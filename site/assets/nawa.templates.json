{
 "ملخّص_نصوص": {
  "name": "ملخص-نصوص",
  "files": {
   "index.html": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>ملخّص نصوص</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><h1>ملخّص نصوص</h1><textarea id=\"t\"></textarea><button id=\"b\">لخّص</button><pre id=\"o\"></pre><script src=\"app.js\"></script></body></html>",
   "style.css": "body{font-family:Tahoma,sans-serif;margin:0;padding:16px;background:#faf8f3;color:#222;direction:rtl}h1{font-size:20px;margin:0 0 12px}textarea{width:100%;box-sizing:border-box;min-height:120px;padding:8px;font:inherit}button{padding:8px 16px;margin:8px 0;font:inherit;background:#9a6b12;color:#fff;border:0;border-radius:8px}pre{font:inherit;white-space:pre-wrap;background:#fff;padding:10px;border-radius:8px}",
   "app.js": "document.getElementById(\"b\").onclick=function(){var o=document.getElementById(\"o\");o.textContent=\"…\";window.nawa.call(\"لخّص\",{نص:document.getElementById(\"t\").value,حد:300}).then(function(r){o.textContent=r.وُجد?r.نص:\"لا يوجد ما يُلخَّص\";window.nawa.save(\"آخر\",r.نص||\"\")},function(e){o.textContent=\"تعذّر: \"+e.message})};window.nawa.load(\"آخر\").then(function(v){if(v)document.getElementById(\"o\").textContent=v});",
   "نواة.json": "{\"خدمات\": [\"لخّص\"]}"
  }
 },
 "اختبار_ذاتي": {
  "name": "اختبار-ذاتي",
  "files": {
   "index.html": "<!doctype html><html lang=\"ar\" dir=\"rtl\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>اختبار ذاتي</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><h1>اختبار ذاتي</h1><textarea id=\"t\"></textarea><button id=\"b\">ابنِ الأسئلة</button><pre id=\"q\"></pre><textarea id=\"a\" placeholder=\"مثال: ١ ب ٢ أ\"></textarea><button id=\"c\">صحّح</button><pre id=\"r\"></pre><script src=\"app.js\"></script></body></html>",
   "style.css": "body{font-family:Tahoma,sans-serif;margin:0;padding:16px;background:#faf8f3;color:#222;direction:rtl}h1{font-size:20px;margin:0 0 12px}textarea{width:100%;box-sizing:border-box;min-height:120px;padding:8px;font:inherit}button{padding:8px 16px;margin:8px 0;font:inherit;background:#9a6b12;color:#fff;border:0;border-radius:8px}pre{font:inherit;white-space:pre-wrap;background:#fff;padding:10px;border-radius:8px}",
   "app.js": "var S=[];document.getElementById(\"b\").onclick=function(){window.nawa.call(\"اختبار\",{نص:document.getElementById(\"t\").value,عدد:5}).then(function(r){S=r.أسئلة||[];var x=[];S.forEach(function(q,i){x.push((i+1)+\") \"+q.سؤال);q.خيارات.forEach(function(c,j){x.push(\"   \"+\"أبجد\"[j]+\") \"+c)})});document.getElementById(\"q\").textContent=r.وُجد?x.join(\"\\n\"):(r.سبب||\"\")})};document.getElementById(\"c\").onclick=function(){window.nawa.call(\"صحّح_اختبار\",{أسئلة:S,إجابات:document.getElementById(\"a\").value}).then(function(r){document.getElementById(\"r\").textContent=r.فهم?r.نص:\"لم أفهم الإجابات\"})};",
   "نواة.json": "{\"خدمات\": [\"اختبار\", \"صحّح_اختبار\"]}"
  }
 }
}