# ضاد/محسنات — خوارزميات التحسين فوق ضاد/تفاضل: SGD بزخم ونستيروف، Adam وAdamW، قصّ التدرجات، جدولة معدل التعلّم.
# مكتوبة بضاد نفسها بلا مضيف. الصيغ مطابقة لصيغ PyTorch (تُقارَن في الاختبارات قيمةً بقيمة بمرجع مستقل).
# الاستعمال: متغير ح = محسنات.آدم(معاملات، ٠.٠٠١)  ثم في كل دورة: صفّر_تدرجات، انتشر_خلفا(خسارة)، ثم خطوة(ح).
# المعاملات: قائمة عقد من ت.معامل(...)؛ لا يُحدَّث معامل تدرجه لاشيء.

متغير ر = استورد("ضاد/رياضيات")

# قائمة أصفار بطول ن
دالة _أصفار(ن) {
    متغير خرج = []
    من_أجل (ي في مدى(ن)) { أضف(خرج، ٠) }
    ارجع خرج
}

# ---------- SGD ----------
# معدل: معدل التعلّم · زخم: معامل الزخم (٠ = بلا زخم) · نستيروف: زخم نستيروف · اضمحلال: عقوبة L2 تُضاف إلى التدرج
صدّر دالة سجد(معاملات، معدل، زخم = ٠، نستيروف = خطأ، اضمحلال = ٠) {
    متغير سرعة = []
    من_أجل (ع في معاملات) { أضف(سرعة، _أصفار(طول(ع["قيمة"]["بيانات"]))) }
    ارجع {"نوع": "سجد"، "معاملات": معاملات، "معدل": معدل، "زخم": زخم، "نستيروف": نستيروف، "اضمحلال": اضمحلال، "سرعة": سرعة، "خطوات": ٠}
}

# ---------- Adam / AdamW ----------
# اضمحلال: في Adam عقوبة L2 تُضاف إلى التدرج، وفي AdamW (فصل = صحيح) يُطبَّق على الأوزان مباشرة مضروبًا في المعدل
صدّر دالة آدم(معاملات، معدل، بيتا١ = ٠.٩، بيتا٢ = ٠.٩٩٩، إبسيلون = ٠.٠٠٠٠٠٠٠١، اضمحلال = ٠، فصل = خطأ) {
    متغير ق = []
    متغير ن = []
    من_أجل (ع في معاملات) {
        أضف(ق، _أصفار(طول(ع["قيمة"]["بيانات"])))
        أضف(ن، _أصفار(طول(ع["قيمة"]["بيانات"])))
    }
    ارجع {"نوع": "آدم"، "معاملات": معاملات، "معدل": معدل، "بيتا١": بيتا١، "بيتا٢": بيتا٢، "إبسيلون": إبسيلون، "اضمحلال": اضمحلال، "فصل": فصل، "ق": ق، "ن": ن، "خطوات": ٠}
}

صدّر دالة آدم_ث(معاملات، معدل، اضمحلال = ٠.٠١) {
    ارجع آدم(معاملات، معدل، ٠.٩، ٠.٩٩٩، ٠.٠٠٠٠٠٠٠١، اضمحلال، صحيح)
}

# يغيّر معدل التعلّم (للجدولة)
صدّر دالة اضبط_المعدل(ح، معدل) { ح["معدل"] = معدل }

# ---------- خطوة واحدة ----------
صدّر دالة خطوة(ح) {
    ح["خطوات"] = ح["خطوات"] + ١
    متغير ت = ح["خطوات"]
    متغير معدل = ح["معدل"]
    متغير ي = ٠
    من_أجل (ع في ح["معاملات"]) {
        إذا (ع["تدرج"] != لاشيء) {
            متغير وز = ع["قيمة"]["بيانات"]
            متغير غ = ع["تدرج"]["بيانات"]
            إذا (ح["نوع"] == "سجد") {
                متغير س = ح["سرعة"][ي]
                من_أجل (ك في مدى(طول(وز))) {
                    متغير د = غ[ك] + ح["اضمحلال"] * وز[ك]
                    إذا (ح["زخم"] != ٠) {
                        إذا (ت == ١) { س[ك] = د } وإلا { س[ك] = ح["زخم"] * س[ك] + د }
                        إذا (ح["نستيروف"]) { د = د + ح["زخم"] * س[ك] } وإلا { د = س[ك] }
                    }
                    وز[ك] = وز[ك] - معدل * د
                }
            } وإلا {
                متغير ق = ح["ق"][ي]
                متغير ن = ح["ن"][ي]
                متغير ب١ = ح["بيتا١"]
                متغير ب٢ = ح["بيتا٢"]
                متغير تصحيح١ = ١ - ب١ ** ت
                متغير تصحيح٢ = ١ - ب٢ ** ت
                من_أجل (ك في مدى(طول(وز))) {
                    متغير د = غ[ك]
                    إذا (ح["اضمحلال"] != ٠) {
                        إذا (ح["فصل"]) { وز[ك] = وز[ك] * (١ - معدل * ح["اضمحلال"]) } وإلا { د = د + ح["اضمحلال"] * وز[ك] }
                    }
                    ق[ك] = ب١ * ق[ك] + (١ - ب١) * د
                    ن[ك] = ب٢ * ن[ك] + (١ - ب٢) * د * د
                    وز[ك] = وز[ك] - معدل * (ق[ك] / تصحيح١) / (جذر(ن[ك] / تصحيح٢) + ح["إبسيلون"])
                }
            }
        }
        ي = ي + ١
    }
}

# ---------- قصّ التدرجات ----------
# يحسب معيار L2 الكلي لتدرجات المعاملات ويقلّصها بنسبة أقصى/معيار إن زاد عنه؛ يرجع المعيار قبل القص
صدّر دالة قصّ_التدرجات(معاملات، أقصى) {
    متغير مجموع = ٠
    من_أجل (ع في معاملات) {
        إذا (ع["تدرج"] != لاشيء) {
            من_أجل (غ في ع["تدرج"]["بيانات"]) { مجموع = مجموع + غ * غ }
        }
    }
    متغير معيار = جذر(مجموع)
    إذا (معيار > أقصى) {
        متغير نسبة = أقصى / (معيار + ٠.٠٠٠٠٠٠١)
        من_أجل (ع في معاملات) {
            إذا (ع["تدرج"] != لاشيء) {
                متغير غغ = ع["تدرج"]["بيانات"]
                من_أجل (ك في مدى(طول(غغ))) { غغ[ك] = غغ[ك] * نسبة }
            }
        }
    }
    ارجع معيار
}

# ---------- جدولة معدل التعلّم ----------
# احماء خطي من ٠ إلى «أقصى» خلال «احماء» خطوة، ثم هبوط جيب التمام إلى «أدنى» عند الخطوة «كلي»
صدّر دالة جدول_جيبي(خطوة_، كلي، احماء، أقصى، أدنى) {
    إذا (احماء > ٠ و خطوة_ < احماء) { ارجع أقصى * (خطوة_ + ١) / احماء }
    إذا (خطوة_ >= كلي) { ارجع أدنى }
    متغير تقدم = (خطوة_ - احماء) / (كلي - احماء)
    ارجع أدنى + ٠.٥ * (أقصى - أدنى) * (١ + ر.جتا(ر.ثابت_ط * تقدم))
}
