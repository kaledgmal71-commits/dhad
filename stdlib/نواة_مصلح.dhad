# ضاد/نواة_مصلح — مصلح شيفرة ضاد: يحدد موضع خطأ الصياغة بمحلل ضاد، ويجرّب إصلاحات مرشحة متراكمة، ويقبل منها ما اجتاز فحص الصياغة ثم شُغِّل،
# ولا يعرض إصلاحًا لم يُتحقَّق منه. إن تعذّر الإصلاح الآلي عاد بموضع الخطأ وتفسيره واقتراحه من محلل الأخطاء.
# الإصلاحات المرشحة (قواعد صريحة): كلمات برمجة إنجليزية، الفاصلة اللاتينية، نص لم يُغلق، أقواس ناقصة أو زائدة، واسم مكتوب خطأً وقت التشغيل.
# الحد: لا يصلح أخطاء المنطق ولا ما لا تغطيه هذه القواعد؛ ويقول ذلك.

متغير ع = استورد("ضاد/نواة_عقد")
متغير أخطاء_ = استورد("ضاد/نواة_أخطاء")

متغير _حروف_لاتينية = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"
متغير _مقابلات = {
    "if": "إذا"، "else": "وإلا"، "while": "طالما"، "function": "دالة"، "return": "ارجع"،
    "let": "متغير"، "var": "متغير"، "const": "متغير"، "print": "اطبع"، "true": "صحيح"، "false": "خطأ"،
    "null": "لاشيء"، "break": "توقف"، "continue": "أكمل"
}
متغير _فاصل_الاسم = " ()[]{}،,;:+-*/%<>=!&|^~?.#" + حرف(٣٤) + حرف(١٠) + حرف(٩)

# --- مسح يعرف النصوص والتعليقات ---

# يعيد قائمة بخلايا {ح: الحرف، خارج: صحيح إن كان خارج نص وتعليق}
دالة _خلايا(ش) {
    متغير خرج = []
    متغير داخل_نص = خطأ
    متغير داخل_تعليق = خطأ
    متغير ط = طول(ش)
    من_أجل (ي في مدى(ط)) {
        متغير ح = ش[ي]
        متغير خارج = خطأ
        إذا (ح == حرف(١٠)) { داخل_تعليق = خطأ }
        إذا (داخل_نص) {
            إذا (ح == حرف(٣٤)) { داخل_نص = خطأ }
        } وإلا إذا (داخل_تعليق) {
            متغير تجاهل = ٠
        } وإلا إذا (ح == حرف(٣٤)) {
            داخل_نص = صحيح
        } وإلا إذا (ح == "#") {
            داخل_تعليق = صحيح
        } وإلا {
            خارج = صحيح
        }
        أضف(خرج، {"ح": ح، "خارج": خارج})
    }
    ارجع خرج
}

# --- الإصلاحات المرشحة: كل منها يعيد [نص جديد، عدد التغييرات] ---

دالة _كلمات_إنجليزية(ش) {
    متغير خ = _خلايا(ش)
    متغير خرج = []
    متغير عدد = ٠
    متغير ي = ٠
    متغير ط = طول(خ)
    طالما (ي < ط) {
        متغير ح = خ[ي]["ح"]
        إذا (خ[ي]["خارج"] و يحوي(_حروف_لاتينية، ح)) {
            متغير كلمة = ""
            متغير ج = ي
            طالما (ج < ط و خ[ج]["خارج"] و يحوي(_حروف_لاتينية، خ[ج]["ح"])) {
                كلمة = كلمة + خ[ج]["ح"]
                ج = ج + ١
            }
            إذا (يحوي(_مقابلات، كلمة)) {
                أضف(خرج، _مقابلات[كلمة])
                عدد = عدد + ١
            } وإلا { أضف(خرج، كلمة) }
            ي = ج
        } وإلا إذا (خ[ي]["خارج"] و ح == "&" و ي + ١ < ط و خ[ي + ١]["ح"] == "&") {
            أضف(خرج، "و")
            عدد = عدد + ١
            ي = ي + ٢
        } وإلا إذا (خ[ي]["خارج"] و ح == "|" و ي + ١ < ط و خ[ي + ١]["ح"] == "|") {
            أضف(خرج، "أو")
            عدد = عدد + ١
            ي = ي + ٢
        } وإلا {
            أضف(خرج، ح)
            ي = ي + ١
        }
    }
    ارجع [اربط(خرج، "")، عدد]
}

دالة _فواصل_لاتينية(ش) {
    متغير خرج = []
    متغير عدد = ٠
    من_أجل (خلية في _خلايا(ش)) {
        إذا (خلية["خارج"] و خلية["ح"] == ",") {
            أضف(خرج، "،")
            عدد = عدد + ١
        } وإلا { أضف(خرج، خلية["ح"]) }
    }
    ارجع [اربط(خرج، "")، عدد]
}

# سطر فيه عدد فردي من علامات الاقتباس (خارج التعليق) يُغلق نصّه في آخره
دالة _نصوص_مفتوحة(ش) {
    متغير سطور = افصل(ش، حرف(١٠))
    متغير عدد = ٠
    متغير جديد = []
    من_أجل (س في سطور) {
        متغير ع٢ = ٠
        من_أجل (خلية في _خلايا(س)) { إذا (خلية["ح"] == حرف(٣٤)) { ع٢ = ع٢ + ١ } }
        إذا (ع٢ % ٢ == ١) {
            # الإغلاق قبل أقواس السطر الختامية: «اطبع("مرحبا)» تصير «اطبع("مرحبا")»
            متغير ك = طول(س)
            طالما (ك > ٠ و يحوي(")]}; "، س[ك - ١])) { ك = ك - ١ }
            أضف(جديد، س[٠:ك] + حرف(٣٤) + س[ك:طول(س)])
            عدد = عدد + ١
        } وإلا { أضف(جديد، س) }
    }
    ارجع [اربط(جديد، حرف(١٠))، عدد]
}

# فاصلة عربية في آخر السطر لا تليها قيمة (عادة جاءت من عادة لغات أخرى) تُحذف
دالة _فاصلة_ختامية(ش) {
    متغير سطور = افصل(ش، حرف(١٠))
    متغير عدد = ٠
    متغير جديد = []
    من_أجل (س في سطور) {
        متغير ك = طول(س)
        طالما (ك > ٠ و يحوي(" "، س[ك - ١])) { ك = ك - ١ }
        إذا (ك > ٠ و س[ك - ١] == "،") {
            # لا تُحذف إلا إن كانت خارج النصوص والتعليقات
            متغير خلايا_ = _خلايا(س)
            إذا (خلايا_[ك - ١]["خارج"]) {
                أضف(جديد، س[٠:ك - ١] + س[ك:طول(س)])
                عدد = عدد + ١
            } وإلا { أضف(جديد، س) }
        } وإلا { أضف(جديد، س) }
    }
    ارجع [اربط(جديد، حرف(١٠))، عدد]
}

# أقواس زائدة تُحذف وناقصة تُغلق في آخر النص بترتيب فتحها المعكوس
دالة _توازن_الأقواس(ش) {
    متغير خ = _خلايا(ش)
    متغير مكدس = []
    متغير خرج = []
    متغير عدد = ٠
    متغير أزواج = {")": "("، "]": "["، "}": "{"}
    من_أجل (خلية في خ) {
        متغير ح = خلية["ح"]
        متغير احتفظ = صحيح
        إذا (خلية["خارج"]) {
            إذا (ح == "(" أو ح == "[" أو ح == "{") { أضف(مكدس، ح) }
            إذا (ح == ")" أو ح == "]" أو ح == "}") {
                إذا (طول(مكدس) > ٠ و مكدس[طول(مكدس) - ١] == أزواج[ح]) {
                    احذف(مكدس، طول(مكدس) - ١)
                } وإلا {
                    احتفظ = خطأ
                    عدد = عدد + ١
                }
            }
        }
        إذا (احتفظ) { أضف(خرج، ح) }
    }
    متغير ذيل = ""
    متغير إغلاق = {"(": ")"، "[": "]"، "{": "}"}
    متغير ي = طول(مكدس) - ١
    طالما (ي >= ٠) {
        إذا (مكدس[ي] == "{") { ذيل = ذيل + حرف(١٠) + "}" } وإلا { ذيل = ذيل + إغلاق[مكدس[ي]] }
        عدد = عدد + ١
        ي = ي - ١
    }
    ارجع [اربط(خرج، "") + ذيل، عدد]
}

# استبدال اسم كامل (لا جزء اسم) خارج النصوص والتعليقات
دالة _بدّل_الاسم(ش، قديم، جديد) {
    متغير خ = _خلايا(ش)
    متغير خرج = []
    متغير ي = ٠
    متغير ط = طول(خ)
    طالما (ي < ط) {
        إذا (خ[ي]["خارج"] و ليس يحوي(_فاصل_الاسم، خ[ي]["ح"])) {
            متغير كلمة = ""
            متغير ج = ي
            طالما (ج < ط و خ[ج]["خارج"] و ليس يحوي(_فاصل_الاسم، خ[ج]["ح"])) {
                كلمة = كلمة + خ[ج]["ح"]
                ج = ج + ١
            }
            إذا (كلمة == قديم) { أضف(خرج، جديد) } وإلا { أضف(خرج، كلمة) }
            ي = ج
        } وإلا {
            أضف(خرج، خ[ي]["ح"])
            ي = ي + ١
        }
    }
    ارجع اربط(خرج، "")
}

دالة _خطأ_تشغيل(ناتج) {
    إذا (طول(ناتج) > ٠ و يبدأ_(ناتج[طول(ناتج) - ١])) { ارجع ناتج[طول(ناتج) - ١] }
    ارجع ""
}

دالة يبدأ_(س) { ارجع طول(س) >= ٥ و س[٠:٥] == "خطأ: " }

# النتيجة: {حالة: سليمة | أُصلحت | تشخيص | تعذّر، خطأ، إصلاحات: [وصف]، شيفرة، ناتج، تشخيص}
صدّر دالة أصلح(شيفرة) {
    متغير إصلاحات = []
    متغير حالي = شيفرة
    متغير أصل_الخطأ = ""
    متغير فحص = نواة_فحص_صياغة(حالي)
    إذا (فحص != "كامل") {
        أصل_الخطأ = نواة_شجرة(حالي)["خطأ"]
        متغير مراحل = [
            ["كلمات برمجة إنجليزية حوّلتُها إلى مقابلها العربي"، _كلمات_إنجليزية]،
            ["فواصل لاتينية (,) بدّلتُها بالفاصلة العربية («،»)"، _فواصل_لاتينية]،
            ["فواصل في آخر السطر لا تليها قيمة حذفتُها"، _فاصلة_ختامية]،
            ["نصوص لم تُغلق أغلقتُها بعلامة الاقتباس"، _نصوص_مفتوحة]،
            ["أقواس زائدة حذفتُها أو ناقصة أغلقتُها"، _توازن_الأقواس]
        ]
        من_أجل ([ص٢، ف٢] في مراحل) {
            إذا (نواة_فحص_صياغة(حالي) != "كامل") {
                متغير ن٢ = ف٢(حالي)
                إذا (ن٢[١] > ٠) {
                    حالي = ن٢[٠]
                    أضف(إصلاحات، نص(ن٢[١]) + " " + ص٢)
                }
            }
        }
        إذا (نواة_فحص_صياغة(حالي) != "كامل") {
            متغير د = أخطاء_.حلّل_الخطأ(أصل_الخطأ، شيفرة)
            ارجع {"حالة": "تعذّر"، "خطأ": أصل_الخطأ، "إصلاحات": []، "شيفرة": شيفرة، "ناتج": []، "تشخيص": د}
        }
    }
    # صياغة سليمة (أصلية أو بعد الإصلاح): تشغيل
    متغير ناتج = نفّذ(حالي، ٢٠٠٠٠٠، ٢٠٠٠)
    متغير خطأ_ت = _خطأ_تشغيل(ناتج)
    إذا (خطأ_ت != "") {
        متغير د = أخطاء_.حلّل_الخطأ(خطأ_ت، حالي)
        # كلمة برمجة إنجليزية استُعملت كاسم (مثل if/print) فيفشل التشغيل: تُحوَّل إلى مقابلها ويُعاد التحقق
        إذا (د["اسم"] != "" و يحوي(_مقابلات، د["اسم"])) {
            متغير ترجمة = _كلمات_إنجليزية(حالي)
            إذا (ترجمة[١] > ٠) {
                متغير ناتج٣ = نفّذ(ترجمة[٠]، ٢٠٠٠٠٠، ٢٠٠٠)
                إذا (_خطأ_تشغيل(ناتج٣) == "") {
                    أضف(إصلاحات، نص(ترجمة[١]) + " كلمات برمجة إنجليزية حوّلتُها إلى مقابلها العربي")
                    ارجع {"حالة": "أُصلحت"، "خطأ": خطأ_ت، "إصلاحات": إصلاحات، "شيفرة": ترجمة[٠]، "ناتج": ناتج٣، "تشخيص": د}
                }
            }
        }
        إذا (د["أقرب_اسم"] != "" و د["اسم"] != "") {
            متغير مجرَّب = _بدّل_الاسم(حالي، د["اسم"]، د["أقرب_اسم"])
            متغير ناتج٢ = نفّذ(مجرَّب، ٢٠٠٠٠٠، ٢٠٠٠)
            إذا (_خطأ_تشغيل(ناتج٢) == "") {
                أضف(إصلاحات، "الاسم «" + د["اسم"] + "» غير معرّف فبدّلته بأقرب اسم معرّف «" + د["أقرب_اسم"] + "»")
                ارجع {"حالة": "أُصلحت"، "خطأ": أصل_الخطأ، "إصلاحات": إصلاحات، "شيفرة": مجرَّب، "ناتج": ناتج٢، "تشخيص": د}
            }
        }
        ارجع {"حالة": "تشخيص"، "خطأ": خطأ_ت، "إصلاحات": إصلاحات، "شيفرة": حالي، "ناتج": ناتج، "تشخيص": د}
    }
    إذا (طول(إصلاحات) > ٠) {
        ارجع {"حالة": "أُصلحت"، "خطأ": أصل_الخطأ، "إصلاحات": إصلاحات، "شيفرة": حالي، "ناتج": ناتج، "تشخيص": لاشيء}
    }
    ارجع {"حالة": "سليمة"، "خطأ": ""، "إصلاحات": []، "شيفرة": حالي، "ناتج": ناتج، "تشخيص": لاشيء}
}

# صياغة نصية للقارئ
صدّر دالة صغ(ن٢) {
    متغير سياج = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    متغير خرج = []
    متغير ح = ن٢["حالة"]
    إذا (ح == "سليمة") {
        أضف(خرج، "الشيفرة سليمة الصياغة ولم أجد فيها خطأً تشغيل.")
    } وإلا إذا (ح == "تعذّر") {
        أضف(خرج، "تعذّر الإصلاح الآلي لهذه الشيفرة؛ قواعدي تغطي الكلمات الإنجليزية والفواصل اللاتينية والنصوص والأقواس غير المغلقة وأسماء المتغيرات المكتوبة خطأً.")
        أضف(خرج، "")
        أضف(خرج، "الخطأ: " + ن٢["خطأ"])
        إذا (ن٢["تشخيص"]["نص_السطر"] != "") { أضف(خرج، "السطر: " + ن٢["تشخيص"]["نص_السطر"]) }
        أضف(خرج، "التفسير: " + ن٢["تشخيص"]["تفسير"])
        أضف(خرج، "الاقتراح: " + ن٢["تشخيص"]["اقتراح"])
    } وإلا إذا (ح == "تشخيص") {
        أضف(خرج، "الصياغة سليمة لكن التشغيل فشل بهذا الخطأ:")
        أضف(خرج، ن٢["خطأ"])
        أضف(خرج، "")
        أضف(خرج، "التفسير: " + ن٢["تشخيص"]["تفسير"])
        أضف(خرج، "الاقتراح: " + ن٢["تشخيص"]["اقتراح"])
        إذا (ن٢["تشخيص"]["نص_السطر"] != "") { أضف(خرج، "السطر: " + ن٢["تشخيص"]["نص_السطر"]) }
    } وإلا {
        أضف(خرج، "أصلحتُ الشيفرة وتحققتُ منها: صياغتها سليمة وشُغِّلت بلا خطأ.")
        أضف(خرج، "")
        أضف(خرج، "ما أصلحته:")
        من_أجل (ا٣ في ن٢["إصلاحات"]) { أضف(خرج، "- " + ا٣) }
        أضف(خرج، "")
        أضف(خرج، "الشيفرة بعد الإصلاح:")
        أضف(خرج، سياج)
        أضف(خرج، ن٢["شيفرة"])
        أضف(خرج، سياج)
    }
    إذا (طول(ن٢["ناتج"]) > ٠ و (ح == "سليمة" أو ح == "أُصلحت")) {
        أضف(خرج، "")
        أضف(خرج، "الناتج عند التشغيل:")
        من_أجل (ل في ن٢["ناتج"]) { أضف(خرج، "  " + ل) }
    }
    ارجع اربط(خرج، حرف(١٠))
}

صدّر دالة سجّل_المحرك() {
    إذا (ليس يحوي(ع.المحركات()، "مصلح_شيفرة")) {
        ع.سجّل(ع.محرك("مصلح_شيفرة"، "يحدد خطأ الصياغة ويجرّب إصلاحات مرشحة ويقبل ما اجتاز الفحص والتشغيل"، {"شيفرة": "نص"}، {"إصلاح": "خريطة"، "نص": "نص"}،
            دالة(م) {
                متغير ن٢ = أصلح(م["شيفرة"])
                ارجع {"إصلاح": ن٢، "نص": صغ(ن٢)}
            }))
    }
}
