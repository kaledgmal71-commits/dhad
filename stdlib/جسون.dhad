# ضاد/جسون — قراءة JSON وكتابته، مكتوبة بضاد نفسها فوق دوال المحرك الأساسية فقط (رمز، حرف، اقتطع، عدد، قوة)
# حلّل(نص): يحوّل نص JSON إلى قيمة ضاد: خريطة، قائمة، نص، رقم، صحيح/خطأ، لاشيء.
# اكتب(قيمة، مسافة، رتّب): يحوّل قيمة ضاد إلى نص JSON.
# الصرامة: تتبع القراءة قواعد JSON الرسمية (RFC 8259) حرفيًا: أرقام لاتينية فقط، ولا فاصلة زائدة، ولا تعليقات.

# ---------- حالة القراءة (القراءة متزامنة دائمًا فلا تتداخل استدعاءان) ----------
متغير _س = ""
متغير _ن = ٠
متغير _م = ٠

دالة _خطأ(رسالة) {
    متغير سطر = ١
    متغير عمود = ١
    متغير ي = ٠
    طالما (ي < _م و ي < _ن) {
        إذا (رمز(_س[ي]) == ١٠) {
            سطر = سطر + ١
            عمود = ١
        } وإلا {
            عمود = عمود + ١
        }
        ي = ي + ١
    }
    أطلق_خطأ("جسون: " + رسالة + " (في النص: السطر " + نص(سطر) + "، العمود " + نص(عمود) + ")")
}

دالة _تخطّ() {
    طالما (_م < _ن) {
        متغير ر = رمز(_س[_م])
        إذا (ر == ٣٢ أو ر == ١٠ أو ر == ١٣ أو ر == ٩) {
            _م = _م + ١
        } وإلا {
            توقف
        }
    }
}

# قيمة الرقم السداسي عشري للحرف، أو -١ إن لم يكن كذلك
دالة _هكس(ر) {
    إذا (ر >= ٤٨ و ر <= ٥٧) { ارجع ر - ٤٨ }
    إذا (ر >= ٦٥ و ر <= ٧٠) { ارجع ر - ٥٥ }
    إذا (ر >= ٩٧ و ر <= ١٠٢) { ارجع ر - ٨٧ }
    ارجع -١
}

# يستهلك الأرقام اللاتينية المتتالية ويعيدها نصًّا (قد يكون فارغًا)
دالة _أرقام() {
    متغير ب = _م
    طالما (_م < _ن) {
        متغير ر = رمز(_س[_م])
        إذا (ر >= ٤٨ و ر <= ٥٧) { _م = _م + ١ } وإلا { توقف }
    }
    ارجع اقتطع(_س، ب، _م)
}

دالة _رقم() {
    متغير سالب = خطأ
    إذا (_س[_م] == "-") {
        سالب = صحيح
        _م = _م + ١
    }
    متغير صحيحة = _أرقام()
    إذا (صحيحة == "") { _خطأ("رقم غير صالح: توقّعتُ رقمًا لاتينيًا") }
    إذا (طول(صحيحة) > ١ و رمز(صحيحة[٠]) == ٤٨) {
        _خطأ("رقم غير صالح: لا يبدأ الرقم بصفر زائد")
    }
    متغير كسر = ""
    إذا (_م < _ن و _س[_م] == ".") {
        _م = _م + ١
        كسر = _أرقام()
        إذا (كسر == "") { _خطأ("رقم غير صالح: لا بدّ من رقم بعد الفاصلة العشرية") }
    }
    متغير أس = ٠
    إذا (_م < _ن و (_س[_م] == "e" أو _س[_م] == "E")) {
        _م = _م + ١
        متغير إشارة = ١
        إذا (_م < _ن و (_س[_م] == "+" أو _س[_م] == "-")) {
            إذا (_س[_م] == "-") { إشارة = -١ }
            _م = _م + ١
        }
        متغير ص = _أرقام()
        إذا (ص == "") { _خطأ("رقم غير صالح: لا بدّ من رقم بعد e") }
        إذا (طول(ص) > ٦) { _خطأ("رقم غير صالح: الأس كبير جدًا") }
        أس = إشارة * عدد(ص)
    }
    # القيمة = الأرقام كلها كعدد صحيح × ١٠^(الأس − عدد خانات الكسر)
    # القسمة أو الضرب بقوة عشرة دقيق تمامًا للأعداد المعتادة (حتى ١٥ خانة وأس حتى ٢٢)
    متغير ك = عدد(صحيحة + كسر)
    متغير ق = أس - طول(كسر)
    إذا (ق < ٠) {
        متغير ه = -ق
        طالما (ه > ٢٢) {
            ك = ك / قوة(١٠، ٢٢)
            ه = ه - ٢٢
        }
        ك = ك / قوة(١٠، ه)
    } وإلا إذا (ق > ٠) {
        متغير ه = ق
        طالما (ه > ٢٢) {
            ك = ك * قوة(١٠، ٢٢)
            ه = ه - ٢٢
        }
        ك = ك * قوة(١٠، ه)
    }
    إذا (ك == قوة(١٠، ٤٠٠)) { _خطأ("رقم أكبر من المدى الذي تدعمه ضاد") }
    إذا (سالب) { ارجع -ك }
    ارجع ك
}

دالة _نص_قيمة() {
    _م = _م + ١
    متغير أجزاء = []
    متغير بداية = _م
    طالما (صحيح) {
        إذا (_م >= _ن) { _خطأ("نص غير مغلق: ينقص علامة التنصيص الختامية") }
        متغير ر = رمز(_س[_م])
        إذا (ر == ٣٤) {
            أضف(أجزاء، اقتطع(_س، بداية، _م))
            _م = _م + ١
            توقف
        }
        إذا (ر < ٣٢) { _خطأ("حرف تحكم غير مهرَّب داخل النص") }
        إذا (ر == ٩٢) {
            أضف(أجزاء، اقتطع(_س، بداية، _م))
            _م = _م + ١
            إذا (_م >= _ن) { _خطأ("نص غير مغلق بعد شرطة الهروب") }
            متغير هـ = رمز(_س[_م])
            إذا (هـ == ٣٤) { أضف(أجزاء، حرف(٣٤)) }
            وإلا إذا (هـ == ٩٢) { أضف(أجزاء، حرف(٩٢)) }
            وإلا إذا (هـ == ٤٧) { أضف(أجزاء، حرف(٤٧)) }
            وإلا إذا (هـ == ٩٨) { أضف(أجزاء، حرف(٨)) }
            وإلا إذا (هـ == ١٠٢) { أضف(أجزاء، حرف(١٢)) }
            وإلا إذا (هـ == ١١٠) { أضف(أجزاء، حرف(١٠)) }
            وإلا إذا (هـ == ١١٤) { أضف(أجزاء، حرف(١٣)) }
            وإلا إذا (هـ == ١١٦) { أضف(أجزاء، حرف(٩)) }
            وإلا إذا (هـ == ١١٧) {
                متغير ق = ٠
                متغير ي = ١
                طالما (ي <= ٤) {
                    إذا (_م + ي >= _ن) { _خطأ("رمز الهروب u ناقص: يلزم أربع خانات سداسية عشرية") }
                    متغير ه = _هكس(رمز(_س[_م + ي]))
                    إذا (ه < ٠) {
                        _م = _م + ي
                        _خطأ("رمز الهروب u غير صالح: خانة سداسية عشرية متوقَّعة")
                    }
                    ق = ق * ١٦ + ه
                    ي = ي + ١
                }
                أضف(أجزاء، حرف(ق))
                _م = _م + ٤
            } وإلا {
                _خطأ("هروب غير معروف داخل النص")
            }
            _م = _م + ١
            بداية = _م
        } وإلا {
            _م = _م + ١
        }
    }
    ارجع اربط(أجزاء، "")
}

دالة _كلمة(كلمة) {
    ارجع اقتطع(_س، _م، _م + طول(كلمة)) == كلمة
}

دالة _قائمة(عمق) {
    _م = _م + ١
    متغير ق = []
    _تخطّ()
    إذا (_م < _ن و _س[_م] == "]") {
        _م = _م + ١
        ارجع ق
    }
    طالما (صحيح) {
        أضف(ق، _قيمة(عمق + ١))
        _تخطّ()
        إذا (_م >= _ن) { _خطأ("القائمة غير مغلقة: ينقص «]»") }
        متغير ف = _س[_م]
        إذا (ف == "]") {
            _م = _م + ١
            ارجع ق
        }
        إذا (رمز(ف) != ٤٤) { _خطأ("متوقَّع فاصلة «,» أو «]» بعد عنصر القائمة") }
        _م = _م + ١
    }
}

دالة _كائن(عمق) {
    _م = _م + ١
    متغير خ = {}
    _تخطّ()
    إذا (_م < _ن و _س[_م] == "}") {
        _م = _م + ١
        ارجع خ
    }
    طالما (صحيح) {
        _تخطّ()
        إذا (_م >= _ن أو رمز(_س[_م]) != ٣٤) { _خطأ("متوقَّع اسم مفتاح بين علامتي تنصيص") }
        متغير مفتاح = _نص_قيمة()
        _تخطّ()
        إذا (_م >= _ن أو رمز(_س[_م]) != ٥٨) { _خطأ("متوقَّعة النقطتان «:» بعد المفتاح") }
        _م = _م + ١
        خ[مفتاح] = _قيمة(عمق + ١)
        _تخطّ()
        إذا (_م >= _ن) { _خطأ("الكائن غير مغلق: ينقص «}»") }
        متغير ف = _س[_م]
        إذا (ف == "}") {
            _م = _م + ١
            ارجع خ
        }
        إذا (رمز(ف) != ٤٤) { _خطأ("متوقَّع فاصلة «,» أو «}» بعد قيمة المفتاح") }
        _م = _م + ١
    }
}

دالة _قيمة(عمق) {
    إذا (عمق > ٤٠٠) { _خطأ("التداخل أعمق من ٤٠٠ مستوى") }
    _تخطّ()
    إذا (_م >= _ن) { _خطأ("انتهى النص قبل اكتمال القيمة") }
    متغير ح = _س[_م]
    متغير ر = رمز(ح)
    إذا (ر == ١٢٣) { ارجع _كائن(عمق) }
    إذا (ر == ٩١) { ارجع _قائمة(عمق) }
    إذا (ر == ٣٤) { ارجع _نص_قيمة() }
    إذا (ر == ٤٥ أو (ر >= ٤٨ و ر <= ٥٧)) { ارجع _رقم() }
    إذا (_كلمة("true")) {
        _م = _م + ٤
        ارجع صحيح
    }
    إذا (_كلمة("false")) {
        _م = _م + ٥
        ارجع خطأ
    }
    إذا (_كلمة("null")) {
        _م = _م + ٤
        ارجع لاشيء
    }
    _خطأ("رمز غير متوقَّع «" + ح + "»")
}

صدّر دالة حلّل(س) {
    إذا (نوع(س) != "نص") { أطلق_خطأ("حلّل() تحتاج نصًّا") }
    _س = س
    _ن = طول(س)
    _م = ٠
    متغير ناتج = لاشيء
    حاول {
        ناتج = _قيمة(٠)
        _تخطّ()
        إذا (_م < _ن) { _خطأ("نص زائد بعد نهاية القيمة") }
    } التقط (خ) {
        _س = ""
        _ن = ٠
        _م = ٠
        أطلق_خطأ(خ)
    }
    _س = ""
    _ن = ٠
    _م = ٠
    ارجع ناتج
}

صدّر دالة صالح(س) {
    إذا (نوع(س) != "نص") { ارجع خطأ }
    متغير ن = خطأ
    حاول {
        حلّل(س)
        ن = صحيح
    } التقط (خ) {
        ن = خطأ
    }
    ارجع ن
}

# ---------- الكتابة ----------
دالة _هكس٤(ق) {
    متغير ز = "0123456789abcdef"
    ارجع ز[أرضية(ق / ٤٠٩٦) % ١٦] + ز[أرضية(ق / ٢٥٦) % ١٦] + ز[أرضية(ق / ١٦) % ١٦] + ز[ق % ١٦]
}

دالة _نص_جسون(س) {
    متغير أ = [حرف(٣٤)]
    متغير ب = ٠
    متغير ن = طول(س)
    متغير ي = ٠
    طالما (ي < ن) {
        متغير ر = رمز(س[ي])
        إذا (ر == ٣٤ أو ر == ٩٢ أو ر < ٣٢) {
            أضف(أ، اقتطع(س، ب، ي))
            إذا (ر == ٣٤) { أضف(أ، حرف(٩٢) + حرف(٣٤)) }
            وإلا إذا (ر == ٩٢) { أضف(أ، حرف(٩٢) + حرف(٩٢)) }
            وإلا إذا (ر == ١٠) { أضف(أ، حرف(٩٢) + "n") }
            وإلا إذا (ر == ١٣) { أضف(أ، حرف(٩٢) + "r") }
            وإلا إذا (ر == ٩) { أضف(أ، حرف(٩٢) + "t") }
            وإلا إذا (ر == ٨) { أضف(أ، حرف(٩٢) + "b") }
            وإلا إذا (ر == ١٢) { أضف(أ، حرف(٩٢) + "f") }
            وإلا { أضف(أ، حرف(٩٢) + "u" + _هكس٤(ر)) }
            ب = ي + ١
        }
        ي = ي + ١
    }
    أضف(أ، اقتطع(س، ب))
    أضف(أ، حرف(٣٤))
    ارجع اربط(أ، "")
}

دالة _رقم_جسون(ق) {
    إذا (ق == قوة(١٠، ٤٠٠) أو ق == -قوة(١٠، ٤٠٠)) { أطلق_خطأ("جسون: لا يمكن كتابة عدد غير منتهٍ") }
    ارجع نص_برمجي(ق)
}

# مقارنة حرفية بوحدات النص (لا بحسب لغة الجهاز) لتخرج الكتابة المرتّبة ثابتة في كل مكان
دالة _قارن(ا، ب) {
    متغير ي = ٠
    متغير ن = الأصغر(طول(ا)، طول(ب))
    طالما (ي < ن) {
        متغير ف = رمز(ا[ي]) - رمز(ب[ي])
        إذا (ف != ٠) { ارجع ف }
        ي = ي + ١
    }
    ارجع طول(ا) - طول(ب)
}

دالة _اكتب_قيمة(ق، مسافة، مستوى، أسلاف، رتّب، أ) {
    متغير ت = نوع(ق)
    إذا (ت == "لاشيء") {
        أضف(أ، "null")
        ارجع لاشيء
    }
    إذا (ت == "قيمة منطقية") {
        إذا (ق) { أضف(أ، "true") } وإلا { أضف(أ، "false") }
        ارجع لاشيء
    }
    إذا (ت == "رقم") {
        أضف(أ، _رقم_جسون(ق))
        ارجع لاشيء
    }
    إذا (ت == "نص") {
        أضف(أ، _نص_جسون(ق))
        ارجع لاشيء
    }
    إذا (ت != "قائمة" و ت != "خريطة" و ت != "مجموعة") {
        أطلق_خطأ("جسون: لا يمكن كتابة قيمة من نوع «" + ت + "»")
    }
    إذا (مستوى > ٤٠٠) { أطلق_خطأ("جسون: التداخل أعمق من ٤٠٠ مستوى") }
    من_أجل (س في أسلاف) {
        إذا (س == ق) { أطلق_خطأ("جسون: القيمة تحوي نفسها (دورة) فلا يمكن كتابتها") }
    }
    أضف(أسلاف، ق)
    متغير عناصر = ق
    إذا (ت == "مجموعة") { عناصر = إلى_قائمة(ق) }
    متغير مفاتيح_ك = لاشيء
    إذا (ت == "خريطة") {
        مفاتيح_ك = مفاتيح(ق)
        من_أجل (م في مفاتيح_ك) {
            إذا (نوع(م) != "نص") { أطلق_خطأ("جسون: مفاتيح الخريطة يجب أن تكون نصوصًا، وُجد «" + نوع(م) + "»") }
        }
        إذا (رتّب) { مفاتيح_ك = رتب(مفاتيح_ك، _قارن) }
        عناصر = مفاتيح_ك
    }
    متغير فتح = "["
    متغير غلق = "]"
    إذا (ت == "خريطة") {
        فتح = "{"
        غلق = "}"
    }
    إذا (طول(عناصر) == ٠) {
        أضف(أ، فتح + غلق)
    } وإلا {
        أضف(أ، فتح)
        متغير بداخل = ""
        متغير نهاية = ""
        إذا (مسافة != "") {
            بداخل = حرف(١٠) + كرّر(مسافة، مستوى + ١)
            نهاية = حرف(١٠) + كرّر(مسافة، مستوى)
        }
        متغير ي = ٠
        من_أجل (ع في عناصر) {
            إذا (ي > ٠) { أضف(أ، ",") }
            أضف(أ، بداخل)
            إذا (ت == "خريطة") {
                أضف(أ، _نص_جسون(ع))
                أضف(أ، ":")
                إذا (مسافة != "") { أضف(أ، " ") }
                _اكتب_قيمة(ق[ع]، مسافة، مستوى + ١، أسلاف، رتّب، أ)
            } وإلا {
                _اكتب_قيمة(ع، مسافة، مستوى + ١، أسلاف، رتّب، أ)
            }
            ي = ي + ١
        }
        أضف(أ، نهاية)
        أضف(أ، غلق)
    }
    انزع(أسلاف)
    ارجع لاشيء
}

# اكتب(قيمة) مضغوطًا، واكتب(قيمة، ٢) بمسافتين لكل مستوى، واكتب(قيمة، نص_المسافة) بنص تختاره (مثل علامة جدولة)
# اكتب(قيمة، ٢، صحيح) يرتّب مفاتيح كل خريطة فيخرج النص ثابتًا لنفس المحتوى
صدّر دالة اكتب(ق، مسافة، رتّب) {
    متغير م = ""
    إذا (مسافة == لاشيء) {
        م = ""
    } وإلا إذا (نوع(مسافة) == "رقم") {
        إذا (مسافة != أرضية(مسافة) أو مسافة < ٠) { أطلق_خطأ("اكتب(): المسافة عدد صحيح غير سالب") }
        إذا (مسافة > ١٠) { مسافة = ١٠ }
        م = كرّر(" "، مسافة)
    } وإلا إذا (نوع(مسافة) == "نص") {
        م = اقتطع(مسافة، ٠، ١٠)
    } وإلا {
        أطلق_خطأ("اكتب(): المسافة عدد أو نص")
    }
    متغير أجزاء = []
    _اكتب_قيمة(ق، م، ٠، []، رتّب == صحيح، أجزاء)
    ارجع اربط(أجزاء، "")
}
