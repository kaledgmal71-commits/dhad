# ضاد/نواة_اقتباس — التحقق من النص المنسوب (grounding check): يكشف في مخرجات المولِّد كل جملة منسوبة (حديث، آية، إسناد، «اقتباس»)
# ويطابقها على متتاليات كلمات المصادر المعروضة؛ ما لم يثبت حرفيًّا في المصادر يُحذف ويُسجَّل. المولِّد لا ينفرد بنسبة نص إلى أحد.
# عامة: لا تعرف موضوعًا؛ علامات النسبة قائمة قابلة للتبديل.

متغير ع = استورد("ضاد/نواة_عقد")
متغير ن = استورد("ضاد/نصوص")
متغير ف٠ = استورد("ضاد/نواة_ملف")

# علامات النسبة بصورتها المطبَّعة (بلا تشكيل، ألف واحدة، تاء مربوطة هاء)
متغير _علامات = ["قال رسول الله"، "قال النبي"، "عن النبي"، "عن رسول الله"، "حدثنا"، "أخبرنا"، "حدثني"، "اخبرنا"، "قال الله تعالي"، "قال تعالي"، "قال الله"، "فقال رسول الله"، "سمعت رسول الله"]
متغير _حد_القبول = ٨
متغير _طول_المتتالية = ٦

# كلمات النص مطبَّعة، كل كلمة على حدة
صدّر دالة كلمات_مطبّعة(س) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في ن.أزل_التطويل(ن.أزل_التشكيل(س))) {
        إذا (ن.هل_حرف_عربي(ح)) { حالي = حالي + ح }
        وإلا {
            إذا (حالي != "") { أضف(خرج، ف٠.مطبّع(حالي)) }
            حالي = ""
        }
    }
    إذا (حالي != "") { أضف(خرج، ف٠.مطبّع(حالي)) }
    ارجع خرج
}

دالة _متتالية(كلمات_، من_، ط) {
    متغير ج = []
    من_أجل (ي في مدى(ط)) { أضف(ج، كلمات_[من_ + ي]) }
    ارجع اربط(ج، " ")
}

# فهرس متتاليات ط كلمة من المصادر: [{مصدر، نص}] ← {متتالية: اسم المصدر}
صدّر دالة ابنِ_فهرس(مصادر، ط = ٦) {
    متغير فه = {}
    متغير نصوص_ = []
    من_أجل (م في مصادر) {
        متغير ك = كلمات_مطبّعة(م["نص"])
        أضف(نصوص_، {"مصدر": م["مصدر"]، "نص": " " + اربط(ك، " ") + " "})
        من_أجل (ي في مدى(طول(ك) - ط + ١)) {
            متغير ج = _متتالية(ك، ي، ط)
            إذا (ليس يحوي(فه، ج)) { فه[ج] = م["مصدر"] }
        }
    }
    ارجع {"متتاليات": فه، "ط": ط، "نصوص": نصوص_}
}

دالة _منسوبة(جملة) {
    متغير م = " " + اربط(كلمات_مطبّعة(جملة)، " ") + " "
    من_أجل (ع٠ في _علامات) { إذا (يحوي(م، " " + ع٠ + " ")) { ارجع صحيح } }
    ارجع يحوي(جملة، "«") أو يحوي(جملة، "{")
}

# ما بعد أول علامة نسبة (وإلا الجملة كلها)، بلا صيغ التصلية والترضّي التي تتغير بين الروايات
دالة _ذيل(ك) {
    متغير بداية = ٠
    متغير وجدت = خطأ
    من_أجل (ي في مدى(طول(ك))) {
        إذا (ليس وجدت) {
            من_أجل (ع٠ في _علامات) {
                متغير م٠ = ن.كلمات(ع٠)
                إذا (ليس وجدت و ي + طول(م٠) <= طول(ك)) {
                    متغير ك٠ = []
                    من_أجل (ز في مدى(طول(م٠))) { أضف(ك٠، ك[ي + ز]) }
                    إذا (اربط(ك٠، " ") == ع٠) { وجدت = صحيح ; بداية = ي + طول(م٠) }
                }
            }
        }
    }
    متغير خرج = []
    متغير ي٢ = بداية
    طالما (ي٢ < طول(ك)) {
        متغير تخطى = ٠
        إذا (ي٢ + ٣ < طول(ك) و ك[ي٢] == "صلي" و ك[ي٢ + ١] == "الله" و ك[ي٢ + ٢] == "عليه" و ك[ي٢ + ٣] == "وسلم") { تخطى = ٤ }
        إذا (تخطى == ٠ و ي٢ + ٢ < طول(ك) و ك[ي٢] == "رضي" و ك[ي٢ + ١] == "الله") { تخطى = ٣ }
        إذا (تخطى == ٠ و ي٢ + ١ < طول(ك) و ك[ي٢] == "عليه" و ك[ي٢ + ١] == "السلام") { تخطى = ٢ }
        إذا (تخطى > ٠) { ي٢ = ي٢ + تخطى } وإلا { أضف(خرج، ك[ي٢]) ; ي٢ = ي٢ + ١ }
    }
    ارجع خرج
}

# يقيس نسبة (من عشرة) متتاليات الجملة الموجودة في الفهرس؛ الجملة الأقصر من المتتالية تُقاس بمتتالية بطولها
دالة _قياس(جملة، فهرس) {
    متغير ك = _ذيل(كلمات_مطبّعة(جملة))
    متغير ط = فهرس["ط"]
    إذا (طول(ك) < ٣) { ارجع {"نسبة": ١٠، "مصدر": ""} }
    إذا (طول(ك) < ط) { ط = طول(ك) }
    متغير كلها = ٠
    متغير وُجدت = ٠
    متغير مصدر = ""
    من_أجل (ي في مدى(طول(ك) - ط + ١)) {
        متغير ج = _متتالية(ك، ي، ط)
        كلها = كلها + ١
        إذا (يحوي(فهرس["متتاليات"]، ج)) { وُجدت = وُجدت + ١ ; مصدر = فهرس["متتاليات"][ج] }
    }
    إذا (ط < فهرس["ط"]) {
        # نص قصير: يُقبل إن ورد كاملًا متتاليًا في أحد المصادر
        متغير كامل = " " + اربط(ك، " ") + " "
        من_أجل (ن٠ في فهرس["نصوص"]) { إذا (يحوي(ن٠["نص"]، كامل)) { ارجع {"نسبة": ١٠، "مصدر": ن٠["مصدر"]} } }
        ارجع {"نسبة": ٠، "مصدر": ""}
    }
    ارجع {"نسبة": (وُجدت * ١٠) / كلها، "مصدر": مصدر}
}

# يقسم النص إلى مقاطع تنتهي بفاصلة جملة أو سطر؛ يحفظ الفواصل ليعاد تركيب النص كما هو
دالة _مقاطع(نص_) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في نص_) {
        حالي = حالي + ح
        إذا (ح == "." أو ح == "؟" أو ح == "!" أو ح == "؛" أو ح == حرف(١٠)) { أضف(خرج، حالي) ; حالي = "" }
    }
    إذا (حالي != "") { أضف(خرج، حالي) }
    ارجع خرج
}

# نقّح: المنسوب الموثَّق يبقى بنصه، وغير الموثَّق يُستبدل بعبارة الحذف. مصادر: [{مصدر، نص}]
صدّر دالة نقّح(نص_، مصادر، عبارة_الحذف = "[حُذف نص منسوب لم يثبت في المصادر]") {
    متغير فهرس = ابنِ_فهرس(مصادر، _طول_المتتالية)
    متغير أجزاء = []
    متغير تفاصيل = []
    متغير موثّق = ٠
    متغير محذوف = ٠
    من_أجل (ق في _مقاطع(نص_)) {
        إذا (_منسوبة(ق)) {
            متغير س = _قياس(ق، فهرس)
            إذا (س["نسبة"] >= _حد_القبول) {
                موثّق = موثّق + ١
                أضف(أجزاء، ق)
                أضف(تفاصيل، {"جملة": ن.قصّ(ق)، "حالة": "موثّق"، "مصدر": س["مصدر"]، "نسبة": س["نسبة"]})
            } وإلا {
                محذوف = محذوف + ١
                أضف(أجزاء، عبارة_الحذف + " ")
                أضف(تفاصيل، {"جملة": ن.قصّ(ق)، "حالة": "محذوف"، "مصدر": ""، "نسبة": س["نسبة"]})
            }
        } وإلا { أضف(أجزاء، ق) }
    }
    ارجع {"نص": اربط(أجزاء، "")، "منسوب": موثّق + محذوف، "موثّق": موثّق، "محذوف": محذوف، "تفاصيل": تفاصيل}
}

صدّر دالة سجّل_المحرك() {
    إذا (ليس يحوي(ع.المحركات()، "تحقق_اقتباس")) {
        ع.سجّل(ع.محرك("تحقق_اقتباس"، "تحقق من النص المنسوب: ما لم يثبت حرفيًّا في المصادر يُحذف"، {"نص": "نص"، "مصادر": "قائمة"}، {"نص": "نص"، "منسوب": "عدد"، "موثّق": "عدد"، "محذوف": "عدد"، "تفاصيل": "قائمة"}،
            دالة(م) { ارجع نقّح(م["نص"]، م["مصادر"]) }))
    }
}
