# ضاد/نواة_استرجاع — محرك الاسترجاع: يفهرس وثائق ويجيب الاستعلام بترتيب BM25 فوق رموز المجزِّئ.
# يبني فهرسه بنفسه: يطبّع العربية، يدرّب مجزِّئًا على الوثائق، ثم يخزّن فهرسًا مقلوبًا (رمز ← وثائقه وتكراره).

متغير ن = استورد("ضاد/نصوص")
متغير ت = استورد("ضاد/نواة_مجزئ")
متغير ع = استورد("ضاد/نواة_عقد")

# كلمات وقف شائعة بصورتها المطبَّعة. (اذا ليست منها: هي الكلمة المحجوزة «إذا»)
متغير _وقف = {}
من_أجل (ك في ["في"، "من"، "علي"، "الي"، "عن"، "ان"، "او"، "ما"، "لا"، "هذا"، "هذه"، "ذلك"، "تلك"، "التي"، "الذي"، "الذين"، "هو"، "هي"، "هم"، "كان"، "كانت"، "مع"، "بين"، "كل"، "لم"، "لن"، "قد"، "ثم"، "هل"، "بعد"، "قبل"، "عند"، "حتي"، "ايضا"، "فقط"، "كيف"، "لماذا"، "ماذا"، "لي"، "لك"، "له"، "به"، "بها"، "فيه"، "فيها"، "منه"، "منها"]) {
    _وقف[ك] = صحيح
}

# لوغاريتم طبيعي بالمتسلسلة: يرد x إلى [٠٫٧٥، ١٫٥) بالقسمة على ٢ ثم 2·atanh((x-1)/(x+1))
دالة _لن(س) {
    إذا (س <= ٠) { أطلق_خطأ("لوغاريتم عدد غير موجب") }
    متغير ق = ٠
    متغير ا = س
    طالما (ا >= ١.٥) { ا = ا / ٢; ق = ق + ١ }
    طالما (ا < ٠.٧٥) { ا = ا * ٢; ق = ق - ١ }
    متغير ي = (ا - ١) / (ا + ١)
    متغير ي٢ = ي * ي
    متغير حد = ي
    متغير مجموع = ٠
    من_أجل (ك في مدى(١، ٦٠، ٢)) {
        مجموع = مجموع + حد / ك
        حد = حد * ي٢
    }
    ارجع ٢ * مجموع + ق * ٠.٦٩٣١٤٧١٨٠٥٥٩٩٤٥٣
}

صدّر دالة لوغاريتم(س) { ارجع _لن(س) }

# تطبيع البحث بمرور واحد: يُسقط التشكيل والتطويل، ويوحّد الألف والياء والتاء المربوطة والأرقام، ويصغّر اللاتيني
صدّر دالة طبّع(س) {
    متغير خرج = []
    من_أجل (ح في س) {
        متغير ر = رمز(ح)
        إذا ((ر >= ١٦١١ و ر <= ١٦٣١) أو ر == ١٦٠٠ أو ر == ١٦٤٨) { }
        وإلا إذا (ر == ١٥٧٠ أو ر == ١٥٧١ أو ر == ١٥٧٣ أو ر == ١٦٤٩) { أضف(خرج، "ا") }
        وإلا إذا (ر == ١٦٠٩) { أضف(خرج، "ي") }
        وإلا إذا (ر == ١٥٧٧) { أضف(خرج، "ه") }
        وإلا إذا (ر >= ١٦٣٢ و ر <= ١٦٤١) { أضف(خرج، حرف(ر - ١٦٣٢ + ٤٨)) }
        وإلا إذا (ر >= ١٧٧٦ و ر <= ١٧٨٥) { أضف(خرج، حرف(ر - ١٧٧٦ + ٤٨)) }
        وإلا إذا (ر >= ٦٥ و ر <= ٩٠) { أضف(خرج، حرف(ر + ٣٢)) }
        وإلا { أضف(خرج، ح) }
    }
    ارجع اربط(خرج، "")
}

# رموز الاستعلام أو الوثيقة المفيدة: النص يُطبَّع أولًا، ثم يُجزَّأ، وتُسقَط الرموز الفارغة المعنى
دالة _رموز_مفيدة(نموذج، نص_) {
    متغير خرج = []
    من_أجل (ر في ت.رموز(نموذج، طبّع(نص_))) {
        إذا (ت.رمز_مفيد(ر)) { أضف(خرج، ت.بلا_علامة(ر)) }
    }
    ارجع خرج
}

دالة _بلا_وقف(رموز) {
    متغير خرج = []
    من_أجل (ر في رموز) { إذا (ليس يحوي(_وقف، ر)) { أضف(خرج، ر) } }
    إذا (طول(خرج) == ٠) { ارجع رموز }
    ارجع خرج
}

# وثائق: قائمة خرائط {معرف، عنوان، نص}. العنوان يُفهرَس مرتين ليرجح على النص.
# الفهرسة تشمل كل النص، أما تدريب المجزِّئ فيقتصر على مطلعه (سقف_التدريب).
صدّر دالة ابنِ(وثائق، حجم_المفردات = ٨٠٠، سقف_التدريب = ٤٠٠) {
    إذا (نوع(وثائق) != "قائمة") { أطلق_خطأ("الاسترجاع: الوثائق قائمة خرائط {معرف، عنوان، نص}") }
    متغير نصوص = []
    من_أجل (و_ في وثائق) {
        إذا (نوع(و_) != "خريطة" أو ليس يحوي(و_، "معرف") أو ليس يحوي(و_، "عنوان") أو ليس يحوي(و_، "نص")) {
            أطلق_خطأ("الاسترجاع: كل وثيقة خريطة فيها معرف وعنوان ونص")
        }
        أضف(نصوص، طبّع(و_["عنوان"] + " " + و_["عنوان"] + " " + و_["نص"]))
    }
    # المجزِّئ يتعلّم من مطلع كل وثيقة (حدّه سقف_التدريب حرفًا) لا من كامل نصها، فيبقى التدريب سريعًا
    متغير عيّنة = []
    من_أجل (ص في نصوص) { أضف(عيّنة، اقتطع(ص، ٠، سقف_التدريب)) }
    متغير نموذج = ت.درّب(عيّنة، حجم_المفردات)
    متغير مقلوب = {}
    متغير أطوال = []
    متغير معلومات = []
    متغير مجموع_الأطوال = ٠
    من_أجل (ي في مدى(طول(نصوص))) {
        متغير رموز_الوثيقة = _رموز_مفيدة(نموذج، نصوص[ي])
        أضف(أطوال، طول(رموز_الوثيقة))
        مجموع_الأطوال = مجموع_الأطوال + طول(رموز_الوثيقة)
        أضف(معلومات، {"معرف": وثائق[ي]["معرف"]، "عنوان": وثائق[ي]["عنوان"]})
        من_أجل (ر في رموز_الوثيقة) {
            إذا (ليس يحوي(مقلوب، ر)) { مقلوب[ر] = {} }
            متغير مف = نص(ي)
            إذا (يحوي(مقلوب[ر]، مف)) { مقلوب[ر][مف] = مقلوب[ر][مف] + ١ } وإلا { مقلوب[ر][مف] = ١ }
        }
    }
    متغير متوسط = ٠
    إذا (طول(أطوال) > ٠) { متوسط = مجموع_الأطوال / طول(أطوال) }
    ارجع {"نموذج": نموذج، "مقلوب": مقلوب، "أطوال": أطوال، "وثائق": معلومات، "متوسط_الطول": متوسط}
}

# يعيد أفضل «حد» وثائق: قائمة {معرف، عنوان، درجة} بترتيب الدرجة ثم ترتيب الوثيقة في الفهرس
صدّر دالة ابحث(فهرس، استعلام، حد = ٥) {
    إذا (نوع(فهرس) != "خريطة" أو ليس يحوي(فهرس، "مقلوب") أو ليس يحوي(فهرس، "نموذج")) { أطلق_خطأ("الاسترجاع: فهرس غير صالح؛ أنشئه بالدالة ابنِ") }
    إذا (نوع(استعلام) != "نص") { أطلق_خطأ("الاسترجاع: الاستعلام نص") }
    إذا (نوع(حد) != "رقم" أو حد < ١) { أطلق_خطأ("الاسترجاع: الحد عدد موجب") }
    متغير ك١ = ١.٥
    متغير ب = ٠.٧٥
    متغير ن_ = طول(فهرس["وثائق"])
    متغير مصطلحات = _بلا_وقف(_رموز_مفيدة(فهرس["نموذج"]، استعلام))
    متغير فريدة = {}
    من_أجل (ر في مصطلحات) { فريدة[ر] = صحيح }
    متغير درجات = {}
    من_أجل (ر في مفاتيح(فريدة)) {
        إذا (يحوي(فهرس["مقلوب"]، ر)) {
            متغير وثائق_الرمز = فهرس["مقلوب"][ر]
            متغير ع_ = طول(وثائق_الرمز)
            متغير معامل = _لن(١ + (ن_ - ع_ + ٠.٥) / (ع_ + ٠.٥))
            من_أجل (مف في مفاتيح(وثائق_الرمز)) {
                متغير تك = وثائق_الرمز[مف]
                متغير طول_و = فهرس["أطوال"][عدد(مف)]
                متغير تطبيع = ١ - ب + ب * طول_و / فهرس["متوسط_الطول"]
                متغير جزء = معامل * تك * (ك١ + ١) / (تك + ك١ * تطبيع)
                إذا (يحوي(درجات، مف)) { درجات[مف] = درجات[مف] + جزء } وإلا { درجات[مف] = جزء }
            }
        }
    }
    متغير قائمة = []
    من_أجل (مف في مفاتيح(درجات)) { أضف(قائمة، [عدد(مف)، درجات[مف]]) }
    متغير مرتبة = رتب(قائمة، دالة(أ، ب_) {
        إذا (أ[١] != ب_[١]) { ارجع ب_[١] - أ[١] }
        ارجع أ[٠] - ب_[٠]
    })
    متغير نتائج = []
    من_أجل (ي في مدى(طول(مرتبة))) {
        إذا (ي < حد) {
            متغير وث = فهرس["وثائق"][مرتبة[ي][٠]]
            أضف(نتائج، {"معرف": وث["معرف"]، "عنوان": وث["عنوان"]، "درجة": مرتبة[ي][١]})
        }
    }
    ارجع نتائج
}

صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "استرجاع"،
        "يبحث في فهرس وثائق ويعيد أفضلها بترتيب BM25"،
        {"فهرس": "خريطة"، "استعلام": "نص"، "حد": "رقم"}،
        {"نتائج": "قائمة"}،
        دالة(مدخل) { ارجع {"نتائج": ابحث(مدخل["فهرس"]، مدخل["استعلام"]، مدخل["حد"])} }
    ))
}
