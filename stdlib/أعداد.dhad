# ضاد/أعداد — مكتبة الأعداد، مكتوبة بضاد نفسها
# تقريب وتنسيق عربي، وحساب أعداد، وإحصاء بسيط، وتفقيط (كتابة العدد بالحروف).

دالة _صحيح(ن) {
    ارجع نوع(ن) == "رقم" و ن == أرضية(ن)
}

دالة _يلزم_رقم(اسم، ن) {
    إذا (نوع(ن) != "رقم") { أطلق_خطأ(اسم + "() تحتاج رقمًا") }
}

# ---------- التقريب والتنسيق ----------
صدّر دالة قرّب(ع، منازل) {
    _يلزم_رقم("قرّب"، ع)
    إذا (منازل == لاشيء) { منازل = ٠ }
    متغير م = قوة(١٠، منازل)
    ارجع جولة(ع * م) / م
}

# نسّق(١٢٣٤٥٫٦٧٨، ٢) ترجع «١٢٬٣٤٦٫٦٨»: فاصلة آلاف عربية وفاصلة عشرية عربية
صدّر دالة نسّق(ع، منازل) {
    _يلزم_رقم("نسّق"، ع)
    إذا (منازل == لاشيء) { منازل = ٠ }
    إذا (مطلق(ع) >= قوة(١٠، ١٥)) { أطلق_خطأ("نسّق() تدعم الأعداد الأصغر من ١٠ مرفوعة للقوة ١٥") }
    متغير م = قوة(١٠، منازل)
    متغير كلي = جولة(مطلق(ع) * م)
    متغير ص = أرضية(كلي / م)
    متغير كسر = كلي - ص * م
    متغير أرقام = نص(ص)
    متغير مجموعات = []
    متغير نهاية = طول(أرقام)
    طالما (نهاية > ٠) {
        متغير بداية = نهاية - ٣
        إذا (بداية < ٠) { بداية = ٠ }
        أضف(مجموعات، اقتطع(أرقام، بداية، نهاية))
        نهاية = بداية
    }
    متغير يسار = []
    متغير ي = طول(مجموعات) - ١
    طالما (ي >= ٠) {
        أضف(يسار، مجموعات[ي])
        ي = ي - ١
    }
    متغير ناتج = اربط(يسار، "٬")
    إذا (منازل > ٠) {
        متغير ك = نص(كسر)
        طالما (طول(ك) < منازل) { ك = "٠" + ك }
        ناتج = ناتج + "٫" + ك
    }
    إذا (ع < ٠ و كلي > ٠) { ناتج = "-" + ناتج }
    ارجع ناتج
}

# ---------- حساب الأعداد ----------
صدّر دالة أكبر_قاسم(أ، ب) {
    إذا (ليس _صحيح(أ) أو ليس _صحيح(ب)) { أطلق_خطأ("أكبر_قاسم() تحتاج عددين صحيحين") }
    أ = مطلق(أ)
    ب = مطلق(ب)
    طالما (ب != ٠) {
        متغير ت = أ % ب
        أ = ب
        ب = ت
    }
    ارجع أ
}

صدّر دالة أصغر_مضاعف(أ، ب) {
    إذا (أ == ٠ أو ب == ٠) { ارجع ٠ }
    ارجع مطلق(أ * ب) / أكبر_قاسم(أ، ب)
}

صدّر دالة أولي(ن) {
    إذا (ليس _صحيح(ن)) { أطلق_خطأ("أولي() تحتاج عددًا صحيحًا") }
    إذا (ن < ٢) { ارجع خطأ }
    إذا (ن < ٤) { ارجع صحيح }
    إذا (ن % ٢ == ٠) { ارجع خطأ }
    متغير د = ٣
    طالما (د * د <= ن) {
        إذا (ن % د == ٠) { ارجع خطأ }
        د = د + ٢
    }
    ارجع صحيح
}

صدّر دالة عوامل_أولية(ن) {
    إذا (ليس _صحيح(ن) أو ن < ٢) { أطلق_خطأ("عوامل_أولية() تحتاج عددًا صحيحًا لا يقل عن ٢") }
    متغير ناتج = []
    متغير د = ٢
    طالما (د * د <= ن) {
        طالما (ن % د == ٠) {
            أضف(ناتج، د)
            ن = ن / د
        }
        د = د + ١
    }
    إذا (ن > ١) { أضف(ناتج، ن) }
    ارجع ناتج
}

صدّر دالة عاملي(ن) {
    إذا (ليس _صحيح(ن) أو ن < ٠ أو ن > ١٧٠) { أطلق_خطأ("عاملي() تحتاج عددًا صحيحًا بين ٠ و ١٧٠") }
    متغير ناتج = ١
    من_أجل (ك من ٢ إلى ن) { ناتج = ناتج * ك }
    ارجع ناتج
}

# ---------- إحصاء بسيط ----------
صدّر دالة متوسط(قائمة) {
    إذا (نوع(قائمة) != "قائمة" أو طول(قائمة) == ٠) { أطلق_خطأ("متوسط() تحتاج قائمة فيها أرقام") }
    ارجع جمع(قائمة) / طول(قائمة)
}

صدّر دالة وسيط(قائمة) {
    إذا (نوع(قائمة) != "قائمة" أو طول(قائمة) == ٠) { أطلق_خطأ("وسيط() تحتاج قائمة فيها أرقام") }
    متغير م = رتب(قائمة)
    متغير ن = طول(م)
    متغير نصف = أرضية(ن / ٢)
    إذا (ن % ٢ == ١) { ارجع م[نصف] }
    ارجع (م[نصف - ١] + م[نصف]) / ٢
}

# ---------- التفقيط: كتابة العدد بالحروف ----------
دالة _آحاد() { ارجع ["", "واحد", "اثنان", "ثلاثة", "أربعة", "خمسة", "ستة", "سبعة", "ثمانية", "تسعة"] }
دالة _عشرات_ثانية() { ارجع ["عشرة", "أحد عشر", "اثنا عشر", "ثلاثة عشر", "أربعة عشر", "خمسة عشر", "ستة عشر", "سبعة عشر", "ثمانية عشر", "تسعة عشر"] }
دالة _عقود() { ارجع ["", "", "عشرون", "ثلاثون", "أربعون", "خمسون", "ستون", "سبعون", "ثمانون", "تسعون"] }
دالة _مئات() { ارجع ["", "مئة", "مئتان", "ثلاثمئة", "أربعمئة", "خمسمئة", "ستمئة", "سبعمئة", "ثمانمئة", "تسعمئة"] }

# من ١ إلى ٩٩؛ «معدود» صحيحة حين يتبع العدد اسمًا مذكرًا (أحد وعشرون ألفًا)
دالة _دون_المئة(ن، معدود) {
    إذا (ن < ١٠) { ارجع _آحاد()[ن] }
    إذا (ن < ٢٠) { ارجع _عشرات_ثانية()[ن - ١٠] }
    متغير ع = أرضية(ن / ١٠)
    متغير آد = ن % ١٠
    إذا (آد == ٠) { ارجع _عقود()[ع] }
    متغير وحدة = _آحاد()[آد]
    إذا (آد == ١ و معدود) { وحدة = "أحد" }
    ارجع وحدة + " و" + _عقود()[ع]
}

# من ١ إلى ٩٩٩
دالة _دون_الألف(ن، معدود) {
    متغير م = أرضية(ن / ١٠٠)
    متغير ب = ن % ١٠٠
    إذا (م == ٠) { ارجع _دون_المئة(ب، معدود) }
    إذا (ب == ٠) { ارجع _مئات()[م] }
    ارجع _مئات()[م] + " و" + _دون_المئة(ب، معدود)
}

# تفقيط(٢١٠٠٥) ترجع «أحد وعشرون ألفًا وخمسة». تدعم الأعداد الصحيحة حتى ٩٩٩٩٩،
# لأن قواعد ما فوقها (مثل مئة ألف وما بعده) تختلف فيه المراجع فلا نخمّن.
صدّر دالة تفقيط(ن) {
    إذا (ليس _صحيح(ن)) { أطلق_خطأ("تفقيط() تحتاج عددًا صحيحًا") }
    إذا (مطلق(ن) > ٩٩٩٩٩) { أطلق_خطأ("تفقيط() تدعم حتى ٩٩٩٩٩ حاليًا، لأن قواعد ما فوقه فيها خلاف بين المراجع") }
    إذا (ن == ٠) { ارجع "صفر" }
    إذا (ن < ٠) { ارجع "سالب " + تفقيط(-ن) }
    متغير أجزاء = []
    متغير آلاف = أرضية(ن / ١٠٠٠)
    متغير باقي = ن % ١٠٠٠
    إذا (آلاف > ٠) {
        إذا (آلاف == ١) { أضف(أجزاء، "ألف") }
        وإلا إذا (آلاف == ٢) { أضف(أجزاء، "ألفان") }
        وإلا إذا (آلاف <= ١٠) { أضف(أجزاء، _دون_المئة(آلاف، صحيح) + " آلاف") }
        وإلا { أضف(أجزاء، _دون_المئة(آلاف، صحيح) + " ألفًا") }
    }
    إذا (باقي > ٠) { أضف(أجزاء، _دون_الألف(باقي، خطأ)) }
    ارجع اربط(أجزاء، " و")
}
