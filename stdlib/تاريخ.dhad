# ضاد/تاريخ — التواريخ والأوقات، مكتوبة بضاد نفسها، بالتقويمين الميلادي والهجري
# التاريخ خريطة: {"سنة": ٢٠٢٦، "شهر": ١٠، "يوم": ٢٧}، والتاريخ مع الوقت يزيد عليها: ساعة ودقيقة وثانية وميلي، وإزاحة (بالدقائق) اختيارية.
# القيم لا تتغير: كل دالة ترجع خريطة جديدة ولا تعدّل التي أعطيتها (فكرة أخذناها من تجارب الأعطال القديمة في كائنات التاريخ القابلة للتغيير).
# الشهر من ١ إلى ١٢ (لا ٠ إلى ١١). التقويم الميلادي «ممتد»: يطبّق قواعده الحالية على كل السنوات.
# الأيام تُحسب بخوارزمية التقويم المدني، والهجري «حسابي» (جدولي): قد يخالف الرؤية الفعلية أو أم القرى بيوم.

# ---------- أدوات داخلية ----------
دالة _طابق(اسم، قيمة) {
    إذا (نوع(قيمة) != "رقم" أو قيمة != أرضية(قيمة)) {
        أطلق_خطأ("تاريخ: " + اسم + " يجب أن يكون عددًا صحيحًا (وُجد " + نص(قيمة) + ")")
    }
}

# قسمة صحيحة تقرّب نحو ناقص اللانهاية (تختلف عن / للأعداد السالبة)
دالة _قسم(أ، ب) {
    ارجع أرضية(أ / ب)
}

# باقي القسمة غير السالب
دالة _باقي(أ، ب) {
    ارجع أ - ب * أرضية(أ / ب)
}

دالة _انسخ(خ) {
    متغير ن = {}
    من_أجل (ك في مفاتيح(خ)) { ن[ك] = خ[ك] }
    ارجع ن
}

دالة _يلزم_تاريخ(اسم، د) {
    إذا (نوع(د) != "خريطة" أو د["سنة"] == لاشيء أو د["شهر"] == لاشيء أو د["يوم"] == لاشيء) {
        أطلق_خطأ("تاريخ: " + اسم + "() تحتاج تاريخًا من تاريخ() أو حلّل_أيزو()")
    }
}

دالة _صفر(ن، عرض) {
    متغير س = نص_برمجي(ن)
    طالما (طول(س) < عرض) { س = "0" + س }
    ارجع س
}

# ---------- التقويم الميلادي ----------
صدّر دالة هل_كبيسة(سنة) {
    _طابق("السنة"، سنة)
    ارجع (_باقي(سنة، ٤) == ٠ و _باقي(سنة، ١٠٠) != ٠) أو _باقي(سنة، ٤٠٠) == ٠
}

صدّر دالة أيام_الشهر(سنة، شهر) {
    _طابق("السنة"، سنة)
    _طابق("الشهر"، شهر)
    إذا (شهر < ١ أو شهر > ١٢) { أطلق_خطأ("تاريخ: الشهر يجب أن يكون بين ١ و١٢ (وُجد " + نص(شهر) + ")") }
    إذا (شهر == ٢) {
        إذا (هل_كبيسة(سنة)) { ارجع ٢٩ }
        ارجع ٢٨
    }
    إذا (شهر == ٤ أو شهر == ٦ أو شهر == ٩ أو شهر == ١١) { ارجع ٣٠ }
    ارجع ٣١
}

# عدد الأيام منذ ١٩٧٠-٠١-٠١ (قد يكون سالبًا قبلها). بلا تحقق: للاستعمال الداخلي
دالة _أيام_من(س، ش، ي) {
    متغير ع = س
    إذا (ش <= ٢) { ع = ع - ١ }
    متغير حقبة = _قسم(ع، ٤٠٠)
    متغير سح = ع - حقبة * ٤٠٠
    متغير ك = ش - ٣
    إذا (ش <= ٢) { ك = ش + ٩ }
    متغير يس = _قسم(١٥٣ * ك + ٢، ٥) + ي - ١
    متغير يح = سح * ٣٦٥ + _قسم(سح، ٤) - _قسم(سح، ١٠٠) + يس
    ارجع حقبة * ١٤٦٠٩٧ + يح - ٧١٩٤٦٨
}

# عكس الدالة السابقة: يرجع [سنة، شهر، يوم]
دالة _من_أيام(ز) {
    متغير ن = ز + ٧١٩٤٦٨
    متغير حقبة = _قسم(ن، ١٤٦٠٩٧)
    متغير يح = ن - حقبة * ١٤٦٠٩٧
    متغير سح = _قسم(يح - _قسم(يح، ١٤٦٠) + _قسم(يح، ٣٦٥٢٤) - _قسم(يح، ١٤٦٠٩٦)، ٣٦٥)
    متغير س = سح + حقبة * ٤٠٠
    متغير يس = يح - (٣٦٥ * سح + _قسم(سح، ٤) - _قسم(سح، ١٠٠))
    متغير مس = _قسم(٥ * يس + ٢، ١٥٣)
    متغير ي = يس - _قسم(١٥٣ * مس + ٢، ٥) + ١
    متغير ش = مس + ٣
    إذا (مس >= ١٠) { ش = مس - ٩ }
    إذا (ش <= ٢) { س = س + ١ }
    ارجع [س، ش، ي]
}

دالة _ابنِ(ق، س، ش، ي) {
    متغير ن = _انسخ(ق)
    ن["سنة"] = س
    ن["شهر"] = ش
    ن["يوم"] = ي
    ارجع ن
}

دالة _تحقق_تاريخ(س، ش، ي) {
    _طابق("السنة"، س)
    _طابق("الشهر"، ش)
    _طابق("اليوم"، ي)
    إذا (س < -٢٧٥٠٠٠ أو س > ٢٧٥٠٠٠) { أطلق_خطأ("تاريخ: السنة خارج المدى المدعوم (±٢٧٥٠٠٠)") }
    متغير ن = أيام_الشهر(س، ش)
    إذا (ي < ١ أو ي > ن) {
        أطلق_خطأ("تاريخ: اليوم يجب أن يكون بين ١ و" + نص(ن) + " في هذا الشهر (وُجد " + نص(ي) + ")")
    }
}

# تاريخ(٢٠٢٦، ١٠، ٢٧): يرفض ما لا وجود له مثل ٣٠ فبراير بدل أن «يلفّ» إلى مارس بصمت
صدّر دالة تاريخ(سنة، شهر، يوم) {
    _تحقق_تاريخ(سنة، شهر، يوم)
    ارجع {"سنة": سنة، "شهر": شهر، "يوم": يوم}
}

# تاريخ مع وقت. الإزاحة بالدقائق عن التوقيت العالمي (٠ = عالمي، ١٨٠ = +٠٣:٠٠)، وإن حُذفت فالوقت «محلي بلا منطقة»
صدّر دالة تاريخ_ووقت(سنة، شهر، يوم، ساعة = ٠، دقيقة = ٠، ثانية = ٠، ميلي = ٠، إزاحة = لاشيء) {
    _تحقق_تاريخ(سنة، شهر، يوم)
    _طابق("الساعة"، ساعة)
    _طابق("الدقيقة"، دقيقة)
    _طابق("الثانية"، ثانية)
    _طابق("الميلي"، ميلي)
    إذا (ساعة < ٠ أو ساعة > ٢٣) { أطلق_خطأ("تاريخ: الساعة يجب أن تكون بين ٠ و٢٣ (وُجد " + نص(ساعة) + ")") }
    إذا (دقيقة < ٠ أو دقيقة > ٥٩) { أطلق_خطأ("تاريخ: الدقيقة يجب أن تكون بين ٠ و٥٩ (وُجد " + نص(دقيقة) + ")") }
    إذا (ثانية < ٠ أو ثانية > ٥٩) { أطلق_خطأ("تاريخ: الثانية يجب أن تكون بين ٠ و٥٩ (وُجد " + نص(ثانية) + ")") }
    إذا (ميلي < ٠ أو ميلي > ٩٩٩) { أطلق_خطأ("تاريخ: الميلي يجب أن يكون بين ٠ و٩٩٩ (وُجد " + نص(ميلي) + ")") }
    متغير د = {"سنة": سنة، "شهر": شهر، "يوم": يوم، "ساعة": ساعة، "دقيقة": دقيقة، "ثانية": ثانية، "ميلي": ميلي}
    إذا (إزاحة != لاشيء) {
        _طابق("الإزاحة"، إزاحة)
        إذا (إزاحة < -١٠٨٠ أو إزاحة > ١٠٨٠) { أطلق_خطأ("تاريخ: الإزاحة يجب أن تكون بين -١٠٨٠ و١٠٨٠ دقيقة") }
        د["إزاحة"] = إزاحة
    }
    ارجع د
}

صدّر دالة رقم_اليوم(د) {
    _يلزم_تاريخ("رقم_اليوم"، د)
    ارجع _أيام_من(د["سنة"]، د["شهر"]، د["يوم"])
}

صدّر دالة من_رقم_اليوم(ن) {
    _طابق("رقم اليوم"، ن)
    متغير ت = _من_أيام(ن)
    ارجع {"سنة": ت[٠]، "شهر": ت[١]، "يوم": ت[٢]}
}

# ١ = الاثنين … ٧ = الأحد (ترقيم أيزو)
صدّر دالة يوم_الأسبوع(د) {
    ارجع _باقي(رقم_اليوم(د) + ٣، ٧) + ١
}

صدّر دالة ترتيب_اليوم_في_السنة(د) {
    _يلزم_تاريخ("ترتيب_اليوم_في_السنة"، د)
    ارجع _أيام_من(د["سنة"]، د["شهر"]، د["يوم"]) - _أيام_من(د["سنة"]، ١، ١) + ١
}

# أسبوع أيزو: يرجع {"سنة": …، "أسبوع": …}. يبدأ الأسبوع الاثنين، وأسبوعه الأول يحوي أول خميس في السنة
صدّر دالة أسبوع_أيزو(د) {
    متغير خميس = أضف_أياما(د، ٤ - يوم_الأسبوع(د))
    متغير ر = ترتيب_اليوم_في_السنة(خميس)
    ارجع {"سنة": خميس["سنة"]، "أسبوع": _قسم(ر - ١، ٧) + ١}
}

# ---------- الحساب ----------
صدّر دالة أضف_أياما(د، ن) {
    _يلزم_تاريخ("أضف_أياما"، د)
    _طابق("عدد الأيام"، ن)
    متغير ت = _من_أيام(رقم_اليوم(د) + ن)
    ارجع _ابنِ(د، ت[٠]، ت[١]، ت[٢])
}

# إن لم يوجد اليوم في الشهر الناتج (٣١ مارس + شهر) رجع آخر يوم فيه، لا بداية الشهر التالي
صدّر دالة أضف_أشهرا(د، ن) {
    _يلزم_تاريخ("أضف_أشهرا"، د)
    _طابق("عدد الأشهر"، ن)
    متغير كلي = د["سنة"] * ١٢ + (د["شهر"] - ١) + ن
    متغير س = _قسم(كلي، ١٢)
    متغير ش = كلي - س * ١٢ + ١
    متغير ي = د["يوم"]
    متغير آخر = أيام_الشهر(س، ش)
    إذا (ي > آخر) { ي = آخر }
    ارجع _ابنِ(د، س، ش، ي)
}

صدّر دالة أضف_سنوات(د، ن) {
    _طابق("عدد السنوات"، ن)
    ارجع أضف_أشهرا(د، ن * ١٢)
}

صدّر دالة بداية_الشهر(د) {
    _يلزم_تاريخ("بداية_الشهر"، د)
    ارجع _ابنِ(د، د["سنة"]، د["شهر"]، ١)
}

صدّر دالة نهاية_الشهر(د) {
    _يلزم_تاريخ("نهاية_الشهر"، د)
    ارجع _ابنِ(د، د["سنة"]، د["شهر"]، أيام_الشهر(د["سنة"]، د["شهر"]))
}

# عدد الأيام من أ إلى ب (موجب إن كان ب بعد أ). يقارن التواريخ فقط ويتجاهل الوقت
صدّر دالة فرق_الأيام(أ، ب) {
    ارجع رقم_اليوم(ب) - رقم_اليوم(أ)
}

# ---------- الوقت والطابع الزمني ----------
دالة _مللي_اليوم(د) {
    إذا (د["ساعة"] == لاشيء) { ارجع ٠ }
    ارجع د["ساعة"] * ٣٦٠٠٠٠٠ + د["دقيقة"] * ٦٠٠٠٠ + د["ثانية"] * ١٠٠٠ + د["ميلي"]
}

# الطابع الزمني: ملّي ثانية منذ ١٩٧٠-٠١-٠١ بالتوقيت العالمي. الوقت بلا إزاحة يُعامل كأنه عالمي
صدّر دالة إلى_طابع(د) {
    _يلزم_تاريخ("إلى_طابع"، د)
    متغير ز = رقم_اليوم(د) * ٨٦٤٠٠٠٠٠ + _مللي_اليوم(د)
    إذا (د["إزاحة"] != لاشيء) { ز = ز - د["إزاحة"] * ٦٠٠٠٠ }
    ارجع ز
}

صدّر دالة من_طابع(ز، إزاحة = ٠) {
    _طابق("الطابع الزمني"، ز)
    _طابق("الإزاحة"، إزاحة)
    متغير م = ز + إزاحة * ٦٠٠٠٠
    متغير ي = _قسم(م، ٨٦٤٠٠٠٠٠)
    متغير ب = م - ي * ٨٦٤٠٠٠٠٠
    متغير ت = _من_أيام(ي)
    ارجع {"سنة": ت[٠]، "شهر": ت[١]، "يوم": ت[٢]، "ساعة": _قسم(ب، ٣٦٠٠٠٠٠)، "دقيقة": _قسم(_باقي(ب، ٣٦٠٠٠٠٠)، ٦٠٠٠٠)، "ثانية": _قسم(_باقي(ب، ٦٠٠٠٠)، ١٠٠٠)، "ميلي": _باقي(ب، ١٠٠٠)، "إزاحة": إزاحة}
}

# الآن بالتوقيت العالمي (هذه الدالة الوحيدة التي تتغير نتيجتها مع الزمن)
صدّر دالة الآن() {
    ارجع من_طابع(الوقت()، ٠)
}

صدّر دالة اليوم() {
    متغير ن = الآن()
    ارجع {"سنة": ن["سنة"]، "شهر": ن["شهر"]، "يوم": ن["يوم"]}
}

# يغيّر إزاحة وقت له إزاحة، مع بقاء اللحظة نفسها
صدّر دالة بإزاحة(د، إزاحة) {
    إذا (د["إزاحة"] == لاشيء) { أطلق_خطأ("تاريخ: بإزاحة() تحتاج وقتًا له إزاحة") }
    ارجع من_طابع(إلى_طابع(د)، إزاحة)
}

صدّر دالة أضف_ثواني(د، ن) {
    _يلزم_تاريخ("أضف_ثواني"، د)
    _طابق("عدد الثواني"، ن)
    إذا (د["ساعة"] == لاشيء) { أطلق_خطأ("تاريخ: أضف_ثواني() تحتاج تاريخًا مع وقت") }
    # الإزاحة ثابتة فنضيف على الوقت المكتوب نفسه ثم نُبقي الإزاحة كما كانت
    متغير ر = من_طابع(رقم_اليوم(د) * ٨٦٤٠٠٠٠٠ + _مللي_اليوم(د) + ن * ١٠٠٠، ٠)
    إذا (د["إزاحة"] != لاشيء) {
        ر["إزاحة"] = د["إزاحة"]
    } وإلا {
        احذف(ر، "إزاحة")
    }
    ارجع ر
}

# -١ إن كان أ قبل ب، ٠ إن تساويا، ١ إن كان بعده. إن كان لكليهما إزاحة قورنت اللحظتان، وإلا قورن الوقت المكتوب
صدّر دالة قارن(أ، ب) {
    _يلزم_تاريخ("قارن"، أ)
    _يلزم_تاريخ("قارن"، ب)
    متغير س = ٠
    إذا (أ["إزاحة"] != لاشيء و ب["إزاحة"] != لاشيء) {
        س = إلى_طابع(أ) - إلى_طابع(ب)
    } وإلا {
        س = (رقم_اليوم(أ) - رقم_اليوم(ب)) * ٨٦٤٠٠٠٠٠ + _مللي_اليوم(أ) - _مللي_اليوم(ب)
    }
    إذا (س < ٠) { ارجع -١ }
    إذا (س > ٠) { ارجع ١ }
    ارجع ٠
}

# ---------- أيزو ٨٦٠١ ----------
صدّر دالة نسّق_أيزو(د) {
    _يلزم_تاريخ("نسّق_أيزو"، د)
    إذا (د["سنة"] < ٠ أو د["سنة"] > ٩٩٩٩) { أطلق_خطأ("تاريخ: نص أيزو يدعم السنوات من ٠ إلى ٩٩٩٩ فقط") }
    متغير ن = _صفر(د["سنة"]، ٤) + "-" + _صفر(د["شهر"]، ٢) + "-" + _صفر(د["يوم"]، ٢)
    إذا (د["ساعة"] == لاشيء) { ارجع ن }
    ن = ن + "T" + _صفر(د["ساعة"]، ٢) + ":" + _صفر(د["دقيقة"]، ٢) + ":" + _صفر(د["ثانية"]، ٢)
    إذا (د["ميلي"] != ٠) { ن = ن + "." + _صفر(د["ميلي"]، ٣) }
    إذا (د["إزاحة"] != لاشيء) {
        إذا (د["إزاحة"] == ٠) {
            ن = ن + "Z"
        } وإلا {
            متغير ع = مطلق(د["إزاحة"])
            متغير إش = "+"
            إذا (د["إزاحة"] < ٠) { إش = "-" }
            ن = ن + إش + _صفر(_قسم(ع، ٦٠)، ٢) + ":" + _صفر(_باقي(ع، ٦٠)، ٢)
        }
    }
    ارجع ن
}

دالة _رقم_ثابت(س، بداية، كم، ما) {
    إذا (بداية + كم > طول(س)) { أطلق_خطأ("تاريخ: نص أيزو ناقص: " + ما) }
    متغير أ = ٠
    متغير ي = ٠
    طالما (ي < كم) {
        متغير ر = رمز(س[بداية + ي])
        إذا (ر < ٤٨ أو ر > ٥٧) { أطلق_خطأ("تاريخ: نص أيزو غير صالح: " + ما + " يلزمه " + نص(كم) + " أرقام لاتينية") }
        أ = أ * ١٠ + (ر - ٤٨)
        ي = ي + ١
    }
    ارجع أ
}

دالة _علامة(س، م، ح) {
    إذا (م >= طول(س) أو س[م] != ح) { أطلق_خطأ("تاريخ: نص أيزو غير صالح: يلزم «" + ح + "» عند الموضع " + نص(م + ١)) }
}

# حلّل_أيزو("٢٠٢٦-١٠-٢٧") أو ("2026-10-27T14:30:00Z") أو ("2026-10-27T14:30:00.5+03:00"). الأرقام لاتينية والصيغة الموسّعة فقط
صدّر دالة حلّل_أيزو(س) {
    إذا (نوع(س) != "نص") { أطلق_خطأ("تاريخ: حلّل_أيزو() تحتاج نصًّا") }
    متغير ن = طول(س)
    متغير سنة = _رقم_ثابت(س، ٠، ٤، "السنة")
    _علامة(س، ٤، "-")
    متغير شهر = _رقم_ثابت(س، ٥، ٢، "الشهر")
    _علامة(س، ٧، "-")
    متغير يوم = _رقم_ثابت(س، ٨، ٢، "اليوم")
    إذا (ن == ١٠) { ارجع تاريخ(سنة، شهر، يوم) }
    _علامة(س، ١٠، "T")
    متغير ساعة = _رقم_ثابت(س، ١١، ٢، "الساعة")
    _علامة(س، ١٣، ":")
    متغير دقيقة = _رقم_ثابت(س، ١٤، ٢، "الدقيقة")
    _علامة(س، ١٦، ":")
    متغير ثانية = _رقم_ثابت(س، ١٧، ٢، "الثانية")
    متغير م = ١٩
    متغير ميلي = ٠
    إذا (م < ن و س[م] == ".") {
        م = م + ١
        متغير ب = م
        متغير مقام = ١٠٠
        طالما (م < ن) {
            متغير ر = رمز(س[م])
            إذا (ر < ٤٨ أو ر > ٥٧) { توقف }
            إذا (مقام >= ١) {
                ميلي = ميلي + (ر - ٤٨) * مقام
                مقام = مقام / ١٠
                إذا (مقام < ١) { مقام = ٠ }
            }
            م = م + ١
        }
        إذا (م == ب) { أطلق_خطأ("تاريخ: نص أيزو غير صالح: لا بدّ من رقم بعد الفاصلة العشرية") }
    }
    متغير إزاحة = لاشيء
    إذا (م < ن) {
        إذا (س[م] == "Z") {
            إزاحة = ٠
            م = م + ١
        } وإلا إذا (س[م] == "+" أو س[م] == "-") {
            متغير إش = ١
            إذا (س[م] == "-") { إش = -١ }
            متغير سع = _رقم_ثابت(س، م + ١، ٢، "ساعات الإزاحة")
            _علامة(س، م + ٣، ":")
            متغير دق = _رقم_ثابت(س، م + ٤، ٢، "دقائق الإزاحة")
            إذا (دق > ٥٩) { أطلق_خطأ("تاريخ: دقائق الإزاحة بين ٠ و٥٩") }
            إزاحة = إش * (سع * ٦٠ + دق)
            م = م + ٦
        }
    }
    إذا (م != ن) { أطلق_خطأ("تاريخ: نص زائد بعد نهاية الوقت في نص أيزو") }
    ارجع تاريخ_ووقت(سنة، شهر، يوم، ساعة، دقيقة، ثانية، ميلي، إزاحة)
}

صدّر دالة صالح_أيزو(س) {
    إذا (نوع(س) != "نص") { ارجع خطأ }
    متغير ن = خطأ
    حاول {
        حلّل_أيزو(س)
        ن = صحيح
    } التقط (خ) {
        ن = خطأ
    }
    ارجع ن
}

# ---------- الأسماء العربية ----------
دالة _أسماء_الأشهر(نظام) {
    إذا (نظام == "شامي") {
        ارجع ["كانون الثاني"، "شباط"، "آذار"، "نيسان"، "أيار"، "حزيران"، "تموز"، "آب"، "أيلول"، "تشرين الأول"، "تشرين الثاني"، "كانون الأول"]
    }
    إذا (نظام == "مغاربي") {
        ارجع ["جانفي"، "فيفري"، "مارس"، "أفريل"، "ماي"، "جوان"، "جويلية"، "أوت"، "سبتمبر"، "أكتوبر"، "نوفمبر"، "ديسمبر"]
    }
    إذا (نظام != "عام" و نظام != لاشيء) {
        أطلق_خطأ("تاريخ: نظام الأسماء «" + نص(نظام) + "» غير معروف، الأنظمة: عام، شامي، مغاربي")
    }
    ارجع ["يناير"، "فبراير"، "مارس"، "أبريل"، "مايو"، "يونيو"، "يوليو"، "أغسطس"، "سبتمبر"، "أكتوبر"، "نوفمبر"، "ديسمبر"]
}

# اسم الشهر الميلادي. النظام: «عام» (يناير…) أو «شامي» (كانون الثاني…) أو «مغاربي» (جانفي…)
صدّر دالة اسم_الشهر(شهر، نظام = "عام") {
    _طابق("الشهر"، شهر)
    إذا (شهر < ١ أو شهر > ١٢) { أطلق_خطأ("تاريخ: الشهر يجب أن يكون بين ١ و١٢ (وُجد " + نص(شهر) + ")") }
    ارجع _أسماء_الأشهر(نظام)[شهر - ١]
}

# اسم اليوم من ترقيم أيزو: ١ الاثنين … ٧ الأحد
صدّر دالة اسم_اليوم(رقم) {
    _طابق("رقم اليوم"، رقم)
    إذا (رقم < ١ أو رقم > ٧) { أطلق_خطأ("تاريخ: رقم يوم الأسبوع بين ١ (الاثنين) و٧ (الأحد)") }
    ارجع ["الاثنين"، "الثلاثاء"، "الأربعاء"، "الخميس"، "الجمعة"، "السبت"، "الأحد"][رقم - ١]
}

# «الثلاثاء ٢٧ أكتوبر ٢٠٢٦» (والأرقام هندية كما تطبعها ضاد)
صدّر دالة نسّق_عربي(د، نظام = "عام") {
    _يلزم_تاريخ("نسّق_عربي"، د)
    ارجع اسم_اليوم(يوم_الأسبوع(د)) + " " + نص(د["يوم"]) + " " + اسم_الشهر(د["شهر"]، نظام) + " " + نص(د["سنة"])
}

# ---------- التقويم الهجري (حسابي/جدولي) ----------
# الحساب مأخوذ من الدورة الثلاثينية: ١١ سنة كبيسة من كل ٣٠. 
# أول محرم من سنة ١ هـ = الجمعة ١٦ يوليو ٦٢٢م بالتقويم اليولياني = ١٩ يوليو ٦٢٢م بالميلادي الممتد (رقم اليوم -٤٩٢١٤٨).
# ملاحظة مهمة: هذا حساب فلكي-مدني منتظم. الرؤية الفعلية وتقويم أم القرى قد يخالفانه بيوم أو يومين.
صدّر دالة هل_كبيسة_هجرية(سنة) {
    _طابق("السنة"، سنة)
    ارجع _باقي(١٤ + ١١ * سنة، ٣٠) < ١١
}

صدّر دالة أيام_الشهر_الهجري(سنة، شهر) {
    _طابق("السنة"، سنة)
    _طابق("الشهر"، شهر)
    إذا (شهر < ١ أو شهر > ١٢) { أطلق_خطأ("تاريخ: الشهر الهجري يجب أن يكون بين ١ و١٢ (وُجد " + نص(شهر) + ")") }
    إذا (شهر % ٢ == ١) { ارجع ٣٠ }
    إذا (شهر == ١٢ و هل_كبيسة_هجرية(سنة)) { ارجع ٣٠ }
    ارجع ٢٩
}

# عدد الأيام منذ ١٩٧٠-٠١-٠١ لتاريخ هجري (بلا تحقق)
دالة _أيام_من_هجري(س، ش، ي) {
    ارجع ي + سقف(٢٩٫٥ * (ش - ١)) + (س - ١) * ٣٥٤ + _قسم(٣ + ١١ * س، ٣٠) - ٤٩٢١٤٨ - ١
}

# يرجع تاريخًا هجريًا: {"سنة"، "شهر"، "يوم"، "تقويم": "هجري"}
صدّر دالة إلى_هجري(د) {
    متغير ز = رقم_اليوم(د)
    متغير أول = -٤٩٢١٤٨
    متغير س = _قسم(٣٠ * (ز - أول) + ١٠٦٤٦، ١٠٦٣١)
    متغير ش = سقف((ز - (٢٩ + _أيام_من_هجري(س، ١، ١))) / ٢٩٫٥) + ١
    إذا (ش > ١٢) { ش = ١٢ }
    متغير ي = ز - _أيام_من_هجري(س، ش، ١) + ١
    ارجع {"سنة": س، "شهر": ش، "يوم": ي، "تقويم": "هجري"}
}

# من تاريخ هجري إلى ميلادي. يرفض يومًا لا وجود له (٣٠ صفر مثلًا)
صدّر دالة من_هجري(ه) {
    _يلزم_تاريخ("من_هجري"، ه)
    _طابق("السنة"، ه["سنة"])
    _طابق("اليوم"، ه["يوم"])
    متغير ن = أيام_الشهر_الهجري(ه["سنة"]، ه["شهر"])
    إذا (ه["يوم"] < ١ أو ه["يوم"] > ن) {
        أطلق_خطأ("تاريخ: اليوم الهجري يجب أن يكون بين ١ و" + نص(ن) + " في هذا الشهر (وُجد " + نص(ه["يوم"]) + ")")
    }
    ارجع من_رقم_اليوم(_أيام_من_هجري(ه["سنة"]، ه["شهر"]، ه["يوم"]))
}

صدّر دالة اسم_الشهر_الهجري(شهر) {
    _طابق("الشهر"، شهر)
    إذا (شهر < ١ أو شهر > ١٢) { أطلق_خطأ("تاريخ: الشهر الهجري يجب أن يكون بين ١ و١٢ (وُجد " + نص(شهر) + ")") }
    ارجع ["محرم"، "صفر"، "ربيع الأول"، "ربيع الآخر"، "جمادى الأولى"، "جمادى الآخرة"، "رجب"، "شعبان"، "رمضان"، "شوال"، "ذو القعدة"، "ذو الحجة"][شهر - ١]
}

# «١٥ ربيع الآخر ١٤٤٨ هـ»
صدّر دالة نسّق_هجري(ه) {
    _يلزم_تاريخ("نسّق_هجري"، ه)
    ارجع نص(ه["يوم"]) + " " + اسم_الشهر_الهجري(ه["شهر"]) + " " + نص(ه["سنة"]) + " هـ"
}
