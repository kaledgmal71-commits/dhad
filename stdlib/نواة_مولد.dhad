# ضاد/نواة_مولد — مُصدِر شيفرة ضاد من مواصفة دالة (ت١): مواصفة ← نص دالة كاملة.
# المواصفة خريطة: {عائلة، اسم، معاملات، ...}؛ العائلات: قائمة، مدى، محمول، أرقام، نص، صيغة.
# مستقل عن أي استرجاع: يبني الشيفرة تركيبًا من مكوّنات (مصدر ← مرشِّح ← تحويل ← اختزال). صحته تُفحص بمقارنة ناتجه المنفَّذ
# بمُحكَّم دلالي مستقل (tools/t1_space.js) على آلاف المواصفات، لا بالثقة بالقراءة.

دالة _مسافة(ن) {
    متغير خ = ""
    من_أجل (ي في مدى(ن)) { خ = خ + "    " }
    ارجع خ
}

دالة _أزح(سطور، ن) {
    متغير خ = []
    من_أجل (س في سطور) { أضف(خ، _مسافة(ن) + س) }
    ارجع خ
}

دالة _أضف_كل(هدف، مصدر) {
    من_أجل (س في مصدر) { أضف(هدف، س) }
}

# يختار اسمًا محليًّا لا يصطدم بمعامل ولا باسم سابق
دالة _طازج(محجوز، مرشحون) {
    من_أجل (ا في مرشحون) {
        إذا (ليس يحوي(محجوز، ا)) {
            أضف(محجوز، ا)
            ارجع ا
        }
    }
    ارجع "ز٩"
}

دالة _ثابت(ك) {
    إذا (يحوي(ك، "معامل")) { ارجع ك["معامل"] }
    متغير ق = ك["قيمة"]
    إذا (ق < ٠) { ارجع "(" + نص(ق) + ")" }
    ارجع نص(ق)
}

دالة _شرط(نوع، ع، ك) {
    إذا (نوع == "زوجي") { ارجع ع + " % 2 == 0" }
    إذا (نوع == "فردي") { ارجع ع + " % 2 != 0" }
    إذا (نوع == "موجب") { ارجع ع + " > 0" }
    إذا (نوع == "سالب") { ارجع ع + " < 0" }
    إذا (نوع == "غير_صفر") { ارجع ع + " != 0" }
    إذا (نوع == "صفر") { ارجع ع + " == 0" }
    إذا (نوع == "أكبر") { ارجع ع + " > " + _ثابت(ك) }
    إذا (نوع == "أكبر_أو_يساوي") { ارجع ع + " >= " + _ثابت(ك) }
    إذا (نوع == "أصغر") { ارجع ع + " < " + _ثابت(ك) }
    إذا (نوع == "أصغر_أو_يساوي") { ارجع ع + " <= " + _ثابت(ك) }
    إذا (نوع == "يساوي") { ارجع ع + " == " + _ثابت(ك) }
    إذا (نوع == "يقبل_القسمة") { ارجع ع + " % " + _ثابت(ك) + " == 0" }
    ارجع لاشيء
}

دالة _تحويل(نوع، ع، ك) {
    إذا (نوع == "مربع") { ارجع ع + " * " + ع }
    إذا (نوع == "مكعب") { ارجع ع + " * " + ع + " * " + ع }
    إذا (نوع == "ضعف") { ارجع ع + " * 2" }
    إذا (نوع == "ثلاثة_أمثال") { ارجع ع + " * 3" }
    إذا (نوع == "سالب") { ارجع "0 - " + ع }
    إذا (نوع == "مطلق") { ارجع "مطلق(" + ع + ")" }
    إذا (نوع == "زائد") { ارجع ع + " + " + _ثابت(ك) }
    إذا (نوع == "ضرب") { ارجع ع + " * " + _ثابت(ك) }
    ارجع ع
}

دالة _رأس(م) { ارجع "دالة " + م["اسم"] + "(" + اربط(م["معاملات"]، "، ") + ") {" }

دالة _علبة(م، جسم) {
    متغير خ = [_رأس(م)]
    _أضف_كل(خ، _أزح(جسم، ١))
    أضف(خ، "}")
    ارجع اربط(خ، حرف(١٠))
}

دالة _نسخ(قائمة_) {
    متغير خ = []
    من_أجل (س في قائمة_) { أضف(خ، س) }
    ارجع خ
}

# ===== مسار (قائمة أو مدى) =====
دالة _مسار(م) {
    متغير محجوز = _نسخ(م["معاملات"])
    متغير ع = _طازج(محجوز، ["ع"، "ي"، "ب٢"])
    متغير ح = _طازج(محجوز، ["م"، "ن٢"، "ج٢"])
    متغير ك٢ = _طازج(محجوز، ["ك٢"، "ت٢"])
    متغير قيم_ = _طازج(محجوز، ["ق٢"، "ف٢"، "ص٢"])
    متغير اخ = م["اختزال"]["نوع"]
    متغير مر = م["مرشح"]
    متغير تح = م["تحويل"]
    متغير جسم = []
    متغير ق٣ = ع
    متغير داخل = []
    إذا (تح["نوع"] != "بلا") {
        أضف(داخل، "متغير " + قيم_ + " = " + _تحويل(تح["نوع"]، ع، (يحوي(تح، "ك")) ? تح["ك"] : لاشيء))
        ق٣ = قيم_
    }
    إذا (اخ == "مجموع") { أضف(داخل، ح + " = " + ح + " + " + ق٣) }
    إذا (اخ == "ضرب") { أضف(داخل، ح + " = " + ح + " * " + ق٣) }
    إذا (اخ == "عدد") { أضف(داخل، ح + " = " + ح + " + 1") }
    إذا (اخ == "متوسط") {
        أضف(داخل، ح + " = " + ح + " + " + ق٣)
        أضف(داخل، ك٢ + " = " + ك٢ + " + 1")
    }
    إذا (اخ == "قائمة") { أضف(داخل، "أضف(" + ح + "، " + ق٣ + ")") }
    إذا (اخ == "أكبر" أو اخ == "أصغر") {
        متغير مقارن = ">"
        إذا (اخ == "أصغر") { مقارن = "<" }
        أضف(داخل، "إذا (" + ح + " == لاشيء) {")
        أضف(داخل، "    " + ح + " = " + ق٣)
        أضف(داخل، "} وإلا إذا (" + ق٣ + " " + مقارن + " " + ح + ") {")
        أضف(داخل، "    " + ح + " = " + ق٣)
        أضف(داخل، "}")
    }
    إذا (اخ == "أول") {
        أضف(داخل، "إذا (" + ح + " == لاشيء) {")
        أضف(داخل، "    " + ح + " = " + ق٣)
        أضف(داخل، "}")
    }
    إذا (اخ == "آخر") { أضف(داخل، ح + " = " + ق٣) }
    إذا (اخ == "يوجد") { أضف(داخل، ح + " = صحيح") }
    متغير شرط_ = _شرط(مر["نوع"]، ع، (يحوي(مر، "ك")) ? مر["ك"] : لاشيء)
    إذا (اخ == "الكل") {
        أضف(جسم، "متغير " + ح + " = صحيح")
    } وإلا إذا (اخ == "قائمة") {
        أضف(جسم، "متغير " + ح + " = []")
    } وإلا إذا (اخ == "مجموع" أو اخ == "عدد" أو اخ == "متوسط") {
        أضف(جسم، "متغير " + ح + " = 0")
    } وإلا إذا (اخ == "ضرب") {
        أضف(جسم، "متغير " + ح + " = 1")
    } وإلا إذا (اخ == "يوجد") {
        أضف(جسم، "متغير " + ح + " = خطأ")
    } وإلا {
        أضف(جسم، "متغير " + ح + " = لاشيء")
    }
    إذا (اخ == "متوسط") { أضف(جسم، "متغير " + ك٢ + " = 0") }
    متغير رأس_حلقة = ""
    إذا (م["عائلة"] == "قائمة") {
        رأس_حلقة = "من_أجل (" + ع + " في " + م["معاملات"][٠] + ") {"
    } وإلا {
        رأس_حلقة = "من_أجل (" + ع + " من 1 إلى " + م["معاملات"][٠] + ") {"
    }
    أضف(جسم، رأس_حلقة)
    إذا (اخ == "الكل") {
        أضف(جسم، "    إذا (ليس (" + شرط_ + ")) {")
        أضف(جسم، "        " + ح + " = خطأ")
        أضف(جسم، "    }")
    } وإلا إذا (مر["نوع"] == "بلا") {
        _أضف_كل(جسم، _أزح(داخل، ١))
    } وإلا {
        أضف(جسم، "    إذا (" + شرط_ + ") {")
        _أضف_كل(جسم، _أزح(داخل، ٢))
        أضف(جسم، "    }")
    }
    أضف(جسم، "}")
    إذا (اخ == "متوسط") { أضف(جسم، "ارجع " + ح + " / " + ك٢) } وإلا { أضف(جسم، "ارجع " + ح) }
    ارجع _علبة(م، جسم)
}

# ===== محمول على عدد =====
دالة _محمول(م) {
    متغير ن = م["معاملات"][٠]
    متغير نوع = م["نوع"]
    متغير محجوز = _نسخ(م["معاملات"])
    متغير ي = _طازج(محجوز، ["ي"، "ع"])
    متغير ج = _طازج(محجوز، ["ج"، "ق٢"])
    متغير ر = _طازج(محجوز، ["ر٢"، "م"])
    إذا (نوع == "بين") {
        ارجع _علبة(م، ["ارجع " + ن + " >= " + _ثابت(م["ك_أ"]) + " و " + ن + " <= " + _ثابت(م["ك_ب"])])
    }
    إذا (نوع == "أولي") {
        ارجع _علبة(م، ["إذا (" + ن + " < 2) {"، "    ارجع خطأ"، "}"، "متغير " + ي + " = 2"، "طالما (" + ي + " * " + ي + " <= " + ن + ") {"، "    إذا (" + ن + " % " + ي + " == 0) {"، "        ارجع خطأ"، "    }"، "    " + ي + " = " + ي + " + 1"، "}"، "ارجع صحيح"])
    }
    إذا (نوع == "مربع_كامل") {
        ارجع _علبة(م، ["متغير " + ج + " = 0"، "طالما (" + ج + " * " + ج + " < " + ن + ") {"، "    " + ج + " = " + ج + " + 1"، "}"، "ارجع " + ج + " * " + ج + " == " + ن])
    }
    إذا (نوع == "متناظر") {
        ارجع _علبة(م، ["إذا (" + ن + " < 0) {"، "    ارجع خطأ"، "}"، "متغير " + ج + " = " + ن، "متغير " + ر + " = 0"، "طالما (" + ج + " > 0) {"، "    " + ر + " = " + ر + " * 10 + " + ج + " % 10"، "    " + ج + " = " + ج + " // 10"، "}"، "ارجع " + ر + " == " + ن])
    }
    ارجع _علبة(م، ["ارجع " + _شرط(نوع، ن، (يحوي(م، "ك")) ? م["ك"] : لاشيء)])
}

# ===== أرقام العدد =====
دالة _أرقام(م) {
    متغير ن = م["معاملات"][٠]
    متغير نوع = م["نوع"]
    متغير محجوز = _نسخ(م["معاملات"])
    متغير ج = _طازج(محجوز، ["ج"، "ق٢"])
    متغير ح = _طازج(محجوز، ["م"، "ر٢"])
    متغير مقدمة = "متغير " + ج + " = مطلق(" + ن + ")"
    إذا (نوع == "آخر_رقم") { ارجع _علبة(م، ["ارجع مطلق(" + ن + ") % 10"]) }
    إذا (نوع == "أول_رقم") {
        ارجع _علبة(م، [مقدمة، "طالما (" + ج + " >= 10) {"، "    " + ج + " = " + ج + " // 10"، "}"، "ارجع " + ج])
    }
    إذا (نوع == "عدد_الأرقام") {
        ارجع _علبة(م، [مقدمة، "متغير " + ح + " = 1"، "طالما (" + ج + " >= 10) {"، "    " + ج + " = " + ج + " // 10"، "    " + ح + " = " + ح + " + 1"، "}"، "ارجع " + ح])
    }
    إذا (نوع == "مجموع_الأرقام") {
        ارجع _علبة(م، [مقدمة، "متغير " + ح + " = 0"، "طالما (" + ج + " > 0) {"، "    " + ح + " = " + ح + " + " + ج + " % 10"، "    " + ج + " = " + ج + " // 10"، "}"، "ارجع " + ح])
    }
    إذا (نوع == "عكس") {
        ارجع _علبة(م، [مقدمة، "متغير " + ح + " = 0"، "طالما (" + ج + " > 0) {"، "    " + ح + " = " + ح + " * 10 + " + ج + " % 10"، "    " + ج + " = " + ج + " // 10"، "}"، "ارجع " + ح])
    }
    إذا (نوع == "أكبر_رقم" أو نوع == "أصغر_رقم") {
        متغير مقارن = ">"
        إذا (نوع == "أصغر_رقم") { مقارن = "<" }
        ارجع _علبة(م، [مقدمة، "متغير " + ح + " = " + ج + " % 10"، "طالما (" + ج + " > 0) {"، "    إذا (" + ج + " % 10 " + مقارن + " " + ح + ") {"، "        " + ح + " = " + ج + " % 10"، "    }"، "    " + ج + " = " + ج + " // 10"، "}"، "ارجع " + ح])
    }
    إذا (نوع == "ضرب_الأرقام") {
        ارجع _علبة(م، [مقدمة، "إذا (" + ج + " == 0) {"، "    ارجع 0"، "}"، "متغير " + ح + " = 1"، "طالما (" + ج + " > 0) {"، "    " + ح + " = " + ح + " * (" + ج + " % 10)"، "    " + ج + " = " + ج + " // 10"، "}"، "ارجع " + ح])
    }
    ارجع لاشيء
}

# ===== نص =====
دالة _نص(م) {
    متغير س = م["معاملات"][٠]
    متغير نوع = م["نوع"]
    متغير محجوز = _نسخ(م["معاملات"])
    متغير ح = _طازج(محجوز، ["ح٢"، "ز٢"])
    متغير ن = _طازج(محجوز، ["ن٣"، "ر٢"])
    متغير ي = _طازج(محجوز، ["ي"، "ع"])
    إذا (نوع == "طول") { ارجع _علبة(م، ["ارجع طول(" + س + ")"]) }
    إذا (نوع == "أول_حرف") { ارجع _علبة(م، ["ارجع " + س + "[0]"]) }
    إذا (نوع == "آخر_حرف") { ارجع _علبة(م، ["ارجع " + س + "[طول(" + س + ") - 1]"]) }
    إذا (نوع == "عدد_كلمات") { ارجع _علبة(م، ["ارجع طول(افصل(" + س + "، " + حرف(٣٤) + " " + حرف(٣٤) + "))"]) }
    إذا (نوع == "يحوي") { ارجع _علبة(م، ["ارجع يحوي(" + س + "، " + م["معاملات"][١] + ")"]) }
    إذا (نوع == "دمج") {
        إذا (يحوي(م، "بمسافة")) { ارجع _علبة(م، ["ارجع " + س + " + " + حرف(٣٤) + " " + حرف(٣٤) + " + " + م["معاملات"][١]]) }
        ارجع _علبة(م، ["ارجع " + س + " + " + م["معاملات"][١]])
    }
    إذا (نوع == "عكس" أو نوع == "متناظر") {
        متغير ختام = "ارجع " + ن
        إذا (نوع == "متناظر") { ختام = "ارجع " + ن + " == " + س }
        ارجع _علبة(م، ["متغير " + ن + " = " + حرف(٣٤) + حرف(٣٤)، "من_أجل (" + ح + " في " + س + ") {"، "    " + ن + " = " + ح + " + " + ن، "}"، ختام])
    }
    إذا (نوع == "عدد_حرف") {
        ارجع _علبة(م، ["متغير " + ن + " = 0"، "من_أجل (" + ح + " في " + س + ") {"، "    إذا (" + ح + " == " + م["معاملات"][١] + ") {"، "        " + ن + " = " + ن + " + 1"، "    }"، "}"، "ارجع " + ن])
    }
    إذا (نوع == "تكرار") {
        ارجع _علبة(م، ["متغير " + ن + " = " + حرف(٣٤) + حرف(٣٤)، "من_أجل (" + ي + " من 1 إلى " + م["معاملات"][١] + ") {"، "    " + ن + " = " + ن + " + " + س، "}"، "ارجع " + ن])
    }
    ارجع لاشيء
}

# ===== صيغة =====
دالة _صيغة(م) {
    متغير ب = م["معاملات"]
    متغير أ = ب[٠]
    متغير نوع = م["نوع"]
    متغير ط = {"مربع": أ + " * " + أ، "مكعب": أ + " * " + أ + " * " + أ، "ضعف": أ + " * 2"، "ثلاثة_أمثال": أ + " * 3"، "نصف": أ + " / 2"، "سالب": "0 - " + أ، "التالي": أ + " + 1"، "السابق": أ + " - 1"، "مطلق": "مطلق(" + أ + ")"}
    إذا (يحوي(ط، نوع)) { ارجع _علبة(م، ["ارجع " + ط[نوع]]) }
    إذا (نوع == "زائد_ثابت") { ارجع _علبة(م، ["ارجع " + أ + " + " + _ثابت(م["ك"])]) }
    إذا (نوع == "ضرب_ثابت") { ارجع _علبة(م، ["ارجع " + أ + " * " + _ثابت(م["ك"])]) }
    إذا (نوع == "طرح_ثابت") { ارجع _علبة(م، ["ارجع " + أ + " - " + _ثابت(م["ك"])]) }
    إذا (نوع == "إشارة") {
        ارجع _علبة(م، ["إذا (" + أ + " > 0) {"، "    ارجع 1"، "}"، "إذا (" + أ + " < 0) {"، "    ارجع -1"، "}"، "ارجع 0"])
    }
    إذا (طول(ب) >= ٢) {
        متغير ج = ب[١]
        متغير ث = {"جمع": أ + " + " + ج، "طرح": أ + " - " + ج، "ضرب": أ + " * " + ج، "قسمة": أ + " / " + ج، "باقي": أ + " % " + ج، "قوة": أ + " ** " + ج، "متوسط": "(" + أ + " + " + ج + ") / 2"، "محيط": "2 * (" + أ + " + " + ج + ")"، "مساحة_مثلث": أ + " * " + ج + " / 2"، "فرق_مطلق": "مطلق(" + أ + " - " + ج + ")"}
        إذا (يحوي(ث، نوع)) { ارجع _علبة(م، ["ارجع " + ث[نوع]]) }
        إذا (نوع == "أكبر") { ارجع _علبة(م، ["إذا (" + أ + " > " + ج + ") {"، "    ارجع " + أ، "}"، "ارجع " + ج]) }
        إذا (نوع == "أصغر") { ارجع _علبة(م، ["إذا (" + أ + " < " + ج + ") {"، "    ارجع " + أ، "}"، "ارجع " + ج]) }
    }
    إذا (طول(ب) >= ٣) {
        متغير ج = ب[١]
        متغير د = ب[٢]
        إذا (نوع == "جمع٣") { ارجع _علبة(م، ["ارجع " + أ + " + " + ج + " + " + د]) }
        إذا (نوع == "ضرب٣") { ارجع _علبة(م، ["ارجع " + أ + " * " + ج + " * " + د]) }
        إذا (نوع == "متوسط٣") { ارجع _علبة(م، ["ارجع (" + أ + " + " + ج + " + " + د + ") / 3"]) }
        إذا (نوع == "أكبر٣" أو نوع == "أصغر٣") {
            متغير مقارن = ">"
            إذا (نوع == "أصغر٣") { مقارن = "<" }
            متغير محجوز = _نسخ(ب)
            متغير ح = _طازج(محجوز، ["م"، "ر٢"])
            ارجع _علبة(م، ["متغير " + ح + " = " + أ، "إذا (" + ج + " " + مقارن + " " + ح + ") {"، "    " + ح + " = " + ج، "}"، "إذا (" + د + " " + مقارن + " " + ح + ") {"، "    " + ح + " = " + د، "}"، "ارجع " + ح])
        }
    }
    ارجع لاشيء
}

# يبني نص الدالة من المواصفة؛ لاشيء إن لم تُعرَف
صدّر دالة ابنِ(مواصفة) {
    متغير ع = مواصفة["عائلة"]
    إذا (ع == "قائمة" أو ع == "مدى") { ارجع _مسار(مواصفة) }
    إذا (ع == "محمول") { ارجع _محمول(مواصفة) }
    إذا (ع == "أرقام") { ارجع _أرقام(مواصفة) }
    إذا (ع == "نص") { ارجع _نص(مواصفة) }
    إذا (ع == "صيغة") { ارجع _صيغة(مواصفة) }
    ارجع لاشيء
}
