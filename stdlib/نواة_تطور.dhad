# ضاد/نواة_تطور — محرك التطور الذاتي بضوابط وثيقة نواة:
#   كل تغيير يبدأ فرضيةً، ولا تصير مثبتة إلا باختبارات تُشغَّل فعلًا في المنفذ المعزول.
#   البيئات: بحث ← تجريب ← إنتاج، ولا قفز بينها. التغيير الحساس لا يدخل الإنتاج بلا موافقة بشرية باسم صاحبها.
#   كل خطوة تُدوَّن في سجل لا يُمحى. المهارة المعتمدة تُكتب في الذاكرة الإجرائية بدليلها.

متغير ش = استورد("ضاد/نواة_منفذ")
متغير ذ = استورد("ضاد/نواة_ذاكرة")
متغير ع = استورد("ضاد/نواة_عقد")

متغير _بيئات = ["بحث"، "تجريب"، "إنتاج"]

صدّر دالة أنشئ() { ارجع {"مقترحات": {}، "عداد": ٠، "سجل": []} }

دالة _دوّن(م، معرف، فعل، تفصيل) { أضف(م["سجل"]، {"مقترح": معرف، "فعل": فعل، "تفصيل": تفصيل}) }

دالة _مقترح(م، معرف) {
    إذا (نوع(م) != "خريطة" أو ليس يحوي(م، "مقترحات")) { أطلق_خطأ("التطور: المخزن يُنشأ بالدالة أنشئ()") }
    إذا (ليس يحوي(م["مقترحات"]، معرف)) { أطلق_خطأ("التطور: لا مقترح باسم «" + نص(معرف) + "»") }
    ارجع م["مقترحات"][معرف]
}

# يقترح تغييرًا: فرضية + شيفرة المهارة الجديدة + درجة الحساسية (عادي/حساس)
صدّر دالة اقترح(م، فرضية، شيفرة، حساسية = "عادي") {
    إذا (نوع(فرضية) != "نص" أو طول(فرضية) == ٠) { أطلق_خطأ("التطور: الفرضية نص غير فارغ") }
    إذا (نوع(شيفرة) != "نص" أو طول(شيفرة) == ٠) { أطلق_خطأ("التطور: شيفرة المهارة نص غير فارغ") }
    إذا (حساسية != "عادي" و حساسية != "حساس") { أطلق_خطأ("التطور: الحساسية «عادي» أو «حساس»") }
    إذا (نوع(م) != "خريطة" أو ليس يحوي(م، "مقترحات")) { أطلق_خطأ("التطور: المخزن يُنشأ بالدالة أنشئ()") }
    م["عداد"] = م["عداد"] + ١
    متغير معرف = "ط" + نص(م["عداد"])
    م["مقترحات"][معرف] = {"معرف": معرف، "فرضية": فرضية، "شيفرة": شيفرة، "حساسية": حساسية، "بيئة": "بحث"، "حالة": "فرضية"، "اختبارات": []، "موافقة": ""}
    _دوّن(م، معرف، "اقتُرح"، فرضية)
    ارجع معرف
}

# يجرّب المقترح: كل اختبار {شيفرة_اختبار، متوقع} تُلحَق بشيفرة المهارة وتُشغَّل في المنفذ
# النجاح الكامل يرفع الحالة إلى «مثبتة» وينقل البيئة إلى «تجريب»؛ أي إخفاق يجعلها «مرفوضة»
صدّر دالة جرّب(م، معرف، اختبارات) {
    متغير ق = _مقترح(م، معرف)
    إذا (ق["حالة"] == "معتمد") { أطلق_خطأ("التطور: المقترح معتمد من قبل") }
    إذا (نوع(اختبارات) != "قائمة" أو طول(اختبارات) == ٠) { أطلق_خطأ("التطور: لا تثبت فرضية بلا اختبارات") }
    متغير نتائج = []
    متغير كلها = صحيح
    من_أجل (ت في اختبارات) {
        إذا (نوع(ت) != "خريطة" أو ليس يحوي(ت، "شيفرة") أو ليس يحوي(ت، "متوقع")) { أطلق_خطأ("التطور: كل اختبار فيه شيفرة ومتوقع") }
        متغير ر = ش.اختبر(ق["شيفرة"] + حرف(١٠) + ت["شيفرة"]، ت["متوقع"])
        أضف(نتائج، {"نجح": ر["نجح"]، "فرق": ر["فرق"]})
        إذا (ليس ر["نجح"]) { كلها = خطأ }
    }
    ق["اختبارات"] = نتائج
    إذا (كلها) {
        ق["حالة"] = "مثبتة"
        ق["بيئة"] = "تجريب"
        _دوّن(م، معرف، "ثبتت"، نص(طول(نتائج)) + " اختبارًا")
    } وإلا {
        ق["حالة"] = "مرفوضة"
        ق["بيئة"] = "بحث"
        _دوّن(م، معرف، "رُفضت"، "أخفق اختبار")
    }
    ارجع ق["حالة"]
}

# يوافق إنسان على مقترح حساس باسمه
صدّر دالة وافق(م، معرف، اسم_الموافق) {
    متغير ق = _مقترح(م، معرف)
    إذا (نوع(اسم_الموافق) != "نص" أو طول(اسم_الموافق) == ٠) { أطلق_خطأ("التطور: الموافقة تُسجَّل باسم صاحبها") }
    ق["موافقة"] = اسم_الموافق
    _دوّن(م، معرف، "وُوفق"، اسم_الموافق)
    ارجع صحيح
}

# يعتمد المقترح إلى الإنتاج: مثبتة أولًا؛ والحساس لا يُعتمد بلا موافقة بشرية.
# عند الاعتماد تُكتب المهارة في الذاكرة الإجرائية (إن مُرِّر مخزن ذاكرة) وتُعتمد بدليل الاختبارات.
صدّر دالة اعتمد(م، معرف، ذاكرة = "") {
    متغير ق = _مقترح(م، معرف)
    إذا (ق["حالة"] != "مثبتة") { أطلق_خطأ("التطور: لا يُعتمد إلا مقترح مثبَت بالاختبار (حالته الآن: " + ق["حالة"] + ")") }
    إذا (ق["حساسية"] == "حساس" و ق["موافقة"] == "") { أطلق_خطأ("التطور: التغيير الحساس يحتاج موافقة بشرية قبل الاعتماد") }
    ق["حالة"] = "معتمد"
    ق["بيئة"] = "إنتاج"
    _دوّن(م، معرف، "اعتُمد"، ق["حساسية"])
    إذا (ذاكرة != "") {
        متغير ح = ذ.اكتب(ذاكرة، "إجرائية"، ق["فرضية"]، "تطور " + معرف، ٩٠)
        ذ.اعتمد(ذاكرة، ح، نص(طول(ق["اختبارات"])) + " اختبارًا ناجحًا")
        ق["ذاكرة"] = ح
    }
    ارجع صحيح
}

# يتراجع عن مقترح معتمد: يعود إلى التجريب ويُسحب اعتماده من الذاكرة
صدّر دالة تراجع(م، معرف، ذاكرة = "") {
    متغير ق = _مقترح(م، معرف)
    إذا (ق["حالة"] != "معتمد") { أطلق_خطأ("التطور: التراجع لمقترح معتمد فقط") }
    ق["حالة"] = "مثبتة"
    ق["بيئة"] = "تجريب"
    إذا (ذاكرة != "" و يحوي(ق، "ذاكرة")) { ذ.اسحب_الاعتماد(ذاكرة، ق["ذاكرة"]) }
    _دوّن(م، معرف، "تُراجع عنه"، "")
    ارجع صحيح
}

صدّر دالة اقرأ(م، معرف) { ارجع _مقترح(م، معرف) }
صدّر دالة السجل(م) { ارجع م["سجل"] }

صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "تطور_ذاتي"،
        "يختبر مقترح مهارة جديدة في المنفذ ويثبّتها أو يرفضها بضوابط البيئات والموافقة البشرية"،
        {"مخزن": "خريطة"، "مقترح": "نص"، "اختبارات": "قائمة"}،
        {"حالة": "نص"}،
        دالة(مدخل) { ارجع {"حالة": جرّب(مدخل["مخزن"]، مدخل["مقترح"]، مدخل["اختبارات"])} }
    ))
}
