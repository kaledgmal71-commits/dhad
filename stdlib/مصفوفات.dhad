# ضاد/مصفوفات — المصفوفات متعددة الأبعاد (Tensor) مكتوبة بضاد نفسها: الأشكال والبثّ والضرب والاختزال.
# التمثيل: خريطة {"بيانات": قائمة مسطحة بترتيب الصفوف، "شكل": قائمة أبعاد}. الشكل [] يعني قيمة مفردة.
# كل مصفوفة متصلة في الذاكرة بترتيب الصفوف؛ «أعد_تشكيل» تشارك البيانات بلا نسخ، وما سواها يُنتج بيانات جديدة.
# البثّ (broadcasting) كما في NumPy: تُحاذى الأبعاد من اليمين ويُمدَّد البعد ١ أو المفقود.
# هذه مرحلة الصحة والدقة؛ النوى السريعة (SIMD فوق ذاكرة wasm) هي البند ١٥-٢ و١٥-٣.

متغير ر = استورد("ضاد/رياضيات")

# ---------- أدوات داخلية ----------
دالة _حجم(ش) {
    متغير ح = ١
    من_أجل (ب في ش) { ح = ح * ب }
    ارجع ح
}

صدّر دالة نسخ_شكل(ق) { ارجع _نسخ_قائمة(ق) }

دالة _نسخ_قائمة(ق) {
    متغير خ = []
    من_أجل (ع في ق) { أضف(خ، ع) }
    ارجع خ
}

دالة _يساوي_أشكال(أ، ب) {
    إذا (طول(أ) != طول(ب)) { ارجع خطأ }
    من_أجل (ي من ٠ إلى طول(أ) - ١) {
        إذا (أ[ي] != ب[ي]) { ارجع خطأ }
    }
    ارجع صحيح
}

دالة _محور_صالح(م، محور) {
    متغير رتبة = طول(م["شكل"])
    متغير ح = محور
    إذا (ح < ٠) { ح = ح + رتبة }
    إذا (ح < ٠ أو ح >= رتبة) { أطلق_خطأ("المحور " + نص(محور) + " خارج رتبة المصفوفة " + نص(رتبة)) }
    ارجع ح
}

# ناتج الضرب لأبعاد قبل المحور (خارج)، وبعده (داخل)
دالة _خارج_داخل(ش، ح) {
    متغير خارج = ١
    متغير داخل = ١
    من_أجل (ي من ٠ إلى طول(ش) - ١) {
        إذا (ي < ح) { خارج = خارج * ش[ي] }
        إذا (ي > ح) { داخل = داخل * ش[ي] }
    }
    ارجع [خارج، داخل]
}

# شكل البثّ بين شكلين، أو خطأ صريح إن تعذّر
دالة _شكل_بث(أ، ب) {
    متغير ن = طول(أ)
    إذا (طول(ب) > ن) { ن = طول(ب) }
    متغير خ = []
    من_أجل (ي من ٠ إلى ن - ١) {
        متغير ا = ١
        متغير ب٢ = ١
        إذا (ي >= ن - طول(أ)) { ا = أ[ي - (ن - طول(أ))] }
        إذا (ي >= ن - طول(ب)) { ب٢ = ب[ي - (ن - طول(ب))] }
        إذا (ا == ب٢) { أضف(خ، ا) }
        وإلا إذا (ا == ١) { أضف(خ، ب٢) }
        وإلا إذا (ب٢ == ١) { أضف(خ، ا) }
        وإلا { أطلق_خطأ("لا يمكن بثّ الشكلين " + نص(أ) + " و" + نص(ب)) }
    }
    ارجع خ
}

# لكل موضع في شكل الخرج، موضع المصدر المقابل (البعد المبثوث يثبت موضعه)
دالة _مواضع_بث(خرج، مصدر) { ارجع نواة_مواضع_بث(خرج، مصدر) }

دالة _مصفوفة_من(ق) {
    إذا (نوع(ق) == "رقم") { ارجع {"بيانات": [ق]، "شكل": []} }
    ارجع ق
}

# ---------- الإنشاء ----------
صدّر دالة من_قائمة(بيانات، شكل) {
    إذا (طول(بيانات) != _حجم(شكل)) { أطلق_خطأ("عدد العناصر " + نص(طول(بيانات)) + " لا يطابق الشكل " + نص(شكل)) }
    ارجع {"بيانات": بيانات، "شكل": _نسخ_قائمة(شكل)}
}

صدّر دالة أنشئ(شكل، قيمة) {
    ارجع {"بيانات": نواة_أنشئ(_حجم(شكل)، قيمة)، "شكل": _نسخ_قائمة(شكل)}
}

صدّر دالة أصفار(شكل) { ارجع أنشئ(شكل، ٠) }
صدّر دالة آحاد(شكل) { ارجع أنشئ(شكل، ١) }

صدّر دالة هوية(ن) {
    متغير م = أصفار([ن، ن])
    من_أجل (ي من ٠ إلى ن - ١) { م["بيانات"][ي * ن + ي] = ١ }
    ارجع م
}

# قيم متساوية البعد بين بداية ونهاية (شاملتين)
صدّر دالة مدى_خطي(بداية، نهاية، عدد) {
    متغير ب = []
    إذا (عدد == ١) { أضف(ب، بداية) }
    وإلا {
        من_أجل (ي من ٠ إلى عدد - ١) { أضف(ب، بداية + (نهاية - بداية) * ي / (عدد - ١)) }
    }
    ارجع {"بيانات": ب، "شكل": [عدد]}
}

# من قوائم متداخلة: الشكل يُستنتج من أول عنصر في كل مستوى ويُتحقَّق من انتظامه
دالة _استنتج_شكل(ق) {
    متغير ش = []
    متغير ج = ق
    طالما (نوع(ج) == "قائمة") {
        أضف(ش، طول(ج))
        إذا (طول(ج) == ٠) { ج = ٠ } وإلا { ج = ج[٠] }
    }
    ارجع ش
}

دالة _سطّح(ق، ش، عمق، خرج) {
    إذا (عمق == طول(ش)) {
        إذا (نوع(ق) != "رقم") { أطلق_خطأ("قائمة غير منتظمة: توقعت رقمًا") }
        أضف(خرج، ق)
        ارجع لاشيء
    }
    إذا (نوع(ق) != "قائمة" أو طول(ق) != ش[عمق]) { أطلق_خطأ("قائمة غير منتظمة عند المستوى " + نص(عمق)) }
    من_أجل (ع في ق) { _سطّح(ع، ش، عمق + ١، خرج) }
}

صدّر دالة من_متداخلة(قائمة) {
    إذا (نوع(قائمة) == "رقم") { ارجع {"بيانات": [قائمة]، "شكل": []} }
    متغير ش = _استنتج_شكل(قائمة)
    متغير خ = []
    _سطّح(قائمة، ش، ٠، خ)
    ارجع {"بيانات": خ، "شكل": ش}
}

دالة _ابنِ_متداخلة(ب، ش، عمق، موضع) {
    إذا (عمق == طول(ش)) { ارجع ب[موضع] }
    متغير خطوة = ١
    من_أجل (ي من عمق + ١ إلى طول(ش) - ١) { خطوة = خطوة * ش[ي] }
    متغير خ = []
    من_أجل (ي من ٠ إلى ش[عمق] - ١) { أضف(خ، _ابنِ_متداخلة(ب، ش، عمق + ١، موضع + ي * خطوة)) }
    ارجع خ
}

صدّر دالة إلى_متداخلة(م) { ارجع _ابنِ_متداخلة(م["بيانات"]، م["شكل"]، ٠، ٠) }

# طبيعية معيارية × مقياس بمولّد حتمي (ضاد/رياضيات)
صدّر دالة عشوائي_طبيعي(شكل، مولد، مقياس) {
    متغير ب = []
    من_أجل (ي من ١ إلى _حجم(شكل)) { أضف(ب، ر.طبيعي(مولد) * مقياس) }
    ارجع {"بيانات": ب، "شكل": _نسخ_قائمة(شكل)}
}

صدّر دالة عشوائي_منتظم(شكل، مولد، أدنى، أعلى) {
    متغير ب = []
    من_أجل (ي من ١ إلى _حجم(شكل)) { أضف(ب، أدنى + (أعلى - أدنى) * ر.تالي(مولد)) }
    ارجع {"بيانات": ب، "شكل": _نسخ_قائمة(شكل)}
}

# ---------- الاستعلام ----------
صدّر دالة الشكل(م) { ارجع _نسخ_قائمة(م["شكل"]) }
صدّر دالة الرتبة(م) { ارجع طول(م["شكل"]) }
صدّر دالة الحجم(م) { ارجع _حجم(م["شكل"]) }
صدّر دالة نسخة(م) { ارجع {"بيانات": _نسخ_قائمة(م["بيانات"])، "شكل": _نسخ_قائمة(م["شكل"])} }

دالة _موضع(م، فهارس) {
    متغير ش = م["شكل"]
    إذا (طول(فهارس) != طول(ش)) { أطلق_خطأ("عدد الفهارس " + نص(طول(فهارس)) + " لا يطابق الرتبة " + نص(طول(ش))) }
    متغير م٢ = ٠
    من_أجل (ي من ٠ إلى طول(ش) - ١) {
        متغير ف = فهارس[ي]
        إذا (ف < ٠) { ف = ف + ش[ي] }
        إذا (ف < ٠ أو ف >= ش[ي]) { أطلق_خطأ("الفهرس " + نص(فهارس[ي]) + " خارج البعد " + نص(ش[ي])) }
        م٢ = م٢ * ش[ي] + ف
    }
    ارجع م٢
}

صدّر دالة عنصر(م، فهارس) { ارجع م["بيانات"][_موضع(م، فهارس)] }

صدّر دالة ضع(م، فهارس، قيمة) {
    م["بيانات"][_موضع(م، فهارس)] = قيمة
    ارجع م
}

# ---------- إعادة التشكيل والتبديل ----------
# بعد واحد قد يكون -١ فيُستنتج. البيانات مشتركة لا منسوخة.
صدّر دالة أعد_تشكيل(م، شكل) {
    متغير حجم = _حجم(م["شكل"])
    متغير ش = _نسخ_قائمة(شكل)
    متغير مجهول = -١
    متغير معلوم = ١
    من_أجل (ي من ٠ إلى طول(ش) - ١) {
        إذا (ش[ي] == -١) {
            إذا (مجهول != -١) { أطلق_خطأ("بعد مجهول واحد فقط مسموح") }
            مجهول = ي
        } وإلا { معلوم = معلوم * ش[ي] }
    }
    إذا (مجهول != -١) {
        إذا (معلوم == ٠ أو حجم % معلوم != ٠) { أطلق_خطأ("تعذّر استنتاج البعد المجهول") }
        ش[مجهول] = حجم / معلوم
    }
    إذا (_حجم(ش) != حجم) { أطلق_خطأ("الشكل الجديد " + نص(شكل) + " لا يطابق حجم " + نص(حجم)) }
    ارجع {"بيانات": م["بيانات"]، "شكل": ش}
}

# تبديل المحاور: محاور[ي] هو محور الأصل الذي يصير البعد ي في الناتج
صدّر دالة بدّل_محاور(م، محاور) {
    متغير ش = م["شكل"]
    متغير ن = طول(ش)
    إذا (طول(محاور) != ن) { أطلق_خطأ("بدّل_محاور تحتاج محورًا لكل بعد") }
    متغير خطوات = []
    من_أجل (ي من ٠ إلى ن - ١) { أضف(خطوات، ٠) }
    متغير جار = ١
    متغير ي = ن - ١
    طالما (ي >= ٠) {
        خطوات[ي] = جار
        جار = جار * ش[ي]
        ي = ي - ١
    }
    متغير ش٢ = []
    متغير خ٢ = []
    من_أجل (ي من ٠ إلى ن - ١) {
        متغير ا = محاور[ي]
        إذا (ا < ٠) { ا = ا + ن }
        إذا (ا < ٠ أو ا >= ن) { أطلق_خطأ("محور غير صالح في بدّل_محاور") }
        أضف(ش٢، ش[ا])
        أضف(خ٢، خطوات[ا])
    }
    متغير ب = نواة_تبديل(م["بيانات"]، ش٢، خ٢)
    ارجع {"بيانات": ب، "شكل": ش٢}
}

# تبديل آخر محورين
صدّر دالة منقول(م) {
    متغير ن = طول(م["شكل"])
    إذا (ن < ٢) { ارجع نسخة(م) }
    متغير مح = []
    من_أجل (ي من ٠ إلى ن - ١) { أضف(مح، ي) }
    مح[ن - ١] = ن - ٢
    مح[ن - ٢] = ن - ١
    ارجع بدّل_محاور(م، مح)
}

# ---------- العمليات على العناصر (مع البثّ) ----------
صدّر دالة ثنائي(أ، ب، دالة_ما) {
    متغير س = _مصفوفة_من(أ)
    متغير ص = _مصفوفة_من(ب)
    متغير خرج = []
    إذا (_يساوي_أشكال(س["شكل"]، ص["شكل"])) {
        متغير ا = س["بيانات"]
        متغير ب٢ = ص["بيانات"]
        من_أجل (ي من ٠ إلى طول(ا) - ١) { أضف(خرج، دالة_ما(ا[ي]، ب٢[ي])) }
        ارجع {"بيانات": خرج، "شكل": _نسخ_قائمة(س["شكل"])}
    }
    متغير ش = _شكل_بث(س["شكل"]، ص["شكل"])
    متغير مأ = _مواضع_بث(ش، س["شكل"])
    متغير مب = _مواضع_بث(ش، ص["شكل"])
    من_أجل (ي من ٠ إلى طول(مأ) - ١) { أضف(خرج، دالة_ما(س["بيانات"][مأ[ي]]، ص["بيانات"][مب[ي]])) }
    ارجع {"بيانات": خرج، "شكل": ش}
}

# العمليات الأربع الشائعة تعمل بنواة أصلية (بالبت نفسه)؛ ما سواها يمرّ عبر «ثنائي» بدالة
دالة _حسابي(أ، ب، عملية) {
    متغير س = _مصفوفة_من(أ)
    متغير ص = _مصفوفة_من(ب)
    إذا (_يساوي_أشكال(س["شكل"]، ص["شكل"])) {
        ارجع {"بيانات": نواة_حسابي(س["بيانات"]، ص["بيانات"]، لاشيء، لاشيء، عملية)، "شكل": _نسخ_قائمة(س["شكل"])}
    }
    متغير ش = _شكل_بث(س["شكل"]، ص["شكل"])
    ارجع {"بيانات": نواة_حسابي(س["بيانات"]، ص["بيانات"]، _مواضع_بث(ش، س["شكل"])، _مواضع_بث(ش، ص["شكل"])، عملية)، "شكل": ش}
}

صدّر دالة جمع(أ، ب) { ارجع _حسابي(أ، ب، ٠) }
صدّر دالة طرح(أ، ب) { ارجع _حسابي(أ، ب، ١) }
صدّر دالة ضرب(أ، ب) { ارجع _حسابي(أ، ب، ٢) }
صدّر دالة قسمة(أ، ب) { ارجع _حسابي(أ، ب، ٣) }
صدّر دالة أعلى_من(أ، ب) { ارجع ثنائي(أ، ب، دالة(س، ص) { إذا (س > ص) { ارجع س } ارجع ص }) }
صدّر دالة أدنى_من(أ، ب) { ارجع ثنائي(أ، ب، دالة(س، ص) { إذا (س < ص) { ارجع س } ارجع ص }) }

صدّر دالة طبّق_عناصر(م، دالة_ما) {
    متغير خرج = []
    من_أجل (ع في م["بيانات"]) { أضف(خرج، دالة_ما(ع)) }
    ارجع {"بيانات": خرج، "شكل": _نسخ_قائمة(م["شكل"])}
}

# الدوال الأحادية الشائعة تعمل بنواة أصلية بنفس نتائج تعريفاتها بضاد
دالة _أحادي(م، رمز) { ارجع {"بيانات": نواة_أحادي(م["بيانات"]، رمز)، "شكل": _نسخ_قائمة(م["شكل"])} }

صدّر دالة سالب(م) { ارجع _أحادي(م، ١) }
صدّر دالة مربع(م) { ارجع _أحادي(م، ٠) }
صدّر دالة جذر_عناصر(م) { ارجع _أحادي(م، ٢) }
صدّر دالة أس_عناصر(م) { ارجع _أحادي(م، ٣) }
صدّر دالة لوغ_عناصر(م) { ارجع _أحادي(م، ٤) }
صدّر دالة ظل_قطعي_عناصر(م) { ارجع _أحادي(م، ٦) }
صدّر دالة سيني_عناصر(م) { ارجع _أحادي(م، ٥) }
صدّر دالة جيلو_عناصر(م) { ارجع طبّق_عناصر(م، ر.جيلو) }
صدّر دالة ريلو(م) { ارجع _أحادي(م، ٧) }

# ---------- الاختزال ----------
دالة _اختزل(م، محور، دالة_ما، بداية، أبقِ_البعد) {
    متغير ح = _محور_صالح(م، محور)
    متغير ش = م["شكل"]
    متغير ا = _خارج_داخل(ش، ح)
    متغير خارج = ا[٠]
    متغير داخل = ا[١]
    متغير ن = ش[ح]
    متغير ب = م["بيانات"]
    متغير خرج = []
    من_أجل (أ٠ من ٠ إلى خارج - ١) {
        من_أجل (د من ٠ إلى داخل - ١) {
            متغير تجميع = بداية
            من_أجل (ك من ٠ إلى ن - ١) { تجميع = دالة_ما(تجميع، ب[(أ٠ * ن + ك) * داخل + د]) }
            أضف(خرج، تجميع)
        }
    }
    متغير ش٢ = []
    من_أجل (ي من ٠ إلى طول(ش) - ١) {
        إذا (ي == ح) { إذا (أبقِ_البعد) { أضف(ش٢، ١) } }
        وإلا { أضف(ش٢، ش[ي]) }
    }
    ارجع {"بيانات": خرج، "شكل": ش٢}
}

دالة _كلي(م، دالة_ما، بداية) {
    متغير تجميع = بداية
    من_أجل (ع في م["بيانات"]) { تجميع = دالة_ما(تجميع، ع) }
    ارجع تجميع
}

صدّر دالة مجموع(م، محور، أبقِ_البعد) {
    إذا (محور == لاشيء) { ارجع {"بيانات": [نواة_جمع_محور(م["بيانات"]، ١، طول(م["بيانات"])، ١)[٠]]، "شكل": []} }
    متغير ح = _محور_صالح(م، محور)
    متغير ش = م["شكل"]
    متغير ا = _خارج_داخل(ش، ح)
    متغير ش٢ = []
    من_أجل (ي من ٠ إلى طول(ش) - ١) {
        إذا (ي == ح) { إذا (أبقِ_البعد) { أضف(ش٢، ١) } }
        وإلا { أضف(ش٢، ش[ي]) }
    }
    ارجع {"بيانات": نواة_جمع_محور(م["بيانات"]، ا[٠]، ش[ح]، ا[١])، "شكل": ش٢}
}

صدّر دالة متوسط(م، محور، أبقِ_البعد) {
    إذا (محور == لاشيء) { ارجع {"بيانات": [_كلي(م، دالة(س، ص) { ارجع س + ص }، ٠) / طول(م["بيانات"])]، "شكل": []} }
    متغير ن = م["شكل"][_محور_صالح(م، محور)]
    متغير مج = _اختزل(م، محور، دالة(س، ص) { ارجع س + ص }، ٠، أبقِ_البعد)
    ارجع طبّق_عناصر(مج، دالة(س) { ارجع س / ن })
}

صدّر دالة أكبر_قيمة(م، محور، أبقِ_البعد) {
    متغير دا = دالة(س، ص) { إذا (ص > س) { ارجع ص } ارجع س }
    إذا (محور == لاشيء) { ارجع {"بيانات": [_كلي(م، دا، -١e٣٠٨)]، "شكل": []} }
    ارجع _اختزل(م، محور، دا، -١e٣٠٨، أبقِ_البعد)
}

صدّر دالة أصغر_قيمة(م، محور، أبقِ_البعد) {
    متغير دا = دالة(س، ص) { إذا (ص < س) { ارجع ص } ارجع س }
    إذا (محور == لاشيء) { ارجع {"بيانات": [_كلي(م، دا، ١e٣٠٨)]، "شكل": []} }
    ارجع _اختزل(م، محور، دا، ١e٣٠٨، أبقِ_البعد)
}

# موضع أكبر عنصر على المحور (أول موضع عند التساوي)
صدّر دالة موضع_الأكبر(م، محور) {
    متغير ح = _محور_صالح(م، محور)
    متغير ش = م["شكل"]
    متغير ا = _خارج_داخل(ش، ح)
    متغير ن = ش[ح]
    متغير خرج = []
    من_أجل (أ٠ من ٠ إلى ا[٠] - ١) {
        من_أجل (د من ٠ إلى ا[١] - ١) {
            متغير أفضل = ٠
            متغير قيمة = م["بيانات"][(أ٠ * ن) * ا[١] + د]
            من_أجل (ك من ١ إلى ن - ١) {
                متغير ع = م["بيانات"][(أ٠ * ن + ك) * ا[١] + د]
                إذا (ع > قيمة) { قيمة = ع
                    أفضل = ك }
            }
            أضف(خرج، أفضل)
        }
    }
    متغير ش٢ = []
    من_أجل (ي من ٠ إلى طول(ش) - ١) { إذا (ي != ح) { أضف(ش٢، ش[ي]) } }
    ارجع {"بيانات": خرج، "شكل": ش٢}
}

# ---------- ضرب المصفوفات (مع بثّ أبعاد الدفعة) ----------
صدّر دالة ضرب_مصفوفي(أ، ب) {
    متغير شأ = أ["شكل"]
    متغير شب = ب["شكل"]
    إذا (طول(شأ) < ٢ أو طول(شب) < ٢) { أطلق_خطأ("ضرب_مصفوفي يحتاج رتبة ٢ على الأقل") }
    متغير ن = شأ[طول(شأ) - ٢]
    متغير ك = شأ[طول(شأ) - ١]
    متغير ك٢ = شب[طول(شب) - ٢]
    متغير م = شب[طول(شب) - ١]
    إذا (ك != ك٢) { أطلق_خطأ("البعدان الداخليان غير متطابقين: " + نص(ك) + " و" + نص(ك٢)) }
    متغير دأ = اقتطع_قائمة(شأ، ٠، طول(شأ) - ٢)
    متغير دب = اقتطع_قائمة(شب، ٠، طول(شب) - ٢)
    متغير دفعة = _شكل_بث(دأ، دب)
    متغير مأ = _مواضع_بث(دفعة، دأ)
    متغير مب = _مواضع_بث(دفعة، دب)
    متغير خرج = []
    متغير بأ = أ["بيانات"]
    متغير بب = ب["بيانات"]
    من_أجل (د من ٠ إلى طول(مأ) - ١) {
        متغير قأ = مأ[د] * ن * ك
        متغير قب = مب[د] * ك * م
        خرج = خرج + نواة_ضرب_مصفوفي(بأ، بب، قأ، قب، ن، ك، م)
    }
    متغير ش = _نسخ_قائمة(دفعة)
    أضف(ش، ن)
    أضف(ش، م)
    ارجع {"بيانات": خرج، "شكل": ش}
}

# شريحة من قائمة عادية (نهاية غير شاملة)
دالة اقتطع_قائمة(ق، ب، ن) {
    متغير خ = []
    من_أجل (ي من ب إلى ن - ١) { أضف(خ، ق[ي]) }
    ارجع خ
}

# ---------- التطبيع والتوزيع ----------
# softmax مستقر عدديًا على المحور (الافتراضي الأخير)
صدّر دالة سوفت_ماكس(م، محور) {
    متغير مح = محور
    إذا (مح == لاشيء) { مح = -١ }
    متغير ح = _محور_صالح(م، مح)
    متغير ش = م["شكل"]
    متغير ا = _خارج_داخل(ش، ح)
    ارجع {"بيانات": نواة_سوفت_ماكس(م["بيانات"]، ا[٠]، ش[ح]، ا[١])، "شكل": _نسخ_قائمة(ش)}
}

# log-softmax: x − max − log Σ e^(x−max)
صدّر دالة لوغ_سوفت_ماكس(م، محور) {
    متغير مح = محور
    إذا (مح == لاشيء) { مح = -١ }
    متغير ح = _محور_صالح(م، مح)
    متغير ش = م["شكل"]
    متغير ا = _خارج_داخل(ش، ح)
    ارجع {"بيانات": نواة_لوغ_سوفت_ماكس(م["بيانات"]، ا[٠]، ش[ح]، ا[١])، "شكل": _نسخ_قائمة(ش)}
}

# تطبيع الطبقة على المحور الأخير: (x − μ) / √(σ² + ε) بلا معاملات قابلة للتعلم
صدّر دالة تطبيع_طبقة(م، إبسيلون) {
    متغير ش = م["شكل"]
    متغير ن = ش[طول(ش) - ١]
    متغير صفوف = _حجم(ش) / ن
    متغير ب = م["بيانات"]
    متغير خرج = []
    من_أجل (ص من ٠ إلى صفوف - ١) {
        متغير مج = ٠
        من_أجل (ك من ٠ إلى ن - ١) { مج = مج + ب[ص * ن + ك] }
        متغير وسط = مج / ن
        متغير تب = ٠
        من_أجل (ك من ٠ إلى ن - ١) { تب = تب + (ب[ص * ن + ك] - وسط) * (ب[ص * ن + ك] - وسط) }
        متغير مقام = جذر(تب / ن + إبسيلون)
        من_أجل (ك من ٠ إلى ن - ١) { أضف(خرج، (ب[ص * ن + ك] - وسط) / مقام) }
    }
    ارجع {"بيانات": خرج، "شكل": _نسخ_قائمة(ش)}
}

# ---------- الضمّ والتقطيع ----------
صدّر دالة ضمّ(قائمة، محور) {
    متغير أول = قائمة[٠]
    متغير ح = _محور_صالح(أول، محور)
    متغير ش = _نسخ_قائمة(أول["شكل"])
    متغير مجموع_البعد = ٠
    من_أجل (م في قائمة) {
        إذا (طول(م["شكل"]) != طول(ش)) { أطلق_خطأ("ضمّ: اختلاف في الرتبة") }
        من_أجل (ي من ٠ إلى طول(ش) - ١) {
            إذا (ي != ح و م["شكل"][ي] != ش[ي]) { أطلق_خطأ("ضمّ: اختلاف في الأبعاد غير المضمومة") }
        }
        مجموع_البعد = مجموع_البعد + م["شكل"][ح]
    }
    متغير ا = _خارج_داخل(ش، ح)
    ش[ح] = مجموع_البعد
    متغير قطع = []
    متغير أطوال = []
    من_أجل (م في قائمة) { أضف(قطع، م["بيانات"]); أضف(أطوال، م["شكل"][ح]) }
    متغير خرج = نواة_ضم(قطع، أطوال، ا[٠]، ا[١])
    ارجع {"بيانات": خرج، "شكل": ش}
}

# شريحة على محور: [بداية، نهاية)
صدّر دالة شريحة(م، محور، بداية، نهاية) {
    متغير ح = _محور_صالح(م، محور)
    متغير ش = م["شكل"]
    متغير ا = _خارج_داخل(ش، ح)
    متغير ن = ش[ح]
    إذا (بداية < ٠ أو نهاية > ن أو بداية > نهاية) { أطلق_خطأ("حدود الشريحة خارج البعد " + نص(ن)) }
    متغير خرج = نواة_شريحة(م["بيانات"]، ا[٠]، ن، ا[١]، بداية، نهاية)
    متغير ش٢ = _نسخ_قائمة(ش)
    ش٢[ح] = نهاية - بداية
    ارجع {"بيانات": خرج، "شكل": ش٢}
}

# ---------- المقارنة ----------
صدّر دالة يساوي_شكل(أ، ب) { ارجع _يساوي_أشكال(أ["شكل"]، ب["شكل"]) }

# قريب: نفس الشكل، وكل |a−b| ≤ تسامح · (١ + |b|)
صدّر دالة قريب(أ، ب، تسامح) {
    إذا (ليس _يساوي_أشكال(أ["شكل"]، ب["شكل"])) { ارجع خطأ }
    من_أجل (ي من ٠ إلى طول(أ["بيانات"]) - ١) {
        إذا (مطلق(أ["بيانات"][ي] - ب["بيانات"][ي]) > تسامح * (١ + مطلق(ب["بيانات"][ي]))) { ارجع خطأ }
    }
    ارجع صحيح
}
