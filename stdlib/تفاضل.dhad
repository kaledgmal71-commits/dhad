# ضاد/تفاضل — التفاضل التلقائي بالانتشار العكسي فوق ضاد/مصفوفات، مكتوب بضاد نفسها.
# كل عملية تبني عقدة: {"قيمة": مصفوفة، "تدرج": مصفوفة أو لاشيء، "آباء": عقد، "خلفي": دالة(غ) ترجع تدرجات الآباء، "معرف"، "يحتاج"}.
# «انتشر_خلفا(خسارة)» يرتب العقد طوبولوجيًا ويراكم التدرجات؛ والتدرجات تُتحقَّق بالفروق المنتهية في الاختبارات.
# التدرجات المبثوثة تُختزل إلى شكل أصلها فلا يضيع بعد في الانتشار.

متغير م = استورد("ضاد/مصفوفات")
متغير ر = استورد("ضاد/رياضيات")

متغير _عداد = ٠

دالة _عقدة(قيمة، آباء، خلفي) {
    _عداد = _عداد + ١
    متغير يحتاج = خطأ
    من_أجل (أ في آباء) { إذا (أ["يحتاج"]) { يحتاج = صحيح } }
    إذا (ليس يحتاج) { ارجع {"قيمة": قيمة، "تدرج": لاشيء، "آباء": []، "خلفي": لاشيء، "معرف": _عداد، "يحتاج": خطأ} }
    ارجع {"قيمة": قيمة، "تدرج": لاشيء، "آباء": آباء، "خلفي": خلفي، "معرف": _عداد، "يحتاج": صحيح}
}

# ---------- الأوراق ----------
صدّر دالة ثابت(مصفوفة) {
    _عداد = _عداد + ١
    ارجع {"قيمة": مصفوفة، "تدرج": لاشيء، "آباء": []، "خلفي": لاشيء، "معرف": _عداد، "يحتاج": خطأ}
}

# معامل قابل للتعلّم: تُحسب له تدرجات
صدّر دالة معامل(مصفوفة) {
    _عداد = _عداد + ١
    ارجع {"قيمة": مصفوفة، "تدرج": لاشيء، "آباء": []، "خلفي": لاشيء، "معرف": _عداد، "يحتاج": صحيح}
}

صدّر دالة قيمة(ع) { ارجع ع["قيمة"] }
صدّر دالة تدرج(ع) { ارجع ع["تدرج"] }

صدّر دالة صفّر_تدرجات(معاملات) {
    من_أجل (ع في معاملات) { ع["تدرج"] = لاشيء }
}

# ---------- أدوات التدرج ----------
# يختزل تدرجًا مبثوثًا إلى شكل أصله: يجمع البعد الزائد من اليسار والأبعاد التي كانت ١
دالة _اختزل_للشكل(غ، شكل) {
    متغير ك = غ
    طالما (طول(ك["شكل"]) > طول(شكل)) { ك = م.مجموع(ك، ٠، خطأ) }
    من_أجل (ي من ٠ إلى طول(شكل) - ١) {
        إذا (شكل[ي] == ١ و ك["شكل"][ي] != ١) { ك = م.مجموع(ك، ي، صحيح) }
    }
    ارجع ك
}

دالة _راكم(ع، غ) {
    إذا (ليس ع["يحتاج"]) { ارجع لاشيء }
    إذا (ع["تدرج"] == لاشيء) { ع["تدرج"] = م.نسخة(غ) } وإلا { ع["تدرج"] = م.جمع(ع["تدرج"]، غ) }
}

# ---------- العمليات الحسابية ----------
صدّر دالة جمع(أ، ب) {
    متغير شأ = أ["قيمة"]["شكل"]
    متغير شب = ب["قيمة"]["شكل"]
    ارجع _عقدة(م.جمع(أ["قيمة"]، ب["قيمة"])، [أ، ب]، دالة(غ) {
        ارجع [_اختزل_للشكل(غ، شأ)، _اختزل_للشكل(غ، شب)]
    })
}

صدّر دالة طرح(أ، ب) {
    متغير شأ = أ["قيمة"]["شكل"]
    متغير شب = ب["قيمة"]["شكل"]
    ارجع _عقدة(م.طرح(أ["قيمة"]، ب["قيمة"])، [أ، ب]، دالة(غ) {
        ارجع [_اختزل_للشكل(غ، شأ)، _اختزل_للشكل(م.سالب(غ)، شب)]
    })
}

صدّر دالة ضرب(أ، ب) {
    متغير قأ = أ["قيمة"]
    متغير قب = ب["قيمة"]
    ارجع _عقدة(م.ضرب(قأ، قب)، [أ، ب]، دالة(غ) {
        ارجع [_اختزل_للشكل(م.ضرب(غ، قب)، قأ["شكل"])، _اختزل_للشكل(م.ضرب(غ، قأ)، قب["شكل"])]
    })
}

صدّر دالة قسمة(أ، ب) {
    متغير قأ = أ["قيمة"]
    متغير قب = ب["قيمة"]
    ارجع _عقدة(م.قسمة(قأ، قب)، [أ، ب]، دالة(غ) {
        متغير دأ = م.قسمة(غ، قب)
        متغير دب = م.سالب(م.قسمة(م.ضرب(غ، قأ)، م.ضرب(قب، قب)))
        ارجع [_اختزل_للشكل(دأ، قأ["شكل"])، _اختزل_للشكل(دب، قب["شكل"])]
    })
}

صدّر دالة سالب(أ) {
    ارجع _عقدة(م.سالب(أ["قيمة"])، [أ]، دالة(غ) { ارجع [م.سالب(غ)] })
}

# ضرب عدد ثابت (مفرد) في عقدة
صدّر دالة مقياس(أ، عدد) {
    ارجع _عقدة(م.ضرب(أ["قيمة"]، عدد)، [أ]، دالة(غ) { ارجع [م.ضرب(غ، عدد)] })
}

صدّر دالة ضرب_مصفوفي(أ، ب) {
    متغير قأ = أ["قيمة"]
    متغير قب = ب["قيمة"]
    ارجع _عقدة(م.ضرب_مصفوفي(قأ، قب)، [أ، ب]، دالة(غ) {
        متغير دأ = م.ضرب_مصفوفي(غ، م.منقول(قب))
        متغير دب = م.ضرب_مصفوفي(م.منقول(قأ)، غ)
        ارجع [_اختزل_للشكل(دأ، قأ["شكل"])، _اختزل_للشكل(دب، قب["شكل"])]
    })
}

# ---------- الدوال العنصرية ----------
دالة _عنصرية(أ، دالة_أمامية، دالة_مشتقة_من_المدخل_والمخرج) {
    متغير قأ = أ["قيمة"]
    متغير خرج = م.طبّق_عناصر(قأ، دالة_أمامية)
    ارجع _عقدة(خرج، [أ]، دالة(غ) {
        متغير مشتقة = م.أنشئ(قأ["شكل"]، ٠)
        من_أجل (ي من ٠ إلى طول(قأ["بيانات"]) - ١) {
            مشتقة["بيانات"][ي] = دالة_مشتقة_من_المدخل_والمخرج(قأ["بيانات"][ي]، خرج["بيانات"][ي])
        }
        ارجع [م.ضرب(غ، مشتقة)]
    })
}

صدّر دالة أس(أ) { ارجع _عنصرية(أ، ر.أس، دالة(س، ص) { ارجع ص }) }
صدّر دالة لوغ(أ) { ارجع _عنصرية(أ، ر.لوغ، دالة(س، ص) { ارجع ١ / س }) }
صدّر دالة ظل_قطعي(أ) { ارجع _عنصرية(أ، ر.ظل_قطعي، دالة(س، ص) { ارجع ١ - ص * ص }) }
صدّر دالة سيني(أ) { ارجع _عنصرية(أ، ر.سيني، دالة(س، ص) { ارجع ص * (١ - ص) }) }
صدّر دالة ريلو(أ) {
    ارجع _عنصرية(أ، دالة(س) { إذا (س > ٠) { ارجع س } ارجع ٠ }، دالة(س، ص) { إذا (س > ٠) { ارجع ١ } ارجع ٠ })
}
صدّر دالة مربع(أ) { ارجع _عنصرية(أ، دالة(س) { ارجع س * س }، دالة(س، ص) { ارجع ٢ * س }) }
صدّر دالة جذر_تربيعي(أ) { ارجع _عنصرية(أ، دالة(س) { ارجع جذر(س) }، دالة(س، ص) { ارجع ٠.٥ / ص }) }
# gelu الدقيقة: مشتقتها Φ(x) + x·φ(x)
صدّر دالة جيلو(أ) {
    ارجع _عنصرية(أ، ر.جيلو، دالة(س، ص) {
        ارجع ٠.٥ * (١ + ر.خطأ_غاوس(س / ١.٤١٤٢١٣٥٦٢٣٧٣٠٩٥١)) + س * ر.أس(-س * س / ٢) / ٢.٥٠٦٦٢٨٢٧٤٦٣١٠٠٠٢
    })
}

# ---------- الاختزال ----------
دالة _وسّع_تدرج(غ، شكل_الأصل، محور، أبقِ_البعد) {
    متغير ح = محور
    إذا (ح < ٠) { ح = ح + طول(شكل_الأصل) }
    متغير شكل_مع_بعد = []
    من_أجل (ي من ٠ إلى طول(شكل_الأصل) - ١) {
        إذا (ي == ح) { أضف(شكل_مع_بعد، ١) } وإلا { أضف(شكل_مع_بعد، شكل_الأصل[ي]) }
    }
    ارجع م.ضرب(م.أعد_تشكيل(غ، شكل_مع_بعد)، م.آحاد(شكل_الأصل))
}

صدّر دالة مجموع(أ، محور، أبقِ_البعد) {
    متغير قأ = أ["قيمة"]
    إذا (محور == لاشيء) {
        ارجع _عقدة(م.مجموع(قأ، لاشيء، خطأ)، [أ]، دالة(غ) { ارجع [م.ضرب(م.آحاد(قأ["شكل"])، م.أعد_تشكيل(غ، [])) ] })
    }
    ارجع _عقدة(م.مجموع(قأ، محور، أبقِ_البعد)، [أ]، دالة(غ) { ارجع [_وسّع_تدرج(غ، قأ["شكل"]، محور، أبقِ_البعد)] })
}

صدّر دالة متوسط(أ، محور، أبقِ_البعد) {
    متغير قأ = أ["قيمة"]
    متغير عدد = طول(قأ["بيانات"])
    إذا (محور != لاشيء) {
        متغير ح = محور
        إذا (ح < ٠) { ح = ح + طول(قأ["شكل"]) }
        عدد = قأ["شكل"][ح]
    }
    ارجع مقياس(مجموع(أ، محور، أبقِ_البعد)، ١ / عدد)
}

# ---------- إعادة التشكيل ----------
صدّر دالة أعد_تشكيل(أ، شكل) {
    متغير قأ = أ["قيمة"]
    ارجع _عقدة(م.أعد_تشكيل(قأ، شكل)، [أ]، دالة(غ) { ارجع [م.أعد_تشكيل(غ، قأ["شكل"])] })
}

صدّر دالة بدّل_محاور(أ، محاور) {
    متغير ن = طول(محاور)
    متغير عكس = []
    من_أجل (ي من ٠ إلى ن - ١) { أضف(عكس، ٠) }
    من_أجل (ي من ٠ إلى ن - ١) {
        متغير ح = محاور[ي]
        إذا (ح < ٠) { ح = ح + ن }
        عكس[ح] = ي
    }
    ارجع _عقدة(م.بدّل_محاور(أ["قيمة"]، محاور)، [أ]، دالة(غ) { ارجع [م.بدّل_محاور(غ، عكس)] })
}

صدّر دالة منقول(أ) {
    ارجع _عقدة(م.منقول(أ["قيمة"])، [أ]، دالة(غ) { ارجع [م.منقول(غ)] })
}

# ---------- الضمّ والتقطيع ----------
صدّر دالة ضمّ(عقد، محور) {
    متغير قيم = []
    متغير أبعاد = []
    متغير ح = محور
    إذا (ح < ٠) { ح = ح + طول(عقد[٠]["قيمة"]["شكل"]) }
    من_أجل (ع في عقد) {
        أضف(قيم، ع["قيمة"])
        أضف(أبعاد، ع["قيمة"]["شكل"][ح])
    }
    ارجع _عقدة(م.ضمّ(قيم، ح)، عقد، دالة(غ) {
        متغير نتيجة = []
        متغير بداية = ٠
        من_أجل (ب في أبعاد) {
            أضف(نتيجة، م.شريحة(غ، ح، بداية، بداية + ب))
            بداية = بداية + ب
        }
        ارجع نتيجة
    })
}

صدّر دالة شريحة(أ، محور، بداية، نهاية) {
    متغير قأ = أ["قيمة"]
    متغير ح = محور
    إذا (ح < ٠) { ح = ح + طول(قأ["شكل"]) }
    ارجع _عقدة(م.شريحة(قأ، ح، بداية، نهاية)، [أ]، دالة(غ) {
        متغير أجزاء = []
        إذا (بداية > ٠) {
            متغير ش١ = م.الشكل(قأ)
            ش١[ح] = بداية
            أضف(أجزاء، م.أصفار(ش١))
        }
        أضف(أجزاء، غ)
        إذا (نهاية < قأ["شكل"][ح]) {
            متغير ش٢ = م.الشكل(قأ)
            ش٢[ح] = قأ["شكل"][ح] - نهاية
            أضف(أجزاء، م.أصفار(ش٢))
        }
        ارجع [م.ضمّ(أجزاء، ح)]
    })
}

# ---------- التوزيع والتطبيع ----------
صدّر دالة سوفت_ماكس(أ، محور) {
    متغير ح = محور
    إذا (ح == لاشيء) { ح = -١ }
    متغير خرج = م.سوفت_ماكس(أ["قيمة"]، ح)
    ارجع _عقدة(خرج، [أ]، دالة(غ) {
        متغير غس = م.ضرب(غ، خرج)
        متغير مج = م.مجموع(غس، ح، صحيح)
        ارجع [م.طرح(غس، م.ضرب(خرج، مج))]
    })
}

صدّر دالة لوغ_سوفت_ماكس(أ، محور) {
    متغير ح = محور
    إذا (ح == لاشيء) { ح = -١ }
    متغير قأ = أ["قيمة"]
    ارجع _عقدة(م.لوغ_سوفت_ماكس(قأ، ح)، [أ]، دالة(غ) {
        متغير س = م.سوفت_ماكس(قأ، ح)
        ارجع [م.طرح(غ، م.ضرب(س، م.مجموع(غ، ح، صحيح)))]
    })
}

# تطبيع الطبقة على المحور الأخير؛ تدرجه: (١/ن)·rstd·(ن·g − Σg − x̂·Σ(g·x̂))
صدّر دالة تطبيع_طبقة(أ، إبسيلون) {
    متغير قأ = أ["قيمة"]
    متغير ن = قأ["شكل"][طول(قأ["شكل"]) - ١]
    متغير خرج = م.تطبيع_طبقة(قأ، إبسيلون)
    ارجع _عقدة(خرج، [أ]، دالة(غ) {
        متغير وسط = م.متوسط(قأ، -١، صحيح)
        متغير مركز = م.طرح(قأ، وسط)
        متغير تباين = م.متوسط(م.ضرب(مركز، مركز)، -١، صحيح)
        متغير مقلوب = م.طبّق_عناصر(تباين، دالة(س) { ارجع ١ / جذر(س + إبسيلون) })
        متغير مج_غ = م.مجموع(غ، -١، صحيح)
        متغير مج_غخ = م.مجموع(م.ضرب(غ، خرج)، -١، صحيح)
        متغير داخل = م.طرح(م.طرح(م.ضرب(غ، ن)، مج_غ)، م.ضرب(خرج، مج_غخ))
        ارجع [م.ضرب(م.ضرب(داخل، مقلوب)، ١ / ن)]
    })
}

# ---------- التضمين والخسائر ----------
# جدول [ح، ب] وفهارس صفوف → [عدد، ب]؛ تدرجه يُنثر بالجمع فتتراكم الصفوف المتكررة
صدّر دالة تضمين(جدول، فهارس) {
    متغير قج = جدول["قيمة"]
    متغير ح = قج["شكل"][٠]
    متغير ب = قج["شكل"][١]
    متغير خرج = []
    من_أجل (ف في فهارس) {
        إذا (ف < ٠ أو ف >= ح) { أطلق_خطأ("فهرس التضمين " + نص(ف) + " خارج الجدول") }
        من_أجل (د من ٠ إلى ب - ١) { أضف(خرج، قج["بيانات"][ف * ب + د]) }
    }
    ارجع _عقدة({"بيانات": خرج، "شكل": [طول(فهارس)، ب]}، [جدول]، دالة(غ) {
        متغير تدرج_الجدول = م.أصفار([ح، ب])
        من_أجل (ي من ٠ إلى طول(فهارس) - ١) {
            من_أجل (د من ٠ إلى ب - ١) {
                تدرج_الجدول["بيانات"][فهارس[ي] * ب + د] = تدرج_الجدول["بيانات"][فهارس[ي] * ب + د] + غ["بيانات"][ي * ب + د]
            }
        }
        ارجع [تدرج_الجدول]
    })
}

# إنتروبيا متقاطعة: متوسط −log softmax(سجلات[ي])[هدف[ي]]؛ التدرج (softmax − one-hot)/ن
صدّر دالة خسارة_متقاطعة(سجلات، أهداف) {
    متغير قس = سجلات["قيمة"]
    متغير ن = قس["شكل"][٠]
    متغير ك = قس["شكل"][١]
    متغير لس = م.لوغ_سوفت_ماكس(قس، ١)
    متغير مج = ٠
    من_أجل (ي من ٠ إلى ن - ١) { مج = مج - لس["بيانات"][ي * ك + أهداف[ي]] }
    ارجع _عقدة({"بيانات": [مج / ن]، "شكل": []}، [سجلات]، دالة(غ) {
        متغير س = م.سوفت_ماكس(قس، ١)
        من_أجل (ي من ٠ إلى ن - ١) { س["بيانات"][ي * ك + أهداف[ي]] = س["بيانات"][ي * ك + أهداف[ي]] - ١ }
        ارجع [م.ضرب(س، غ["بيانات"][٠] / ن)]
    })
}

# متوسط مربع الفرق بين عقدة وهدف ثابت
صدّر دالة مربع_الأخطاء(أ، هدف) {
    ارجع متوسط(مربع(طرح(أ، ثابت(هدف)))، لاشيء، خطأ)
}

# ---------- الانتشار العكسي ----------
# ترتيب طوبولوجي بمكدس صريح (بلا عودية عميقة) ثم مراكمة التدرجات من الخسارة إلى الأوراق
صدّر دالة انتشر_خلفا(خسارة) {
    إذا (طول(خسارة["قيمة"]["بيانات"]) != ١) { أطلق_خطأ("انتشر_خلفا تحتاج خسارة مفردة") }
    متغير مزار = {}
    متغير ترتيب = []
    متغير مكدس = [{"عقدة": خسارة، "ابن": ٠}]
    مزار[نص(خسارة["معرف"])] = صحيح
    طالما (طول(مكدس) > ٠) {
        متغير أعلى = مكدس[طول(مكدس) - ١]
        متغير ع = أعلى["عقدة"]
        إذا (أعلى["ابن"] < طول(ع["آباء"])) {
            متغير أب = ع["آباء"][أعلى["ابن"]]
            أعلى["ابن"] = أعلى["ابن"] + ١
            إذا (أب["يحتاج"] و ليس يحوي(مزار، نص(أب["معرف"]))) {
                مزار[نص(أب["معرف"])] = صحيح
                أضف(مكدس، {"عقدة": أب، "ابن": ٠})
            }
        } وإلا {
            أضف(ترتيب، ع)
            انزع(مكدس)
        }
    }
    خسارة["تدرج"] = م.آحاد(خسارة["قيمة"]["شكل"])
    متغير ي = طول(ترتيب) - ١
    طالما (ي >= ٠) {
        متغير ع = ترتيب[ي]
        إذا (ع["خلفي"] != لاشيء و ع["تدرج"] != لاشيء) {
            متغير تدرجات = ع["خلفي"](ع["تدرج"])
            من_أجل (ك من ٠ إلى طول(ع["آباء"]) - ١) { _راكم(ع["آباء"][ك]، تدرجات[ك]) }
        }
        ي = ي - ١
    }
}
