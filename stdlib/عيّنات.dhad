# ضاد/عيّنات — اختيار الرمز التالي من سجلات النموذج: حرارة، top-k، top-p (النواة)، رموز توقف، وتوليد بالعيّنات.
# تعمل على قوائم أرقام عادية (سجلات صف واحد)؛ والمولّد العشوائي حتمي (ضاد/رياضيات) فيعيد التشغيل الأرقام نفسها.

متغير ر = استورد("ضاد/رياضيات")
متغير ط = استورد("ضاد/طبقات")

# فهارس مرتبة تنازليًا بالقيمة، وعند التعادل بالفهرس الأصغر (حتمية كاملة)
دالة _رتّب_فهارس(قيم) {
    متغير ف = []
    من_أجل (ي في مدى(طول(قيم))) {
        متغير ك = طول(ف)
        أضف(ف، ي)
        طالما (ك > ٠ و قيم[ف[ك - ١]] < قيم[ي]) { ف[ك] = ف[ك - ١]; ك = ك - ١ }
        ف[ك] = ي
    }
    ارجع ف
}

# توزيع الاحتمال بعد الحرارة والقصّ: السجلات تُقسَم على الحرارة، ثم softmax، ثم تُبقى أعلى ك رموز
# (٠ = بلا قصّ) ثم أصغر مجموعة مجموع احتمالها ≥ أعلى_ب (١ = بلا قصّ) ويُعاد التطبيع.
صدّر دالة توزيع(سجلات، حرارة = ١، أعلى_ك = ٠، أعلى_ب = ١) {
    إذا (حرارة <= ٠) { أطلق_خطأ("العيّنات: الحرارة يجب أن تكون موجبة؛ استعمل اختر_الأكبر للقرار الحتمي") }
    متغير ن = طول(سجلات)
    متغير أكبر = سجلات[٠]
    من_أجل (س في سجلات) { إذا (س > أكبر) { أكبر = س } }
    متغير أ = []
    متغير مج = ٠
    من_أجل (س في سجلات) {
        متغير ق = ر.أس((س - أكبر) / حرارة)
        أضف(أ، ق)
        مج = مج + ق
    }
    من_أجل (ي في مدى(ن)) { أ[ي] = أ[ي] / مج }
    متغير ترتيب = _رتّب_فهارس(أ)
    متغير يبقى = ن
    إذا (أعلى_ك > ٠ و أعلى_ك < يبقى) { يبقى = أعلى_ك }
    إذا (أعلى_ب < ١) {
        متغير تراكم = ٠
        متغير عدد = ٠
        من_أجل (ك في ترتيب) {
            إذا (عدد >= يبقى) { توقف }
            تراكم = تراكم + أ[ك]
            عدد = عدد + ١
            إذا (تراكم >= أعلى_ب) { توقف }
        }
        يبقى = عدد
    }
    متغير خرج = []
    من_أجل (ي في مدى(ن)) { أضف(خرج، ٠) }
    متغير مجموع = ٠
    من_أجل (ي في مدى(يبقى)) { مجموع = مجموع + أ[ترتيب[ي]] }
    من_أجل (ي في مدى(يبقى)) { خرج[ترتيب[ي]] = أ[ترتيب[ي]] / مجموع }
    ارجع خرج
}

# الرمز الأكبر (عند التعادل الأصغر فهرسًا)
صدّر دالة اختر_الأكبر(سجلات) {
    متغير أفضل = ٠
    من_أجل (ي في مدى(طول(سجلات))) { إذا (سجلات[ي] > سجلات[أفضل]) { أفضل = ي } }
    ارجع أفضل
}

# سحب من توزيع بعكس دالة التوزيع التراكمي بعدد عشوائي من المولّد
صدّر دالة اسحب(احتمالات، مولد) {
    متغير س = ر.تالي(مولد)
    متغير تراكم = ٠
    متغير آخر = ٠
    من_أجل (ي في مدى(طول(احتمالات))) {
        إذا (احتمالات[ي] > ٠) {
            آخر = ي
            تراكم = تراكم + احتمالات[ي]
            إذا (س < تراكم) { ارجع ي }
        }
    }
    ارجع آخر
}

# عيّنة واحدة؛ حرارة ٠ = قرار حتمي
صدّر دالة عيّن(سجلات، مولد، حرارة = ١، أعلى_ك = ٠، أعلى_ب = ١) {
    إذا (حرارة == ٠) { ارجع اختر_الأكبر(سجلات) }
    ارجع اسحب(توزيع(سجلات، حرارة، أعلى_ك، أعلى_ب)، مولد)
}

# آخر صف من مصفوفة سجلات [ط، مفردات] كقائمة
صدّر دالة آخر_صف(سجلات) {
    متغير ص = سجلات["شكل"][٠]
    متغير ف = سجلات["شكل"][١]
    متغير خرج = []
    من_أجل (ك في مدى(ف)) { أضف(خرج، سجلات["بيانات"][(ص - ١) * ف + ك]) }
    ارجع خرج
}

دالة يحوي_قائمة(قائمة، قيمة) {
    من_أجل (ع في قائمة) { إذا (ع == قيمة) { ارجع صحيح } }
    ارجع خطأ
}

# توليد بالعيّنات. خيارات: {"حرارة"، "أعلى_ك"، "أعلى_ب"، "توقف": قائمة معرّفات تنهي التوليد (ولا تُضاف)}
صدّر دالة ولّد(ن، بداية، عدد، مولد، خيارات = {}) {
    متغير حرارة = ١
    متغير أعلى_ك = ٠
    متغير أعلى_ب = ١
    متغير رموز_نهاية = []
    إذا (يحوي(خيارات، "حرارة")) { حرارة = خيارات["حرارة"] }
    إذا (يحوي(خيارات، "أعلى_ك")) { أعلى_ك = خيارات["أعلى_ك"] }
    إذا (يحوي(خيارات، "أعلى_ب")) { أعلى_ب = خيارات["أعلى_ب"] }
    إذا (يحوي(خيارات، "توقف")) { رموز_نهاية = خيارات["توقف"] }
    متغير رموز = []
    من_أجل (ك في بداية) { أضف(رموز، ك) }
    من_أجل (ي في مدى(عدد)) {
        إذا (طول(رموز) >= ن["إعداد"]["أقصى_طول"]) { ارجع رموز }
        متغير س = عيّن(آخر_صف(ط.أمام(ن، رموز)["قيمة"])، مولد، حرارة، أعلى_ك، أعلى_ب)
        إذا (يحوي_قائمة(رموز_نهاية، س)) { ارجع رموز }
        أضف(رموز، س)
    }
    ارجع رموز
}
