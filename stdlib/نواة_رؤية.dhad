# ضاد/نواة_رؤية — محرك الرؤية الحاسوبية الكلاسيكي لصفحات المخطوطات والمطبوعات (منقول من «المُحَرِّر» ومبني على نوى الآلة):
# رمادي ← ثنائية ساوفولا التكيفية (تعزل الحبر عن رق متفاوت الإضاءة حيث تفشل العتبة العامة) ← مساقط ← تقطيع السطور وحدود المتن ← نسبة المداد الأحمر.
# كل الصور قوائم مسطحة: RGBA بأربع قنوات للبكسل، والرمادي والثنائي بقناة واحدة بترتيب الصفوف.

صدّر دالة رمادي(رغب، ع، ط) { ارجع نواة_رمادي(رغب، ع، ط) }

# خيارات: {"نصف_القطر": ١٥، "ك": ٠.٢، "مدى": ١٢٨}؛ الناتج ١ للحبر و٠ للخلفية
صدّر دالة ثنّئ(رمادية، ع، ط، خيارات) {
    متغير خ = خيارات
    إذا (خ == لاشيء) { خ = {} }
    متغير نق = ١٥
    متغير ك = ٠.٢
    متغير مدى = ١٢٨
    إذا ("نصف_القطر" في خ) { نق = خ["نصف_القطر"] }
    إذا ("ك" في خ) { ك = خ["ك"] }
    إذا ("مدى" في خ) { مدى = خ["مدى"] }
    ارجع نواة_ثنائي_ساوفولا(رمادية، ع، ط، نق، ك، مدى)
}

# عتبة عامة ثابتة (للمقارنة والاختبار): ١ حيث الرمادي ≤ العتبة
صدّر دالة عتبة_عامة(رمادية، عتبة) {
    متغير خرج = []
    من_أجل (ق في رمادية) { إذا (ق <= عتبة) { أضف(خرج، ١) } وإلا { أضف(خرج، ٠) } }
    ارجع خرج
}

# تقطيع السطور من المسقط الأفقي: صفوف كثافتها ≥ نسبة من أعلى صف تُجمَّع في سطر، وتُدمج الفجوات الأقصر من «فجوة»،
# ويُهمل ما ارتفاعه دون «أدنى_ارتفاع». كل سطر: {"بداية"، "نهاية"، "كثافة"} (الصفوف شاملة).
صدّر دالة سطور(ثنائية، ع، ط، خيارات) {
    متغير خ = خيارات
    إذا (خ == لاشيء) { خ = {} }
    متغير نسبة = ٠.١٥
    متغير فجوة = ١
    متغير أدنى = ٢
    إذا ("نسبة" في خ) { نسبة = خ["نسبة"] }
    إذا ("فجوة" في خ) { فجوة = خ["فجوة"] }
    إذا ("أدنى_ارتفاع" في خ) { أدنى = خ["أدنى_ارتفاع"] }
    متغير م = نواة_مساقط(ثنائية، ع، ط)
    متغير صفوف = م[٠]
    متغير أعلى = ٠
    من_أجل (ق في صفوف) { إذا (ق > أعلى) { أعلى = ق } }
    إذا (أعلى == ٠) { ارجع [] }
    متغير حد = أعلى * نسبة
    متغير خام = []
    متغير بداية = -١
    من_أجل (ي من ٠ إلى ط - ١) {
        إذا (صفوف[ي] >= حد و صفوف[ي] > ٠) {
            إذا (بداية < ٠) { بداية = ي }
        } وإلا {
            إذا (بداية >= ٠) { أضف(خام، [بداية، ي - ١]); بداية = -١ }
        }
    }
    إذا (بداية >= ٠) { أضف(خام، [بداية، ط - ١]) }
    متغير مدمج = []
    من_أجل (ق في خام) {
        إذا (طول(مدمج) > ٠ و ق[٠] - مدمج[طول(مدمج) - ١][١] - ١ <= فجوة) {
            مدمج[طول(مدمج) - ١][١] = ق[١]
        } وإلا {
            أضف(مدمج، [ق[٠]، ق[١]])
        }
    }
    متغير نتيجة = []
    من_أجل (ق في مدمج) {
        إذا (ق[١] - ق[٠] + ١ >= أدنى) {
            متغير مج = ٠
            من_أجل (ي من ق[٠] إلى ق[١]) { مج = مج + صفوف[ي] }
            أضف(نتيجة، {"بداية": ق[٠]، "نهاية": ق[١]، "كثافة": مج})
        }
    }
    ارجع نتيجة
}

# حدود كتلة المتن أفقيًا من المسقط العمودي: أول وآخر عمود كثافته ≥ نسبة من الارتفاع (افتراضيًا ٤٪). تعيد {"يسار"، "يمين"} أو لاشيء إن خلت الصفحة.
صدّر دالة حدود_المتن(ثنائية، ع، ط، نسبة) {
    متغير ن = نسبة
    إذا (ن == لاشيء) { ن = ٠.٠٤ }
    متغير أعمدة = نواة_مساقط(ثنائية، ع، ط)[١]
    متغير حد = ط * ن
    متغير يسار = -١
    متغير يمين = -١
    من_أجل (ي من ٠ إلى ع - ١) {
        إذا (أعمدة[ي] > حد) {
            إذا (يسار < ٠) { يسار = ي }
            يمين = ي
        }
    }
    إذا (يسار < ٠) { ارجع لاشيء }
    ارجع {"يسار": يسار، "يمين": يمين}
}

# كثافة الحبر ونسبة المداد الأحمر (الحمرة) في الصورة الملوّنة
صدّر دالة نسبة_الحمرة(رغب، ع، ط) {
    متغير قناع = نواة_حمرة(رغب، ع، ط)
    متغير مج = ٠
    من_أجل (ق في قناع) { مج = مج + ق }
    إذا (ع * ط == ٠) { ارجع ٠ }
    ارجع مج / (ع * ط)
}

صدّر دالة نسبة_الحبر(ثنائية) {
    إذا (طول(ثنائية) == ٠) { ارجع ٠ }
    متغير مج = ٠
    من_أجل (ق في ثنائية) { مج = مج + ق }
    ارجع مج / طول(ثنائية)
}
