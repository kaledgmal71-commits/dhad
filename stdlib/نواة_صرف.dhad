# ضاد/نواة_صرف — محلل صرفي يعدّد كل التحليلات الممكنة للكلمة (بادئة + جذع + لاحقة، ثم وزن وجذر) ويعطي لكل تحليل درجة ثقة،
# ويعترف بالغموض بدل تخمين تحليل واحد وتشكيل إعرابي. (الأصل في «المُحَرِّر» كان يلتقط أول بادئة وأول لاحقة ويخمّن الإعراب.)
# الأوزان قوالب بحروف ف ع ل مواضعَ للجذر وما عداها حروف حرفية؛ الدرجة ترتفع بعدد الحروف الحرفية في الوزن (وزن أخص أدلّ)
# وتنخفض مع كل بادئة أو لاحقة وعند اعتلال الجذر. معجم الجذور الاختياري (من مكتبة المستخدم) يرفع التحليلات التي جذرها فيه.
# الكلمات تُطبَّع (بلا تشكيل، همزات ← ا، ة ← ه، ى ← ي) فيأتي الجذر بصورته المطبَّعة.

متغير ر = استورد("ضاد/نواة_رسم")
متغير ن = استورد("ضاد/نصوص")

# أوزان: [الاسم، القالب المطبَّع، النوع]
متغير _أوزان = [
    ["فَعَل"، "فعل"، "اسم أو فعل"]،
    ["فاعِل"، "فاعل"، "اسم"]، ["مفعول"، "مفعول"، "اسم"]، ["مَفعَل"، "مفعل"، "اسم"]، ["مَفعَلة"، "مفعله"، "اسم"]،
    ["فِعال"، "فعال"، "اسم"]، ["فَعيل"، "فعيل"، "اسم"]، ["فَعول"، "فعول"، "اسم"]، ["فِعالة"، "فعاله"، "اسم"]،
    ["فاعِلة"، "فاعله"، "اسم"]، ["مِفعال"، "مفعال"، "اسم"]، ["فُعلة"، "فعله"، "اسم"]، ["فَعّال"، "فعال"، "اسم"]، ["أفعَل"، "افعل"، "فعل أو اسم"]،
    ["تفعيل"، "تفعيل"، "اسم"]، ["تفاعُل"، "تفاعل"، "اسم أو فعل"]، ["افتعال"، "افتعال"، "اسم"]، ["انفعال"، "انفعال"، "اسم"]،
    ["استفعال"، "استفعال"، "اسم"]، ["استفعَل"، "استفعل"، "فعل"]، ["افتعَل"، "افتعل"، "فعل"]، ["انفعَل"، "انفعل"، "فعل"]،
    ["تفعَّل"، "تفعل"، "فعل"]، ["مُفاعَلة"، "مفاعله"، "اسم"]، ["مُفعِل"، "مفعل"، "اسم"]، ["مُتفعِّل"، "متفعل"، "اسم"]،
    ["مُستفعِل"، "مستفعل"، "اسم"]، ["مُنفعِل"، "منفعل"، "اسم"]، ["مُفتعِل"، "مفتعل"، "اسم"]، ["مُتفاعِل"، "متفاعل"، "اسم"]،
    ["يَفعَل"، "يفعل"، "فعل مضارع"]، ["نَفعَل"، "نفعل"، "فعل مضارع"]، ["يستفعل"، "يستفعل"، "فعل مضارع"]،
    ["تستفعل"، "تستفعل"، "فعل مضارع"]، ["ينفعل"، "ينفعل"، "فعل مضارع"]، ["يفتعل"، "يفتعل"، "فعل مضارع"]،
    ["يتفعل"، "يتفعل"، "فعل مضارع"]، ["يفاعل"، "يفاعل"، "فعل مضارع"]
]

متغير _بوادئ = [""، "و"، "ف"، "ب"، "ك"، "ل"، "س"، "ال"، "وال"، "فال"، "بال"، "كال"، "لل"، "ولل"، "فلل"، "وب"، "فب"، "ول"، "فل"، "وك"، "وس"، "فس"، "وبال"، "وكال"، "فبال"، "فكال"]
متغير _لواحق = [""، "ه"، "ها"، "هم"، "هن"، "هما"، "ك"، "كم"، "كن"، "نا"، "ني"، "ي"، "ون"، "ين"، "ان"، "ات"، "وا"، "ا"، "ن"، "ت"، "تم"، "تن"، "تما"، "كما"]

# كلمات مبنية معروفة (بصورتها المطبَّعة) ودورها
متغير _مبنيات = {"من": "حرف جر"، "الي": "حرف جر"، "عن": "حرف جر"، "علي": "حرف جر"، "في": "حرف جر"، "ان": "حرف توكيد ونصب أو مصدري"،
    "كان": "فعل ماض ناقص"، "لكن": "حرف استدراك"، "ليت": "حرف تمن"، "لعل": "حرف ترج"، "لم": "حرف نفي وجزم"،
    "لن": "حرف نفي ونصب"، "لا": "حرف نفي"، "ما": "حرف نفي أو اسم موصول"، "قد": "حرف تحقيق أو تقليل"، "بل": "حرف إضراب"، "ثم": "حرف عطف"،
    "او": "حرف عطف"، "هل": "حرف استفهام"، "اذا": "ظرف شرط"، "اذ": "ظرف"، "الا": "أداة استثناء"، "هذا": "اسم إشارة"، "هذه": "اسم إشارة"،
    "ذلك": "اسم إشارة"، "تلك": "اسم إشارة"، "الذي": "اسم موصول"، "التي": "اسم موصول"، "الذين": "اسم موصول"، "هو": "ضمير"، "هي": "ضمير"،
    "هم": "ضمير"، "نحن": "ضمير"، "انا": "ضمير"، "انت": "ضمير"، "حدثنا": "صيغة أداء"، "اخبرنا": "صيغة أداء"، "انبانا": "صيغة أداء"، "سمعت": "صيغة سماع"}

دالة _قالب_يطابق(جذع، قالب) {
    إذا (طول(جذع) != طول(قالب)) { ارجع لاشيء }
    متغير جذر = ""
    من_أجل (ي من ٠ إلى طول(قالب) - ١) {
        متغير ق = قالب[ي]
        إذا (ق == "ف" أو ق == "ع" أو ق == "ل") {
            جذر = جذر + جذع[ي]
        } وإلا إذا (ق != جذع[ي]) {
            ارجع لاشيء
        }
    }
    ارجع جذر
}

دالة _حرفية(قالب) { ارجع طول(قالب) - ٣ }

دالة _معتل(جذر) {
    من_أجل (ح في جذر) { إذا (ح == "ا" أو ح == "و" أو ح == "ي") { ارجع صحيح } }
    ارجع خطأ
}

# كل تحليلات الكلمة مرتبةً بالثقة تنازليًا. خيارات: {"معجم": خريطة جذور، "أقصى": عدد}
# كل تحليل: {"كلمة"، "بادئة"، "جذع"، "لاحقة"، "جذر"، "وزن"، "نوع"، "ثقة"}
صدّر دالة حلّل(كلمة، خيارات) {
    متغير خ = خيارات
    إذا (خ == لاشيء) { خ = {} }
    متغير ط = ر.طبّع_للمقابلة(كلمة)
    إذا (طول(ط) == ٠) { ارجع [] }
    إذا (ط في _مبنيات) {
        ارجع [{"كلمة": كلمة، "بادئة": ""، "جذع": ط، "لاحقة": ""، "جذر": لاشيء، "وزن": "مبني"، "نوع": _مبنيات[ط]، "ثقة": ١}]
    }
    متغير مرشحون = []
    متغير ترتيب = ٠
    من_أجل (ب في _بوادئ) {
        إذا (ط[٠:طول(ب)] == ب) {
            من_أجل (ل في _لواحق) {
                متغير نهاية = طول(ط) - طول(ل)
                إذا (نهاية >= طول(ب) + ٣ و ط[نهاية:طول(ط)] == ل) {
                    متغير جذع = ط[طول(ب):نهاية]
                    من_أجل (وزّ في _أوزان) {
                        متغير جذر = _قالب_يطابق(جذع، وزّ[١])
                        إذا (جذر != لاشيء) {
                            متغير درجة = ١ + _حرفية(وزّ[١])
                            إذا (ب != "") { درجة = درجة * ٠.٦ }
                            إذا (ب[طول(ب) - ١:طول(ب)] == "ك") { درجة = درجة * ٠.٥ }
                            إذا (ل != "") { درجة = درجة * ٠.٦ }
                            إذا (_معتل(جذر)) { درجة = درجة * ٠.٥ }
                            إذا ("معجم" في خ) { إذا (جذر في خ["معجم"]) { درجة = درجة * ٣ } }
                            ترتيب = ترتيب + ١
                            أضف(مرشحون، {"كلمة": كلمة، "بادئة": ب، "جذع": جذع، "لاحقة": ل، "جذر": جذر، "وزن": وزّ[٠]، "نوع": وزّ[٢]، "ثقة": درجة، "_ترتيب": ترتيب})
                        }
                    }
                }
            }
        }
    }
    إذا (طول(مرشحون) == ٠) { ارجع [] }
    متغير مرتبة = رتب(مرشحون، دالة(أ، ب) {
        إذا (أ["ثقة"] > ب["ثقة"]) { ارجع -١ }
        إذا (أ["ثقة"] < ب["ثقة"]) { ارجع ١ }
        ارجع أ["_ترتيب"] - ب["_ترتيب"]
    })
    متغير مجموع = ٠
    من_أجل (م في مرتبة) { مجموع = مجموع + م["ثقة"] }
    متغير نتيجة = []
    متغير أقصى = طول(مرتبة)
    إذا ("أقصى" في خ) { إذا (خ["أقصى"] < أقصى) { أقصى = خ["أقصى"] } }
    من_أجل (ي من ٠ إلى أقصى - ١) {
        متغير م = مرتبة[ي]
        أضف(نتيجة، {"كلمة": م["كلمة"]، "بادئة": م["بادئة"]، "جذع": م["جذع"]، "لاحقة": م["لاحقة"]، "جذر": م["جذر"]، "وزن": م["وزن"]، "نوع": م["نوع"]، "ثقة": م["ثقة"] / مجموع})
    }
    ارجع نتيجة
}

# أفضل تحليل أو لاشيء
صدّر دالة أفضل(كلمة، خيارات) {
    متغير ح = حلّل(كلمة، خيارات)
    إذا (طول(ح) == ٠) { ارجع لاشيء }
    ارجع ح[٠]
}

# أكثر الجذور تكرارًا في نص: قائمة [جذر، عدد] مرتبة تنازليًا (من أفضل تحليل لكل كلمة ثقته ≥ الحد، افتراضيًا ٠٫٣)
صدّر دالة جذور_النص(نص، أعلى، حد) {
    متغير ح٠ = حد
    إذا (ح٠ == لاشيء) { ح٠ = ٠.٣ }
    متغير عدّاد = {}
    من_أجل (ك في ن.كلمات(نص)) {
        متغير ف = أفضل(ك، لاشيء)
        إذا (ف != لاشيء) {
            إذا (ف["جذر"] != لاشيء و ف["ثقة"] >= ح٠) {
                إذا (ف["جذر"] في عدّاد) { عدّاد[ف["جذر"]] = عدّاد[ف["جذر"]] + ١ } وإلا { عدّاد[ف["جذر"]] = ١ }
            }
        }
    }
    متغير قائمة = []
    من_أجل (ج في مفاتيح(عدّاد)) { أضف(قائمة، [ج، عدّاد[ج]]) }
    متغير مرتبة = رتب(قائمة، دالة(أ، ب) {
        إذا (أ[١] != ب[١]) { ارجع ب[١] - أ[١] }
        إذا (أ[٠] < ب[٠]) { ارجع -١ }
        إذا (أ[٠] > ب[٠]) { ارجع ١ }
        ارجع ٠
    })
    إذا (أعلى == لاشيء) { ارجع مرتبة }
    ارجع مرتبة[٠:أعلى]
}
