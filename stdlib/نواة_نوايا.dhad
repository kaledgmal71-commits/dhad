# ضاد/نواة_نوايا — مصنِّف نوايا متعلَّم: انحدار softmax على سمات حروف وكلمات مجزّأة (hash)، تدريبًا واستدلالًا بضاد.
# السمات: كلمات، وأجزاء حرفية (٣ و٤) بحدود الكلمة، وأزواج كلمات، وطول الكلام. الأوزان في «ضاد/نواة_نوايا_أوزان» (مُدرَّبة بهذه الوحدة نفسها).
# عامة: لا تعرف لغة ولا نوعًا بعينه؛ التصنيفات والبيانات تأتي من الخارج. الامتناع عند ضعف الثقة يقرره الاستدعاء.

متغير ن = استورد("ضاد/نصوص")
متغير ر = استورد("ضاد/رياضيات")
متغير أ٥ = استورد("ضاد/نواة_نوايا_أوزان")

متغير _أبعاد = ٤٠٩٦

دالة _تجزئة(س) {
    متغير خ = ٥٣٨١
    من_أجل (ح في س) { خ = (خ * ٣٣ + رمز(ح)) % ١٠٠٠٠٠٣ }
    ارجع خ % _أبعاد
}

# تطبيع: بلا تشكيل ولا تطويل، ألف وياء وهاء موحّدة، وما ليس حرفًا ولا رقمًا يصير فراغًا
دالة _طبّع(س) {
    متغير ف = ن.طبّع_للبحث(س)
    متغير ناتج = ""
    متغير سابق_فراغ = صحيح
    من_أجل (ح في ف) {
        متغير مقبول = ن.هل_حرف_عربي(ح) أو ن.هل_حرف_لاتيني(ح) أو ن.هل_رقم(ح)
        إذا (مقبول) { ناتج = ناتج + ح; سابق_فراغ = خطأ }
        وإلا إذا (ليس سابق_فراغ) { ناتج = ناتج + " "; سابق_فراغ = صحيح }
    }
    إذا (طول(ناتج) > ٠ و ناتج[طول(ناتج) - ١] == " ") { ناتج = ناتج[٠:طول(ناتج) - ١] }
    ارجع ناتج
}

دالة _موضع(قائمة، قيمة) {
    من_أجل (ي في مدى(طول(قائمة))) { إذا (قائمة[ي] == قيمة) { ارجع ي } }
    ارجع -١
}

دالة _أضف(خريطة، مفتاح) {
    متغير ي = _تجزئة(مفتاح)
    إذا (يحوي(خريطة، ي)) { خريطة[ي] = خريطة[ي] + ١ } وإلا { خريطة[ي] = ١ }
}

# سمات الكلام: خريطة {فهرس: قيمة} مطبَّعة بالطول الإقليدي
صدّر دالة سمات(كلام) {
    متغير ك = []
    من_أجل (ج في افصل(_طبّع(كلام)، " ")) { إذا (ج != "") { أضف(ك، ج) } }
    متغير خ = {}
    من_أجل (ج في ك) {
        _أضف(خ، "w:" + ج)
        متغير ف = " " + ج + " "
        من_أجل (ط في [٣، ٤]) {
            من_أجل (ي في مدى(طول(ف) - ط + ١)) { _أضف(خ، "c:" + ف[ي:ي + ط]) }
        }
    }
    من_أجل (ي في مدى(طول(ك) - ١)) { _أضف(خ، "b:" + ك[ي] + " " + ك[ي + ١]) }
    متغير ع = طول(ك)
    إذا (ع > ٨) { ع = ٨ }
    _أضف(خ، "n:" + نص(ع))
    متغير مجموع = ٠
    من_أجل (م في مفاتيح(خ)) { مجموع = مجموع + خ[م] * خ[م] }
    متغير جذر_ = جذر(مجموع)
    إذا (جذر_ == ٠) { ارجع خ }
    من_أجل (م في مفاتيح(خ)) { خ[م] = خ[م] / جذر_ }
    ارجع خ
}

دالة _احتمالات(درجات) {
    متغير أكبر = درجات[٠]
    من_أجل (د في درجات) { إذا (د > أكبر) { أكبر = د } }
    متغير آس = []
    متغير مجموع = ٠
    من_أجل (د في درجات) { متغير ق = ر.أس(د - أكبر); أضف(آس، ق); مجموع = مجموع + ق }
    متغير خ = []
    من_أجل (ق في آس) { أضف(خ، ق / مجموع) }
    ارجع خ
}

# تدريب: بيانات = [[كلام، تصنيف]...]؛ خيارات {دورات، معدل، تنظيم}؛ يعيد {تصنيفات، أوزان: {فهرس: [قيمة لكل تصنيف]}، انحياز}
صدّر دالة درّب(بيانات، خيارات) {
    متغير دورات = ٤٠
    متغير معدل = ٥ / ١٠
    متغير تنظيم = ١ / ١٠٠٠٠
    إذا (يحوي(خيارات، "دورات")) { دورات = خيارات["دورات"] }
    إذا (يحوي(خيارات، "معدل")) { معدل = خيارات["معدل"] }
    إذا (يحوي(خيارات، "تنظيم")) { تنظيم = خيارات["تنظيم"] }
    متغير تصنيفات = []
    من_أجل (د في بيانات) { إذا (ليس يحوي(تصنيفات، د[١])) { أضف(تصنيفات، د[١]) } }
    متغير عدد_ت = طول(تصنيفات)
    متغير عيّنات = []
    متغير تكرار = {}
    من_أجل (د في بيانات) {
        أضف(عيّنات، {"س": سمات(د[٠]), "ص": _موضع(تصنيفات، د[١])})
        إذا (يحوي(تكرار، د[١])) { تكرار[د[١]] = تكرار[د[١]] + ١ } وإلا { تكرار[د[١]] = ١ }
    }
    متغير ص٥ = []
    متغير ب = []
    من_أجل (ج في تصنيفات) {
        متغير صف = []
        من_أجل (ي في مدى(_أبعاد)) { أضف(صف، ٠) }
        أضف(ص٥، صف)
        أضف(ب، ٠)
    }
    متغير ترتيب = []
    من_أجل (ي في مدى(طول(عيّنات))) { أضف(ترتيب، ي) }
    متغير بذرة = ١٣
    من_أجل (دورة في مدى(دورات)) {
        # خلط حتمي (فيشر–ييتس) بمولّد خطي صغير لا يتجاوز دقة الأعداد
        من_أجل (ي في مدى(طول(ترتيب) - ١، ٠، -١)) {
            بذرة = (بذرة * ١٦٨٠٧) % ٢١٤٧٤٨٣٦٤٧
            متغير ك = بذرة % (ي + ١)
            متغير ت = ترتيب[ي]
            ترتيب[ي] = ترتيب[ك]
            ترتيب[ك] = ت
        }
        من_أجل (ي في ترتيب) {
            متغير ع = عيّنات[ي]
            متغير درجات = []
            من_أجل (ج في مدى(عدد_ت)) {
                متغير أ = ب[ج]
                من_أجل (م في مفاتيح(ع["س"])) { أ = أ + ص٥[ج][م] * ع["س"][م] }
                أضف(درجات، أ)
            }
            متغير ح = _احتمالات(درجات)
            متغير ثقل = طول(عيّنات) / (عدد_ت * تكرار[تصنيفات[ع["ص"]]])
            من_أجل (ج في مدى(عدد_ت)) {
                متغير غ = ح[ج]
                إذا (ج == ع["ص"]) { غ = غ - ١ }
                غ = غ * ثقل
                من_أجل (م في مفاتيح(ع["س"])) { ص٥[ج][م] = ص٥[ج][م] - معدل * (غ * ع["س"][م] + تنظيم * ص٥[ج][م]) }
                ب[ج] = ب[ج] - معدل * غ
            }
        }
    }
    # حفظ متناثر: ما له وزن غير مهمل فقط، مقرَّب إلى ثلاث منازل عشرية (عددًا صحيحًا ×١٠٠٠)
    متغير أوزان_ = {}
    من_أجل (م في مدى(_أبعاد)) {
        متغير غير_صفر = خطأ
        متغير قيم = []
        من_أجل (ج في مدى(عدد_ت)) {
            متغير ق = جولة(ص٥[ج][م] * ١٠٠٠)
            إذا (ق != ٠) { غير_صفر = صحيح }
            أضف(قيم، ق)
        }
        إذا (غير_صفر) { أوزان_[م] = قيم }
    }
    متغير انحياز = []
    من_أجل (ج في مدى(عدد_ت)) { أضف(انحياز، جولة(ب[ج] * ١٠٠٠)) }
    ارجع {"تصنيفات": تصنيفات، "أوزان": أوزان_، "انحياز": انحياز}
}

# تصنيف بنموذج (من درّب أو من ملف الأوزان): يعيد {نية، ثقة، احتمالات}
صدّر دالة صنّف(نموذج، كلام) {
    متغير ع = سمات(كلام)
    متغير درجات = []
    من_أجل (ج في مدى(طول(نموذج["تصنيفات"]))) {
        متغير أ = نموذج["انحياز"][ج] / ١٠٠٠
        من_أجل (م في مفاتيح(ع)) {
            إذا (يحوي(نموذج["أوزان"]، م)) { أ = أ + نموذج["أوزان"][م][ج] / ١٠٠٠ * ع[م] }
        }
        أضف(درجات، أ)
    }
    متغير ح = _احتمالات(درجات)
    متغير أفضل = ٠
    من_أجل (ج في مدى(طول(ح))) { إذا (ح[ج] > ح[أفضل]) { أفضل = ج } }
    ارجع {"نية": نموذج["تصنيفات"][أفضل]، "ثقة": ح[أفضل]، "احتمالات": ح}
}

# قرار الاستدعاء: يصنّف بالنموذج المحفوظ؛ يعيد {نية، فرعي، ثقة} حيث «نية» التصنيف الأعم (الحوار كله «حوار») و«فرعي» نوعه («تحية» ...)
صدّر دالة قرّر(كلام) {
    متغير ق = صنّف(أ٥.نموذج()، كلام)
    متغير نية = ق["نية"]
    إذا (ق["ثقة"] < أ٥.عتبة()) { نية = "خارج_النطاق" }
    متغير فرعي = ""
    إذا (طول(نية) > ٥ و نية[٠:٥] == "حوار:") {
        فرعي = نية[٥:طول(نية)]
        نية = "حوار"
    }
    ارجع {"نية": نية، "فرعي": فرعي، "ثقة": ق["ثقة"]}
}
