# ضاد/نواة_مجزئ — المجزِّئ (Tokenizer) الذي تقوم عليه محركات نواة: يفكّك النص إلى رموز فرعية تُتعلَّم من المدوّنة.
# تقنيته: دمج أزواج الرموز الأكثر تكرارًا (BPE) فوق حروف يونيكود، مع رجوع إلى بايتات UTF-8
# لأي حرف غير مرئي في التدريب، فلا يضيع نص أبدًا (الترميز ثم الفكّ يعيدان النص حرفًا بحرف).
# المفردات: ٠ <pad>، ١ <unk>، ٢ <bos>، ٣ <eos>، ثم ٢٥٦ رمز بايت، ثم الحروف، ثم الدمجات بترتيب تعلّمها.
# الفراغ الذي يسبق كلمة يُحمل في أولها بالعلامة ▁؛ والحرف ▁ نفسه في المدخل يُعامَل فراغًا.

متغير _علامة = "▁"
متغير _خاصة = ["<pad>"، "<unk>"، "<bos>"، "<eos>"]
متغير _هكس = "0123456789ABCDEF"
متغير _بديل = حرف(٦٥٥٣٣)

# مفتاح زوج الرموز: «طول الأول:الأول الثاني» فلا يلتبس بأي حرف في النص
دالة _مفتاح(أ، ب) {
    ارجع نص(طول(أ)) + ":" + أ + ب
}

دالة _فك_المفتاح(م) {
    متغير ن = موضع(م، ":")
    متغير ط = عدد(اقتطع(م، ٠، ن))
    ارجع [اقتطع(م، ن + ١، ن + ١ + ط)، اقتطع(م، ن + ١ + ط)]
}

# ---------- تصنيف الحروف ----------
دالة _فراغ(ر) {
    ارجع ر == ٣٢ أو ر == ٩ أو ر == ١٠ أو ر == ١٣ أو ر == ١٢ أو ر == ١٦٠ أو ر == ١١ أو (ر >= ٨١٩٢ و ر <= ٨٢٠٢) أو ر == ١٢٢٨٨
}

# علامة ترقيم أو رمز (يُفصل عن الكلمة): ما عدا الحروف والأرقام والتشكيل والتطويل و _
دالة _ترقيم(ر) {
    إذا (ر == ٩٥) { ارجع خطأ }
    إذا (ر < ٤٨) { ارجع صحيح }
    إذا (ر <= ٥٧) { ارجع خطأ }
    إذا (ر < ٦٥) { ارجع صحيح }
    إذا (ر <= ٩٠) { ارجع خطأ }
    إذا (ر < ٩٧) { ارجع صحيح }
    إذا (ر <= ١٢٢) { ارجع خطأ }
    إذا (ر < ١٢٨) { ارجع صحيح }
    إذا (ر == ١٥٤٨ أو ر == ١٥٦٣ أو ر == ١٥٦٧ أو ر == ١٥٤٢ أو ر == ١٥٤٣ أو ر == ١٥٤٧ أو ر == ١٧٤٨) { ارجع صحيح }
    إذا (ر >= ١٢٨ و ر <= ١٩١) { ارجع صحيح }
    إذا ((ر >= ٨٢١٣ و ر <= ٨٣٠٣) أو (ر >= ١٢٢٨٩ و ر <= ١٢٣٥١) أو (ر >= ٦٥٢٨١ و ر <= ٦٥٢٩٥)) { ارجع صحيح }
    ارجع خطأ
}

# ---------- UTF-8 ----------
دالة _بايتات(ر) {
    إذا (ر < ١٢٨) { ارجع [ر] }
    إذا (ر < ٢٠٤٨) { ارجع [١٩٢ | (ر >> ٦)، ١٢٨ | (ر & ٦٣)] }
    إذا (ر < ٦٥٥٣٦) { ارجع [٢٢٤ | (ر >> ١٢)، ١٢٨ | ((ر >> ٦) & ٦٣)، ١٢٨ | (ر & ٦٣)] }
    ارجع [٢٤٠ | (ر >> ١٨)، ١٢٨ | ((ر >> ١٢) & ٦٣)، ١٢٨ | ((ر >> ٦) & ٦٣)، ١٢٨ | (ر & ٦٣)]
}

دالة _اسم_بايت(ب) {
    ارجع "<0x" + _هكس[ب >> ٤] + _هكس[ب & ١٥] + ">"
}

متغير _قيمة_بايت = {}
من_أجل (ب في مدى(٢٥٦)) { _قيمة_بايت[_اسم_بايت(ب)] = ب }

# يفكّ قائمة بايتات إلى نص (التسلسل غير الصالح يصير �)
دالة _من_بايتات(ب) {
    متغير خرج = ""
    متغير ي = ٠
    متغير ن = طول(ب)
    طالما (ي < ن) {
        متغير أ = ب[ي]
        متغير عدد = ٠
        متغير رمز_ = -١
        إذا (أ < ١٢٨) { عدد = ١; رمز_ = أ }
        وإلا إذا (أ >= ١٩٢ و أ < ٢٢٤) { عدد = ٢; رمز_ = أ & ٣١ }
        وإلا إذا (أ >= ٢٢٤ و أ < ٢٤٠) { عدد = ٣; رمز_ = أ & ١٥ }
        وإلا إذا (أ >= ٢٤٠ و أ < ٢٤٨) { عدد = ٤; رمز_ = أ & ٧ }
        متغير صالح = رمز_ >= ٠ و ي + عدد <= ن
        إذا (صالح و عدد > ١) {
            من_أجل (ك في مدى(١، عدد)) {
                إذا ((ب[ي + ك] & ١٩٢) != ١٢٨) { صالح = خطأ }
                رمز_ = (رمز_ << ٦) | (ب[ي + ك] & ٦٣)
            }
        }
        إذا (صالح) {
            خرج = خرج + حرف(رمز_)
            ي = ي + عدد
        } وإلا {
            خرج = خرج + "�"
            ي = ي + ١
        }
    }
    ارجع خرج
}

# ---------- التقطيع الأولي ----------
# يقسّم النص إلى قطع: كلمة (يسبقها فراغ واحد فتحمل ▁)، علامات ترقيم، أو حرف فراغ منفرد
دالة _قطّع(نص_) {
    متغير س = استبدل(نص_، _علامة، " ")
    متغير قطع = []
    متغير حالية = ""
    متغير صنف = ٠
    متغير معلّق = خطأ
    متغير ي = ٠
    متغير ن = طول(س)
    طالما (ي < ن) {
        متغير ح = س[ي]
        إذا (رمز(ح) >= ٥٥٢٩٦ و رمز(ح) <= ٥٦٣١٩ و ي + ١ < ن و رمز(س[ي + ١]) >= ٥٦٣٢٠ و رمز(س[ي + ١]) <= ٥٧٣٤٣) {
            ح = اقتطع(س، ي، ي + ٢)
        }
        ي = ي + طول(ح)
        متغير ر = رمز(ح)
        إذا (_فراغ(ر)) {
            إذا (حالية != "") { أضف(قطع، حالية); حالية = ""; صنف = ٠ }
            إذا (ح == " ") {
                إذا (معلّق) { أضف(قطع، _علامة) }
                معلّق = صحيح
            } وإلا {
                إذا (معلّق) { أضف(قطع، _علامة); معلّق = خطأ }
                أضف(قطع، ح)
            }
        } وإلا {
            متغير ص = ١
            إذا (_ترقيم(ر)) { ص = ٢ }
            إذا (حالية != "" و ص != صنف) { أضف(قطع، حالية); حالية = ""; صنف = ٠ }
            إذا (حالية == "") {
                إذا (معلّق) { حالية = _علامة; معلّق = خطأ }
                صنف = ص
            }
            حالية = حالية + ح
        }
    }
    إذا (حالية != "") { أضف(قطع، حالية) }
    إذا (معلّق) { أضف(قطع، _علامة) }
    ارجع قطع
}

# يفكّك قطعة إلى حروفها (الزوج البديل يُحسب حرفًا واحدًا)
دالة _حروف(قطعة) {
    متغير خرج = []
    متغير ي = ٠
    متغير ن = طول(قطعة)
    طالما (ي < ن) {
        متغير ح = قطعة[ي]
        إذا (رمز(ح) >= ٥٥٢٩٦ و رمز(ح) <= ٥٦٣١٩ و ي + ١ < ن و رمز(قطعة[ي + ١]) >= ٥٦٣٢٠ و رمز(قطعة[ي + ١]) <= ٥٧٣٤٣) {
            ح = اقتطع(قطعة، ي، ي + ٢)
        }
        أضف(خرج، ح)
        ي = ي + طول(ح)
    }
    ارجع خرج
}

# ---------- ترتيب حتمي بترتيب الشيفرة (رتب() تعتمد على لغة النظام فلا تصلح هنا) ----------
دالة _رتّب_نصوصا(قائمة) {
    متغير خرج = []
    من_أجل (ع في قائمة) {
        متغير موضع = طول(خرج)
        طالما (موضع > ٠ و ع < خرج[موضع - ١]) { موضع = موضع - ١ }
        أدرج(خرج، موضع، ع)
    }
    ارجع خرج
}

# ---------- كومة ثنائية (الأفضل: العدد الأكبر ثم المفتاح الأصغر) ----------
دالة _كومة_جديدة() { ارجع {"أعداد": []، "مفاتيح": []} }
دالة _حجم_الكومة(ك) { ارجع طول(ك["أعداد"]) }
دالة _أفضل_من(ك، ي، ج) {
    إذا (ك["أعداد"][ي] != ك["أعداد"][ج]) { ارجع ك["أعداد"][ي] > ك["أعداد"][ج] }
    ارجع ك["مفاتيح"][ي] < ك["مفاتيح"][ج]
}
دالة _بدّل(ك، ي، ج) {
    متغير ع = ك["أعداد"][ي]
    متغير م = ك["مفاتيح"][ي]
    ك["أعداد"][ي] = ك["أعداد"][ج]
    ك["مفاتيح"][ي] = ك["مفاتيح"][ج]
    ك["أعداد"][ج] = ع
    ك["مفاتيح"][ج] = م
}
دالة _ادفع(ك، عدد_، مفتاح) {
    أضف(ك["أعداد"]، عدد_)
    أضف(ك["مفاتيح"]، مفتاح)
    متغير ي = طول(ك["أعداد"]) - ١
    طالما (ي > ٠) {
        متغير أب = (ي - ١) // ٢
        إذا (_أفضل_من(ك، ي، أب)) { _بدّل(ك، ي، أب); ي = أب } وإلا { توقف }
    }
}
دالة _اسحب(ك) {
    متغير ن = طول(ك["أعداد"])
    متغير خرج = [ك["أعداد"][٠]، ك["مفاتيح"][٠]]
    _بدّل(ك، ٠، ن - ١)
    انزع(ك["أعداد"])
    انزع(ك["مفاتيح"])
    ن = ن - ١
    متغير ي = ٠
    طالما (صحيح) {
        متغير ل = ٢ * ي + ١
        متغير ر = ل + ١
        متغير ف = ي
        إذا (ل < ن و _أفضل_من(ك، ل، ف)) { ف = ل }
        إذا (ر < ن و _أفضل_من(ك، ر، ف)) { ف = ر }
        إذا (ف == ي) { توقف }
        _بدّل(ك، ي، ف)
        ي = ف
    }
    ارجع خرج
}

# ---------- التدريب ----------
دالة _ابنِ_فهرس(رموز) {
    متغير ف = {}
    من_أجل (ي في مدى(طول(رموز))) { ف[رموز[ي]] = ي }
    ارجع ف
}

صدّر دالة درّب(نصوص، حجم_المفردات) {
    إذا (نوع(نصوص) != "قائمة") { أطلق_خطأ("المجزِّئ: التدريب يأخذ قائمة نصوص") }
    إذا (نوع(حجم_المفردات) != "رقم") { أطلق_خطأ("المجزِّئ: حجم المفردات رقم") }
    # الكلمات وتكرارها بترتيب أول ظهور
    متغير ترتيب = []
    متغير تكرار = {}
    من_أجل (ن_ في نصوص) {
        إذا (نوع(ن_) != "نص") { أطلق_خطأ("المجزِّئ: كل عنصر في مدوّنة التدريب يجب أن يكون نصًا") }
        من_أجل (ق في _قطّع(ن_)) {
            إذا (يحوي(تكرار، ق)) { تكرار[ق] = تكرار[ق] + ١ } وإلا { تكرار[ق] = ١; أضف(ترتيب، ق) }
        }
    }
    # الحروف المرئية
    متغير حروف_مرئية = {}
    حروف_مرئية[_علامة] = صحيح
    من_أجل (ق في ترتيب) {
        من_أجل (ح في _حروف(ق)) { حروف_مرئية[ح] = صحيح }
    }
    متغير حروف = _رتّب_نصوصا(مفاتيح(حروف_مرئية))
    متغير رموز = []
    من_أجل (خ في _خاصة) { أضف(رموز، خ) }
    من_أجل (ب في مدى(٢٥٦)) { أضف(رموز، _اسم_بايت(ب)) }
    من_أجل (ح في حروف) { أضف(رموز، ح) }
    # تمثيل كل كلمة قائمةَ رموز
    متغير كلمات = []
    من_أجل (ق في ترتيب) { أضف(كلمات، {"رموز": _حروف(ق)، "عدد": تكرار[ق]}) }
    متغير دمجات = []
    # عدّاد الأزواج، وفهرس يدلّ كل زوج على الكلمات التي تحويه، وكومة كسولة لأعلى زوج تكرارًا
    متغير أزواج = {}
    متغير فهرس_الأزواج = {}
    متغير كومة = _كومة_جديدة()
    من_أجل (ك_ي في مدى(طول(كلمات))) {
        متغير ر = كلمات[ك_ي]["رموز"]
        من_أجل (ي في مدى(طول(ر) - ١)) {
            متغير مفتاح = _مفتاح(ر[ي]، ر[ي + ١])
            إذا (يحوي(أزواج، مفتاح)) { أزواج[مفتاح] = أزواج[مفتاح] + كلمات[ك_ي]["عدد"] } وإلا { أزواج[مفتاح] = كلمات[ك_ي]["عدد"]; فهرس_الأزواج[مفتاح] = {} }
            فهرس_الأزواج[مفتاح][ك_ي] = صحيح
        }
    }
    من_أجل (مفتاح في مفاتيح(أزواج)) { _ادفع(كومة، أزواج[مفتاح]، مفتاح) }
    طالما (طول(رموز) < حجم_المفردات) {
        متغير أفضل = لاشيء
        متغير أفضل_عدد = ٠
        طالما (_حجم_الكومة(كومة) > ٠) {
            متغير أعلى = _اسحب(كومة)
            متغير فعلي = ٠
            إذا (يحوي(أزواج، أعلى[١])) { فعلي = أزواج[أعلى[١]] }
            إذا (فعلي == أعلى[٠] و فعلي > ٠) {
                أفضل = أعلى[١]
                أفضل_عدد = فعلي
                توقف
            }
            إذا (فعلي > ٠) { _ادفع(كومة، فعلي، أعلى[١]) }
        }
        إذا (أفضل == لاشيء أو أفضل_عدد < ٢) { توقف }
        متغير جزآن = _فك_المفتاح(أفضل)
        متغير أ = جزآن[٠]
        متغير ب = جزآن[١]
        متغير مدموج = أ + ب
        أضف(دمجات، [أ، ب])
        أضف(رموز، مدموج)
        متغير متأثرة = مفاتيح(فهرس_الأزواج[أفضل])
        من_أجل (ك_ي في متأثرة) {
            متغير ك = كلمات[عدد(ك_ي)]
            متغير ر = ك["رموز"]
            متغير يحويه = خطأ
            من_أجل (ي في مدى(طول(ر) - ١)) { إذا (ر[ي] == أ و ر[ي + ١] == ب) { يحويه = صحيح } }
            إذا (يحويه) {
                من_أجل (ي في مدى(طول(ر) - ١)) {
                    متغير مف = _مفتاح(ر[ي]، ر[ي + ١])
                    أزواج[مف] = أزواج[مف] - ك["عدد"]
                }
                متغير جديد = []
                متغير ي = ٠
                طالما (ي < طول(ر)) {
                    إذا (ي < طول(ر) - ١ و ر[ي] == أ و ر[ي + ١] == ب) {
                        أضف(جديد، مدموج)
                        ي = ي + ٢
                    } وإلا {
                        أضف(جديد، ر[ي])
                        ي = ي + ١
                    }
                }
                ك["رموز"] = جديد
                من_أجل (ي في مدى(طول(جديد) - ١)) {
                    متغير مف = _مفتاح(جديد[ي]، جديد[ي + ١])
                    إذا (يحوي(أزواج، مف)) { أزواج[مف] = أزواج[مف] + ك["عدد"] } وإلا { أزواج[مف] = ك["عدد"]; فهرس_الأزواج[مف] = {} }
                    فهرس_الأزواج[مف][عدد(ك_ي)] = صحيح
                    _ادفع(كومة، أزواج[مف]، مف)
                }
            }
        }
        احذف(أزواج، أفضل)
    }
    ارجع {"إصدار": ١، "رموز": رموز، "دمجات": دمجات، "فهرس": _ابنِ_فهرس(رموز)}
}

# ---------- الترميز ----------
دالة _رتب_الدمج(نموذج) {
    متغير ر = {}
    من_أجل (ي في مدى(طول(نموذج["دمجات"]))) {
        ر[_مفتاح(نموذج["دمجات"][ي][٠]، نموذج["دمجات"][ي][١])] = ي
    }
    ارجع ر
}

دالة _رمّز_قطعة(نموذج، رتب، قطعة) {
    متغير رموز = []
    من_أجل (ح في _حروف(قطعة)) {
        إذا (يحوي(نموذج["فهرس"]، ح) و ح != "") {
            أضف(رموز، ح)
        } وإلا {
            متغير ر = رمز(ح)
            من_أجل (ب في _بايتات(ر)) { أضف(رموز، _اسم_بايت(ب)) }
        }
    }
    طالما (طول(رموز) > ١) {
        متغير أفضل = -١
        متغير أفضل_رتبة = لاشيء
        من_أجل (ي في مدى(طول(رموز) - ١)) {
            متغير مفتاح = _مفتاح(رموز[ي]، رموز[ي + ١])
            إذا (يحوي(رتب، مفتاح)) {
                إذا (أفضل_رتبة == لاشيء أو رتب[مفتاح] < أفضل_رتبة) {
                    أفضل = ي
                    أفضل_رتبة = رتب[مفتاح]
                }
            }
        }
        إذا (أفضل < ٠) { توقف }
        متغير جديد = []
        من_أجل (ي في مدى(أفضل)) { أضف(جديد، رموز[ي]) }
        أضف(جديد، رموز[أفضل] + رموز[أفضل + ١])
        من_أجل (ي في مدى(أفضل + ٢، طول(رموز))) { أضف(جديد، رموز[ي]) }
        رموز = جديد
    }
    ارجع رموز
}

دالة _تحقق_نموذج(نموذج) {
    إذا (نوع(نموذج) != "خريطة" أو ليس يحوي(نموذج، "رموز") أو ليس يحوي(نموذج، "دمجات") أو ليس يحوي(نموذج، "فهرس")) {
        أطلق_خطأ("المجزِّئ: النموذج غير صالح؛ أنشئه بالدالة درّب أو حمّله من ملف حفظه")
    }
}

# النص ← قائمة رموز نصية
صدّر دالة رموز(نموذج، نص_) {
    _تحقق_نموذج(نموذج)
    إذا (نوع(نص_) != "نص") { أطلق_خطأ("المجزِّئ: المدخل يجب أن يكون نصًا لا " + نوع(نص_)) }
    متغير رتب = _رتب_الدمج(نموذج)
    متغير خرج = []
    من_أجل (ق في _قطّع(نص_)) {
        من_أجل (ر في _رمّز_قطعة(نموذج، رتب، ق)) { أضف(خرج، ر) }
    }
    ارجع خرج
}

# النص ← قائمة معرّفات
صدّر دالة رمّز(نموذج، نص_) {
    متغير خرج = []
    من_أجل (ر في رموز(نموذج، نص_)) { أضف(خرج، نموذج["فهرس"][ر]) }
    ارجع خرج
}

# قائمة معرّفات ← النص (الرموز الخاصة <pad> <bos> <eos> تُحذف، و<unk> تصير �)
صدّر دالة فكّ(نموذج، معرفات) {
    _تحقق_نموذج(نموذج)
    متغير خرج = ""
    متغير بايتات = []
    متغير ن = طول(نموذج["رموز"])
    من_أجل (م في معرفات) {
        إذا (نوع(م) != "رقم" أو م < ٠ أو م >= ن) { أطلق_خطأ("المجزِّئ: معرّف غير صالح: " + نص(م)) }
        متغير ر = نموذج["رموز"][م]
        إذا (يحوي(_قيمة_بايت، ر)) {
            أضف(بايتات، _قيمة_بايت[ر])
        } وإلا {
            إذا (طول(بايتات) > ٠) { خرج = خرج + _من_بايتات(بايتات); بايتات = [] }
            إذا (ر == "<unk>") { خرج = خرج + "�" }
            وإلا إذا (ر != "<pad>" و ر != "<bos>" و ر != "<eos>") { خرج = خرج + استبدل(ر، _علامة، " ") }
        }
    }
    إذا (طول(بايتات) > ٠) { خرج = خرج + _من_بايتات(بايتات) }
    ارجع خرج
}

صدّر دالة حجم(نموذج) {
    _تحقق_نموذج(نموذج)
    ارجع طول(نموذج["رموز"])
}

# معرّف رمز خاص: "<pad>" "<unk>" "<bos>" "<eos>"
صدّر دالة معرّف_خاص(نموذج، اسم) {
    _تحقق_نموذج(نموذج)
    إذا (ليس يحوي(_خاصة، اسم)) { أطلق_خطأ("المجزِّئ: الرمز الخاص «" + نص(اسم) + "» غير معروف. المعروف: " + اربط(_خاصة، "، ")) }
    ارجع نموذج["فهرس"][اسم]
}

# مقياس الخصوبة: متوسط عدد الرموز للكلمة الواحدة (أقل أفضل) — يعيد الرموز وكلمات النص الفاصلة بفراغ
صدّر دالة خصوبة(نموذج، نصوص) {
    متغير عدد_الرموز = ٠
    متغير عدد_الكلمات = ٠
    من_أجل (ن_ في نصوص) {
        عدد_الرموز = عدد_الرموز + طول(رمّز(نموذج، ن_))
        من_أجل (ك في افصل(قصّ(ن_)، " ")) { إذا (ك != "") { عدد_الكلمات = عدد_الكلمات + ١ } }
    }
    ارجع {"رموز": عدد_الرموز، "كلمات": عدد_الكلمات}
}

# يسجّل المجزِّئ محركًا في سجل نواة: {نموذج، نص} ← {معرفات، رموز}
صدّر دالة سجّل_المحرك() {
    متغير ع = استورد("ضاد/نواة_عقد")
    ارجع ع.سجّل(ع.محرك(
        "مجزّئ"،
        "يفكّك نصًّا إلى رموز فرعية ومعرّفاتها بنموذج مدرَّب"،
        {"نموذج": "خريطة"، "نص": "نص"}،
        {"معرفات": "قائمة"، "رموز": "قائمة"}،
        دالة(مدخل) { ارجع {"معرفات": رمّز(مدخل["نموذج"]، مدخل["نص"])، "رموز": رموز(مدخل["نموذج"]، مدخل["نص"])} }
    ))
}
