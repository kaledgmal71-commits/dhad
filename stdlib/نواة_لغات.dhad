# ضاد/نواة_لغات — تحديد اللغة المطلوبة وسجلّ وحدات اللغات.
# نواة عامة: لا تعرف لغةً بعينها. اللغة تُحدَّد من الطلب نفسه (اسم صريح، أو وسم كتلة شيفرة، أو شيفرة تُحلَّل بمحلل تلك اللغة)،
# وكل لغة وحدة مستقلة تُسجَّل هنا وتُستدعى حين تُطلب وحدها؛ فإزالة وحدة لا تمسّ بقية نواة.
# لا يقرأ هذا الملف شيئًا من معرفة الموقع ولا دروسه.

متغير _وحدات = []

# وحدة: {اسم: "ضاد", أسماء: [أسماء تدل عليها في الطلب بعد التوحيد], يتعرف: دالة(شيفرة)→منطقي, حاول: دالة(سياق_الطلب)→نتيجة أو لاشيء}
صدّر دالة سجّل_وحدة(ل٣) {
    من_أجل (ك في _وحدات) { إذا (ك["اسم"] == ل٣["اسم"]) { ارجع خطأ } }
    أضف(_وحدات، ل٣)
    ارجع صحيح
}

صدّر دالة صفّر_الوحدات() { _وحدات = [] }

صدّر دالة الوحدات() { ارجع _وحدات }

# توحيد بسيط للمقارنة: أحرف صغيرة لاتينية، وألف بأنواعها
دالة _وحّد(نص_) {
    متغير خرج = ""
    من_أجل (ح في نص_) {
        إذا (ح == "أ" أو ح == "إ" أو ح == "آ") { خرج = خرج + "ا" }
        وإلا { خرج = خرج + ح }
    }
    ارجع خرج
}

دالة _كلمات(نص_) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في نص_) {
        إذا (ح == " " أو ح == حرف(١٠) أو ح == "،" أو ح == "," أو ح == "." أو ح == "؟" أو ح == "?" أو ح == ":" أو ح == "(" أو ح == ")" أو ح == "«" أو ح == "»" أو ح == حرف(٣٤)) {
            إذا (حالي != "") { أضف(خرج، حالي) }
            حالي = ""
        } وإلا { حالي = حالي + ح }
    }
    إذا (حالي != "") { أضف(خرج، حالي) }
    ارجع خرج
}

# الكلمات التي تدل على الوحدة، دون كلمات لاحقة متصلة بها (بضاد، لضاد، وضاد)
دالة _يذكر(كلمات، أسماء) {
    من_أجل (ك في كلمات) {
        من_أجل (س في أسماء) {
            إذا (ك == س) { ارجع صحيح }
            إذا (طول(ك) == طول(س) + ١ و (ك[٠] == "ب" أو ك[٠] == "ل" أو ك[٠] == "و" أو ك[٠] == "ف") و ك[١:طول(ك)] == س) { ارجع صحيح }
        }
    }
    ارجع خطأ
}

# كتلة الشيفرة الأولى في الطلب: {وسم، نص} أو لاشيء
دالة _كتلة(طلب) {
    متغير س = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    إذا (ليس يحوي(طلب، س)) { ارجع لاشيء }
    متغير أجزاء = افصل(طلب، س)
    إذا (طول(أجزاء) < ٣) { ارجع لاشيء }
    متغير سطور = افصل(أجزاء[١]، حرف(١٠))
    متغير وسم = ""
    متغير بقية = أجزاء[١]
    إذا (طول(سطور) > ١ و طول(سطور[٠]) < ١٢ و ليس يحوي(سطور[٠]، "(")) {
        وسم = سطور[٠]
        متغير ب = []
        من_أجل (ي من ١ إلى طول(سطور) - ١) { أضف(ب، سطور[ي]) }
        بقية = اربط(ب، حرف(١٠))
    }
    ارجع {"وسم": _وحّد(وسم)، "نص": بقية}
}

# اللغة المطلوبة: اسم وحدة مسجَّلة أو "" إن لم تُسمَّ ولم تُعرف. آخر: خريطة الجلسة (لغتها النشطة تُرث في المتابعات فقط).
صدّر دالة حدّد(طلب، تابع = خطأ، آخر = {}) {
    متغير كلمات = _كلمات(_وحّد(طلب))
    متغير ك = _كتلة(طلب)
    من_أجل (ل٣ في _وحدات) {
        إذا (_يذكر(كلمات، ل٣["أسماء"])) { ارجع ل٣["اسم"] }
        إذا (ك != لاشيء و ك["وسم"] != "" و يحوي(ل٣["أسماء"]، ك["وسم"])) { ارجع ل٣["اسم"] }
    }
    إذا (ك != لاشيء و ك["وسم"] == "") {
        من_أجل (ل٣ في _وحدات) { إذا (ل٣["يتعرف"](ك["نص"])) { ارجع ل٣["اسم"] } }
    }
    إذا (تابع و يحوي(آخر، "لغة") و آخر["لغة"] != "") { ارجع آخر["لغة"] }
    ارجع ""
}

# الوحدة باسمها أو لاشيء
صدّر دالة وحدة(اسم) {
    من_أجل (ل٣ في _وحدات) { إذا (ل٣["اسم"] == اسم) { ارجع ل٣ } }
    ارجع لاشيء
}

# الوحدة التي تتولى ملفًا بحسب امتداده (خريطة الوحدة: امتدادات) أو لاشيء
صدّر دالة وحدة_الملف(اسم) {
    من_أجل (ل٣ في _وحدات) {
        إذا (يحوي(ل٣، "امتدادات")) {
            من_أجل (ا٢ في ل٣["امتدادات"]) {
                إذا (طول(اسم) >= طول(ا٢) و اسم[طول(اسم) - طول(ا٢):طول(اسم)] == ا٢) { ارجع ل٣ }
            }
        }
    }
    ارجع لاشيء
}
