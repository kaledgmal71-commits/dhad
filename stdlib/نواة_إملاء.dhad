# ضاد/نواة_إملاء — فاحص الرسم الإملائي والتراثي: يقترح ولا يفرض. كل اقتراح له قاعدة وشرح وعلامة غموض؛
# ما كان غامضًا (كلمة قد تكون صحيحة بمعنى آخر، مثل «علي» اسمًا أو «على» حرفًا) يُقترح ولا يُطبَّق إلا بطلب صريح.
# الأصل في «المُحَرِّر» يطبّق جدوله كله آليًا وفيه تصحيحات خاطئة (مثل «ثلث» ← «ثلاث» وهي كلمة صحيحة)؛ هنا لا تُلمَس
# الكلمات الصحيحة، ويحرس ذلك اختبار. لا يعدّل الرسم العثماني للقرآن عمدًا (الربوا، الصلوة في الآيات…) لأنه رسم مقصود.

متغير ن = استورد("ضاد/نصوص")

# [كلمة كما تُكتب بلا تشكيل ← الصواب، القاعدة، الشرح، غامض؟]
متغير _قواعد = [
    ["الصلوة"، "الصلاة"، "رسم تراثي"، "الواو بدل الألف في الصلاة"، خطأ]، ["صلوة"، "صلاة"، "رسم تراثي"، "الواو بدل الألف في الصلاة"، خطأ]،
    ["الزكوة"، "الزكاة"، "رسم تراثي"، "الواو بدل الألف في الزكاة"، خطأ]، ["زكوة"، "زكاة"، "رسم تراثي"، "الواو بدل الألف في الزكاة"، خطأ]،
    ["الحيوة"، "الحياة"، "رسم تراثي"، "الواو بدل الألف في الحياة"، خطأ]، ["حيوة"، "حياة"، "رسم تراثي"، "الواو بدل الألف في الحياة"، خطأ]،
    ["ابرهيم"، "إبراهيم"، "رسم تراثي"، "حذف الألف الوسطى وهمزة القطع"، خطأ]، ["اسمعيل"، "إسماعيل"، "رسم تراثي"، "حذف الألف الوسطى وهمزة القطع"، خطأ]،
    ["اسحق"، "إسحاق"، "رسم تراثي"، "حذف الألف الوسطى وهمزة القطع"، خطأ]، ["سليمن"، "سليمان"، "رسم تراثي"، "حذف الألف الوسطى"، خطأ]،
    ["عثمن"، "عثمان"، "رسم تراثي"، "حذف الألف الوسطى"، خطأ]، ["ملئكة"، "ملائكة"، "رسم تراثي"، "الهمزة على نبرة مع الألف"، خطأ]،
    ["ثلثة"، "ثلاثة"، "رسم تراثي"، "حذف ألف العدد"، خطأ]، ["ثلثمائة"، "ثلاثمائة"، "رسم تراثي"، "حذف ألف العدد"، خطأ]،
    ["لاكن"، "لكن"، "رسم تراثي"، "زيادة ألف في لكن"، خطأ]، ["هاذا"، "هذا"، "رسم تراثي"، "ألف زائدة في اسم الإشارة"، خطأ]،
    ["هاذه"، "هذه"، "رسم تراثي"، "ألف زائدة في اسم الإشارة"، خطأ]، ["ذالك"، "ذلك"، "رسم تراثي"، "ألف زائدة في ذلك"، خطأ]،
    ["اذا"، "إذا"، "همزة"، "همزة قطع مكسورة في إذا"، خطأ]، ["انسان"، "إنسان"، "همزة"، "مصدر على إفعال: همزة قطع"، خطأ]،
    ["ايمان"، "إيمان"، "همزة"، "مصدر على إفعال: همزة قطع"، خطأ]، ["اسلام"، "إسلام"، "همزة"، "مصدر على إفعال: همزة قطع"، خطأ]،
    ["احسان"، "إحسان"، "همزة"، "مصدر على إفعال: همزة قطع"، خطأ]، ["اجماع"، "إجماع"، "همزة"، "مصدر على إفعال: همزة قطع"، خطأ]،
    ["اسناد"، "إسناد"، "همزة"، "مصدر على إفعال: همزة قطع"، خطأ]، ["اخراج"، "إخراج"، "همزة"، "مصدر على إفعال: همزة قطع"، خطأ]،
    ["شئ"، "شيء"، "همزة"، "الهمزة المتطرفة بعد ياء ساكنة تُكتب على السطر"، خطأ]، ["مسئلة"، "مسألة"، "همزة"، "الهمزة المفتوحة بعد ساكن على ألف"، خطأ]،
    ["حتي"، "حتى"، "ألف مقصورة"، "حتى بالألف المقصورة"، خطأ]، ["متي"، "متى"، "ألف مقصورة"، "متى بالألف المقصورة"، خطأ]،
    ["موسي"، "موسى"، "ألف مقصورة"، "اسم مقصور"، خطأ]، ["عيسي"، "عيسى"، "ألف مقصورة"، "اسم مقصور"، خطأ]،
    ["يحيي"، "يحيى"، "ألف مقصورة"، "اسم مقصور"، خطأ]، ["مصطفي"، "مصطفى"، "ألف مقصورة"، "اسم مقصور"، خطأ]،
    ["مستشفي"، "مستشفى"، "ألف مقصورة"، "اسم مقصور"، خطأ]، ["فتوي"، "فتوى"، "ألف مقصورة"، "اسم مقصور"، خطأ]، ["دعوي"، "دعوى"، "ألف مقصورة"، "اسم مقصور"، خطأ]،
    # غامضة: تُقترح ولا تُطبَّق تلقائيًا
    ["الي"، "إلى"، "ألف مقصورة"، "قد تكون «إلى»، وقد تكون كلمة أخرى"، صحيح]، ["علي"، "على"، "ألف مقصورة"، "قد تكون «على» وقد تكون اسمًا «عليّ»"، صحيح]، ["لدي"، "لدى"، "ألف مقصورة"، "قد تكون «لدى» وقد تكون «لديَّ»"، صحيح]، ["بلي"، "بلى"، "ألف مقصورة"، "قد تكون «بلى» وقد تكون «بَلِيَ»"، صحيح]، ["معني"، "معنى"، "ألف مقصورة"، "قد تكون «معنى» وقد تكون «معنيّ»"، صحيح]، ["مبني"، "مبنى"، "ألف مقصورة"، "قد تكون «مبنى» وقد تكون «مبنيّ»"، صحيح]، ["امام"، "إمام"، "همزة"، "قد تكون «إمام» وقد تكون «أمام»"، صحيح]، ["اما"، "أما"، "همزة"، "قد تكون «أما» أو «إما»"، صحيح]، ["الا"، "إلا"، "همزة"، "قد تكون «إلا» أو «ألا»"، صحيح]
]

متغير _فهرس = {}
من_أجل (ق في _قواعد) { _فهرس[ق[٠]] = ق }

دالة _حرف_كلمة(ح) { ارجع ن.هل_حرف_عربي(ح) أو ن.هل_تشكيل(ح) }

# اقتراحات الرسم: قائمة {"موضع"، "طول"، "أصل"، "اقتراح"، "قاعدة"، "شرح"، "غامض"}؛ الموضع ببداية الكلمة في النص (من ٠)
صدّر دالة اقترح(نص) {
    متغير نتيجة = []
    متغير ي = ٠
    متغير ع = طول(نص)
    طالما (ي < ع) {
        إذا (_حرف_كلمة(نص[ي])) {
            متغير بداية = ي
            طالما (ي < ع و _حرف_كلمة(نص[ي])) { ي = ي + ١ }
            متغير كلمة = نص[بداية:ي]
            متغير صافية = ن.أزل_التطويل(ن.أزل_التشكيل(كلمة))
            إذا (صافية في _فهرس) {
                متغير ق = _فهرس[صافية]
                أضف(نتيجة، {"موضع": بداية، "طول": ي - بداية، "أصل": كلمة، "اقتراح": ق[١]، "قاعدة": ق[٢]، "شرح": ق[٣]، "غامض": ق[٤]})
            } وإلا إذا (طول(صافية) > ٣ و (صافية[٠:١] == "و" أو صافية[٠:١] == "ف")) {
                # حرف عطف متصل: يُجرَّد ويُطبَّق على ما بعده إن كانت القاعدة غير غامضة
                متغير بقية = صافية[١:طول(صافية)]
                إذا (بقية في _فهرس) {
                    متغير ق = _فهرس[بقية]
                    إذا (ليس ق[٤]) {
                        متغير فاصل = ١
                        طالما (فاصل < طول(كلمة) و ن.هل_تشكيل(كلمة[فاصل])) { فاصل = فاصل + ١ }
                        أضف(نتيجة، {"موضع": بداية + فاصل، "طول": طول(كلمة) - فاصل، "أصل": كلمة[فاصل:طول(كلمة)]، "اقتراح": ق[١]، "قاعدة": ق[٢]، "شرح": ق[٣] + " (بعد حرف عطف)"، "غامض": خطأ})
                    }
                }
            }
        } وإلا {
            ي = ي + ١
        }
    }
    ارجع نتيجة
}

# تطبيق الاقتراحات: غير الغامضة فقط، إلا إن كان «الكل» صحيحًا. الكلمة المستبدَلة تفقد تشكيلها.
صدّر دالة طبّق(نص، اقتراحات، الكل) {
    متغير خرج = ""
    متغير مؤشر = ٠
    من_أجل (ق في اقتراحات) {
        إذا (الكل == صحيح أو ليس ق["غامض"]) {
            خرج = خرج + نص[مؤشر:ق["موضع"]] + ق["اقتراح"]
            مؤشر = ق["موضع"] + ق["طول"]
        }
    }
    ارجع خرج + نص[مؤشر:طول(نص)]
}

صدّر دالة صحّح(نص) { ارجع طبّق(نص، اقترح(نص)، خطأ) }
