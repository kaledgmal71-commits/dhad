# ضاد/نواة_شرح — شارح شيفرة ضاد: يقرأ شجرة الصياغة الحقيقية التي يبنيها محلل ضاد (نواة_شجرة) ويشرح كل جملة بالعربية،
# ثم يشغّل الشيفرة في الصندوق المعزول ليُري الناتج. لا استرجاع ولا مطابقة كلمات: الشرح مشتق من بنية الشيفرة نفسها.
# الحد: يشرح ما تعرّفه الشجرة (متغيرات، شروط، حلقات، دوال، استدعاءات)؛ لا يعلّل «لماذا» اختار كاتب الشيفرة طريقته.

متغير ن = استورد("ضاد/نصوص")
متغير ع = استورد("ضاد/نواة_عقد")

متغير _عمليات = {
    "PLUS": "+"، "MINUS": "-"، "STAR": "×"، "SLASH": "÷"، "PERCENT": "باقي قسمة"، "POW": "أُسّ"، "FLOORDIV": "قسمة صحيحة على"،
    "EQ": "يساوي"، "NEQ": "لا يساوي"، "LT": "أصغر من"، "GT": "أكبر من"، "LTE": "أصغر من أو يساوي"، "GTE": "أكبر من أو يساوي"،
    "و": "و"، "أو": "أو"
}

دالة _اسم_عملية(ر) {
    إذا (يحوي(_عمليات، ر)) { ارجع _عمليات[ر] }
    ارجع ر
}

# وصف موجز لتعبير
دالة _ع(ش) {
    إذا (ش == لاشيء) { ارجع "لاشيء" }
    متغير ك = ش["kind"]
    إذا (ك == "Number") { ارجع نص(ش["value"]) }
    إذا (ك == "String") { ارجع "«" + ش["value"] + "»" }
    إذا (ك == "Boolean") { إذا (ش["value"]) { ارجع "صحيح" } ارجع "خطأ" }
    إذا (ك == "Null") { ارجع "لاشيء" }
    إذا (ك == "Identifier") { ارجع "«" + ش["name"] + "»" }
    إذا (ك == "BinOp") {
        إذا (ش["op"] == "PERCENT") { ارجع "باقي قسمة " + _ع(ش["left"]) + " على " + _ع(ش["right"]) }
        إذا (ش["op"] == "FLOORDIV") { ارجع "ناتج قسمة " + _ع(ش["left"]) + " على " + _ع(ش["right"]) + " (صحيحًا)" }
        ارجع _ع(ش["left"]) + " " + _اسم_عملية(ش["op"]) + " " + _ع(ش["right"])
    }
    إذا (ك == "UnaryOp") { ارجع ش["op"] + " " + _ع(ش["expr"]) }
    إذا (ك == "Call") {
        متغير وسائط = []
        من_أجل (ا٢ في ش["args"]) { أضف(وسائط، _ع(ا٢)) }
        ارجع "نتيجة استدعاء " + _ع(ش["callee"]) + _وسائط_نص(وسائط)
    }
    إذا (ك == "Index") { ارجع "عنصر " + _ع(ش["obj"]) + " عند " + _ع(ش["index"]) }
    إذا (ك == "ListLiteral") {
        متغير أج = []
        من_أجل (ه في ش["elements"]) { أضف(أج، _ع(ه)) }
        إذا (طول(أج) == ٠) { ارجع "قائمة فارغة" }
        ارجع "قائمة (" + اربط(أج، "، ") + ")"
    }
    إذا (ك == "MapLiteral") { ارجع "خريطة فيها " + نص(طول(ش["entries"])) + " مدخلًا" }
    إذا (ك == "FuncExpr") { ارجع "دالة بلا اسم" }
    إذا (ك == "Assign") { ارجع "وضع " + _ع(ش["expr"]) + " في " + _ع(ش["target"]) }
    ارجع "تعبير"
}

دالة _وسائط_نص(وسائط) {
    إذا (طول(وسائط) == ٠) { ارجع " بلا وسائط" }
    ارجع " بالوسائط: " + اربط(وسائط، "، ")
}

# شرح جملة واحدة (دون جسمها): نص
دالة _شرح_جملة(ج) {
    متغير ك = ج["kind"]
    إذا (ك == "VarDecl") { ارجع "يعرّف متغيرًا اسمه «" + ج["name"] + "» ويضع فيه: " + _ع(ج["expr"]) + "." }
    إذا (ك == "FuncDecl") {
        متغير م = ج["params"]
        إذا (طول(م) == ٠) { ارجع "يعرّف دالة اسمها «" + ج["name"] + "» بلا معاملات؛ لا تعمل إلا حين تُستدعى." }
        ارجع "يعرّف دالة اسمها «" + ج["name"] + "» تأخذ: " + اربط(م، "، ") + "؛ لا تعمل إلا حين تُستدعى."
    }
    إذا (ك == "Return") { ارجع "يُرجع " + _ع(ج["expr"]) + " إلى مستدعي الدالة وينهي عملها." }
    إذا (ك == "If") { ارجع "إن تحقق الشرط (" + _ع(ج["cond"]) + ") نُفّذت الكتلة التالية." }
    إذا (ك == "While") { ارجع "يكرر الكتلة التالية ما دام (" + _ع(ج["cond"]) + ") متحققًا." }
    إذا (ك == "For") { ارجع "يكرر الكتلة والمتغير «" + ج["varName"] + "» يأخذ الأعداد من " + _ع(ج["start"]) + " إلى " + _ع(ج["end"]) + " بالتتابع (والحد الأخير داخل)." }
    إذا (ك == "ForIn") { ارجع "يمرّ على كل عنصر في " + _ع(ج["iter"]) + " ويسمّيه «" + ج["varName"] + "» في كل دورة." }
    إذا (ك == "Break") { ارجع "يقطع الحلقة الحالية ويخرج منها." }
    إذا (ك == "Continue") { ارجع "يتخطى بقية الدورة الحالية وينتقل إلى التي بعدها." }
    إذا (ك == "ExprStmt") {
        متغير ب = ج["expr"]
        إذا (ب["kind"] == "Assign") { ارجع "يضع في " + _ع(ب["target"]) + " القيمة: " + _ع(ب["expr"]) + "." }
        إذا (ب["kind"] == "Call" و ب["callee"]["kind"] == "Identifier" و ب["callee"]["name"] == "اطبع") {
            متغير أج = []
            من_أجل (ا٢ في ب["args"]) { أضف(أج، _ع(ا٢)) }
            ارجع "يطبع: " + اربط(أج، "، ") + "."
        }
        إذا (ب["kind"] == "Call") {
            متغير أج = []
            من_أجل (ا٢ في ب["args"]) { أضف(أج، _ع(ا٢)) }
            إذا (طول(أج) == ٠) { ارجع "يستدعي " + _ع(ب["callee"]) + " ويتجاهل نتيجتها." }
            ارجع "يستدعي " + _ع(ب["callee"]) + " بالوسائط: " + اربط(أج، "، ") + "."
        }
        ارجع "ينفّذ تعبيرًا: " + _ع(ب) + "."
    }
    ارجع "جملة من نوع " + ك + "."
}

# يجمع أسطر الشرح بالتداخل: [{سطر، عمق، شرح}]
دالة _اجمع(جمل، عمق، خرج) {
    من_أجل (ج في جمل) {
        أضف(خرج، {"سطر": _سطر_ج(ج)، "عمق": عمق، "شرح": _شرح_جملة(ج)})
        متغير ك = ج["kind"]
        إذا (ك == "FuncDecl" أو ك == "While" أو ك == "For" أو ك == "ForIn") { _اجمع(ج["body"]["statements"]، عمق + ١، خرج) }
        إذا (ك == "If") {
            _اجمع(ج["thenBlock"]["statements"]، عمق + ١، خرج)
            إذا (ج["elseBlock"] != لاشيء) {
                أضف(خرج، {"سطر": _سطر_ج(ج)، "عمق": عمق، "شرح": "وإلا (إن لم يتحقق الشرط) نُفّذت الكتلة التالية:"})
                متغير ب = ج["elseBlock"]
                إذا (ب["kind"] == "Block") { _اجمع(ب["statements"]، عمق + ١، خرج) } وإلا { _اجمع([ب]، عمق + ١، خرج) }
            }
        }
    }
    ارجع خرج
}

دالة _سطر_ج(ج) {
    إذا (يحوي(ج، "line")) { ارجع ج["line"] }
    ارجع ٠
}

# النتيجة: {صحيح، خطأ، أسطر: [{سطر، مصدر، عمق، شرح}]، ناتج: [نص]}
صدّر دالة اشرح(شيفرة، شغّل_ = صحيح) {
    متغير ش = نواة_شجرة(شيفرة)
    إذا (يحوي(ش، "خطأ")) { ارجع {"صحيح": خطأ، "خطأ": ش["خطأ"]، "أسطر": []، "ناتج": []} }
    متغير مصدر = افصل(شيفرة، حرف(١٠))
    متغير أسطر = _اجمع(ش["statements"]، ٠، [])
    من_أجل (س في أسطر) {
        س["مصدر"] = ""
        إذا (س["سطر"] >= ١ و س["سطر"] <= طول(مصدر)) { س["مصدر"] = مصدر[س["سطر"] - ١] }
    }
    متغير ناتج = []
    إذا (شغّل_) { ناتج = نفّذ(شيفرة، ٢٠٠٠٠٠، ٢٠٠٠) }
    ارجع {"صحيح": صحيح، "خطأ": ""، "أسطر": أسطر، "ناتج": ناتج}
}

# صياغة نصية للقارئ
صدّر دالة صغ(ن٢) {
    إذا (ليس ن٢["صحيح"]) { ارجع "الشيفرة فيها خطأ صياغة قبل أن أشرحها:" + حرف(١٠) + ن٢["خطأ"] }
    متغير خرج = []
    متغير آخر_سطر = -١
    من_أجل (س في ن٢["أسطر"]) {
        متغير بادئة = ""
        من_أجل (ي في مدى(س["عمق"])) { بادئة = بادئة + "  " }
        # سطر المصدر يُعرض مرة واحدة حين تتفرع جملته الواحدة إلى عدة شروح
        إذا (س["مصدر"] != "" و س["سطر"] != آخر_سطر) { أضف(خرج، بادئة + "‹" + ن.قصّ(س["مصدر"]) + "›") }
        آخر_سطر = س["سطر"]
        أضف(خرج، بادئة + "— " + س["شرح"])
    }
    إذا (طول(ن٢["ناتج"]) > ٠) {
        أضف(خرج، "")
        أضف(خرج، "الناتج عند التشغيل:")
        من_أجل (ل في ن٢["ناتج"]) { أضف(خرج، "  " + ل) }
    }
    ارجع اربط(خرج، حرف(١٠))
}

صدّر دالة سجّل_المحرك() {
    إذا (ليس يحوي(ع.المحركات()، "شرح_شيفرة")) {
        ع.سجّل(ع.محرك("شرح_شيفرة"، "يشرح شيفرة ضاد جملةً جملة من شجرة الصياغة ويشغّلها ليُري الناتج"، {"شيفرة": "نص"}، {"شرح": "خريطة"، "نص": "نص"}،
            دالة(م) {
                متغير ن٢ = اشرح(م["شيفرة"])
                ارجع {"شرح": ن٢، "نص": صغ(ن٢)}
            }))
    }
}
