# ضاد/نواة_تلخيص — تلخيص استخراجي: يختار من نصوص المصادر الجمل الأقرب إلى السؤال، دون تكرار، ويبقي ترتيبها ومصدر كل جملة.
# لا يُنشئ كلامًا من عنده: كل جملة في الخلاصة نقلٌ حرفي من مصدرها، فلا اختلاق ولا نسبة خاطئة.
# عامة: لا تعرف لغة ولا موضوعًا.

متغير ع = استورد("ضاد/نواة_عقد")
متغير ن = استورد("ضاد/نصوص")
متغير ف٠ = استورد("ضاد/نواة_ملف")

# جمل النص: عند . ؟ ! ؛ ? وفواصل الأسطر؛ يبقى ما طوله بين ٢٥ و٣٦٠ حرفًا (دون العناوين القصيرة والفقرات الضخمة)
دالة _جمل(س) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في س) {
        إذا (ح == "." أو ح == "؟" أو ح == "!" أو ح == "؛" أو ح == "?" أو ح == حرف(١٠)) {
            متغير ق = ن.قصّ(حالي)
            إذا (طول(ق) >= ٢٥ و طول(ق) <= ٣٦٠) { أضف(خرج، ق) }
            حالي = ""
        } وإلا { حالي = حالي + ح }
    }
    متغير ق٢ = ن.قصّ(حالي)
    إذا (طول(ق٢) >= ٢٥ و طول(ق٢) <= ٣٦٠) { أضف(خرج، ق٢) }
    ارجع خرج
}

دالة _مشترك(أ، ب) {
    متغير ك = ٠
    من_أجل (ج في أ) { إذا (يحوي(ب، ج)) { ك = ك + ١ } }
    ارجع ك
}

# مصادر: [{مصدر: اسم، نص}]؛ استعلام: السؤال (فارغ = أول ما في المصادر)؛ حد: أقصى عدد حروف الخلاصة
# يعيد {وُجد، نص، جمل: [{نص، مصدر}]، مصادر: [أسماء]}. لا جملة تحوي جذرًا من السؤال = لا خلاصة.
صدّر دالة لخّص(مصادر، استعلام = ""، حد = ٤٠٠) {
    متغير جذور = ف٠.جذوع(استعلام)
    متغير مرشحة = []
    من_أجل (ي في مدى(طول(مصادر))) {
        متغير جمل = _جمل(مصادر[ي]["نص"])
        من_أجل (ج في مدى(طول(جمل))) {
            إذا (طول(مرشحة) < ٨٠) {
                متغير م = ف٠.مطبّع(جمل[ج])
                متغير درجة = ٠
                من_أجل (ر في جذور) { إذا (يحوي(م، ر)) { درجة = درجة + ٣ } }
                إذا (ج == ٠) { درجة = درجة + ١ }
                إذا (طول(جذور) == ٠ أو درجة >= ٣) {
                    أضف(مرشحة، {"نص": جمل[ج]، "مصدر": مصادر[ي]["مصدر"]، "درجة": درجة، "ترتيب": ي * ١٠٠٠ + ج، "جذور": ف٠.جذوع(جمل[ج])، "أُخذت": خطأ})
                }
            }
        }
    }
    متغير مختارة = []
    متغير طول_كلي = ٠
    متغير أمام = صحيح
    طالما (أمام) {
        متغير أفضل = -١
        من_أجل (ي في مدى(طول(مرشحة))) {
            إذا (ليس مرشحة[ي]["أُخذت"]) {
                إذا (أفضل < ٠ أو مرشحة[ي]["درجة"] > مرشحة[أفضل]["درجة"]) { أفضل = ي }
            }
        }
        إذا (أفضل < ٠) { أمام = خطأ }
        وإلا {
            متغير م٢ = مرشحة[أفضل]
            م٢["أُخذت"] = صحيح
            متغير مكررة = خطأ
            من_أجل (ك في مختارة) {
                متغير أصغر = طول(ك["جذور"])
                إذا (طول(م٢["جذور"]) < أصغر) { أصغر = طول(م٢["جذور"]) }
                إذا (أصغر > ٠ و _مشترك(ك["جذور"]، م٢["جذور"]) * ١٠ >= أصغر * ٦) { مكررة = صحيح }
            }
            إذا (ليس مكررة) {
                إذا (طول_كلي + طول(م٢["نص"]) <= حد أو طول(مختارة) == ٠) {
                    أضف(مختارة، م٢)
                    طول_كلي = طول_كلي + طول(م٢["نص"]) + ٢
                } وإلا { أمام = خطأ }
            }
        }
    }
    # ترتيب الخلاصة كترتيب ورودها في المصادر
    متغير مرتبة = []
    طالما (طول(مرتبة) < طول(مختارة)) {
        متغير أول = -١
        من_أجل (ي في مدى(طول(مختارة))) {
            إذا (ليس يحوي(مرتبة، مختارة[ي])) {
                إذا (أول < ٠ أو مختارة[ي]["ترتيب"] < مختارة[أول]["ترتيب"]) { أول = ي }
            }
        }
        أضف(مرتبة، مختارة[أول])
    }
    متغير نصوص = []
    متغير جمل_ = []
    متغير أسماء = []
    من_أجل (ك في مرتبة) {
        أضف(نصوص، ك["نص"] + ".")
        أضف(جمل_، {"نص": ك["نص"]، "مصدر": ك["مصدر"]})
        إذا (ليس يحوي(أسماء، ك["مصدر"])) { أضف(أسماء، ك["مصدر"]) }
    }
    ارجع {"وُجد": طول(مرتبة) > ٠، "نص": اربط(نصوص، " ")، "جمل": جمل_، "مصادر": أسماء}
}

صدّر دالة سجّل_المحرك() {
    إذا (ليس يحوي(ع.المحركات()، "تلخيص")) {
        ع.سجّل(ع.محرك("تلخيص"، "تلخيص استخراجي: جمل حرفية من المصادر الأقرب إلى السؤال بلا تكرار"، {"مصادر": "قائمة"، "استعلام": "نص"}، {"وُجد": "قيمة منطقية"، "نص": "نص"، "جمل": "قائمة"، "مصادر": "قائمة"}،
            دالة(م) { ارجع لخّص(م["مصادر"]، م["استعلام"]) }))
    }
}
