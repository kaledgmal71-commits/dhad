# ضاد/نواة_ملف — تحليل ملف مرفق كاملًا: القياسات والبنية وأبرز المصطلحات وأدل الجمل.
# كله قياس فعلي على النص المعروض؛ لا يدّعي ما لم يقسه. النصوص الأطول من الحد تُقاس بمطلعها ويُذكر ذلك.

متغير ن = استورد("ضاد/نصوص")

متغير _حد_التحليل = ٢٠٠٠٠٠

# كلمات شائعة لا تدل على الموضوع (بالصورة المطبَّعة)
متغير _توقف = {}
من_أجل (ك في ["في"، "من"، "على"، "الي"، "عن"، "ان"، "انه"، "انها"، "التي"، "الذي"، "الذين"، "هذا"، "هذه"، "ذلك"، "تلك"، "هو"، "هي"، "هم"، "كان"، "كانت"، "يكون"، "تكون"، "لا"، "لم"، "لن"، "قد"، "كل"، "او"، "ثم"، "بعد"، "قبل"، "بين"، "حتي"، "اذا"، "مع"، "عند"، "كما"، "لكن"، "بل"، "ايضا"، "وهو"، "وهي"، "ما"، "ماذا"، "اي"، "هل"، "كيف"، "لماذا"، "متي"، "اين"، "اشرح"، "اذكر"، "وضح"، "قل"، "عرف"، "بيان"، "به"، "بها"، "له"، "لها"، "فيه"، "فيها"، "منه"، "منها"، "عليه"، "عليها"، "هذا"، "ذلك"، "the"، "and"، "of"، "to"، "in"، "is"، "a"، "for"، "that"، "it"، "on"، "with"، "as"، "are"، "be"، "this"، "by"، "or"، "an"]) { _توقف[ك] = ١ }

دالة _مطبّع(س) { ارجع ن.وحّد_التاء_المربوطة(ن.طبّع_للبحث(س)) }

# كلمات النص كما كُتبت (بلا تشكيل ولا تطويل): حروف عربية ولاتينية وأرقام
دالة _كلمات(س) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في ن.أزل_التطويل(ن.أزل_التشكيل(س))) {
        إذا (ن.هل_حرف_عربي(ح) أو ن.هل_حرف_لاتيني(ح) أو ن.هل_رقم(ح)) {
            حالي = حالي + ح
        } وإلا {
            إذا (حالي != "") { أضف(خرج، حالي) }
            حالي = ""
        }
    }
    إذا (حالي != "") { أضف(خرج، حالي) }
    ارجع خرج
}

# عدد الحروف التي تُنزع من أول الكلمة المطبَّعة لتُحصى بجذعها: وال/بال/كال/فال/لل ثم ال ثم و
دالة _نزع(م) {
    إذا (طول(م) > ٥ و (ن.يبدأ_ب(م، "وال") أو ن.يبدأ_ب(م، "بال") أو ن.يبدأ_ب(م، "كال") أو ن.يبدأ_ب(م، "فال"))) { ارجع ٣ }
    إذا (طول(م) > ٤ و ن.يبدأ_ب(م، "ال")) { ارجع ٢ }
    إذا (طول(م) > ٤ و ن.يبدأ_ب(م، "لل")) { ارجع ٢ }
    إذا (طول(م) > ٤ و م[٠] == "و") { ارجع ١ }
    ارجع ٠
}

# الصورة المطبَّعة للنص (للمطابقة)
صدّر دالة مطبّع(س) { ارجع _مطبّع(س) }

# جذوع الكلمات الدالة في طلب (بلا كلمات الاستفهام والوصل الشائعة): ما يلزم أن يوجد في مقطع ليكون جوابًا
صدّر دالة جذوع(طلب) {
    متغير خرج = []
    من_أجل (خام في _كلمات(طلب)) {
        متغير م = _مطبّع(خام)
        متغير ج = اقتطع(م، _نزع(م))
        إذا (طول(ج) >= ٣ و ليس يحوي(_توقف، م) و ليس يحوي(_توقف، ج) و ليس يحوي(خرج، ج)) { أضف(خرج، ج) }
    }
    ارجع خرج
}

# هل يحوي المقطع جذرًا واحدًا على الأقل من جذور الطلب؟ (لا جذور = لا شرط)
صدّر دالة يطابق(نص_المقطع، جذوع_) {
    إذا (طول(جذوع_) == ٠) { ارجع صحيح }
    متغير م = _مطبّع(نص_المقطع)
    من_أجل (ج في جذوع_) { إذا (يحوي(م، ج)) { ارجع صحيح } }
    ارجع خطأ
}

# يقسّم النص إلى جمل عند . ؟ ! ؛ ? وفواصل الأسطر، ويُبقي ما لا يقل عن ٢٠ حرفًا
دالة _جمل(س) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في س) {
        إذا (ح == "." أو ح == "؟" أو ح == "!" أو ح == "؛" أو ح == "?" أو ح == حرف(١٠)) {
            متغير ق = ن.قصّ(حالي)
            إذا (طول(ق) >= ٢٠) { أضف(خرج، ق) }
            حالي = ""
        } وإلا {
            حالي = حالي + ح
        }
    }
    متغير ق٢ = ن.قصّ(حالي)
    إذا (طول(ق٢) >= ٢٠) { أضف(خرج، ق٢) }
    ارجع خرج
}

دالة _يبدأ_بأحدها(س، بدايات) {
    من_أجل (ب في بدايات) { إذا (ن.يبدأ_ب(س، ب)) { ارجع صحيح } }
    ارجع خطأ
}

# عناوين الأبواب والفصول: أسطر قصيرة تبدأ بكلمة بنية معروفة أو علامة عنوان
دالة _عناوين(نص_) {
    متغير خرج = []
    من_أجل (سطر في افصل(نص_، حرف(١٠))) {
        متغير ق = ن.قصّ(سطر)
        إذا (طول(ق) > ٠ و طول(ق) <= ٦٠ و طول(خرج) < ١٥) {
            متغير م = _مطبّع(ق)
            إذا (_يبدأ_بأحدها(م، ["باب "، "فصل "، "كتاب "، "مبحث "، "مقدمه"، "خاتمه"، "الباب "، "الفصل "، "#"])) { أضف(خرج، ق) }
        }
    }
    ارجع خرج
}

دالة _فيه_كود(س) {
    ارجع يحوي(س، "اطبع(") أو يحوي(س، "دالة ") أو يحوي(س، "متغير ") أو يحوي(س، "من_أجل") أو يحوي(س، "function ") أو يحوي(س، "def ")
}

# يحلّل نص ملف ويعيد تقريرًا من قياسات فعلية
صدّر دالة حلّل(اسم، نص_) {
    إذا (نوع(نص_) != "نص") { أطلق_خطأ("تحليل الملف: النص نص") }
    متغير مبتور = خطأ
    متغير عيّنة = نص_
    إذا (طول(نص_) > _حد_التحليل) {
        عيّنة = اقتطع(نص_، ٠، _حد_التحليل)
        مبتور = صحيح
    }
    متغير جمل = _جمل(عيّنة)
    متغير كلمات_الجمل = []
    متغير تكرار = {}
    متغير عرض = {}
    متغير كل = {}
    متغير مجموع = ٠
    متغير عربية = ٠
    متغير لاتينية = ٠
    من_أجل (ج في جمل) {
        متغير خام = _كلمات(ج)
        متغير ك = []
        من_أجل (و_خام في خام) {
            متغير و_ = _مطبّع(و_خام)
            مجموع = مجموع + ١
            كل[و_] = ١
            إذا (ن.هل_حرف_لاتيني(و_[٠])) { لاتينية = لاتينية + ١ } وإلا إذا (ن.هل_حرف_عربي(و_[٠])) { عربية = عربية + ١ }
            متغير نز = _نزع(و_)
            متغير جذع = اقتطع(و_، نز)
            أضف(ك، جذع)
            إذا (طول(جذع) >= ٣ و ليس يحوي(_توقف، و_) و ليس يحوي(_توقف، جذع) و ليس ن.هل_رقم(جذع[٠])) {
                إذا (يحوي(تكرار، جذع)) { تكرار[جذع] = تكرار[جذع] + ١ } وإلا {
                    تكرار[جذع] = ١
                    عرض[جذع] = اقتطع(و_خام، نز)
                }
            }
        }
        أضف(كلمات_الجمل، ك)
    }
    # أبرز المصطلحات: أعلى ١٠ تكرارًا (يُقدَّم الأسبق عند التعادل)
    متغير أبرز = []
    متغير مأخوذ = {}
    من_أجل (ي في مدى(١٠)) {
        متغير أفضل = ""
        متغير عدد_أفضل = ٠
        من_أجل (ك في مفاتيح(تكرار)) {
            إذا (ليس يحوي(مأخوذ، ك) و تكرار[ك] > عدد_أفضل) {
                أفضل = ك
                عدد_أفضل = تكرار[ك]
            }
        }
        إذا (أفضل != "" و عدد_أفضل >= ٢) {
            أضف(أبرز، {"كلمة": عرض[أفضل]، "تكرار": عدد_أفضل})
            مأخوذ[أفضل] = ١
        }
    }
    # أدل الجمل: مجموع تكرار مصطلحاتها مقسومًا على طولها ليتعادل القصير والطويل
    متغير درجات = []
    من_أجل (ي في مدى(طول(جمل))) {
        متغير د = ٠
        من_أجل (و_ في كلمات_الجمل[ي]) { إذا (يحوي(تكرار، و_) و تكرار[و_] >= ٢) { د = د + تكرار[و_] } }
        أضف(درجات، د * ١٠٠ / (طول(كلمات_الجمل[ي]) + ٨))
    }
    متغير مختارة = []
    متغير مستخدم = {}
    من_أجل (ي في مدى(٣)) {
        متغير أفضل_ي = -١
        متغير أفضل_د = ٠
        من_أجل (ك في مدى(طول(جمل))) {
            إذا (ليس يحوي(مستخدم، نص(ك)) و درجات[ك] > أفضل_د) {
                أفضل_ي = ك
                أفضل_د = درجات[ك]
            }
        }
        إذا (أفضل_ي >= ٠) {
            مستخدم[نص(أفضل_ي)] = ١
            أضف(مختارة، أفضل_ي)
        }
    }
    متغير جمل_دالة = []
    من_أجل (ي في مدى(طول(جمل))) {
        إذا (يحوي(مستخدم، نص(ي))) {
            متغير ج = جمل[ي]
            إذا (طول(ج) > ٢٠٠) { ج = اقتطع(ج، ٠، ٢٠٠) + "…" }
            أضف(جمل_دالة، ج)
        }
    }
    متغير لغة = "عربي"
    إذا (لاتينية > عربية) { لغة = "إنجليزي" }
    إذا (عربية > ٠ و لاتينية > ٠ و لاتينية * ٤ > عربية و عربية * ٤ > لاتينية) { لغة = "مختلط" }
    متغير متوسط = ٠
    إذا (طول(جمل) > ٠) { متوسط = أرضية(مجموع / طول(جمل)) }
    متغير تنوع = ٠
    إذا (مجموع > ٠) { تنوع = أرضية(طول(مفاتيح(كل)) * ١٠٠ / مجموع) }
    متغير فقرات = ٠
    من_أجل (ف في افصل(عيّنة، حرف(١٠) + حرف(١٠))) { إذا (ن.قصّ(ف) != "") { فقرات = فقرات + ١ } }
    ارجع {
        "اسم": اسم، "أحرف": طول(نص_)، "كلمات": مجموع، "جمل": طول(جمل)، "فقرات": فقرات،
        "لغة": لغة، "تنوع": تنوع، "متوسط_الجملة": متوسط، "مبتور": مبتور،
        "أبرز": أبرز، "جمل_دالة": جمل_دالة، "عناوين": _عناوين(عيّنة)،
        "فيه_كود": _فيه_كود(عيّنة)
    }
}

# يحوّل التقرير إلى نص مقروء
صدّر دالة صغ(ت) {
    متغير أسطر = ["تحليل الملف «" + ت["اسم"] + "»:"]
    أضف(أسطر، "- الحجم: " + نص(ت["أحرف"]) + " حرفًا، " + نص(ت["كلمات"]) + " كلمة، " + نص(ت["جمل"]) + " جملة، " + نص(ت["فقرات"]) + " فقرة.")
    أضف(أسطر، "- اللغة: " + ت["لغة"] + ". تنوّع المفردات: " + نص(ت["تنوع"]) + "٪. متوسط طول الجملة: " + نص(ت["متوسط_الجملة"]) + " كلمة.")
    إذا (ت["مبتور"]) { أضف(أسطر، "- حُلِّل مطلع الملف (أول " + نص(_حد_التحليل) + " حرف) لطوله.") }
    إذا (طول(ت["أبرز"]) > ٠) {
        متغير أج = []
        من_أجل (ب في ت["أبرز"]) { أضف(أج، ب["كلمة"] + " (" + نص(ب["تكرار"]) + ")") }
        أضف(أسطر، "- أبرز المصطلحات: " + اربط(أج، "، ") + ".")
    }
    إذا (طول(ت["عناوين"]) > ٠) { أضف(أسطر، "- العناوين: " + اربط(ت["عناوين"]، "، ") + ".") }
    إذا (طول(ت["جمل_دالة"]) > ٠) {
        أضف(أسطر، "- أدل الجمل على موضوعه:")
        من_أجل (ج في ت["جمل_دالة"]) { أضف(أسطر، "  • " + ج) }
    }
    ارجع اربط(أسطر، حرف(١٠))
}

# هل الطلب يريد عملية على ملف كامل؟ (تحليل، تلخيص، تقييم، مراجعة، سؤال عن محتواه)
متغير _أفعال = ["حلل"، "تحليل"، "لخص"، "تلخيص"، "ملخص"، "قيم"، "تقييم"، "راجع"، "مراجعه"، "افحص"، "فحص"]
متغير _أسماء = ["ملف"، "ملفي"، "ملفاتي"، "كتابي"، "الملف"، "ملفات"، "الملفات"، "كتاب"، "الكتاب"، "مرفق"، "المرفق"، "مرفقات"، "المرفقات"، "مستند"، "المستند"، "وثيقه"، "الوثيقه"، "النص"]
متغير _عبارات = ["ماذا في"، "ما محتوي"، "عن ماذا"، "عما يتحدث"، "ما موضوع"]

دالة _نص_الكلمات(س) { ارجع " " + اربط(_كلمات(س)، " ") + " " }

صدّر دالة طلب_ملف(طلب، عدد_المرفقات) {
    متغير س = _نص_الكلمات(طلب)
    متغير فعل = خطأ
    متغير اسم_ = خطأ
    من_أجل (ك في _أفعال) { إذا (يحوي(س، " " + ك + " ")) { فعل = صحيح } }
    من_أجل (ك في _أسماء) { إذا (يحوي(س، " " + ك + " ")) { اسم_ = صحيح } }
    من_أجل (ك في _عبارات) { إذا (يحوي(س، " " + ك + " ")) { فعل = صحيح } }
    إذا (يحوي(طلب، حرف(٩٦) + حرف(٩٦) + حرف(٩٦))) { ارجع خطأ }
    ارجع فعل و (اسم_ أو عدد_المرفقات > ٠)
}

# أي الملفات المرفقة يقصد الطلب؟ المسمّى باسمه إن وُجد، وإلا كلها
صدّر دالة اختر_الملفات(طلب، أسماء) {
    متغير س = " " + _مطبّع(طلب) + " "
    متغير مختار = []
    من_أجل (ا في أسماء) {
        متغير م = _مطبّع(ا)
        إذا (طول(م) >= ٣ و يحوي(س، م)) { أضف(مختار، ا) }
    }
    إذا (طول(مختار) > ٠) { ارجع مختار }
    ارجع أسماء
}
