# ضاد/نواة_منفذ — منفذ العزل: يشغّل شيفرة ضاد في آلة فرعية معزولة بحدّ للخطوات وللزمن.
# العزل: لا حفظ ملفات، لا واجهة مساعد، ولا أثر على متغيرات المستدعي. أي خطأ يعود نتيجةً لا استثناءً.
# قيد معروف: الآلة الفرعية تُلحق سطر «خطأ: …» بمخرجاتها عند الفشل، فمن طبع بنفسه سطرًا يبدأ بـ«خطأ: » في آخر مخرجاته عُدّ فاشلًا.

متغير ع = استورد("ضاد/نواة_عقد")
متغير ن = استورد("ضاد/نصوص")

متغير سقف_الشيفرة = ٢٠٠٠٠
متغير بادئة_الخطأ = "خطأ: "

دالة _صنّف(رسالة) {
    إذا (يحوي(رسالة، "استغرق البرنامج وقتًا طويلًا")) { ارجع "حد" }
    إذا (يحوي(رسالة، "لم أفهم") أو يحوي(رسالة، "توقّعت") أو يحوي(رسالة، "نهاية الكود")) { ارجع "صياغة" }
    ارجع "تنفيذ"
}

# يشغّل الشيفرة ويعيد {ناجح، مخرجات، خطأ، نوع_الخطأ}
صدّر دالة شغّل_معزولًا(شيفرة، سقف_الخطوات = ٢٠٠٠٠٠، سقف_الزمن = ٢٠٠٠) {
    إذا (نوع(شيفرة) != "نص") { أطلق_خطأ("المنفذ: الشيفرة نص") }
    إذا (نوع(سقف_الخطوات) != "رقم" أو سقف_الخطوات < ١) { أطلق_خطأ("المنفذ: سقف الخطوات رقم موجب") }
    إذا (نوع(سقف_الزمن) != "رقم" أو سقف_الزمن < ١) { أطلق_خطأ("المنفذ: سقف الزمن رقم موجب (بالمللي ثانية)") }
    إذا (طول(شيفرة) > سقف_الشيفرة) {
        ارجع {"ناجح": خطأ، "مخرجات": []، "خطأ": "الشيفرة أطول من الحد (" + نص(سقف_الشيفرة) + " حرف)"، "نوع_الخطأ": "حد"}
    }
    متغير خرج = نفّذ(شيفرة، سقف_الخطوات، سقف_الزمن)
    متغير ك = طول(خرج)
    إذا (ك > ٠ و ن.يبدأ_ب(خرج[ك - ١]، بادئة_الخطأ)) {
        متغير رسالة = اقتطع(خرج[ك - ١]، طول(بادئة_الخطأ))
        متغير سابقة = []
        من_أجل (ي في مدى(ك - ١)) { أضف(سابقة، خرج[ي]) }
        ارجع {"ناجح": خطأ، "مخرجات": سابقة، "خطأ": رسالة، "نوع_الخطأ": _صنّف(رسالة)}
    }
    ارجع {"ناجح": صحيح، "مخرجات": خرج، "خطأ": ""، "نوع_الخطأ": ""}
}

# يشغّل الشيفرة ويقارن مخرجاتها بقائمة متوقعة سطرًا سطرًا.
# يعيد {نجح، فرق، نتيجة} حيث فرق = أول سطر مختلف (أو نص فارغ).
صدّر دالة اختبر(شيفرة، متوقع، سقف_الخطوات = ٢٠٠٠٠٠) {
    إذا (نوع(متوقع) != "قائمة") { أطلق_خطأ("المنفذ: المتوقع قائمة أسطر") }
    متغير ر = شغّل_معزولًا(شيفرة، سقف_الخطوات)
    إذا (ليس ر["ناجح"]) { ارجع {"نجح": خطأ، "فرق": "فشل التشغيل: " + ر["خطأ"]، "نتيجة": ر} }
    متغير م = ر["مخرجات"]
    إذا (طول(م) != طول(متوقع)) {
        ارجع {"نجح": خطأ، "فرق": "عدد الأسطر " + نص(طول(م)) + " والمتوقع " + نص(طول(متوقع))، "نتيجة": ر}
    }
    من_أجل (ي في مدى(طول(م))) {
        إذا (نص(م[ي]) != نص(متوقع[ي])) {
            ارجع {"نجح": خطأ، "فرق": "السطر " + نص(ي + ١) + ": خرج «" + نص(م[ي]) + "» والمتوقع «" + نص(متوقع[ي]) + "»"، "نتيجة": ر}
        }
    }
    ارجع {"نجح": صحيح، "فرق": ""، "نتيجة": ر}
}

صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "منفذ_معزول"،
        "يشغّل شيفرة ضاد بعزل وحدّ للخطوات والزمن ويعيد المخرجات أو الخطأ مصنَّفًا"،
        {"شيفرة": "نص"، "سقف_الخطوات": "رقم"}،
        {"ناجح": "قيمة منطقية"، "مخرجات": "قائمة"، "خطأ": "نص"، "نوع_الخطأ": "نص"}،
        دالة(مدخل) { ارجع شغّل_معزولًا(مدخل["شيفرة"]، مدخل["سقف_الخطوات"]) }
    ))
}
