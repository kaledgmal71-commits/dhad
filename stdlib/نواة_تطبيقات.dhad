# ضاد/نواة_تطبيقات — اختيار قالب التطبيق الجاهز من وصف المستخدم (قوالب مركَّبة ومتحقَّق منها، لا بناء حر).
# القوالب نفسها ملفات مشروع في الواجهة (nawa.templates.json)؛ هنا اختيارها بالاسم والعنوان والوصف. عامة: لا تعرف لغة ولا موضوعًا.

متغير ن = استورد("ضاد/نصوص")

# [الاسم، العنوان، الوصف، جذوع الغرض]
متغير _قوالب = [
    ["ملخّص_نصوص"، "ملخّص نصوص"، "يلخّص أي نص تلصقه بجمل منه."، ["لخص"، "تلخيص"، "خلاص"]]،
    ["اختبار_ذاتي"، "اختبار ذاتي"، "يبني أسئلة من نص ويصحّحها ويكشف الفخاخ."، ["اختبار"، "اسئل"، "امتحان"]]
]
متغير _كلمات_التطبيق = ["تطبيق"، "اداة"، "اداه"، "صفحة"، "صفحه"، "موقع"]
متغير _يستبعد = ["كود"، "شيفره"، "دالة"، "دالّة"، "بايثون"، "ضاد"، "جافا"، "python"، "javascript"]

صدّر دالة قوالب() {
    متغير خ = []
    من_أجل (ق في _قوالب) { أضف(خ، {"اسم": ق[٠]، "عنوان": ق[١]، "وصف": ق[٢]}) }
    ارجع خ
}

# يعيد {اسم، عنوان، وصف} للقالب المطلوب، أو لاشيء إن لم يكن الطلب طلب تطبيق جاهز
صدّر دالة اختر(طلب) {
    متغير س = ن.طبّع_للبحث(طلب)
    متغير تطبيق = خطأ
    من_أجل (ك في _كلمات_التطبيق) { إذا (يحوي(س، ك)) { تطبيق = صحيح } }
    إذا (ليس تطبيق) { ارجع لاشيء }
    من_أجل (ك في _يستبعد) { إذا (يحوي(س، ك)) { ارجع لاشيء } }
    من_أجل (ق في _قوالب) {
        من_أجل (ج في ق[٣]) {
            إذا (يحوي(س، ج)) { ارجع {"اسم": ق[٠]، "عنوان": ق[١]، "وصف": ق[٢]} }
        }
    }
    ارجع لاشيء
}
