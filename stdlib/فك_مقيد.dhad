# ضاد/فك_مقيد — توليد مقيَّد بنحو ضاد: لا يُقبل رمز إلا إذا بقي النص بداية صالحة لبرنامج (يفحصها محلّل اللغة نفسه)،
# فلا يخرج النموذج شيفرة بنيتها مكسورة مهما كانت سجلاته. الطريقة: سحب من التوزيع ثم رفض ما يكسر الصياغة وإعادة السحب
# (يحفظ التوزيع الشرطي الصحيح). مع مكافأة تنفيذ للتدريب بالتعزيز.

متغير ر = استورد("ضاد/رياضيات")
متغير ع = استورد("ضاد/عيّنات")
متغير ز = استورد("ضاد/نواة_مجزئ")
متغير ط = استورد("ضاد/طبقات")
متغير م = استورد("ضاد/نواة_منفذ")

# «كامل» | «قابل» | «مرفوض». بايتات حرف ناقص (�) في النهاية لا تُحسب خطأ: يُفحص النص بدونها.
صدّر دالة حالة(نص_) {
    متغير ق = نص_
    طالما (طول(ق) > ٠ و ق[طول(ق) - ١] == "�") { ق = اقتطع(ق، ٠، طول(ق) - ١) }
    ارجع نواة_فحص_صياغة(ق)
}

# سحب من توزيع غير مطبَّع (قد أُصفِّر بعض احتمالاته)
دالة _اسحب_من(احتمالات، مولد) {
    متغير مج = ٠
    من_أجل (ب في احتمالات) { مج = مج + ب }
    إذا (مج <= ٠) { ارجع -١ }
    متغير س = ر.تالي(مولد) * مج
    متغير تراكم = ٠
    متغير آخر = -١
    من_أجل (ي في مدى(طول(احتمالات))) {
        إذا (احتمالات[ي] > ٠) {
            آخر = ي
            تراكم = تراكم + احتمالات[ي]
            إذا (س < تراكم) { ارجع ي }
        }
    }
    ارجع آخر
}

# يختار رمزًا مقبولًا: رفض بالسحب المتكرر ثم، إن نفدت المحاولات، توسيع التوزيع كله بلا قصّ
دالة _اختر_مقبولا(سجلات، رموز، نموذج_مجزئ، مولد، حرارة، أعلى_ك، أعلى_ب، ماض، خاصة) {
    من_أجل (مرحلة في [٠، ١]) {
        متغير د = لاشيء
        إذا (مرحلة == ٠) { د = ع.توزيع(سجلات، حرارة، أعلى_ك، أعلى_ب) } وإلا { د = ع.توزيع(سجلات، حرارة، ٠، ١) }
        من_أجل (ي في مدى(٢٥٦)) {
            متغير م٢ = _اسحب_من(د، مولد)
            إذا (م٢ < ٠) { توقف }
            إذا (م٢ == خاصة["pad"] أو م٢ == خاصة["unk"] أو م٢ == خاصة["bos"]) { د[م٢] = ٠ }
            وإلا إذا (م٢ == خاصة["eos"]) {
                إذا (حالة(ماض) == "كامل") { ارجع م٢ }
                د[م٢] = ٠
            } وإلا {
                # الفحص على فك التسلسل كله؛ ويُرفض كل رمز يترك حرفًا ناقص البايتات (�) فلا تبقى طريق مسدودة
                متغير مرشح = ز.فكّ(نموذج_مجزئ، رموز + [م٢])
                إذا (طول(مرشح) > ٠ و مرشح[طول(مرشح) - ١] != "�" و حالة(مرشح) != "مرفوض") { ارجع م٢ }
                د[م٢] = ٠
            }
        }
    }
    ارجع -١
}

# منتج_سجلات(رموز) ← قائمة سجلات لآخر موضع. بداية: نص يسبق التوليد. ينتهي عند <eos> المقبول أو بلوغ «عدد».
# ما يرجع: {"نص"، "رموز"، "حالة"، "سبب": "eos" | "عدد" | "عالق"، "مرفوض": عدد المحاولات المرفوضة تقريبًا}
صدّر دالة ولّد(منتج_سجلات، نموذج_مجزئ، بداية، عدد، مولد، خيارات = {}) {
    متغير حرارة = ١
    متغير أعلى_ك = ٠
    متغير أعلى_ب = ١
    إذا (يحوي(خيارات، "حرارة")) { حرارة = خيارات["حرارة"] }
    إذا (يحوي(خيارات، "أعلى_ك")) { أعلى_ك = خيارات["أعلى_ك"] }
    إذا (يحوي(خيارات، "أعلى_ب")) { أعلى_ب = خيارات["أعلى_ب"] }
    متغير خاصة = {"pad": ز.معرّف_خاص(نموذج_مجزئ، "<pad>")، "unk": ز.معرّف_خاص(نموذج_مجزئ، "<unk>")، "bos": ز.معرّف_خاص(نموذج_مجزئ، "<bos>")، "eos": ز.معرّف_خاص(نموذج_مجزئ، "<eos>")}
    متغير رموز = ز.رمّز_تسلسلا(نموذج_مجزئ، بداية، صحيح، خطأ)
    إذا (حالة(بداية) == "مرفوض") { أطلق_خطأ("الفك المقيّد: بداية النص نفسها مرفوضة نحويًّا") }
    متغير سبب = "عدد"
    من_أجل (ي في مدى(عدد)) {
        متغير ماض = ز.فكّ(نموذج_مجزئ، رموز)
        متغير س = منتج_سجلات(رموز)
        متغير ق = _اختر_مقبولا(س، رموز، نموذج_مجزئ، مولد، حرارة، أعلى_ك، أعلى_ب، ماض، خاصة)
        إذا (ق < ٠) { سبب = "عالق"; توقف }
        إذا (ق == خاصة["eos"]) { سبب = "eos"; توقف }
        أضف(رموز، ق)
    }
    متغير نص_ = ز.فكّ(نموذج_مجزئ، رموز)
    ارجع {"نص": نص_، "رموز": رموز، "حالة": حالة(نص_)، "سبب": سبب}
}

# منتج سجلات من نموذج محوّل
صدّر دالة منتج_من_نموذج(ن) {
    ارجع دالة(رموز) { ارجع ع.آخر_صف(ط.أمام(ن، رموز)["قيمة"]) }
}

# ---------- مكافأة التنفيذ للتعلّم بالتعزيز ----------
# ٠ صياغة مرفوضة · ٠٫١ صياغة سليمة ولم تُنفَّذ · ٠٫٣ نُفِّذت بخطأ · ٠٫٥ نُفِّذت بلا خطأ بمخرجات مختلفة · ١ مخرجاتها تطابق المتوقع
صدّر دالة مكافأة(شيفرة، متوقع) {
    إذا (نواة_فحص_صياغة(شيفرة) != "كامل") { ارجع ٠ }
    متغير ن = م.شغّل_معزولًا(شيفرة)
    إذا (ليس ن["ناجح"]) {
        إذا (ن["نوع_الخطأ"] == "صياغة") { ارجع ٠ }
        ارجع ٠.٣
    }
    إذا (طول(ن["مخرجات"]) != طول(متوقع)) { ارجع ٠.٥ }
    من_أجل (ي في مدى(طول(متوقع))) { إذا (ن["مخرجات"][ي] != متوقع[ي]) { ارجع ٠.٥ } }
    ارجع ١
}
