# ضاد/نواة_أخطاء — محلل الأخطاء: يقرأ رسالة خطأ ضاد (ومعها الشيفرة إن وُجدت) فيعيد تصنيفها وتفسيرها واقتراح الإصلاح.
# قواعده شفافة: لكل نمط رسالة تصنيف وتفسير واقتراح. ويستعين بالشيفرة لإظهار السطر المعيب واقتراح أقرب اسم عند الخطأ المطبعي.
# هو غير محلل اللغة: يعمل على رسائل التشغيل الفعلية لا على شجرة الصياغة، ويُلحَق بمنسّق نواة.

متغير ن = استورد("ضاد/نصوص")
متغير ع = استورد("ضاد/نواة_عقد")

# [جزء من الرسالة، تصنيف، تفسير، اقتراح]
متغير _قواعد = [
    ["متغير غير معرّف"، "اسم_غير_معرف"، "استُعمل اسم لم يُعرَّف قبل استعماله في هذا النطاق"، "عرّف الاسم بـ«متغير» قبل استعماله، أو صحّح كتابته"]،
    ["غير قابل للاستدعاء"، "استدعاء_غير_دالة"، "وُضعت أقواس استدعاء بعد قيمة ليست دالة"، "تأكد أن الاسم دالة؛ وإن كان قائمة أو خريطة فاستعمل [ ] للوصول"]،
    ["قسمة على صفر"، "حساب"، "المقسوم عليه صفر"، "تحقق من المقسوم عليه قبل القسمة بـ«إذا (ب != ٠)»"]،
    ["تجاوزت الدالة عمق الاستدعاء"، "تكرار_لا_ينتهي"، "دالة تستدعي نفسها بلا شرط توقف يكفي"، "أضف حالة أساس تُنهي الاستدعاء الذاتي"]،
    ["نفاد المكدّس"، "تكرار_لا_ينتهي"، "دالة تستدعي نفسها بلا شرط توقف يكفي"، "أضف حالة أساس تُنهي الاستدعاء الذاتي"]،
    ["استغرق البرنامج وقتًا طويلًا"، "حد"، "تجاوز التنفيذ حدّ الخطوات أو الزمن، غالبًا لحلقة لا تنتهي"، "تأكد أن شرط «طالما» يتغير داخل الكتلة، أو قلّل حجم الحساب"]،
    ["النصوص لا تُعدَّل بالفهرسة"، "تعديل_نص"، "النص ثابت ولا يُسند إلى موضع فيه"، "ابنِ نصًا جديدًا (اقتطع واربط) بدل تعديل حرف بعينه"]،
    ["انزع() لا تعمل على قائمة فارغة"، "قائمة_فارغة"، "نُزع عنصر من قائمة لا عناصر فيها"، "تحقق من «طول(القائمة) > ٠» قبل الانتزاع"]،
    ["لا يمكن إعادة إسناد الثابت"، "ثابت"، "قيمة معرَّفة بـ«ثابت» لا تتغير"، "عرّفها بـ«متغير» إن كانت ستتغير"]،
    ["معرَّف سابقًا"، "تعريف_مكرر"، "عُرّف الاسم مرتين في النطاق نفسه"، "غيّر الاسم الثاني أو احذف التعريف المكرر"]،
    ["مستخدمة خارج حلقة"، "تحكم_خارج_حلقة"، "«توقف» أو «أكمل» كُتبت خارج أي حلقة"، "ضعها داخل «طالما» أو «من_أجل»"]،
    ["نص غير مغلق"، "صياغة"، "نص بُدئ بعلامة اقتباس ولم تُغلق"، "أغلق النص بعلامة الاقتباس نفسها"]،
    ["تعليق كتلة غير مغلق"، "صياغة"، "تعليق كتلة بُدئ ولم يُختم"، "أغلق التعليق بالرمز المخصّص لختمه"]،
    ["تعبير القالب غير مغلق"، "صياغة"، "فُتح تعبير داخل نص قالب بلا إغلاق }"، "أغلق التعبير بـ }"]،
    ["رمز غير معروف"، "صياغة"، "ورد رمز لا تعرفه اللغة"، "احذف الرمز أو ضعه داخل نص"]،
    ["لم أفهم هذا الموضع"، "صياغة"، "الصياغة ناقصة عند هذا الموضع، غالبًا قوس أو فاصلة أو كلمة ناقصة"، "راجع الأقواس والفواصل في السطر المذكور وما قبله"]،
    ["كنت أنتظر اسم"، "صياغة"، "وُجدت كلمة محجوزة حيث يلزم اسم متغير أو دالة"، "غيّر الاسم؛ كلمات مثل و أو ليس من إلى في محجوزة"]،
    ["تحتاج"، "نوع_وسيط"، "دالة مدمجة استُدعيت بنوع قيمة لا تقبله"، "راجع نوع الوسيط (نص أو رقم أو قائمة أو خريطة) بـ«نوع()»"]
]

# مسافة التحرير (ليفنشتاين) بين كلمتين
صدّر دالة مسافة(أ، ب) {
    متغير س = طول(أ)
    متغير ص = طول(ب)
    متغير سابق = []
    من_أجل (ي في مدى(ص + ١)) { أضف(سابق، ي) }
    من_أجل (ي في مدى(١، س + ١)) {
        متغير حالي = [ي]
        من_أجل (ك في مدى(١، ص + ١)) {
            متغير تكلفة = ١
            إذا (أ[ي - ١] == ب[ك - ١]) { تكلفة = ٠ }
            متغير أدنى = سابق[ك] + ١
            إذا (حالي[ك - ١] + ١ < أدنى) { أدنى = حالي[ك - ١] + ١ }
            إذا (سابق[ك - ١] + تكلفة < أدنى) { أدنى = سابق[ك - ١] + تكلفة }
            أضف(حالي، أدنى)
        }
        سابق = حالي
    }
    ارجع سابق[ص]
}

# رقم السطر من «السطر N:» أو ٠ إن غاب
دالة _سطر_الرسالة(رسالة) {
    متغير م = موضع(رسالة، "السطر ")
    إذا (م < ٠) { ارجع ٠ }
    متغير ر = ""
    متغير ي = م + طول("السطر ")
    طالما (ي < طول(رسالة) و ن.هل_رقم(رسالة[ي])) {
        ر = ر + رسالة[ي]
        ي = ي + ١
    }
    إذا (ر == "") { ارجع ٠ }
    ارجع عدد(ر)
}

# الاسم بين «» في الرسالة (أول واحد) أو نص فارغ
دالة _اسم_الرسالة(رسالة) {
    متغير أ = موضع(رسالة، "«")
    إذا (أ < ٠) { ارجع "" }
    متغير ب = موضع(اقتطع(رسالة، أ + ١)، "»")
    إذا (ب < ٠) { ارجع "" }
    ارجع اقتطع(اقتطع(رسالة، أ + ١)، ٠، ب)
}

# الأسماء التي تظهر في الشيفرة (كلمات من حروف وأرقام و _)
دالة _أسماء_الشيفرة(شيفرة) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في شيفرة) {
        إذا (ن.هل_حرف_عربي(ح) أو ن.هل_حرف_لاتيني(ح) أو ن.هل_رقم(ح) أو ح == "_") {
            حالي = حالي + ح
        } وإلا {
            إذا (حالي != "" و ليس يحوي(خرج، حالي)) { أضف(خرج، حالي) }
            حالي = ""
        }
    }
    إذا (حالي != "" و ليس يحوي(خرج، حالي)) { أضف(خرج، حالي) }
    ارجع خرج
}

# يحلّل رسالة خطأ (ومعها الشيفرة اختياريًا) ويعيد
# {تصنيف، تفسير، اقتراح، سطر، نص_السطر، اسم، أقرب_اسم}
صدّر دالة حلّل_الخطأ(رسالة، شيفرة = "") {
    إذا (نوع(رسالة) != "نص") { أطلق_خطأ("محلل الأخطاء: الرسالة نص") }
    إذا (نوع(شيفرة) != "نص") { أطلق_خطأ("محلل الأخطاء: الشيفرة نص") }
    متغير تصنيف = "غير_مصنّف"
    متغير تفسير = "لا قاعدة تطابق هذه الرسالة"
    متغير اقتراح = "اقرأ الرسالة وراجع السطر المذكور"
    من_أجل ([جزء، ص، ت، ق] في _قواعد) {
        إذا (تصنيف == "غير_مصنّف" و يحوي(رسالة، جزء)) {
            تصنيف = ص
            تفسير = ت
            اقتراح = ق
        }
    }
    متغير سطر = _سطر_الرسالة(رسالة)
    متغير نص_السطر = ""
    إذا (سطر > ٠ و شيفرة != "") {
        متغير سطور = افصل(شيفرة، حرف(١٠))
        إذا (سطر <= طول(سطور)) { نص_السطر = سطور[سطر - ١] }
    }
    متغير اسم = ""
    متغير أقرب = ""
    إذا (تصنيف == "اسم_غير_معرف") {
        اسم = _اسم_الرسالة(رسالة)
        إذا (اسم == "") {
            متغير أ = موضع(رسالة، "غير معرّف: ")
            إذا (أ >= ٠) { اسم = اقتطع(رسالة، أ + طول("غير معرّف: ")) }
        }
        إذا (اسم != "" و شيفرة != "") {
            متغير أفضل = ٣
            من_أجل (ك في _أسماء_الشيفرة(شيفرة)) {
                إذا (ك != اسم و طول(ك) > ١) {
                    متغير د = مسافة(اسم، ك)
                    إذا (د < أفضل) {
                        أفضل = د
                        أقرب = ك
                    }
                }
            }
        }
        إذا (أقرب != "") { اقتراح = "ربما تقصد «" + أقرب + "»" }
    }
    ارجع {"تصنيف": تصنيف، "تفسير": تفسير، "اقتراح": اقتراح، "سطر": سطر، "نص_السطر": نص_السطر، "اسم": اسم، "أقرب_اسم": أقرب}
}

صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "محلل_أخطاء"،
        "يصنّف رسالة خطأ ضاد ويفسّرها ويقترح الإصلاح"،
        {"رسالة": "نص"، "شيفرة": "نص"}،
        {"تصنيف": "نص"، "تفسير": "نص"، "اقتراح": "نص"، "سطر": "رقم"، "نص_السطر": "نص"، "اسم": "نص"، "أقرب_اسم": "نص"}،
        دالة(مدخل) { ارجع حلّل_الخطأ(مدخل["رسالة"]، مدخل["شيفرة"]) }
    ))
}
