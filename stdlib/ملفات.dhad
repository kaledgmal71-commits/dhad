# ضاد/ملفات — أدوات الملفات والمجلدات، مكتوبة بضاد فوق دوال المحرك الأساسية (اقرأ_ملف، اكتب_ملف، اسرد_مجلد …)
# لا يصل البرنامج إلى القرص إلا عبر مجلد واحد يمنحه المضيف (جذر «/»). والمحرك يرفض الخروج من هذا الجذر قبل أن تصل هذه الدوال.
# الملفات نصية (UTF-8). لا ملفات ثنائية بعد. المسارات تستعمل الفاصل «/» دائمًا.

متغير _م = استورد("ضاد/مسارات")
متغير _ج = استورد("ضاد/جسون")

دالة _مسار(اسم، م) {
    إذا (نوع(م) != "نص") { أطلق_خطأ("ملفات: " + اسم + "() تحتاج مسارًا نصًّا (وُجد " + نوع(م) + ")") }
}

دالة _قارن(ا، ب) {
    إذا (ا < ب) { ارجع -١ }
    إذا (ا > ب) { ارجع ١ }
    ارجع ٠
}

# يرفض المسار الذي يصعد بـ «..» فوق الجذر، كما يفعل المحرك، بدل أن يهمله بصمت فيعمل على مسار غير مقصود
دالة _حلّ_آمن(اسم، م) {
    _مسار(اسم، م)
    متغير عمق = ٠
    من_أجل (ج في افصل(م، "/")) {
        إذا (ج == ".." ) {
            عمق = عمق - ١
            إذا (عمق < ٠) { أطلق_خطأ("ملفات: " + اسم + "() المسار «" + م + "» يخرج من المجلد المسموح") }
        } وإلا إذا (ج != "" و ج != ".") {
            عمق = عمق + ١
        }
    }
    ارجع _م.حلّ(م، "/")
}

صدّر دالة يوجد(مسار) {
    _مسار("يوجد"، مسار)
    ارجع نوع_المسار(مسار) != لاشيء
}

صدّر دالة هل_ملف(مسار) {
    _مسار("هل_ملف"، مسار)
    ارجع نوع_المسار(مسار) == "ملف"
}

صدّر دالة هل_مجلد(مسار) {
    _مسار("هل_مجلد"، مسار)
    ارجع نوع_المسار(مسار) == "مجلد"
}

# محتوى الملف، أو القيمة الافتراضية إن لم يكن موجودًا (أي خطأ آخر يظهر كما هو)
صدّر دالة اقرأ_أو(مسار، افتراضي = لاشيء) {
    إذا (هل_ملف(مسار)) { ارجع اقرأ_ملف(مسار) }
    ارجع افتراضي
}

# سطور الملف قائمة نصوص. يقبل نهاية السطر بنوعيها (يونكس وويندوز)، ولا يعدّ السطر الفارغ الأخير سطرًا
صدّر دالة اقرأ_سطور(مسار) {
    متغير نص_ = اقرأ_ملف(مسار)
    إذا (نص_ == "") { ارجع [] }
    متغير ق = افصل(نص_، حرف(10))
    إذا (ق[طول(ق) - ١] == "") { انزع(ق) }
    متغير ن = []
    من_أجل (س في ق) {
        إذا (طول(س) > ٠ و رمز(س[طول(س) - ١]) == ١٣) { س = اقتطع(س، ٠، طول(س) - ١) }
        أضف(ن، س)
    }
    ارجع ن
}

# يكتب كل نص في سطر، وينهي الملف بسطر جديد. القائمة الفارغة تنتج ملفًا فارغًا
صدّر دالة اكتب_سطور(مسار، سطور) {
    _مسار("اكتب_سطور"، مسار)
    إذا (نوع(سطور) != "قائمة") { أطلق_خطأ("ملفات: اكتب_سطور() تحتاج قائمة نصوص") }
    من_أجل (س في سطور) {
        إذا (نوع(س) != "نص") { أطلق_خطأ("ملفات: اكتب_سطور() كل عنصر يجب أن يكون نصًّا (وُجد " + نوع(س) + ")") }
    }
    إذا (طول(سطور) == ٠) {
        اكتب_ملف(مسار، "")
    } وإلا {
        اكتب_ملف(مسار، اربط(سطور، حرف(10)) + حرف(10))
    }
    ارجع مسار
}

# يقرأ ملف JSON إلى قيمة ضاد (انظر ضاد/جسون). خطأ الصيغة يذكر اسم الملف
صدّر دالة اقرأ_جسون(مسار) {
    متغير ن = اقرأ_ملف(مسار)
    حاول {
        ارجع _ج.حلّل(ن)
    } التقط (خ) {
        أطلق_خطأ("ملفات: الملف " + مسار + " ليس JSON صالحًا: " + نص(خ))
    }
}

# يكتب قيمة JSON منسّقة بمسافتين (غيّرها بالمعامل الثالث، و٠ للمضغوط في سطر واحد). رتّب = صحيح يرتّب مفاتيح كل خريطة
صدّر دالة اكتب_جسون(مسار، قيمة، مسافة = ٢، رتّب = خطأ) {
    _مسار("اكتب_جسون"، مسار)
    اكتب_ملف(مسار، _ج.اكتب(قيمة، مسافة، رتّب) + حرف(10))
    ارجع مسار
}

دالة _امش(مسار، نتيجة، مجلدات، عمق) {
    إذا (عمق > ١٠٠) { أطلق_خطأ("ملفات: المجلدات متداخلة أكثر من ١٠٠ مستوى (ربما وصلة دائرية)") }
    من_أجل (اسم في اسرد_مجلد(مسار)) {
        متغير ك = _م.ادمج([مسار، اسم])
        إذا (نوع_المسار(ك) == "مجلد") {
            إذا (مجلدات) { أضف(نتيجة، ك) }
            _امش(ك، نتيجة، مجلدات، عمق + ١)
        } وإلا {
            أضف(نتيجة، ك)
        }
    }
}

# كل الملفات تحت المجلد (وما تحته)، مرتبة حرفيًا، مساراتها من جذر البرنامج: ["/أ/ب.txt"، …]. مع_المجلدات = صحيح تضيف المجلدات أيضًا
صدّر دالة اسرد_شجرة(مجلد = "/"، مع_المجلدات = خطأ) {
    _مسار("اسرد_شجرة"، مجلد)
    متغير جذر = _حلّ_آمن("اسرد_شجرة"، مجلد)
    إذا (نوع_المسار(جذر) != "مجلد") { أطلق_خطأ("ملفات: اسرد_شجرة() المسار " + جذر + " ليس مجلدًا موجودًا") }
    متغير ن = []
    _امش(جذر، ن، مع_المجلدات، ٠)
    ارجع رتب(ن، _قارن)
}

# ملفات المجلد (وما تحته) التي امتدادها المطلوب مثل ".txt"، مرتبة
صدّر دالة ملفات_بامتداد(مجلد، امتداد) {
    _مسار("ملفات_بامتداد"، امتداد)
    متغير ن = []
    من_أجل (ك في اسرد_شجرة(مجلد)) {
        إذا (_م.الامتداد(ك) == امتداد) { أضف(ن، ك) }
    }
    ارجع ن
}

# يحذف ملفًا أو مجلدًا بكل ما فيه. لا يحذف جذر البرنامج. إن لم يوجد المسار فخطأ واضح
صدّر دالة احذف_شجرة(مسار) {
    _مسار("احذف_شجرة"، مسار)
    متغير ح = _حلّ_آمن("احذف_شجرة"، مسار)
    إذا (ح == "/") { أطلق_خطأ("ملفات: احذف_شجرة() لا تحذف جذر المجلد المسموح") }
    متغير ن = نوع_المسار(ح)
    إذا (ن == لاشيء) { أطلق_خطأ("ملفات: احذف_شجرة() المسار " + ح + " غير موجود") }
    إذا (ن == "ملف") {
        احذف_مسار(ح)
        ارجع ح
    }
    من_أجل (اسم في اسرد_مجلد(ح)) { احذف_شجرة(_م.ادمج([ح، اسم])) }
    احذف_مسار(ح)
    ارجع ح
}

# ينسخ ملفًا أو مجلدًا كاملًا إلى المسار الهدف (المسار نفسه لا «داخله»)، وتُستبدل الملفات الموجودة. يرفض نسخ مجلد إلى داخل نفسه
صدّر دالة انسخ(مصدر، هدف) {
    _مسار("انسخ"، مصدر)
    _مسار("انسخ"، هدف)
    متغير أ = _حلّ_آمن("انسخ"، مصدر)
    متغير ب = _حلّ_آمن("انسخ"، هدف)
    متغير ن = نوع_المسار(أ)
    إذا (ن == لاشيء) { أطلق_خطأ("ملفات: انسخ() المصدر " + أ + " غير موجود") }
    إذا (أ == ب) { أطلق_خطأ("ملفات: انسخ() المصدر والهدف هما نفس المسار") }
    إذا (ن == "ملف") {
        إذا (نوع_المسار(ب) == "مجلد") { أطلق_خطأ("ملفات: انسخ() الهدف " + ب + " مجلد موجود، اذكر اسم الملف الهدف كاملًا") }
        اكتب_ملف(ب، اقرأ_ملف(أ))
        ارجع ب
    }
    إذا (أ == "/" أو ب == أ + "/" أو اقتطع(ب، ٠، طول(أ) + ١) == أ + "/") { أطلق_خطأ("ملفات: انسخ() لا تنسخ مجلدًا إلى داخل نفسه") }
    إذا (نوع_المسار(ب) == "ملف") { أطلق_خطأ("ملفات: انسخ() الهدف " + ب + " ملف موجود والمصدر مجلد") }
    أنشئ_مجلد(ب)
    من_أجل (اسم في اسرد_مجلد(أ)) { انسخ(_م.ادمج([أ، اسم])، _م.ادمج([ب، اسم])) }
    ارجع ب
}

# ينقل بنسخ ثم حذف المصدر (ليس عملية ذرّية: لو انقطع التنفيذ بينهما بقي المصدر والنسخة معًا)
صدّر دالة انقل(مصدر، هدف) {
    متغير ن = انسخ(مصدر، هدف)
    احذف_شجرة(مصدر)
    ارجع ن
}
