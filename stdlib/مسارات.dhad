# ضاد/مسارات — التعامل مع مسارات الملفات كنصوص، مكتوب بضاد نفسها. الفاصل «/» دائمًا (أي بيئة تشغيل).
# كل الدوال نصوص مقابل نصوص: لا تلمس القرص ولا تتحقق من وجود شيء. وهي الأساس الذي ستبنى عليه مكتبة الملفات.
# الأسماء مبنية على معنى كل عملية: ادمج (join)، طبّع (normalize)، المجلد (dirname)، اسم_الملف (basename)، الامتداد (extname).

دالة _يلزم_نص(اسم، م) {
    إذا (نوع(م) != "نص") { أطلق_خطأ("مسارات: " + اسم + "() تحتاج نصًّا (وُجد " + نوع(م) + ")") }
}

دالة _ينتهي_بشرطة(م) {
    ارجع طول(م) > ٠ و رمز(م[طول(م) - ١]) == ٤٧
}

# يفصل المسار إلى أجزاء غير فارغة: «a//b/» تعطي [a، b]
صدّر دالة أجزاء(م) {
    _يلزم_نص("أجزاء"، م)
    متغير ن = []
    من_أجل (ج في افصل(م، "/")) {
        إذا (ج != "") { أضف(ن، ج) }
    }
    ارجع ن
}

صدّر دالة هل_مطلق(م) {
    _يلزم_نص("هل_مطلق"، م)
    ارجع طول(م) > ٠ و رمز(م[٠]) == ٤٧
}

# يحلّ «.» و«..» ويدمج الشرطات المتكررة. الناتج الفارغ يصير «.». تبقى الشرطة الأخيرة إن وُجدت.
# «..» فوق الجذر المطلق تُهمَل (لا يوجد فوق الجذر شيء)، وفي المسار النسبي تبقى.
صدّر دالة طبّع(م) {
    _يلزم_نص("طبّع"، م)
    إذا (م == "") { ارجع "." }
    متغير مطلق = هل_مطلق(م)
    متغير خارج = []
    من_أجل (ج في افصل(م، "/")) {
        إذا (ج == "" أو ج == ".") {
            أكمل
        }
        إذا (ج == "..") {
            إذا (طول(خارج) > ٠ و خارج[طول(خارج) - ١] != "..") {
                انزع(خارج)
            } وإلا إذا (ليس مطلق) {
                أضف(خارج، "..")
            }
        } وإلا {
            أضف(خارج، ج)
        }
    }
    متغير ن = اربط(خارج، "/")
    إذا (مطلق) { ن = "/" + ن }
    إذا (ن == "") { ن = "." }
    إذا (_ينتهي_بشرطة(م) و ن != "/" و ليس _ينتهي_بشرطة(ن)) { ن = ن + "/" }
    ارجع ن
}

# ادمج(["أ"، "ب"، "../ج"]) تعطي «ب/ج» بعد التطبيع. الأجزاء الفارغة تُتجاهل، وإن كانت كلها فارغة فالناتج «.»
صدّر دالة ادمج(قائمة) {
    إذا (نوع(قائمة) != "قائمة") { أطلق_خطأ("مسارات: ادمج() تحتاج قائمة نصوص") }
    متغير ن = []
    من_أجل (ج في قائمة) {
        _يلزم_نص("ادمج"، ج)
        إذا (ج != "") { أضف(ن، ج) }
    }
    إذا (طول(ن) == ٠) { ارجع "." }
    ارجع طبّع(اربط(ن، "/"))
}

# اسم الملف أو المجلد الأخير. اسم_الملف("a/b.txt"، ".txt") تعطي «b». لا يُحذف اللاحق إن كان هو الاسم كله.
صدّر دالة اسم_الملف(م، لاحقة = لاشيء) {
    _يلزم_نص("اسم_الملف"، م)
    متغير ج = أجزاء(م)
    إذا (طول(ج) == ٠) { ارجع "" }
    متغير ن = ج[طول(ج) - ١]
    إذا (لاحقة != لاشيء) {
        _يلزم_نص("اسم_الملف"، لاحقة)
        إذا (لاحقة != "" و طول(ن) > طول(لاحقة) و اقتطع(ن، طول(ن) - طول(لاحقة)) == لاحقة) {
            ارجع اقتطع(ن، ٠، طول(ن) - طول(لاحقة))
        }
    }
    ارجع ن
}

# المجلد الأب. «/» و«a» و«» لها مجلد «/» و«.» و«.» على الترتيب
صدّر دالة المجلد(م) {
    _يلزم_نص("المجلد"، م)
    متغير مطلق = هل_مطلق(م)
    متغير ج = أجزاء(م)
    إذا (طول(ج) <= ١) {
        إذا (مطلق) { ارجع "/" }
        ارجع "."
    }
    انزع(ج)
    متغير ن = اربط(ج، "/")
    إذا (مطلق) { ن = "/" + ن }
    ارجع ن
}

# الامتداد مع النقطة: «.txt». الاسم الذي يبدأ بنقطة فقط (.bashrc) أو بلا نقطة لا امتداد له، و«a.» امتداده «.»
صدّر دالة الامتداد(م) {
    _يلزم_نص("الامتداد"، م)
    متغير ن = اسم_الملف(م)
    إذا (ن == "..") { ارجع "" }
    متغير ي = طول(ن) - ١
    طالما (ي >= ٠ و ن[ي] != ".") { ي = ي - ١ }
    إذا (ي <= ٠) { ارجع "" }
    ارجع اقتطع(ن، ي)
}

# يفصل المسار: جذر ومجلد واسم وامتداد واسم بلا امتداد. المجلد «» إن لم يكن للمسار مجلد
صدّر دالة حلّل(م) {
    _يلزم_نص("حلّل"، م)
    متغير جذر = ""
    إذا (هل_مطلق(م)) { جذر = "/" }
    متغير اسم = اسم_الملف(م)
    متغير امتداد = الامتداد(م)
    متغير مجلد = ""
    متغير ج = أجزاء(م)
    إذا (طول(ج) > ١) {
        انزع(ج)
        مجلد = اربط(ج، "/")
        إذا (جذر != "") { مجلد = "/" + مجلد }
    } وإلا إذا (جذر != "" و طول(ج) == ١) {
        مجلد = "/"
    }
    ارجع {"جذر": جذر، "مجلد": مجلد، "اسم": اسم، "امتداد": امتداد، "أصل": اقتطع(اسم، ٠، طول(اسم) - طول(امتداد))}
}

# يحلّ المسار على أساس مطلق: إن كان المسار مطلقًا فهو كما هو (مطبَّعًا)، وإلا دُمج بالأساس. بلا شرطة أخيرة
صدّر دالة حلّ(م، أساس) {
    _يلزم_نص("حلّ"، م)
    _يلزم_نص("حلّ"، أساس)
    إذا (ليس هل_مطلق(أساس)) { أطلق_خطأ("مسارات: حلّ() تحتاج أساسًا مطلقًا (يبدأ بـ «/»)") }
    متغير ن = طبّع(م)
    إذا (ليس هل_مطلق(م)) { ن = طبّع(أساس + "/" + م) }
    إذا (ن != "/" و _ينتهي_بشرطة(ن)) { ن = اقتطع(ن، ٠، طول(ن) - ١) }
    ارجع ن
}

# المسار النسبي من مجلد إلى مسار: نسبي("/أ/ب"، "/أ/ج/د") تعطي «../ج/د». الاثنان مطلقان أو كلاهما نسبي
صدّر دالة نسبي(أصل، هدف) {
    _يلزم_نص("نسبي"، أصل)
    _يلزم_نص("نسبي"، هدف)
    إذا (هل_مطلق(أصل) != هل_مطلق(هدف)) { أطلق_خطأ("مسارات: نسبي() تحتاج مسارين مطلقين أو مسارين نسبيين") }
    متغير ا = أجزاء(طبّع(أصل))
    متغير ب = أجزاء(طبّع(هدف))
    إذا (طول(ا) > ٠ و ا[٠] == "." و طول(ا) == ١ و ليس هل_مطلق(أصل)) { ا = [] }
    إذا (طول(ب) > ٠ و ب[٠] == "." و طول(ب) == ١ و ليس هل_مطلق(هدف)) { ب = [] }
    متغير ي = ٠
    طالما (ي < طول(ا) و ي < طول(ب) و ا[ي] == ب[ي]) { ي = ي + ١ }
    متغير ن = []
    متغير ك = ي
    طالما (ك < طول(ا)) {
        إذا (ا[ك] == "..") { أطلق_خطأ("مسارات: نسبي() لا تحسب من مسار نسبي يصعد فوق نفسه (..) دون أساس معروف") }
        أضف(ن، "..")
        ك = ك + ١
    }
    ك = ي
    طالما (ك < طول(ب)) {
        أضف(ن، ب[ك])
        ك = ك + ١
    }
    ارجع اربط(ن، "/")
}

# ادمج_داخل("/ملفاتي"، "تقارير/٢٠٢٦.txt") تعطي «/ملفاتي/تقارير/٢٠٢٦.txt»، وترفض كل ما يهرب من الجذر («../» أو مسار مطلق)
# هذا هو الأساس الآمن لأي مكتبة ملفات تمنح المستخدم مجلدًا واحدًا لا الجهاز كله
صدّر دالة ادمج_داخل(جذر، م) {
    _يلزم_نص("ادمج_داخل"، جذر)
    _يلزم_نص("ادمج_داخل"، م)
    إذا (ليس هل_مطلق(جذر)) { أطلق_خطأ("مسارات: ادمج_داخل() تحتاج جذرًا مطلقًا") }
    إذا (هل_مطلق(م)) { أطلق_خطأ("مسارات: المسار «" + م + "» مطلق ويخرج من الجذر") }
    متغير ثابت = حلّ(جذر، "/")
    متغير ن = حلّ(م، ثابت)
    متغير بادئة = ثابت
    إذا (بادئة != "/") { بادئة = بادئة + "/" }
    إذا (ن != ثابت و اقتطع(ن، ٠، طول(بادئة)) != بادئة) { أطلق_خطأ("مسارات: المسار «" + م + "» يخرج من الجذر «" + ثابت + "»") }
    ارجع ن
}
