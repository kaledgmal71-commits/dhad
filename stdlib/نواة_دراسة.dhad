# ضاد/نواة_دراسة — دراسة نص يلصقه المستخدم: اختبار متنوع بتغذية راجعة تذكر الصواب والفخاخ وكيف يُتحاشى،
# وأسئلة وأجوبة، وتلخيص واختصار ونقاط.
# كل سؤال وكل خيار مبنيان من جمل النص نفسها: الجواب الصحيح نقل منه، والفخاخ كلمات وأرقام وجمل منه أو معدَّلة عنه،
# وكل فخ يُعلَّل بسببه. لا اختلاق، ولا فهم لمعنى النص: الأسئلة تختبر الإحاطة بما ورد فيه.
# عامة: لا تعرف لغة ولا موضوعًا.

متغير ن = استورد("ضاد/نصوص")
متغير ل = استورد("ضاد/نواة_تلخيص")

متغير _أرقام_ = "٠١٢٣٤٥٦٧٨٩"
متغير _حروف_الخيارات = ["أ"، "ب"، "ج"، "د"]
متغير _حروف_لاتينية = ["a"، "b"، "c"، "d"]
متغير _وقف = ["الذي"، "التي"، "الذين"، "هذا"، "هذه"، "ذلك"، "تلك"، "هؤلاء"، "كان"، "كانت"، "يكون"، "تكون"، "قد"، "لقد"، "لكن"، "ولكن"، "حتى"، "عند"، "بعد"، "قبل"، "بين"، "منذ"، "خلال"، "أيضا"، "أيضًا"، "كما"، "إذا"، "عندما"، "لأن"، "بسبب"، "حيث"، "إلى"، "على"، "عن"، "مع"، "ثم"، "أن"، "إن"، "أنه"، "إنه"، "فيه"، "فيها"، "منه"، "منها"، "عليه"، "عليها"، "هو"، "هي"، "هما"، "وقد"، "ومن"، "وفي"، "وهو"، "وهي"، "وقال"، "قال"]

# ——— أدوات نصية ———

# يطبّع للمقارنة: بلا تشكيل ولا تطويل، وألف بأنواعها واحدة
دالة _طبّع(س) {
    متغير خ = ""
    من_أجل (ح في س) {
        إذا (يحوي("ًٌٍَُِّْـ"، ح)) { خ = خ }
        وإلا إذا (ح == "أ" أو ح == "إ" أو ح == "آ") { خ = خ + "ا" }
        وإلا { خ = خ + ح }
    }
    ارجع خ
}

دالة _جمل(س) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في س) {
        إذا (ح == "." أو ح == "؟" أو ح == "!" أو ح == "؛" أو ح == "?" أو ح == حرف(١٠)) {
            متغير ق = ن.قصّ(حالي)
            إذا (طول(ق) >= ٢٠ و طول(ق) <= ٣٠٠) { أضف(خرج، ق) }
            حالي = ""
        } وإلا { حالي = حالي + ح }
    }
    متغير ق٢ = ن.قصّ(حالي)
    إذا (طول(ق٢) >= ٢٠ و طول(ق٢) <= ٣٠٠) { أضف(خرج، ق٢) }
    ارجع خرج
}

دالة _قصّ_علامات(ك) {
    متغير س = ك
    متغير ي = ٠
    طالما (طول(س) > ٠ و يحوي(("،,:;«»()[]{}!؟?." + حرف(٣٤))، س[٠])) { س = س[١:طول(س)] }
    طالما (طول(س) > ٠ و يحوي(("،,:;«»()[]{}!؟?." + حرف(٣٤))، س[طول(س) - ١])) { س = س[٠:طول(س) - ١] }
    ارجع س
}

دالة _كلمات(جملة) {
    متغير خ = []
    من_أجل (ك في افصل(جملة، " ")) {
        متغير ق = _قصّ_علامات(ك)
        إذا (ق != "") { أضف(خ، ق) }
    }
    ارجع خ
}

دالة _رقم_حرف(ح) {
    من_أجل (ي في مدى(١٠)) { إذا (_أرقام_[ي] == ح) { ارجع ي } }
    إذا (ح >= "0" و ح <= "9") { ارجع طول("") + ٠ }
    ارجع -١
}

# هل الكلمة رقم خالص (هندي أو لاتيني)؟
دالة _عددية(ك) {
    إذا (طول(ك) == ٠) { ارجع خطأ }
    من_أجل (ح في ك) { إذا (ليس يحوي("٠١٢٣٤٥٦٧٨٩0123456789"، ح)) { ارجع خطأ } }
    ارجع صحيح
}

# قيمة رقم خالص (كلمة عددية) أو -١
دالة _قيمة(ك) {
    متغير ق = ٠
    من_أجل (ح في ك) {
        متغير ر = -١
        من_أجل (ي في مدى(١٠)) { إذا (_أرقام_[ي] == ح) { ر = ي } }
        إذا (ر < ٠) { ر = رقم(ح) }
        ق = ق * ١٠ + ر
    }
    ارجع ق
}

دالة _كلمة_محتوى(ك) {
    إذا (طول(ك) < ٤ أو _عددية(ك)) { ارجع خطأ }
    ارجع ليس يحوي(_وقف، ك)
}

دالة _استبدل_أول(جملة، قديم، جديد) {
    متغير ي = موضع(جملة، قديم)
    إذا (ي < ٠) { ارجع جملة }
    ارجع جملة[٠:ي] + جديد + جملة[ي + طول(قديم):طول(جملة)]
}

# ——— توليد الأسئلة ———

# يرتّب الخيارات بوضع حتمي للصحيح بحسب رقم السؤال لئلا يتكرر موضعه
دالة _رتّب(صحيح_، مموِّهات، رقم_سؤال) {
    متغير كل = [صحيح_]
    من_أجل (م في مموِّهات) { أضف(كل، م) }
    متغير موضع = (رقم_سؤال * ٣ + ١) % طول(كل)
    متغير خ = []
    متغير اتجه = ١
    من_أجل (ي في مدى(طول(كل))) { أضف(خ، "") }
    # يُنقل الصحيح (موضعه ٠) إلى «موضع» ويُسحب ما بينهما خطوة
    متغير ترتيب = []
    من_أجل (ي في مدى(طول(كل))) { أضف(ترتيب، ي) }
    متغير نتيجة = []
    متغير ب = ١
    من_أجل (ي في مدى(طول(كل))) {
        إذا (ي == موضع) { أضف(نتيجة، ٠) }
        وإلا { أضف(نتيجة، ب); ب = ب + ١ }
    }
    ارجع {"ترتيب": نتيجة، "موضع": موضع}
}

دالة _ابنِ(نوع_سؤال، سؤال، صحيح_، مموِّهات، أسباب، مصدر، فخ، احتياط، رقم_سؤال) {
    متغير ر = _رتّب(صحيح_، مموِّهات، رقم_سؤال)
    متغير كل = [صحيح_]
    متغير أس = [""]
    من_أجل (ي في مدى(طول(مموِّهات))) { أضف(كل، مموِّهات[ي]); أضف(أس، أسباب[ي]) }
    متغير خيارات = []
    متغير أسباب_مرتبة = []
    من_أجل (ي في ر["ترتيب"]) { أضف(خيارات، كل[ي]); أضف(أسباب_مرتبة، أس[ي]) }
    ارجع {"نوع": نوع_سؤال، "سؤال": سؤال، "خيارات": خيارات، "صحيح": ر["موضع"]، "أسباب": أسباب_مرتبة، "مصدر": مصدر، "فخ": فخ، "احتياط": احتياط}
}

# سؤال رقم: يُحجب الرقم، والمموِّهات أرقام من جمل أخرى أو قريبة منه
دالة _سؤال_رقم(جمل، ي، أرقام_الجمل، رقم_سؤال) {
    متغير ك = أرقام_الجمل[ي]
    إذا (طول(ك) == ٠) { ارجع لاشيء }
    متغير ص = ك[٠]
    متغير مموِّهات = []
    متغير أسباب = []
    من_أجل (ج في مدى(طول(جمل))) {
        من_أجل (ر في أرقام_الجمل[ج]) {
            إذا (ج != ي و ر != ص و ليس يحوي(مموِّهات، ر) و طول(مموِّهات) < ٣) {
                أضف(مموِّهات، ر)
                أضف(أسباب، "رقم ورد في جملة أخرى من النص: «" + جمل[ج] + "»")
            }
        }
    }
    إذا (_عددية(ص)) {
        متغير قيمة = _قيمة(ص)
        متغير قريبة = [قيمة + ١، قيمة + ١٠، قيمة - ١، قيمة + ٥٠]
        من_أجل (ق في قريبة) {
            إذا (ق > ٠ و طول(مموِّهات) < ٣ و نص(ق) != ص و ليس يحوي(مموِّهات، نص(ق))) {
                أضف(مموِّهات، نص(ق))
                أضف(أسباب، "رقم قريب من الصحيح لا أصل له في النص")
            }
        }
    }
    إذا (طول(مموِّهات) < ٣) { ارجع لاشيء }
    ارجع _ابنِ("رقم"، "أكمل الجملة الواردة في النص:" + حرف(١٠) + "«" + _استبدل_أول(جمل[ي]، ص، "_____") + "»"، ص، مموِّهات، أسباب، جمل[ي]،
        "الأرقام المتقاربة أو الواردة في مواضع أخرى تُخلَط بسهولة."،
        "ارجع إلى الجملة نفسها ولا تعتمد على الذاكرة؛ وقارن الرقم بما حوله من كلمات قبل الاختيار."، رقم_سؤال)
}

# سؤال إكمال: تُحجب كلمة محتوى لا تتكرر في النص؛ والمموِّهات كلمات من جمل أخرى بطول قريب
دالة _سؤال_إكمال(جمل، ي، كلمات_الجمل، تكرار، رقم_سؤال) {
    متغير هدف = ""
    من_أجل (ك في كلمات_الجمل[ي]) {
        إذا (_كلمة_محتوى(ك) و تكرار[_طبّع(ك)] == ١ و طول(ك) > طول(هدف)) { هدف = ك }
    }
    إذا (هدف == "") { ارجع لاشيء }
    متغير مموِّهات = []
    متغير أسباب = []
    متغير مصادر_ = []
    من_أجل (ج في مدى(طول(جمل))) {
        من_أجل (ك في كلمات_الجمل[ج]) {
            إذا (ج != ي و ليس يحوي(مصادر_، ج) و _كلمة_محتوى(ك) و _طبّع(ك) != _طبّع(هدف) و ليس يحوي(مموِّهات، ك) و طول(مموِّهات) < ٣ و ليس يحوي(جمل[ي]، ك)) {
                أضف(مموِّهات، ك)
                أضف(مصادر_، ج)
                أضف(أسباب، "كلمة وردت في النص لكن في جملة أخرى: «" + جمل[ج] + "»")
            }
        }
    }
    إذا (طول(مموِّهات) < ٣) { ارجع لاشيء }
    ارجع _ابنِ("إكمال"، "اختر الكلمة المناسبة للفراغ:" + حرف(١٠) + "«" + _استبدل_أول(جمل[ي]، هدف، "_____") + "»"، هدف، مموِّهات، أسباب، جمل[ي]،
        "كلمة صحيحة في ذاتها لكنها وردت في سياق آخر، فتبدو مألوفة."،
        "لا يكفي أن تتذكر أن الكلمة وردت في النص؛ اقرأ الجملة كاملة وتأكد أن الكلمة تناسب معناها وموضعها."، رقم_سؤال)
}

# سؤال صح أم خطأ: الجملة كما هي (صح) أو بعد استبدال كلمة محتوى بكلمة من موضع آخر (خطأ)
دالة _سؤال_صح_خطأ(جمل، ي، كلمات_الجمل، رقم_سؤال، صحيحة) {
    إذا (صحيحة) {
        ارجع _ابنِ("صح أو خطأ"، "هل ورد هذا في النص كما هو؟" + حرف(١٠) + "«" + جمل[ي] + "»"، "صح"، ["خطأ"]، ["الجملة وردت في النص كما هي حرفيًّا"]، جمل[ي]،
            "الظن بأن كل جملة تبدو غير مألوفة فهي معدّلة."،
            "قارن الجملة بالنص كلمة كلمة ولا ترفضها لمجرد أنك لا تذكرها."، رقم_سؤال)
    }
    متغير هدف = ""
    من_أجل (ك في كلمات_الجمل[ي]) { إذا (_كلمة_محتوى(ك) و طول(ك) > طول(هدف)) { هدف = ك } }
    متغير بديل = ""
    من_أجل (ج في مدى(طول(جمل))) {
        من_أجل (ك في كلمات_الجمل[ج]) {
            إذا (بديل == "" و ج != ي و _كلمة_محتوى(ك) و _طبّع(ك) != _طبّع(هدف) و ليس يحوي(جمل[ي]، ك)) { بديل = ك }
        }
    }
    إذا (هدف == "" أو بديل == "") { ارجع لاشيء }
    متغير معدّلة = _استبدل_أول(جمل[ي]، هدف، بديل)
    ارجع _ابنِ("صح أو خطأ"، "هل ورد هذا في النص كما هو؟" + حرف(١٠) + "«" + معدّلة + "»"، "خطأ"، ["صح"]، ["الجملة معدّلة: استُبدلت «" + هدف + "» بـ«" + بديل + "»؛ والأصل: «" + جمل[ي] + "»"]، جمل[ي]،
        "الجملة المعدّلة تشبه الأصل في كل شيء إلا كلمة واحدة."،
        "انتبه للأسماء والأرقام والأفعال المفتاحية؛ فالتبديل الدقيق لكلمة واحدة هو أكثر الفخاخ شيوعًا."، رقم_سؤال)
}

# سؤال الصياغة الأمينة: أيّ الصياغات وردت في النص؟ والباقي نسخ معدّلة منها
دالة _سؤال_أمين(جمل، ي، كلمات_الجمل، رقم_سؤال) {
    متغير هدف = ""
    من_أجل (ك في كلمات_الجمل[ي]) { إذا (_كلمة_محتوى(ك) و طول(ك) > طول(هدف)) { هدف = ك } }
    إذا (هدف == "") { ارجع لاشيء }
    متغير مموِّهات = []
    متغير أسباب = []
    من_أجل (ج في مدى(طول(جمل))) {
        من_أجل (ك في كلمات_الجمل[ج]) {
            إذا (ج != ي و _كلمة_محتوى(ك) و _طبّع(ك) != _طبّع(هدف) و ليس يحوي(جمل[ي]، ك) و طول(مموِّهات) < ٣) {
                أضف(مموِّهات، _استبدل_أول(جمل[ي]، هدف، ك))
                أضف(أسباب، "صياغة معدّلة: استُبدلت «" + هدف + "» بـ«" + ك + "»")
            }
        }
    }
    إذا (طول(مموِّهات) < ٣) { ارجع لاشيء }
    ارجع _ابنِ("الصياغة الأمينة"، "أيّ الصياغات التالية وردت في النص؟"، جمل[ي]، مموِّهات، أسباب، جمل[ي]،
        "صياغات متقاربة في الشكل تختلف في كلمة واحدة."،
        "لا تختر ما يبدو أجمل أو أوضح؛ اختر ما يطابق النص حرفيًّا."، رقم_سؤال)
}

# يولّد اختبارًا من نص: {وُجد، أسئلة} (حتى «حد» سؤالًا، الأنواع بالتناوب)
صدّر دالة اختبار(النص، حد = ٥) {
    متغير جمل = _جمل(النص)
    إذا (طول(جمل) < ٣) { ارجع {"وُجد": خطأ، "أسئلة": []، "سبب": "النص قصير؛ أحتاج ثلاث جمل مفيدة على الأقل"} }
    متغير كلمات_الجمل = []
    متغير أرقام_الجمل = []
    متغير تكرار = {}
    من_أجل (ج في جمل) {
        متغير ك = _كلمات(ج)
        أضف(كلمات_الجمل، ك)
        متغير ر = []
        من_أجل (و١ في ك) {
            إذا (_عددية(و١)) { أضف(ر، و١) }
            متغير ط = _طبّع(و١)
            إذا (يحوي(مفاتيح(تكرار)، ط)) { تكرار[ط] = تكرار[ط] + ١ } وإلا { تكرار[ط] = ١ }
        }
        أضف(أرقام_الجمل، ر)
    }
    متغير أنواع = ["رقم"، "إكمال"، "صح"، "أمين"، "إكمال"، "خطأ"، "رقم"، "أمين"]
    متغير أسئلة = []
    متغير مستعملة = []
    متغير محاولة = ٠
    متغير اتجاه = ٠
    طالما (طول(أسئلة) < حد و محاولة < طول(جمل) * ٤) {
        متغير ي = (محاولة + اتجاه) % طول(جمل)
        إذا (ليس يحوي(مستعملة، ي)) {
            متغير هدف = أنواع[طول(أسئلة) % طول(أنواع)]
            متغير س = لاشيء
            إذا (هدف == "رقم") { س = _سؤال_رقم(جمل، ي، أرقام_الجمل، طول(أسئلة)) }
            وإلا إذا (هدف == "إكمال") { س = _سؤال_إكمال(جمل، ي، كلمات_الجمل، تكرار، طول(أسئلة)) }
            وإلا إذا (هدف == "صح") { س = _سؤال_صح_خطأ(جمل، ي، كلمات_الجمل، طول(أسئلة)، صحيح) }
            وإلا إذا (هدف == "خطأ") { س = _سؤال_صح_خطأ(جمل، ي، كلمات_الجمل، طول(أسئلة)، خطأ) }
            وإلا { س = _سؤال_أمين(جمل، ي، كلمات_الجمل، طول(أسئلة)) }
            إذا (س != لاشيء) { أضف(أسئلة، س); أضف(مستعملة، ي) }
            وإلا { اتجاه = اتجاه + ١ }
        }
        محاولة = محاولة + ١
    }
    ارجع {"وُجد": طول(أسئلة) > ٠، "أسئلة": أسئلة، "سبب": ""}
}

# عرض الاختبار نصًّا
صدّر دالة اعرض_اختبارا(أسئلة) {
    متغير س = ["اختبار من النص (" + نص(طول(أسئلة)) + " أسئلة). أجب بحروف الخيارات مثل: ١ ب، ٢ أ، ٣ ج" + حرف(١٠)]
    من_أجل (ي في مدى(طول(أسئلة))) {
        متغير ق = أسئلة[ي]
        أضف(س، نص(ي + ١) + ") " + ق["سؤال"])
        من_أجل (ك في مدى(طول(ق["خيارات"]))) { أضف(س، "   " + _حروف_الخيارات[ك] + ") " + ق["خيارات"][ك]) }
        أضف(س، "")
    }
    ارجع اربط(س، حرف(١٠))
}

# أسئلة وأجوبة بلا خيارات
صدّر دالة أسئلة_وأجوبة(أسئلة) {
    متغير س = []
    من_أجل (ي في مدى(طول(أسئلة))) {
        متغير ق = أسئلة[ي]
        أضف(س، "س" + نص(ي + ١) + ": " + ق["سؤال"])
        أضف(س، "ج: " + ق["خيارات"][ق["صحيح"]])
        أضف(س، "المصدر: «" + ق["مصدر"] + "»")
        أضف(س، "")
    }
    ارجع اربط(س، حرف(١٠))
}

# ——— التصحيح ———

# يحلّل جوابًا مكتوبًا إلى قائمة اختيارات (٠..٣ أو -١ بلا جواب)؛ يعيد لاشيء إن لم يكن الكلام أجوبة
صدّر دالة حلّل_إجابات(كلام، عدد_الأسئلة) {
    متغير كلمات = []
    من_أجل (ك في افصل(كلام، " ")) {
        من_أجل (ك٢ في افصل(ك، "،")) {
            من_أجل (ك٣ في افصل(ك٢، ",")) {
                متغير ق = _قصّ_علامات(ك٣)
                إذا (ق != "") { أضف(كلمات، ق) }
            }
        }
    }
    إذا (طول(كلمات) == ٠ أو طول(كلمات) > عدد_الأسئلة * ٣) { ارجع لاشيء }
    متغير إجابات = []
    من_أجل (ي في مدى(عدد_الأسئلة)) { أضف(إجابات، -١) }
    متغير متوقع = ٠
    متغير رقم_معلّق = -١
    من_أجل (ك في كلمات) {
        متغير ح = ك
        متغير مع_رقم = -١
        # شكل «١ب» أو «١-ب» أو «١)ب»
        متغير أرقام_ك = ""
        متغير بقية = ""
        من_أجل (ج في ك) {
            إذا (بقية == "" و يحوي("٠١٢٣٤٥٦٧٨٩0123456789"، ج)) { أرقام_ك = أرقام_ك + ج }
            وإلا إذا (يحوي("-)):"، ج) و بقية == "") { بقية = "" }
            وإلا { بقية = بقية + ج }
        }
        متغير حرف_إجابة = -١
        من_أجل (ي في مدى(٤)) { إذا (بقية == _حروف_الخيارات[ي] أو بقية == _حروف_لاتينية[ي] أو بقية == ن.كبّر(_حروف_لاتينية[ي])) { حرف_إجابة = ي } }
        إذا (أرقام_ك != "" و بقية == "") { رقم_معلّق = _قيمة(أرقام_ك) - ١ }
        وإلا إذا (حرف_إجابة < ٠) { ارجع لاشيء }
        وإلا {
            متغير موضع = متوقع
            إذا (أرقام_ك != "") { موضع = _قيمة(أرقام_ك) - ١ }
            وإلا إذا (رقم_معلّق >= ٠) { موضع = رقم_معلّق; رقم_معلّق = -١ }
            إذا (موضع < ٠ أو موضع >= عدد_الأسئلة) { ارجع لاشيء }
            إجابات[موضع] = حرف_إجابة
            متوقع = موضع + ١
        }
    }
    ارجع إجابات
}

# تصحيح: لكل سؤال الحكم والصحيح ومصدره، وكل فخ مع سببه وكيف يُحتاط منه
صدّر دالة صحّح(أسئلة، إجابات) {
    متغير صحيحة = ٠
    متغير س = []
    من_أجل (ي في مدى(طول(أسئلة))) {
        متغير ق = أسئلة[ي]
        متغير ج = إجابات[ي]
        متغير ن٢ = نص(ي + ١) + ") "
        إذا (ج == ق["صحيح"]) {
            صحيحة = صحيحة + ١
            أضف(س، ن٢ + "✓ صحيحة: " + _حروف_الخيارات[ق["صحيح"]] + ") " + ق["خيارات"][ق["صحيح"]])
        } وإلا {
            متغير مختار = "لم تجب"
            إذا (ج >= ٠ و ج < طول(ق["خيارات"])) { مختار = "اخترتَ " + _حروف_الخيارات[ج] + ") " + ق["خيارات"][ج] }
            أضف(س، ن٢ + "✗ " + مختار + ". الصحيح: " + _حروف_الخيارات[ق["صحيح"]] + ") " + ق["خيارات"][ق["صحيح"]])
        }
        أضف(س، "   في النص: «" + ق["مصدر"] + "»")
        من_أجل (ك في مدى(طول(ق["خيارات"]))) {
            إذا (ك != ق["صحيح"]) { أضف(س، "   " + _حروف_الخيارات[ك] + ") " + ق["أسباب"][ك]) }
        }
        إذا (ج != ق["صحيح"]) {
            أضف(س، "   الفخ: " + ق["فخ"])
            أضف(س، "   الاحتياط: " + ق["احتياط"])
        }
        أضف(س، "")
    }
    متغير خلاصة = "نتيجتك: " + نص(صحيحة) + " من " + نص(طول(أسئلة))
    ارجع {"درجة": صحيحة، "من": طول(أسئلة)، "نص": خلاصة + حرف(١٠) + حرف(١٠) + اربط(س، حرف(١٠))}
}

# ——— فهم الطلب ———

دالة _بداية_كلمة(كلمات، جذور) {
    من_أجل (ك في كلمات) {
        من_أجل (ج في جذور) {
            إذا (طول(ك) >= طول(ج) و ك[٠:طول(ج)] == ج) { ارجع صحيح }
        }
    }
    ارجع خطأ
}

# يفصل التعليمة عن النص: بسطر أول قصير، أو بنقطتين، أو (بلا فاصل) أول اثنتي عشرة كلمة تعليمة والباقي نص
دالة _افصل(طلب) {
    متغير سطور = افصل(طلب، حرف(١٠))
    إذا (طول(سطور) >= ٢ و طول(سطور[٠]) < ١٢٠) {
        متغير بقية = []
        من_أجل (ي في مدى(١، طول(سطور))) { أضف(بقية، سطور[ي]) }
        ارجع {"تعليمة": سطور[٠]، "نص": ن.قصّ(اربط(بقية، حرف(١٠)))}
    }
    متغير ي = موضع(طلب، ":")
    إذا (ي > ٠ و ي < ١٢٠) { ارجع {"تعليمة": طلب[٠:ي]، "نص": ن.قصّ(طلب[ي + ١:طول(طلب)])} }
    متغير ك = افصل(طلب، " ")
    متغير أول = []
    من_أجل (ي في مدى(طول(ك))) { إذا (ي < ١٢) { أضف(أول، ك[ي]) } }
    ارجع {"تعليمة": اربط(أول، " ")، "نص": طلب}
}

دالة _نية(تعليمة) {
    متغير ك = []
    من_أجل (و٢ في افصل(_طبّع(تعليمة)، " ")) { إذا (و٢ != "") {
        متغير ق٣ = _قصّ_علامات(و٢)
        أضف(ك، ق٣)
        إذا (طول(ق٣) > ٣ و ق٣[٠] == "و") { أضف(ك، ق٣[١:طول(ق٣)]) }
    } }
    إذا (_بداية_كلمة(ك، ["اختبر"، "امتحن"]) أو (_بداية_كلمة(ك، ["اسئل"]) و ليس _بداية_كلمة(ك، ["اجوب"]))) { ارجع "اختبار" }
    إذا (_بداية_كلمة(ك، ["اجوب"]) أو (_بداية_كلمة(ك، ["سوال"]) و _بداية_كلمة(ك، ["جواب"]))) { ارجع "أسئلة_وأجوبة" }
    إذا (_بداية_كلمة(ك، ["لخص"، "تلخيص"، "خلاصه"])) { ارجع "تلخيص" }
    إذا (_بداية_كلمة(ك، ["اختصر"، "اختصار"])) { ارجع "اختصار" }
    إذا (_بداية_كلمة(ك، ["نقاط"، "نقطي"])) { ارجع "نقاط" }
    ارجع ""
}

# نقاط: جمل التلخيص نفسها مسرودة
دالة _نقاط(ملخص) {
    متغير س = []
    من_أجل (ج في ملخص["جمل"]) { أضف(س، "• " + ج["نص"]) }
    ارجع اربط(س، حرف(١٠))
}

# يتناول طلب دراسة نص (أو جوابًا عن اختبار قائم)؛ لاشيء إن لم يكن طلبًا من هذا الباب
# ط: {طلب، آخر}؛ يعيد نتيجة بالصورة المعتادة أو لاشيء
صدّر دالة تعامل(ط) {
    متغير طلب = ط["طلب"]
    متغير آخر = ط["آخر"]
    إذا (يحوي(آخر، "اختبار") و طول(آخر["اختبار"]) > ٠) {
        متغير ج = حلّل_إجابات(طلب، طول(آخر["اختبار"]))
        إذا (ج != لاشيء) {
            متغير ر = صحّح(آخر["اختبار"]، ج)
            ارجع {"نوع": "تصحيح_اختبار"، "ثقة": ١٠٠، "لغة": ""، "خطة": [{"محرك": "دراسة"، "حالة": "نُفّذ"، "تفصيل": نص(ر["درجة"]) + "/" + نص(ر["من"])}]، "نتائج": {"تصحيح": {"درجة": ر["درجة"]، "من": ر["من"]}}، "ذكريات": []، "بادئة": ""، "رد": ر["نص"]}
        }
    }
    متغير ف = _افصل(طلب)
    متغير غرض = _نية(ف["تعليمة"])
    إذا (غرض == "" أو طول(ف["نص"]) < ٨٠) { ارجع لاشيء }
    متغير النص_ = ف["نص"]
    إذا (غرض == "اختبار" أو غرض == "أسئلة_وأجوبة") {
        متغير ت = اختبار(النص_، ٦)
        إذا (ليس ت["وُجد"]) {
            ارجع {"نوع": "دراسة_نص"، "ثقة": ١٠٠، "لغة": ""، "خطة": [{"محرك": "دراسة"، "حالة": "نُفّذ"، "تفصيل": "تعذّر"}]، "نتائج": {}، "ذكريات": []، "بادئة": ""، "رد": "لم أستطع بناء أسئلة موثوقة من هذا النص: " + ت["سبب"] + "."}
        }
        إذا (غرض == "اختبار") {
            ارجع {"نوع": "اختبار"، "ثقة": ١٠٠، "لغة": ""، "خطة": [{"محرك": "دراسة"، "حالة": "نُفّذ"، "تفصيل": نص(طول(ت["أسئلة"])) + " أسئلة"}]، "نتائج": {"اختبار": ت["أسئلة"]}، "ذكريات": []، "بادئة": ""، "رد": اعرض_اختبارا(ت["أسئلة"])}
        }
        ارجع {"نوع": "أسئلة_وأجوبة"، "ثقة": ١٠٠، "لغة": ""، "خطة": [{"محرك": "دراسة"، "حالة": "نُفّذ"، "تفصيل": نص(طول(ت["أسئلة"])) + " سؤالًا"}]، "نتائج": {}، "ذكريات": []، "بادئة": ""، "رد": أسئلة_وأجوبة(ت["أسئلة"])}
    }
    # تلخيص واختصار ونقاط: نسبة من طول النص
    متغير نسبة = ٤٠ / ١٠٠
    إذا (غرض == "اختصار") { نسبة = ٢٥ / ١٠٠ }
    متغير حد = طول(النص_) * نسبة
    إذا (حد < ١٥٠) { حد = ١٥٠ }
    متغير م = ل.لخّص([{"مصدر": "النص"، "نص": النص_}]، ""، حد)
    إذا (ليس م["وُجد"]) { ارجع لاشيء }
    متغير رد = م["نص"]
    إذا (غرض == "نقاط") { رد = _نقاط(م) }
    ارجع {"نوع": غرض، "ثقة": ١٠٠، "لغة": ""، "خطة": [{"محرك": "تلخيص"، "حالة": "نُفّذ"، "تفصيل": نص(طول(م["جمل"])) + " جملة"}]، "نتائج": {"ملخص": {"نص": م["نص"]}}، "ذكريات": []، "بادئة": ""، "رد": رد}
}
