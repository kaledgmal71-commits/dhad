# ضاد/نواة_دليل — دليل ضاد داخل نواة: مقاطع نثرية من الدليل والدروس والشروحات والمعجم، يُجاب منها عن أسئلة اللغة
# بنصها الفعلي لا بعناوين فقط. ثلاثة مستويات للشرح: بسيط (جملتان ومثال)، عادي (المقطع الأوفق)، معمّق (المقطع وما يليه من صفحته).
# لا يختلق جوابًا: ما لا يطابق جذرًا من الطلب في نص المقطع لا يُعرض.
# بنية الدليل: {مقاطع: [{معرف، عنوان، رابط، نص، شيفرة}]، فهرس: فهرس الاسترجاع}

متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ف = استورد("ضاد/نواة_ملف")

# جذع الكلمة: ما بعد نزع البادئة (ف.جذوع) ثم لواحق الجمع والتأنيث والضمير حتى يلتقي «حلقة» و«الحلقات»
متغير _لواحق = ["ات"، "ون"، "ين"، "ان"، "ها"، "هم"، "ه"، "ي"]
دالة _جذع(ك) {
    من_أجل (ل في _لواحق) {
        إذا (طول(ك) >= طول(ل) + ٣ و اقتطع(ك، طول(ك) - طول(ل)) == ل) { ارجع اقتطع(ك، ٠، طول(ك) - طول(ل)) }
    }
    ارجع ك
}

# جذوع نص بلا تكرار
دالة _جذوع(نص_) {
    متغير خرج = []
    من_أجل (ك في ف.جذوع(نص_)) {
        متغير ج = _جذع(ك)
        إذا (ليس يحوي(خرج، ج)) { أضف(خرج، ج) }
    }
    ارجع خرج
}

# يبني الدليل من مقاطعه (يُستدعى وقت بناء الموقع لا في المتصفح): لكل مقطع جذوع نصه وجذوع عنوانه، وتكرار كل جذع في المقاطع
صدّر دالة ابنِ(مقاطع) {
    متغير تكرار = {}
    من_أجل (م في مقاطع) {
        م["جذوع"] = _جذوع(م["نص"] + " " + م["شيفرة"])
        م["جذوع_عنوان"] = _جذوع(م["عنوان"])
        متغير كلها = []
        من_أجل (ج في م["جذوع"]) { أضف(كلها، ج) }
        من_أجل (ج في م["جذوع_عنوان"]) { إذا (ليس يحوي(كلها، ج)) { أضف(كلها، ج) } }
        من_أجل (ج في كلها) {
            إذا (يحوي(تكرار، ج)) { تكرار[ج] = تكرار[ج] + ١ } وإلا { تكرار[ج] = ١ }
        }
    }
    ارجع {"مقاطع": مقاطع، "تكرار": تكرار}
}

متغير _بسيط = ["بسط"، "ببساطه"، "للمبتدئ"، "سهل"، "مبسط"، "اسهل"]
متغير _معمق = ["عمق"، "تفصيل"، "اطل"، "اطول"، "توسع"، "اسهاب"، "اكثر تفصيل"، "اشرح اكثر"]

# مستوى الشرح المطلوب في الطلب: "بسيط" أو "معمق" أو "" (عادي)
صدّر دالة مستوى(طلب) {
    متغير س = ر.طبّع(طلب)
    من_أجل (ك في _بسيط) { إذا (يحوي(س، ك)) { ارجع "بسيط" } }
    من_أجل (ك في _معمق) { إذا (يحوي(س، ك)) { ارجع "معمق" } }
    ارجع ""
}

# أول جملتين من النص
دالة _جملتان(نص_) {
    متغير عدّ = ٠
    متغير خرج = ""
    من_أجل (ح في نص_) {
        خرج = خرج + ح
        إذا (ح == "." أو ح == "؟" أو ح == "!") {
            عدّ = عدّ + ١
            إذا (عدّ >= ٢) { ارجع خرج }
        }
    }
    ارجع خرج
}

دالة _مقطع_بمعرفه(دليل، معرف) {
    من_أجل (م في دليل["مقاطع"]) { إذا (م["معرف"] == معرف) { ارجع م } }
    ارجع ""
}

# أفضل المقاطع للطلب بالترتيب (حتى «حد»): مجموع أوزان الجذور المطابقة (ندرة الجذر في الدليل، ومضاعفة إن ورد في العنوان)
# لا يُقبل مقطع يطابق أقل من نصف جذور الطلب: الطلب حينئذ عن شيء ليس في الدليل
دالة _أفضل_عدة(دليل، طلب، حد) {
    متغير جذور = _جذوع(طلب)
    إذا (طول(جذور) == ٠) { ارجع [] }
    متغير ك = طول(دليل["مقاطع"])
    متغير قائمة = []
    متغير ترتيب = ٠
    من_أجل (م في دليل["مقاطع"]) {
        متغير درجة = ٠
        متغير مطابق = ٠
        من_أجل (ج في جذور) {
            متغير وزن = ٠
            إذا (يحوي(دليل["تكرار"]، ج)) { وزن = ر.لوغاريتم(١ + ك / دليل["تكرار"][ج]) }
            إذا (يحوي(م["جذوع"]، ج) أو يحوي(م["جذوع_عنوان"]، ج)) { مطابق = مطابق + ١ }
            إذا (يحوي(م["جذوع"]، ج)) { درجة = درجة + وزن }
            إذا (يحوي(م["جذوع_عنوان"]، ج)) { درجة = درجة + وزن * ١.٥ }
        }
        إذا (مطابق * ٢ >= طول(جذور) و درجة > ١.٥) { أضف(قائمة، [ترتيب، درجة]) }
        ترتيب = ترتيب + ١
    }
    متغير مرتبة = رتب(قائمة، دالة(أ، ب) {
        إذا (أ[١] != ب[١]) { ارجع ب[١] - أ[١] }
        ارجع أ[٠] - ب[٠]
    })
    متغير خرج = []
    من_أجل (ي في مدى(طول(مرتبة))) {
        إذا (ي < حد) { أضف(خرج، دليل["مقاطع"][مرتبة[ي][٠]]) }
    }
    ارجع خرج
}

دالة _أفضل(دليل، طلب) {
    متغير ق = _أفضل_عدة(دليل، طلب، ١)
    إذا (طول(ق) == ٠) { ارجع "" }
    ارجع ق[٠]
}

# المقاطع التي تلي المقطع في صفحته (حتى «حد» مقطعًا)
دالة _التالية(دليل، م، حد) {
    متغير خرج = []
    متغير وجدناه = خطأ
    من_أجل (ك في دليل["مقاطع"]) {
        إذا (وجدناه و ك["رابط"] == م["رابط"] و طول(خرج) < حد) { أضف(خرج، ك) }
        إذا (ك["معرف"] == م["معرف"]) { وجدناه = صحيح }
    }
    # آخر مقطع في صفحته: يُتمَّم بما قبله من الصفحة نفسها
    إذا (طول(خرج) == ٠) {
        متغير سابقة = []
        من_أجل (ك في دليل["مقاطع"]) {
            إذا (ك["معرف"] == م["معرف"]) { ارجع سابقة }
            إذا (ك["رابط"] == م["رابط"]) {
                أضف(سابقة، ك)
                إذا (طول(سابقة) > حد) { احذف(سابقة، ٠) }
            }
        }
    }
    ارجع خرج
}

# يجيب عن الطلب من الدليل: {وُجد، مستوى، معرف، عنوان، رابط، نص، شيفرة، رد}
# الطلب بلا كلمات مستوى الشرح (ببساطة، بالتفصيل…) حتى لا تُحسب موضوعًا
دالة _بلا_المستوى(طلب) {
    متغير بقي = []
    من_أجل (ك في افصل(طلب، " ")) {
        متغير س = ر.طبّع(ك)
        متغير مستوى_كلمة = خطأ
        من_أجل (ل في _بسيط) { إذا (س != "" و يحوي(س، ل)) { مستوى_كلمة = صحيح } }
        من_أجل (ل في _معمق) { إذا (س != "" و يحوي(س، ل)) { مستوى_كلمة = صحيح } }
        إذا (ليس مستوى_كلمة) { أضف(بقي، ك) }
    }
    ارجع اربط(بقي، " ")
}

صدّر دالة أجب(دليل، طلب، مستوى_ = "") {
    متغير ل = مستوى_
    إذا (ل == "") { ل = مستوى(طلب) }
    متغير م = _أفضل(دليل، _بلا_المستوى(طلب))
    إذا (م == "") { ارجع {"وُجد": خطأ، "مستوى": ل، "رد": ""} }
    متغير نص_ = م["نص"]
    متغير شيفرة = م["شيفرة"]
    إذا (ل == "بسيط") {
        نص_ = _جملتان(م["نص"])
    } وإلا إذا (ل == "معمق") {
        متغير مضاف = ٠
        من_أجل (ك في _التالية(دليل، م، ٢)) {
            نص_ = نص_ + حرف(١٠) + حرف(١٠) + ك["نص"]
            إذا (شيفرة == "") { شيفرة = ك["شيفرة"] }
            مضاف = مضاف + ١
        }
        # صفحة من مقطع واحد: يُتمَّم بما يتصل بالموضوع من صفحات أخرى
        إذا (مضاف == ٠) {
            من_أجل (ك في _أفضل_عدة(دليل، _بلا_المستوى(طلب)، ٤)) {
                إذا (ك["رابط"] != م["رابط"] و مضاف < ٢) {
                    نص_ = نص_ + حرف(١٠) + حرف(١٠) + "وفي " + ك["عنوان"] + ": " + ك["نص"]
                    مضاف = مضاف + ١
                }
            }
        }
    }
    متغير رد_ = م["عنوان"] + حرف(١٠) + حرف(١٠) + نص_
    إذا (شيفرة != "") { رد_ = رد_ + حرف(١٠) + حرف(١٠) + "مثال:" + حرف(١٠) + شيفرة }
    رد_ = رد_ + حرف(١٠) + حرف(١٠) + "المصدر: " + م["رابط"]
    ارجع {"وُجد": صحيح، "مستوى": ل، "معرف": م["معرف"]، "عنوان": م["عنوان"]، "رابط": م["رابط"]، "نص": نص_، "شيفرة": شيفرة، "رد": رد_}
}
