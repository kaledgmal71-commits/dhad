# ضاد/نواة_مهام — محلل المهام: يفهم نوع الطلب ويحدّد لغته ومتطلباته قبل أي تنفيذ.
# قواعده شفافة: لكل نوع دلائل موزونة، ويعيد المحلل الأدلة التي استند إليها مع نسبة الثقة.
# الدلائل مكتوبة بصورتها المطبَّعة (تطبيع ضاد/نصوص: ألف واحدة، ياء، هاء، بلا تشكيل).

متغير ن = استورد("ضاد/نصوص")
متغير ع = استورد("ضاد/نواة_عقد")

# ترتيب الأنواع يحسم التعادل
متغير _أنواع = [
    ["كتابة_برنامج"، [["ابن لي"، ٣]، ["ابن لنا"، ٣]، ["ابن تطبيق"، ٣]، ["ابن موقع"، ٣]، ["ابن برنامج"، ٣]، ["ابن لعبه"، ٣]، ["ابن صفحه"، ٣]، ["اكتب"، ٢]، ["انشي"، ٣]، ["صمم"، ٣]، ["برمج"، ٣]، ["ولد لي"، ٢]، ["ولد برنامج"، ٢]، ["ولد كود"، ٢]، ["ولد شيفره"، ٢]، ["اصنع"، ٣]، ["اريد تطبيق"، ٢]، ["تطبيق"، ٢]، ["برنامج"، ٢]، ["لعبه"، ٢]، ["موقع"، ٢]، ["صفحه"، ١]، ["ادا"، ١]، ["حاسبه"، ٢]، ["دال"، ١]]]،
    ["إصلاح_خطأ"، [["خطا"، ٤]، ["اصلح"، ٤]، ["صحح"، ٤]، ["لا يعمل"، ٤]، ["لا تعمل"، ٤]، ["مشكل"، ٢]، ["تعطل"، ٣]، ["استثناء"، ٣]، ["لماذا لا"، ٣]، ["error"، ٤]، ["bug"، ٤]، ["رساله"، ١]، ["السطر"، ٢]]]،
    ["شرح_مفهوم"، [["اشرح"، ٤]، ["وضح"، ٤]، ["ما هو"، ٣]، ["ما هي"، ٣]، ["معني"، ٣]، ["كيف يعمل"، ٣]، ["كيف تعمل"، ٣]، ["علمني"، ٤]، ["تعلم"، ٢]، ["الفرق بين"، ٤]، ["مفهوم"، ٢]، ["ماذا يعني"، ٤]]]،
    ["بحث_معرفة"، [["ابحث"، ٤]، ["اين"، ٢]، ["جد"، ٣]، ["اعرض"، ٢]، ["ارني"، ٢]، ["معجم"، ٢]، ["دليل"، ٢]، ["مكتبه"، ٢]، ["مصدر"، ٢]، ["مثال"، ٢]]]،
    ["تحويل_صياغة"، [["حول"، ٤]، ["ترجم"، ٤]، ["بالانجليزيه"، ٤]، ["بالعربيه"، ٢]، ["صياغه"، ٣]، ["convert"، ٤]، ["english"، ٣]]]،
    ["تقييم_كود"، [["قيم"، ٣]، ["راجع"، ٤]، ["حلل"، ٣]، ["افحص"، ٣]، ["اختبر"، ٣]، ["حسن"، ٣]، ["نظف"، ٣]، ["اداء"، ٢]، ["اسرع"، ٢]]]
]

متغير _محركات_لازمة = {
    "كتابة_برنامج": ["استرجاع"، "توليف_شيفرة"، "منفذ_معزول"]،
    "إصلاح_خطأ": ["محلل_أخطاء"، "استرجاع"، "منفذ_معزول"]،
    "شرح_مفهوم": ["استرجاع"]،
    "بحث_معرفة": ["استرجاع"]،
    "تحويل_صياغة": ["محول_صياغة"]،
    "تقييم_كود": ["محلل_شيفرة"، "منفذ_معزول"]،
    "محادثة": []
}

# اللغات المعروفة بأسماء مطبَّعة (الاسم الظاهر في الناتج ← الدلائل)
متغير _لغات = [
    ["ضاد"، ["ضاد"، "dhad"]]،
    ["بايثون"، ["بايثون"، "python"]]،
    ["جافاسكربت"، ["جافاسكربت"، "javascript"، "js"]]،
    ["جافا"، ["جافا"، "java"]]،
    ["سي++"، ["c++"، "cpp"]]،
    ["روبي"، ["روبي"، "ruby"]]،
    ["جو"، ["golang"]]
]

# يقطّع النص المطبَّع إلى كلمات (حروف عربية ولاتينية وأرقام و _ و + فقط)
دالة _كلمات(س) {
    متغير خ = ن.طبّع_للبحث(س)
    متغير ناتج = []
    متغير حالي = ""
    من_أجل (ح في خ) {
        إذا (ن.هل_حرف_عربي(ح) أو ن.هل_حرف_لاتيني(ح) أو ن.هل_رقم(ح) أو ح == "_" أو ح == "+") {
            حالي = حالي + ح
        } وإلا {
            إذا (حالي != "") { أضف(ناتج، حالي) }
            حالي = ""
        }
    }
    إذا (حالي != "") { أضف(ناتج، حالي) }
    ارجع ناتج
}

# صور الكلمة بعد نزع السوابق الشائعة (و ف ب ل ك وال)
دالة _صور(ك) {
    متغير صور = [ك]
    متغير ق = ك
    إذا (طول(ق) > ٣ و ن.يبدأ_ب(ق، "ال")) { أضف(صور، اقتطع(ق، ٢)) }
    إذا (طول(ق) > ٣ و (ق[٠] == "و" أو ق[٠] == "ف" أو ق[٠] == "ب" أو ق[٠] == "ل" أو ق[٠] == "ك")) {
        متغير ب = اقتطع(ق، ١)
        أضف(صور، ب)
        إذا (طول(ب) > ٣ و ن.يبدأ_ب(ب، "ال")) { أضف(صور، اقتطع(ب، ٢)) }
    }
    ارجع صور
}

دالة _تطابق_كلمة(كلمات، دليل) {
    من_أجل (ك في كلمات) {
        من_أجل (ص في _صور(ك)) {
            إذا (ص == دليل أو (طول(دليل) >= ٣ و ن.يبدأ_ب(ص، دليل))) { ارجع صحيح }
        }
    }
    ارجع خطأ
}

دالة _تطابق(كلمات، نص_مطبّع، دليل) {
    إذا (يحوي(دليل، " ")) { ارجع يحوي(" " + نص_مطبّع + " "، " " + دليل + " ") }
    ارجع _تطابق_كلمة(كلمات، دليل)
}

دالة _نص_الكلمات(كلمات) { ارجع اربط(كلمات، " ") }

دالة _لغة_الطلب(كلمات) {
    متغير وجدت = []
    من_أجل ([اسم، دلائل] في _لغات) {
        من_أجل (د في دلائل) {
            إذا (يحوي(كلمات، د) و ليس يحوي(وجدت، اسم)) { أضف(وجدت، اسم) }
        }
    }
    ارجع وجدت
}

دالة _فيه_كود(س) {
    ارجع يحوي(س، "اطبع(") أو يحوي(س، "دالة ") أو يحوي(س، "متغير ") أو يحوي(س، "طالما (") أو يحوي(س، "إذا (") أو يحوي(س، "من_أجل")
}

صدّر دالة حلّل(طلب) {
    متغير كلمات = _كلمات(طلب)
    متغير نص_ك = _نص_الكلمات(كلمات)
    متغير نتائج = []
    من_أجل ([نوع_المهمة، دلائل] في _أنواع) {
        متغير مجموع = ٠
        متغير أدلة = []
        من_أجل ([د، وزن] في دلائل) {
            إذا (_تطابق(كلمات، نص_ك، د)) {
                مجموع = مجموع + وزن
                أضف(أدلة، د)
            }
        }
        أضف(نتائج، [نوع_المهمة، مجموع، أدلة])
    }
    متغير أعلى = ["محادثة"، ٠، []]
    متغير ثاني = ٠
    من_أجل (ر في نتائج) {
        إذا (ر[١] > أعلى[١]) {
            ثاني = أعلى[١]
            أعلى = ر
        } وإلا إذا (ر[١] > ثاني) {
            ثاني = ر[١]
        }
    }
    متغير نوع_نهائي = أعلى[٠]
    متغير ثقة = ٠
    إذا (أعلى[١] < ٢) {
        نوع_نهائي = "محادثة"
        ثقة = ١٠٠
        أعلى = ["محادثة"، ٠، []]
    } وإلا {
        ثقة = أرضية((أعلى[١] - ثاني) * ١٠٠ / أعلى[١])
    }
    متغير مذكورة = _لغة_الطلب(كلمات)
    متغير لغة = "ضاد"
    إذا (طول(مذكورة) > ٠) { لغة = مذكورة[٠] }
    ارجع {
        "نوع": نوع_نهائي،
        "ثقة": ثقة،
        "لغة": لغة،
        "لغة_مذكورة": طول(مذكورة) > ٠،
        "فيه_كود": _فيه_كود(طلب)،
        "محركات_لازمة": _محركات_لازمة[نوع_نهائي]،
        "أدلة": أعلى[٢]،
        "كلمات": كلمات
    }
}

# يعيد الدلائل التي ليست بصورتها المطبَّعة (يجب أن تكون القائمة فارغة)
صدّر دالة دلائل_غير_مطبّعة() {
    متغير سيئة = []
    من_أجل ([ت، دلائل] في _أنواع) {
        من_أجل ([د، وز] في دلائل) {
            إذا (ن.طبّع_للبحث(د) != د) { أضف(سيئة، د) }
        }
    }
    من_أجل ([اسم، دلائل] في _لغات) {
        من_أجل (د في دلائل) {
            إذا (ن.طبّع_للبحث(د) != د) { أضف(سيئة، د) }
        }
    }
    ارجع سيئة
}

# يسجّل المحلل محركًا في سجل نواة
صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "محلل_المهام"،
        "يحدّد نوع الطلب ولغته والمحركات اللازمة لتنفيذه"،
        {"طلب": "نص"}،
        {"نوع": "نص"، "ثقة": "رقم"، "لغة": "نص"، "لغة_مذكورة": "قيمة منطقية"، "فيه_كود": "قيمة منطقية"، "محركات_لازمة": "قائمة"، "أدلة": "قائمة"، "كلمات": "قائمة"}،
        دالة(مدخل) { ارجع حلّل(مدخل["طلب"]) }
    ))
}
