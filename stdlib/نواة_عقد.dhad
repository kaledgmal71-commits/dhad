# ضاد/نواة_عقد — عقد المحركات وسجلّها: الأساس الذي تقوم عليه محركات نواة كلها.
# المحرك وحدة تعلن مدخلاتها ومخرجاتها وأنواعها؛ يتحقق السجل منها عند كل تشغيل ويترك أثرًا قابلًا للفحص.

متغير _محركات = {}
متغير _أنواع_معروفة = ["نص"، "رقم"، "قيمة منطقية"، "قائمة"، "خريطة"، "مجموعة"، "دالة"، "لاشيء"، "أي"]

دالة _تحقق_من_الحقول(مواصفة، قيمة، موضع، معرف) {
    إذا (نوع(قيمة) != "خريطة") {
        أطلق_خطأ("المحرك «" + معرف + "»: " + موضع + " يجب أن تكون خريطة لا " + نوع(قيمة))
    }
    من_أجل (اسم في مفاتيح(مواصفة)) {
        إذا (ليس يحوي(قيمة، اسم)) {
            أطلق_خطأ("المحرك «" + معرف + "»: ينقص الحقل «" + اسم + "» في " + موضع)
        }
        متغير مطلوب = مواصفة[اسم]
        إذا (مطلوب != "أي" و نوع(قيمة[اسم]) != مطلوب) {
            أطلق_خطأ("المحرك «" + معرف + "»: الحقل «" + اسم + "» في " + موضع + " يجب أن يكون " + مطلوب + " لا " + نوع(قيمة[اسم]))
        }
    }
}

دالة _تحقق_من_المواصفة(مواصفة، موضع، معرف) {
    إذا (نوع(مواصفة) != "خريطة") {
        أطلق_خطأ("المحرك «" + معرف + "»: " + موضع + " يجب أن تكون خريطة (اسم الحقل ← نوعه)")
    }
    من_أجل (اسم في مفاتيح(مواصفة)) {
        إذا (ليس يحوي(_أنواع_معروفة، مواصفة[اسم])) {
            أطلق_خطأ("المحرك «" + معرف + "»: النوع «" + نص(مواصفة[اسم]) + "» غير معروف في " + موضع)
        }
    }
}

# ينشئ محركًا بعد التحقق من اكتمال تعريفه
صدّر دالة محرك(معرف، وصف، مدخلات، مخرجات، تشغيل) {
    إذا (نوع(معرف) != "نص" أو طول(معرف) == ٠) { أطلق_خطأ("معرّف المحرك يجب أن يكون نصًا غير فارغ") }
    إذا (نوع(وصف) != "نص") { أطلق_خطأ("المحرك «" + معرف + "»: الوصف يجب أن يكون نصًا") }
    _تحقق_من_المواصفة(مدخلات، "المدخلات"، معرف)
    _تحقق_من_المواصفة(مخرجات، "المخرجات"، معرف)
    إذا (نوع(تشغيل) != "دالة") { أطلق_خطأ("المحرك «" + معرف + "»: التشغيل يجب أن يكون دالة") }
    ارجع {"معرف": معرف، "وصف": وصف، "مدخلات": مدخلات، "مخرجات": مخرجات، "تشغيل": تشغيل}
}

صدّر دالة سجّل(م) {
    إذا (نوع(م) != "خريطة" أو ليس يحوي(م، "معرف") أو ليس يحوي(م، "تشغيل")) {
        أطلق_خطأ("السجل يقبل ما أنشأته الدالة محرك() فقط")
    }
    إذا (يحوي(_محركات، م["معرف"])) { أطلق_خطأ("المحرك «" + م["معرف"] + "» مسجَّل من قبل") }
    _محركات[م["معرف"]] = م
    ارجع م["معرف"]
}

صدّر دالة المحركات() {
    ارجع رتب(مفاتيح(_محركات))
}

صدّر دالة وصف_المحرك(معرف) {
    إذا (ليس يحوي(_محركات، معرف)) { أطلق_خطأ("لا محرك مسجَّلًا باسم «" + معرف + "». الموجود: " + اربط(المحركات()، "، ")) }
    متغير م = _محركات[معرف]
    ارجع {"معرف": م["معرف"]، "وصف": م["وصف"]، "مدخلات": م["مدخلات"]، "مخرجات": م["مخرجات"]}
}

# يشغّل محركًا مسجَّلًا: يتحقق من المدخل، ينفّذ، يتحقق من المخرج، ويعيد النتيجة مع أثرها
صدّر دالة شغّل(معرف، مدخل) {
    إذا (ليس يحوي(_محركات، معرف)) { أطلق_خطأ("لا محرك مسجَّلًا باسم «" + معرف + "». الموجود: " + اربط(المحركات()، "، ")) }
    متغير م = _محركات[معرف]
    _تحقق_من_الحقول(م["مدخلات"]، مدخل، "المدخل"، معرف)
    متغير خرج = م["تشغيل"](مدخل)
    _تحقق_من_الحقول(م["مخرجات"]، خرج، "المخرج"، معرف)
    ارجع {"نتيجة": خرج، "أثر": {"محرك": معرف، "حقول_المدخل": رتب(مفاتيح(مدخل))، "حقول_المخرج": رتب(مفاتيح(خرج))}}
}

# يفرّغ السجل (للاختبار وإعادة التهيئة)
صدّر دالة صفّر() {
    من_أجل (ك في مفاتيح(_محركات)) { احذف(_محركات، ك) }
    ارجع صحيح
}
