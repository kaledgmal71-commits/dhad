# ضاد/نواة_استيعاب — استيعاب المصادر الخارجية: تقطيع النصوص إلى مقاطع قابلة للفهرسة، وعقد الموصّلات (مكتبات وملفات).
# الموصّل وحدة تعلن اسمها ونوعها ودالة جلب تعيد مقاطع {عنوان، نص، مصدر}. لا موصّل يُسجَّل بلا دالة جلب حقيقية.
# حدّ معروف: قراءة PDF وDOCX (فك الضغط والبنية) لم تُبنَ بعد؛ المدخل هنا نص مستخرج.

متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ع = استورد("ضاد/نواة_عقد")

متغير _موصّلات = {}

# يقطّع نصًا إلى مقاطع بحدّ أقصى للأحرف، عند حدود الفقرات (سطر فارغ) ثم السطور ثم الحروف
# ويعيد قائمة نصوص. مع تراكب اختياري من آخر المقطع السابق (بالأحرف).
صدّر دالة قطّع(نص_، أقصى = ٦٠٠، تراكب = ٠) {
    إذا (نوع(نص_) != "نص") { أطلق_خطأ("الاستيعاب: النص نص") }
    إذا (نوع(أقصى) != "رقم" أو أقصى < ٢٠) { أطلق_خطأ("الاستيعاب: الحد الأقصى رقم لا يقل عن ٢٠") }
    إذا (نوع(تراكب) != "رقم" أو تراكب < ٠ أو تراكب >= أقصى) { أطلق_خطأ("الاستيعاب: التراكب أقل من الحد الأقصى وغير سالب") }
    متغير وحدات = []
    من_أجل (فقرة في افصل(نص_، حرف(١٠) + حرف(١٠))) {
        متغير ف = فقرة
        طالما (طول(ف) > أقصى) {
            متغير قطع = أقصى
            # نحاول القطع عند آخر سطر أو مسافة داخل الحد
            متغير ي = أقصى
            طالما (ي > أقصى / ٢ و قطع == أقصى) {
                إذا (ف[ي - ١] == حرف(١٠) أو ف[ي - ١] == " ") { قطع = ي }
                ي = ي - ١
            }
            أضف(وحدات، اقتطع(ف، ٠، قطع))
            ف = اقتطع(ف، قطع)
        }
        إذا (طول(ف) > ٠) { أضف(وحدات، ف) }
    }
    # دمج الوحدات المتجاورة ما دامت تسع في الحد
    متغير مقاطع = []
    متغير حالي = ""
    من_أجل (و_ في وحدات) {
        إذا (حالي == "") {
            حالي = و_
        } وإلا إذا (طول(حالي) + ٢ + طول(و_) <= أقصى) {
            حالي = حالي + حرف(١٠) + حرف(١٠) + و_
        } وإلا {
            أضف(مقاطع، حالي)
            حالي = و_
        }
    }
    إذا (حالي != "") { أضف(مقاطع، حالي) }
    إذا (تراكب > ٠) {
        متغير مع = []
        من_أجل (ي في مدى(طول(مقاطع))) {
            إذا (ي == ٠) {
                أضف(مع، مقاطع[ي])
            } وإلا {
                متغير س = مقاطع[ي - ١]
                متغير ذيل = س
                إذا (طول(س) > تراكب) { ذيل = اقتطع(س، طول(س) - تراكب) }
                أضف(مع، ذيل + " " + مقاطع[ي])
            }
        }
        ارجع مع
    }
    ارجع مقاطع
}

# يحوّل مصدرًا نصيًّا إلى وثائق فهرسة {معرف، عنوان، نص}: معرف = المصدر#رقم المقطع
صدّر دالة وثائق_من_نص(مصدر، عنوان، نص_، أقصى = ٦٠٠) {
    إذا (نوع(مصدر) != "نص" أو طول(مصدر) == ٠) { أطلق_خطأ("الاستيعاب: للمصدر اسم") }
    متغير خرج = []
    متغير ك = ٠
    من_أجل (م في قطّع(نص_، أقصى)) {
        ك = ك + ١
        أضف(خرج، {"معرف": مصدر + "#" + نص(ك)، "عنوان": عنوان، "نص": م})
    }
    ارجع خرج
}

# موصّل: {اسم، نوع (مكتبة|ملفات)، جلب: دالة(استعلام، حد) ← قائمة {عنوان، نص، مصدر}}
صدّر دالة سجّل_موصّلًا(اسم، نوع_الموصّل، جلب) {
    إذا (نوع(اسم) != "نص" أو طول(اسم) == ٠) { أطلق_خطأ("الموصّل: له اسم") }
    إذا (نوع_الموصّل != "مكتبة" و نوع_الموصّل != "ملفات") { أطلق_خطأ("الموصّل: النوع «مكتبة» أو «ملفات»") }
    إذا (نوع(جلب) != "دالة") { أطلق_خطأ("الموصّل «" + اسم + "»: لا يُسجَّل بلا دالة جلب") }
    إذا (يحوي(_موصّلات، اسم)) { أطلق_خطأ("الموصّل «" + اسم + "» مسجَّل من قبل") }
    _موصّلات[اسم] = {"اسم": اسم، "نوع": نوع_الموصّل، "جلب": جلب}
    ارجع اسم
}

صدّر دالة الموصّلات() {
    متغير خرج = []
    من_أجل (ك في رتب(مفاتيح(_موصّلات))) { أضف(خرج، {"اسم": ك، "نوع": _موصّلات[ك]["نوع"]}) }
    ارجع خرج
}

صدّر دالة افصل_موصّلًا(اسم) {
    إذا (ليس يحوي(_موصّلات، اسم)) { أطلق_خطأ("لا موصّل باسم «" + نص(اسم) + "»") }
    احذف(_موصّلات، اسم)
    ارجع صحيح
}

# يستعلم كل الموصّلات المربوطة (أو واحدًا باسمه) ويجمع المقاطع بأسماء مصادرها؛ فشل موصّل لا يُسقط البقية
صدّر دالة اجلب(استعلام، حد = ٥، اسم = "") {
    إذا (نوع(استعلام) != "نص") { أطلق_خطأ("الموصّل: الاستعلام نص") }
    إذا (اسم != "" و ليس يحوي(_موصّلات، اسم)) { أطلق_خطأ("لا موصّل باسم «" + اسم + "»") }
    متغير نتائج = []
    متغير أخطاء = []
    من_أجل (ك في رتب(مفاتيح(_موصّلات))) {
        إذا (اسم == "" أو اسم == ك) {
            حاول {
                متغير قائمة = _موصّلات[ك]["جلب"](استعلام، حد)
                إذا (نوع(قائمة) != "قائمة") { أطلق_خطأ("أعاد غير قائمة") }
                من_أجل (م في قائمة) { أضف(نتائج، {"موصّل": ك، "عنوان": م["عنوان"]، "نص": م["نص"]، "مصدر": م["مصدر"]}) }
            } التقط (خ) {
                أضف(أخطاء، {"موصّل": ك، "خطأ": نص(خ)})
            }
        }
    }
    ارجع {"نتائج": نتائج، "أخطاء": أخطاء}
}

صدّر دالة صفّر() {
    من_أجل (ك في مفاتيح(_موصّلات)) { احذف(_موصّلات، ك) }
    ارجع صحيح
}

صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "استيعاب"،
        "يقطّع نصًا إلى مقاطع بمعرفات قابلة للفهرسة"،
        {"مصدر": "نص"، "عنوان": "نص"، "نص": "نص"}،
        {"وثائق": "قائمة"}،
        دالة(مدخل) { ارجع {"وثائق": وثائق_من_نص(مدخل["مصدر"]، مدخل["عنوان"]، مدخل["نص"])} }
    ))
}
