# ضاد/نواة_مقابلة — محرك المقابلة النقدية: يحاذي نسختين كلمةً كلمة ويصنّف كل فرق (زيادة، سقط، رسم، تصحيف، تحريف، إبدال، قلب)
# ويولّد حواشي جهاز التحقيق. المحاذاة برمجة ديناميكية بتكلفة: تطابق ٠، تطابق بلا نقط ٠٫٥، إبدال كلمة تشبهها رسمًا ١،
# إبدال كلمة لا تشبهها ١٫٥ (فيُفضَّل سقط وزيادة على إبدالين لكلمتين غير متشابهتين)، زيادة أو سقط ١،
# وقلب كلمتين متجاورتين ١ (تُحسب عملية واحدة داخل المحاذاة نفسها لا فحصًا لاحقًا). تعادل التكاليف يُحسم بترتيب ثابت:
# تطابق/إبدال ثم قلب ثم سقط ثم زيادة، فالنتيجة حتمية.

متغير ر = استورد("ضاد/نواة_رسم")
متغير ن = استورد("ضاد/نصوص")

# تصنيف العلاقة بين قراءة الأصل وقراءة الشاهد (إحداهما قد تكون فارغة)
صدّر دالة صنّف(أصل، شاهد، رمز) {
    متغير أ = ن.أزل_التشكيل(قصّ(أصل))
    متغير ش = ن.أزل_التشكيل(قصّ(شاهد))
    إذا (طول(أ) == ٠ و طول(ش) > ٠) {
        ارجع {"نوع": "زيادة"، "تشابه": ٠، "حاشية": "في (" + رمز + "): زيادة «" + شاهد + "»."}
    }
    إذا (طول(أ) > ٠ و طول(ش) == ٠) {
        ارجع {"نوع": "سقط"، "تشابه": ٠، "حاشية": "«" + أصل + "»: سقط من (" + رمز + ")."}
    }
    إذا (ر.طبّع_للمقابلة(أ) == ر.طبّع_للمقابلة(ش)) {
        ارجع {"نوع": "رسم"، "تشابه": ٠.٩٥، "حاشية": "في (" + رمز + ") برسم: «" + شاهد + "»."}
    }
    إذا (ر.تطابق_بلا_نقط(أ، ش)) {
        ارجع {"نوع": "تصحيف"، "تشابه": ٠.٨٥،
            "حاشية": "في (" + رمز + "): «" + شاهد + "» تصحيف عن «" + أصل + "»؛ يتحد رسمهما (" + ر.هيكل_الرسم(أ) + ")."}
    }
    متغير ت = ر.تشابه_الرسم(أ، ش)
    إذا (ت >= ٠.٦) {
        ارجع {"نوع": "تحريف"، "تشابه": ت، "حاشية": "في (" + رمز + "): «" + شاهد + "» (تحريف قريب في الرسم من «" + أصل + "»)."}
    }
    ارجع {"نوع": "إبدال"، "تشابه": ت، "حاشية": "في (" + رمز + "): «" + شاهد + "» بدل «" + أصل + "»."}
}

# المقابلة الكاملة: تعيد قائمة فروق بترتيب النص، لكل فرق: رقم، موضع الأصل (من ٠)، أصل، شاهد، رمز، نوع، تشابه، حاشية
صدّر دالة قابل(نص_الأصل، نص_الشاهد، رمز) {
    متغير ر٠ = رمز
    إذا (ر٠ == لاشيء) { ر٠ = "ب" }
    متغير أ = ن.كلمات(نص_الأصل)
    متغير ب = ن.كلمات(نص_الشاهد)
    متغير م = طول(أ)
    متغير ك = طول(ب)
    متغير نأ = []
    من_أجل (ك١ في أ) { أضف(نأ، ر.طبّع_للمقابلة(ك١)) }
    متغير نب = []
    من_أجل (ك٢ في ب) { أضف(نب، ر.طبّع_للمقابلة(ك٢)) }
    دالة تكلفة(ي، ج) {
        إذا (نأ[ي] == نب[ج]) { ارجع ٠ }
        إذا (ر.تطابق_بلا_نقط(أ[ي]، ب[ج])) { ارجع ٠.٥ }
        إذا (ر.تشابه_الرسم(أ[ي]، ب[ج]) >= ٠.٦) { ارجع ١ }
        ارجع ١.٥
    }
    متغير د = []
    متغير ع = []
    من_أجل (ي من ٠ إلى م) {
        متغير صفد = []
        متغير صفع = []
        من_أجل (ج من ٠ إلى ك) { أضف(صفد، ٠); أضف(صفع، ٠) }
        أضف(د، صفد)
        أضف(ع، صفع)
    }
    من_أجل (ي من ١ إلى م) { د[ي][٠] = ي; ع[ي][٠] = ٣ }
    من_أجل (ج من ١ إلى ك) { د[٠][ج] = ج; ع[٠][ج] = ٤ }
    من_أجل (ي من ١ إلى م) {
        من_أجل (ج من ١ إلى ك) {
            متغير أفضل = د[ي - ١][ج - ١] + تكلفة(ي - ١، ج - ١)
            متغير رمز_ع = ١
            إذا (ي >= ٢ و ج >= ٢) {
                إذا (نأ[ي - ١] == نب[ج - ٢] و نأ[ي - ٢] == نب[ج - ١] و نأ[ي - ١] != نأ[ي - ٢]) {
                    إذا (د[ي - ٢][ج - ٢] + ١ < أفضل) { أفضل = د[ي - ٢][ج - ٢] + ١; رمز_ع = ٢ }
                }
            }
            إذا (د[ي - ١][ج] + ١ < أفضل) { أفضل = د[ي - ١][ج] + ١; رمز_ع = ٣ }
            إذا (د[ي][ج - ١] + ١ < أفضل) { أفضل = د[ي][ج - ١] + ١; رمز_ع = ٤ }
            د[ي][ج] = أفضل
            ع[ي][ج] = رمز_ع
        }
    }
    متغير عكسي = []
    متغير ي = م
    متغير ج = ك
    طالما (ي > ٠ أو ج > ٠) {
        متغير ق = ع[ي][ج]
        إذا (ق == ١) {
            إذا (أ[ي - ١] != ب[ج - ١]) {
                متغير ص = صنّف(أ[ي - ١]، ب[ج - ١]، ر٠)
                إذا (ن.أزل_التشكيل(أ[ي - ١]) != ن.أزل_التشكيل(ب[ج - ١])) {
                    أضف(عكسي، {"موضع_أصل": ي - ١، "أصل": أ[ي - ١]، "شاهد": ب[ج - ١]، "رمز": ر٠، "نوع": ص["نوع"]، "تشابه": ص["تشابه"]، "حاشية": ص["حاشية"]})
                }
            }
            ي = ي - ١
            ج = ج - ١
        } وإلا إذا (ق == ٢) {
            متغير قديم = أ[ي - ٢] + " " + أ[ي - ١]
            متغير جديد = ب[ج - ٢] + " " + ب[ج - ١]
            أضف(عكسي، {"موضع_أصل": ي - ٢، "أصل": قديم، "شاهد": جديد، "رمز": ر٠، "نوع": "قلب"، "تشابه": ٠.٩،
                "حاشية": "في (" + ر٠ + "): «" + جديد + "» بالتقديم والتأخير."})
            ي = ي - ٢
            ج = ج - ٢
        } وإلا إذا (ق == ٣) {
            متغير ص = صنّف(أ[ي - ١]، ""، ر٠)
            أضف(عكسي، {"موضع_أصل": ي - ١، "أصل": أ[ي - ١]، "شاهد": ""، "رمز": ر٠، "نوع": ص["نوع"]، "تشابه": ٠، "حاشية": ص["حاشية"]})
            ي = ي - ١
        } وإلا {
            متغير ص = صنّف(""، ب[ج - ١]، ر٠)
            أضف(عكسي، {"موضع_أصل": ي، "أصل": ""، "شاهد": ب[ج - ١]، "رمز": ر٠، "نوع": ص["نوع"]، "تشابه": ٠، "حاشية": ص["حاشية"]})
            ج = ج - ١
        }
    }
    متغير فروق = []
    متغير ف = طول(عكسي) - ١
    متغير رقم = ١
    طالما (ف >= ٠) {
        متغير عنصر = عكسي[ف]
        عنصر["رقم"] = رقم
        أضف(فروق، عنصر)
        رقم = رقم + ١
        ف = ف - ١
    }
    ارجع فروق
}

# حواشي جهاز التحقيق: سطر لكل فرق بصيغة «(رقم) [نوع] نص الحاشية»
صدّر دالة صغ_الحواشي(فروق) {
    إذا (طول(فروق) == ٠) { ارجع "لا فروق بين النسختين." }
    متغير أسطر = []
    من_أجل (ف في فروق) { أضف(أسطر، "(" + نص(ف["رقم"]) + ") [" + ف["نوع"] + "] " + ف["حاشية"]) }
    ارجع اربط(أسطر، حرف(١٠))
}

# عدّاد الأنواع: خريطة نوع ← عدد
صدّر دالة ملخص(فروق) {
    متغير ع = {}
    من_أجل (ف في فروق) {
        إذا (ف["نوع"] في ع) { ع[ف["نوع"]] = ع[ف["نوع"]] + ١ } وإلا { ع[ف["نوع"]] = ١ }
    }
    ارجع ع
}
