,-٦,-٣,-٤,-٥,-١٥,-٧,-٦,-٥,-٤,-٢;٤٠٨٩:-٤٠,-٥٣,-٥٢,-٤٣,-٥٠,-٦٠,-٦٣,-٤٤,-٥٨,-٤٩,١٩٦١,-٥٤,-٥٠,-٣٧,-٤٠,-٦٦,-٤٣,-٧٢,-٦١,-٨٣,-٤٠,-٤١,-٥٣,-٦٦,-٣٢,-٤٠,-٢٣,-٥٨,-٣٧,-٤٥,-٣٠٤,-١١١,-٥٥,-٣٩;٤٠٩٠:-٣١,-١١,-٤٤,-٤٩,-٢٧,-١٣,-٢١,-١٤,-٢٥٩,-٢١,-٢٤,-٢١,-٨,-١٠,٥٠٠,-٣٠,-٢٥,-١٥,-١٢,-٢٧,٣٥٦,-١٦,-١٣,-١٩,-١١,-٨,-٦,-١٣,-٣٢,-٢٥,-١٨,-١٤,-١٠,-٨;٤٠٩٣:-١٤٦,-١٠٤,-١٣٢,-١٣٣,-١٨٢,-١٢٨,-١٢٣,-٧٧,-٧٧,-٢٤٩,-١٣٤,٢٢٤٩,-٩٦,-٨٢,-١٢٣,-١٣٣,-١٤١,١٥٤٦,-٩٩,-١٢٩,-٨٥,-٨٤,-٧٨,-١٢٩,-٦٤,-١١٤,-٤٨,-٩٨,-١٠٧,-٢٤٦,-١٣١,-١٥٣,-٩٣,-٧٦;٤٠٩٤:١٠٠٩,٥٥٠,١٨٢,-٣٤,-٤٢,-٥٥,-٥٨,٩٧,-٨٠,-٥٧,-٣٧,-٤٦,-٤٠,-٤٧,-١٠٩,-٨٤,-٧٥,-٣٦,٩٦٨,-٣٦,-٢٧,-٥٥٨,٣٢٤,-٤٨,-٢٢,-١١٣٩,-١٦,-٦٥,-٤٠,-١٦٢,-٧٣,-٨٥,-٢٥,-٣٣"}
}
متغير _مخزن = {}

دالة _عدد(ك) {
    متغير س = ١
    متغير ق = ٠
    متغير ب = ك
    إذا (طول(ب) > ٠ و ب[٠] == "-") { س = -١; ب = ب[١:طول(ب)] }
    من_أجل (ح في ب) {
        من_أجل (ي في مدى(١٠)) { إذا ("٠١٢٣٤٥٦٧٨٩"[ي] == ح) { ق = ق * ١٠ + ي } }
    }
    ارجع س * ق
}

دالة _قائمة(ن) {
    متغير خ = []
    من_أجل (ك في افصل(ن، ",")) { أضف(خ، _عدد(ك)) }
    ارجع خ
}

صدّر دالة رؤوس() { ارجع مفاتيح(_رؤوس) }

صدّر دالة نموذج(اسم) {
    إذا (ليس يحوي(_مخزن، اسم)) {
        متغير ر = _رؤوس[اسم]
        متغير أوزان_ = {}
        من_أجل (مدخل في افصل(ر["نص"]، ";")) {
            متغير نقطتان = ٠
            من_أجل (ي في مدى(طول(مدخل))) { إذا (مدخل[ي] == ":" و نقطتان == ٠) { نقطتان = ي } }
            أوزان_[_عدد(مدخل[٠:نقطتان])] = _قائمة(مدخل[نقطتان + ١:طول(مدخل)])
        }
        _مخزن[اسم] = {"تصنيفات": ر["تصنيفات"]، "انحياز": _قائمة(ر["انحياز"])، "أوزان": أوزان_}
    }
    ارجع _مخزن[اسم]
}
