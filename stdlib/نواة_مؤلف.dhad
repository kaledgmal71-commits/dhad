# ضاد/نواة_مؤلف — مؤلّف برامج: يحوّل طلبًا عربيًّا (من نيات معروفة) إلى برنامج ضاد من قوالب،
# ثم يتحقق منه بمحلل الصياغة ويشغّله في الصندوق المعزول؛ لا يعيد إلا ما صحّ وعمل.
# بلا أوزان ولا استرجاع: قواعد وقوالب وتحقق. الحدّ: نيات محدودة بصياغات متنوعة لا لغة حرة؛ وما خرج عنها يُرفض ولا يُخمَّن.
# النيات: طباعة نص، جمع/ضرب/طرح أعداد، جدول ضرب، عدّ من إلى، مجموع من إلى، زوجي/فردي، الأكبر/الأصغر، المضروب، طول قائمة.

متغير ع = استورد("ضاد/نواة_عقد")
متغير شرح_ = استورد("ضاد/نواة_شرح")

متغير _هندية = "٠١٢٣٤٥٦٧٨٩"
متغير _غربية = "0123456789"
متغير _ترقيم = ["،"، ","، "."، "؟"، "?"، "!"، ":"، "؛"، ";"، "«"، "»"]

# توحيد الحروف: ألف بأنواعها، ة→ه، ى→ي، ئ→ي، ؤ→و، وإزالة التشكيل والتطويل
دالة _وحّد(نص_) {
    متغير خرج = ""
    من_أجل (ح في نص_) {
        إذا (ح == "أ" أو ح == "إ" أو ح == "آ") { خرج = خرج + "ا" }
        وإلا إذا (ح == "ة") { خرج = خرج + "ه" }
        وإلا إذا (ح == "ى" أو ح == "ئ") { خرج = خرج + "ي" }
        وإلا إذا (ح == "ؤ") { خرج = خرج + "و" }
        وإلا إذا (ح == "ـ" أو ح == "َ" أو ح == "ُ" أو ح == "ِ" أو ح == "ً" أو ح == "ٌ" أو ح == "ٍ" أو ح == "ّ" أو ح == "ْ") { خرج = خرج }
        وإلا { خرج = خرج + ح }
    }
    ارجع خرج
}

دالة _رقم_ح(ح) { ارجع يحوي(_هندية، ح) أو يحوي(_غربية، ح) }

# الحرف إلى رقم هندي
دالة _هندي(ح) {
    من_أجل (ي من ٠ إلى ٩) {
        إذا (_هندية[ي] == ح أو _غربية[ي] == ح) { ارجع _هندية[ي] }
    }
    ارجع ح
}

# ينزع علامات الترقيم من طرفي الكلمة
دالة _نظّف(ك) {
    متغير ن٢ = ك
    طالما (طول(ن٢) > ٠ و يحوي(_ترقيم، ن٢[٠])) { ن٢ = ن٢[١:طول(ن٢)] }
    طالما (طول(ن٢) > ٠ و يحوي(_ترقيم، ن٢[طول(ن٢) - ١])) { ن٢ = ن٢[٠:طول(ن٢) - ١] }
    ارجع ن٢
}

# كلمات الطلب (منظَّفة) دون توحيد، للاقتطاف الحرفي للنص
دالة _كلمات(طلب) {
    متغير خرج = []
    من_أجل (ك في افصل(طلب، " ")) {
        متغير ص = _نظّف(ك)
        إذا (ص != "") { أضف(خرج، ص) }
    }
    ارجع خرج
}

# العدد في الكلمة (هنديًّا) أو "" : «٣٠» و«و٣٠» و«30»
دالة _عدد_في(ك) {
    متغير ص = ك
    إذا (طول(ص) > ١ و ص[٠] == "و" و _رقم_ح(ص[١])) { ص = ص[١:طول(ص)] }
    إذا (ص == "") { ارجع "" }
    متغير خرج = ""
    من_أجل (ح في ص) {
        إذا (_رقم_ح(ح)) { خرج = خرج + _هندي(ح) } وإلا { ارجع "" }
    }
    ارجع خرج
}

دالة _أعداد(كلمات) {
    متغير خرج = []
    من_أجل (ك في كلمات) {
        متغير ر = _عدد_في(ك)
        إذا (ر != "") { أضف(خرج، ر) }
    }
    ارجع خرج
}

دالة _فيه(س، عبارات) {
    من_أجل (ب في عبارات) { إذا (يحوي(س، ب)) { ارجع صحيح } }
    ارجع خطأ
}

دالة _جذر_كلمة(س، جذور) {
    من_أجل (ك في افصل(س، " ")) {
        من_أجل (ب في جذور) { إذا (ك == ب) { ارجع صحيح } }
    }
    ارجع خطأ
}

دالة _سطور(أسطر) { ارجع اربط(أسطر، حرف(١٠)) }

# النص الحرفي بعد كلمة دالة (عبارة/كلمة/جملة/نص) أو بين علامتي اقتباس؛ "" إن لم يوجد
دالة _نص_للطباعة(طلب، موحد) {
    متغير ك = _كلمات(طلب)
    متغير ا٢ = _كلمات(موحد)
    متغير علامات = ["عباره"، "كلمه"، "جمله"، "نص"، "نصا"، "عبارتي"]
    من_أجل (ي من ٠ إلى طول(ا٢) - ٢) {
        إذا (يحوي(علامات، ا٢[ي])) {
            متغير بقية = []
            من_أجل (ج من ي + ١ إلى طول(ك) - ١) { أضف(بقية، ك[ج]) }
            # يُنزع ذيل «على الشاشة»
            متغير ن٢ = طول(بقية)
            إذا (ن٢ >= ٢ و _وحّد(بقية[ن٢ - ٢]) == "علي" و _وحّد(بقية[ن٢ - ١]) == "الشاشه") { بقية = بقية[٠:ن٢ - ٢] }
            ارجع اربط(بقية، " ")
        }
    }
    ارجع ""
}

# يبني الشيفرة من الطلب؛ يعيد {نية، شيفرة} أو لاشيء
دالة _ابنِ(طلب) {
    متغير س = " " + _وحّد(طلب) + " "
    متغير ك = _كلمات(طلب)
    متغير ن٣ = _أعداد(ك)
    متغير كم = طول(ن٣)
    # يجب أن يطلب الكلامُ شيفرةً
    إذا (ليس _فيه(س، ["برنامج"، "كود"، "برمج"، "شيفره"، "سكربت"، "اكتب"])) { ارجع لاشيء }

    إذا (يحوي(س، "جدول") و كم >= ١) {
        ارجع {"نية": "جدول_ضرب"، "شيفرة": _سطور(["متغير ن = " + ن٣[٠]، "من_أجل (ي من ١ إلى ١٠) {"، "    اطبع(ن، ¤×¤، ي، ¤=¤، ن * ي)"، "}"])}
    }
    إذا (_فيه(س، [" مضروب"، " عاملي"، " فاكتوريال"]) و كم >= ١) {
        ارجع {"نية": "مضروب"، "شيفرة": _سطور(["متغير ن = " + ن٣[٠]، "متغير ناتج = ١"، "من_أجل (ي من ١ إلى ن) {"، "    ناتج = ناتج * ي"، "}"، "اطبع(ناتج)"])}
    }
    متغير فيها_الى = يحوي(س، " الي ") و كم >= ٢
    إذا (فيها_الى و _فيه(س، ["جمع"، "مجموع"، "يجمع"])) {
        ارجع {"نية": "مجموع_مدى"، "شيفرة": _سطور(["متغير مجموع = ٠"، "من_أجل (ي من " + ن٣[٠] + " إلى " + ن٣[١] + ") {"، "    مجموع = مجموع + ي"، "}"، "اطبع(مجموع)"])}
    }
    إذا (فيها_الى و _فيه(س، [" عد "، " يعد "، " اعد "، "تنازلي"، "تصاعدي"، "الاعداد"، "الارقام"])) {
        إذا (كم >= ٢ و عدد(ن٣[٠]) >= عدد(ن٣[١])) {
            ارجع {"نية": "عد_تنازلي"، "شيفرة": _سطور(["متغير ن = " + ن٣[٠]، "طالما (ن >= " + ن٣[١] + ") {"، "    اطبع(ن)"، "    ن = ن - ١"، "}"])}
        }
        ارجع {"نية": "عد_تصاعدي"، "شيفرة": _سطور(["من_أجل (ي من " + ن٣[٠] + " إلى " + ن٣[١] + ") {"، "    اطبع(ي)"، "}"])}
    }
    إذا (_فيه(س، ["زوجي"، "فردي"، "زوجيا"، "فرديا"]) و كم >= ١) {
        ارجع {"نية": "زوجي_فردي"، "شيفرة": _سطور(["متغير ع = " + ن٣[٠]، "إذا (ع % ٢ == ٠) {"، "    اطبع(¤زوجي¤)"، "} وإلا {"، "    اطبع(¤فردي¤)"، "}"])}
    }
    إذا (_فيه(س، ["اكبر"، "الاكبر"، "اصغر"، "الاصغر"]) و كم >= ٢) {
        متغير مقارن = ">"
        إذا (_فيه(س، ["اصغر"، "الاصغر"])) { مقارن = "<" }
        ارجع {"نية": "الأكبر_أو_الأصغر"، "شيفرة": _سطور(["متغير أعداد = [" + اربط(ن٣، "،") + "]"، "متغير ك = أعداد[٠]"، "من_أجل (ع في أعداد) {"، "    إذا (ع " + مقارن + " ك) { ك = ع }"، "}"، "اطبع(ك)"])}
    }
    إذا (_فيه(س، ["قايمه"، "قائمه"]) و _فيه(س، ["طول"، "عدد"، "عناصر"]) و كم >= ١) {
        ارجع {"نية": "طول_قائمة"، "شيفرة": _سطور(["متغير ق = [" + اربط(ن٣، "، ") + "]"، "اطبع(طول(ق))"])}
    }
    إذا (كم >= ٢ و _فيه(س، ["طرح"، "يطرح"])) {
        متغير أ٢ = ن٣[٠]
        متغير ب٢ = ن٣[١]
        إذا (يحوي(س، " من ")) { أ٢ = ن٣[١]; ب٢ = ن٣[٠] }
        ارجع {"نية": "طرح"، "شيفرة": "اطبع(" + أ٢ + " - " + ب٢ + ")"}
    }
    إذا (كم >= ٢ و _فيه(س، ["ضرب"، "يضرب"])) {
        ارجع {"نية": "ضرب"، "شيفرة": "اطبع(" + اربط(ن٣، " * ") + ")"}
    }
    إذا (كم >= ٢ و _فيه(س، ["جمع"، "يجمع"، "مجموع"، "زائد"])) {
        ارجع {"نية": "جمع"، "شيفرة": "اطبع(" + اربط(ن٣، " + ") + ")"}
    }
    متغير نص_ = _نص_للطباعة(طلب، _وحّد(طلب))
    إذا (نص_ != "" و _فيه(س، ["يطبع"، "اطبع"، "يعرض"، "اعرض"، "يكتب"، "اكتب"، "طباعه"]) و ليس يحوي(نص_، حرف(٣٤)) و ليس يحوي(نص_، حرف(١٠))) {
        ارجع {"نية": "طباعة_نص"، "شيفرة": "اطبع(" + حرف(٣٤) + نص_ + حرف(٣٤) + ")"}
    }
    ارجع لاشيء
}

# النتيجة: {حالة: "ناجح"|"مرفوض"|"فاشل", نية, شيفرة, ناتج, شرح}
صدّر دالة ألّف(طلب) {
    إذا (نوع(طلب) != "نص") { أطلق_خطأ("المؤلّف: الطلب نص") }
    متغير ب = _ابنِ(طلب)
    إذا (ب == لاشيء) { ارجع {"حالة": "مرفوض"، "نية": ""، "شيفرة": ""، "ناتج": []، "شرح": لاشيء} }
    متغير شيفرة = استبدل(ب["شيفرة"]، "¤"، حرف(٣٤))
    إذا (نواة_فحص_صياغة(شيفرة) != "كامل") { ارجع {"حالة": "فاشل"، "نية": ب["نية"]، "شيفرة": شيفرة، "ناتج": []، "شرح": لاشيء} }
    متغير خ = نفّذ(شيفرة، ٢٠٠٠٠٠، ٢٠٠٠)
    من_أجل (ل في خ) {
        إذا (طول(ل) >= ٥ و ل[٠:٥] == "خطأ: ") { ارجع {"حالة": "فاشل"، "نية": ب["نية"]، "شيفرة": شيفرة، "ناتج": خ، "شرح": لاشيء} }
    }
    ارجع {"حالة": "ناجح"، "نية": ب["نية"]، "شيفرة": شيفرة، "ناتج": خ، "شرح": شرح_.اشرح(شيفرة، خطأ)}
}

# صياغة للقارئ
صدّر دالة صغ(ن٢) {
    متغير سياج = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    متغير خرج = ["هذا البرنامج، وقد شُغِّل الآن:"، ""، سياج، ن٢["شيفرة"]، سياج، ""، "الناتج:"]
    من_أجل (ل في ن٢["ناتج"]) { أضف(خرج، "  " + ل) }
    إذا (ن٢["شرح"] != لاشيء) {
        أضف(خرج، "")
        أضف(خرج، "شرحه:")
        أضف(خرج، شرح_.صغ(ن٢["شرح"]))
    }
    ارجع اربط(خرج، حرف(١٠))
}

صدّر دالة سجّل_المحرك() {
    إذا (ليس يحوي(ع.المحركات()، "مؤلف_برامج")) {
        ع.سجّل(ع.محرك("مؤلف_برامج"، "يؤلّف برنامج ضاد من طلب عربي بقوالب ويتحقق منه بالتشغيل"، {"طلب": "نص"}، {"حالة": "نص"، "نية": "نص"، "شيفرة": "نص"، "ناتج": "قائمة"}،
            دالة(م) { ارجع ألّف(م["طلب"]) }))
    }
}
