# ضاد/رياضيات — الدوال الرياضية الأساسية للذكاء الاصطناعي، مكتوبة بضاد نفسها بلا اعتماد على مضيف.
# الأسّ واللوغاريتم والجيب وتمام الجيب والمماس القطعي والسيني وغاوس الخطأ ودوال التنشيط، ومولّد عشوائي حتمي.
# الدقة الموثَّقة (تُختبر على مرجع المضيف): خطأ نسبي لا يتجاوز ١e-١٢ في المدى المعتاد لكل دالة.
# الحتمية: لا يُقرأ شيء من خارج المعاملات؛ المولّد العشوائي حالته صريحة فيعيد التشغيلُ ذاتُه الأرقامَ ذاتَها.

متغير _ه = ٢.٧١٨٢٨١٨٢٨٤٥٩٠٤٥
متغير _ط = ٣.١٤١٥٩٢٦٥٣٥٨٩٧٩٣
متغير _لو٢ = ٠.٦٩٣١٤٧١٨٠٥٥٩٩٤٥٣
# ٢ط على جزأين لتقليل خطأ الاختزال
متغير _ط٢أ = ٦.٢٨٣١٨٥٣٠٧١٧٩٥٨٦
متغير _ط٢ب = ٢.٤٤٩٢٩٣٥٩٨٢٩٤٧٠٦٤e-١٦
متغير _جذر_ط = ١.٧٧٢٤٥٣٨٥٠٩٠٥٥١٦٠٣

صدّر متغير ثابت_ه = _ه
صدّر متغير ثابت_ط = _ط

# ---------- الأسّ ----------
# التنفيذ أصلي في المضيف بنقل حرفي لهذه الخوارزمية (يُختبر بالبت مقابل النسخة الأصلية بضاد): e^x = ٢^k · e^r مع |r| ≤ ln٢/٢، ومتسلسلة تايلور لـ e^r (١٦ حدًا)
صدّر دالة أس(س) { ارجع نواة_أس(س) }

# ---------- اللوغاريتم الطبيعي ----------
# x = m · ٢^e مع m في [٠.٧٥، ١.٥)؛ ln m = ٢·(t + t³/٣ + t⁵/٥ …) حيث t=(m-١)/(m+١)
صدّر دالة لوغ(س) { ارجع نواة_لوغ(س) }

# ---------- الجيب وتمام الجيب ----------
دالة _اختزل_دورة(س) {
    متغير ك = جولة(س / _ط٢أ)
    ارجع (س - ك * _ط٢أ) - ك * _ط٢ب
}

صدّر دالة جيب(س) {
    متغير ر = _اختزل_دورة(س)
    متغير ر٢ = ر * ر
    متغير حد = ر
    متغير مجموع = ر
    من_أجل (ن من ١ إلى ١٥) {
        حد = -حد * ر٢ / ((٢ * ن) * (٢ * ن + ١))
        مجموع = مجموع + حد
    }
    ارجع مجموع
}

صدّر دالة جتا(س) {
    متغير ر = _اختزل_دورة(س)
    متغير ر٢ = ر * ر
    متغير حد = ١
    متغير مجموع = ١
    من_أجل (ن من ١ إلى ١٥) {
        حد = -حد * ر٢ / ((٢ * ن - ١) * (٢ * ن))
        مجموع = مجموع + حد
    }
    ارجع مجموع
}

# ---------- دوال التنشيط ----------
صدّر دالة ظل_قطعي(س) {
    إذا (س > ٢٠) { ارجع ١ }
    إذا (س < -٢٠) { ارجع -١ }
    إذا (مطلق(س) < ٠.٠٠٠١) { ارجع س - س * س * س / ٣ }
    متغير ي = أس(٢ * س)
    ارجع (ي - ١) / (ي + ١)
}

صدّر دالة سيني(س) {
    إذا (س >= ٠) { ارجع ١ / (١ + أس(-س)) }
    متغير ي = أس(س)
    ارجع ي / (١ + ي)
}

صدّر دالة زائد_ناعم(س) {
    متغير م = ٠
    إذا (س > ٠) { م = س }
    ارجع م + لوغ(١ + أس(-مطلق(س)))
}

# كسر متصل لـ erfc عند س ≥ ١.٥: e^(-x²) / (√π · f) حيث f = x + (١/٢)/(x + ١/(x + (٣/٢)/(x + …)))
دالة _مكمل_كبير(ع) {
    متغير ف = ع
    متغير ك = ٩٠
    طالما (ك >= ١) {
        ف = ع + (ك / ٢) / ف
        ك = ك - ١
    }
    ارجع أس(-ع * ع) / (_جذر_ط * ف)
}

# متسلسلة تايلور لـ erf عند ع ≤ ١.٥
دالة _خطأ_صغير(ع) {
    متغير حد = ع
    متغير مجموع = ع
    متغير ع٢ = ع * ع
    من_أجل (ن من ١ إلى ٦٠) {
        حد = -حد * ع٢ / ن
        مجموع = مجموع + حد / (٢ * ن + ١)
    }
    ارجع ٢ / _جذر_ط * مجموع
}

# دالة غاوس للخطأ التكميلية erfc = ١ − erf بلا فقد في الدقة للقيم الكبيرة
صدّر دالة خطأ_مكمل(س) {
    إذا (س < ٠) { ارجع ٢ - خطأ_مكمل(-س) }
    إذا (س >= ١.٥) { ارجع _مكمل_كبير(س) }
    ارجع ١ - _خطأ_صغير(س)
}

صدّر دالة خطأ_غاوس(س) {
    متغير ع = مطلق(س)
    متغير إشارة = ١
    إذا (س < ٠) { إشارة = -١ }
    إذا (ع >= ٦) { ارجع إشارة }
    إذا (ع <= ١.٥) { ارجع إشارة * _خطأ_صغير(ع) }
    ارجع إشارة * (١ - _مكمل_كبير(ع))
}

صدّر دالة جيلو(س) {
    ارجع ٠.٥ * س * خطأ_مكمل(-س / ١.٤١٤٢١٣٥٦٢٣٧٣٠٩٥١)
}

# صيغة التقريب بالمماس القطعي (GELU-tanh) المستعملة في بعض النماذج
صدّر دالة جيلو_تقريبي(س) {
    ارجع ٠.٥ * س * (١ + ظل_قطعي(٠.٧٩٧٨٨٤٥٦٠٨٠٢٨٦٥٤ * (س + ٠.٠٤٤٧١٥ * س * س * س)))
}

صدّر دالة سيلو(س) { ارجع س * سيني(س) }

# ---------- مولّد عشوائي حتمي (Park–Miller الأدنى: ٤٨٢٧١ ومعامل ٢³¹−١) ----------
صدّر دالة مولّد(بذرة) {
    متغير ح = بذرة % ٢١٤٧٤٨٣٦٤٧
    إذا (ح <= ٠) { ح = ح + ٢١٤٧٤٨٣٦٤٦ }
    ارجع {"حالة": ح}
}

# عدد منتظم في (٠، ١)
صدّر دالة تالي(م) {
    م["حالة"] = (م["حالة"] * ٤٨٢٧١) % ٢١٤٧٤٨٣٦٤٧
    ارجع م["حالة"] / ٢١٤٧٤٨٣٦٤٧
}

# عدد من التوزيع الطبيعي المعياري (بوكس–مولر)
صدّر دالة طبيعي(م) {
    متغير أ = تالي(م)
    متغير ب = تالي(م)
    ارجع جذر(-٢ * لوغ(أ)) * جتا(٢ * _ط * ب)
}
