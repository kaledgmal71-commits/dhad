# ضاد/نواة_مشروع — مساحة مشروع التطبيق: ملفات بمسارات آمنة، وبيان خدمات، وإصدارات، وحزم إلى صفحة واحدة، وتحقق من العمل دون إنترنت.
# عامة: لا تعرف لغة تطبيق ولا نوعه. التطبيق مشروع ملفات (html و js و css و json و md و dhad) وبيانه «نواة.json» يعلن الخدمات التي يستعملها من المحيط.

متغير ن = استورد("ضاد/نصوص")
متغير ج = استورد("ضاد/جسون")

متغير _امتدادات = [".html"، ".js"، ".css"، ".json"، ".md"، ".dhad"، ".svg"، ".txt"]
متغير _أقصى_ملف = ٢٠٠٠٠٠
متغير _أقصى_ملفات = ٦٠
متغير _بيان = "نواة.json"

صدّر دالة بيان_اسم() { ارجع _بيان }

# مسار آمن: نسبي، بلا «..» ولا شرطة مائلة عكسية ولا بدء بـ«/»، بامتداد معروف
صدّر دالة مسار_آمن(مسار) {
    إذا (نوع(مسار) != "نص" أو طول(مسار) == ٠ أو طول(مسار) > ١٢٠) { ارجع خطأ }
    إذا (مسار[٠] == "/" أو يحوي(مسار، "..") أو يحوي(مسار، حرف(٩٢)) أو يحوي(مسار، "//")) { ارجع خطأ }
    من_أجل (ح في مسار) { إذا (ح == " " أو ح == حرف(١٠) أو ح == ":") { ارجع خطأ } }
    من_أجل (ا في _امتدادات) { إذا (ن.ينتهي_ب(مسار، ا)) { ارجع صحيح } }
    ارجع خطأ
}

صدّر دالة أنشئ(اسم) {
    إذا (نوع(اسم) != "نص" أو طول(ن.قصّ(اسم)) == ٠) { أطلق_خطأ("المشروع: الاسم نص غير فارغ") }
    ارجع {"اسم": ن.قصّ(اسم)، "ملفات": {}، "إصدارات": []}
}

صدّر دالة اكتب(م، مسار، محتوى) {
    إذا (ليس مسار_آمن(مسار)) { أطلق_خطأ("المشروع: مسار غير آمن: " + نص(مسار)) }
    إذا (نوع(محتوى) != "نص" أو طول(محتوى) > _أقصى_ملف) { أطلق_خطأ("المشروع: محتوى الملف نص لا يتجاوز " + نص(_أقصى_ملف) + " حرف") }
    إذا (ليس يحوي(م["ملفات"]، مسار) و طول(مفاتيح(م["ملفات"])) >= _أقصى_ملفات) { أطلق_خطأ("المشروع: بلغ الحد الأقصى للملفات") }
    م["ملفات"][مسار] = محتوى
    ارجع م
}

صدّر دالة اقرأ(م، مسار) {
    إذا (ليس يحوي(م["ملفات"]، مسار)) { ارجع لاشيء }
    ارجع م["ملفات"][مسار]
}

صدّر دالة احذف_ملف(م، مسار) {
    إذا (يحوي(م["ملفات"]، مسار)) { احذف(م["ملفات"]، مسار) }
    ارجع م
}

صدّر دالة اسرد(م) {
    متغير خ = []
    من_أجل (ك في مفاتيح(م["ملفات"])) { أضف(خ، ك) }
    ارجع خ
}

# إصدارات: لقطة بوصف، واسترجاع، وما تغيّر بين لقطة والحالة الحالية
صدّر دالة لقطة(م، وصف) {
    متغير نسخة = {}
    من_أجل (ك في مفاتيح(م["ملفات"])) { نسخة[ك] = م["ملفات"][ك] }
    أضف(م["إصدارات"]، {"وصف": وصف، "ملفات": نسخة})
    ارجع طول(م["إصدارات"])
}

صدّر دالة استرجع(م، رقم_) {
    إذا (رقم_ < ١ أو رقم_ > طول(م["إصدارات"])) { أطلق_خطأ("المشروع: لا إصدار برقم " + نص(رقم_)) }
    متغير نسخة = م["إصدارات"][رقم_ - ١]["ملفات"]
    م["ملفات"] = {}
    من_أجل (ك في مفاتيح(نسخة)) { م["ملفات"][ك] = نسخة[ك] }
    ارجع م
}

صدّر دالة ما_تغيّر(م، رقم_) {
    متغير قديم = م["إصدارات"][رقم_ - ١]["ملفات"]
    متغير مضاف = []
    متغير معدّل = []
    متغير محذوف = []
    من_أجل (ك في مفاتيح(م["ملفات"])) {
        إذا (ليس يحوي(قديم، ك)) { أضف(مضاف، ك) }
        وإلا إذا (قديم[ك] != م["ملفات"][ك]) { أضف(معدّل، ك) }
    }
    من_أجل (ك في مفاتيح(قديم)) { إذا (ليس يحوي(م["ملفات"]، ك)) { أضف(محذوف، ك) } }
    ارجع {"مضاف": مضاف، "معدّل": معدّل، "محذوف": محذوف}
}

# الخدمات المعلنة في البيان؛ قائمة فارغة إن لم يوجد بيان صالح
صدّر دالة خدمات(م) {
    إذا (ليس يحوي(م["ملفات"]، _بيان)) { ارجع [] }
    إذا (ليس ج.صالح(م["ملفات"][_بيان])) { ارجع [] }
    متغير ب = ج.حلّل(م["ملفات"][_بيان])
    إذا (نوع(ب) != "خريطة" أو ليس يحوي(ب، "خدمات") أو نوع(ب["خدمات"]) != "قائمة") { ارجع [] }
    ارجع ب["خدمات"]
}

# مراجع ملفات في html: src="..." و href="..." النسبية فقط
دالة _مراجع(نص_html) {
    متغير خ = []
    من_أجل (سمة في ["src=" + حرف(٣٤)، "href=" + حرف(٣٤)]) {
        متغير أجزاء = افصل(نص_html، سمة)
        من_أجل (ي في مدى(١، طول(أجزاء))) {
            متغير ق = أجزاء[ي]
            متغير ز = موضع(ق، حرف(٣٤))
            إذا (ز > ٠) { أضف(خ، ق[٠:ز]) }
        }
    }
    ارجع خ
}

# هل في النص عنوان شبكة خارجي؟ (يمنع العمل دون إنترنت)
دالة _خارجي(نص_) {
    ارجع يحوي(نص_، "http://") أو يحوي(نص_، "https://") أو يحوي(نص_، "//cdn") أو يحوي(نص_، "@import url(")
}

# تحقق: يعيد {سليم، أخطاء، تحذيرات، دون_إنترنت}. المسموح من الخدمات تُمرَّر (قائمة أسماء)
صدّر دالة تحقق(م، مسموح) {
    متغير أخطاء = []
    متغير تحذيرات = []
    إذا (ليس يحوي(م["ملفات"]، "index.html")) { أضف(أخطاء، "لا يوجد index.html") }
    متغير دون_إنترنت = صحيح
    من_أجل (ك في مفاتيح(م["ملفات"])) {
        إذا (ك != _بيان و _خارجي(م["ملفات"][ك])) { دون_إنترنت = خطأ; أضف(تحذيرات، "اعتماد على عنوان خارجي في " + ك) }
    }
    إذا (يحوي(م["ملفات"]، "index.html")) {
        من_أجل (مرجع في _مراجع(م["ملفات"]["index.html"])) {
            إذا (ليس _خارجي(مرجع) و ليس يحوي(م["ملفات"]، مرجع) و ليس ن.يبدأ_ب(مرجع، "#") و ليس ن.يبدأ_ب(مرجع، "data:")) { أضف(أخطاء، "مرجع إلى ملف غير موجود: " + مرجع) }
        }
    }
    إذا (يحوي(م["ملفات"]، _بيان) و ليس ج.صالح(م["ملفات"][_بيان])) { أضف(أخطاء، _بيان + " ليس JSON صالحًا") }
    من_أجل (خ في خدمات(م)) {
        إذا (ليس يحوي(مسموح، خ)) { أضف(أخطاء، "خدمة غير متاحة: " + نص(خ)) }
    }
    ارجع {"سليم": طول(أخطاء) == ٠، "أخطاء": أخطاء، "تحذيرات": تحذيرات، "دون_إنترنت": دون_إنترنت}
}

# حزمة: صفحة واحدة بها كل css وjs المرجوعين منسوخَين داخلها (للمعاينة المعزولة ولتثبيت مستقل)
صدّر دالة احزم(م) {
    متغير صفحة = م["ملفات"]["index.html"]
    من_أجل (مرجع في _مراجع(صفحة)) {
        إذا (يحوي(م["ملفات"]، مرجع)) {
            متغير محتوى = م["ملفات"][مرجع]
            إذا (ن.ينتهي_ب(مرجع، ".js")) {
                صفحة = استبدل(صفحة، "<script src=" + حرف(٣٤) + مرجع + حرف(٣٤) + "></script>"، "<script>" + محتوى + "</script>")
            }
            إذا (ن.ينتهي_ب(مرجع، ".css")) {
                صفحة = استبدل(صفحة، "<link rel=" + حرف(٣٤) + "stylesheet" + حرف(٣٤) + " href=" + حرف(٣٤) + مرجع + حرف(٣٤) + ">"، "<style>" + محتوى + "</style>")
            }
        }
    }
    ارجع صفحة
}

صدّر دالة حدود() { ارجع {"أقصى_ملف": _أقصى_ملف، "أقصى_ملفات": _أقصى_ملفات، "امتدادات": _امتدادات} }
