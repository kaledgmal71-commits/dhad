# ضاد/طبقات — طبقات المحوّل (Transformer) مكتوبة بضاد فوق ضاد/تفاضل، لتسلسل واحد [ط، د].
# المكوّنات: تضمين، تطبيع RMS، ترميز موضعي دوّار (RoPE)، انتباه ذاتي مقنَّع متعدد الرؤوس، شبكة SwiGLU، كتلة بوصلات متبقية، نموذج لغوي بأوزان مربوطة.
# التحقق في الاختبارات: تدرجات بالفروق المنتهية، ومطابقة المخرجات لمرجع JS مستقل، وسببية المقنَّع، وتدريب فعلي.

متغير م = استورد("ضاد/مصفوفات")
متغير ت = استورد("ضاد/تفاضل")
متغير ر = استورد("ضاد/رياضيات")

دالة _معامل(شكل، مولد، مقياس) { ارجع ت.معامل(م.عشوائي_طبيعي(شكل، مولد، مقياس)) }

# ---------- تطبيع RMS: س · (متوسط س² + ε)^-½ · كسب ----------
صدّر دالة تطبيع(د) {
    ارجع {"كسب": ت.معامل(م.آحاد([١، د]))، "إبسيلون": ٠.٠٠٠٠٠١}
}
صدّر دالة طبّق_تطبيع(ط، س) {
    متغير ميل = ت.متوسط(ت.مربع(س)، -١، صحيح)
    متغير مقلوب = ت.قسمة(ت.ثابت(م.آحاد([١، ١]))، ت.جذر_تربيعي(ت.جمع(ميل، ت.ثابت(م.أنشئ([١، ١]، ط["إبسيلون"])))))
    ارجع ت.ضرب(ت.ضرب(س، مقلوب)، ط["كسب"])
}

# ---------- جداول الدوران (RoPE بنصفين): تردد ي = ١٠٠٠٠^(-٢ي/ب) ----------
صدّر دالة جداول_الدوران(أقصى، بعد_رأس) {
    متغير نصف = بعد_رأس / ٢
    متغير جت = []
    متغير جب = []
    من_أجل (ع من ٠ إلى أقصى - ١) {
        من_أجل (ك من ٠ إلى بعد_رأس - ١) {
            متغير ي = ك
            إذا (ي >= نصف) { ي = ي - نصف }
            متغير زاوية = ع * ر.أس(-٢ * ي / بعد_رأس * ر.لوغ(١٠٠٠٠))
            أضف(جت، ر.جتا(زاوية))
            أضف(جب، ر.جيب(زاوية))
        }
    }
    ارجع {"جتا": م.من_قائمة(جت، [أقصى، بعد_رأس])، "جيب": م.من_قائمة(جب، [أقصى، بعد_رأس])}
}

# س·جتا + دوّر_نصف(س)·جيب حيث دوّر_نصف([أ، ب]) = [−ب، أ]
صدّر دالة دوّر(س، جتا، جيب) {
    متغير ب = س["قيمة"]["شكل"][١]
    متغير نصف = ب / ٢
    متغير أ١ = ت.شريحة(س، ١، ٠، نصف)
    متغير أ٢ = ت.شريحة(س، ١، نصف، ب)
    متغير مدوّر = ت.ضمّ([ت.سالب(أ٢)، أ١]، ١)
    ارجع ت.جمع(ت.ضرب(س، ت.ثابت(جتا))، ت.ضرب(مدوّر، ت.ثابت(جيب)))
}

# ---------- الانتباه الذاتي المقنَّع ----------
صدّر دالة انتباه(د، رؤوس، مولد) {
    إذا (د % رؤوس != ٠) { أطلق_خطأ("بعد النموذج يجب أن يقبل القسمة على عدد الرؤوس") }
    متغير مقياس = ١ / جذر(د)
    ارجع {"د": د، "رؤوس": رؤوس، "رأس": د / رؤوس،
        "ق": _معامل([د، د]، مولد، مقياس)، "ف": _معامل([د، د]، مولد، مقياس)،
        "ك": _معامل([د، د]، مولد، مقياس)، "خ": _معامل([د، د]، مولد، مقياس)}
}

# قناع سببي: ٠ حيث ي ≤ ع و −١٠⁹ فيما سواه
صدّر دالة قناع_سببي(ط) {
    متغير ب = []
    من_أجل (ع من ٠ إلى ط - ١) {
        من_أجل (ي من ٠ إلى ط - ١) {
            إذا (ي <= ع) { أضف(ب، ٠) } وإلا { أضف(ب، -١٠٠٠٠٠٠٠٠٠) }
        }
    }
    ارجع م.من_قائمة(ب، [ط، ط])
}

صدّر دالة طبّق_انتباه(ط، س، دوران) {
    متغير طول_ = س["قيمة"]["شكل"][٠]
    متغير ب = ط["رأس"]
    متغير ق = ت.ضرب_مصفوفي(س، ط["ق"])
    متغير ف = ت.ضرب_مصفوفي(س، ط["ف"])
    متغير ك = ت.ضرب_مصفوفي(س، ط["ك"])
    متغير جتا = م.شريحة(دوران["جتا"]، ٠، ٠، طول_)
    متغير جيب = م.شريحة(دوران["جيب"]، ٠، ٠، طول_)
    متغير قناع = ت.ثابت(قناع_سببي(طول_))
    متغير مخرجات = []
    من_أجل (ه من ٠ إلى ط["رؤوس"] - ١) {
        متغير قر = دوّر(ت.شريحة(ق، ١، ه * ب، (ه + ١) * ب)، جتا، جيب)
        متغير فر = دوّر(ت.شريحة(ف، ١، ه * ب، (ه + ١) * ب)، جتا، جيب)
        متغير كر = ت.شريحة(ك، ١، ه * ب، (ه + ١) * ب)
        متغير درجات = ت.جمع(ت.مقياس(ت.ضرب_مصفوفي(قر، ت.منقول(فر))، ١ / جذر(ب))، قناع)
        أضف(مخرجات، ت.ضرب_مصفوفي(ت.سوفت_ماكس(درجات، -١)، كر))
    }
    ارجع ت.ضرب_مصفوفي(ت.ضمّ(مخرجات، ١)، ط["خ"])
}

# ---------- شبكة SwiGLU: (سيلو(س·و١) ⊙ (س·و٣))·و٢ ----------
صدّر دالة شبكة(د، مخفي، مولد) {
    ارجع {"و١": _معامل([د، مخفي]، مولد، ١ / جذر(د))، "و٣": _معامل([د، مخفي]، مولد، ١ / جذر(د))،
        "و٢": _معامل([مخفي، د]، مولد، ١ / جذر(مخفي))}
}
صدّر دالة طبّق_شبكة(ط، س) {
    متغير أ = ت.ضرب_مصفوفي(س، ط["و١"])
    متغير بوابة = ت.ضرب(أ، ت.سيني(أ))
    ارجع ت.ضرب_مصفوفي(ت.ضرب(بوابة، ت.ضرب_مصفوفي(س، ط["و٣"]))، ط["و٢"])
}

# ---------- كتلة المحوّل ----------
صدّر دالة كتلة(د، رؤوس، مخفي، مولد) {
    ارجع {"ت١": تطبيع(د)، "انتباه": انتباه(د، رؤوس، مولد)، "ت٢": تطبيع(د)، "شبكة": شبكة(د، مخفي، مولد)}
}
صدّر دالة طبّق_كتلة(ك، س، دوران) {
    متغير ص = ت.جمع(س، طبّق_انتباه(ك["انتباه"]، طبّق_تطبيع(ك["ت١"]، س)، دوران))
    ارجع ت.جمع(ص، طبّق_شبكة(ك["شبكة"]، طبّق_تطبيع(ك["ت٢"]، ص)))
}

# ---------- النموذج اللغوي ----------
# إعداد: {"مفردات"، "د"، "رؤوس"، "طبقات"، "مخفي"، "أقصى_طول"}
صدّر دالة نموذج(إعداد، مولد) {
    متغير كتل = []
    من_أجل (ي من ١ إلى إعداد["طبقات"]) { أضف(كتل، كتلة(إعداد["د"]، إعداد["رؤوس"]، إعداد["مخفي"]، مولد)) }
    ارجع {"إعداد": إعداد، "تضمين": _معامل([إعداد["مفردات"]، إعداد["د"]]، مولد، ١ / جذر(إعداد["د"]))،
        "كتل": كتل، "ختامي": تطبيع(إعداد["د"])،
        "دوران": جداول_الدوران(إعداد["أقصى_طول"]، إعداد["د"] / إعداد["رؤوس"])}
}

# يرجع سجلات [ط، مفردات]؛ رأس المخرجات هو منقول جدول التضمين (أوزان مربوطة)
صدّر دالة أمام(ن، فهارس) {
    إذا (طول(فهارس) > ن["إعداد"]["أقصى_طول"]) { أطلق_خطأ("التسلسل أطول من أقصى طول للنموذج") }
    متغير س = ت.تضمين(ن["تضمين"]، فهارس)
    من_أجل (ك في ن["كتل"]) { س = طبّق_كتلة(ك، س، ن["دوران"]) }
    ارجع ت.ضرب_مصفوفي(طبّق_تطبيع(ن["ختامي"]، س)، ت.منقول(ن["تضمين"]))
}

صدّر دالة معاملات(ن) {
    متغير ق = [ن["تضمين"]]
    من_أجل (ك في ن["كتل"]) {
        أضف(ق، ك["ت١"]["كسب"])
        أضف(ق، ك["انتباه"]["ق"]) أضف(ق، ك["انتباه"]["ف"]) أضف(ق، ك["انتباه"]["ك"]) أضف(ق، ك["انتباه"]["خ"])
        أضف(ق، ك["ت٢"]["كسب"])
        أضف(ق، ك["شبكة"]["و١"]) أضف(ق، ك["شبكة"]["و٣"]) أضف(ق، ك["شبكة"]["و٢"])
    }
    أضف(ق، ن["ختامي"]["كسب"])
    ارجع ق
}

# خسارة التنبؤ بالرمز التالي لتسلسل: المدخل س[٠..ن−٢] والهدف س[١..ن−١]
صدّر دالة خسارة_التسلسل(ن، رموز) {
    متغير دخل = []
    متغير هدف = []
    من_أجل (ي من ٠ إلى طول(رموز) - ٢) { أضف(دخل، رموز[ي]) أضف(هدف، رموز[ي + ١]) }
    ارجع ت.خسارة_متقاطعة(أمام(ن، دخل)، هدف)
}

# توليد جشع: أكبر سجل في آخر موضع في كل خطوة
صدّر دالة ولّد_جشعا(ن، بداية، عدد) {
    متغير رموز = []
    من_أجل (ك في بداية) { أضف(رموز، ك) }
    من_أجل (ي من ١ إلى عدد) {
        إذا (طول(رموز) >= ن["إعداد"]["أقصى_طول"]) { ارجع رموز }
        متغير سجلات = أمام(ن، رموز)["قيمة"]
        متغير ص = سجلات["شكل"][٠]
        متغير ف = سجلات["شكل"][١]
        متغير أفضل = ٠
        من_أجل (ك من ١ إلى ف - ١) {
            إذا (سجلات["بيانات"][(ص - ١) * ف + ك] > سجلات["بيانات"][(ص - ١) * ف + أفضل]) { أفضل = ك }
        }
        أضف(رموز، أفضل)
    }
    ارجع رموز
}
