# ضاد/نواة_وحدة_ضاد — وحدة لغة ضاد في نواة: كل ما يخص ضاد (شرح شيفرتها وإصلاحها وتعليمها وتأليف برامجها والإجابة من دليلها)
# في ملف واحد مستقل. لا تُستدعى إلا حين تُطلب ضاد وحدها (باسمها أو بشيفرتها)؛ فإزالتها لا تمسّ بقية نواة.
# تتعامل نواة مع ضاد كما تتعامل مع أي لغة: محلل ومنفّذ وأدوات؛ وما في الدليل لا يُستدعى إلا لسؤال عن ضاد نفسها.

متغير ع = استورد("ضاد/نواة_عقد")
متغير ل٥ = استورد("ضاد/نواة_لغات")
متغير د٠ = استورد("ضاد/نواة_دليل")
متغير ف٠ = استورد("ضاد/نواة_ملف")
متغير ش٢ = استورد("ضاد/نواة_شرح")
متغير ت٢ = استورد("ضاد/نواة_تعليم")
متغير م٢ = استورد("ضاد/نواة_مصلح")
متغير ل٢ = استورد("ضاد/نواة_مؤلف")
متغير م٤ = استورد("ضاد/نواة_منفذ")
متغير ت٣ = استورد("ضاد/نواة_توليف")
متغير خ٣ = استورد("ضاد/نواة_أخطاء")

دالة اختر(شرط، أ، ب) {
    إذا (شرط) { ارجع أ }
    ارجع ب
}

دالة _خطوة(محرك، حالة، تفصيل) { ارجع {"محرك": محرك، "حالة": حالة، "تفصيل": تفصيل} }

دالة _أضف_البادئة(بادئة، رد_) {
    إذا (بادئة == "" أو رد_ == "") { ارجع رد_ }
    ارجع بادئة + حرف(١٠) + حرف(١٠) + رد_
}

دالة _شيفرة_الطلب(طلب) {
    متغير س = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    إذا (يحوي(طلب، س)) {
        متغير أجزاء = افصل(طلب، س)
        إذا (طول(أجزاء) >= ٣) {
            متغير كتلة = أجزاء[١]
            متغير سطور = افصل(كتلة، حرف(١٠))
            إذا (طول(سطور) > ١ و طول(سطور[٠]) < ١٢ و ليس يحوي(سطور[٠]، "(")) {
                متغير بقية = []
                من_أجل (ي في مدى(١، طول(سطور))) { أضف(بقية، سطور[ي]) }
                ارجع اربط(بقية، حرف(١٠))
            }
            ارجع كتلة
        }
    }
    ارجع ""
}

# شرح شيفرة ضاد من شجرة الصياغة الحقيقية مع تشغيلها
دالة _شرح_شيفرة(شيفرة، بادئة) {
    متغير ن٢ = ع.شغّل("شرح_شيفرة"، {"شيفرة": شيفرة})["نتيجة"]
    ارجع {
        "نوع": "شرح"، "ثقة": ١٠٠، "لغة": "ضاد"،
        "خطة": [_خطوة("شرح_شيفرة"، "نُفّذ"، "شجرة الصياغة")]،
        "نتائج": {"شرح": ن٢["شرح"]، "شيفرة_حالية": شيفرة}، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، ن٢["نص"])
    }
}

دالة _نتيجة_دليل(ج، طلب، بادئة) {
    # الجواب مثال شيفرة: يُشرح من شجرته ويُشغَّل ليرى السائل الناتج الفعلي، لا نص الدرس وحده
    متغير رد_ = ج["رد"]
    إذا (ج["شيفرة"] != "" و نوع(ج["شيفرة"]) == "نص" و طول(افصل(ج["شيفرة"]، حرف(١٠))) <= ٢٥) {
        متغير ن٢ = ع.شغّل("شرح_شيفرة"، {"شيفرة": ج["شيفرة"]})["نتيجة"]
        إذا (ن٢["شرح"]["صحيح"]) { رد_ = رد_ + حرف(١٠) + حرف(١٠) + "شرح المثال:" + حرف(١٠) + ن٢["نص"] }
    }
    ارجع {
        "نوع": "دليل"، "ثقة": ١٠٠، "لغة": "ضاد"،
        "خطة": [_خطوة("دليل"، "نُفّذ"، ج["مستوى"] + " — " + ج["معرف"])]،
        "نتائج": {"دليل": {"طلب": طلب، "عنوان": ج["عنوان"]، "رابط": ج["رابط"]، "نص": ج["نص"]، "شيفرة": ج["شيفرة"]، "مستوى": ج["مستوى"]}}،
        "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، رد_)
    }
}

# «بسّطه» و«عمّقه»: إعادة شرح آخر موضوع من الدليل بمستوى آخر
دالة _متابعة_دليل(نوع_، آخر، سياق، بادئة) {
    إذا (ليس يحوي(آخر، "دليل_طلب") أو ليس يحوي(سياق، "دليل")) {
        ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": [_خطوة("دليل"، "تُخطّي"، "لا شرح سابق")]، "نتائج": {}، "ذكريات": []،
            "رد": _أضف_البادئة(بادئة، "لا أرى شرحًا سابقًا أعدّله. اسألني عن موضوع في ضاد أولًا، ثم اطلب تبسيطه أو التعمّق فيه.")}
    }
    متغير مستوى_ = "معمق"
    إذا (نوع_ == "بسّط") { مستوى_ = "بسيط" }
    متغير ج = د٠.أجب(سياق["دليل"]، _بلا_الاسم(آخر["دليل_طلب"])، مستوى_)
    ارجع _نتيجة_دليل(ج، آخر["دليل_طلب"]، بادئة)
}

# «شغّله»: تشغيل آخر برنامج عُرض في الصندوق المعزول، وتشخيص الخطأ إن فشل
دالة _تشغيل_السابق(آخر، بادئة) {
    متغير خطة = []
    إذا (ليس يحوي(آخر، "شيفرة") أو آخر["شيفرة"] == "") {
        أضف(خطة، _خطوة("متابعة"، "تُخطّي"، "لا شيفرة سابقة"))
        ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": خطة، "نتائج": {}، "ذكريات": []،
            "رد": _أضف_البادئة(بادئة، "لا أرى برنامجًا سابقًا لأشغّله. اطلب برنامجًا أولًا، أو الصق شيفرتك.")}
    }
    متغير ج = ع.شغّل("منفذ_معزول"، {"شيفرة": آخر["شيفرة"]، "سقف_الخطوات": ٢٠٠٠٠٠})["نتيجة"]
    متغير نتائج = {"تنفيذ": ج}
    أضف(خطة، _خطوة("منفذ_معزول"، "نُفّذ"، اختر(ج["ناجح"]، "نجح"، "فشل: " + ج["نوع_الخطأ"])))
    متغير نص_ = ""
    إذا (ج["ناجح"]) {
        نص_ = "شُغِّل البرنامج السابق:" + حرف(١٠) + اربط(ج["مخرجات"]، حرف(١٠))
    } وإلا {
        متغير د = ع.شغّل("محلل_أخطاء"، {"رسالة": ج["خطأ"]، "شيفرة": آخر["شيفرة"]})["نتيجة"]
        نتائج["تشخيص"] = د
        أضف(خطة، _خطوة("محلل_أخطاء"، "نُفّذ"، د["تفسير"]))
        نص_ = "فشل تشغيل البرنامج السابق: " + ج["خطأ"] + حرف(١٠) + د["تفسير"]
    }
    ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": خطة، "نتائج": نتائج، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، نص_)}
}

# الطلب بلا اسم اللغة نفسه (ضاد، بضاد، في ضاد): اسمها يدل على الوحدة وليس موضوع البحث في دليلها
دالة _بلا_الاسم(طلب) {
    متغير ك = افصل(طلب، " ")
    متغير خرج = []
    من_أجل (ي في مدى(طول(ك))) {
        متغير ك٤ = ك[ي]
        متغير تالي = ""
        إذا (ي + ١ < طول(ك)) { تالي = ك[ي + ١] }
        متغير اسم_ = (ك٤ == "ضاد" أو ك٤ == "بضاد" أو ك٤ == "لضاد" أو ك٤ == "وضاد" أو ك٤ == "Dhad" أو ك٤ == "dhad")
        متغير حرف_جر = (ك٤ == "في" و (تالي == "ضاد" أو تالي == "dhad" أو تالي == "Dhad"))
        إذا (ليس اسم_ و ليس حرف_جر) { أضف(خرج، ك٤) }
    }
    ارجع اربط(خرج، " ")
}

# هل النص شيفرة ضاد؟ فيه كلمة من كلماتها المميّزة (لا يُشترط أن تكون سليمة الصياغة: الشيفرة المكسورة تُصلَح)
صدّر دالة يتعرف(شيفرة) {
    من_أجل (ك في ["متغير "، "دالة "، "اطبع("، "من_أجل"، "طالما"، "إذا ("]) { إذا (يحوي(شيفرة، ك)) { ارجع صحيح } }
    ارجع خطأ
}

# محاولة الإجابة بعد أن تقرّر أن الطلب عن ضاد. ط: {طلب، سياق، آخر، بادئة، متابعة}. يعيد نتيجة أو لاشيء.
صدّر دالة حاول(ط) {
    متغير طلب = ط["طلب"]
    متغير سياق = ط["سياق"]
    متغير آخر = ط["آخر"]
    متغير بادئة = ط["بادئة"]
    متغير متابعة = ط["متابعة"]
    متغير شيفرة_ = _شيفرة_الطلب(طلب)

    إذا (متابعة == "شغّل") { ارجع _تشغيل_السابق(آخر، بادئة) }
    إذا (متابعة == "بسّط" أو متابعة == "عمّق" أو (متابعة == "مزيد" و يحوي(آخر، "دليل_طلب"))) { ارجع _متابعة_دليل(متابعة، آخر، سياق، بادئة) }
    إذا (متابعة == "اشرح" و يحوي(آخر، "شيفرة")) { ارجع _شرح_شيفرة(آخر["شيفرة"]، بادئة) }
    إذا (يحوي(طلب، "اشرح") و شيفرة_ != "") { ارجع _شرح_شيفرة(شيفرة_، بادئة) }

    # «أصلح/صحّح» مع شيفرة: مصلح الشيفرة (يتحقق من كل إصلاح بالفحص والتشغيل)
    إذا (شيفرة_ != "" و (يحوي(طلب، "أصلح") أو يحوي(طلب، "اصلح") أو يحوي(طلب، "صحح") أو يحوي(طلب، "صحّح"))) {
        متغير م٣ = م٢.أصلح(شيفرة_)
        ارجع {
            "نوع": "إصلاح"، "ثقة": ١٠٠، "لغة": "ضاد"،
            "خطة": [_خطوة("مصلح_شيفرة"، "نُفّذ"، م٣["حالة"])]،
            "نتائج": {"إصلاح": {"حالة": م٣["حالة"]، "شيفرة": م٣["شيفرة"]}، "شيفرة_حالية": م٣["شيفرة"]}، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، م٢.صغ(م٣))
        }
    }

    # تعليم مفاهيم ضاد: مفهوم ومثال مشغَّل وشرح من شجرته
    متغير تعليم = ت٢.أجب(طلب)
    إذا (تعليم != لاشيء) {
        ارجع {
            "نوع": "تعليم"، "ثقة": ١٠٠، "لغة": "ضاد"،
            "خطة": [_خطوة("شرح_شيفرة"، "نُفّذ"، "مفهوم: " + تعليم["معرف"])]،
            "نتائج": {"تعليم": {"معرف": تعليم["معرف"]، "شيفرة": تعليم["شيفرة"]}}، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، تعليم["رد"])
        }
    }

    # تأليف برنامج بضاد من طلب عربي بقوالب، مُتحقَّق منه بالتشغيل
    إذا (شيفرة_ == "") {
        متغير تأليف = ل٢.ألّف(طلب)
        إذا (تأليف["حالة"] == "ناجح") {
            ارجع {
                "نوع": "تأليف"، "ثقة": ١٠٠، "لغة": "ضاد"،
                "خطة": [_خطوة("مؤلف_برامج"، "نُفّذ"، "نية: " + تأليف["نية"])]،
                "نتائج": {"تأليف": {"نية": تأليف["نية"]، "شيفرة": تأليف["شيفرة"]}}، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، ل٢.صغ(تأليف))
            }
        }
    }

    # سؤال عن ضاد نفسها: يُجاب من نص دليلها ودروسها (لا يُستدعى إلا إذا سُئلت ضاد بالاسم)
    متغير س = ف٠.مطبّع(طلب)
    إذا (يحوي(سياق، "دليل") و شيفرة_ == "" و ليس (يحوي(س، "ملفات") أو يحوي(س، "مكتبت") أو يحوي(س، "ملفي") أو يحوي(س، "مجلد"))) {
        متغير تحليل = ع.شغّل("محلل_المهام"، {"طلب": طلب})["نتيجة"]
        إذا (تحليل["نوع"] != "كتابة_برنامج") {
            متغير ج = د٠.أجب(سياق["دليل"]، _بلا_الاسم(طلب))
            إذا (ج["وُجد"]) { ارجع _نتيجة_دليل(ج، طلب، بادئة) }
        }
    }
    ارجع لاشيء
}

# امتداد المنسّق: ما تتولاه هذه اللغة من «المحركات اللازمة» لطلب مسمّى بها. يعيد صحيحًا إن تولّته.
صدّر دالة لازم(ط) {
    متغير ل = ط["لازم"]
    متغير طلب = ط["طلب"]
    متغير سياق = ط["سياق"]
    متغير خطة = ط["خطة"]
    متغير نتائج = ط["نتائج"]
    إذا (ل == "استرجاع" و يحوي(سياق، "فهرس")) {
        متغير خ = ع.شغّل("استرجاع"، {"فهرس": سياق["فهرس"]، "استعلام": طلب، "حد": ٣})["نتيجة"]["نتائج"]
        نتائج["استرجاع"] = خ
        أضف(خطة، _خطوة("استرجاع"، "نُفّذ"، "وُجدت " + نص(طول(خ)) + " نتيجة"))
        ارجع صحيح
    }
    إذا (ل == "منفذ_معزول") {
        متغير شيفرة = _شيفرة_الطلب(طلب)
        إذا (شيفرة != "" و ط["تحليل"]["نوع"] != "كتابة_برنامج") {
            متغير ن = ع.شغّل("منفذ_معزول"، {"شيفرة": شيفرة، "سقف_الخطوات": ٢٠٠٠٠٠})["نتيجة"]
            نتائج["تنفيذ"] = ن
            أضف(خطة، _خطوة("منفذ_معزول"، "نُفّذ"، اختر(ن["ناجح"]، "نجح"، "فشل: " + ن["نوع_الخطأ"])))
            ارجع صحيح
        }
        أضف(خطة، _خطوة("منفذ_معزول"، "تُخطّي"، "لا شيفرة جاهزة للتشغيل"))
        ارجع صحيح
    }
    إذا (ل == "توليف_شيفرة" و يحوي(سياق، "قاعدة")) {
        متغير ن = ع.شغّل("توليف_شيفرة"، {"قاعدة": سياق["قاعدة"]، "وصف": طلب})["نتيجة"]
        نتائج["توليف"] = ن
        أضف(خطة، _خطوة("توليف_شيفرة"، "نُفّذ"، اختر(ن["وُجد"]، "من " + ن["مصدر"]، "لم يوجد برنامج موثوق")))
        ارجع صحيح
    }
    ارجع خطأ
}

# بعد التشغيل: تشخيص خطأ التنفيذ إن لزم
صدّر دالة بعد(ط) {
    متغير نتائج = ط["نتائج"]
    متغير خطة = ط["خطة"]
    إذا (يحوي(ط["تحليل"]["محركات_لازمة"]، "محلل_أخطاء")) {
        إذا (يحوي(نتائج، "تنفيذ") و ليس نتائج["تنفيذ"]["ناجح"]) {
            متغير ت = نتائج["تنفيذ"]
            نتائج["تشخيص"] = ع.شغّل("محلل_أخطاء"، {"رسالة": ت["خطأ"]، "شيفرة": _شيفرة_الطلب(ط["طلب"])})["نتيجة"]
            أضف(خطة، _خطوة("محلل_أخطاء"، "نُفّذ"، نتائج["تشخيص"]["تصنيف"]))
        } وإلا {
            أضف(خطة، _خطوة("محلل_أخطاء"، "تُخطّي"، "لا خطأ تشغيل لتحليله"))
        }
    }
}

# أسطر الردّ من نتائج هذه اللغة
صدّر دالة صغ(نتائج) {
    متغير أسطر = []
    إذا (يحوي(نتائج، "توليف")) {
        متغير ل = نتائج["توليف"]
        إذا (ل["وُجد"]) {
            أضف(أسطر، "برنامج مُتحقَّق منه (" + ل["مصدر"] + "):")
            أضف(أسطر، ل["شيفرة"])
        } وإلا {
            إذا (يحوي(ل، "لغة_أخرى") و ل["لغة_أخرى"] != "") {
                أضف(أسطر، "برامجي الموثَّقة مكتوبة بضاد وحدها، ولا أملك برنامجًا مُتحقَّقًا بلغة " + ل["لغة_أخرى"] + " بعد؛ التحويل المتحقَّق إلى اللغات الأخرى من أهدافي المقبلة. يمكنني كتابته بضاد إن أردت.")
            } وإلا {
                أضف(أسطر، "لم أجد برنامجًا موثوقًا يطابق الوصف في معرفتي الحالية.")
            }
        }
    }
    إذا (يحوي(نتائج، "تنفيذ")) {
        متغير ت = نتائج["تنفيذ"]
        إذا (ت["ناجح"]) {
            أضف(أسطر، "نتيجة التشغيل:")
            من_أجل (س في ت["مخرجات"]) { أضف(أسطر، "  " + نص(س)) }
        } وإلا {
            أضف(أسطر، "فشل التشغيل (" + ت["نوع_الخطأ"] + "): " + ت["خطأ"])
        }
    }
    إذا (يحوي(نتائج، "تشخيص")) {
        متغير د = نتائج["تشخيص"]
        أضف(أسطر، "التشخيص: " + د["تفسير"])
        إذا (د["نص_السطر"] != "") { أضف(أسطر، "  السطر " + نص(د["سطر"]) + ": " + د["نص_السطر"]) }
        أضف(أسطر، "الاقتراح: " + د["اقتراح"])
    }
    ارجع أسطر
}

# ملف بامتداد هذه اللغة في عملية على ملف كامل: يُشغَّل ويُشخَّص خطؤه. يعيد {كتلة، تنفيذ، تشخيص؟}
صدّر دالة ملف(اسم، نص_ملف) {
    متغير ج = ع.شغّل("منفذ_معزول"، {"شيفرة": نص_ملف، "سقف_الخطوات": ٢٠٠٠٠٠})["نتيجة"]
    متغير كتلة = ""
    متغير خرج = {"تنفيذ": ج}
    إذا (ج["ناجح"]) {
        كتلة = "- التشغيل: نجح."
        متغير ناتج = []
        من_أجل (س في ج["مخرجات"]) { إذا (طول(ناتج) < ٨) { أضف(ناتج، "  " + نص(س)) } }
        إذا (طول(ناتج) > ٠) { كتلة = كتلة + حرف(١٠) + اربط(ناتج، حرف(١٠)) }
    } وإلا {
        كتلة = "- التشغيل: فشل (" + ج["نوع_الخطأ"] + ") " + ج["خطأ"]
        متغير د = ع.شغّل("محلل_أخطاء"، {"رسالة": ج["خطأ"]، "شيفرة": نص_ملف})["نتيجة"]
        خرج["تشخيص"] = د
        كتلة = كتلة + حرف(١٠) + "- التشخيص: " + د["تفسير"]
        إذا (د["نص_السطر"] != "") { كتلة = كتلة + حرف(١٠) + "  السطر " + نص(د["سطر"]) + ": " + د["نص_السطر"] }
        كتلة = كتلة + حرف(١٠) + "- الاقتراح: " + د["اقتراح"]
    }
    خرج["كتلة"] = كتلة
    ارجع خرج
}

# تسجيل الوحدة في سجلّ اللغات ومحركاتها في سجلّ المحركات
صدّر دالة سجّل() {
    متغير موجود = ع.المحركات()
    إذا (ليس يحوي(موجود، "منفذ_معزول")) { م٤.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "محلل_أخطاء")) { خ٣.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "توليف_شيفرة")) { ت٣.سجّل_المحرك() }
    ش٢.سجّل_المحرك()
    م٢.سجّل_المحرك()
    ل٢.سجّل_المحرك()
    ارجع ل٥.سجّل_وحدة({
        "اسم": "ضاد"، "أسماء": ["ضاد"، "dhad"، "Dhad"، "DHAD"]، "امتدادات": [".dhad"]،
        "يتعرف": يتعرف، "حاول": حاول، "لازم": لازم، "بعد": بعد، "صغ": صغ، "ملف": ملف
    })
}
