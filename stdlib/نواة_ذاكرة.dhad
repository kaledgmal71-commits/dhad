# ضاد/نواة_ذاكرة — ذاكرة نواة: ثلاثة أنواع، وفصل صريح بين المؤقت والدائم.
#   عاملة   : حالة المهمة الجارية. مؤقتة دائمًا، ذات سقف، يُزاح أقدمها وأضعفها.
#   تجريبية : وقائع جرت (طلب، نتيجة، خطأ). دائمة، لكل واقعة مصدر وثقة.
#   إجرائية : مهارات وطرائق. دائمة، لكنها تبدأ «فرضية» ولا تُعتمد إلا بدليل اختبار.
# أي عنصر له: معرف، نوع، محتوى، مصدر، ثقة (٠–١٠٠)، خطوة الإنشاء، مرات الاستدعاء.

متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ع = استورد("ضاد/نواة_عقد")
متغير ج = استورد("ضاد/جسون")

متغير _أنواع = ["عاملة"، "تجريبية"، "إجرائية"]

صدّر دالة أنشئ(سقف_العاملة = ٢٠) {
    إذا (نوع(سقف_العاملة) != "رقم" أو سقف_العاملة < ١) { أطلق_خطأ("الذاكرة: سقف العاملة رقم موجب") }
    ارجع {"عناصر": {}، "عداد": ٠، "خطوة": ٠، "سقف_العاملة": سقف_العاملة}
}

دالة _تحقق_من_المخزن(م) {
    إذا (نوع(م) != "خريطة" أو ليس يحوي(م، "عناصر") أو ليس يحوي(م، "عداد")) { أطلق_خطأ("الذاكرة: المخزن يُنشأ بالدالة أنشئ()") }
}

دالة _عدد_العاملة(م) {
    متغير ك = ٠
    من_أجل (مف في مفاتيح(م["عناصر"])) { إذا (م["عناصر"][مف]["نوع"] == "عاملة") { ك = ك + ١ } }
    ارجع ك
}

# يزيح أقدم العاملة وأضعفها حتى يعود العدد إلى السقف
دالة _أزح_الزائد(م) {
    طالما (_عدد_العاملة(م) > م["سقف_العاملة"]) {
        متغير أضعف = ""
        من_أجل (مف في مفاتيح(م["عناصر"])) {
            متغير ب = م["عناصر"][مف]
            إذا (ب["نوع"] == "عاملة") {
                إذا (أضعف == "") {
                    أضعف = مف
                } وإلا {
                    متغير س = م["عناصر"][أضعف]
                    إذا (ب["ثقة"] < س["ثقة"] أو (ب["ثقة"] == س["ثقة"] و ب["خطوة"] < س["خطوة"])) { أضعف = مف }
                }
            }
        }
        احذف(م["عناصر"]، أضعف)
    }
}

# يكتب عنصرًا ويعيد معرفه
صدّر دالة اكتب(م، نوع_الذاكرة، محتوى، مصدر، ثقة = ٥٠) {
    _تحقق_من_المخزن(م)
    إذا (ليس يحوي(_أنواع، نوع_الذاكرة)) { أطلق_خطأ("الذاكرة: النوع «" + نص(نوع_الذاكرة) + "» غير معروف. الأنواع: " + اربط(_أنواع، "، ")) }
    إذا (نوع(محتوى) != "نص" أو طول(محتوى) == ٠) { أطلق_خطأ("الذاكرة: المحتوى نص غير فارغ") }
    إذا (نوع(مصدر) != "نص" أو طول(مصدر) == ٠) { أطلق_خطأ("الذاكرة: لكل عنصر مصدر") }
    إذا (نوع(ثقة) != "رقم" أو ثقة < ٠ أو ثقة > ١٠٠) { أطلق_خطأ("الذاكرة: الثقة بين ٠ و١٠٠") }
    م["عداد"] = م["عداد"] + ١
    م["خطوة"] = م["خطوة"] + ١
    متغير معرف = "ذ" + نص(م["عداد"])
    متغير عنصر = {"معرف": معرف، "نوع": نوع_الذاكرة، "محتوى": محتوى، "مصدر": مصدر، "ثقة": ثقة، "خطوة": م["خطوة"]، "استدعاءات": ٠}
    إذا (نوع_الذاكرة == "إجرائية") {
        عنصر["حالة"] = "فرضية"
        عنصر["دليل"] = ""
    }
    م["عناصر"][معرف] = عنصر
    إذا (نوع_الذاكرة == "عاملة") { _أزح_الزائد(م) }
    ارجع معرف
}

صدّر دالة اقرأ(م، معرف) {
    _تحقق_من_المخزن(م)
    إذا (ليس يحوي(م["عناصر"]، معرف)) { أطلق_خطأ("الذاكرة: لا عنصر باسم «" + نص(معرف) + "»") }
    ارجع م["عناصر"][معرف]
}

# يعتمد مهارة إجرائية بدليل اختبار؛ بلا دليل تبقى فرضية
صدّر دالة اعتمد(م، معرف، دليل) {
    متغير ب = اقرأ(م، معرف)
    إذا (ب["نوع"] != "إجرائية") { أطلق_خطأ("الذاكرة: الاعتماد للإجرائية وحدها") }
    إذا (نوع(دليل) != "نص" أو طول(دليل) == ٠) { أطلق_خطأ("الذاكرة: لا اعتماد بلا دليل اختبار") }
    ب["حالة"] = "معتمدة"
    ب["دليل"] = دليل
    ارجع صحيح
}

# يسحب الاعتماد (فشل المهارة عند التجربة) فتعود فرضية
صدّر دالة اسحب_الاعتماد(م، معرف) {
    متغير ب = اقرأ(م، معرف)
    إذا (ب["نوع"] != "إجرائية") { أطلق_خطأ("الذاكرة: السحب للإجرائية وحدها") }
    ب["حالة"] = "فرضية"
    ب["دليل"] = ""
    ارجع صحيح
}

# يرقّي عنصرًا من العاملة إلى التجريبية (يصير دائمًا) بمصدر جديد
صدّر دالة رقِّ(م، معرف، مصدر) {
    متغير ب = اقرأ(م، معرف)
    إذا (ب["نوع"] != "عاملة") { أطلق_خطأ("الذاكرة: الترقية من العاملة وحدها") }
    إذا (نوع(مصدر) != "نص" أو طول(مصدر) == ٠) { أطلق_خطأ("الذاكرة: لكل عنصر مصدر") }
    ب["نوع"] = "تجريبية"
    ب["مصدر"] = مصدر
    ارجع صحيح
}

# ينهي المهمة: يمحو المؤقت كله ويعيد عدد ما مُحي
صدّر دالة انهِ_المهمة(م) {
    _تحقق_من_المخزن(م)
    متغير ك = ٠
    من_أجل (مف في مفاتيح(م["عناصر"])) {
        إذا (م["عناصر"][مف]["نوع"] == "عاملة") {
            احذف(م["عناصر"]، مف)
            ك = ك + ١
        }
    }
    ارجع ك
}

دالة _كلمات_مطبّعة(س) {
    متغير خرج = []
    من_أجل (ك في افصل(ر.طبّع(س)، " ")) { إذا (طول(ك) > ٠) { أضف(خرج، ك) } }
    ارجع خرج
}

# يستدعي عناصر تناسب الاستعلام (تقاطع كلمات مطبّعة، مرجَّحًا بالثقة). الإجرائية الفرضية لا تُستدعى إلا إذا طُلبت.
صدّر دالة استدعِ(م، استعلام، حد = ٥، نوع_الذاكرة = "", مع_الفرضيات = خطأ) {
    _تحقق_من_المخزن(م)
    إذا (نوع(استعلام) != "نص") { أطلق_خطأ("الذاكرة: الاستعلام نص") }
    إذا (نوع(حد) != "رقم" أو حد < ١) { أطلق_خطأ("الذاكرة: الحد رقم موجب") }
    إذا (نوع_الذاكرة != "" و ليس يحوي(_أنواع، نوع_الذاكرة)) { أطلق_خطأ("الذاكرة: النوع «" + نوع_الذاكرة + "» غير معروف") }
    متغير كلمات = _كلمات_مطبّعة(استعلام)
    متغير نتائج = []
    من_أجل (مف في مفاتيح(م["عناصر"])) {
        متغير ب = م["عناصر"][مف]
        متغير مقبول = نوع_الذاكرة == "" أو ب["نوع"] == نوع_الذاكرة
        إذا (مقبول و ب["نوع"] == "إجرائية" و ب["حالة"] != "معتمدة" و ليس مع_الفرضيات) { مقبول = خطأ }
        إذا (مقبول) {
            متغير ك_ب = _كلمات_مطبّعة(ب["محتوى"])
            متغير تطابق = ٠
            من_أجل (ك في كلمات) { إذا (يحوي(ك_ب، ك)) { تطابق = تطابق + ١ } }
            إذا (تطابق > ٠) { أضف(نتائج، [تطابق * ١٠٠ + ب["ثقة"]، ب["خطوة"]، مف]) }
        }
    }
    # الأعلى درجة أولًا، وعند التعادل الأحدث
    متغير مرتبة = رتب(نتائج، دالة(أ، ب) {
        إذا (أ[٠] != ب[٠]) { ارجع ب[٠] - أ[٠] }
        ارجع ب[١] - أ[١]
    })
    متغير خرج = []
    من_أجل (ي في مدى(طول(مرتبة))) {
        إذا (ي < حد) {
            متغير ب = م["عناصر"][مرتبة[ي][٢]]
            ب["استدعاءات"] = ب["استدعاءات"] + ١
            أضف(خرج، ب)
        }
    }
    ارجع خرج
}

# ملخص العدد لكل نوع
صدّر دالة إحصاء(م) {
    _تحقق_من_المخزن(م)
    متغير ح = {"عاملة": ٠، "تجريبية": ٠، "إجرائية": ٠}
    من_أجل (مف في مفاتيح(م["عناصر"])) {
        متغير ن = م["عناصر"][مف]["نوع"]
        ح[ن] = ح[ن] + ١
    }
    ارجع ح
}

# يحفظ الدائم فقط (التجريبية والإجرائية) بجسون؛ العاملة لا تُحفظ أبدًا
صدّر دالة احفظ(م) {
    _تحقق_من_المخزن(م)
    متغير دائم = {}
    من_أجل (مف في مفاتيح(م["عناصر"])) {
        إذا (م["عناصر"][مف]["نوع"] != "عاملة") { دائم[مف] = م["عناصر"][مف] }
    }
    ارجع ج.اكتب({"عناصر": دائم، "عداد": م["عداد"]، "خطوة": م["خطوة"]، "سقف_العاملة": م["سقف_العاملة"]})
}

صدّر دالة حمّل(نص_جسون) {
    متغير د = ج.حلّل(نص_جسون)
    إذا (نوع(د) != "خريطة" أو ليس يحوي(د، "عناصر") أو ليس يحوي(د، "عداد")) { أطلق_خطأ("الذاكرة: نص الحفظ غير صالح") }
    ارجع د
}

# يسجّل الذاكرة محركًا: عملية واحدة لكل استدعاء على مخزن يُمرَّر ويُعاد
صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "ذاكرة"،
        "يستدعي عناصر من ذاكرة نواة بحسب استعلام ونوع"،
        {"مخزن": "خريطة"، "استعلام": "نص"، "حد": "رقم"، "نوع": "نص"}،
        {"عناصر": "قائمة"}،
        دالة(مدخل) { ارجع {"عناصر": استدعِ(مدخل["مخزن"]، مدخل["استعلام"]، مدخل["حد"]، مدخل["نوع"])} }
    ))
}
