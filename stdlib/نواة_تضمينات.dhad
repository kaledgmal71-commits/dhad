# ضاد/نواة_تضمينات — مُرمِّز دلالي تتعلمه نواة وقت التشغيل من نصوصها هي: جدول تضمين رموز + متوسط + تطبيع L2،
# يُدرَّب بخسارة تقابلية (InfoNCE متناظرة) على أزواج (مقطع قصير، النص الذي أُخذ منه) داخل الدفعة.
# يُستعمل للبحث الدلالي: متجهات الاستعلام والمقاطع أحادية الطول فالضرب الداخلي = تشابه جيب التمام.

متغير م = استورد("ضاد/مصفوفات")
متغير ت = استورد("ضاد/تفاضل")
متغير ر = استورد("ضاد/رياضيات")
متغير ح = استورد("ضاد/محسنات")
متغير ز = استورد("ضاد/نواة_مجزئ")

صدّر دالة نموذج(مجزئ، أبعاد، مولد، أقصى_رموز = ٢٥٦) {
    ارجع {"مجزئ": مجزئ، "أبعاد": أبعاد، "أقصى": أقصى_رموز،
        "جدول": ت.معامل(م.عشوائي_طبيعي([ز.حجم(مجزئ)، أبعاد]، مولد، ١ / جذر(أبعاد)))}
}

# معرّفات النص (مقصوصة)
صدّر دالة رموز_نص(ن، نص_) {
    متغير كل = ز.رمّز(ن["مجزئ"]، نص_)
    إذا (طول(كل) <= ن["أقصى"]) { ارجع كل }
    متغير خ = []
    من_أجل (ي في مدى(ن["أقصى"])) { أضف(خ، كل[ي]) }
    ارجع خ
}

# متجه أحادي الطول قابل للاشتقاق من معرّفات (النص الفارغ يأخذ رمز <unk>)
صدّر دالة متجه(ن، معرفات) {
    متغير ع = معرفات
    إذا (طول(ع) == ٠) { ع = [ز.معرّف_خاص(ن["مجزئ"]، "<unk>")] }
    متغير س = ت.متوسط(ت.تضمين(ن["جدول"]، ع)، ٠، صحيح)
    متغير معيار = ت.جذر_تربيعي(ت.جمع(ت.مجموع(ت.مربع(س)، لاشيء، صحيح)، ت.ثابت(م.أنشئ([١، ١]، ٠.٠٠٠٠٠٠٠٠١))))
    ارجع ت.قسمة(س، معيار)
}

# خسارة تقابلية متناظرة لدفعة: أزواج = [[معرفات_استعلام، معرفات_مفتاح]، …]؛ التشابه يُقسَم على الحرارة
صدّر دالة خسارة_دفعة(ن، أزواج، حرارة) {
    متغير ق = []
    متغير ك = []
    متغير هدف = []
    من_أجل (ي في مدى(طول(أزواج))) {
        أضف(ق، متجه(ن، أزواج[ي][٠]))
        أضف(ك، متجه(ن، أزواج[ي][١]))
        أضف(هدف، ي)
    }
    متغير س = ت.مقياس(ت.ضرب_مصفوفي(ت.ضمّ(ق، ٠)، ت.منقول(ت.ضمّ(ك، ٠)))، ١ / حرارة)
    ارجع ت.مقياس(ت.جمع(ت.خسارة_متقاطعة(س، هدف)، ت.خسارة_متقاطعة(ت.منقول(س)، هدف))، ٠.٥)
}

# تدريب: خيارات {"معدل"، "خطوات"، "دفعة"، "حرارة"}. يرجع قائمة الخسائر.
صدّر دالة درّب(ن، أزواج، خيارات، مولد) {
    متغير معدل = ٠.٠٣
    متغير خطوات = ١٠٠
    متغير دفعة = ٣٢
    متغير حرارة = ٠.٠٥
    إذا (يحوي(خيارات، "معدل")) { معدل = خيارات["معدل"] }
    إذا (يحوي(خيارات، "خطوات")) { خطوات = خيارات["خطوات"] }
    إذا (يحوي(خيارات، "دفعة")) { دفعة = خيارات["دفعة"] }
    إذا (يحوي(خيارات، "حرارة")) { حرارة = خيارات["حرارة"] }
    متغير مح = ح.آدم([ن["جدول"]]، معدل)
    متغير خسائر = []
    متغير مؤشر = ٠
    من_أجل (خ في مدى(خطوات)) {
        ح.اضبط_المعدل(مح، ح.جدول_جيبي(خ، خطوات، ٥، معدل، معدل * ٠.٠٥))
        ت.صفّر_تدرجات([ن["جدول"]])
        متغير ب = []
        من_أجل (ي في مدى(دفعة)) { أضف(ب، أزواج[(مؤشر + ي) % طول(أزواج)]) }
        مؤشر = (مؤشر + دفعة) % طول(أزواج)
        متغير خسارة = خسارة_دفعة(ن، ب، حرارة)
        ت.انتشر_خلفا(خسارة)
        ح.خطوة(مح)
        أضف(خسائر، خسارة["قيمة"]["بيانات"][٠])
    }
    ارجع خسائر
}

# ---------- الفهرسة والاسترجاع (أرقام عادية بلا تفاضل) ----------
صدّر دالة فهرس(ن، نصوص) {
    متغير خ = []
    من_أجل (ص في نصوص) { أضف(خ، متجه(ن، رموز_نص(ن، ص))["قيمة"]["بيانات"]) }
    ارجع خ
}

صدّر دالة متجه_نص(ن، نص_) { ارجع متجه(ن، رموز_نص(ن، نص_))["قيمة"]["بيانات"] }

# أعلى «ك» مقاطع تشابهًا: قائمة [فهرس، تشابه] مرتّبة تنازليًّا (التعادل: الأصغر فهرسًا)
صدّر دالة استرجع(متجهات، استعلام، ك) {
    متغير درجات = []
    من_أجل (ي في مدى(طول(متجهات))) {
        متغير مج = ٠
        من_أجل (ب في مدى(طول(استعلام))) { مج = مج + استعلام[ب] * متجهات[ي][ب] }
        أضف(درجات، مج)
    }
    متغير ترتيب = []
    من_أجل (ي في مدى(طول(درجات))) {
        متغير موضع = طول(ترتيب)
        أضف(ترتيب، ي)
        طالما (موضع > ٠ و درجات[ترتيب[موضع - ١]] < درجات[ي]) { ترتيب[موضع] = ترتيب[موضع - ١]; موضع = موضع - ١ }
        ترتيب[موضع] = ي
    }
    متغير خ = []
    من_أجل (ي في مدى(ك)) { إذا (ي < طول(ترتيب)) { أضف(خ، [ترتيب[ي]، درجات[ترتيب[ي]]]) } }
    ارجع خ
}

# أوزان للتصدير (للعامل في المتصفح): جدول مسطح وأبعاده
صدّر دالة أوزان(ن) { ارجع {"أبعاد": ن["أبعاد"]، "مفردات": ز.حجم(ن["مجزئ"])، "جدول": ن["جدول"]["قيمة"]["بيانات"]} }
