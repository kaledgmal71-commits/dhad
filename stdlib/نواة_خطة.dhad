# ضاد/نواة_خطة — تفكيك الطلب المركّب إلى خطوات متتابعة (ثم، وبعدها، بعد ذلك) ليُنفَّذ كل منها بدوره بحالة الجلسة نفسها.
# عامة: لا تعرف لغة ولا محركًا. تفكّك ولا تنفّذ؛ التنفيذ والتحقق وشرط التوقف عند الجلسة.
# حدّ الخطوات سقف تنفيذ صريح، وما فوقه لا يُنفَّذ ويُعلَن.

متغير ح٠ = استورد("ضاد/نواة_حوار")

متغير _سقف = ٤

صدّر دالة سقف() { ارجع _سقف }

# كلمة تفصل بين خطوتين؟ (ي: موضعها، ك: كلمات الطلب) — يعيد عدد الكلمات التي يستهلكها الفاصل أو ٠
دالة _فاصل(ك، ي) {
    متغير ح = ك[ي]
    إذا (ح == "ثم" أو ح == "ثمّ" أو ح == "وبعدها" أو ح == "بعدها") { ارجع ١ }
    إذا ((ح == "بعد" أو ح == "وبعد") و ي + ١ < طول(ك) و ك[ي + ١] == "ذلك") { ارجع ٢ }
    ارجع ٠
}

دالة _جرّد_الفاصلة(نص_) {
    متغير س = نص_
    طالما (طول(س) > ٠ و (س[طول(س) - ١] == "،" أو س[طول(س) - ١] == ",")) { س = س[٠:طول(س) - ١] }
    ارجع س
}

# يفكّك الطلب إلى خطوات؛ إن لم يكن مركّبًا (أو كانت إحدى خطواته غير صالحة) يعيد [الطلب] كما هو.
# كتل الشيفرة لا تُفكَّك من داخلها. الخطوة صالحة إن كان فيها كلمتان فأكثر أو كانت متابعة («شغّله»، «اشرحه»).
صدّر دالة فكّك(طلب) {
    متغير س = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    متغير كتل = []
    متغير نص_ = طلب
    إذا (يحوي(طلب، س)) {
        متغير أجزاء = افصل(طلب، س)
        إذا (طول(أجزاء) % ٢ == ٠) { ارجع [طلب] }
        نص_ = ""
        متغير داخل = خطأ
        من_أجل (ج في أجزاء) {
            إذا (داخل) {
                نص_ = نص_ + "@@" + نص(طول(كتل)) + "@@"
                أضف(كتل، س + ج + س)
            } وإلا { نص_ = نص_ + ج }
            داخل = ليس داخل
        }
    }
    متغير كلمات = []
    من_أجل (ك في افصل(نص_، " ")) { إذا (ك != "") { أضف(كلمات، ك) } }
    متغير أقسام = []
    متغير حالي = []
    متغير ي = ٠
    طالما (ي < طول(كلمات)) {
        متغير ن٢ = _فاصل(كلمات، ي)
        إذا (ن٢ > ٠) {
            إذا (طول(حالي) > ٠) { أضف(أقسام، اربط(حالي، " ")); حالي = [] }
            ي = ي + ن٢
        } وإلا {
            أضف(حالي، كلمات[ي])
            ي = ي + ١
        }
    }
    إذا (طول(حالي) > ٠) { أضف(أقسام، اربط(حالي، " ")) }
    إذا (طول(أقسام) < ٢) { ارجع [طلب] }
    متغير خرج = []
    من_أجل (ق في أقسام) {
        متغير ص = _جرّد_الفاصلة(ق)
        من_أجل (ب في مدى(طول(كتل))) { ص = استبدل(ص، "@@" + نص(ب) + "@@"، كتل[ب]) }
        متغير عدد_كلمات = ٠
        من_أجل (ك في افصل(ص، " ")) { إذا (ك != "") { عدد_كلمات = عدد_كلمات + ١ } }
        إذا (عدد_كلمات < ٢ و ح٠.متابعة(ص) == "") { ارجع [طلب] }
        أضف(خرج، ص)
    }
    ارجع خرج
}
