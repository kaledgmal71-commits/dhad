# ضاد/نواة_مولد_فهم — من وصف عربي إلى دالة ضاد (ت١): توقيع بقواعد + رؤوس فهم مُدرَّبة (نواة_مصنف) + مُصدِر (نواة_مولد) + تحقق بالتنفيذ.
# ما يُرفض: وصف بلا توقيع، ثقة دون العتبة، ثابت لازم لم يوجد، أو شيفرة لا تمرّ بفحص الصياغة. لا تخمين ولا استرجاع لشيفرة مخزَّنة.
# الحدّ: يفهم ما في فضاء المواصفات (قوائم ومدى وأرقام ونصوص وصيغ)؛ ما خرج عنه يُرفض بسبب صريح.

متغير مصدر_ = استورد("ضاد/نواة_مولد")
متغير مصنف_ = استورد("ضاد/نواة_مصنف")
متغير أوزان_ = استورد("ضاد/نواة_مولد_أوزان")

متغير _عتبة_عائلة = ٤ / ١٠
متغير _عتبة_رأس = ٣ / ١٠
متغير _ترقيم = ["،"، ","، "."، "؟"، "?"، "!"، ":"، "؛"، ";"، "("، ")"]
متغير _أرقام = "٠١٢٣٤٥٦٧٨٩0123456789"

دالة _هل_رقم(ح) { ارجع يحوي(_أرقام، ح) }

# يقصّ الفراغ من الطرفين
دالة _قص(ن) {
    متغير ب = ٠
    متغير ه = طول(ن)
    طالما (ب < ه و ن[ب] == " ") { ب = ب + ١ }
    طالما (ه > ب و ن[ه - ١] == " ") { ه = ه - ١ }
    ارجع ن[ب:ه]
}

دالة _نظّف(ك) {
    متغير ن٢ = ك
    طالما (طول(ن٢) > ٠ و يحوي(_ترقيم، ن٢[٠])) { ن٢ = ن٢[١:طول(ن٢)] }
    طالما (طول(ن٢) > ٠ و يحوي(_ترقيم، ن٢[طول(ن٢) - ١])) { ن٢ = ن٢[٠:طول(ن٢) - ١] }
    ارجع ن٢
}

دالة _وحّد_فراغ(ن) {
    متغير خ = []
    من_أجل (ك في افصل(ن، " ")) { إذا (ك != "") { أضف(خ، ك) } }
    ارجع اربط(خ، " ")
}

دالة _قائمة_معاملات(ن) {
    متغير خ = []
    من_أجل (ك في افصل(استبدل(ن، "،"، ",")، ",")) {
        متغير ص = _قص(ك)
        إذا (ص != "") { أضف(خ، ص) }
    }
    ارجع خ
}

# يفصل التوقيع عن الوصف: {وُجد، اسم، معاملات، متن}
دالة _جزّئ_توقيع(نص_) {
    متغير ن = طول(نص_)
    متغير ب = -١
    من_أجل (ي في مدى(ن)) {
        إذا (ب < ٠ و ي > ٠ و نص_[ي] == "(") {
            إذا (نص_[ي - ١] != " ") { ب = ي }
        }
    }
    إذا (ب >= ٠) {
        متغير بداية = ب
        طالما (بداية > ٠ و نص_[بداية - ١] != " ") { بداية = بداية - ١ }
        متغير نهاية = ب
        طالما (نهاية < ن و نص_[نهاية] != ")") { نهاية = نهاية + ١ }
        متغير اسم_ = _نظّف(نص_[بداية:ب])
        متغير ق = نص_[٠:بداية] + " " + نص_[نهاية + ١:ن]
        ارجع {"وُجد": صحيح، "اسم": اسم_، "معاملات": _قائمة_معاملات(نص_[ب + ١:نهاية])، "متن": _وحّد_فراغ(ق)}
    }
    # الصيغة «اسمها X تأخذ (..)»
    متغير كلمات = افصل(نص_، " ")
    من_أجل (ي في مدى(طول(كلمات) - ١)) {
        إذا (كلمات[ي] == "اسمها") {
            متغير اسم_ = _نظّف(كلمات[ي + ١])
            متغير ر = -١
            متغير ي٢ = ٠
            من_أجل (ح في نص_) { إذا (ر < ٠ و ح == "(") { ر = ي٢ }; ي٢ = ي٢ + ١ }
            إذا (ر >= ٠) {
                متغير ن٣ = ر
                طالما (ن٣ < ن و نص_[ن٣] != ")") { ن٣ = ن٣ + ١ }
                متغير بقية = []
                من_أجل (ج في مدى(ي)) { أضف(بقية، كلمات[ج]) }
                متغير بعد = _وحّد_فراغ(نص_[ن٣ + ١:ن])
                ارجع {"وُجد": صحيح، "اسم": اسم_، "معاملات": _قائمة_معاملات(نص_[ر + ١:ن٣])، "متن": _وحّد_فراغ(اربط(بقية، " ") + " " + بعد)}
            }
        }
    }
    ارجع {"وُجد": خطأ، "اسم": ""، "معاملات": []، "متن": _وحّد_فراغ(نص_)}
}

# قيمة العدد في كلمة أو لاشيء
دالة _قيمة(ك) {
    متغير ص = ك
    متغير س = ١
    إذا (طول(ص) > ١ و ص[٠] == "-") { س = -١; ص = ص[١:طول(ص)] }
    إذا (طول(ص) == ٠) { ارجع لاشيء }
    متغير ق = ٠
    من_أجل (ح في ص) {
        إذا (ليس _هل_رقم(ح)) { ارجع لاشيء }
        من_أجل (ي في مدى(١٠)) { إذا ("٠١٢٣٤٥٦٧٨٩"[ي] == ح أو "0123456789"[ي] == ح) { ق = ق * ١٠ + ي } }
    }
    ارجع س * ق
}

# المعامل المقصود بالكلمة (بعد نزع «و» و«لـ» و«بـ») أو لاشيء؛ لا يشمل المعامل الأول (المصدر)
دالة _معامل_في(ك، معاملات) {
    من_أجل (ي في مدى(طول(معاملات))) {
        إذا (ي > ٠) {
            متغير ف = معاملات[ي]
            إذا (ك == ف) { ارجع ف }
            إذا (طول(ك) > طول(ف) و ك[طول(ك) - طول(ف):طول(ك)] == ف) {
                متغير ب = ك[٠:طول(ك) - طول(ف)]
                إذا (ب == "و" أو ب == "لـ" أو ب == "بـ" أو ب == "ل" أو ب == "ب" أو ب == "وبـ" أو ب == "ولـ") { ارجع ف }
            }
        }
    }
    ارجع لاشيء
}

# عدد مكتوب بالكلمات (للتكرار) أو لاشيء
دالة _كلمة_عدد(ك) {
    إذا (ك == "مرتين") { ارجع ٢ }
    إذا (ك == "ثلاث" أو ك == "ثلاثا" أو ك == "ثلاثة") { ارجع ٣ }
    إذا (ك == "أربع" أو ك == "أربعا" أو ك == "أربعة") { ارجع ٤ }
    إذا (ك == "خمس" أو ك == "خمسا" أو ك == "خمسة") { ارجع ٥ }
    ارجع لاشيء
}

# المعاملات الثابتة (أعداد أو أسماء معاملات) بترتيب ورودها في المتن
دالة _أطراف(متن، معاملات، عائلة) {
    متغير ك = []
    من_أجل (ج في افصل(متن، " ")) {
        متغير ص = _نظّف(ج)
        إذا (ص != "") { أضف(ك، ص) }
    }
    متغير خ = []
    متغير ي = ٠
    طالما (ي < طول(ك)) {
        متغير ص = ك[ي]
        متغير س = ١
        متغير ص٢ = ص
        متغير استهلك = ١
        متغير ص_إشارة = ص
        من_أجل (ب في ["ولـ"، "وبـ"، "لـ"، "بـ"، "و"]) {
            إذا (طول(ص) > طول(ب) و ص[٠:طول(ب)] == ب و ص[طول(ب):طول(ص)] == "سالب") { ص_إشارة = "سالب" }
        }
        إذا (ص_إشارة == "سالب" و ي + ١ < طول(ك) و _قيمة(ك[ي + ١]) != لاشيء) {
            ص٢ = ك[ي + ١]
            س = -١
            استهلك = ٢
        }
        متغير تم = خطأ
        من_أجل (ب في ["ولـ"، "وبـ"، "لـ"، "بـ"، "و"]) {
            إذا (ليس تم و طول(ص٢) > طول(ب) و ص٢[٠:طول(ب)] == ب و _قيمة(ص٢[طول(ب):طول(ص٢)]) != لاشيء) {
                ص٢ = ص٢[طول(ب):طول(ص٢)]
                تم = صحيح
            }
        }
        متغير ق = _قيمة(ص٢)
        إذا (ق == لاشيء و عائلة == "نص") { ق = _كلمة_عدد(ص) }
        إذا (ق != لاشيء) {
            متغير تالي = ""
            إذا (ي + استهلك < طول(ك)) { تالي = ك[ي + استهلك] }
            متغير سابق = ""
            إذا (ي > ٠) { سابق = ك[ي - ١] }
            متغير إشارة_مدى = (سابق == "من" أو سابق == "بين") و ق == ١ و (تالي == "إلى" أو تالي == "حتى" أو (طول(تالي) > ٠ و تالي[٠] == "و"))
            إذا (ليس (عائلة == "مدى" و إشارة_مدى)) { أضف(خ، {"قيمة": س * ق}) }
        } وإلا {
            متغير م = _معامل_في(ص٢، معاملات)
            إذا (م != لاشيء) { أضف(خ، {"معامل": م}) }
        }
        ي = ي + استهلك
    }
    ارجع خ
}

دالة _صنّف(رأس، متن) { ارجع مصنف_.صنّف(أوزان_.نموذج(رأس)، متن) }

دالة _يحتاج_ك_مرشح(ن) { ارجع يحوي(["أكبر"، "أكبر_أو_يساوي"، "أصغر"، "أصغر_أو_يساوي"، "يساوي"، "يقبل_القسمة"]، ن) }
دالة _يحتاج_ك_محمول(ن) { ارجع يحوي(["يقبل_القسمة"، "أكبر"، "أصغر"، "أكبر_أو_يساوي"، "أصغر_أو_يساوي"، "يساوي"]، ن) }

دالة _رفض(سبب، تفاصيل) { ارجع {"مواصفة": لاشيء، "سبب": سبب، "تفاصيل": تفاصيل} }

# يفهم الوصف؛ توقيع_مفروض: {اسم، معاملات} أو لاشيء (للإصلاح: من الشيفرة المعطوبة)
صدّر دالة افهم(وصف، توقيع_مفروض) {
    متغير ت = _جزّئ_توقيع(وصف)
    متغير اسم_ = ت["اسم"]
    متغير معاملات = ت["معاملات"]
    إذا (توقيع_مفروض != لاشيء) {
        اسم_ = توقيع_مفروض["اسم"]
        معاملات = توقيع_مفروض["معاملات"]
    } وإلا إذا (ليس ت["وُجد"]) {
        ارجع _رفض("لا توقيع"، "")
    }
    إذا (اسم_ == "" أو طول(معاملات) == ٠) { ارجع _رفض("توقيع ناقص"، اسم_) }
    متغير متن = ت["متن"]
    متغير ف = _صنّف("عائلة"، متن)
    إذا (ف["ثقة"] < _عتبة_عائلة) { ارجع _رفض("ثقة العائلة ضعيفة"، نص(ف["ثقة"])) }
    متغير عائلة = ف["فئة"]
    إذا (عائلة == "خارج") { ارجع _رفض("خارج فضاء المواصفات"، "") }
    متغير م = {"عائلة": عائلة، "اسم": اسم_، "معاملات": معاملات}
    إذا (عائلة == "قائمة" أو عائلة == "مدى") {
        متغير مر = _صنّف("مرشح"، متن)
        متغير تح = _صنّف("تحويل"، متن)
        متغير اخ = _صنّف("اختزال"، متن)
        إذا (مر["ثقة"] < _عتبة_رأس أو تح["ثقة"] < _عتبة_رأس أو اخ["ثقة"] < _عتبة_رأس) { ارجع _رفض("ثقة المسار ضعيفة"، "") }
        متغير نوع_م = مر["فئة"]
        متغير نوع_ت = تح["فئة"]
        متغير نوع_ا = اخ["فئة"]
        إذا (ليس يحوي(["مجموع"، "ضرب"، "قائمة"، "متوسط"، "عكس"، "ترتيب"، "فريد"]، نوع_ا)) { نوع_ت = "بلا" }
        إذا ((نوع_ا == "يوجد" أو نوع_ا == "الكل") و نوع_م == "بلا") { ارجع _رفض("اختزال يتطلب شرطًا"، نوع_ا) }
        متغير أط = _أطراف(متن، معاملات، عائلة)
        متغير ض = ٠
        م["مرشح"] = {"نوع": نوع_م}
        م["تحويل"] = {"نوع": نوع_ت}
        م["اختزال"] = {"نوع": نوع_ا}
        إذا (_يحتاج_ك_مرشح(نوع_م)) {
            إذا (ض >= طول(أط)) { ارجع _رفض("ثابت المرشح مفقود"، نوع_م) }
            م["مرشح"]["ك"] = أط[ض]
            ض = ض + ١
        }
        إذا (نوع_ت == "زائد" أو نوع_ت == "ضرب") {
            إذا (ض >= طول(أط)) { ارجع _رفض("ثابت التحويل مفقود"، نوع_ت) }
            م["تحويل"]["ك"] = أط[ض]
        }
        ارجع {"مواصفة": م، "سبب": ""}
    }
    متغير رأس = ""
    إذا (عائلة == "محمول") { رأس = "محمول" }
    إذا (عائلة == "أرقام") { رأس = "أرقام" }
    إذا (عائلة == "نص") { رأس = "نص" }
    إذا (عائلة == "صيغة") { رأس = "صيغة" }
    متغير ر = _صنّف(رأس، متن)
    إذا (ر["ثقة"] < _عتبة_رأس) { ارجع _رفض("ثقة النوع ضعيفة"، عائلة) }
    متغير نوع = ر["فئة"]
    إذا (عائلة == "نص" و نوع == "دمج_بمسافة") { نوع = "دمج"; م["بمسافة"] = ١ }
    م["نوع"] = نوع
    متغير أط٢ = _أطراف(متن، معاملات، عائلة)
    إذا (عائلة == "محمول") {
        إذا (نوع == "بين") {
            إذا (طول(أط٢) < ٢) { ارجع _رفض("حدّا المدى مفقودان"، "") }
            م["ك_أ"] = أط٢[٠]
            م["ك_ب"] = أط٢[١]
        } وإلا إذا (_يحتاج_ك_محمول(نوع)) {
            إذا (طول(أط٢) < ١) { ارجع _رفض("ثابت المحمول مفقود"، نوع) }
            م["ك"] = أط٢[٠]
        }
    }
    إذا (عائلة == "نص" و نوع == "تكرار_ثابت") {
        إذا (طول(أط٢) < ١) { ارجع _رفض("عدد التكرار مفقود"، نوع) }
        م["ك"] = أط٢[٠]
    }
    إذا (عائلة == "صيغة" و (نوع == "زائد_ثابت" أو نوع == "ضرب_ثابت" أو نوع == "طرح_ثابت")) {
        إذا (طول(أط٢) < ١) { ارجع _رفض("ثابت الصيغة مفقود"، نوع) }
        م["ك"] = أط٢[٠]
    }
    # عدد المعاملات يوافق النوع
    متغير مطلوب = ٠
    إذا (عائلة == "أرقام") { مطلوب = ١ }
    إذا (عائلة == "محمول") {
        مطلوب = ١
        إذا (يحوي(م، "ك") و يحوي(م["ك"]، "معامل")) { مطلوب = ٢ }
        إذا (نوع == "بين" و يحوي(م["ك_أ"]، "معامل")) { مطلوب = ٣ }
    }
    إذا (عائلة == "صيغة") {
        إذا (يحوي(["جمع"، "طرح"، "ضرب"، "قسمة"، "باقي"، "قوة"، "أكبر"، "أصغر"، "متوسط"، "محيط"، "مساحة_مثلث"، "فرق_مطلق"، "قاسم_مشترك"، "مضاعف_مشترك"]، نوع)) { مطلوب = ٢ }
        وإلا إذا (يحوي(["جمع٣"، "أكبر٣"، "أصغر٣"، "متوسط٣"، "ضرب٣"]، نوع)) { مطلوب = ٣ }
        وإلا { مطلوب = ١ }
    }
    إذا (عائلة == "نص") {
        مطلوب = ١
        إذا (يحوي(["عدد_حرف"، "يحوي"، "دمج"، "تكرار"]، نوع)) { مطلوب = ٢ }
    }
    إذا (مطلوب > ٠ و طول(معاملات) < مطلوب) { ارجع _رفض("معاملات أقل من اللازم"، نص(مطلوب)) }
    ارجع {"مواصفة": م، "سبب": ""}
}

# يولّد: {حالة: ناجح|مرفوض|فاشل، شيفرة، سبب}
صدّر دالة ولّد(وصف، توقيع_مفروض) {
    متغير ف = افهم(وصف، توقيع_مفروض)
    إذا (ف["مواصفة"] == لاشيء) { ارجع {"حالة": "مرفوض"، "شيفرة": ""، "سبب": ف["سبب"]} }
    متغير شيفرة = مصدر_.ابنِ(ف["مواصفة"])
    إذا (شيفرة == لاشيء) { ارجع {"حالة": "مرفوض"، "شيفرة": ""، "سبب": "لا مُصدِر للمواصفة"} }
    إذا (نواة_فحص_صياغة(شيفرة) != "كامل") { ارجع {"حالة": "فاشل"، "شيفرة": شيفرة، "سبب": "صياغة"} }
    متغير خ = نفّذ(شيفرة، ٢٠٠٠٠٠، ٢٠٠٠)
    من_أجل (ل في خ) {
        إذا (طول(ل) >= ٥ و ل[٠:٥] == "خطأ: ") { ارجع {"حالة": "فاشل"، "شيفرة": شيفرة، "سبب": "تشغيل"} }
    }
    ارجع {"حالة": "ناجح"، "شيفرة": شيفرة، "سبب": "", "مواصفة": ف["مواصفة"]}
}

# يستخرج {اسم، معاملات} من رأس دالة معطوبة
صدّر دالة توقيع_شيفرة(شيفرة) {
    متغير سطر = افصل(شيفرة، حرف(١٠))[٠]
    متغير ت = _جزّئ_توقيع(سطر)
    إذا (ليس ت["وُجد"]) { ارجع لاشيء }
    متغير ا = ت["اسم"]
    إذا (طول(ا) > ٣ و ا[٠:٤] == "دالة") { ا = _قص(ا[٤:طول(ا)]) }
    ارجع {"اسم": ا، "معاملات": ت["معاملات"]}
}

# الإصلاح: يُعاد بناء الدالة من وصف السلوك بتوقيع الشيفرة المعطوبة
صدّر دالة أصلح(وصف، معطوب) {
    متغير ت = توقيع_شيفرة(معطوب)
    إذا (ت == لاشيء) { ارجع {"حالة": "مرفوض"، "شيفرة": ""، "سبب": "لا توقيع في المعطوب"} }
    ارجع ولّد(وصف، ت)
}

# واجهات فحص (تُستعمل في tools/t1_strip_test.js)
صدّر دالة جزّئ(نص_) { ارجع _جزّئ_توقيع(نص_) }
صدّر دالة أطراف(متن، معاملات، عائلة) { ارجع _أطراف(متن، معاملات، عائلة) }

# تشخيص معايرة الثقة: أدنى ثقة بين رؤوس القرار لوصف معيّن (للقياس والمعايرة لا للإنتاج)
صدّر دالة تشخيص(وصف) {
    متغير ت = _جزّئ_توقيع(وصف)
    متغير ف = _صنّف("عائلة"، ت["متن"])
    متغير أدنى = ف["ثقة"]
    متغير ع = ف["فئة"]
    إذا (ع == "قائمة" أو ع == "مدى") {
        من_أجل (ه في ["مرشح"، "تحويل"، "اختزال"]) {
            متغير ر = _صنّف(ه، ت["متن"])
            إذا (ر["ثقة"] < أدنى) { أدنى = ر["ثقة"] }
        }
    } وإلا إذا (ع != "خارج") {
        متغير ر = _صنّف(ع، ت["متن"])
        إذا (ر["ثقة"] < أدنى) { أدنى = ر["ثقة"] }
    }
    ارجع {"عائلة": ع، "ثقة_عائلة": ف["ثقة"]، "أدنى": أدنى}
}
