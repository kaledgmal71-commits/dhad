# ضاد/نواة_مخطوطات — يسجّل محركات الرسم والمقابلة والصرف والإملاء والتخريج والكشّاف في سجل نواة، ويفهم الطلب الصريح بها من المحادثة.
# لا يستولي على الطلبات العادية: لكل محرك عبارات صريحة، فإن وُجدت العبارة ونقصت المعطيات سأل عنها بجملة قصيرة، وإن لم توجد العبارة تُرك الطلب لبقية المنسّق.
# المصادر: المقتطف بين « » أو بين علامتي تنصيص، وإلا الملفات المرفقة بالترتيب. التخريج يبحث في المرفقات ثم المكتبة المربوطة.

متغير ن = استورد("ضاد/نصوص")
متغير ع = استورد("ضاد/نواة_عقد")
متغير مقابلة = استورد("ضاد/نواة_مقابلة")
متغير صرف = استورد("ضاد/نواة_صرف")
متغير إملاء = استورد("ضاد/نواة_إملاء")
متغير كشاف_ = استورد("ضاد/نواة_كشاف")
متغير رسم_ = استورد("ضاد/نواة_رسم")

متغير _أقصى_كلمات_المقابلة = ٨٠٠
متغير _ذاكرة_الفهرس = {"توقيع": ""، "فهرس": لاشيء}

صدّر دالة سجّل_المحركات() {
    متغير موجود = ع.المحركات()
    إذا (ليس يحوي(موجود، "مقابلة_نقدية")) {
        ع.سجّل(ع.محرك("مقابلة_نقدية"، "يحاذي نسختين كلمةً كلمة ويصنّف الفروق ويصوغ الحواشي"، {"أصل": "نص"، "شاهد": "نص"، "رمز": "نص"}، {"فروق": "قائمة"، "حواش": "نص"، "ملخص": "خريطة"}،
            دالة(م) {
                متغير ف = مقابلة.قابل(م["أصل"]، م["شاهد"]، م["رمز"])
                ارجع {"فروق": ف، "حواش": مقابلة.صغ_الحواشي(ف)، "ملخص": مقابلة.ملخص(ف)}
            }))
    }
    إذا (ليس يحوي(موجود، "تحليل_صرفي")) {
        ع.سجّل(ع.محرك("تحليل_صرفي"، "يعدّد تحليلات الكلمة (بادئة وجذع ولاحقة ووزن وجذر) بثقة لكل تحليل"، {"كلمة": "نص"}، {"تحليلات": "قائمة"}، دالة(م) { ارجع {"تحليلات": صرف.حلّل(م["كلمة"]، {"أقصى": ٤})} }))
    }
    إذا (ليس يحوي(موجود، "تدقيق_إملائي")) {
        ع.سجّل(ع.محرك("تدقيق_إملائي"، "يقترح تصحيحات الرسم الإملائي والتراثي ولا يطبّق الغامض"، {"نص": "نص"}، {"اقتراحات": "قائمة"، "مصحَّح": "نص"}،
            دالة(م) {
                متغير ق = إملاء.اقترح(م["نص"])
                ارجع {"اقتراحات": ق، "مصحَّح": إملاء.طبّق(م["نص"]، ق، خطأ)}
            }))
    }
    إذا (ليس يحوي(موجود، "تخريج_اقتباس")) {
        ع.سجّل(ع.محرك("تخريج_اقتباس"، "يجد الاقتباس في فقرات المكتبة ويعزوه إلى ما وُجد فيه فعلًا"، {"فقرات": "قائمة"، "اقتباس": "نص"}، {"حالة": "نص"، "نتائج": "قائمة"}، دالة(م) { ارجع _خرّج(م["فقرات"]، م["اقتباس"]) }))
    }
    إذا (ليس يحوي(موجود، "كشاف_نص")) {
        ع.سجّل(ع.محرك("كشاف_نص"، "يستخرج الأعلام والأماكن والكتب والآيات والاقتباسات من النص"، {"نص": "نص"}، {"أعلام": "قائمة"، "أماكن": "قائمة"، "كتب": "قائمة"، "آيات": "قائمة"، "اقتباسات": "قائمة"}، دالة(م) { ارجع كشاف_.كشاف(م["نص"]) }))
    }
    ارجع ع.المحركات()
}

دالة _خرّج(فقرات، اقتباس) {
    متغير توقيع = نص(طول(فقرات))
    إذا (طول(فقرات) > ٠) { توقيع = توقيع + ":" + نص(فقرات[٠]["معرف"]) + ":" + نص(فقرات[طول(فقرات) - ١]["معرف"]) }
    إذا (_ذاكرة_الفهرس["توقيع"] != توقيع) {
        _ذاكرة_الفهرس["فهرس"] = كشاف_.ابنِ_فهرس(فقرات)
        _ذاكرة_الفهرس["توقيع"] = توقيع
    }
    ارجع كشاف_.خرّج(_ذاكرة_الفهرس["فهرس"]، اقتباس، لاشيء)
}

# ---------- فهم الطلب ----------

دالة يبدأ_ب_(س، بداية) { ارجع طول(س) >= طول(بداية) و س[٠:طول(بداية)] == بداية }

دالة _فيه(س، عبارات) {
    من_أجل (ب في عبارات) { إذا (يحوي(س، " " + ب + " ")) { ارجع صحيح } }
    ارجع خطأ
}

# المقتطفات: بين « »، وإلا بين علامتي تنصيص
دالة _مقتطفات(طلب) {
    متغير ق = كشاف_.بين_علامتين(طلب، "«"، "»")
    إذا (طول(ق) > ٠) { ارجع ق }
    ارجع كشاف_.بين_علامتين(طلب، حرف(٣٤)، حرف(٣٤))
}

# نصوص المرفقات بترتيب أسمائها: [[اسم، نص]]
دالة _نصوص_المرفقات(مرفقات) {
    متغير خرج = []
    من_أجل (اسم في رتب(مفاتيح(مرفقات["ملفات"]))) { أضف(خرج، [اسم، مرفقات["ملفات"][اسم]]) }
    ارجع خرج
}

دالة _رمز_الملف(اسم) {
    متغير ك = اسم
    متغير ن٠ = طول(ك)
    من_أجل (ي من ٠ إلى ن٠ - ١) { إذا (ك[ي] == ".") { ك = ك[٠:ي]; ارجع ك } }
    ارجع ك
}

دالة _نتيجة(نوع_، رد_، نتائج، خطوة) {
    ارجع {"نوع": نوع_، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": [{"محرك": خطوة، "حالة": "نُفّذ"، "تفصيل": ""}]، "نتائج": نتائج، "ذكريات": []، "رد": رد_}
}

دالة _نسبة(ك) { ارجع نص(أرضية(ك * ١٠٠)) + "٪" }

# يعيد لاشيء إن لم يكن الطلب لأحد هذه المحركات، وإلا النتيجة الجاهزة للمنسّق
صدّر دالة تعامل(طلب، مرفقات، سياق) {
    # الطلب مطبَّعًا كلمةً كلمة بتطبيع المقابلة (بلا تشكيل، ألف واحدة، ة ← ه، ى وئ ← ي) وبلا ترقيم
    متغير مطبعة = []
    من_أجل (ك في كشاف_.كلمات_نقية(طلب)) { أضف(مطبعة، رسم_.طبّع_للمقابلة(ك)) }
    متغير س = " " + اربط(مطبعة، " ") + " "
    متغير مق = _مقتطفات(طلب)
    متغير ملفات = _نصوص_المرفقات(مرفقات)

    # --- المقابلة النقدية ---
    إذا (_فيه(س، ["قابل بين"، "قابل النص"، "قابل النسخ"، "مقابله بين"، "الفروق بين النسخ"، "الفروق بين النصين"، "قارن بين النصين"، "قارن بين النسختين"])) {
        متغير مصادر = []
        من_أجل (ق في مق) { أضف(مصادر، ["ب"، ق]) }
        إذا (طول(مصادر) < ٢) {
            من_أجل (ف في ملفات) { أضف(مصادر، [_رمز_الملف(ف[٠])، ف[١]]) }
        }
        إذا (طول(مصادر) < ٢) {
            ارجع _نتيجة("مقابلة"، "أحتاج نصين لأقابل بينهما: ضع كلًّا منهما بين « » في طلبك، أو أرفق ملفين."، {}، "مقابلة_نقدية")
        }
        إذا (طول(ن.كلمات(مصادر[٠][١])) > _أقصى_كلمات_المقابلة أو طول(ن.كلمات(مصادر[١][١])) > _أقصى_كلمات_المقابلة) {
            ارجع _نتيجة("مقابلة"، "النصان أطول من أن أقابلهما دفعة واحدة؛ الحد " + نص(_أقصى_كلمات_المقابلة) + " كلمة لكل نص. أعطني مقطعًا أقصر منهما."، {}، "مقابلة_نقدية")
        }
        متغير رمز_الشاهد = مصادر[١][٠]
        متغير ن١ = ع.شغّل("مقابلة_نقدية"، {"أصل": مصادر[٠][١]، "شاهد": مصادر[١][١]، "رمز": رمز_الشاهد})["نتيجة"]
        متغير رد_ = "لا فروق بين النسختين."
        إذا (طول(ن١["فروق"]) > ٠) {
            متغير أسطر = ["الفروق بين النسختين (" + نص(طول(ن١["فروق"])) + "):"، ن١["حواش"]]
            متغير عدّاد = []
            من_أجل (نوع_ في مفاتيح(ن١["ملخص"])) { أضف(عدّاد، نوع_ + " " + نص(ن١["ملخص"][نوع_])) }
            أضف(أسطر، "الملخص: " + اربط(رتب(عدّاد)، "، "))
            رد_ = اربط(أسطر، حرف(١٠))
        }
        ارجع _نتيجة("مقابلة"، رد_، {"مقابلة": ن١}، "مقابلة_نقدية")
    }

    # --- التحليل الصرفي ---
    إذا (_فيه(س، ["جذر كلمه"، "ما جذر كلمه"، "تحليل صرفي"، "حلل كلمه"، "حلل صرفيا"، "وزن كلمه"، "ما وزن كلمه"]) أو (يحوي(س، " جذر ") و طول(مق) > ٠)) {
        متغير كلمة = ""
        إذا (طول(مق) > ٠) { كلمة = مق[٠] } وإلا {
            متغير أصلية = كشاف_.كلمات_نقية(طلب)
            من_أجل (ي من ٠ إلى طول(أصلية) - ٢) {
                إذا (كلمة == "" و رسم_.طبّع_للمقابلة(أصلية[ي]) == "كلمه") { كلمة = أصلية[ي + ١] }
            }
        }
        إذا (كلمة == "") { ارجع _نتيجة("صرف"، "أي كلمة أحلّل؟ اكتبها بعد «كلمة» أو بين « »."، {}، "تحليل_صرفي") }
        متغير ح = ع.شغّل("تحليل_صرفي"، {"كلمة": كلمة})["نتيجة"]["تحليلات"]
        إذا (طول(ح) == ٠) {
            ارجع _نتيجة("صرف"، "لم أستخرج تحليلًا للكلمة «" + كلمة + "»: قصيرة جدًا أو على غير أوزاني المعروفة."، {"صرف": []}، "تحليل_صرفي")
        }
        متغير أسطر = []
        إذا (ح[٠]["وزن"] == "مبني") {
            أضف(أسطر، "«" + كلمة + "»: " + ح[٠]["نوع"] + " (كلمة مبنية لا جذر لها).")
        } وإلا {
            أضف(أسطر، "«" + كلمة + "»: أرجح تحليل: " + _وصف_تحليل(ح[٠]) + "، ثقته " + _نسبة(ح[٠]["ثقة"]) + ".")
            من_أجل (ي من ١ إلى طول(ح) - ١) {
                إذا (ح[ي]["ثقة"] >= ٠.١) { أضف(أسطر، "ويحتمل: " + _وصف_تحليل(ح[ي]) + " (" + _نسبة(ح[ي]["ثقة"]) + ").") }
            }
            أضف(أسطر، "التحليل بالأوزان لا بمعجم: إن كان الجذر معتلًّا (أجوف أو ناقصًا) فقد يظهر بصورته السطحية.")
        }
        ارجع _نتيجة("صرف"، اربط(أسطر، حرف(١٠))، {"صرف": ح}، "تحليل_صرفي")
    }

    # --- الإملاء ---
    إذا (_فيه(س، ["صحح الاملاء"، "تدقيق املايي"، "صحح رسم"، "دقق املايي"، "تصحيح الاملاء"، "راجع الاملاء"])) {
        متغير نص_ = ""
        إذا (طول(مق) > ٠) { نص_ = مق[٠] } وإلا إذا (طول(ملفات) > ٠) { نص_ = ملفات[٠][١] }
        إذا (نص_ == "") { ارجع _نتيجة("إملاء"، "ضع النص بين « » أو أرفقه ملفًا لأراجع إملاءه."، {}، "تدقيق_إملائي") }
        متغير ت = ع.شغّل("تدقيق_إملائي"، {"نص": نص_})["نتيجة"]
        إذا (طول(ت["اقتراحات"]) == ٠) {
            ارجع _نتيجة("إملاء"، "لم أجد في النص ما يحتاج تصحيحًا."، {"إملاء": ت}، "تدقيق_إملائي")
        }
        متغير أسطر = []
        من_أجل (ف في ت["اقتراحات"]) {
            متغير ختم = ""
            إذا (ف["غامض"]) { ختم = " — محتمل، لم أطبّقه: " + ف["شرح"] }
            أضف(أسطر، "- «" + ف["أصل"] + "» ← «" + ف["اقتراح"] + "» (" + ف["قاعدة"] + ")" + ختم)
        }
        إذا (ت["مصحَّح"] != نص_) { أضف(أسطر، حرف(١٠) + "النص بعد التصحيح:"); أضف(أسطر، ت["مصحَّح"]) }
        ارجع _نتيجة("إملاء"، اربط(أسطر، حرف(١٠))، {"إملاء": ت}، "تدقيق_إملائي")
    }

    # --- التخريج ---
    إذا (_فيه(س، ["خرج هذا"، "خرج لي"، "خرج الاقتباس"، "خرج النص"، "خرجه"، "تخريج"، "اين ورد"، "اين يوجد هذا"، "في اي ملف ورد"]) أو (طول(مق) > ٠ و يبدأ_ب_(س، " خرج "))) {
        إذا (طول(مق) == ٠) { ارجع _نتيجة("تخريج"، "ضع الاقتباس بين « » لأبحث عن موضعه في ملفاتك."، {}، "تخريج_اقتباس") }
        متغير فقرات = []
        من_أجل (ف في ملفات) {
            متغير رقم = ٠
            من_أجل (سطر في افصل(ف[١]، حرف(١٠))) {
                رقم = رقم + ١
                إذا (طول(ن.كلمات(سطر)) >= ٣) { أضف(فقرات، {"معرف": ف[٠] + "#" + نص(رقم)، "نص": سطر}) }
            }
        }
        إذا (يحوي(سياق، "مقاطع")) {
            من_أجل (م في سياق["مقاطع"]["مرفقات"]) { أضف(فقرات، م) }
            من_أجل (م في سياق["مقاطع"]["مكتبة"]) { أضف(فقرات، م) }
        }
        إذا (طول(فقرات) == ٠) { ارجع _نتيجة("تخريج"، "لا ملفات عندي لأخرّج منها: أرفق ملفًا أو اربط مكتبتك."، {}، "تخريج_اقتباس") }
        متغير خ = ع.شغّل("تخريج_اقتباس"، {"فقرات": فقرات، "اقتباس": مق[٠]})["نتيجة"]
        متغير رد_ = ""
        إذا (خ["حالة"] == "قصير") {
            رد_ = "الاقتباس أقصر من أن يُخرَّج؛ أعطني عبارة من كلمتين على الأقل (والأفضل ثلاث)."
        } وإلا إذا (خ["حالة"] == "لم يوجد") {
            رد_ = "لم أجد هذا الاقتباس في الملفات المرفقة ولا في المكتبة المربوطة."
        } وإلا {
            متغير أسطر = []
            من_أجل (م في خ["نتائج"]) {
                متغير مقتطف = م["نص"]
                إذا (طول(مقتطف) > ٢٤٠) { مقتطف = مقتطف[٠:٢٤٠] + "…" }
                أضف(أسطر، "وُجد في «" + م["معرف"] + "» (تطابق " + _نسبة(م["تطابق"]) + "):")
                أضف(أسطر، "  " + مقتطف)
            }
            رد_ = اربط(أسطر، حرف(١٠))
        }
        ارجع _نتيجة("تخريج"، رد_، {"تخريج": خ}، "تخريج_اقتباس")
    }

    # --- الكشّاف ---
    إذا (_فيه(س، ["استخرج الاعلام"، "استخرج الاماكن"، "كشاف"، "فهرس الاعلام"، "اعلام النص"، "استخرج الكتب"])) {
        متغير نص_ = ""
        إذا (طول(مق) > ٠) { نص_ = مق[٠] } وإلا إذا (طول(ملفات) > ٠) { نص_ = ملفات[٠][١] }
        إذا (نص_ == "") { ارجع _نتيجة("كشاف"، "ضع النص بين « » أو أرفقه ملفًا لأستخرج منه الأعلام والأماكن والكتب."، {}، "كشاف_نص") }
        متغير ك = ع.شغّل("كشاف_نص"، {"نص": نص_})["نتيجة"]
        متغير أسطر = []
        من_أجل ([مفتاح، عنوان] في [["أعلام"، "الأعلام"]، ["أماكن"، "الأماكن"]، ["كتب"، "الكتب"]، ["آيات"، "الآيات"]]) {
            إذا (طول(ك[مفتاح]) > ٠) { أضف(أسطر، عنوان + ": " + اربط(ك[مفتاح]، "، ")) }
        }
        إذا (طول(أسطر) == ٠) { أسطر = ["لم أجد في النص أعلامًا ولا أماكن ولا كتبًا."] }
        ارجع _نتيجة("كشاف"، اربط(أسطر، حرف(١٠))، {"كشاف": ك}، "كشاف_نص")
    }
    ارجع لاشيء
}

دالة _وصف_تحليل(ت) {
    متغير ج = "جذر " + ت["جذر"] + "، وزن " + ت["وزن"]
    إذا (ت["بادئة"] != "" أو ت["لاحقة"] != "") {
        ج = ج + " (" + اربط([ت["بادئة"]، ت["جذع"]، ت["لاحقة"]]، "+") + ")"
    }
    ارجع ج
}
