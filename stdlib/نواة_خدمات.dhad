# ضاد/نواة_خدمات — واجهة الخدمات التي يطلبها التطبيق من المحيط (محركات نواة) بالاسم.
# لا يستدعي التطبيق شيئًا خارج هذا السجل؛ كل خدمة بمدخلات مسمّاة ومعلَنة، والنتيجة {ناجح، نتيجة} أو {ناجح: خطأ، سبب}. لا تُطلق استثناءً.
# «دون_إنترنت»: صحيح للخدمات التي تعمل بلا شبكة. عامة: لا تعرف تطبيقًا بعينه.

متغير ل = استورد("ضاد/نواة_تلخيص")
متغير د = استورد("ضاد/نواة_دراسة")
متغير ي = استورد("ضاد/نواة_نوايا")

متغير _سجل = {}

صدّر دالة سجّل(اسم، وصف، مدخلات، دون_إنترنت، تشغيل) {
    إذا (نوع(اسم) != "نص" أو طول(اسم) == ٠) { أطلق_خطأ("الخدمات: الاسم نص غير فارغ") }
    إذا (نوع(تشغيل) != "دالة") { أطلق_خطأ("الخدمات: التشغيل دالة") }
    _سجل[اسم] = {"اسم": اسم، "وصف": وصف، "مدخلات": مدخلات، "دون_إنترنت": دون_إنترنت، "تشغيل": تشغيل}
}

صدّر دالة المتاحة() {
    متغير خ = []
    من_أجل (ك في مفاتيح(_سجل)) { أضف(خ، ك) }
    ارجع خ
}

صدّر دالة وصف(اسم) {
    إذا (ليس يحوي(_سجل، اسم)) { ارجع لاشيء }
    متغير ر = _سجل[اسم]
    ارجع {"اسم": ر["اسم"]، "وصف": ر["وصف"]، "مدخلات": ر["مدخلات"]، "دون_إنترنت": ر["دون_إنترنت"]}
}

# استدعاء آمن: يتحقق من وجود الخدمة ومن المدخلات المعلَنة (وجودًا ونوعها «نص» أو «رقم» أو «قائمة»)
صدّر دالة استدع(اسم، مدخل) {
    إذا (ليس يحوي(_سجل، اسم)) { ارجع {"ناجح": خطأ، "سبب": "خدمة غير معروفة: " + نص(اسم)} }
    إذا (نوع(مدخل) != "خريطة") { ارجع {"ناجح": خطأ، "سبب": "المدخل خريطة"} }
    متغير ر = _سجل[اسم]
    من_أجل (م في ر["مدخلات"]) {
        إذا (ليس يحوي(مدخل، م[٠])) { ارجع {"ناجح": خطأ، "سبب": "ينقص المدخل «" + م[٠] + "»"} }
        إذا (نوع(مدخل[م[٠]]) != م[١]) { ارجع {"ناجح": خطأ، "سبب": "المدخل «" + م[٠] + "» من نوع «" + م[١] + "»"} }
    }
    حاول {
        ارجع {"ناجح": صحيح، "نتيجة": ر["تشغيل"](مدخل)}
    } التقط (خطأ_) {
        ارجع {"ناجح": خطأ، "سبب": "فشل التشغيل: " + نص(خطأ_)}
    }
}

# الخدمات الأساسية: كلها من محركات نواة نفسها وتعمل دون إنترنت
صدّر دالة سجّل_الأساسية() {
    سجّل("لخّص"، "يلخّص نصًّا بجمل منه"، [["نص"، "نص"]]، صحيح، دالة(م) {
        متغير حد = ٤٠٠
        إذا (يحوي(م، "حد") و نوع(م["حد"]) == "رقم") { حد = م["حد"] }
        متغير ر = ل.لخّص([{"مصدر": "النص"، "نص": م["نص"]}]، ""، حد)
        ارجع {"وُجد": ر["وُجد"]، "نص": ر["نص"]}
    })
    سجّل("اختبار"، "يبني أسئلة اختيار من نص"، [["نص"، "نص"]]، صحيح، دالة(م) {
        متغير عدد_ = ٥
        إذا (يحوي(م، "عدد") و نوع(م["عدد"]) == "رقم") { عدد_ = م["عدد"] }
        ارجع د.اختبار(م["نص"]، عدد_)
    })
    سجّل("صحّح_اختبار"، "يصحّح إجابات اختبار بُني بخدمة «اختبار»"، [["أسئلة"، "قائمة"]، ["إجابات"، "نص"]]، صحيح، دالة(م) {
        متغير ج = د.حلّل_إجابات(م["إجابات"]، طول(م["أسئلة"]))
        إذا (ج == لاشيء) { ارجع {"فهم": خطأ} }
        متغير ر = د.صحّح(م["أسئلة"]، ج)
        ارجع {"فهم": صحيح، "درجة": ر["درجة"]، "من": ر["من"]، "نص": ر["نص"]}
    })
    سجّل("نية"، "يصنّف نية كلام"، [["نص"، "نص"]]، صحيح، دالة(م) {
        ارجع ي.قرّر(م["نص"])
    })
}
