# ضاد/نواة_منسق — منسّق المهام: يحلّل الطلب، يختار المحركات اللازمة من السجل، يشغّلها، ويجمع نتائجها في ردّ واحد.
# لا يدّعي ما لم يُبنَ: المحرك اللازم غير المسجَّل يظهر في الخطة بحالة «غير_متاح» ولا يُختلق له ناتج.
# السياق: {فهرس: فهرس الاسترجاع (اختياري)، ذاكرة: مخزن الذاكرة (اختياري)}

متغير ع = استورد("ضاد/نواة_عقد")
متغير م = استورد("ضاد/نواة_مهام")
متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ذ = استورد("ضاد/نواة_ذاكرة")
متغير ش = استورد("ضاد/نواة_منفذ")
متغير خ٠ = استورد("ضاد/نواة_أخطاء")
متغير ت٠ = استورد("ضاد/نواة_توليف")
متغير ح٠ = استورد("ضاد/نواة_حوار")
متغير ف٠ = استورد("ضاد/نواة_ملف")
متغير د٠ = استورد("ضاد/نواة_دليل")

# يسجّل محركات نواة الجاهزة إن لم تكن مسجَّلة
صدّر دالة جهّز() {
    متغير موجود = ع.المحركات()
    إذا (ليس يحوي(موجود، "محلل_المهام")) { م.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "استرجاع")) { ر.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "ذاكرة")) { ذ.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "منفذ_معزول")) { ش.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "محلل_أخطاء")) { خ٠.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "توليف_شيفرة")) { ت٠.سجّل_المحرك() }
    ارجع ع.المحركات()
}

# يستخرج شيفرة الطلب: كتلة بين ثلاث علامات اقتباس عكسية إن وجدت، وإلا الطلب كله إن بدا شيفرة
دالة _شيفرة_الطلب(طلب) {
    متغير س = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    إذا (يحوي(طلب، س)) {
        متغير أجزاء = افصل(طلب، س)
        إذا (طول(أجزاء) >= ٣) {
            متغير كتلة = أجزاء[١]
            متغير سطور = افصل(كتلة، حرف(١٠))
            # السطر الأول قد يكون اسم اللغة
            إذا (طول(سطور) > ١ و طول(سطور[٠]) < ١٢ و ليس يحوي(سطور[٠]، "(")) {
                متغير بقية = []
                من_أجل (ي في مدى(١، طول(سطور))) { أضف(بقية، سطور[ي]) }
                ارجع اربط(بقية، حرف(١٠))
            }
            ارجع كتلة
        }
    }
    ارجع ""
}

دالة اختر(شرط، أ، ب) {
    إذا (شرط) { ارجع أ }
    ارجع ب
}

دالة _خطوة(محرك، حالة، تفصيل) { ارجع {"محرك": محرك، "حالة": حالة، "تفصيل": تفصيل} }

# ينفّذ الطلب كله ويعيد {نوع، ثقة، لغة، خطة، نتائج، ذكريات، رد}
صدّر دالة نفّذ_الطلب(طلب، سياق = {}) {
    إذا (نوع(طلب) != "نص" أو طول(طلب) == ٠) { أطلق_خطأ("المنسّق: الطلب نص غير فارغ") }
    إذا (نوع(سياق) != "خريطة") { أطلق_خطأ("المنسّق: السياق خريطة") }
    جهّز()
    # السياق الاختياري: مرفقات {فهرس، ملفات: {اسم: نص كامل}} وعدد_المكتبة (ملفات مربوطة)
    متغير مرفقات = {"فهرس": "", "ملفات": {}}
    إذا (يحوي(سياق، "مرفقات")) { مرفقات = سياق["مرفقات"] }
    متغير أسماء_المرفقات = مفاتيح(مرفقات["ملفات"])
    متغير عدد_المكتبة = ٠
    إذا (يحوي(سياق، "عدد_المكتبة")) { عدد_المكتبة = سياق["عدد_المكتبة"] }

    # الحوار: تحية وتعريف وقدرات. لا يستولي على الطلب الحقيقي، فإن حمل مهمة أُضيفت البادئة إلى ردّها
    متغير حوار = ح٠.اكتشف(طلب)
    إذا (طول(حوار["أنواع"]) > ٠ و حوار["متبقية"] == ٠) {
        ارجع {
            "نوع": "حوار"، "ثقة": ١٠٠، "لغة": "ضاد"، "نتائج": {}، "ذكريات": []،
            "خطة": [_خطوة("حوار"، "نُفّذ"، اربط(حوار["أنواع"]، "،"))]،
            "رد": ح٠.ردّ(حوار["أنواع"]، {"مرفقات": أسماء_المرفقات، "مكتبة": عدد_المكتبة})
        }
    }
    متغير بادئة = ""
    إذا (حوار["متبقية"] > ٠) {
        بادئة = ح٠.بادئة(حوار["أنواع"])
        # الطلب الحقيقي بلا التحية التي سبقته
        طلب = ح٠.بلا_المطلع(طلب)
    }

    # المتابعة: «شغّله» و«اشرحه» و«المزيد» تشير إلى ما قبلها
    متغير آخر = {}
    إذا (يحوي(سياق، "آخر")) { آخر = سياق["آخر"] }
    متغير متابعة = ح٠.متابعة(طلب)
    إذا (متابعة == "شغّل") { ارجع _تشغيل_السابق(آخر، بادئة) }
    إذا (متابعة == "بسّط" أو متابعة == "عمّق" أو (متابعة == "مزيد" و يحوي(آخر، "دليل_طلب"))) { ارجع _متابعة_دليل(متابعة، آخر، سياق، بادئة) }
    إذا (متابعة == "مزيد" و يحوي(آخر، "استعلام")) { ارجع _مزيد(آخر، سياق، بادئة) }
    إذا (متابعة == "اشرح" و يحوي(آخر، "عنوان")) { طلب = "اشرح لي " + آخر["عنوان"] }

    # عملية على ملف كامل: تحليل أو تلخيص أو تقييم أو سؤال عن المحتوى
    إذا (ف٠.طلب_ملف(طلب، طول(أسماء_المرفقات))) {
        ارجع _ردّ_الملف(طلب، مرفقات، بادئة)
    }

    متغير تحليل = ع.شغّل("محلل_المهام"، {"طلب": طلب})["نتيجة"]
    # أسئلة ضاد: تُجاب من نص الدليل والدروس والشروحات والمعجم (لا من عناوينها)
    إذا (يحوي(سياق، "دليل") و تحليل["نوع"] != "كتابة_برنامج" و _شيفرة_الطلب(طلب) == "" و ليس _عن_ملفاتي(طلب)) {
        متغير ج = د٠.أجب(سياق["دليل"]، طلب)
        إذا (ج["وُجد"]) { ارجع _نتيجة_دليل(ج، طلب، بادئة) }
    }
    متغير خطة = []
    متغير نتائج = {}
    متغير ذكريات = []
    متغير مخزن = ""
    إذا (يحوي(سياق، "ذاكرة")) { مخزن = سياق["ذاكرة"] }

    # الذاكرة: تذكّر ما يناسب الطلب، ثم دوّنه عاملًا
    إذا (مخزن != "") {
        # الذاكرة العاملة حالة المهمة الجارية لا معرفة: لا تُستدعى ردًّا، وإنما تُستدعى الدائمة (تجريبية وإجرائية)
        من_أجل (ن في ع.شغّل("ذاكرة"، {"مخزن": مخزن، "استعلام": طلب، "حد": ٥، "نوع": ""})["نتيجة"]["عناصر"]) {
            إذا (ن["نوع"] != "عاملة") { أضف(ذكريات، ن) }
        }
        ذ.اكتب(مخزن، "عاملة"، طلب، "طلب المستخدم"، ٦٠)
        أضف(خطة، _خطوة("ذاكرة"، "نُفّذ"، "استُدعي " + نص(طول(ذكريات)) + " عنصرًا"))
    }

    من_أجل (لازم في تحليل["محركات_لازمة"]) {
        إذا (لازم == "استرجاع") {
            إذا (يحوي(سياق، "فهرس")) {
                متغير خ = ع.شغّل("استرجاع"، {"فهرس": سياق["فهرس"]، "استعلام": طلب، "حد": ٣})["نتيجة"]["نتائج"]
                نتائج["استرجاع"] = خ
                أضف(خطة، _خطوة("استرجاع"، "نُفّذ"، "وُجدت " + نص(طول(خ)) + " نتيجة"))
            } وإلا {
                أضف(خطة، _خطوة("استرجاع"، "تُخطّي"، "لا فهرس في السياق"))
            }
        } وإلا إذا (لازم == "منفذ_معزول") {
            متغير شيفرة = _شيفرة_الطلب(طلب)
            إذا (شيفرة != "" و تحليل["نوع"] != "كتابة_برنامج") {
                متغير ن = ع.شغّل("منفذ_معزول"، {"شيفرة": شيفرة، "سقف_الخطوات": ٢٠٠٠٠٠})["نتيجة"]
                نتائج["تنفيذ"] = ن
                أضف(خطة، _خطوة("منفذ_معزول"، "نُفّذ"، اختر(ن["ناجح"]، "نجح"، "فشل: " + ن["نوع_الخطأ"])))
            } وإلا {
                أضف(خطة، _خطوة("منفذ_معزول"، "تُخطّي"، "لا شيفرة جاهزة للتشغيل"))
            }
        } وإلا إذا (لازم == "توليف_شيفرة") {
            إذا (يحوي(سياق، "قاعدة")) {
                متغير ن = ع.شغّل("توليف_شيفرة"، {"قاعدة": سياق["قاعدة"]، "وصف": طلب})["نتيجة"]
                نتائج["توليف"] = ن
                أضف(خطة، _خطوة("توليف_شيفرة"، "نُفّذ"، اختر(ن["وُجد"]، "من " + ن["مصدر"]، "لم يوجد برنامج موثوق")))
            } وإلا {
                أضف(خطة، _خطوة("توليف_شيفرة"، "تُخطّي"، "لا قاعدة أمثلة في السياق"))
            }
        } وإلا إذا (لازم == "محلل_أخطاء") {
            # يُرجأ إلى ما بعد التشغيل: لا خطأ يُحلَّل قبل أن يظهر
        } وإلا {
            أضف(خطة، _خطوة(لازم، "غير_متاح"، "المحرك لم يُسجَّل بعد"))
        }
    }
    # ملفات المستخدم المربوطة: تُستعلَم كلما كان الطلب بحثًا أو شرحًا أو إصلاحًا، لا عند طلب كتابة برنامج
    إذا ((يحوي(سياق، "مستندات") أو مرفقات["فهرس"] != "") و تحليل["نوع"] != "كتابة_برنامج") {
        متغير د = []
        # المرفقات أولًا: هي ما يعمل عليه الآن، ثم المكتبة المربوطة. لا يُقبل مقطع لا يحوي أي جذر دالّ من الطلب.
        متغير جذور = ف٠.جذوع(طلب)
        متغير نص_م = ""
        إذا (يحوي(سياق، "نص_المقطع")) { نص_م = سياق["نص_المقطع"] }
        إذا (مرفقات["فهرس"] != "") {
            من_أجل (ن في ع.شغّل("استرجاع"، {"فهرس": مرفقات["فهرس"]، "استعلام": طلب، "حد": ٣})["نتيجة"]["نتائج"]) {
                إذا (ن["درجة"] > ٠ و _صالح(ن، جذور، نص_م)) { أضف(د، ن) }
            }
        }
        إذا (يحوي(سياق، "مستندات")) {
            من_أجل (ن في ع.شغّل("استرجاع"، {"فهرس": سياق["مستندات"]، "استعلام": طلب، "حد": ٣})["نتيجة"]["نتائج"]) {
                إذا (ن["درجة"] > ٠ و طول(د) < ٤ و _صالح(ن، جذور، نص_م)) { أضف(د، ن) }
            }
        }
        نتائج["مستندات"] = د
        أضف(خطة، _خطوة("استرجاع"، "نُفّذ"، "في ملفاتك: " + نص(طول(د))))
    }
    إذا (يحوي(تحليل["محركات_لازمة"]، "محلل_أخطاء")) {
        إذا (يحوي(نتائج، "تنفيذ") و ليس نتائج["تنفيذ"]["ناجح"]) {
            متغير ت = نتائج["تنفيذ"]
            نتائج["تشخيص"] = ع.شغّل("محلل_أخطاء"، {"رسالة": ت["خطأ"]، "شيفرة": _شيفرة_الطلب(طلب)})["نتيجة"]
            أضف(خطة، _خطوة("محلل_أخطاء"، "نُفّذ"، نتائج["تشخيص"]["تصنيف"]))
        } وإلا {
            أضف(خطة، _خطوة("محلل_أخطاء"، "تُخطّي"، "لا خطأ تشغيل لتحليله"))
        }
    }

    ارجع {
        "نوع": تحليل["نوع"]، "ثقة": تحليل["ثقة"]، "لغة": تحليل["لغة"]،
        "خطة": خطة، "نتائج": نتائج، "ذكريات": ذكريات،
        "بادئة": بادئة،
        "رد": _أضف_البادئة(بادئة، _صغ_الرد(تحليل، خطة، نتائج، ذكريات))
    }
}

دالة _صالح(ن، جذور، نص_م) {
    إذا (نص_م == "") { ارجع صحيح }
    ارجع ف٠.يطابق(نص_م(ن["معرف"])، جذور)
}

دالة _أضف_البادئة(بادئة، رد_) {
    إذا (بادئة == "" أو رد_ == "") { ارجع رد_ }
    ارجع بادئة + حرف(١٠) + حرف(١٠) + رد_
}

# هل الطلب عن ملفات المستخدم (لا عن ضاد)؟
دالة _عن_ملفاتي(طلب) {
    متغير س = ف٠.مطبّع(طلب)
    ارجع يحوي(س، "ملفات") أو يحوي(س، "مكتبت") أو يحوي(س، "ملفي") أو يحوي(س، "مجلد")
}

دالة _نتيجة_دليل(ج، طلب، بادئة) {
    ارجع {
        "نوع": "دليل"، "ثقة": ١٠٠، "لغة": "ضاد"،
        "خطة": [_خطوة("دليل"، "نُفّذ"، ج["مستوى"] + " — " + ج["معرف"])]،
        "نتائج": {"دليل": {"طلب": طلب، "عنوان": ج["عنوان"]، "رابط": ج["رابط"]، "نص": ج["نص"]، "شيفرة": ج["شيفرة"]، "مستوى": ج["مستوى"]}}،
        "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، ج["رد"])
    }
}

# «بسّطه» و«عمّقه»: إعادة شرح آخر موضوع من الدليل بمستوى آخر
دالة _متابعة_دليل(نوع_، آخر، سياق، بادئة) {
    إذا (ليس يحوي(آخر، "دليل_طلب") أو ليس يحوي(سياق، "دليل")) {
        ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": [_خطوة("دليل"، "تُخطّي"، "لا شرح سابق")]، "نتائج": {}، "ذكريات": []،
            "رد": _أضف_البادئة(بادئة، "لا أرى شرحًا سابقًا أعدّله. اسألني عن موضوع في ضاد أولًا، ثم اطلب تبسيطه أو التعمّق فيه.")}
    }
    متغير مستوى_ = "معمق"
    إذا (نوع_ == "بسّط") { مستوى_ = "بسيط" }
    متغير ج = د٠.أجب(سياق["دليل"]، آخر["دليل_طلب"]، مستوى_)
    ارجع _نتيجة_دليل(ج، آخر["دليل_طلب"]، بادئة)
}

# «شغّله»: تشغيل آخر برنامج عُرض في الصندوق المعزول، وتشخيص الخطأ إن فشل
دالة _تشغيل_السابق(آخر، بادئة) {
    متغير خطة = []
    إذا (ليس يحوي(آخر، "شيفرة") أو آخر["شيفرة"] == "") {
        أضف(خطة، _خطوة("متابعة"، "تُخطّي"، "لا شيفرة سابقة"))
        ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": خطة، "نتائج": {}، "ذكريات": []،
            "رد": _أضف_البادئة(بادئة، "لا أرى برنامجًا سابقًا لأشغّله. اطلب برنامجًا أولًا، أو الصق شيفرتك.")}
    }
    متغير ج = ع.شغّل("منفذ_معزول"، {"شيفرة": آخر["شيفرة"]، "سقف_الخطوات": ٢٠٠٠٠٠})["نتيجة"]
    متغير نتائج = {"تنفيذ": ج}
    أضف(خطة، _خطوة("منفذ_معزول"، "نُفّذ"، اختر(ج["ناجح"]، "نجح"، "فشل: " + ج["نوع_الخطأ"])))
    متغير نص_ = ""
    إذا (ج["ناجح"]) {
        نص_ = "شُغِّل البرنامج السابق:" + حرف(١٠) + اربط(ج["مخرجات"]، حرف(١٠))
    } وإلا {
        متغير د = ع.شغّل("محلل_أخطاء"، {"رسالة": ج["خطأ"]، "شيفرة": آخر["شيفرة"]})["نتيجة"]
        نتائج["تشخيص"] = د
        أضف(خطة، _خطوة("محلل_أخطاء"، "نُفّذ"، د["تفسير"]))
        نص_ = "فشل تشغيل البرنامج السابق: " + ج["خطأ"] + حرف(١٠) + د["تفسير"]
    }
    ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": خطة، "نتائج": نتائج، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، نص_)}
}

# «المزيد»: نتائج أخرى للطلب السابق لم تُعرض بعد
دالة _مزيد(آخر، سياق، بادئة) {
    متغير خطة = []
    متغير عُرض = []
    إذا (يحوي(آخر، "عرض")) { عُرض = آخر["عرض"] }
    متغير جديد = []
    إذا (يحوي(سياق، "فهرس")) {
        من_أجل (ن في ع.شغّل("استرجاع"، {"فهرس": سياق["فهرس"]، "استعلام": آخر["استعلام"]، "حد": طول(عُرض) + ٦})["نتيجة"]["نتائج"]) {
            إذا (ن["درجة"] > ٠ و ليس يحوي(عُرض، ن["معرف"]) و طول(جديد) < ٣) { أضف(جديد، ن) }
        }
    }
    أضف(خطة، _خطوة("استرجاع"، "نُفّذ"، "نتائج إضافية: " + نص(طول(جديد))))
    متغير أسطر = []
    من_أجل (ن في جديد) { أضف(أسطر، "- " + ن["عنوان"] + " (" + ن["معرف"] + ")") }
    متغير نص_ = "لا نتائج أخرى لهذا الطلب."
    إذا (طول(جديد) > ٠) { نص_ = "نتائج أخرى لطلبك:" + حرف(١٠) + اربط(أسطر، حرف(١٠)) }
    ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": خطة، "نتائج": {"استرجاع": جديد}، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، نص_)}
}

# ردّ طلب على ملفات مرفقة: تحليل كل ملف (والشيفرة تُشغَّل وتُشخَّص أخطاؤها)
دالة _ردّ_الملف(طلب، مرفقات، بادئة) {
    متغير أسماء = مفاتيح(مرفقات["ملفات"])
    متغير خطة = []
    إذا (طول(أسماء) == ٠) {
        أضف(خطة، _خطوة("تحليل_ملف"، "تُخطّي"، "لا ملف مرفق"))
        ارجع {
            "نوع": "تحليل_ملف"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": خطة، "نتائج": {}، "ذكريات": []،
            "رد": _أضف_البادئة(بادئة، "لا أرى ملفًا مرفقًا. أرفق الملف من زر + ثم «إرفاق ملفات»، وأطلب تحليله بعدها.")
        }
    }
    متغير مختارة = ف٠.اختر_الملفات(طلب، أسماء)
    متغير تقارير = []
    متغير كتل = []
    من_أجل (ا في مختارة) {
        إذا (طول(تقارير) < ٣) {
            متغير نص_ملف = مرفقات["ملفات"][ا]
            متغير ت = ف٠.حلّل(ا، نص_ملف)
            متغير كتلة = ف٠.صغ(ت)
            إذا (_ينتهي_ب(ا، ".dhad")) {
                متغير ج = ع.شغّل("منفذ_معزول"، {"شيفرة": نص_ملف، "سقف_الخطوات": ٢٠٠٠٠٠})["نتيجة"]
                ت["تنفيذ"] = ج
                إذا (ج["ناجح"]) {
                    كتلة = كتلة + حرف(١٠) + "- التشغيل: نجح."
                    متغير ناتج = []
                    من_أجل (س في ج["مخرجات"]) { إذا (طول(ناتج) < ٨) { أضف(ناتج، "  " + نص(س)) } }
                    إذا (طول(ناتج) > ٠) { كتلة = كتلة + حرف(١٠) + اربط(ناتج، حرف(١٠)) }
                } وإلا {
                    كتلة = كتلة + حرف(١٠) + "- التشغيل: فشل (" + ج["نوع_الخطأ"] + ") " + ج["خطأ"]
                    متغير د = ع.شغّل("محلل_أخطاء"، {"رسالة": ج["خطأ"]، "شيفرة": نص_ملف})["نتيجة"]
                    ت["تشخيص"] = د
                    كتلة = كتلة + حرف(١٠) + "- التشخيص: " + د["تفسير"]
                    إذا (د["نص_السطر"] != "") { كتلة = كتلة + حرف(١٠) + "  السطر " + نص(د["سطر"]) + ": " + د["نص_السطر"] }
                    كتلة = كتلة + حرف(١٠) + "- الاقتراح: " + د["اقتراح"]
                }
            }
            أضف(تقارير، ت)
            أضف(كتل، كتلة)
            أضف(خطة، _خطوة("تحليل_ملف"، "نُفّذ"، ا))
        }
    }
    إذا (طول(مختارة) > ٣) { أضف(كتل، "وبقية الملفات المرفقة (" + نص(طول(مختارة) - ٣) + ") لم تُحلَّل في هذا الردّ؛ سمِّ الملف الذي تريده.") }
    ارجع {
        "نوع": "تحليل_ملف"، "ثقة": ١٠٠، "لغة": "ضاد"، "خطة": خطة، "نتائج": {"ملف": تقارير}، "ذكريات": []، "بادئة": بادئة،
        "رد": _أضف_البادئة(بادئة، اربط(كتل، حرف(١٠) + حرف(١٠)))
    }
}

دالة _ينتهي_ب(س، ل) { ارجع طول(س) >= طول(ل) و اقتطع(س، طول(س) - طول(ل)) == ل }

# يصوغ الردّ من النتائج الفعلية فقط
دالة _صغ_الرد(تحليل، خطة، نتائج، ذكريات) {
    متغير أسطر = []
    متغير وُجد_برنامج = يحوي(نتائج، "توليف") و نتائج["توليف"]["وُجد"]
    إذا (يحوي(نتائج، "استرجاع") و طول(نتائج["استرجاع"]) > ٠ و ليس وُجد_برنامج) {
        أضف(أسطر، "أقرب ما في المعرفة:")
        من_أجل (ن في نتائج["استرجاع"]) { أضف(أسطر، "- " + ن["عنوان"] + " (" + ن["معرف"] + ")") }
    }
    إذا (يحوي(نتائج، "مستندات") و طول(نتائج["مستندات"]) > ٠) {
        أضف(أسطر، "من ملفاتك:")
        من_أجل (ن في نتائج["مستندات"]) { أضف(أسطر، "- " + ن["عنوان"] + " (" + ن["معرف"] + ")") }
    }
    إذا (يحوي(نتائج، "توليف")) {
        متغير ل = نتائج["توليف"]
        إذا (ل["وُجد"]) {
            أضف(أسطر، "برنامج مُتحقَّق منه (" + ل["مصدر"] + "):")
            أضف(أسطر، ل["شيفرة"])
        } وإلا {
            أضف(أسطر، "لم أجد برنامجًا موثوقًا يطابق الوصف في معرفتي الحالية.")
        }
    }
    إذا (يحوي(نتائج، "تنفيذ")) {
        متغير ت = نتائج["تنفيذ"]
        إذا (ت["ناجح"]) {
            أضف(أسطر، "نتيجة التشغيل:")
            من_أجل (س في ت["مخرجات"]) { أضف(أسطر، "  " + نص(س)) }
        } وإلا {
            أضف(أسطر، "فشل التشغيل (" + ت["نوع_الخطأ"] + "): " + ت["خطأ"])
        }
    }
    إذا (يحوي(نتائج، "تشخيص")) {
        متغير د = نتائج["تشخيص"]
        أضف(أسطر، "التشخيص: " + د["تفسير"])
        إذا (د["نص_السطر"] != "") { أضف(أسطر، "  السطر " + نص(د["سطر"]) + ": " + د["نص_السطر"]) }
        أضف(أسطر، "الاقتراح: " + د["اقتراح"])
    }
    إذا (طول(ذكريات) > ٠) { أضف(أسطر، "من الذاكرة: " + ذكريات[٠]["محتوى"]) }
    من_أجل (خ في خطة) {
        إذا (خ["حالة"] == "غير_متاح") { أضف(أسطر، "لم يتوفر بعد: " + خ["محرك"]) }
    }
    إذا (طول(أسطر) == ٠) { ارجع "" }
    ارجع اربط(أسطر، حرف(١٠))
}

صدّر دالة سجّل_المحرك() {
    جهّز()
    ارجع ع.سجّل(ع.محرك(
        "منسّق"،
        "يحلّل الطلب ويشغّل المحركات اللازمة ويجمع نتائجها في ردّ واحد"،
        {"طلب": "نص"}،
        {"نوع": "نص"، "خطة": "قائمة"، "رد": "نص"}،
        دالة(مدخل) { ارجع نفّذ_الطلب(مدخل["طلب"]) }
    ))
}
