# ضاد/نواة_منسق — منسّق المهام: يحلّل الطلب، يختار المحركات اللازمة من السجل، يشغّلها، ويجمع نتائجها في ردّ واحد.
# لا يدّعي ما لم يُبنَ: المحرك اللازم غير المسجَّل يظهر في الخطة بحالة «غير_متاح» ولا يُختلق له ناتج.
# السياق: {فهرس: فهرس الاسترجاع (اختياري)، ذاكرة: مخزن الذاكرة (اختياري)}

متغير ع = استورد("ضاد/نواة_عقد")
متغير م = استورد("ضاد/نواة_مهام")
متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ذ = استورد("ضاد/نواة_ذاكرة")
متغير ح٠ = استورد("ضاد/نواة_حوار")
متغير ف٠ = استورد("ضاد/نواة_ملف")
متغير ل٥ = استورد("ضاد/نواة_لغات")
متغير ت٧ = استورد("ضاد/نواة_تلخيص")
متغير ح٦ = استورد("ضاد/نواة_وحدات")
متغير خ٢ = استورد("ضاد/نواة_مخطوطات")
متغير د٣ = استورد("ضاد/نواة_دراسة")

# يسجّل محركات نواة الجاهزة إن لم تكن مسجَّلة
# تُسجَّل وحدات اللغات مرة واحدة؛ فمن صفّر السجلّ (ل٥.صفّر_الوحدات) بقيت نواة بلا لغات
متغير _لغات_سُجّلت = خطأ
صدّر دالة جهّز() {
    متغير موجود = ع.المحركات()
    إذا (ليس يحوي(موجود، "محلل_المهام")) { م.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "استرجاع")) { ر.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "ذاكرة")) { ذ.سجّل_المحرك() }
    ت٧.سجّل_المحرك()
    خ٢.سجّل_المحركات()
    إذا (ليس _لغات_سُجّلت) {
        ح٦.سجّل_الكل()
        _لغات_سُجّلت = صحيح
    }
    ارجع ع.المحركات()
}

# يستخرج شيفرة الطلب: كتلة بين ثلاث علامات اقتباس عكسية إن وجدت، وإلا الطلب كله إن بدا شيفرة
دالة _شيفرة_الطلب(طلب) {
    متغير س = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    إذا (يحوي(طلب، س)) {
        متغير أجزاء = افصل(طلب، س)
        إذا (طول(أجزاء) >= ٣) {
            متغير كتلة = أجزاء[١]
            متغير سطور = افصل(كتلة، حرف(١٠))
            # السطر الأول قد يكون اسم اللغة
            إذا (طول(سطور) > ١ و طول(سطور[٠]) < ١٢ و ليس يحوي(سطور[٠]، "(")) {
                متغير بقية = []
                من_أجل (ي في مدى(١، طول(سطور))) { أضف(بقية، سطور[ي]) }
                ارجع اربط(بقية، حرف(١٠))
            }
            ارجع كتلة
        }
    }
    ارجع ""
}

دالة _خطوة(محرك، حالة، تفصيل) { ارجع {"محرك": محرك، "حالة": حالة، "تفصيل": تفصيل} }

# هل الطلب جواب قصير يسمّي لغة لطلب برنامج سُئل عن لغته؟
صدّر دالة تكمّل_معلّقًا(طلب، آخر) {
    ارجع يحوي(آخر، "معلّق") و ل٥.حدّد(طلب) != "" و طول(افصل(طلب، " ")) <= ٣
}

# ينفّذ الطلب كله ويعيد {نوع، ثقة، لغة، خطة، نتائج، ذكريات، رد}
صدّر دالة نفّذ_الطلب(طلب، سياق = {}) {
    إذا (نوع(طلب) != "نص" أو طول(طلب) == ٠) { أطلق_خطأ("المنسّق: الطلب نص غير فارغ") }
    إذا (نوع(سياق) != "خريطة") { أطلق_خطأ("المنسّق: السياق خريطة") }
    جهّز()
    # السياق الاختياري: مرفقات {فهرس، ملفات: {اسم: نص كامل}} وعدد_المكتبة (ملفات مربوطة)
    متغير مرفقات = {"فهرس": "", "ملفات": {}}
    إذا (يحوي(سياق، "مرفقات")) { مرفقات = سياق["مرفقات"] }
    متغير أسماء_المرفقات = مفاتيح(مرفقات["ملفات"])
    متغير عدد_المكتبة = ٠
    إذا (يحوي(سياق، "عدد_المكتبة")) { عدد_المكتبة = سياق["عدد_المكتبة"] }

    # دراسة نص ملصوق (اختبار، أسئلة وأجوبة، تلخيص، اختصار، نقاط) وتصحيح جواب اختبار قائم
    متغير آخر_ = {}
    إذا (يحوي(سياق، "آخر")) { آخر_ = سياق["آخر"] }
    متغير دراسة = د٣.تعامل({"طلب": طلب، "آخر": آخر_})
    إذا (دراسة != لاشيء) { ارجع دراسة }

    # الحوار: تحية وتعريف وقدرات. لا يستولي على الطلب الحقيقي، فإن حمل مهمة أُضيفت البادئة إلى ردّها
    متغير حوار = ح٠.اكتشف(طلب)
    إذا (طول(حوار["أنواع"]) > ٠ و حوار["متبقية"] == ٠) {
        ارجع {
            "نوع": "حوار"، "ثقة": ١٠٠، "لغة": ""، "نتائج": {}، "ذكريات": []،
            "خطة": [_خطوة("حوار"، "نُفّذ"، اربط(حوار["أنواع"]، "،"))]،
            "رد": ح٠.ردّ(حوار["أنواع"]، {"مرفقات": أسماء_المرفقات، "مكتبة": عدد_المكتبة})
        }
    }
    متغير بادئة = ""
    إذا (حوار["متبقية"] > ٠) {
        بادئة = ح٠.بادئة(حوار["أنواع"])
        # الطلب الحقيقي بلا التحية التي سبقته
        طلب = ح٠.بلا_المطلع(طلب)
    }

    # المتابعة: «شغّله» و«اشرحه» و«المزيد» تشير إلى ما قبلها
    متغير آخر = {}
    إذا (يحوي(سياق، "آخر")) { آخر = سياق["آخر"] }
    متغير متابعة = ح٠.متابعة(طلب)
    إذا (متابعة == "مزيد" و يحوي(آخر، "استعلام")) { ارجع _مزيد(آخر، سياق، بادئة) }
    # الطلب المعلّق: سُئل عن اللغة فجاء اسمها وحده؛ يُكمَّل الطلب الأصلي بها
    إذا (تكمّل_معلّقًا(طلب، آخر)) { طلب = آخر["معلّق"] + " " + طلب }

    # اللغة المطلوبة: لا تُفترض لغة. تُسمّى في الطلب، أو تُعرف من شيفرته، أو تُرث في المتابعات فقط
    # الخطوة الثانية فما بعدها في خطة مركّبة ترث لغة ما قبلها إن كانت طلب برنامج؛ أما سائر الطلبات فلا ترث لغة
    متغير ورث = متابعة != ""
    إذا (يحوي(سياق، "سلسلة") و ع.شغّل("محلل_المهام"، {"طلب": طلب})["نتيجة"]["نوع"] == "كتابة_برنامج") { ورث = صحيح }
    متغير لغة = ل٥.حدّد(طلب، ورث، آخر)
    متغير ل٦ = لاشيء
    إذا (لغة != "") {
        متغير و٣ = ل٥.وحدة(لغة)
        ل٦ = و٣
        إذا (و٣ != لاشيء) {
            متغير ن٥ = و٣["حاول"]({"طلب": طلب، "سياق": سياق، "آخر": آخر، "بادئة": بادئة، "متابعة": متابعة})
            إذا (ن٥ != لاشيء) { ن٥["لغة"] = لغة; ارجع ن٥ }
        }
    }

    # محركات المخطوطات والتحقيق: مقابلة، صرف، إملاء، تخريج، كشّاف (بعبارات صريحة فقط)
    متغير مخطوط = خ٢.تعامل(طلب، مرفقات، سياق)
    إذا (مخطوط != لاشيء) {
        مخطوط["بادئة"] = بادئة
        مخطوط["رد"] = _أضف_البادئة(بادئة، مخطوط["رد"])
        ارجع مخطوط
    }

    # عملية على ملف كامل: تحليل أو تلخيص أو تقييم أو سؤال عن المحتوى
    إذا (ف٠.طلب_ملف(طلب، طول(أسماء_المرفقات))) {
        ارجع _ردّ_الملف(طلب، مرفقات، بادئة)
    }

    متغير تحليل = ع.شغّل("محلل_المهام"، {"طلب": طلب})["نتيجة"]
    # طلب برنامج بلا لغة مسمّاة: لا تُفترض لغة؛ يُسأل عنها مرة واحدة ويُحفظ الطلب ليُكمَّل بجواب قصير
    إذا (لغة == "" و تحليل["نوع"] == "كتابة_برنامج" و _يطلب_برنامجا(طلب)) {
        متغير أسماء_ل = []
        من_أجل (ك في ل٥.الوحدات()) { أضف(أسماء_ل، ك["اسم"]) }
        إذا (طول(أسماء_ل) > ٠) {
            ارجع {
                "نوع": "سؤال_لغة"، "ثقة": ١٠٠، "لغة": ""، "خطة": [_خطوة("لغات"، "نُفّذ"، "لم تُسمَّ لغة")]، "نتائج": {"معلّق": طلب}، "ذكريات": []، "بادئة": بادئة،
                "رد": _أضف_البادئة(بادئة، "بأي لغة تريد البرنامج؟ أتحقق من البرنامج بتشغيله الآن في: " + اربط(أسماء_ل، "، ") + ".")
            }
        }
    }
    متغير خطة = []
    متغير نتائج = {}
    متغير ذكريات = []
    متغير مخزن = ""
    إذا (يحوي(سياق، "ذاكرة")) { مخزن = سياق["ذاكرة"] }

    # الذاكرة: تذكّر ما يناسب الطلب، ثم دوّنه عاملًا
    إذا (مخزن != "") {
        # الذاكرة العاملة حالة المهمة الجارية لا معرفة: لا تُستدعى ردًّا، وإنما تُستدعى الدائمة (تجريبية وإجرائية)
        من_أجل (ن في ع.شغّل("ذاكرة"، {"مخزن": مخزن، "استعلام": طلب، "حد": ٥، "نوع": ""})["نتيجة"]["عناصر"]) {
            إذا (ن["نوع"] != "عاملة") { أضف(ذكريات، ن) }
        }
        ذ.اكتب(مخزن، "عاملة"، طلب، "طلب المستخدم"، ٦٠)
        أضف(خطة، _خطوة("ذاكرة"، "نُفّذ"، "استُدعي " + نص(طول(ذكريات)) + " عنصرًا"))
    }

    # ما تتولاه وحدة اللغة المسمّاة من المحركات اللازمة تتولاه بنفسها؛ والباقي: محرك مسجَّل بلا وحدة تتولاه يُتخطّى، وغير المسجَّل يُعلَن غير متاح
    من_أجل (لازم في تحليل["محركات_لازمة"]) {
        متغير تولّته = خطأ
        إذا (ل٦ != لاشيء و يحوي(ل٦، "لازم")) {
            تولّته = ل٦["لازم"]({"لازم": لازم، "طلب": طلب، "سياق": سياق، "تحليل": تحليل، "خطة": خطة، "نتائج": نتائج})
        }
        إذا (ليس تولّته) {
            إذا (لازم == "محلل_أخطاء") {
                # يُرجأ إلى ما بعد التشغيل: لا خطأ يُحلَّل قبل أن يظهر
            } وإلا إذا (يحوي(ع.المحركات()، لازم)) {
                أضف(خطة، _خطوة(لازم، "تُخطّي"، "لا لغة مسمّاة تتولّى هذا الطلب"))
            } وإلا {
                أضف(خطة، _خطوة(لازم، "غير_متاح"، "المحرك لم يُسجَّل بعد"))
            }
        }
    }
    # ملفات المستخدم المربوطة: تُستعلَم كلما كان الطلب بحثًا أو شرحًا أو إصلاحًا، لا عند طلب كتابة برنامج
    إذا ((يحوي(سياق، "مستندات") أو مرفقات["فهرس"] != "") و تحليل["نوع"] != "كتابة_برنامج") {
        متغير د = []
        # المرفقات أولًا: هي ما يعمل عليه الآن، ثم المكتبة المربوطة. لا يُقبل مقطع لا يحوي أي جذر دالّ من الطلب.
        متغير جذور = ف٠.جذوع(طلب)
        متغير نص_م = ""
        إذا (يحوي(سياق، "نص_المقطع")) { نص_م = سياق["نص_المقطع"] }
        إذا (مرفقات["فهرس"] != "") {
            من_أجل (ن في ع.شغّل("استرجاع"، {"فهرس": مرفقات["فهرس"]، "استعلام": طلب، "حد": ٣})["نتيجة"]["نتائج"]) {
                إذا (ن["درجة"] > ٠ و _صالح(ن، جذور، نص_م)) { أضف(د، ن) }
            }
        }
        إذا (يحوي(سياق، "مستندات")) {
            من_أجل (ن في ع.شغّل("استرجاع"، {"فهرس": سياق["مستندات"]، "استعلام": طلب، "حد": ٣})["نتيجة"]["نتائج"]) {
                إذا (ن["درجة"] > ٠ و طول(د) < ٤ و _صالح(ن، جذور، نص_م)) { أضف(د، ن) }
            }
        }
        نتائج["مستندات"] = د
        أضف(خطة، _خطوة("استرجاع"، "نُفّذ"، "في ملفاتك: " + نص(طول(د))))
    }
    إذا (ل٦ != لاشيء و يحوي(ل٦، "بعد")) {
        ل٦["بعد"]({"طلب": طلب، "تحليل": تحليل، "خطة": خطة، "نتائج": نتائج})
    }

    ارجع {
        "نوع": تحليل["نوع"]، "ثقة": تحليل["ثقة"]، "لغة": لغة،
        "خطة": خطة، "نتائج": نتائج، "ذكريات": ذكريات،
        "بادئة": بادئة،
        "رد": _أضف_البادئة(بادئة، _صغ_الرد(تحليل، خطة، نتائج، ذكريات، ل٦))
    }
}

دالة _صالح(ن، جذور، نص_م) {
    إذا (نص_م == "") { ارجع صحيح }
    ارجع ف٠.يطابق(نص_م(ن["معرف"])، جذور)
}

دالة _أضف_البادئة(بادئة، رد_) {
    إذا (بادئة == "" أو رد_ == "") { ارجع رد_ }
    ارجع بادئة + حرف(١٠) + حرف(١٠) + رد_
}

# هل الطلب عن ملفات المستخدم (لا عن ضاد)؟
دالة _عن_ملفاتي(طلب) {
    متغير س = ف٠.مطبّع(طلب)
    ارجع يحوي(س، "ملفات") أو يحوي(س، "مكتبت") أو يحوي(س، "ملفي") أو يحوي(س، "مجلد")
}





# «المزيد»: نتائج أخرى للطلب السابق لم تُعرض بعد
دالة _مزيد(آخر، سياق، بادئة) {
    متغير خطة = []
    متغير عُرض = []
    إذا (يحوي(آخر، "عرض")) { عُرض = آخر["عرض"] }
    متغير جديد = []
    إذا (يحوي(سياق، "فهرس")) {
        من_أجل (ن في ع.شغّل("استرجاع"، {"فهرس": سياق["فهرس"]، "استعلام": آخر["استعلام"]، "حد": طول(عُرض) + ٦})["نتيجة"]["نتائج"]) {
            إذا (ن["درجة"] > ٠ و ليس يحوي(عُرض، ن["معرف"]) و طول(جديد) < ٣) { أضف(جديد، ن) }
        }
    }
    أضف(خطة، _خطوة("استرجاع"، "نُفّذ"، "نتائج إضافية: " + نص(طول(جديد))))
    متغير أسطر = []
    من_أجل (ن في جديد) { أضف(أسطر، "- " + ن["عنوان"] + " (" + ن["معرف"] + ")") }
    متغير نص_ = "لا نتائج أخرى لهذا الطلب."
    إذا (طول(جديد) > ٠) { نص_ = "نتائج أخرى لطلبك:" + حرف(١٠) + اربط(أسطر، حرف(١٠)) }
    ارجع {"نوع": "متابعة"، "ثقة": ١٠٠، "لغة": ""، "خطة": خطة، "نتائج": {"استرجاع": جديد}، "ذكريات": []، "بادئة": بادئة، "رد": _أضف_البادئة(بادئة، نص_)}
}

# ردّ طلب على ملفات مرفقة: تحليل كل ملف (والشيفرة تُشغَّل وتُشخَّص أخطاؤها)
دالة _ردّ_الملف(طلب، مرفقات، بادئة) {
    متغير أسماء = مفاتيح(مرفقات["ملفات"])
    متغير خطة = []
    إذا (طول(أسماء) == ٠) {
        أضف(خطة، _خطوة("تحليل_ملف"، "تُخطّي"، "لا ملف مرفق"))
        ارجع {
            "نوع": "تحليل_ملف"، "ثقة": ١٠٠، "لغة": ""، "خطة": خطة، "نتائج": {}، "ذكريات": []،
            "رد": _أضف_البادئة(بادئة، "لا أرى ملفًا مرفقًا. أرفق الملف من زر + ثم «إرفاق ملفات»، وأطلب تحليله بعدها.")
        }
    }
    متغير مختارة = ف٠.اختر_الملفات(طلب، أسماء)
    متغير تقارير = []
    متغير كتل = []
    من_أجل (ا في مختارة) {
        إذا (طول(تقارير) < ٣) {
            متغير نص_ملف = مرفقات["ملفات"][ا]
            متغير ت = ف٠.حلّل(ا، نص_ملف)
            متغير كتلة = ف٠.صغ(ت)
            متغير وحدة_ملف = ل٥.وحدة_الملف(ا)
            إذا (وحدة_ملف != لاشيء و يحوي(وحدة_ملف، "ملف")) {
                متغير ر٣ = وحدة_ملف["ملف"](ا، نص_ملف)
                ت["تنفيذ"] = ر٣["تنفيذ"]
                إذا (يحوي(ر٣، "تشخيص")) { ت["تشخيص"] = ر٣["تشخيص"] }
                كتلة = كتلة + حرف(١٠) + ر٣["كتلة"]
            }
            أضف(تقارير، ت)
            أضف(كتل، كتلة)
            أضف(خطة، _خطوة("تحليل_ملف"، "نُفّذ"، ا))
        }
    }
    إذا (طول(مختارة) > ٣) { أضف(كتل، "وبقية الملفات المرفقة (" + نص(طول(مختارة) - ٣) + ") لم تُحلَّل في هذا الردّ؛ سمِّ الملف الذي تريده.") }
    ارجع {
        "نوع": "تحليل_ملف"، "ثقة": ١٠٠، "لغة": ""، "خطة": خطة، "نتائج": {"ملف": تقارير}، "ذكريات": []، "بادئة": بادئة،
        "رد": _أضف_البادئة(بادئة، اربط(كتل، حرف(١٠) + حرف(١٠)))
    }
}

# هل في الطلب كلمة تدل على برمجيات (لا كتابة نص أدبي ولا سؤال عام)؟
دالة _يطلب_برنامجا(طلب) {
    متغير س = ف٠.مطبّع(طلب)
    من_أجل (ك في ["برنامج"، "كود"، "شيفره"، "سكربت"، "تطبيق"، "موقع"، "صفحه ويب"، "برمج"، "خوارزم"، "دالة"، "دوال"، "لعبه"، "api"]) { إذا (يحوي(س، ك)) { ارجع صحيح } }
    ارجع خطأ
}

# يصوغ الردّ من النتائج الفعلية فقط
دالة _صغ_الرد(تحليل، خطة، نتائج، ذكريات، وحدة_) {
    متغير أسطر = []
    إذا (يحوي(نتائج، "مستندات") و طول(نتائج["مستندات"]) > ٠) {
        أضف(أسطر، "من ملفاتك:")
        من_أجل (ن في نتائج["مستندات"]) { أضف(أسطر، "- " + ن["عنوان"] + " (" + ن["معرف"] + ")") }
    }
    إذا (وحدة_ != لاشيء و يحوي(وحدة_، "صغ")) {
        من_أجل (س في وحدة_["صغ"](نتائج)) { أضف(أسطر، س) }
    }
    إذا (طول(ذكريات) > ٠) { أضف(أسطر، "من الذاكرة: " + ذكريات[٠]["محتوى"]) }
    من_أجل (خ في خطة) {
        إذا (خ["حالة"] == "غير_متاح") { أضف(أسطر، "لم يتوفر بعد: " + خ["محرك"]) }
    }
    إذا (طول(أسطر) == ٠) { ارجع "" }
    ارجع اربط(أسطر، حرف(١٠))
}

صدّر دالة سجّل_المحرك() {
    جهّز()
    ارجع ع.سجّل(ع.محرك(
        "منسّق"،
        "يحلّل الطلب ويشغّل المحركات اللازمة ويجمع نتائجها في ردّ واحد"،
        {"طلب": "نص"}،
        {"نوع": "نص"، "خطة": "قائمة"، "رد": "نص"}،
        دالة(مدخل) { ارجع نفّذ_الطلب(مدخل["طلب"]) }
    ))
}
