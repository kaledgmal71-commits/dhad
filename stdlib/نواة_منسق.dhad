# ضاد/نواة_منسق — منسّق المهام: يحلّل الطلب، يختار المحركات اللازمة من السجل، يشغّلها، ويجمع نتائجها في ردّ واحد.
# لا يدّعي ما لم يُبنَ: المحرك اللازم غير المسجَّل يظهر في الخطة بحالة «غير_متاح» ولا يُختلق له ناتج.
# السياق: {فهرس: فهرس الاسترجاع (اختياري)، ذاكرة: مخزن الذاكرة (اختياري)}

متغير ع = استورد("ضاد/نواة_عقد")
متغير م = استورد("ضاد/نواة_مهام")
متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ذ = استورد("ضاد/نواة_ذاكرة")
متغير ش = استورد("ضاد/نواة_منفذ")

# يسجّل محركات نواة الجاهزة إن لم تكن مسجَّلة
صدّر دالة جهّز() {
    متغير موجود = ع.المحركات()
    إذا (ليس يحوي(موجود، "محلل_المهام")) { م.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "استرجاع")) { ر.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "ذاكرة")) { ذ.سجّل_المحرك() }
    إذا (ليس يحوي(موجود، "منفذ_معزول")) { ش.سجّل_المحرك() }
    ارجع ع.المحركات()
}

# يستخرج شيفرة الطلب: كتلة بين ثلاث علامات اقتباس عكسية إن وجدت، وإلا الطلب كله إن بدا شيفرة
دالة _شيفرة_الطلب(طلب) {
    متغير س = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
    إذا (يحوي(طلب، س)) {
        متغير أجزاء = افصل(طلب، س)
        إذا (طول(أجزاء) >= ٣) {
            متغير كتلة = أجزاء[١]
            متغير سطور = افصل(كتلة، حرف(١٠))
            # السطر الأول قد يكون اسم اللغة
            إذا (طول(سطور) > ١ و طول(سطور[٠]) < ١٢ و ليس يحوي(سطور[٠]، "(")) {
                متغير بقية = []
                من_أجل (ي في مدى(١، طول(سطور))) { أضف(بقية، سطور[ي]) }
                ارجع اربط(بقية، حرف(١٠))
            }
            ارجع كتلة
        }
    }
    ارجع ""
}

دالة اختر(شرط، أ، ب) {
    إذا (شرط) { ارجع أ }
    ارجع ب
}

دالة _خطوة(محرك، حالة، تفصيل) { ارجع {"محرك": محرك، "حالة": حالة، "تفصيل": تفصيل} }

# ينفّذ الطلب كله ويعيد {نوع، ثقة، لغة، خطة، نتائج، ذكريات، رد}
صدّر دالة نفّذ_الطلب(طلب، سياق = {}) {
    إذا (نوع(طلب) != "نص" أو طول(طلب) == ٠) { أطلق_خطأ("المنسّق: الطلب نص غير فارغ") }
    إذا (نوع(سياق) != "خريطة") { أطلق_خطأ("المنسّق: السياق خريطة") }
    جهّز()
    متغير تحليل = ع.شغّل("محلل_المهام"، {"طلب": طلب})["نتيجة"]
    متغير خطة = []
    متغير نتائج = {}
    متغير ذكريات = []
    متغير مخزن = ""
    إذا (يحوي(سياق، "ذاكرة")) { مخزن = سياق["ذاكرة"] }

    # الذاكرة: تذكّر ما يناسب الطلب، ثم دوّنه عاملًا
    إذا (مخزن != "") {
        ذكريات = ع.شغّل("ذاكرة"، {"مخزن": مخزن، "استعلام": طلب، "حد": ٣، "نوع": ""})["نتيجة"]["عناصر"]
        ذ.اكتب(مخزن، "عاملة"، طلب، "طلب المستخدم"، ٦٠)
        أضف(خطة، _خطوة("ذاكرة"، "نُفّذ"، "استُدعي " + نص(طول(ذكريات)) + " عنصرًا"))
    }

    من_أجل (لازم في تحليل["محركات_لازمة"]) {
        إذا (لازم == "استرجاع") {
            إذا (يحوي(سياق، "فهرس")) {
                متغير خ = ع.شغّل("استرجاع"، {"فهرس": سياق["فهرس"]، "استعلام": طلب، "حد": ٣})["نتيجة"]["نتائج"]
                نتائج["استرجاع"] = خ
                أضف(خطة، _خطوة("استرجاع"، "نُفّذ"، "وُجدت " + نص(طول(خ)) + " نتيجة"))
            } وإلا {
                أضف(خطة، _خطوة("استرجاع"، "تُخطّي"، "لا فهرس في السياق"))
            }
        } وإلا إذا (لازم == "منفذ_معزول") {
            متغير شيفرة = _شيفرة_الطلب(طلب)
            إذا (شيفرة != "" و تحليل["نوع"] != "كتابة_برنامج") {
                متغير ن = ع.شغّل("منفذ_معزول"، {"شيفرة": شيفرة، "سقف_الخطوات": ٢٠٠٠٠٠})["نتيجة"]
                نتائج["تنفيذ"] = ن
                أضف(خطة، _خطوة("منفذ_معزول"، "نُفّذ"، اختر(ن["ناجح"]، "نجح"، "فشل: " + ن["نوع_الخطأ"])))
            } وإلا {
                أضف(خطة، _خطوة("منفذ_معزول"، "تُخطّي"، "لا شيفرة جاهزة للتشغيل"))
            }
        } وإلا {
            أضف(خطة، _خطوة(لازم، "غير_متاح"، "المحرك لم يُسجَّل بعد"))
        }
    }

    ارجع {
        "نوع": تحليل["نوع"]، "ثقة": تحليل["ثقة"]، "لغة": تحليل["لغة"]،
        "خطة": خطة، "نتائج": نتائج، "ذكريات": ذكريات،
        "رد": _صغ_الرد(تحليل، خطة، نتائج، ذكريات)
    }
}

# يصوغ الردّ من النتائج الفعلية فقط
دالة _صغ_الرد(تحليل، خطة، نتائج، ذكريات) {
    متغير أسطر = []
    إذا (يحوي(نتائج، "استرجاع") و طول(نتائج["استرجاع"]) > ٠) {
        أضف(أسطر، "أقرب ما في المعرفة:")
        من_أجل (ن في نتائج["استرجاع"]) { أضف(أسطر، "- " + ن["عنوان"] + " (" + ن["معرف"] + ")") }
    }
    إذا (يحوي(نتائج، "تنفيذ")) {
        متغير ت = نتائج["تنفيذ"]
        إذا (ت["ناجح"]) {
            أضف(أسطر، "نتيجة التشغيل:")
            من_أجل (س في ت["مخرجات"]) { أضف(أسطر، "  " + نص(س)) }
        } وإلا {
            أضف(أسطر، "فشل التشغيل (" + ت["نوع_الخطأ"] + "): " + ت["خطأ"])
        }
    }
    إذا (طول(ذكريات) > ٠) { أضف(أسطر، "من الذاكرة: " + ذكريات[٠]["محتوى"]) }
    من_أجل (خ في خطة) {
        إذا (خ["حالة"] == "غير_متاح") { أضف(أسطر، "لم يتوفر بعد: " + خ["محرك"]) }
    }
    إذا (طول(أسطر) == ٠) { ارجع "" }
    ارجع اربط(أسطر، حرف(١٠))
}

صدّر دالة سجّل_المحرك() {
    جهّز()
    ارجع ع.سجّل(ع.محرك(
        "منسّق"،
        "يحلّل الطلب ويشغّل المحركات اللازمة ويجمع نتائجها في ردّ واحد"،
        {"طلب": "نص"}،
        {"نوع": "نص"، "خطة": "قائمة"، "رد": "نص"}،
        دالة(مدخل) { ارجع نفّذ_الطلب(مدخل["طلب"]) }
    ))
}
