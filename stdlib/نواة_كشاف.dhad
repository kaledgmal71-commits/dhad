# ضاد/نواة_كشاف — التخريج والكشّاف فوق مكتبة المستخدم المربوطة.
# التخريج: يبحث عن اقتباس في فقرات المكتبة بتطابق n-gram كلمات مطبَّعة (بلا تشكيل ولا اختلاف همزات)،
# ويعزو إلى معرّف الفقرة التي وُجد فيها فعلًا، ويقول «لم يوجد» إن لم يجد — لا يختلق عزوًا ولا رقم صفحة.
# (الأصل في «المُحَرِّر» يطابق بـ«includes» على متن مدمج صغير ويكتب عزوات جاهزة لا يمكن التحقق منها؛ لم يُنقل ذلك.)
# الكشّاف: يستخرج من النص الكنى والأنساب (أبو/ابن/بن…)، والأماكن، والكتب المقتبسة بين «»، والآيات بين ﴿﴾.

متغير ر = استورد("ضاد/نواة_رسم")
متغير ن = استورد("ضاد/نصوص")

# كلمات عربية نقية: تتابعات الحروف والتشكيل فقط، فتسقط علامات الترقيم والرموز المحيطة بالكلمة
دالة _كلمات_نقية(نص) {
    متغير خرج = []
    متغير جارية = []
    من_أجل (ح في نص) {
        إذا (ن.هل_حرف_عربي(ح) أو ن.هل_تشكيل(ح)) {
            أضف(جارية، ح)
        } وإلا {
            إذا (طول(جارية) > ٠) { أضف(خرج، اربط(جارية، "")); جارية = [] }
        }
    }
    إذا (طول(جارية) > ٠) { أضف(خرج، اربط(جارية، "")) }
    ارجع خرج
}

دالة _كلمات_مطبعة(نص) {
    متغير خرج = []
    من_أجل (ك في _كلمات_نقية(نص)) {
        متغير ط = ر.طبّع_للمقابلة(ك)
        إذا (طول(ط) > ٠) { أضف(خرج، ط) }
    }
    ارجع خرج
}

دالة _شرائح(كلمات، ك) {
    متغير مجموعة = {}
    من_أجل (ي من ٠ إلى طول(كلمات) - ك) {
        متغير مفتاح = اربط(كلمات[ي:ي + ك]، " ")
        مجموعة[مفتاح] = صحيح
    }
    ارجع مجموعة
}

# فهرس التخريج: فقرات [{"معرف": ..، "نص": ..}] ← فهرس مجهَّز (شرائح ٢ و٣ كلمات لكل فقرة)
صدّر دالة ابنِ_فهرس(فقرات) {
    متغير عناصر = []
    من_أجل (ف في فقرات) {
        متغير ك = _كلمات_مطبعة(ف["نص"])
        أضف(عناصر، {"معرف": ف["معرف"]، "نص": ف["نص"]، "ثنائيات": _شرائح(ك، ٢)، "ثلاثيات": _شرائح(ك، ٣)، "كلمات": طول(ك)})
    }
    ارجع {"عناصر": عناصر}
}

# تخريج اقتباس: خيارات {"حد": ٠.٦، "أقصى": ٣}. تعيد {"حالة": "وُجد"|"لم يوجد"|"قصير"، "نتائج": [{"معرف"، "تطابق"، "نص"}]}
# التطابق = نسبة شرائح الاقتباس الموجودة في الفقرة (١ = الاقتباس كله حرفيًا مع إهمال التشكيل والهمزات).
# الاقتباس بكلمة واحدة «قصير» لا يُخرَّج (يطابق كل شيء). الاقتباس بكلمتين يشترط تتابعهما.
صدّر دالة خرّج(فهرس، اقتباس، خيارات) {
    متغير خ = خيارات
    إذا (خ == لاشيء) { خ = {} }
    متغير حد = ٠.٦
    متغير أقصى = ٣
    إذا ("حد" في خ) { حد = خ["حد"] }
    إذا ("أقصى" في خ) { أقصى = خ["أقصى"] }
    متغير ك = _كلمات_مطبعة(اقتباس)
    إذا (طول(ك) < ٢) { ارجع {"حالة": "قصير"، "نتائج": []} }
    متغير حجم = ٣
    إذا (طول(ك) == ٢) { حجم = ٢ }
    # شرائح الاقتباس بالتتابع؛ التطابق = نسبة كلمات الاقتباس المغطّاة بشرائح وُجدت في الفقرة
    # (فكلمة دخيلة في أول الاقتباس، مثل «قال»، لا تُسقط التطابق كله)
    متغير شرائح_الاقتباس = []
    من_أجل (ي من ٠ إلى طول(ك) - حجم) { أضف(شرائح_الاقتباس، اربط(ك[ي:ي + حجم]، " ")) }
    متغير مرشحون = []
    متغير ترتيب = ٠
    من_أجل (ع في فهرس["عناصر"]) {
        متغير مجموعة = ع["ثلاثيات"]
        إذا (حجم == ٢) { مجموعة = ع["ثنائيات"] }
        متغير مغطاة = []
        من_أجل (ي من ٠ إلى طول(ك) - ١) { أضف(مغطاة، ٠) }
        متغير وُجد = ٠
        من_أجل (ي من ٠ إلى طول(شرائح_الاقتباس) - ١) {
            إذا (شرائح_الاقتباس[ي] في مجموعة) {
                وُجد = وُجد + ١
                من_أجل (ج من ي إلى ي + حجم - ١) { مغطاة[ج] = ١ }
            }
        }
        متغير عدد_مغطى = ٠
        من_أجل (م في مغطاة) { عدد_مغطى = عدد_مغطى + م }
        متغير نسبة = عدد_مغطى / طول(ك)
        ترتيب = ترتيب + ١
        إذا (نسبة >= حد و وُجد > ٠) { أضف(مرشحون، {"معرف": ع["معرف"]، "تطابق": نسبة، "نص": ع["نص"]، "_ترتيب": ترتيب}) }
    }
    إذا (طول(مرشحون) == ٠) { ارجع {"حالة": "لم يوجد"، "نتائج": []} }
    متغير مرتبة = رتب(مرشحون، دالة(أ، ب) {
        إذا (أ["تطابق"] > ب["تطابق"]) { ارجع -١ }
        إذا (أ["تطابق"] < ب["تطابق"]) { ارجع ١ }
        ارجع أ["_ترتيب"] - ب["_ترتيب"]
    })
    متغير نتائج = []
    متغير عدد_النتائج = طول(مرتبة)
    إذا (أقصى < عدد_النتائج) { عدد_النتائج = أقصى }
    من_أجل (ي من ٠ إلى عدد_النتائج - ١) {
        أضف(نتائج، {"معرف": مرتبة[ي]["معرف"]، "تطابق": مرتبة[ي]["تطابق"]، "نص": مرتبة[ي]["نص"]})
    }
    ارجع {"حالة": "وُجد"، "نتائج": نتائج}
}

متغير _أماكن = ["مكة"، "المدينة"، "بغداد"، "دمشق"، "البصرة"، "الكوفة"، "مصر"، "القاهرة"، "نيسابور"، "قرطبة"، "إشبيلية"، "فاس"، "القيروان"،
    "بخارى"، "سمرقند"، "القدس"، "بيت المقدس"، "اليمن"، "الشام"، "العراق"، "خراسان"، "الأندلس"، "الحجاز"، "حران"، "تونس"، "شيراز"، "واسط"، "حمص"]

متغير _كنى = {"ابو": ١، "ابي": ١، "ابا": ١، "ابن": ١، "بن": ١}

# نص بين علامتين (بداية ونهاية) كل منهما حرف واحد: قائمة النصوص المقتبسة
دالة _بين(نص، بداية، نهاية) {
    متغير خرج = []
    متغير ي = ٠
    متغير ع = طول(نص)
    طالما (ي < ع) {
        إذا (نص[ي] == بداية) {
            متغير ج = ي + ١
            طالما (ج < ع و نص[ج] != نهاية) { ج = ج + ١ }
            إذا (ج < ع) { أضف(خرج، نص[ي + ١:ج]); ي = ج }
        }
        ي = ي + ١
    }
    ارجع خرج
}

# كشّاف: {"أعلام": [...]، "أماكن": [...]، "كتب": [...]، "آيات": [...]، "اقتباسات": [...]}
# الأعلام: كلمة كنية/نسب (أبو، أبي، أبا، ابن، بن) مع ما يليها، ومتصلة بـ«بن» إن وُجدت (أبو بكر بن عياش).
# الكتب: ما بين «» إن سبقه «كتاب» أو بدا عنوانًا؛ الاقتباسات: ما بين «» عمومًا؛ الآيات: ما بين ﴿﴾.
صدّر دالة كشاف(نص) {
    متغير كلمات = _كلمات_نقية(نص)
    متغير مطبعة = []
    من_أجل (ك في كلمات) { أضف(مطبعة، ر.طبّع_للمقابلة(ك)) }
    متغير أعلام = []
    متغير ي = ٠
    طالما (ي < طول(كلمات)) {
        متغير ب٠ = ي
        متغير أ٠ = خطأ
        إذا (مطبعة[ي] في _كنى و ي + ١ < طول(كلمات)) {
            أ٠ = صحيح
            # «بن» وحدها تُلحَق بالاسم الذي قبلها (أحمد بن حنبل)
            إذا (مطبعة[ي] == "بن" و ي > ٠) { ب٠ = ي - ١ }
        }
        إذا (أ٠) {
            متغير جزء = []
            من_أجل (ك من ب٠ إلى ي + ١) { أضف(جزء، كلمات[ك]) }
            متغير ج = ي + ٢
            طالما (ج + ١ < طول(كلمات) و مطبعة[ج] == "بن") {
                أضف(جزء، كلمات[ج])
                أضف(جزء، كلمات[ج + ١])
                ج = ج + ٢
            }
            متغير اسم = اربط(جزء، " ")
            إذا (ليس (اسم في أعلام)) { أضف(أعلام، اسم) }
            ي = ج
        } وإلا {
            ي = ي + ١
        }
    }
    متغير أماكن = []
    متغير مطبّع_النص = " " + اربط(مطبعة، " ") + " "
    متغير مفرد = {}
    من_أجل (م في _أماكن) { مفرد[ر.طبّع_للمقابلة(م)] = م }
    من_أجل (م في _أماكن) {
        متغير مط = ر.طبّع_للمقابلة(م)
        متغير وُجد_م = خطأ
        إذا ((" " + مط + " ") في مطبّع_النص) { وُجد_م = صحيح }
        # حرف جر أو عطف متصل (بمكة، ومصر، لدمشق)
        إذا (ليس وُجد_م) {
            من_أجل (بادئ في ["ب"، "و"، "ف"، "ل"، "ك"]) {
                إذا ((" " + بادئ + مط + " ") في مطبّع_النص) { وُجد_م = صحيح }
            }
        }
        إذا (وُجد_م) { أضف(أماكن، م) }
    }
    متغير اقتباسات = _بين(نص، "«"، "»")
    متغير كتب = []
    من_أجل (ق في اقتباسات) {
        إذا (طول(_كلمات_نقية(ق)) <= ٦) { أضف(كتب، ق) }
    }
    ارجع {"أعلام": أعلام، "أماكن": أماكن، "كتب": كتب، "آيات": _بين(نص، "﴿"، "﴾")، "اقتباسات": اقتباسات}
}

# واجهتان للمحركات المركّبة عليه
صدّر دالة كلمات_نقية(نص) { ارجع _كلمات_نقية(نص) }
صدّر دالة بين_علامتين(نص، بداية، نهاية) { ارجع _بين(نص، بداية، نهاية) }
