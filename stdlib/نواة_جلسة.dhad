# ضاد/نواة_جلسة — جلسة نواة الحيّة: تحمل المعرفة والذاكرة وملفات المستخدم، وتخدم صفحة المحادثة عبر معالج المضيف.
# يُسجَّل معالج واحد بـ سجّل_معالج(): المضيف يناديه بـ (فعل، أ، ب) فيعيد خريطة. الحالة تبقى بين النداءات.
#   تهيئة(نص_جسون_القاعدة)  — تحميل فهرس معرفة الموقع وأمثلته الموثَّقة
#   مستند(اسم، نص)          — ربط: يقطّع نص ملف ويفهرسه في المكتبة الدائمة تلقائيًا
#   مستند_docx(اسم، xml) / مستند_html(اسم، html) — استخراج النص ثم الفهرسة في المكتبة
#   إزالة(اسم)              — يزيل ملفًا من المكتبة
#   عدد_مربوط(ن) / صفّر_المكتبة() — الموصّل يخبر الجلسة بعدد ما ربطه، ويفرغ ما جلبه للمهمة السابقة
#   مرفق(اسم، نص) / مرفق_docx / مرفق_html / إزالة_مرفق(اسم) / صفّر_المرفقات() — إرفاق: ملف عابر بنصه الكامل للتحليل
#   اسأل(طلب)               — ينفّذ الطلب بالمنسّق ويعيد الردّ والخطة والنتائج
#   مستندات()               — أسماء الملفات (مربوطة ومرفقة) وعدد مقاطع كل منها

متغير ج = استورد("ضاد/جسون")
متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ذ = استورد("ضاد/نواة_ذاكرة")
متغير س = استورد("ضاد/نواة_منسق")
متغير ا = استورد("ضاد/نواة_استيعاب")
متغير ط٠ = استورد("ضاد/نواة_خطة")
متغير ح٧ = استورد("ضاد/نواة_حوار")
متغير ت٧ = استورد("ضاد/نواة_تلخيص")

متغير _قاعدة = ""
# دليل ضاد (مقاطع نثرية من الدليل والدروس والشروحات والمعجم) تُجيب منه نواة عن أسئلة اللغة
متغير _دليل = ""
متغير _ذاكرة = ذ.أنشئ(٢٠)
# آخر ما جرى في المحادثة (لمتابعات: شغّله، اشرحه، المزيد): الشيفرة المعروضة وعنوان مثالها وطلب البحث وما عُرض منه
متغير _آخر = {}
# عدد الملفات المربوطة بالموصّل (مراجع لا نسخ): تُجلَب عند الحاجة فقط ويصل منها إلى المكتبة ما يخص المهمة الجارية
متغير _عدد_مربوط = ٠

# مجموعتان من الملفات، لكل منهما مقاطعها وفهرسها:
#   المكتبة: ملفات مربوطة دائمة يُبحث فيها في كل مهمة (كتب كبيرة، مجلدات)؛ فهرسها بعيّنة منتظمة للكبير.
#   المرفقات: ملفات عابرة تُجرى عليها العمليات كاملة (تحليل، تلخيص، تشغيل)؛ تحتفظ بنصها الكامل.
متغير _مكتبة = {"مقاطع": []، "فهرس": ""، "أسماء": {}}
متغير _مرفقات = {"مقاطع": []، "فهرس": ""، "أسماء": {}، "نصوص": {}}

دالة _أعد_الفهرسة(مج) {
    إذا (طول(مج["مقاطع"]) == ٠) {
        مج["فهرس"] = ""
    } وإلا {
        مج["فهرس"] = ر.ابنِ(مج["مقاطع"]، ٦٠٠، ٣٠٠، ٣٠٠٠٠)
    }
}

دالة _أزل(مج، اسم) {
    متغير بقي = []
    من_أجل (م في مج["مقاطع"]) {
        إذا (ليس (افصل(م["معرف"]، "#")[٠] == اسم)) { أضف(بقي، م) }
    }
    مج["مقاطع"] = بقي
    إذا (يحوي(مج["أسماء"]، اسم)) { احذف(مج["أسماء"]، اسم) }
    إذا (يحوي(مج، "نصوص")) {
        إذا (يحوي(مج["نصوص"]، اسم)) { احذف(مج["نصوص"]، اسم) }
    }
    مج["متسخ"] = صحيح
    ارجع {"اسم": اسم}
}

دالة _أضف(مج، اسم، نص_) {
    إذا (يحوي(مج["أسماء"]، اسم)) { _أزل(مج، اسم) }
    متغير جديد = ا.وثائق_من_نص(اسم، اسم، نص_، ٥٠٠)
    من_أجل (م في جديد) { أضف(مج["مقاطع"]، م) }
    مج["أسماء"][اسم] = طول(جديد)
    إذا (يحوي(مج، "نصوص")) { مج["نصوص"][اسم] = نص_ }
    مج["متسخ"] = صحيح
    ارجع {"اسم": اسم، "مقاطع": طول(جديد)}
}

# يضيف إلى كل نتيجة من الملفات مقتطفًا من نص مقطعها ليعرضه المضيف
دالة _أغنِ_بالمقتطفات(نتائج) {
    من_أجل (ن في نتائج) {
        من_أجل (مج في [_مرفقات، _مكتبة]) {
            من_أجل (م في مج["مقاطع"]) {
                إذا (م["معرف"] == ن["معرف"]) {
                    متغير ن_ص = م["نص"]
                    إذا (طول(ن_ص) > ٣٢٠) { ن_ص = اقتطع(ن_ص، ٠، ٣٢٠) + "…" }
                    ن["مقتطف"] = ن_ص
                }
            }
        }
    }
    ارجع نتائج
}

# خلاصة استخراجية مما جاء من الويب والمستودعات: جمل حرفية من مصادرها الأقرب إلى السؤال، لا كلام مُنشأ
دالة _لخّص_الويب(طلب، ن) {
    متغير مصادر = []
    من_أجل (د في ن["نتائج"]["مستندات"]) {
        متغير اسم = افصل(د["معرف"]، "#")[٠]
        إذا ((طول(اسم) > ٤ و اسم[٠:٤] == "ويب/") أو (طول(اسم) > ٧ و اسم[٠:٧] == "github/")) { أضف(مصادر، {"مصدر": اسم، "نص": _نص_المقطع(د["معرف"])}) }
    }
    إذا (طول(مصادر) > ٠) {
        متغير ل = ت٧.لخّص(مصادر، طلب)
        إذا (ل["وُجد"]) {
            ن["نتائج"]["خلاصة"] = {"نص": ل["نص"]، "مصادر": ل["مصادر"]}
            ن["رد"] = ل["نص"] + حرف(١٠) + حرف(١٠) + ن["رد"]
        }
    }
}

# نص المقطع بمعرفه (من المرفقات ثم المكتبة) لتتحقق المطابقة من وجود جذور الطلب فيه
دالة _نص_المقطع(معرف) {
    من_أجل (مج في [_مرفقات، _مكتبة]) {
        من_أجل (م في مج["مقاطع"]) { إذا (م["معرف"] == معرف) { ارجع م["نص"] } }
    }
    ارجع ""
}

# يحفظ ما يلزم لفهم الطلب التالي: الشيفرة ومثالها، وطلب البحث وما عُرض منه
دالة _حدّث_الآخر(طلب، ن) {
    متغير ت = ن["نتائج"]
    إذا (ن["نوع"] == "متابعة") {
        إذا (يحوي(ت، "استرجاع") و يحوي(_آخر، "عرض")) {
            من_أجل (م في ت["استرجاع"]) { أضف(_آخر["عرض"]، م["معرف"]) }
        }
        ارجع صحيح
    }
    إذا (ن["نوع"] == "سؤال_لغة") {
        _آخر["معلّق"] = ت["معلّق"]
        ارجع صحيح
    }
    إذا (يحوي(_آخر، "معلّق")) { احذف(_آخر، "معلّق") }
    إذا (يحوي(ن، "لغة") و ن["لغة"] != "") { _آخر["لغة"] = ن["لغة"] }
    إذا (يحوي(ت، "تأليف")) { _آخر["شيفرة"] = ت["تأليف"]["شيفرة"] }
    # الشيفرة التي عمل عليها الطلب (مشروحة أو مُصلَحة) تصير ما يتابَع عليه: «شغّله» بعد «أصلح»
    إذا (يحوي(ت، "شيفرة_حالية")) { _آخر["شيفرة"] = ت["شيفرة_حالية"] }
    إذا (ن["نوع"] == "دليل") {
        _آخر["دليل_طلب"] = ت["دليل"]["طلب"]
        ارجع صحيح
    }
    إذا (يحوي(_آخر، "دليل_طلب")) { احذف(_آخر، "دليل_طلب") }
    إذا (ن["نوع"] == "حوار" أو ن["نوع"] == "تحليل_ملف" أو ن["نوع"] == "مقابلة" أو ن["نوع"] == "صرف" أو ن["نوع"] == "إملاء" أو ن["نوع"] == "تخريج" أو ن["نوع"] == "كشاف" أو ن["نوع"] == "شرح" أو ن["نوع"] == "تعليم" أو ن["نوع"] == "إصلاح") { ارجع صحيح }
    إذا (يحوي(ت، "توليف") و ت["توليف"]["وُجد"]) {
        _آخر["شيفرة"] = ت["توليف"]["شيفرة"]
        _آخر["مصدر"] = ت["توليف"]["مصدر"]
        _آخر["عنوان"] = _قاعدة["أمثلة"][ت["توليف"]["مصدر"]]["عنوان"]
    }
    إذا (يحوي(ت، "استرجاع") و طول(ت["استرجاع"]) > ٠) {
        _آخر["استعلام"] = طلب
        _آخر["عرض"] = []
        من_أجل (م في ت["استرجاع"]) { أضف(_آخر["عرض"]، م["معرف"]) }
        إذا (ليس يحوي(_آخر، "عنوان") أو ليس يحوي(ت، "توليف")) { _آخر["عنوان"] = ت["استرجاع"][٠]["عنوان"] }
    }
}

# الفهرسة كسولة: إضافة ملفات كثيرة لا تعيد بناء الفهرس بعدد الملفات، بل مرة واحدة قبل السؤال
دالة _حدّث_الفهارس() {
    من_أجل (مج في [_مكتبة، _مرفقات]) {
        إذا (يحوي(مج، "متسخ") و مج["متسخ"]) {
            _أعد_الفهرسة(مج)
            مج["متسخ"] = خطأ
        }
    }
}

دالة _اسأل_واحد(طلب، سلسلة = خطأ) {
    إذا (_قاعدة == "") { أطلق_خطأ("الجلسة لم تُهيَّأ بعد") }
    _حدّث_الفهارس()
    متغير سياق = {"فهرس": _قاعدة["فهرس"]، "قاعدة": _قاعدة، "ذاكرة": _ذاكرة، "عدد_المكتبة": _عدد_مربوط، "نص_المقطع": _نص_المقطع}
    إذا (_دليل != "") { سياق["دليل"] = _دليل }
    سياق["مقاطع"] = {"مرفقات": _مرفقات["مقاطع"]، "مكتبة": _مكتبة["مقاطع"]}
    إذا (_مكتبة["فهرس"] != "") { سياق["مستندات"] = _مكتبة["فهرس"] }
    إذا (طول(مفاتيح(_مرفقات["أسماء"])) > ٠) { سياق["مرفقات"] = {"فهرس": _مرفقات["فهرس"]، "ملفات": _مرفقات["نصوص"]} }
    إذا (طول(مفاتيح(_آخر)) > ٠) { سياق["آخر"] = _آخر }
    إذا (سلسلة) { سياق["سلسلة"] = صحيح }
    متغير ن = س.نفّذ_الطلب(طلب، سياق)
    _حدّث_الآخر(طلب، ن)
    إذا (ن["رد"] == "") {
        متغير تحية = ""
        إذا (يحوي(ن، "بادئة") و ن["بادئة"] != "") { تحية = ن["بادئة"] + حرف(١٠) + حرف(١٠) }
        ن["رد"] = تحية + "لم أفهم هذا الطلب بعد، ولم أجد ما يخصه في الويب ولا في الملفات المتاحة. أستطيع البحث في الويب وأرشيفاته وفي ملفاتك، وتحليل ملف ترفقه، وتصحيح النصوص العربية، وكتابة برامج وتشغيلها والتحقق منها. صِف المطلوب بكلمات أخرى."
    }
    إذا (يحوي(ن["نتائج"]، "مستندات")) { _أغنِ_بالمقتطفات(ن["نتائج"]["مستندات"]); _لخّص_الويب(طلب، ن) }
    ارجع ن
}

# متابعة («شغّله»، «اشرحه») لا يوجد ما تتابعه: لا برنامج في حالة الجلسة
دالة _بلا_ما_يتابَع(خطوة) {
    متغير م = ح٧.متابعة(خطوة)
    إذا (م != "شغّل" و م != "اشرح") { ارجع خطأ }
    ارجع ليس (يحوي(_آخر، "شيفرة") و _آخر["شيفرة"] != "")
}

# لم تتحقق الخطوة؟ تشغيل فاشل، أو متابعة تُخطّيت لانعدام ما تتابعه. التحقق هنا من حالة العالم (نتيجة التشغيل) لا من كلام الردّ.
دالة _فشلت(ن) {
    إذا (يحوي(ن["نتائج"]، "تنفيذ") و ليس ن["نتائج"]["تنفيذ"]["ناجح"]) { ارجع صحيح }
    إذا (يحوي(ن["نتائج"]، "إصلاح") و (ن["نتائج"]["إصلاح"]["حالة"] == "تعذّر" أو ن["نتائج"]["إصلاح"]["حالة"] == "تشخيص")) { ارجع صحيح }
    إذا (ن["نوع"] == "متابعة") {
        من_أجل (خ في ن["خطة"]) { إذا (خ["حالة"] == "تُخطّي") { ارجع صحيح } }
    }
    ارجع خطأ
}

# خطة مركّبة: خطوات متتابعة بحالة الجلسة نفسها. كل خطوة تُنفَّذ وتُفحَص نتيجتها قبل التي بعدها:
# سؤال عن اللغة أو ردّ فارغ يوقف الخطة، وما بعده يُعلَن ولا يُنفَّذ؛ وسؤال اللغة يحفظ بقية الخطة لتُستأنف بجوابه.
دالة _نفّذ_خطوات(خطوات) {
    متغير ردود = []
    متغير نتائج = []
    متغير أُوقفت = خطأ
    متغير ن٣ = لاشيء
    من_أجل (ي في مدى(طول(خطوات))) {
        إذا (ليس أُوقفت) {
            إذا (ي >= ط٠.سقف()) {
                أضف(ردود، "لم أنفّذ ما بعد الخطوة " + نص(ط٠.سقف()) + ": الخطة لا تتجاوز " + نص(ط٠.سقف()) + " خطوات في الطلب الواحد.")
                أُوقفت = صحيح
            } وإلا إذا (طول(خطوات) > ١ و _بلا_ما_يتابَع(خطوات[ي])) {
                أضف(ردود، نص(ي + ١) + ") " + خطوات[ي] + حرف(١٠) + "لا أرى برنامجًا سابقًا لأتابع عليه، فلم أنفّذ هذه الخطوة ولا ما بعدها.")
                أُوقفت = صحيح
            } وإلا {
                ن٣ = _اسأل_واحد(خطوات[ي]، ي > ٠)
                أضف(نتائج، ن٣)
                أضف(ردود، نص(ي + ١) + ") " + خطوات[ي] + حرف(١٠) + ن٣["رد"])
                # إعادة التخطيط: تشغيل فشل ولدينا شيفرة، فمحاولة إصلاح واحدة ثم إعادة الخطوة نفسها مرة واحدة
                إذا (يحوي(ن٣["نتائج"]، "تنفيذ") و ليس ن٣["نتائج"]["تنفيذ"]["ناجح"] و يحوي(_آخر، "شيفرة") و _آخر["شيفرة"] != "") {
                    متغير س٣ = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
                    متغير إص = _اسأل_واحد("أصلح هذا الكود" + حرف(١٠) + س٣ + حرف(١٠) + _آخر["شيفرة"] + حرف(١٠) + س٣، ي > ٠)
                    إذا (يحوي(إص["نتائج"]، "إصلاح") و إص["نتائج"]["إصلاح"]["حالة"] == "أُصلحت") {
                        ن٣ = _اسأل_واحد(خطوات[ي]، ي > ٠)
                        أضف(نتائج، ن٣)
                        أضف(ردود، "أصلحتُ الشيفرة وأعدتُ المحاولة:" + حرف(١٠) + ن٣["رد"])
                    }
                }
                إذا (ن٣["نوع"] == "سؤال_لغة") {
                    متغير بقية = []
                    من_أجل (ب في مدى(ي + ١، طول(خطوات))) { أضف(بقية، خطوات[ب]) }
                    إذا (طول(بقية) > ٠) { _آخر["بقية"] = بقية }
                    أُوقفت = صحيح
                } وإلا إذا (_فشلت(ن٣) و ي + ١ < طول(خطوات)) {
                    أضف(ردود، "توقفت هنا: لم تتحقق هذه الخطوة، فلم أنفّذ ما بعدها.")
                    أُوقفت = صحيح
                } وإلا إذا (ن٣["رد"] == "") {
                    أضف(ردود، "أُوقفتت هنا: لم أجد ما أنفّذه لهذه الخطوة، فلم أنفّذ ما بعدها.")
                    أُوقفت = صحيح
                }
            }
        }
    }
    إذا (طول(ردود) == ١ و طول(نتائج) == ١) { ارجع نتائج[٠] }
    متغير لغة_أخيرة = ""
    إذا (طول(نتائج) > ٠) { لغة_أخيرة = نتائج[طول(نتائج) - ١]["لغة"] }
    ارجع {
        "نوع": "خطة_مركبة"، "ثقة": ١٠٠، "لغة": لغة_أخيرة، "خطة": [{"محرك": "خطة"، "حالة": "نُفّذ"، "تفصيل": نص(طول(نتائج)) + " خطوات"}]،
        "نتائج": {"خطوات": نتائج}، "ذكريات": []، "بادئة": ""، "رد": اربط(ردود، حرف(١٠) + حرف(١٠))
    }
}

دالة _اسأل(طلب) {
    متغير بقية = []
    إذا (يحوي(_آخر، "بقية")) {
        بقية = _آخر["بقية"]
        احذف(_آخر، "بقية")
    }
    إذا (طول(بقية) > ٠ و س.تكمّل_معلّقًا(طلب، _آخر)) {
        متغير خطوات = [طلب]
        من_أجل (ب في بقية) { أضف(خطوات، ب) }
        ارجع _نفّذ_خطوات(خطوات)
    }
    ارجع _نفّذ_خطوات(ط٠.فكّك(طلب))
}

دالة _قائمة_المستندات() {
    متغير خرج = []
    من_أجل (ك في رتب(مفاتيح(_مكتبة["أسماء"]))) { أضف(خرج، {"اسم": ك، "مقاطع": _مكتبة["أسماء"][ك]، "نوع": "ربط"}) }
    من_أجل (ك في رتب(مفاتيح(_مرفقات["أسماء"]))) { أضف(خرج، {"اسم": ك، "مقاطع": _مرفقات["أسماء"][ك]، "نوع": "إرفاق"}) }
    ارجع {"مستندات": خرج}
}

دالة _صفّر_السياق() {
    _آخر = {}
    ارجع {"تم": صحيح}
}

دالة _صفّر_المرفقات() {
    _مرفقات["مقاطع"] = []
    _مرفقات["فهرس"] = ""
    _مرفقات["أسماء"] = {}
    _مرفقات["نصوص"] = {}
    ارجع {"تم": صحيح}
}

سجّل_معالج(دالة(فعل، أ، ب) {
    إذا (فعل == "تهيئة") {
        _قاعدة = ج.حلّل(أ)
        س.جهّز()
        ارجع {"جاهز": صحيح، "أمثلة": طول(مفاتيح(_قاعدة["أمثلة"]))}
    }
    إذا (فعل == "دليل") {
        _دليل = ج.حلّل(أ)
        ارجع {"جاهز": صحيح، "مقاطع": طول(_دليل["مقاطع"])}
    }
    # الربط: مكتبة دائمة
    إذا (فعل == "مستند") { ارجع _أضف(_مكتبة، أ، ب) }
    إذا (فعل == "مستند_docx") { ارجع _أضف(_مكتبة، أ، ا.نص_من_docx_xml(ب)) }
    إذا (فعل == "مستند_html") { ارجع _أضف(_مكتبة، أ، ا.نص_من_html(ب)) }
    إذا (فعل == "إزالة") { ارجع _أزل(_مكتبة، أ) }
    إذا (فعل == "عدد_مربوط") { _عدد_مربوط = أ
        ارجع {"تم": صحيح} }
    إذا (فعل == "صفّر_المكتبة") {
        _مكتبة["مقاطع"] = []
        _مكتبة["فهرس"] = ""
        _مكتبة["أسماء"] = {}
        ارجع {"تم": صحيح}
    }
    # الإرفاق: ملف عابر يُحلَّل كاملًا
    إذا (فعل == "مرفق") { ارجع _أضف(_مرفقات، أ، ب) }
    إذا (فعل == "مرفق_docx") { ارجع _أضف(_مرفقات، أ، ا.نص_من_docx_xml(ب)) }
    إذا (فعل == "مرفق_html") { ارجع _أضف(_مرفقات، أ، ا.نص_من_html(ب)) }
    إذا (فعل == "إزالة_مرفق") { ارجع _أزل(_مرفقات، أ) }
    إذا (فعل == "صفّر_المرفقات") { ارجع _صفّر_المرفقات() }
    إذا (فعل == "صفّر_السياق") { ارجع _صفّر_السياق() }
    إذا (فعل == "اسأل") { ارجع _اسأل(أ) }
    إذا (فعل == "مستندات") { ارجع _قائمة_المستندات() }
    أطلق_خطأ("فعل غير معروف: " + نص(فعل))
})
