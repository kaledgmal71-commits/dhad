# ضاد/نواة_جلسة — جلسة نواة الحيّة: تحمل المعرفة والذاكرة وملفات المستخدم، وتخدم صفحة المحادثة عبر معالج المضيف.
# يُسجَّل معالج واحد بـ سجّل_معالج(): المضيف يناديه بـ (فعل، أ، ب) فيعيد خريطة. الحالة تبقى بين النداءات.
#   تهيئة(نص_جسون_القاعدة)  — تحميل فهرس معرفة الموقع وأمثلته الموثَّقة
#   مستند(اسم، نص)          — يقطّع نص ملف ويفهرسه تلقائيًا
#   مستند_docx(اسم، xml) / مستند_html(اسم، html) — استخراج النص ثم الفهرسة
#   إزالة(اسم)              — يزيل ملفًا من الفهرس
#   اسأل(طلب)               — ينفّذ الطلب بالمنسّق ويعيد الردّ والخطة والنتائج
#   مستندات()               — أسماء الملفات المفهرسة وعدد مقاطع كل منها

متغير ج = استورد("ضاد/جسون")
متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ذ = استورد("ضاد/نواة_ذاكرة")
متغير س = استورد("ضاد/نواة_منسق")
متغير ا = استورد("ضاد/نواة_استيعاب")

متغير _قاعدة = ""
متغير _ذاكرة = ذ.أنشئ(٢٠)
متغير _مقاطع = []
متغير _فهرس_المستندات = ""
متغير _أسماء = {}

دالة _أعد_فهرسة_المستندات() {
    إذا (طول(_مقاطع) == ٠) {
        _فهرس_المستندات = ""
    } وإلا {
        _فهرس_المستندات = ر.ابنِ(_مقاطع، ٦٠٠، ٣٠٠، ٣٠٠٠٠)
    }
}

دالة _مستند(اسم، نص_) {
    إذا (يحوي(_أسماء، اسم)) { _أزل(اسم) }
    متغير جديد = ا.وثائق_من_نص(اسم، اسم، نص_، ٥٠٠)
    من_أجل (م في جديد) { أضف(_مقاطع، م) }
    _أسماء[اسم] = طول(جديد)
    _أعد_فهرسة_المستندات()
    ارجع {"اسم": اسم، "مقاطع": طول(جديد)}
}

دالة _أزل(اسم) {
    متغير بقي = []
    من_أجل (م في _مقاطع) {
        إذا (ليس (افصل(م["معرف"]، "#")[٠] == اسم)) { أضف(بقي، م) }
    }
    _مقاطع = بقي
    إذا (يحوي(_أسماء، اسم)) { احذف(_أسماء، اسم) }
    _أعد_فهرسة_المستندات()
    ارجع {"اسم": اسم}
}

# يضيف إلى كل نتيجة من الملفات مقتطفًا من نص مقطعها ليعرضه المضيف
دالة _أغنِ_بالمقتطفات(نتائج) {
    من_أجل (ن في نتائج) {
        من_أجل (م في _مقاطع) {
            إذا (م["معرف"] == ن["معرف"]) {
                متغير ن_ص = م["نص"]
                إذا (طول(ن_ص) > ٣٢٠) { ن_ص = اقتطع(ن_ص، ٠، ٣٢٠) + "…" }
                ن["مقتطف"] = ن_ص
            }
        }
    }
    ارجع نتائج
}

دالة _اسأل(طلب) {
    إذا (_قاعدة == "") { أطلق_خطأ("الجلسة لم تُهيَّأ بعد") }
    متغير سياق = {"فهرس": _قاعدة["فهرس"]، "قاعدة": _قاعدة، "ذاكرة": _ذاكرة}
    إذا (_فهرس_المستندات != "") { سياق["مستندات"] = _فهرس_المستندات }
    متغير ن = س.نفّذ_الطلب(طلب، سياق)
    إذا (ن["رد"] == "") {
        ن["رد"] = "لم أجد في معرفتي الحالية ما يخص طلبك. جرّب صياغة أخرى، أو أرفق ملفًا ليصير جزءًا مما أبحث فيه."
    }
    إذا (يحوي(ن["نتائج"]، "مستندات")) { _أغنِ_بالمقتطفات(ن["نتائج"]["مستندات"]) }
    ارجع ن
}

دالة _قائمة_المستندات() {
    متغير خرج = []
    من_أجل (ك في رتب(مفاتيح(_أسماء))) { أضف(خرج، {"اسم": ك، "مقاطع": _أسماء[ك]}) }
    ارجع {"مستندات": خرج}
}

سجّل_معالج(دالة(فعل، أ، ب) {
    إذا (فعل == "تهيئة") {
        _قاعدة = ج.حلّل(أ)
        س.جهّز()
        ارجع {"جاهز": صحيح، "أمثلة": طول(مفاتيح(_قاعدة["أمثلة"]))}
    }
    إذا (فعل == "مستند") { ارجع _مستند(أ، ب) }
    إذا (فعل == "مستند_docx") { ارجع _مستند(أ، ا.نص_من_docx_xml(ب)) }
    إذا (فعل == "مستند_html") { ارجع _مستند(أ، ا.نص_من_html(ب)) }
    إذا (فعل == "إزالة") { ارجع _أزل(أ) }
    إذا (فعل == "اسأل") { ارجع _اسأل(أ) }
    إذا (فعل == "مستندات") { ارجع _قائمة_المستندات() }
    أطلق_خطأ("فعل غير معروف: " + نص(فعل))
})
