# ضاد/نواة_تعليم — يجيب عن «كيف أكتب … في ضاد» بمفهوم ومثال يُشغَّل الآن وشرح من شجرة صياغته (محرك الشرح)،
# لا بروابط دروس ولا بمقاطع مسترجَعة. الأمثلة مكتوبة بيد وتُختبر كلها بالتشغيل في اختبارات المستودع.
# الحدّ: مفاهيم الأساس فقط (متغير، شرط، حلقتان، دالة، قائمة، خريطة، نصوص)؛ ما عداها يُترك لبقية المنسّق.
# في أسطر الأمثلة يمثّل الرمز ¤ علامة الاقتباس المزدوجة (لا يُكتب الاقتباس المزدوج داخل نص ضاد دون دالة).

متغير رسم_ = استورد("ضاد/نواة_رسم")
متغير شرح_ = استورد("ضاد/نواة_شرح")
متغير كشاف_ = استورد("ضاد/نواة_كشاف")

# صيغ السؤال التي تطلب تعليمًا (بعد التطبيع)
متغير _صيغ_السؤال = ["كيف"، "علمني"، "اشرح"، "مثال"، "اتعلم"، "ما هي"، "ما هو"، "طريقه"، "كيفيه"، "استخدم"]

# المفاهيم: الأخص قبل الأعم
متغير _مفاهيم = [
    {"معرف": "طالما"،
     "كلمات": ["طالما"، "حلقه شرطيه"]،
     "وصف": "حلقة «طالما» تكرر كتلة ما دام شرطها متحققًا؛ تنتهي حين يصير الشرط خطأ، فاحرص أن يتغير داخلها شيء يقرّبها من النهاية."،
     "شيفرة": ["متغير ن = ٣"،
        "طالما (ن > ٠) {"،
        "    اطبع(ن)"،
        "    ن = ن - ١"،
        "}"]}،
    {"معرف": "حلقة_عناصر"،
     "كلمات": ["كل عنصر"، "عناصر القايمه"، "المرور على"، "امر على"]،
     "وصف": "للمرور على عناصر قائمة واحدًا واحدًا تُستعمل «من_أجل (اسم في القائمة)»، فيأخذ الاسم كل عنصر بالتتابع."،
     "شيفرة": ["متغير فواكه = [¤تفاح¤، ¤موز¤، ¤عنب¤]"،
        "من_أجل (ف في فواكه) {"،
        "    اطبع(ف)"،
        "}"]}،
    {"معرف": "حلقة"،
     "كلمات": ["حلقه"، "حلقات"، "تكرار"، "كرر"]،
     "وصف": "الحلقة تعيد تنفيذ كتلة عدة مرات. «من_أجل (ع من ١ إلى ٥)» تجعل ع يأخذ الأعداد من ١ إلى ٥ بالتتابع، والحد الأخير داخل."،
     "شيفرة": ["من_أجل (ع من ١ إلى ٥) {"،
        "    اطبع(ع، ¤×¤، ع، ¤=¤، ع * ع)"،
        "}"]}،
    {"معرف": "شرط"،
     "كلمات": ["شرط"، "شروط"، "اذا"، "قرار"، "قرارات"]،
     "وصف": "الشرط يجعل البرنامج يختار طريقه: ما بين قوسي «إذا» يُفحص، فإن تحقق نُفّذت كتلته، وإلا نُفّذت كتلة «وإلا» إن وُجدت."،
     "شيفرة": ["متغير درجة = ٧٥"،
        "إذا (درجة >= ٥٠) {"،
        "    اطبع(¤ناجح¤)"،
        "} وإلا {"،
        "    اطبع(¤راسب¤)"،
        "}"]}،
    {"معرف": "دالة"،
     "كلمات": ["دالة"، "دوال"، "وظيفه"]،
     "وصف": "الدالة خطوات تُسمّى مرة وتُستدعى متى شئت. تأخذ معاملات وتُرجع نتيجة بـ«ارجع»."،
     "شيفرة": ["دالة جمع(أ، ب) {"،
        "    ارجع أ + ب"،
        "}"،
        "اطبع(جمع(٢، ٣))"]}،
    {"معرف": "قائمة"،
     "كلمات": ["قايمه"، "قوايم"، "مصفوفه"]،
     "وصف": "القائمة تحفظ قيمًا مرتبة تحت اسم واحد. يبدأ الترقيم من صفر، و«أضف» تضيف في آخرها، و«طول» تعدّ عناصرها."،
     "شيفرة": ["متغير ق = [٣، ١، ٢]"،
        "أضف(ق، ٤)"،
        "اطبع(طول(ق))"،
        "اطبع(ق[٠])"]}،
    {"معرف": "خريطة"،
     "كلمات": ["خريطه"، "خرايط"، "قاموس"]،
     "وصف": "الخريطة تربط مفاتيح بقيم: تقرأ القيمة بمفتاحها، وتضيف مفتاحًا جديدًا بالإسناد إليه، و«مفاتيح» تعطيك المفاتيح."،
     "شيفرة": ["متغير ش = {¤اسم¤: ¤علي¤، ¤عمر¤: ٢٠}"،
        "اطبع(ش[¤اسم¤])"،
        "ش[¤مدينة¤] = ¤القاهرة¤"،
        "اطبع(مفاتيح(ش))"]}،
    {"معرف": "متغير"،
     "كلمات": ["متغير"، "متغيرات"، "تخزين قيمه"]،
     "وصف": "المتغير اسم يحفظ قيمة لتستعملها لاحقًا؛ يُعرَّف بـ«متغير» ثم يمكن تغيير قيمته بالإسناد."،
     "شيفرة": ["متغير الاسم = ¤ضاد¤"،
        "متغير العدد = ٣"،
        "العدد = العدد + ١"،
        "اطبع(الاسم، العدد)"]}،
    {"معرف": "نصوص"،
     "كلمات": ["النصوص"، "السلاسل"، "سلسله نصيه"]،
     "وصف": "النص سلسلة حروف بين علامتي اقتباس. يُضم بعضه إلى بعض بـ«+»، وتُقصّ منه أجزاء بـ[من:إلى]، و«طول» تعدّ حروفه."،
     "شيفرة": ["متغير س = ¤السلام عليكم¤"،
        "اطبع(طول(س))"،
        "اطبع(س[٠:٥])"،
        "اطبع(س + ¤ يا ضاد¤)"]}
]

# تعريف «ال» يُنزع من الكلمة المطبَّعة حتى تتفق «الشرط» و«شرط»
دالة _قشّر(ك) {
    إذا (طول(ك) > ٤ و ك[٠:٢] == "ال") { ارجع ك[٢:طول(ك)] }
    ارجع ك
}

دالة _كلمات_مقشّرة(عبارة) {
    متغير م = []
    من_أجل (ك في افصل(عبارة، " ")) { إذا (ك != "") { أضف(م، _قشّر(رسم_.طبّع_للمقابلة(ك))) } }
    ارجع م
}

# الطلب مطبَّعًا كلمةً كلمة ومحاطًا بمسافتين
دالة _نص_مطبَّع(طلب) {
    متغير م = []
    من_أجل (ك في كشاف_.كلمات_نقية(طلب)) { أضف(م، _قشّر(رسم_.طبّع_للمقابلة(ك))) }
    ارجع " " + اربط(م، " ") + " "
}

دالة _فيه(س، عبارات) {
    من_أجل (ب في عبارات) {
        إذا (يحوي(س، " " + ب + " ")) { ارجع صحيح }
    }
    ارجع خطأ
}

# كلمات الفئة بعد التطبيع كالطلب (لتتفق «قائمة» و«قايمه» مثلًا)
دالة _طبّع_القائمة(قائمة) {
    متغير خرج = []
    من_أجل (ك في قائمة) { أضف(خرج، اربط(_كلمات_مقشّرة(ك)، " ")) }
    ارجع خرج
}

# نص المثال كما يُشغَّل
صدّر دالة نص_المثال(م) {
    متغير أسطر = []
    من_أجل (ل في م["شيفرة"]) { أضف(أسطر، استبدل(ل، "¤"، حرف(٣٤))) }
    ارجع اربط(أسطر، حرف(١٠))
}

صدّر دالة المفاهيم() { ارجع _مفاهيم }

# يعيد لاشيء إن لم يكن الطلب تعليمًا عن أحد المفاهيم؛ وإلا {معرف، رد، شرح}
صدّر دالة أجب(طلب) {
    # من كتب شيفرة بنفسه فطلبه عن شيفرته لا عن مفهوم
    إذا (يحوي(طلب، حرف(٩٦) + حرف(٩٦) + حرف(٩٦))) { ارجع لاشيء }
    متغير س = _نص_مطبَّع(طلب)
    إذا (ليس _فيه(س، _طبّع_القائمة(_صيغ_السؤال))) { ارجع لاشيء }
    من_أجل (م في _مفاهيم) {
        إذا (_فيه(س، _طبّع_القائمة(م["كلمات"]))) {
            متغير شيفرة = نص_المثال(م)
            متغير ش = شرح_.اشرح(شيفرة)
            متغير سياج = حرف(٩٦) + حرف(٩٦) + حرف(٩٦)
            ارجع {
                "معرف": م["معرف"]،
                "شيفرة": شيفرة،
                "شرح": ش،
                "رد": م["وصف"] + حرف(١٠) + حرف(١٠) + "مثال شُغِّل الآن:" + حرف(١٠) + سياج + حرف(١٠) + شيفرة + حرف(١٠) + سياج + حرف(١٠) + حرف(١٠) + "شرحه:" + حرف(١٠) + شرح_.صغ(ش)
            }
        }
    }
    ارجع لاشيء
}
