# ضاد/نواة_رسم — محرك الرسم الخطي والتصحيف: يجرّد الكلمة من النقط والتشكيل إلى هيكلها الخطي (الرسم غير المنقوط)
# ويقيس قرب الكلمتين رسمًا. الأصل الفكري من محرك «المُحَرِّر»؛ والتحسين هنا أن شكل الحرف يُحسب بموضعه في الكلمة:
# ب ت ث ن ي ئ متطابقة في أول الكلمة ووسطها، وتفترق في آخرها (ن غير ب غير ي)، وكذلك ف وق.
# يعتمد على ضاد/نصوص ولا يستعمل أي مكتبة خارجية.

متغير ن = استورد("ضاد/نصوص")

دالة _حروف(س) {
    متغير ق = []
    من_أجل (ح في س) { أضف(ق، ح) }
    ارجع ق
}

دالة _خريطة(أزواج) {
    متغير خ = {}
    من_أجل (ز في أزواج) {
        من_أجل (ح في _حروف(ز[٠])) { خ[ح] = ز[١] }
    }
    ارجع خ
}

# أحرف مفردة الشكل مهما كان موضعها
متغير _ثابتة = _خريطة([["جحخ"، "ح"]، ["دذ"، "د"]، ["رز"، "ر"]، ["سش"، "س"]، ["صض"، "ص"]، ["طظ"، "ط"]، ["عغ"، "ع"]،
    ["بتث"، "ٮ"]، ["ف"، "ڡ"]، ["ى"، "ى"]، ["هة"، "ه"]، ["وؤ"، "و"]، ["اأإآٱ"، "ا"]])

# أحرف لا تتصل بما بعدها فتأخذ شكل الآخر دائمًا
متغير _قاطعة = _خريطة([["ادذرزوؤأإآٱء"، صحيح]])

# هيكل الرسم: كل حرف يُستبدل بممثل صنفه الخطي دون نقط، مع مراعاة الاتصال بما بعده
صدّر دالة هيكل_الرسم(كلمة) {
    متغير ح = _حروف(ن.أزل_التطويل(ن.أزل_التشكيل(كلمة)))
    متغير ع = طول(ح)
    متغير خرج = []
    من_أجل (ي من ٠ إلى ع - ١) {
        متغير ه = ح[ي]
        متغير متصل = خطأ
        إذا (ي < ع - ١) {
            إذا (ه في _قاطعة) { متصل = خطأ } وإلا { متصل = صحيح }
        }
        إذا (ه في _ثابتة) {
            أضف(خرج، _ثابتة[ه])
        } وإلا إذا (ه == "ن") {
            إذا (متصل) { أضف(خرج، "ٮ") } وإلا { أضف(خرج، "ں") }
        } وإلا إذا (ه == "ي" أو ه == "ئ") {
            إذا (متصل) { أضف(خرج، "ٮ") } وإلا { أضف(خرج، "ى") }
        } وإلا إذا (ه == "ق") {
            إذا (متصل) { أضف(خرج، "ڡ") } وإلا { أضف(خرج، "ٯ") }
        } وإلا {
            أضف(خرج، ه)
        }
    }
    ارجع اربط(خرج، "")
}

# مسافة التحرير (ليفنشتاين) بين نصين على مستوى الحرف
صدّر دالة مسافة_التحرير(أ، ب) {
    متغير س = _حروف(أ)
    متغير ص = _حروف(ب)
    متغير م = طول(س)
    متغير ك = طول(ص)
    متغير سابق = []
    من_أجل (ج من ٠ إلى ك) { أضف(سابق، ج) }
    من_أجل (ي من ١ إلى م) {
        متغير حالي = [ي]
        من_أجل (ج من ١ إلى ك) {
            متغير تكلفة = ١
            إذا (س[ي - ١] == ص[ج - ١]) { تكلفة = ٠ }
            متغير أقل = سابق[ج] + ١
            إذا (حالي[ج - ١] + ١ < أقل) { أقل = حالي[ج - ١] + ١ }
            إذا (سابق[ج - ١] + تكلفة < أقل) { أقل = سابق[ج - ١] + تكلفة }
            أضف(حالي، أقل)
        }
        سابق = حالي
    }
    ارجع سابق[ك]
}

# تشابه الرسم بين كلمتين في [٠، ١]: ١ − مسافة هيكليهما ÷ أطول هيكل
صدّر دالة تشابه_الرسم(أ، ب) {
    متغير ه١ = هيكل_الرسم(أ)
    متغير ه٢ = هيكل_الرسم(ب)
    متغير أطول = طول(ه١)
    إذا (طول(ه٢) > أطول) { أطول = طول(ه٢) }
    إذا (أطول == ٠) { ارجع ١ }
    ارجع ١ - مسافة_التحرير(ه١، ه٢) / أطول
}

# كلمتان مختلفتان كتابةً ومتحدتان في الهيكل الخطي: احتمال تصحيف نقطي مباشر
صدّر دالة تطابق_بلا_نقط(أ، ب) {
    متغير س = ن.أزل_التشكيل(قصّ(أ))
    متغير ص = ن.أزل_التشكيل(قصّ(ب))
    إذا (طول(س) == ٠ أو طول(ص) == ٠ أو س == ص) { ارجع خطأ }
    ارجع هيكل_الرسم(س) == هيكل_الرسم(ص)
}

# تطبيع للمقابلة: بلا تشكيل ولا تطويل، وتوحيد الألف والياء والتاء المربوطة والهمزة على واو أو ياء
صدّر دالة طبّع_للمقابلة(كلمة) {
    متغير ك = ن.وحّد_التاء_المربوطة(ن.وحّد_الياء(ن.وحّد_الألف(ن.أزل_التطويل(ن.أزل_التشكيل(كلمة)))))
    متغير خرج = []
    من_أجل (ح في ك) {
        إذا (ح == "ؤ") { أضف(خرج، "و") } وإلا إذا (ح == "ئ") { أضف(خرج، "ي") } وإلا { أضف(خرج، ح) }
    }
    ارجع اربط(خرج، "")
}
