# ضاد/نواة_توليف — توليف الشيفرة بالاسترجاع والتحقق: يبحث عن أقرب برنامج مُتحقَّق منه لوصف الطلب،
# يشغّله في المنفذ المعزول، ويقبله فقط إن أعاد ناتجه الموثَّق؛ وإن فشل أصلح الخطأ المطبعي في الأسماء ثم أعاد التحقق.
# هذا ليس توليدًا حرًّا: لا تخرج شيفرة لم يؤيّدها تشغيل. فإن لم يوجد برنامج موثوق أعاد «لم يوجد» بصراحة.
# أمثلة القاعدة: قائمة {معرف، عنوان، وصف، شيفرة، ناتج} حيث الناتج ما يطبعه البرنامج مربوطًا بسطر جديد.

متغير ر = استورد("ضاد/نواة_استرجاع")
متغير ش = استورد("ضاد/نواة_منفذ")
متغير خ = استورد("ضاد/نواة_أخطاء")
متغير ع = استورد("ضاد/نواة_عقد")

# يبني قاعدة التوليف من أمثلة متحقَّق منها
صدّر دالة ابنِ_قاعدة(أمثلة، حجم_المفردات = ٨٠٠) {
    إذا (نوع(أمثلة) != "قائمة") { أطلق_خطأ("التوليف: الأمثلة قائمة") }
    متغير وثائق = []
    متغير خريطة = {}
    متغير كلمات = {}
    من_أجل (م في أمثلة) {
        إذا (نوع(م) != "خريطة" أو ليس يحوي(م، "معرف") أو ليس يحوي(م، "عنوان") أو ليس يحوي(م، "وصف") أو ليس يحوي(م، "شيفرة") أو ليس يحوي(م، "ناتج")) {
            أطلق_خطأ("التوليف: كل مثال فيه معرف وعنوان ووصف وشيفرة وناتج")
        }
        أضف(وثائق، {"معرف": م["معرف"]، "عنوان": م["عنوان"]، "نص": م["وصف"]})
        خريطة[م["معرف"]] = م
        كلمات[م["معرف"]] = _كلمات_الموضوع(م["عنوان"] + " " + م["وصف"])
    }
    ارجع {"فهرس": ر.ابنِ(وثائق، حجم_المفردات)، "أمثلة": خريطة، "كلمات": كلمات، "ترتيب": مفاتيح(خريطة)}
}

# كلمات لا تدل على الموضوع في وصف الطلب (مطبَّعة)
متغير _عامة = ["اكتب"، "اريد"، "ابن"، "انشي"، "برنامج"، "كيف"، "ماذا"، "هذا"، "هذه"، "التي"، "الذي"، "مثال"، "شيفره"، "كود"، "بلغه"، "ضاد"، "لي"، "لو"]

دالة _كلمات_الموضوع(س) {
    متغير خرج = []
    من_أجل (ك٠ في افصل(ر.طبّع(س)، " ")) {
        متغير ك = ك٠
        إذا (طول(ك) > ٤ و ن_يبدأ(ك، "ال")) { ك = اقتطع(ك، ٢) }
        إذا (طول(ك) >= ٣ و ليس يحوي(_عامة، ك) و ليس يحوي(خرج، ك)) { أضف(خرج، ك) }
    }
    ارجع خرج
}

# نسبة كلمات الطلب الدالة على موضوعه التي تظهر في عنوان المثال ووصفه (تطابق تام أو بدء كلمة بأخرى)
دالة _تغطية(طلب، مثال_كلمات) {
    إذا (طول(طلب) == ٠) { ارجع ١ }
    متغير وجد = ٠
    من_أجل (ك في طلب) {
        متغير هنا = خطأ
        من_أجل (م في مثال_كلمات) {
            إذا (م == ك أو (طول(ك) >= ٤ و (ن_يبدأ(م، ك) أو ن_يبدأ(ك، م)))) { هنا = صحيح }
        }
        إذا (هنا) { وجد = وجد + ١ }
    }
    ارجع وجد / طول(طلب)
}

دالة ن_يبدأ(س، ب) { ارجع طول(س) >= طول(ب) و اقتطع(س، ٠، طول(ب)) == ب }

دالة _يطابق(مخرجات، ناتج) { ارجع اربط(مخرجات، حرف(١٠)) == ناتج }

# يستبدل كل ظهور لجزء بآخر في نص
دالة _استبدل(س، أ، ب) { ارجع اربط(افصل(س، أ)، ب) }

# يشغّل الشيفرة ويقارنها بالناتج؛ عند اسم غير معرّف مع أقرب اسم يجرّب الإصلاح مرة واحدة
دالة _تحقق(شيفرة، ناتج) {
    متغير ن = ش.شغّل_معزولًا(شيفرة)
    إذا (ن["ناجح"] و _يطابق(ن["مخرجات"]، ناتج)) { ارجع {"نجح": صحيح، "شيفرة": شيفرة، "أُصلح": خطأ، "سبب": ""} }
    إذا (ليس ن["ناجح"]) {
        متغير ح = خ.حلّل_الخطأ(ن["خطأ"]، شيفرة)
        إذا (ح["تصنيف"] == "اسم_غير_معرف" و ح["أقرب_اسم"] != "") {
            متغير مصلحة = _استبدل(شيفرة، ح["اسم"]، ح["أقرب_اسم"])
            متغير ن٢ = ش.شغّل_معزولًا(مصلحة)
            إذا (ن٢["ناجح"] و _يطابق(ن٢["مخرجات"]، ناتج)) { ارجع {"نجح": صحيح، "شيفرة": مصلحة، "أُصلح": صحيح، "سبب": "استُبدل «" + ح["اسم"] + "» بـ«" + ح["أقرب_اسم"] + "»"} }
        }
        ارجع {"نجح": خطأ، "شيفرة": شيفرة، "أُصلح": خطأ، "سبب": ح["تصنيف"] + ": " + ن["خطأ"]}
    }
    ارجع {"نجح": خطأ، "شيفرة": شيفرة، "أُصلح": خطأ، "سبب": "المخرجات لا تطابق الناتج الموثَّق"}
}

# يولّف شيفرة لوصف: {وُجد، شيفرة، مصدر، درجة، أُصلحت، محاولات: [{مصدر، نجح، سبب}]}
صدّر دالة ولّد(قاعدة، وصف، حد_المحاولات = ٣، أدنى_تغطية = ٠٫٦) {
    إذا (نوع(قاعدة) != "خريطة" أو ليس يحوي(قاعدة، "فهرس")) { أطلق_خطأ("التوليف: القاعدة تُبنى بالدالة ابنِ_قاعدة()") }
    إذا (نوع(وصف) != "نص" أو طول(وصف) == ٠) { أطلق_خطأ("التوليف: الوصف نص غير فارغ") }
    إذا (نوع(حد_المحاولات) != "رقم" أو حد_المحاولات < ١) { أطلق_خطأ("التوليف: حدّ المحاولات رقم موجب") }
    # الترتيب: التغطية أولًا (كلمات الطلب في العنوان والوصف)، ثم درجة الاسترجاع عند التعادل
    متغير درجات = {}
    من_أجل (م في ر.ابحث(قاعدة["فهرس"]، وصف، ٣٠)) { درجات[م["معرف"]] = م["درجة"] }
    متغير طلب = _كلمات_الموضوع(وصف)
    متغير مؤهلون = []
    من_أجل (مف في قاعدة["ترتيب"]) {
        متغير غ = _تغطية(طلب، قاعدة["كلمات"][مف])
        إذا (غ >= أدنى_تغطية) {
            متغير د = ٠
            إذا (يحوي(درجات، مف)) { د = درجات[مف] }
            أضف(مؤهلون، [غ، د، مف])
        }
    }
    مؤهلون = رتب(مؤهلون، دالة(أ، ب) {
        إذا (أ[٠] != ب[٠]) { ارجع ب[٠] - أ[٠] }
        إذا (أ[١] != ب[١]) { ارجع ب[١] - أ[١] }
        ارجع ٠
    })
    متغير مرشحون = []
    من_أجل (ي في مدى(طول(مؤهلون))) {
        إذا (ي < حد_المحاولات) { أضف(مرشحون، {"معرف": مؤهلون[ي][٢]، "درجة": مؤهلون[ي][١]}) }
    }
    متغير محاولات = []
    من_أجل (م في مرشحون) {
        متغير مثال = قاعدة["أمثلة"][م["معرف"]]
        متغير ت = _تحقق(مثال["شيفرة"]، مثال["ناتج"])
        أضف(محاولات، {"مصدر": م["معرف"]، "نجح": ت["نجح"]، "سبب": ت["سبب"]})
        إذا (ت["نجح"]) {
            ارجع {"وُجد": صحيح، "شيفرة": ت["شيفرة"]، "مصدر": م["معرف"]، "درجة": م["درجة"]، "أُصلحت": ت["أُصلح"]، "محاولات": محاولات}
        }
    }
    ارجع {"وُجد": خطأ، "شيفرة": ""، "مصدر": ""، "درجة": ٠، "أُصلحت": خطأ، "محاولات": محاولات}
}

صدّر دالة سجّل_المحرك() {
    ارجع ع.سجّل(ع.محرك(
        "توليف_شيفرة"،
        "يجد برنامج ضاد مُتحقَّقًا منه يناسب الوصف ويشغّله للتحقق قبل تسليمه"،
        {"قاعدة": "خريطة"، "وصف": "نص"}،
        {"وُجد": "قيمة منطقية"، "شيفرة": "نص"، "مصدر": "نص"، "محاولات": "قائمة"}،
        دالة(مدخل) { ارجع ولّد(مدخل["قاعدة"]، مدخل["وصف"]) }
    ))
}
