# ضاد/نواة_حوار — محرك الحوار: يميّز التحية والسلام والتعريف بالنفس وسؤال القدرات والشكر والوداع، ويردّ عليها.
# لا يستولي على الطلبات الحقيقية: لا يردّ وحده إلا إذا لم يبقَ في الطلب كلام زائد على العبارة الاجتماعية،
# فإن بقي كلام (مثل «السلام عليكم، اكتب لي برنامجًا…») أعاد البادئة ليُضاف إلى ردّ المهمة.
# الأنواع بترتيبها: سلام، تحية، حال، هوية، قدرات، شكر، وداع.

متغير ن = استورد("ضاد/نصوص")

# عبارات كل نوع بالصورة المطبَّعة (ألف واحدة، ياء، هاء بدل التاء المربوطة، بلا تشكيل)
# الأطول أولًا حتى تُزال العبارة الكاملة قبل أجزائها
متغير _عبارات = [
    ["سلام"، ["السلام عليكم ورحمه الله وبركاته"، "السلام عليكم ورحمه الله"، "السلام عليكم"، "سلام عليكم"]]،
    ["تحية"، ["صباح الخير"، "مساء الخير"، "صباح النور"، "مساء النور"، "مرحبا بك"، "مرحبا"، "اهلا بك"، "اهلا وسهلا"، "اهلا"، "هلا"، "هاي"، "hello"، "hi"]]،
    ["حال"، ["كيف حالك"، "كيف الحال"، "كيف حالكم"، "كيف اصبحت"، "اخبارك"، "ازيك"، "عامل ايه"]]،
    ["هوية"، ["هل انت نموذج ذكاء اصطناعي"، "هل انت نموذج لغوي"، "هل انت ذكاء اصطناعي"، "هل انت نموذج"، "هل انت بشر"، "هل انت انسان"، "هل انت روبوت"، "هل انت chatgpt"، "من انت"، "ما انت"، "من تكون"، "ما اسمك"، "من صنعك"، "من بناك"، "من برمجك"، "من طورك"، "عرف بنفسك"، "عرفني بنفسك"]]،
    ["قدرات"، ["ماذا تستطيع ان تفعل"، "ماذا تستطيع"، "ماذا تفعل"، "ماذا تجيد"، "ماذا يمكنك"، "ما قدراتك"، "ما الذي تفعله"، "ما الذي تستطيع"، "بماذا تساعد"، "كيف استخدمك"، "كيف استعملك"، "كيف اتعامل معك"، "مساعده"، "help"]]،
    ["شكر"، ["شكرا جزيلا"، "جزاك الله خيرا"، "جزاك الله"، "بارك الله فيك"، "بارك الله"، "شكرا"، "مشكور"، "تسلم"]]،
    ["وداع"، ["مع السلامه"، "الي اللقاء"، "وداعا"، "تصبح علي خير"]]
]

# كلمات لا تُحسب كلامًا زائدًا (نداء ومجاملة وبقية صيغة السلام)
متغير _مهملة = ["يا"، "نواه"، "لو"، "سمحت"، "ارجوك"، "فضلك"، "اخي"، "صديقي"، "الله"، "ورحمه"، "وبركاته"، "بركاته"، "ورحمه"، "جدا"، "كثيرا"، "خيرا"، "و"، "ثم"]

دالة _مطبّع(س) { ارجع ن.وحّد_التاء_المربوطة(ن.طبّع_للبحث(س)) }

# يعيد الكلمات المطبَّعة مفصولة بمسافة واحدة (حروف عربية ولاتينية وأرقام فقط)
دالة _نص_الكلمات(س) {
    متغير خرج = []
    متغير حالي = ""
    من_أجل (ح في _مطبّع(س)) {
        إذا (ن.هل_حرف_عربي(ح) أو ن.هل_حرف_لاتيني(ح) أو ن.هل_رقم(ح)) {
            حالي = حالي + ح
        } وإلا {
            إذا (حالي != "") { أضف(خرج، حالي) }
            حالي = ""
        }
    }
    إذا (حالي != "") { أضف(خرج، حالي) }
    ارجع " " + اربط(خرج، " ") + " "
}

# يكتشف الأنواع الاجتماعية في الطلب ويعيد {أنواع، متبقية}: عدد الكلمات المتبقية بعد إزالة العبارات المطابقة
صدّر دالة اكتشف(طلب) {
    متغير س = _نص_الكلمات(طلب)
    متغير أنواع = []
    من_أجل ([نوع_، عبارات] في _عبارات) {
        متغير وُجد = خطأ
        من_أجل (ع في عبارات) {
            متغير ب = " " + ع + " "
            إذا (يحوي(س، ب)) {
                س = اربط(افصل(س، ب)، " ")
                وُجد = صحيح
            }
        }
        إذا (وُجد) { أضف(أنواع، نوع_) }
    }
    متغير متبقية = ٠
    من_أجل (ك في افصل(س، " ")) {
        إذا (ك != "" و ليس يحوي(_مهملة، ك)) { متبقية = متبقية + ١ }
    }
    ارجع {"أنواع": أنواع، "متبقية": متبقية}
}

دالة _عرض_الملفات(سياق) {
    متغير أسطر = []
    متغير م = سياق["مرفقات"]
    إذا (طول(م) > ٠) { أضف(أسطر، "أمامي الآن " + نص(طول(م)) + " ملف مرفق: " + اربط(م، "، ") + ".") }
    إذا (سياق["مكتبة"] > ٠) { أضف(أسطر، "وفي المكتبة المربوطة " + نص(سياق["مكتبة"]) + " ملف أبحث فيها.") }
    ارجع أسطر
}

دالة _جزء(نوع_، سياق) {
    إذا (نوع_ == "سلام") { ارجع "وعليكم السلام ورحمة الله وبركاته." }
    إذا (نوع_ == "تحية") { ارجع "أهلًا بك." }
    إذا (نوع_ == "حال") { ارجع "في أتم الجاهزية." }
    إذا (نوع_ == "هوية") {
        ارجع "أنا نواة، ذكاء اصطناعي أجزاؤه كلها مكتوبة بلغة ضاد. لا أقوم على نموذج لغوي واحد ضخم، بل على محركات متخصصة تُركَّب بحسب المهمة: بحث، وتشغيل معزول، وتشخيص أخطاء، وتوليف برامج يُتحقَّق منها بالتشغيل."
    }
    إذا (نوع_ == "قدرات") {
        متغير أسطر = ["يمكنني:"،
            "- كتابة برنامج بضاد من وصفه، بعد التحقق من أنه يعمل فعلًا بتشغيله."،
            "- تشغيل شيفرتك في بيئة معزولة وتشخيص أخطائها واقتراح إصلاحها."،
            "- شرح مفاهيم اللغة من دروسها وشروحاتها ومعجمها."،
            "- تحليل ملف ترفقه: بنيته وأبرز مصطلحاته وأهم ما فيه، والبحث داخله."،
            "- البحث في المكتبة التي تربطها بعد فهرستها تلقائيًا."]
        من_أجل (س في _عرض_الملفات(سياق)) { أضف(أسطر، س) }
        ارجع اربط(أسطر، حرف(١٠))
    }
    إذا (نوع_ == "شكر") { ارجع "عفوًا." }
    إذا (نوع_ == "وداع") { ارجع "في أمان الله." }
    ارجع ""
}

# بادئة الردّ للتحية والسلام فقط (تُضاف إلى ردّ المهمة حين يحمل الطلب مهمة)
صدّر دالة بادئة(أنواع) {
    إذا (يحوي(أنواع، "سلام")) { ارجع _جزء("سلام"، {}) }
    إذا (يحوي(أنواع، "تحية")) { ارجع _جزء("تحية"، {}) }
    ارجع ""
}

# يصوغ ردّ الحوار كاملًا. السياق: {مرفقات: أسماء، مكتبة: عدد}
صدّر دالة ردّ(أنواع، سياق) {
    متغير أجزاء = []
    من_أجل (ك في أنواع) { أضف(أجزاء، _جزء(ك، سياق)) }
    # تحية أو سلام وحدهما: دعوة قصيرة إلى الطلب
    إذا (طول(أنواع) == ١ و (أنواع[٠] == "سلام" أو أنواع[٠] == "تحية" أو أنواع[٠] == "حال")) {
        أضف(أجزاء، "اكتب ما تريد بناءه أو فهمه، أو أرفق ملفًا لأحلله.")
        من_أجل (س في _عرض_الملفات(سياق)) { أضف(أجزاء، س) }
    }
    ارجع اربط(أجزاء، حرف(١٠) + حرف(١٠))
}

# ===== المتابعة: طلبات قصيرة تشير إلى ما قبلها (شغّله، اشرحه، المزيد) =====
متغير _متابعات = [
    ["شغّل"، ["شغله"، "شغلها"، "جربه"، "جربها"، "نفذه"، "نفذها"، "شغل الكود"، "شغل البرنامج"، "شغل الشيفره"، "جرب الكود"، "جرب البرنامج"، "نفذ الكود"، "نفذ البرنامج"]]،
    ["اشرح"، ["اشرحه"، "اشرحها"، "اشرح الكود"، "اشرح البرنامج"، "اشرح الشيفره"، "اشرح لي الكود"، "اشرح لي البرنامج"، "وضح الكود"، "فسر الكود"، "كيف يعمل"، "كيف تعمل"]]،
    ["مزيد"، ["المزيد"، "مزيد"، "وضح اكثر"، "اعطني المزيد"، "هات المزيد"، "هات غيره"، "غيره"، "اكثر"، "كمل"]]
]

# يعيد "شغّل" أو "اشرح" أو "مزيد" إن كان الطلب متابعة قصيرة، وإلا ""
# (كلمة «شغّل» أو «جرّب» وحدها تُعدّ متابعة أيضًا)
صدّر دالة متابعة(طلب) {
    متغير س = _نص_الكلمات(طلب)
    متغير عدد = ٠
    من_أجل (ك في افصل(س، " ")) { إذا (ك != "") { عدد = عدد + ١ } }
    إذا (عدد > ٤) { ارجع "" }
    من_أجل ([نوع_، عبارات] في _متابعات) {
        من_أجل (ع في عبارات) { إذا (يحوي(س، " " + ع + " ")) { ارجع نوع_ } }
    }
    إذا (عدد == ١ و (يحوي(س، " شغل ") أو يحوي(س، " جرب ") أو يحوي(س، " نفذ "))) { ارجع "شغّل" }
    ارجع ""
}

# يحذف العبارة الاجتماعية من مطلع الطلب (سلام، تحية…) ويعيد بقيته كما كُتبت، ليُعالَج الطلب الحقيقي دون تلويث بحثه
صدّر دالة بلا_المطلع(طلب) {
    متغير كلمات = []
    من_أجل (ك في افصل(طلب، " ")) { إذا (ك != "") { أضف(كلمات، ك) } }
    متغير أفضل = ٠
    من_أجل (ي في مدى(١، (اختر_أصغر(٧، طول(كلمات)) + ١))) {
        متغير مقدمة = ""
        من_أجل (ج في مدى(ي)) { مقدمة = مقدمة + كلمات[ج] + " " }
        متغير ن_ = اكتشف(مقدمة)
        إذا (طول(ن_["أنواع"]) > ٠ و ن_["متبقية"] == ٠) { أفضل = ي }
    }
    إذا (أفضل == ٠ أو أفضل >= طول(كلمات)) { ارجع طلب }
    متغير بقية = []
    من_أجل (ي في مدى(أفضل، طول(كلمات))) { أضف(بقية، كلمات[ي]) }
    ارجع اربط(بقية، " ")
}

دالة اختر_أصغر(أ، ب) {
    إذا (أ < ب) { ارجع أ }
    ارجع ب
}
