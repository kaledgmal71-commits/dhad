# محرّر صفحات الكتاب — بضاد وحدها. يعرض نص كتاب صفحةً صفحة، ويقسّم الصفحات ويدمجها ويصدّرها،
# ويعرض شجرة عناوين التراجم ويحلّلها آليًا (وحدة تحليل)، ويضم مساعدًا اختياريًا يعمل متى وفّرته البيئة.

متغير ت = استورد("ضاد/تعابير")
متغير ج = استورد("ضاد/جسون")
متغير تحليل = استورد("تحليل")

متغير نمط_العناوين_الافتراضي = "^\\s*\\d+\\s*[-–]\\s*(.{3,90})$"
متغير أسلوب = ":root{--bg:#fbfaf6;--fg:#1c1b19;--bar:#efece3;--bd:#d8d3c5;--ac:#7a4b12;--on:#e9dcc3;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)} @media (prefers-color-scheme:dark){:root:not([data-theme='light']){--bg:#1b1a17;--fg:#ece8dc;--bar:#26241f;--bd:#3d392f;--ac:#e0b36a;--on:#3a3326;color-scheme:dark}} :root[data-theme='dark']{--bg:#1b1a17;--fg:#ece8dc;--bar:#26241f;--bd:#3d392f;--ac:#e0b36a;--on:#3a3326;color-scheme:dark} *{box-sizing:border-box} html,body{height:100%;margin:0} body{background:var(--bg);color:var(--fg);font-family:'Traditional Arabic','Amiri','Noto Naskh Arabic',serif;display:flex;flex-direction:column} #bar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:8px;background:var(--bar);border-bottom:1px solid var(--bd);font-family:system-ui,sans-serif;font-size:14px} button,input,select{font:inherit;color:var(--fg);background:var(--bg);border:1px solid var(--bd);border-radius:6px;padding:5px 9px} button{cursor:pointer}button:hover{border-color:var(--ac)} #pn{width:60px;text-align:center} .sp{flex:1} #main{flex:1;display:flex;min-height:0} #side{width:100px;min-width:0;overflow:auto;border-left:1px solid var(--bd);background:var(--bar);font-family:system-ui,sans-serif;font-size:12px} #side h4{margin:0;padding:6px;position:sticky;top:0;background:var(--bar);border-bottom:1px solid var(--bd);font-size:12px} .it{display:block;padding:5px 6px;color:var(--fg);text-decoration:none;border-bottom:1px solid var(--bd);line-height:1.35} .it.on{background:var(--on)}.it small{display:block;color:var(--ac)} #rz{width:6px;cursor:col-resize;background:var(--bd);touch-action:none} #ta{flex:1;width:100%;border:0;border-radius:0;resize:none;padding:18px;font-size:22px;line-height:2;font-family:inherit;direction:rtl;outline:none} #dlg,#exp,#adlg{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:12px;z-index:5} #dlg[hidden],#exp[hidden],#adlg[hidden]{display:none} .box{background:var(--bg);border:1px solid var(--bd);border-radius:10px;padding:16px;width:min(560px,100%);max-height:100%;overflow:auto;font-family:system-ui,sans-serif;font-size:14px;display:flex;flex-direction:column;gap:10px} .box textarea{height:130px;direction:rtl;background:var(--bg);color:var(--fg);border:1px solid var(--bd);border-radius:6px;padding:8px} #msg{font-size:12px;color:var(--ac)} #ft{display:flex;border-top:1px solid var(--bd);background:var(--bar);font-family:system-ui,sans-serif;font-size:13px} #fl{display:flex;flex-direction:column;gap:4px;padding:6px;width:106px;flex:none} #fl button{padding:4px 2px;font-size:12px} #as{flex:1;display:flex;flex-direction:column;gap:4px;padding:6px;min-width:0} #as[hidden]{display:none} #ans{max-height:150px;overflow:auto;white-space:pre-wrap;background:var(--bg);border:1px solid var(--bd);border-radius:6px;padding:6px;direction:rtl} #ans:empty{display:none} #aq{display:flex;gap:6px}#aq input{flex:1;min-width:0} #fs{width:100%;border-radius:0;display:none;font-size:12px} #adlg label{display:block}"

# ---------- الحالة ----------
متغير صفحات = [""]
متغير حالي = ٠
متغير تاريخ = []
متغير متسخ = خطأ
متغير نمط_ع = ت.ابنِ(نمط_العناوين_الافتراضي)
متغير مؤقت_رسالة = لاشيء
متغير مؤقت_شجرة = لاشيء
متغير واجهة = {}
متغير عرض_الجانب = ١٠٠

# ---------- أدوات الواجهة ----------
دالة عنصر(وسم، سمات، نص_) {
    متغير e = عنصر_جديد(وسم)
    إذا (سمات != لاشيء) {
        من_أجل (ز في أزواج(سمات)) { عيّن_سمة(e، ز[٠]، ز[١]) }
    }
    إذا (نص_ != لاشيء) { عيّن_نص(e، نص_) }
    ارجع e
}

دالة ضمّ(أب، أبناء) {
    من_أجل (ك في أبناء) { أضف_ابن(أب، ك) }
    ارجع أب
}

دالة مُعرَّف(اسم) { ارجع واجهة[اسم] }

# يسجّل العنصر باسمه ويعيده
دالة سجّل(اسم، e) {
    عيّن_سمة(e، "id"، اسم)
    واجهة[اسم] = e
    ارجع e
}

دالة زر(اسم، نص_، تلميح) {
    متغير e = سجّل(اسم، عنصر("button"، لاشيء، نص_))
    إذا (تلميح != لاشيء) { عيّن_سمة(e، "title"، تلميح) }
    ارجع e
}

دالة قيمة(اسم) { ارجع اقرأ_خاصية(مُعرَّف(اسم)، "value") }
دالة مفعّل(اسم) { ارجع اقرأ_خاصية(مُعرَّف(اسم)، "checked") }

# عدد من نص الحقل أو ٠ كما يفعل +value||0
دالة رقم_حقل(اسم) {
    متغير س = قصّ(قيمة(اسم))
    إذا (س == "") { ارجع ٠ }
    حاول {
        ارجع عدد(س)
    } التقط (خ) {
        ارجع ٠
    }
}

دالة الإزاحة() { ارجع رقم_حقل("off") }

دالة قُل(نص_) {
    عيّن_نص(مُعرَّف("msg")، نص_)
    إذا (مؤقت_رسالة != لاشيء) { ألغِ_المدة(مؤقت_رسالة) }
    مؤقت_رسالة = بعد_مدة(٤٠٠٠، دالة() { عيّن_نص(مُعرَّف("msg")، "") })
}

دالة أخفِ(اسم، مخفي) { عيّن_خاصية(مُعرَّف(اسم)، "hidden"، مخفي) }

# ---------- التاريخ والتراجع ----------
دالة نسخة(ق) {
    متغير ن = []
    من_أجل (x في ق) { أضف(ن، x) }
    ارجع ن
}

دالة لقطة() {
    أضف(تاريخ، {"صفحات": نسخة(صفحات)، "حالي": حالي})
    إذا (طول(تاريخ) > ٨٠) { احذف(تاريخ، ٠) }
    متسخ = خطأ
}

# ---------- تحميل النص ----------
دالة قصّ_ج(س) {
    ارجع قصّ(س)
}

دالة تنظيف_صفحة(س) {
    ارجع ت.استبدل_الكل(ت.ابنِ("^\\n+|\\s+$")، س، "")
}

دالة حمّل_نص(نص_خام) {
    متغير وضع = قيمة("mode")
    متغير ع = رقم_حقل("nl")
    إذا (ع == ٠) { ع = ٤٠ }
    متغير ن = ت.استبدل_الكل(ت.ابنِ("\\r")، نص_خام، "")
    متغير علامة = ت.ابنِ("^=== صفحة \\d+ ===\\n?"، "m")
    متغير ف = حرف(١٢)
    متغير ص = []
    إذا (وضع == "mark" أو (وضع == "auto" و ت.يوجد(علامة، ن))) {
        ص = ت.افصل(علامة، ن)
        إذا (قصّ(ص[٠]) == "") { احذف(ص، ٠) }
    } وإلا إذا (وضع == "ff" أو (وضع == "auto" و يحوي(ن، ف))) {
        ص = افصل(ن، ف)
    } وإلا {
        متغير سطور = افصل(ن، حرف(١٠))
        متغير ي = ٠
        طالما (ي < طول(سطور)) {
            متغير قطعة = []
            متغير ك = ي
            طالما (ك < ي + ع و ك < طول(سطور)) {
                أضف(قطعة، سطور[ك])
                ك = ك + ١
            }
            أضف(ص، اربط(قطعة، حرف(١٠)))
            ي = ي + ع
        }
    }
    صفحات = []
    من_أجل (x في ص) { أضف(صفحات، تنظيف_صفحة(x)) }
    إذا (طول(صفحات) == ٠) { صفحات = [""] }
    حاول {
        نمط_ع = ت.ابنِ(قيمة("rx"))
    } التقط (خ) {
        قُل("نمط العناوين غير صالح")
    }
    تاريخ = []
    حالي = ٠
    أخفِ("dlg"، صحيح)
    ارسم()
}

# ---------- العرض ----------
دالة ارسم() {
    عيّن_خاصية(مُعرَّف("ta")، "value"، صفحات[حالي])
    عيّن_خاصية(مُعرَّف("pn")، "value"، نص_برمجي(حالي + الإزاحة()))
    عيّن_نص(مُعرَّف("tot")، "من " + نص_برمجي(طول(صفحات) + الإزاحة() - ١))
    متسخ = خطأ
    ارسم_الشجرة()
}

دالة عنوان_المطابقة(م، سطر) {
    متغير مج = م["مجموعات"]
    إذا (طول(مج) > ٠ و مج[٠] != لاشيء و مج[٠] != "") { ارجع مج[٠] }
    ارجع سطر
}

# دالة مستقلة لتثبيت قيمتَي الصفحة والسطر لكل صف (المتغيرات داخل الحلقة تُشارَك بين الدورات في ضاد حاليًا)
# صدق جافاسكربت: لاشيء وخطأ و٠ والنص الفارغ كاذبة، وما عداها صادق (ليطابق التطبيق الأصلي مع ما يرسله النموذج)
دالة _صادق(ق) { ارجع ق != لاشيء و ق != خطأ و ق != ٠ و ق != "" }

دالة اربط_صف(صف، صفحة_ص، سطر_ص) {
    عند(صف، "click"، دالة(ح) {
        امنع_الافتراضي(ح)
        اذهب(صفحة_ص، سطر_ص)
    })
}

دالة ارسم_الشجرة() {
    متغير شجرة = مُعرَّف("tree")
    متغير فلتر = قصّ(قيمة("fs"))
    امسح_عنصر(شجرة)
    متغير عدد_ = ٠
    متغير pi = ٠
    طالما (pi < طول(صفحات)) {
        متغير سطور = افصل(صفحات[pi]، حرف(١٠))
        متغير li = ٠
        طالما (li < طول(سطور)) {
            متغير سطر = سطور[li]
            متغير م = ت.ابحث(نمط_ع، سطر)
            إذا (م != لاشيء) {
                متغير عنوان_ = عنوان_المطابقة(م، سطر)
                إذا (فلتر == "" أو يحوي(عنوان_، فلتر)) {
                    عدد_ = عدد_ + ١
                    متغير صف = عنصر("a"، {"href": "#"، "class": "it"}، لاشيء)
                    إذا (pi == حالي) { عيّن_سمة(صف، "class"، "it on") }
                    متغير س١ = عنصر("span"، لاشيء، قصّ(عنوان_))
                    متغير س٢ = عنصر("small"، لاشيء، "ص " + نص_برمجي(pi + الإزاحة()))
                    ضمّ(صف، [س١، س٢])
                    اربط_صف(صف، pi، li)
                    أضف_ابن(شجرة، صف)
                }
            }
            li = li + ١
        }
        pi = pi + ١
    }
    عيّن_نص(مُعرَّف("cnt")، "(" + نص_برمجي(عدد_) + ")")
}

دالة ارتفاع_السطر() {
    حاول {
        متغير ق = نمط_محسوب(مُعرَّف("ta")، "line-height")
        متغير ر = عدد(استبدل(ق، "px"، ""))
        إذا (ر > ٠) { ارجع ر }
    } التقط (خ) {
        ارجع ٤٠
    }
    ارجع ٤٠
}

دالة اذهب(i، سطر_ما) {
    إذا (i < ٠ أو i >= طول(صفحات)) { ارجع لاشيء }
    حالي = i
    ارسم()
    إذا (سطر_ما != لاشيء) {
        متغير مقدّمة = اقتطع(اربط(نسخة_أسطر(صفحات[i]، سطر_ما)، حرف(١٠))، ٠)
        متغير موضع = طول(مقدّمة)
        إذا (سطر_ما > ٠) { موضع = موضع + ١ }
        متغير ta = مُعرَّف("ta")
        ركّز(ta)
        حدّد_نص(ta، موضع، موضع)
        عيّن_خاصية(ta، "scrollTop"، سطر_ما * ارتفاع_السطر())
    }
}

دالة نسخة_أسطر(نص_، عدد_) {
    متغير س = افصل(نص_، حرف(١٠))
    متغير ن = []
    متغير ي = ٠
    طالما (ي < عدد_ و ي < طول(س)) {
        أضف(ن، س[ي])
        ي = ي + ١
    }
    ارجع ن
}

# ---------- التحرير ----------
دالة قصّ_نهاية(س) { ارجع تحليل.قص_النهاية(س) }

دالة قصّ_بداية(س) {
    متغير ك = ٠
    طالما (ك < طول(س) و قصّ(اقتطع(س، ك، ك + ١)) == "") { ك = ك + ١ }
    ارجع اقتطع(س، ك)
}

دالة قسّم_عند_المؤشر() {
    متغير ta = مُعرَّف("ta")
    متغير م = اقرأ_خاصية(ta، "selectionStart")
    متغير ق = اقرأ_خاصية(ta، "value")
    لقطة()
    متغير قبل = قصّ_نهاية(اقتطع(ق، ٠، م))
    متغير بعد = قصّ_بداية(اقتطع(ق، م))
    متغير جديد = []
    متغير ي = ٠
    طالما (ي < طول(صفحات)) {
        إذا (ي == حالي) {
            أضف(جديد، قبل)
            أضف(جديد، بعد)
        } وإلا {
            أضف(جديد، صفحات[ي])
        }
        ي = ي + ١
    }
    صفحات = جديد
    ارسم()
    قُل("قُسمت الصفحة وأُعيد ترقيم ما بعدها")
}

دالة ادمج_مع_التالية() {
    إذا (حالي >= طول(صفحات) - ١) { ارجع لاشيء }
    لقطة()
    متغير جديد = []
    متغير ي = ٠
    طالما (ي < طول(صفحات)) {
        إذا (ي == حالي) {
            أضف(جديد، صفحات[ي] + حرف(١٠) + صفحات[ي + ١])
            ي = ي + ١
        } وإلا {
            أضف(جديد، صفحات[ي])
        }
        ي = ي + ١
    }
    صفحات = جديد
    ارسم()
    قُل("دُمجت مع التالية وأُعيد الترقيم")
}

دالة ادمج_مع_السابقة() {
    إذا (حالي < ١) { ارجع لاشيء }
    لقطة()
    متغير جديد = []
    متغير ي = ٠
    طالما (ي < طول(صفحات)) {
        إذا (ي == حالي - ١) {
            أضف(جديد، صفحات[ي] + حرف(١٠) + صفحات[ي + ١])
            ي = ي + ١
        } وإلا {
            أضف(جديد، صفحات[ي])
        }
        ي = ي + ١
    }
    صفحات = جديد
    حالي = حالي - ١
    ارسم()
    قُل("دُمجت مع السابقة وأُعيد الترقيم")
}

دالة أضف_صفحة() {
    لقطة()
    متغير جديد = []
    متغير ي = ٠
    طالما (ي < طول(صفحات)) {
        أضف(جديد، صفحات[ي])
        إذا (ي == حالي) { أضف(جديد، "") }
        ي = ي + ١
    }
    صفحات = جديد
    حالي = حالي + ١
    ارسم()
}

دالة احذف_الصفحة() {
    إذا (طول(صفحات) < ٢ أو ليس تأكيد("حذف هذه الصفحة؟")) { ارجع لاشيء }
    لقطة()
    متغير جديد = []
    متغير ي = ٠
    طالما (ي < طول(صفحات)) {
        إذا (ي != حالي) { أضف(جديد، صفحات[ي]) }
        ي = ي + ١
    }
    صفحات = جديد
    إذا (حالي > طول(صفحات) - ١) { حالي = طول(صفحات) - ١ }
    ارسم()
}

دالة تراجع() {
    إذا (طول(تاريخ) == ٠) {
        قُل("لا شيء للتراجع")
        ارجع لاشيء
    }
    متغير ل = انزع(تاريخ)
    صفحات = نسخة(ل["صفحات"])
    حالي = ل["حالي"]
    إذا (حالي > طول(صفحات) - ١) { حالي = طول(صفحات) - ١ }
    ارسم()
}

دالة نص_التصدير() {
    متغير قطع = []
    متغير ي = ٠
    طالما (ي < طول(صفحات)) {
        أضف(قطع، "=== صفحة " + نص_برمجي(ي + الإزاحة()) + " ===" + حرف(١٠) + صفحات[ي])
        ي = ي + ١
    }
    ارجع اربط(قطع، حرف(١٠))
}

# ---------- التحليل الآلي ----------
دالة نفّذ_التحليل(خيارات) {
    متغير ن = تحليل.حلّل(صفحات، خيارات)
    إذا (ن == لاشيء) {
        قُل("لم أجد عناوين تراجم، جرّب تعديل النمط أو النص")
        ارجع لاشيء
    }
    لقطة()
    صفحات = ن["صفحات"]
    حالي = ٠
    عيّن_خاصية(مُعرَّف("rx")، "value"، نمط_العناوين_الافتراضي)
    نمط_ع = ت.ابنِ(نمط_العناوين_الافتراضي)
    ارسم()
    قُل("حُلّل: " + نص_برمجي(ن["عدد"]) + " ترجمة في " + نص_برمجي(طول(ن["صفحات"])) + " صفحة (يمكنك التراجع)")
    ارجع ن["عدد"]
}

# ---------- المساعد ----------
دالة العناوين() {
    متغير خ = []
    متغير pi = ٠
    طالما (pi < طول(صفحات)) {
        من_أجل (سطر في افصل(صفحات[pi]، حرف(١٠))) {
            متغير م = ت.ابحث(نمط_ع، سطر)
            إذا (م != لاشيء) { أضف(خ، {"page": pi + الإزاحة()، "title": قصّ(عنوان_المطابقة(م، سطر))}) }
        }
        pi = pi + ١
    }
    ارجع خ
}

دالة مخطط(خصائص، مطلوب) {
    ارجع {"type": "object"، "properties": خصائص، "required": مطلوب}
}

دالة أداة(اسم، وصف، مخطط_، تنفيذ) {
    ارجع {"اسم": اسم، "وصف": وصف، "مخطط": مخطط_، "نفّذ": تنفيذ}
}

دالة المحدد_الحالي() {
    متغير ta = مُعرَّف("ta")
    متغير ق = اقرأ_خاصية(ta، "value")
    ارجع اقتطع(اقتطع(ق، اقرأ_خاصية(ta، "selectionStart")، اقرأ_خاصية(ta، "selectionEnd"))، ٠، ٣٠٠)
}

دالة الأدوات() {
    متغير رقم_ = {"type": "number"}
    متغير نص_ن = {"type": "string"}
    ارجع [
        أداة("state"، "حالة الأداة الآن"، مخطط({}، [])، دالة(أ) {
            ارجع ج.اكتب({"current": حالي + الإزاحة()، "total": طول(صفحات)، "firstPageNumber": الإزاحة()، "headings": طول(العناوين())، "selected": المحدد_الحالي()})
        })،
        أداة("get_page"، "يقرأ نص صفحة برقمها المعروض"، مخطط({"page": رقم_}، ["page"])، دالة(أ) {
            إذا (أ["page"] - الإزاحة() < ٠ أو أ["page"] - الإزاحة() >= طول(صفحات)) { ارجع "" }
            ارجع اقتطع(صفحات[أ["page"] - الإزاحة()]، ٠، ٦٠٠٠)
        })،
        أداة("headings"، "عناوين التراجم وأرقام صفحاتها"، مخطط({}، [])، دالة(أ) {
            متغير ع = العناوين()
            متغير خ = []
            متغير ي = ٠
            طالما (ي < طول(ع) و ي < ٤٠٠) {
                أضف(خ، ع[ي])
                ي = ي + ١
            }
            ارجع ج.اكتب(خ)
        })،
        أداة("go"، "ينتقل إلى صفحة"، مخطط({"page": رقم_}، ["page"])، دالة(أ) {
            اذهب(أ["page"] - الإزاحة()، لاشيء)
            ارجع "تم"
        })،
        أداة("search"، "يبحث في كل الصفحات ويعيد أرقامها"، مخطط({"query": نص_ن}، ["query"])، دالة(أ) {
            متغير خ = []
            متغير ي = ٠
            طالما (ي < طول(صفحات) و طول(خ) < ٦٠) {
                إذا (يحوي(صفحات[ي]، أ["query"])) { أضف(خ، ي + الإزاحة()) }
                ي = ي + ١
            }
            ارجع ج.اكتب(خ)
        })،
        أداة("replace"، "يستبدل نصًا في الصفحة الحالية، أو في كل الصفحات إذا كانت all صحيحة"، مخطط({"find": نص_ن، "replace": نص_ن، "all": {"type": "boolean"}}، ["find"، "replace"])، دالة(أ) {
            لقطة()
            متغير ن = ٠
            متغير ي = ٠
            متغير الكل = يحوي(أ، "all") و _صادق(أ["all"])
            طالما (ي < طول(صفحات)) {
                إذا (الكل أو ي == حالي) {
                    إذا (يحوي(صفحات[ي]، أ["find"])) { ن = ن + ١ }
                    صفحات[ي] = اربط(افصل(صفحات[ي]، أ["find"])، أ["replace"])
                }
                ي = ي + ١
            }
            ارسم()
            ارجع "صفحات متأثرة: " + نص_برمجي(ن)
        })،
        أداة("split_at"، "يقسم الصفحة الحالية قبل أول ظهور للنص المعطى"، مخطط({"text": نص_ن}، ["text"])، دالة(أ) {
            متغير س = صفحات[حالي]
            متغير ي = موضع(س، أ["text"])
            إذا (ي < ١) { ارجع "لم يوجد" }
            لقطة()
            متغير جديد = []
            متغير ك = ٠
            طالما (ك < طول(صفحات)) {
                إذا (ك == حالي) {
                    أضف(جديد، قصّ_نهاية(اقتطع(س، ٠، ي)))
                    أضف(جديد، اقتطع(س، ي))
                } وإلا {
                    أضف(جديد، صفحات[ك])
                }
                ك = ك + ١
            }
            صفحات = جديد
            ارسم()
            ارجع "تم"
        })،
        أداة("merge"، "يدمج الصفحة الحالية مع التالية (next) أو السابقة (prev)"، مخطط({"with": {"type": "string"، "enum": ["next"، "prev"]}}، ["with"])، دالة(أ) {
            إذا (أ["with"] == "next" و حالي < طول(صفحات) - ١) {
                ادمج_مع_التالية()
            } وإلا إذا (أ["with"] == "prev" و حالي > ٠) {
                ادمج_مع_السابقة()
            } وإلا {
                ارجع "غير ممكن"
            }
            ارجع "تم"
        })،
        أداة("set_page"، "يستبدل نص صفحة كاملة"، مخطط({"page": رقم_، "text": نص_ن}، ["page"، "text"])، دالة(أ) {
            متغير فهرس = أ["page"] - الإزاحة()
            إذا (فهرس < ٠ أو فهرس >= طول(صفحات)) { ارجع "لا توجد" }
            لقطة()
            صفحات[فهرس] = أ["text"]
            ارسم()
            ارجع "تم"
        })،
        أداة("delete_page"، "يحذف الصفحة الحالية"، مخطط({}، [])، دالة(أ) {
            إذا (طول(صفحات) < ٢) { ارجع "غير ممكن" }
            لقطة()
            متغير جديد = []
            متغير ي = ٠
            طالما (ي < طول(صفحات)) {
                إذا (ي != حالي) { أضف(جديد، صفحات[ي]) }
                ي = ي + ١
            }
            صفحات = جديد
            إذا (حالي > طول(صفحات) - ١) { حالي = طول(صفحات) - ١ }
            ارسم()
            ارجع "تم"
        })،
        أداة("analyze"، "يشغّل التحليل الآلي: يكتشف التراجم ويقسم كل ترجمة إلى صفحة للترجمة والجرح وصفحة للأحاديث ويحذف الحواشي والمقدمة"، مخطط({"intro": {"type": "boolean"}، "foot": {"type": "boolean"}، "norm": {"type": "boolean"}، "two": {"type": "boolean"}}، [])، دالة(أ) {
            متغير ن = نفّذ_التحليل({"مقدمة": خيار(أ، "intro")، "حواشي": خيار(أ، "foot")، "تنظيف": خيار(أ، "norm")، "صفحتان": خيار(أ، "two")})
            إذا (ن == لاشيء) { ارجع "تراجم: " + "undefined" }
            ارجع "تراجم: " + نص_برمجي(ن)
        })،
        أداة("undo"، "يتراجع عن آخر عملية"، مخطط({}، [])، دالة(أ) {
            تراجع()
            ارجع "تم"
        })
    ]
}

دالة خيار(أ، اسم) {
    إذا (يحوي(أ، اسم) و أ[اسم] == خطأ) { ارجع خطأ }
    ارجع صحيح
}

متغير تعليمات_المساعد = "أنت مساعد مدمج في أداة ويب عربية لتحرير صفحات كتاب نصي (كتاب المجروحين لابن حبان غالبًا) وتحليله. الأداة تعرض صفحة واحدة في كل مرة، ولها شجرة عناوين التراجم في شريط أيمن، وتقسيم ودمج للصفحات مع إعادة ترقيم، وتحليل آلي يكتشف التراجم ويفصل الأحاديث. أجب بالعربية باختصار ودقة، ونفّذ بنفسك ما يطلبه المستخدم عبر الأدوات المتاحة ولا تكلفه بعمل يدوي تستطيعه، وأخبره بما فعلت. قد يكون النص ناتج OCR وفيه أخطاء، فنبّه عند الشك."
متغير محادثة = []
متغير مشغول = خطأ

دالة اسأل(سؤال) {
    إذا (مشغول أو قصّ(سؤال) == "") { ارجع لاشيء }
    مشغول = صحيح
    عيّن_نص(مُعرَّف("ans")، "…")
    متغير سجل = []
    متغير بداية = طول(محادثة) - ٨
    إذا (بداية < ٠) { بداية = ٠ }
    متغير ي = بداية
    طالما (ي < طول(محادثة)) {
        متغير م = محادثة[ي]
        إذا (م["د"] == "u") { أضف(سجل، "المستخدم: " + م["ن"]) } وإلا { أضف(سجل، "المساعد: " + م["ن"]) }
        ي = ي + ١
    }
    متغير مدخل = تعليمات_المساعد + حرف(١٠) + حرف(١٠) + "الحالة: الصفحة " + نص_برمجي(حالي + الإزاحة()) + " من " + نص_برمجي(طول(صفحات) + الإزاحة() - ١) + "، والتراجم المكتشفة " + نص_برمجي(طول(العناوين())) + "." + حرف(١٠) + "نص الصفحة الحالية (مقتطف):" + حرف(١٠) + اقتطع(صفحات[حالي]، ٠، ١٥٠٠) + حرف(١٠) + حرف(١٠) + "المحادثة السابقة:" + حرف(١٠) + اربط(سجل، حرف(١٠)) + حرف(١٠) + حرف(١٠) + "المستخدم: " + سؤال
    مساعد_اسأل(مدخل، الأدوات()، {
        "جزء": دالة(ن) { عيّن_نص(مُعرَّف("ans")، ن) }،
        "انتهى": دالة(ن) {
            أضف(محادثة، {"د": "u"، "ن": سؤال})
            أضف(محادثة، {"د": "a"، "ن": ن})
            عيّن_نص(مُعرَّف("ans")، ن)
            مشغول = خطأ
        }،
        "خطأ": دالة(رمز_) {
            إذا (رمز_ == "rate_limited") {
                عيّن_نص(مُعرَّف("ans")، "طلبات كثيرة، أعد المحاولة بعد قليل")
            } وإلا إذا (رمز_ == "not_granted") {
                عيّن_نص(مُعرَّف("ans")، "لم يُمنح إذن المساعد")
            } وإلا {
                عيّن_نص(مُعرَّف("ans")، "تعذّر الاتصال بالمساعد")
            }
            مشغول = خطأ
        }
    })
}

# ---------- بناء الواجهة ----------
دالة ابنِ_الشريط() {
    متغير شريط = سجّل("bar"، عنصر("div"، لاشيء، لاشيء))
    متغير رقم_الصفحة = سجّل("pn"، عنصر("input"، {"type": "number"، "aria-label": "رقم الصفحة"}، لاشيء))
    ضمّ(شريط، [
        زر("prev"، "▶ السابقة"، لاشيء)،
        زر("next"، "التالية ◀"، لاشيء)،
        رقم_الصفحة،
        سجّل("tot"، عنصر("span"، لاشيء، لاشيء))،
        زر("an"، "⚙ تحليل آلي وتقسيم"، "يحلل النص آليًا ويقسمه إلى تراجم")،
        زر("split"، "✂ تقسيم عند المؤشر"، "يقسم الصفحة عند موضع المؤشر")،
        زر("mn"، "دمج مع التالية"، لاشيء)،
        زر("mp"، "دمج مع السابقة"، لاشيء)،
        زر("add"، "+ صفحة"، لاشيء)،
        زر("del"، "حذف"، لاشيء)،
        زر("undo"، "↶ تراجع"، لاشيء)،
        عنصر("span"، {"class": "sp"}، لاشيء)،
        سجّل("msg"، عنصر("span"، لاشيء، لاشيء))،
        زر("exp-b"، "تصدير"، لاشيء)،
        زر("ld"، "تحميل كتاب"، لاشيء)
    ])
    ارجع شريط
}

دالة ابنِ_الرئيسي() {
    متغير رئيسي = سجّل("main"، عنصر("div"، لاشيء، لاشيء))
    متغير جانب = سجّل("side"، عنصر("aside"، لاشيء، لاشيء))
    متغير عنوان_الجانب = عنصر("h4"، لاشيء، "التراجم ")
    ضمّ(عنوان_الجانب، [سجّل("cnt"، عنصر("span"، لاشيء، لاشيء))])
    ضمّ(جانب، [عنوان_الجانب، سجّل("fs"، عنصر("input"، {"placeholder": "بحث في التراجم"}، لاشيء))، سجّل("tree"، عنصر("div"، لاشيء، لاشيء))])
    متغير فاصل = سجّل("rz"، عنصر("div"، {"title": "اسحب للتوسيع أو التضييق، ونقرتان للتبديل"}، لاشيء))
    متغير ta = سجّل("ta"، عنصر("textarea"، {"spellcheck": "false"}، لاشيء))
    ضمّ(رئيسي، [جانب، فاصل، ta])
    ارجع رئيسي
}

دالة ابنِ_التذييل() {
    متغير تذييل = سجّل("ft"، عنصر("div"، لاشيء، لاشيء))
    متغير أزرار = سجّل("fl"، عنصر("div"، لاشيء، لاشيء))
    متغير ب = زر("ab"، "المساعد"، "يحتاج اتصالًا بالشبكة")
    عيّن_سمة(ب، "disabled"، صحيح)
    ضمّ(أزرار، [زر("sb"، "بحث في الشجرة"، لاشيء)، ب])
    متغير مساعد = سجّل("as"، عنصر("div"، لاشيء، لاشيء))
    عيّن_خاصية(مساعد، "hidden"، صحيح)
    متغير سؤال_ = سجّل("aq"، عنصر("div"، لاشيء، لاشيء))
    ضمّ(سؤال_، [سجّل("aqi"، عنصر("input"، {"placeholder": "اسأل المساعد أو اطلب منه تنفيذ عملية على النص..."}، لاشيء))، زر("aqb"، "إرسال"، لاشيء)])
    ضمّ(مساعد، [سجّل("ans"، عنصر("div"، لاشيء، لاشيء))، سؤال_])
    ضمّ(تذييل، [أزرار، مساعد])
    ارجع تذييل
}

دالة خيار_تحليل(اسم، نص_) {
    متغير ل = عنصر("label"، لاشيء، لاشيء)
    متغير ح = سجّل(اسم، عنصر("input"، {"type": "checkbox"}، لاشيء))
    عيّن_خاصية(ح، "checked"، صحيح)
    ضمّ(ل، [ح])
    أضف_نصًا(ل، " " + نص_)
    ارجع ل
}

دالة ابنِ_نافذة_التحليل() {
    متغير خلفية = سجّل("adlg"، عنصر("div"، لاشيء، لاشيء))
    عيّن_خاصية(خلفية، "hidden"، صحيح)
    متغير صندوق = عنصر("div"، {"class": "box"}، لاشيء)
    ضمّ(صندوق، [
        عنصر("b"، لاشيء، "التحليل الآلي وتقسيم التراجم")،
        خيار_تحليل("o1"، "ابدأ من أول ترجمة (تجاهل ما قبلها من مقدمات)")،
        خيار_تحليل("o2"، "احذف حواشي المحقق أسفل الصفحات")،
        خيار_تحليل("o3"، "نظّف النص (التشكيل المشوّه وعلامات الترقيم والرمز ﷺ)")،
        خيار_تحليل("o4"، "اجعل لكل ترجمة صفحتين: الترجمة وأقوال الجرح والتعديل، ثم الأحاديث والآثار")،
        عنصر("small"، لاشيء، "يعتمد الاكتشاف على شكل العنوان (رقم ثم اسم) وأول جملة بعده، وعلى كلمات الإسناد والرسول ﷺ لفصل الأحاديث. راجع النتيجة، ويمكنك التراجع.")
    ])
    متغير أزرار = عنصر("div"، لاشيء، لاشيء)
    ضمّ(أزرار، [زر("ago"، "ابدأ التحليل"، لاشيء)])
    أضف_نصًا(أزرار، " ")
    ضمّ(أزرار، [زر("adx"، "إغلاق"، لاشيء)])
    ضمّ(صندوق، [أزرار])
    ضمّ(خلفية، [صندوق])
    ارجع خلفية
}

دالة خيار_قائمة(قيمة_، نص_) {
    ارجع عنصر("option"، {"value": قيمة_}، نص_)
}

دالة ابنِ_نافذة_التحميل() {
    متغير خلفية = سجّل("dlg"، عنصر("div"، لاشيء، لاشيء))
    متغير صندوق = عنصر("div"، {"class": "box"}، لاشيء)
    متغير قائمة = سجّل("mode"، عنصر("select"، لاشيء، لاشيء))
    ضمّ(قائمة، [خيار_قائمة("auto"، "تلقائي")، خيار_قائمة("mark"، "علامات === صفحة ن ===")، خيار_قائمة("ff"، "فاصل صفحة (form feed)")، خيار_قائمة("lines"، "كل عدد من الأسطر")])
    متغير ل١ = عنصر("label"، لاشيء، لاشيء)
    أضف_نصًا(ل١، "تقسيم الصفحات: ")
    ضمّ(ل١، [قائمة])
    أضف_نصًا(ل١، " عدد الأسطر ")
    متغير nl = سجّل("nl"، عنصر("input"، {"type": "number"، "value": "40"}، لاشيء))
    عيّن_نمط(nl، "width"، "70px")
    ضمّ(ل١، [nl])
    متغير ل٢ = عنصر("label"، لاشيء، لاشيء)
    أضف_نصًا(ل٢، "نمط عنوان الترجمة (تعبير نمطي، المجموعة الأولى هي العنوان):")
    متغير rx = سجّل("rx"، عنصر("input"، لاشيء، لاشيء))
    عيّن_خاصية(rx، "value"، نمط_العناوين_الافتراضي)
    عيّن_نمط(rx، "width"، "100%")
    عيّن_نمط(rx، "direction"، "ltr")
    ضمّ(ل٢، [rx])
    متغير ل٣ = عنصر("label"، لاشيء، لاشيء)
    أضف_نصًا(ل٣، "رقم أول صفحة: ")
    متغير off = سجّل("off"، عنصر("input"، {"type": "number"، "value": "1"}، لاشيء))
    عيّن_نمط(off، "width"، "70px")
    ضمّ(ل٣، [off])
    متغير أزرار = عنصر("div"، لاشيء، لاشيء)
    ضمّ(أزرار، [زر("go"، "ابدأ"، لاشيء)])
    أضف_نصًا(أزرار، " ")
    ضمّ(أزرار، [زر("dx"، "إغلاق"، لاشيء)])
    متغير ملف = سجّل("file"، عنصر("input"، {"type": "file"، "accept": ".txt,.md,text/plain"}، لاشيء))
    متغير لصق = سجّل("paste"، عنصر("textarea"، {"placeholder": "أو الصق النص هنا"}، لاشيء))
    ضمّ(صندوق، [عنصر("b"، لاشيء، "تحميل الكتاب النصي")، ملف، لصق، ل١، ل٢، ل٣، أزرار])
    ضمّ(خلفية، [صندوق])
    ارجع خلفية
}

دالة ابنِ_نافذة_التصدير() {
    متغير خلفية = سجّل("exp"، عنصر("div"، لاشيء، لاشيء))
    عيّن_خاصية(خلفية، "hidden"، صحيح)
    متغير صندوق = عنصر("div"، {"class": "box"}، لاشيء)
    متغير خرج = سجّل("out"، عنصر("textarea"، لاشيء، لاشيء))
    عيّن_نمط(خرج، "height"، "260px")
    متغير أزرار = عنصر("div"، لاشيء، لاشيء)
    متغير حفظ = زر("sv"، "حفظ ملف"، لاشيء)
    عيّن_خاصية(حفظ، "hidden"، صحيح)
    ضمّ(أزرار، [حفظ])
    أضف_نصًا(أزرار، " ")
    ضمّ(أزرار، [زر("cp"، "نسخ"، لاشيء)])
    أضف_نصًا(أزرار، " ")
    ضمّ(أزرار، [زر("xc"، "إغلاق"، لاشيء)])
    ضمّ(صندوق، [عنصر("b"، لاشيء، "النص المعدَّل")، خرج، أزرار])
    ضمّ(خلفية، [صندوق])
    ارجع خلفية
}

دالة اضبط_العرض() {
    عيّن_نمط(مُعرَّف("side")، "width"، نص_برمجي(عرض_الجانب) + "px")
    عيّن_نمط(مُعرَّف("fl")، "width"، نص_برمجي(عرض_الجانب + ٦) + "px")
}

دالة اربط_الأحداث() {
    عند_نقر(مُعرَّف("prev")، دالة() { اذهب(حالي - ١، لاشيء) })
    عند_نقر(مُعرَّف("next")، دالة() { اذهب(حالي + ١، لاشيء) })
    عند(مُعرَّف("pn")، "change"، دالة(ح) { اذهب(رقم_حقل("pn") - الإزاحة()، لاشيء) })
    عند_نقر(مُعرَّف("split")، قسّم_عند_المؤشر)
    عند_نقر(مُعرَّف("mn")، ادمج_مع_التالية)
    عند_نقر(مُعرَّف("mp")، ادمج_مع_السابقة)
    عند_نقر(مُعرَّف("add")، أضف_صفحة)
    عند_نقر(مُعرَّف("del")، احذف_الصفحة)
    عند_نقر(مُعرَّف("undo")، تراجع)
    عند_نقر(مُعرَّف("exp-b")، دالة() {
        عيّن_خاصية(مُعرَّف("out")، "value"، نص_التصدير())
        أخفِ("exp"، خطأ)
    })
    عند_نقر(مُعرَّف("cp")، دالة() {
        انسخ_للحافظة(قيمة("out")، دالة(نجح) {
            إذا (نجح) {
                قُل("نُسخ")
            } وإلا {
                ركّز(مُعرَّف("out"))
                حدّد_نص(مُعرَّف("out")، ٠، طول(قيمة("out")))
                قُل("حدّد وانسخ يدويًا")
            }
        })
    })
    عند_نقر(مُعرَّف("xc")، دالة() { أخفِ("exp"، صحيح) })
    عند_نقر(مُعرَّف("ld")، دالة() { أخفِ("dlg"، خطأ) })
    عند_نقر(مُعرَّف("dx")، دالة() { أخفِ("dlg"، صحيح) })
    عند(مُعرَّف("file")، "change"، دالة(ح) {
        نص_المرفوع(مُعرَّف("file")، دالة(محتوى) { عيّن_خاصية(مُعرَّف("paste")، "value"، محتوى) })
    })
    عند_نقر(مُعرَّف("go")، دالة() {
        متغير نص_ل = قيمة("paste")
        إذا (قصّ(نص_ل) != "") { حمّل_نص(نص_ل) } وإلا { قُل("أدخل نصًا أولًا") }
    })
    عند(مُعرَّف("ta")، "beforeinput"، دالة(ح) {
        إذا (ليس متسخ) {
            لقطة()
            متسخ = صحيح
        }
    })
    عند(مُعرَّف("ta")، "input"، دالة(ح) {
        صفحات[حالي] = اقرأ_خاصية(مُعرَّف("ta")، "value")
        إذا (مؤقت_شجرة != لاشيء) { ألغِ_المدة(مؤقت_شجرة) }
        مؤقت_شجرة = بعد_مدة(٤٠٠، ارسم_الشجرة)
    })
    عند(المستند()، "keydown"، دالة(ح) {
        إذا (ح["alt"] و ح["مفتاح"] == "ArrowLeft") {
            امنع_الافتراضي(ح)
            اذهب(حالي + ١، لاشيء)
        }
        إذا (ح["alt"] و ح["مفتاح"] == "ArrowRight") {
            امنع_الافتراضي(ح)
            اذهب(حالي - ١، لاشيء)
        }
    })
    عند_نقر(مُعرَّف("an")، دالة() { أخفِ("adlg"، خطأ) })
    عند_نقر(مُعرَّف("adx")، دالة() { أخفِ("adlg"، صحيح) })
    عند_نقر(مُعرَّف("ago")، دالة() {
        أخفِ("adlg"، صحيح)
        نفّذ_التحليل({"مقدمة": مفعّل("o1")، "حواشي": مفعّل("o2")، "تنظيف": مفعّل("o3")، "صفحتان": مفعّل("o4")})
    })
    عند_نقر(مُعرَّف("sb")، دالة() {
        متغير ف = مُعرَّف("fs")
        إذا (نمط_محسوب(ف، "display") == "none") {
            عيّن_نمط(ف، "display"، "block")
            ركّز(ف)
        } وإلا {
            عيّن_نمط(ف، "display"، "none")
            عيّن_خاصية(ف، "value"، "")
            ارسم_الشجرة()
        }
    })
    عند(مُعرَّف("fs")، "input"، دالة(ح) { ارسم_الشجرة() })
    عند_نقر(مُعرَّف("aqb")، دالة() {
        متغير ق = قيمة("aqi")
        عيّن_خاصية(مُعرَّف("aqi")، "value"، "")
        اسأل(ق)
    })
    عند(مُعرَّف("aqi")، "keydown"، دالة(ح) {
        إذا (ح["مفتاح"] == "Enter") {
            امنع_الافتراضي(ح)
            متغير ق = قيمة("aqi")
            عيّن_خاصية(مُعرَّف("aqi")، "value"، "")
            اسأل(ق)
        }
    })
    عند_نقر(مُعرَّف("ab")، دالة() { ركّز(مُعرَّف("aqi")) })
    # شريط تغيير العرض
    متغير فاصل = مُعرَّف("rz")
    عند(فاصل، "pointerdown"، دالة(ح) {
        التقط_المؤشر(فاصل، ح)
        واجهة["يسحب"] = صحيح
    })
    عند(فاصل، "pointermove"، دالة(ح) {
        إذا (واجهة["يسحب"] == صحيح) {
            متغير ق = قياس(مُعرَّف("main"))
            عرض_الجانب = ق["يمين"] - ح["x"]
            إذا (عرض_الجانب < ٠) { عرض_الجانب = ٠ }
            إذا (عرض_الجانب > ٤٢٠) { عرض_الجانب = ٤٢٠ }
            اضبط_العرض()
        }
    })
    عند(فاصل، "pointerup"، دالة(ح) { واجهة["يسحب"] = خطأ })
    عند(فاصل، "dblclick"، دالة(ح) {
        إذا (عرض_الجانب > ١٢٠) { عرض_الجانب = ١٠٠ } وإلا { عرض_الجانب = ٢٨٠ }
        اضبط_العرض()
    })
}

دالة ابدأ() {
    متغير جذر = الجذر()
    متغير نمط_ = عنصر("style"، لاشيء، أسلوب)
    ضمّ(جذر، [نمط_، ابنِ_الشريط()، ابنِ_الرئيسي()، ابنِ_التذييل()، ابنِ_نافذة_التحليل()، ابنِ_نافذة_التحميل()، ابنِ_نافذة_التصدير()])
    عيّن_نمط(مُعرَّف("fs")، "display"، "none")
    اضبط_العرض()
    اربط_الأحداث()
    إذا (مساعد_متاح()) {
        أخفِ("as"، خطأ)
        عيّن_خاصية(مُعرَّف("ab")، "disabled"، خطأ)
        عيّن_سمة(مُعرَّف("ab")، "title"، "")
    }
    إذا (تنزيل_متاح()) {
        أخفِ("sv"، خطأ)
        عند_نقر(مُعرَّف("sv")، دالة() {
            نزّل_ملفًا("book-pages.txt"، قيمة("out")، دالة(نتيجة) {
                إذا (نتيجة == "ok") {
                    قُل("حُفظ")
                } وإلا إذا (نتيجة == "declined") {
                    قُل("أُلغي الحفظ")
                } وإلا {
                    قُل("تعذّر الحفظ")
                }
            })
        })
    }
    ارسم()
}

ابدأ()
