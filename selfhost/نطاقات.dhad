# محلِّل النطاقات لـ«ضاد» (الوضع الديناميكي في وازم.dhad): يحلّ كل اسم إلى متغيره الحقيقي بقواعد النطاق المتداخل
# (كتل، معاملات، دوال متداخلة) ويحدّد المتغيرات التي تلتقطها الإغلاقات لتُخزَّن في «خلايا» على الكومة.
# المخرج: يكتب في عقد الشجرة نفسها (لا ينسخها):
#   Identifier: ref = {"k": "local"|"free", "var": ف, "idx": موضع في قائمة الملتقَطات (للحرّ)} أو لاشيء (عام/دالة/مدمجة)
#   VarDecl وFor وForIn والدالة المتداخلة: var = المتغير المعرَّف؛ FuncExpr/FuncDecl المتداخلة: ctx = سياق الدالة
# المتغير ف = {"id", "name", "slot", "boxed", "owner"}؛ boxed يصير صحيحًا حين تلتقطه دالة متداخلة.
# السياق = {"decl", "parent", "scopes", "vars", "free", "freeIndex", "nested", "slots", "hasEnv", "index"}.
# الفتحة ٠ في الدالة المتداخلة محجوزة لكائن الإغلاق نفسه (بيئتها).

متغير _عدّاد = ٠

صدّر دالة سياق_جديد(قرار، أب) {
    متغير بيئة = أب != لاشيء
    متغير فتحات = ٠
    إذا (بيئة) { فتحات = ١ }
    ارجع {"decl": قرار، "parent": أب، "scopes": [{}]، "vars": []، "free": []، "freeIndex": {}، "nested": []، "slots": فتحات، "hasEnv": بيئة، "index": -١}
}

دالة _أعلن(سياق، اسم) {
    _عدّاد = _عدّاد + ١
    متغير ف = {"id": _عدّاد، "name": اسم، "slot": سياق["slots"]، "boxed": خطأ، "owner": سياق}
    سياق["slots"] = سياق["slots"] + ١
    أضف(سياق["vars"]، ف)
    سياق["scopes"][طول(سياق["scopes"]) - ١][اسم] = ف
    ارجع ف
}

دالة _ابحث(سياق، اسم) {
    متغير ي = طول(سياق["scopes"]) - ١
    طالما (ي >= ٠) {
        إذا (يحوي(سياق["scopes"][ي]، اسم)) { ارجع {"k": "local"، "var": سياق["scopes"][ي][اسم]} }
        ي = ي - ١
    }
    إذا (سياق["parent"] == لاشيء) { ارجع لاشيء }
    متغير ص = _ابحث(سياق["parent"]، اسم)
    إذا (ص == لاشيء) { ارجع لاشيء }
    متغير ف = ص["var"]
    ف["boxed"] = صحيح
    متغير مفتاح = نص_برمجي(ف["id"])
    إذا (ليس يحوي(سياق["freeIndex"]، مفتاح)) {
        سياق["freeIndex"][مفتاح] = طول(سياق["free"])
        أضف(سياق["free"]، ف)
    }
    ارجع {"k": "free"، "var": ف، "idx": سياق["freeIndex"][مفتاح]}
}

# يحلّ الدالة كلها (معاملاتها وجسمها) في سياقها؛ الدوال المتداخلة تُسجَّل في سياق.nested
صدّر دالة حلّ_دالة(سياق) {
    من_أجل (م في سياق["decl"]["params"]) { _أعلن(سياق، م) }
    _كتلة_بلا_نطاق(سياق، سياق["decl"]["body"])
}

دالة _كتلة_بلا_نطاق(سياق، ك) {
    من_أجل (ج في ك["statements"]) { _جملة(سياق، ج) }
}

دالة _كتلة(سياق، ك) {
    أضف(سياق["scopes"]، {})
    _كتلة_بلا_نطاق(سياق، ك)
    انزع(سياق["scopes"])
}

دالة _دالة_متداخلة(سياق، عقدة) {
    متغير ابن = سياق_جديد(عقدة، سياق)
    عقدة["ctx"] = ابن
    أضف(سياق["nested"]، ابن)
    حلّ_دالة(ابن)
}

دالة _جملة(سياق، ج) {
    متغير ك = ج["kind"]
    إذا (ك == "VarDecl") {
        إذا (ج["expr"] != لاشيء) { _تعبير(سياق، ج["expr"]) }
        ج["var"] = _أعلن(سياق، ج["name"])
    } وإلا إذا (ك == "FuncDecl") {
        # تُعلَن أولًا ليراها جسمها (تكرار ذاتي)
        ج["var"] = _أعلن(سياق، ج["name"])
        _دالة_متداخلة(سياق، ج)
    } وإلا إذا (ك == "ExprStmt" أو ك == "Await") {
        _تعبير(سياق، ج["expr"])
    } وإلا إذا (ك == "Return") {
        إذا (ج["expr"] != لاشيء) { _تعبير(سياق، ج["expr"]) }
    } وإلا إذا (ك == "If") {
        _تعبير(سياق، ج["cond"])
        _كتلة(سياق، ج["thenBlock"])
        إذا (ج["elseBlock"] != لاشيء) { _كتلة(سياق، ج["elseBlock"]) }
    } وإلا إذا (ك == "While") {
        _تعبير(سياق، ج["cond"])
        _كتلة(سياق، ج["body"])
    } وإلا إذا (ك == "For") {
        _تعبير(سياق، ج["start"])
        _تعبير(سياق، ج["end"])
        إذا (ج["step"] != لاشيء) { _تعبير(سياق، ج["step"]) }
        أضف(سياق["scopes"]، {})
        ج["var"] = _أعلن(سياق، ج["varName"])
        _كتلة(سياق، ج["body"])
        انزع(سياق["scopes"])
    } وإلا إذا (ك == "ForIn") {
        # كما يفعل المصرِّف الأصلي: قائمة مخفية = @تكرار(المتكرَّر) ثم حلقة بعدّاد مخفي يُعلَن المتغير في أول جسمها
        _عدّاد = _عدّاد + ١
        متغير اسم_القائمة = "@forin_list_" + نص_برمجي(_عدّاد)
        متغير اسم_العدّاد = "@forin_i_" + نص_برمجي(_عدّاد)
        متغير قائمة_ع = {"kind": "Identifier"، "name": اسم_القائمة}
        متغير عدّاد_ع = {"kind": "Identifier"، "name": اسم_العدّاد}
        متغير آخر = {"kind": "BinOp"، "op": "MINUS"، "left": {"kind": "Call"، "callee": {"kind": "Identifier"، "name": "طول"}، "args": [{"kind": "Identifier"، "name": اسم_القائمة}]}، "right": {"kind": "Number"، "value": ١}}
        متغير أول = {"kind": "VarDecl"، "name": ج["varName"]، "expr": {"kind": "Index"، "obj": قائمة_ع، "index": عدّاد_ع}}
        متغير جمل_الجسم = [أول] + ج["body"]["statements"]
        متغير ربط = {"kind": "VarDecl"، "name": اسم_القائمة، "expr": {"kind": "Call"، "callee": {"kind": "Identifier"، "name": "@تكرار"}، "args": [ج["iter"]]}}
        متغير حلقة = {"kind": "For"، "varName": اسم_العدّاد، "start": {"kind": "Number"، "value": ٠}، "end": آخر، "step": لاشيء، "hidden": صحيح، "body": {"kind": "Block"، "statements": جمل_الجسم}}
        ج["kind"] = "Multi"
        ج["statements"] = [ربط، حلقة]
        _جملة(سياق، ج)
    } وإلا إذا (ك == "Block") {
        _كتلة(سياق، ج)
    } وإلا إذا (ك == "Multi") {
        # جمل مولَّدة (أصناف، تفكيك): أسماؤها في النطاق المحيط
        من_أجل (س في ج["statements"]) { _جملة(سياق، س) }
    } وإلا إذا (ك == "Try") {
        _كتلة(سياق، ج["tryBlock"])
        إذا (ج["catchBlock"] != لاشيء) {
            أضف(سياق["scopes"]، {})
            إذا (ج["errName"] != لاشيء) { ج["var"] = _أعلن(سياق، ج["errName"]) }
            _كتلة(سياق، ج["catchBlock"])
            انزع(سياق["scopes"])
        }
        إذا (ج["finallyBlock"] != لاشيء) { _كتلة(سياق، ج["finallyBlock"]) }
    } وإلا إذا (ك == "Break" أو ك == "Continue") {
        ارجع لاشيء
    } وإلا إذا (ك == "Export") {
        _جملة(سياق، ج["stmt"])
    } وإلا {
        أطلق_خطأ("محلل النطاقات: جملة غير معروفة: " + ك)
    }
}

دالة _تعبير(سياق، ع) {
    متغير ك = ع["kind"]
    إذا (ك == "Identifier") {
        ع["ref"] = _ابحث(سياق، ع["name"])
    } وإلا إذا (ك == "Number" أو ك == "String" أو ك == "Boolean" أو ك == "Null") {
        ارجع لاشيء
    } وإلا إذا (ك == "UnaryOp" أو ك == "Await") {
        _تعبير(سياق، ع["expr"])
    } وإلا إذا (ك == "BinOp") {
        _تعبير(سياق، ع["left"])
        _تعبير(سياق، ع["right"])
    } وإلا إذا (ك == "Assign") {
        _تعبير(سياق، ع["target"])
        _تعبير(سياق، ع["expr"])
    } وإلا إذا (ك == "Call") {
        _تعبير(سياق، ع["callee"])
        من_أجل (وس في ع["args"]) { _تعبير(سياق، وس) }
    } وإلا إذا (ك == "Index") {
        _تعبير(سياق، ع["obj"])
        _تعبير(سياق، ع["index"])
    } وإلا إذا (ك == "ListLiteral") {
        من_أجل (عنصر في ع["elements"]) { _تعبير(سياق، عنصر) }
    } وإلا إذا (ك == "MapLiteral") {
        من_أجل (م في ع["entries"]) {
            _تعبير(سياق، م["key"])
            _تعبير(سياق، م["value"])
        }
    } وإلا إذا (ك == "FuncExpr") {
        _دالة_متداخلة(سياق، ع)
    } وإلا {
        أطلق_خطأ("محلل النطاقات: تعبير غير معروف: " + ك)
    }
}
