# مُصرِّف ضاد (من الشجرة إلى البايتكود) مكتوبًا بضاد (الاستضافة الذاتية، المرحلة ٣).
# نقل أمين لـ compiler.js: التعليمات والثوابت وعناوين القفز والرسائل نفسها. المخرج:
# {"mainChunkIndex", "functionChunks": [{name, params, code: [{op, args, line}], constants, maxSlots, isAsync?}], "exportNames"}

# ---------- الحالة ----------
متغير دوال = []          # كل الدوال المصرَّفة؛ الفهرس ٠ هو البرنامج الرئيسي
متغير مكدّس = []         # مكدّس نطاقات الدوال
متغير حلقات = []         # للحلقات: توقف وأكمل
متغير داخل_أخيرًا = ٠
متغير مكدّس_أخيرًا = []
متغير عمق_حاول = ٠
متغير صادرات = []
متغير عدّاد_فور_إن = ٠
متغير سطر_حالي = لاشيء

# ---------- القطع والنطاقات ----------
دالة _قطعة_جديدة(اسم، معاملات) {
    ارجع {"name": اسم، "params": معاملات، "code": []، "constants": []، "maxSlots": طول(معاملات)}
}

دالة _نطاق_دالة(اسم، معاملات) {
    متغير ن = {"chunk": _قطعة_جديدة(اسم، معاملات)، "scopes": [{}]، "nextSlot": ٠}
    من_أجل (م في معاملات) { _عرّف(ن، م) }
    ارجع ن
}

دالة _عرّف(ن، اسم) {
    متغير خانة = ن["nextSlot"]
    ن["nextSlot"] = خانة + ١
    إذا (ن["nextSlot"] > ن["chunk"]["maxSlots"]) { ن["chunk"]["maxSlots"] = ن["nextSlot"] }
    ن["scopes"][طول(ن["scopes"]) - ١][اسم] = خانة
    ارجع خانة
}

دالة _حلّ_اسم(ن، اسم) {
    متغير ي = طول(ن["scopes"]) - ١
    طالما (ي >= ٠) {
        إذا (يحوي(ن["scopes"][ي]، اسم)) { ارجع ن["scopes"][ي][اسم] }
        ي = ي - ١
    }
    ارجع -١
}

دالة _حالي() { ارجع مكدّس[طول(مكدّس) - ١] }
دالة _قطعة() { ارجع _حالي()["chunk"] }
دالة _أعلى() { ارجع طول(مكدّس) == ١ }

دالة _أصدر(عملية، وسائط) {
    متغير تع = {"op": عملية، "args": وسائط}
    إذا (سطر_حالي != لاشيء) { تع["line"] = سطر_حالي }
    أضف(_قطعة()["code"]، تع)
    ارجع طول(_قطعة()["code"]) - ١
}
دالة _ثابت(قيمة) {
    أضف(_قطعة()["constants"]، قيمة)
    ارجع طول(_قطعة()["constants"]) - ١
}
دالة _رقّع(عنوان، وسائط) { _قطعة()["code"][عنوان]["args"] = وسائط }
دالة _هنا() { ارجع طول(_قطعة()["code"]) }

# ---------- البرنامج ----------
دالة _صرّف_برنامج(برنامج) {
    متغير نطاق = _نطاق_دالة("<رئيسي>"، [])
    أضف(مكدّس، نطاق)
    أضف(دوال، نطاق["chunk"])
    من_أجل (ج في برنامج["statements"]) { _جملة(ج) }
    _أصدر("HALT"، [])
    انزع(مكدّس)
    ارجع {"mainChunkIndex": ٠، "functionChunks": دوال، "exportNames": صادرات}
}

# ---------- الجمل ----------
دالة _جملة(ع) {
    إذا (يحوي(ع، "line") و ع["line"] != لاشيء و ع["line"] != ٠) { سطر_حالي = ع["line"] }
    متغير ك = ع["kind"]
    إذا (ك == "Export") {
        _جملة(ع["stmt"])
        من_أجل (ن في ع["names"]) {
            إذا (ليس (ن في صادرات)) { أضف(صادرات، ن) }
        }
    } وإلا إذا (ك == "ExprStmt") {
        _تعبير(ع["expr"])
        _أصدر("POP"، [])
    } وإلا إذا (ك == "VarDecl") {
        _جملة_متغير(ع)
    } وإلا إذا (ك == "FuncDecl") {
        _جملة_دالة(ع)
    } وإلا إذا (ك == "Try") {
        _جملة_حاول(ع)
    } وإلا إذا (ك == "If") {
        _جملة_إذا(ع)
    } وإلا إذا (ك == "While") {
        _جملة_طالما(ع)
    } وإلا إذا (ك == "For") {
        _جملة_من_إلى(ع)
    } وإلا إذا (ك == "ForIn") {
        _جملة_من_في(ع)
    } وإلا إذا (ك == "Return") {
        _جملة_ارجع(ع)
    } وإلا إذا (ك == "Multi") {
        من_أجل (ج في ع["statements"]) { _جملة(ج) }
    } وإلا إذا (ك == "Block") {
        _كتلة_بنطاق(ع)
    } وإلا إذا (ك == "Break") {
        _جملة_توقف()
    } وإلا إذا (ك == "Continue") {
        _جملة_أكمل()
    } وإلا {
        أطلق_خطأ("لا يمكن تصريف الجملة: " + نص_برمجي(ك))
    }
}

دالة _جملة_متغير(ع) {
    _تعبير(ع["expr"])
    إذا (_أعلى()) {
        _أصدر("DEFINE_GLOBAL"، [ع["name"]])
    } وإلا {
        متغير خانة = _عرّف(_حالي()، ع["name"])
        _أصدر("SET_LOCAL"، [خانة])
        _أصدر("POP"، [])
    }
}

دالة _جسم_دالة(اسم، معاملات، جسم، غير_متزامنة) {
    متغير نطاق = _نطاق_دالة(اسم، معاملات)
    نطاق["chunk"]["isAsync"] = غير_متزامنة != لاشيء و غير_متزامنة != خطأ
    أضف(مكدّس، نطاق)
    متغير حلقات_قديمة = حلقات
    متغير حاول_قديم = عمق_حاول
    متغير أخيرًا_قديم = مكدّس_أخيرًا
    متغير داخل_قديم = داخل_أخيرًا
    حلقات = []
    عمق_حاول = ٠
    مكدّس_أخيرًا = []
    داخل_أخيرًا = ٠
    متغير فهرس = طول(دوال)
    أضف(دوال، نطاق["chunk"])
    من_أجل (ج في جسم["statements"]) { _جملة(ج) }
    _أصدر("CONST"، [_ثابت(لاشيء)])
    _أصدر("RETURN"، [])
    حلقات = حلقات_قديمة
    عمق_حاول = حاول_قديم
    مكدّس_أخيرًا = أخيرًا_قديم
    داخل_أخيرًا = داخل_قديم
    انزع(مكدّس)
    ارجع فهرس
}

دالة _غير_متزامنة_عقدة(ع) { ارجع يحوي(ع، "isAsync") و ع["isAsync"] }

دالة _جملة_دالة(ع) {
    متغير خانة = -١
    إذا (ليس _أعلى()) { خانة = _عرّف(_حالي()، ع["name"]) }
    متغير فهرس = _جسم_دالة(ع["name"]، ع["params"]، ع["body"]، _غير_متزامنة_عقدة(ع))
    _أصدر("BUILD_FUNCTION"، [فهرس])
    إذا (_أعلى()) {
        _أصدر("DEFINE_GLOBAL"، [ع["name"]])
    } وإلا {
        _أصدر("SET_LOCAL"، [خانة])
        _أصدر("POP"، [])
    }
}

دالة _جملة_حاول(ع) {
    إذا (ع["finallyBlock"] == لاشيء) {
        _حاول_التقط(ع)
        ارجع لاشيء
    }
    متغير خارجي = _أصدر("TRY_BEGIN"، [-١])
    عمق_حاول = عمق_حاول + ١
    أضف(مكدّس_أخيرًا، {"block": ع["finallyBlock"]، "depth": عمق_حاول})
    إذا (ع["catchBlock"] != لاشيء) {
        _حاول_التقط(ع)
    } وإلا {
        _كتلة_بنطاق(ع["tryBlock"])
    }
    انزع(مكدّس_أخيرًا)
    عمق_حاول = عمق_حاول - ١
    _أصدر("TRY_END"، [])
    _جسم_أخيرًا(ع["finallyBlock"])
    متغير قفزة_النهاية = _أصدر("JUMP"، [-١])
    _رقّع(خارجي، [_هنا()])
    _جسم_أخيرًا(ع["finallyBlock"])
    _أصدر("RETHROW"، [])
    _رقّع(قفزة_النهاية، [_هنا()])
}

دالة _جسم_أخيرًا(كتلة) {
    داخل_أخيرًا = داخل_أخيرًا + ١
    _كتلة_بنطاق(كتلة)
    داخل_أخيرًا = داخل_أخيرًا - ١
}

# ينفّذ أجسام «أخيرًا» المفتوحة من الداخل إلى الخارج قبل الخروج بـ ارجع/توقف/أكمل
دالة _فكّ_أخيرًا(إلى_عمق) {
    متغير محفوظ = مكدّس_أخيرًا
    متغير ك = عمق_حاول
    طالما (ك > إلى_عمق) {
        _أصدر("TRY_END"، [])
        متغير فهرس = -١
        متغير ي = ٠
        طالما (ي < طول(محفوظ)) {
            إذا (محفوظ[ي]["depth"] == ك) {
                فهرس = ي
                توقف
            }
            ي = ي + ١
        }
        إذا (فهرس >= ٠) {
            مكدّس_أخيرًا = محفوظ[٠:فهرس]
            متغير عمق_محفوظ = عمق_حاول
            عمق_حاول = ك - ١
            _جسم_أخيرًا(محفوظ[فهرس]["block"])
            عمق_حاول = عمق_محفوظ
            مكدّس_أخيرًا = محفوظ
        }
        ك = ك - ١
    }
}

دالة _حاول_التقط(ع) {
    متغير بداية = _أصدر("TRY_BEGIN"، [-١])
    عمق_حاول = عمق_حاول + ١
    _كتلة_بنطاق(ع["tryBlock"])
    عمق_حاول = عمق_حاول - ١
    _أصدر("TRY_END"، [])
    متغير قفزة_النهاية = _أصدر("JUMP"، [-١])
    _رقّع(بداية، [_هنا()])
    إذا (ليس _أعلى()) { أضف(_حالي()["scopes"]، {}) }
    إذا (ع["errName"] != لاشيء) {
        إذا (_أعلى()) {
            _أصدر("DEFINE_GLOBAL"، [ع["errName"]])
        } وإلا {
            متغير خانة = _عرّف(_حالي()، ع["errName"])
            _أصدر("SET_LOCAL"، [خانة])
            _أصدر("POP"، [])
        }
    } وإلا {
        _أصدر("POP"، [])
    }
    من_أجل (ج في ع["catchBlock"]["statements"]) { _جملة(ج) }
    إذا (ليس _أعلى()) { انزع(_حالي()["scopes"]) }
    _رقّع(قفزة_النهاية، [_هنا()])
}

دالة _جملة_إذا(ع) {
    _تعبير(ع["cond"])
    متغير قفزة_خطأ = _أصدر("JUMP_IF_FALSE"، [-١])
    _أصدر("POP"، [])
    _كتلة_بنطاق(ع["thenBlock"])
    متغير قفزة_النهاية = _أصدر("JUMP"، [-١])
    _رقّع(قفزة_خطأ، [_هنا()])
    _أصدر("POP"، [])
    إذا (ع["elseBlock"] != لاشيء) { _كتلة_بنطاق(ع["elseBlock"]) }
    _رقّع(قفزة_النهاية، [_هنا()])
}

دالة _حلقة_جديدة() {
    ارجع {"breakAddrs": []، "continueAddrs": []، "tryDepth": عمق_حاول، "inFinally": داخل_أخيرًا}
}

دالة _جملة_طالما(ع) {
    متغير بداية_الحلقة = _هنا()
    _تعبير(ع["cond"])
    متغير قفزة_خطأ = _أصدر("JUMP_IF_FALSE"، [-١])
    _أصدر("POP"، [])
    أضف(حلقات، _حلقة_جديدة())
    _كتلة_بنطاق(ع["body"])
    متغير حلقة = انزع(حلقات)
    من_أجل (أ في حلقة["continueAddrs"]) { _رقّع(أ، [بداية_الحلقة]) }
    _أصدر("JUMP"، [بداية_الحلقة])
    _رقّع(قفزة_خطأ، [_هنا()])
    _أصدر("POP"، [])
    من_أجل (أ في حلقة["breakAddrs"]) { _رقّع(أ، [_هنا()]) }
}

دالة _مرجع_متغير(اسم) {
    إذا (_أعلى()) { ارجع {"global": اسم} }
    ارجع {"local": _عرّف(_حالي()، اسم)}
}

دالة _حمّل(مرجع) {
    إذا (يحوي(مرجع، "global")) {
        _أصدر("GET_GLOBAL"، [مرجع["global"]])
    } وإلا {
        _أصدر("GET_LOCAL"، [مرجع["local"]])
    }
}
دالة _خزّن(مرجع) {
    إذا (يحوي(مرجع، "global")) {
        _أصدر("SET_GLOBAL_NEW"، [مرجع["global"]])
    } وإلا {
        _أصدر("SET_LOCAL"، [مرجع["local"]])
    }
}

دالة _جملة_من_إلى(ع) {
    متغير مرجع_المتغير = _مرجع_متغير(ع["varName"])
    متغير اسم_النهاية = "@for_end_" + نص_برمجي(_هنا())
    متغير اسم_الخطوة = "@for_step_" + نص_برمجي(_هنا())
    متغير مرجع_النهاية = _مرجع_متغير(اسم_النهاية)
    متغير مرجع_الخطوة = _مرجع_متغير(اسم_الخطوة)

    _تعبير(ع["start"])
    _خزّن(مرجع_المتغير)
    _أصدر("POP"، [])

    _تعبير(ع["end"])
    _خزّن(مرجع_النهاية)
    _أصدر("POP"، [])

    إذا (ع["step"] != لاشيء) {
        _تعبير(ع["step"])
    } وإلا {
        _أصدر("CONST"، [_ثابت(١)])
    }
    _خزّن(مرجع_الخطوة)
    _أصدر("POP"، [])

    متغير بداية_الحلقة = _هنا()
    _حمّل(مرجع_المتغير)
    _حمّل(مرجع_النهاية)
    _حمّل(مرجع_الخطوة)
    _أصدر("FOR_TEST"، [])
    متغير قفزة_خطأ = _أصدر("JUMP_IF_FALSE"، [-١])
    _أصدر("POP"، [])

    أضف(حلقات، _حلقة_جديدة())
    _كتلة_بنطاق(ع["body"])
    متغير عنوان_الزيادة = _هنا()
    متغير حلقة = انزع(حلقات)
    من_أجل (أ في حلقة["continueAddrs"]) { _رقّع(أ، [عنوان_الزيادة]) }
    _حمّل(مرجع_المتغير)
    _حمّل(مرجع_الخطوة)
    _أصدر("ADD"، [])
    _خزّن(مرجع_المتغير)
    _أصدر("POP"، [])
    _أصدر("JUMP"، [بداية_الحلقة])

    _رقّع(قفزة_خطأ، [_هنا()])
    _أصدر("POP"، [])
    من_أجل (أ في حلقة["breakAddrs"]) { _رقّع(أ، [_هنا()]) }
}

دالة _جملة_من_في(ع) {
    عدّاد_فور_إن = عدّاد_فور_إن + ١
    متغير ن = نص_برمجي(عدّاد_فور_إن)
    متغير قائمة = {"kind": "Identifier"، "name": "@forin_list_" + ن}
    متغير فهرس = {"kind": "Identifier"، "name": "@forin_i_" + ن}
    _جملة_متغير({"kind": "VarDecl"، "name": "@forin_list_" + ن، "expr": {"kind": "Call"، "callee": {"kind": "Identifier"، "name": "@تكرار"}، "args": [ع["iter"]]}})
    متغير آخر = {"kind": "BinOp"، "op": "MINUS"، "left": {"kind": "Call"، "callee": {"kind": "Identifier"، "name": "طول"}، "args": [قائمة]}، "right": {"kind": "Number"، "value": ١}}
    متغير أول = {"kind": "VarDecl"، "name": ع["varName"]، "expr": {"kind": "Index"، "obj": قائمة، "index": فهرس}}
    _جملة_من_إلى({"kind": "For"، "varName": "@forin_i_" + ن، "start": {"kind": "Number"، "value": ٠}، "end": آخر، "step": لاشيء،
        "body": {"kind": "Block"، "statements": [أول] + ع["body"]["statements"]}})
}

دالة _جملة_ارجع(ع) {
    إذا (داخل_أخيرًا > ٠) { أطلق_خطأ("لا يُكتب ارجع داخل كتلة «أخيرًا» لأنها تعمل في كل الأحوال") }
    إذا (ع["expr"] != لاشيء) {
        _تعبير(ع["expr"])
    } وإلا {
        _أصدر("CONST"، [_ثابت(لاشيء)])
    }
    إذا (طول(مكدّس_أخيرًا) > ٠) { _فكّ_أخيرًا(٠) }
    _أصدر("RETURN"، [])
}

دالة _جملة_توقف() {
    إذا (طول(حلقات) == ٠) { أطلق_خطأ("توقف مستخدمة خارج حلقة") }
    متغير ح = حلقات[طول(حلقات) - ١]
    إذا (داخل_أخيرًا > ح["inFinally"]) { أطلق_خطأ("لا يخرج توقف/أكمل من كتلة «أخيرًا» إلى حلقة خارجها") }
    _فكّ_أخيرًا(ح["tryDepth"])
    متغير عنوان = _أصدر("JUMP"، [-١])
    أضف(ح["breakAddrs"]، عنوان)
}

دالة _جملة_أكمل() {
    إذا (طول(حلقات) == ٠) { أطلق_خطأ("أكمل مستخدمة خارج حلقة") }
    متغير ح = حلقات[طول(حلقات) - ١]
    إذا (داخل_أخيرًا > ح["inFinally"]) { أطلق_خطأ("لا يخرج توقف/أكمل من كتلة «أخيرًا» إلى حلقة خارجها") }
    _فكّ_أخيرًا(ح["tryDepth"])
    متغير عنوان = _أصدر("JUMP"، [-١])
    أضف(ح["continueAddrs"]، عنوان)
}

دالة _كتلة_بنطاق(كتلة) {
    إذا (ليس _أعلى()) { أضف(_حالي()["scopes"]، {}) }
    من_أجل (ج في كتلة["statements"]) { _جملة(ج) }
    إذا (ليس _أعلى()) { انزع(_حالي()["scopes"]) }
}

# ---------- التعابير ----------
# يبحث عن الاسم في الدوال المحيطة (غير الرئيسي): يعيد {"up", "slot"} أو لاشيء
دالة _حلّ_أعلى(اسم) {
    متغير د = ١
    طالما (د < طول(مكدّس) - ١) {
        متغير نطاق = مكدّس[طول(مكدّس) - ١ - د]
        متغير خانة = _حلّ_اسم(نطاق، اسم)
        إذا (خانة != -١) { ارجع {"up": د، "slot": خانة} }
        د = د + ١
    }
    ارجع لاشيء
}

دالة _تعبير(ع) {
    متغير ك = ع["kind"]
    إذا (ك == "Number" أو ك == "String" أو ك == "Boolean") {
        _أصدر("CONST"، [_ثابت(ع["value"])])
    } وإلا إذا (ك == "Null") {
        _أصدر("CONST"، [_ثابت(لاشيء)])
    } وإلا إذا (ك == "ListLiteral") {
        من_أجل (ج في ع["elements"]) { _تعبير(ج) }
        _أصدر("MAKE_LIST"، [طول(ع["elements"])])
    } وإلا إذا (ك == "MapLiteral") {
        من_أجل (م في ع["entries"]) {
            _تعبير(م["key"])
            _تعبير(م["value"])
        }
        _أصدر("MAKE_MAP"، [طول(ع["entries"])])
    } وإلا إذا (ك == "Identifier") {
        _معرّف_تعبير(ع)
    } وإلا إذا (ك == "Assign") {
        _إسناد_تعبير(ع)
    } وإلا إذا (ك == "Index") {
        _تعبير(ع["obj"])
        _تعبير(ع["index"])
        _أصدر("INDEX_GET"، [])
    } وإلا إذا (ك == "UnaryOp") {
        _تعبير(ع["expr"])
        إذا (ع["op"] == "ليس") {
            _أصدر("NOT"، [])
        } وإلا إذا (ع["op"] == "-") {
            _أصدر("NEG"، [])
        }
    } وإلا إذا (ك == "BinOp") {
        _عملية_ثنائية(ع)
    } وإلا إذا (ك == "Call") {
        _تعبير(ع["callee"])
        من_أجل (ج في ع["args"]) { _تعبير(ج) }
        _أصدر("CALL"، [طول(ع["args"])])
    } وإلا إذا (ك == "FuncExpr") {
        متغير فهرس = _جسم_دالة("<مجهولة>"، ع["params"]، ع["body"]، _غير_متزامنة_عقدة(ع))
        _أصدر("BUILD_FUNCTION"، [فهرس])
    } وإلا إذا (ك == "Await") {
        إذا (ليس _أعلى() و ليس _قطعة()["isAsync"]) {
            أطلق_خطأ("انتظر لا تُكتب إلا داخل دالة غير_متزامنة أو في المستوى الأعلى من الملف")
        }
        _تعبير(ع["expr"])
        _أصدر("AWAIT"، [])
    } وإلا {
        أطلق_خطأ("لا يمكن تصريف التعبير: " + نص_برمجي(ك))
    }
}

دالة _معرّف_تعبير(ع) {
    إذا (ليس _أعلى()) {
        متغير خانة = _حلّ_اسم(_حالي()، ع["name"])
        إذا (خانة != -١) {
            _أصدر("GET_LOCAL"، [خانة])
            ارجع لاشيء
        }
        متغير أعلى = _حلّ_أعلى(ع["name"])
        إذا (أعلى != لاشيء) {
            _أصدر("GET_UP"، [أعلى["up"]، أعلى["slot"]])
            ارجع لاشيء
        }
    }
    _أصدر("GET_GLOBAL"، [ع["name"]])
}

دالة _إسناد_تعبير(ع) {
    إذا (ع["target"]["kind"] == "Identifier") {
        _تعبير(ع["expr"])
        إذا (ليس _أعلى()) {
            متغير خانة = _حلّ_اسم(_حالي()، ع["target"]["name"])
            إذا (خانة != -١) {
                _أصدر("SET_LOCAL"، [خانة])
                ارجع لاشيء
            }
            متغير أعلى = _حلّ_أعلى(ع["target"]["name"])
            إذا (أعلى != لاشيء) {
                _أصدر("SET_UP"، [أعلى["up"]، أعلى["slot"]])
                ارجع لاشيء
            }
        }
        _أصدر("SET_GLOBAL"، [ع["target"]["name"]])
    } وإلا إذا (ع["target"]["kind"] == "Index") {
        _تعبير(ع["expr"])
        _تعبير(ع["target"]["obj"])
        _تعبير(ع["target"]["index"])
        _أصدر("INDEX_SET"، [])
    }
}

متغير عمليات = {"PLUS": "ADD"، "MINUS": "SUB"، "STAR": "MUL"، "SLASH": "DIV"، "PERCENT": "MOD"، "EQ": "EQ"، "NEQ": "NEQ"، "LT": "LT"، "GT": "GT"، "LTE": "LTE"، "GTE": "GTE"}

دالة _عملية_ثنائية(ع) {
    إذا (ع["op"] == "و") {
        _تعبير(ع["left"])
        متغير قفزة_خطأ = _أصدر("JUMP_IF_FALSE"، [-١])
        _أصدر("POP"، [])
        _تعبير(ع["right"])
        _رقّع(قفزة_خطأ، [_هنا()])
        ارجع لاشيء
    }
    إذا (ع["op"] == "أو") {
        _تعبير(ع["left"])
        متغير قفزة_خطأ = _أصدر("JUMP_IF_FALSE"، [-١])
        متغير قفزة_النهاية = _أصدر("JUMP"، [-١])
        _رقّع(قفزة_خطأ، [_هنا()])
        _أصدر("POP"، [])
        _تعبير(ع["right"])
        _رقّع(قفزة_النهاية، [_هنا()])
        ارجع لاشيء
    }
    _تعبير(ع["left"])
    _تعبير(ع["right"])
    إذا (ليس يحوي(عمليات، ع["op"])) { أطلق_خطأ("عملية غير مدعومة في المُصرّف: " + نص_برمجي(ع["op"])) }
    _أصدر(عمليات[ع["op"]]، [])
}

# ---------- الواجهة ----------
# تعيد المخرج نفسه الذي تعيده compile في compiler.js. «سطر_بداية» اختياري لمحاكاة FunctionChunk.curLine الثابتة
صدّر دالة صرّف(برنامج) {
    دوال = []
    مكدّس = []
    حلقات = []
    داخل_أخيرًا = ٠
    مكدّس_أخيرًا = []
    عمق_حاول = ٠
    صادرات = []
    عدّاد_فور_إن = ٠
    سطر_حالي = لاشيء
    ارجع _صرّف_برنامج(برنامج)
}
