# أعداد عشرية بدقة كاملة في ضاد-نواة (الاستقلال ٦هـ): باقي القسمة، وتحويل العدد إلى أقصر نص مطابق لـ String(عدد) في JS.
# تعتمد على نواة-تشغيل.dhad (المخصِّص والنصوص) وعلى مدمجات f64. تُدمج معها عند التصريف.
# الأعداد الكبيرة (bignum): [عدد الأطراف][الطرف٠][الطرف١]… وكل طرف ١٦ بتًا في كلمة؛ السعة ١٦٠ طرفًا (٢٥٦٠ بتًا) تكفي كل عدد f64.

# ---------- الأعداد الكبيرة ----------
دالة ك_جديد() {
    متغير ب = خصّص(٤ + ١٦٠ * ٤)
    خزّن(ب، ٠)
    ارجع ب
}
دالة _ط(ب، ي) {
    إذا (ي < حمّل(ب)) { ارجع حمّل(ب + ٤ + ي * ٤) }
    ارجع ٠
}
دالة ك_قصّ(ب) {
    متغير ن = حمّل(ب)
    طالما (ن > ٠ و حمّل(ب + ٤ + (ن - ١) * ٤) == ٠) { ن = ن - ١ }
    خزّن(ب، ن)
}
دالة ك_انسخ(د، أ) {
    متغير ن = حمّل(أ)
    من_أجل (ي من ٠ إلى ن - ١) { خزّن(د + ٤ + ي * ٤، حمّل(أ + ٤ + ي * ٤)) }
    خزّن(د، ن)
}
دالة ك_صغير(ب، ع) {
    خزّن(ب، ٠)
    إذا (ع > ٠) {
        خزّن(ب + ٤، ع)
        خزّن(ب، ١)
    }
}
دالة ك_ضرب_صغير(ب، م) {
    متغير ن = حمّل(ب)
    متغير ح = ٠
    من_أجل (ي من ٠ إلى ن - ١) {
        متغير ق = حمّل(ب + ٤ + ي * ٤) * م + ح
        خزّن(ب + ٤ + ي * ٤، بتّ_و(ق، ٦٥٥٣٥))
        ح = يمين_موجب(ق، ١٦)
    }
    إذا (ح > ٠) {
        خزّن(ب + ٤ + ن * ٤، ح)
        خزّن(ب، ن + ١)
    }
}
دالة ك_ضرب_أس٢(ب، ع) {
    متغير ن = ع
    طالما (ن >= ١٤) {
        ك_ضرب_صغير(ب، ١٦٣٨٤)
        ن = ن - ١٤
    }
    إذا (ن > ٠) { ك_ضرب_صغير(ب، يسار(١، ن)) }
}
دالة ك_ضرب_أس١٠(ب، ع) {
    متغير ن = ع
    طالما (ن >= ٤) {
        ك_ضرب_صغير(ب، ١٠٠٠٠)
        ن = ن - ٤
    }
    طالما (ن > ٠) {
        ك_ضرب_صغير(ب، ١٠)
        ن = ن - ١
    }
}
دالة ك_قارن(أ، ب) {
    متغير نأ = حمّل(أ)
    متغير نب = حمّل(ب)
    إذا (نأ != نب) {
        إذا (نأ < نب) { ارجع -١ }
        ارجع ١
    }
    متغير ي = نأ - ١
    طالما (ي >= ٠) {
        متغير س = حمّل(أ + ٤ + ي * ٤)
        متغير ص = حمّل(ب + ٤ + ي * ٤)
        إذا (س != ص) {
            إذا (س < ص) { ارجع -١ }
            ارجع ١
        }
        ي = ي - ١
    }
    ارجع ٠
}
# أ += ب
دالة ك_أضف(أ، ب) {
    متغير نأ = حمّل(أ)
    متغير نب = حمّل(ب)
    متغير ن = نأ
    إذا (نب > ن) { ن = نب }
    متغير ح = ٠
    من_أجل (ي من ٠ إلى ن - ١) {
        متغير ق = _ط(أ، ي) + _ط(ب، ي) + ح
        خزّن(أ + ٤ + ي * ٤، بتّ_و(ق، ٦٥٥٣٥))
        ح = يمين_موجب(ق، ١٦)
    }
    إذا (ح > ٠) {
        خزّن(أ + ٤ + ن * ٤، ح)
        ن = ن + ١
    }
    خزّن(أ، ن)
}
# أ -= ب (بشرط أ ≥ ب)
دالة ك_اطرح(أ، ب) {
    متغير ن = حمّل(أ)
    متغير ح = ٠
    من_أجل (ي من ٠ إلى ن - ١) {
        متغير ق = حمّل(أ + ٤ + ي * ٤) - _ط(ب، ي) - ح
        إذا (ق < ٠) {
            ق = ق + ٦٥٥٣٦
            ح = ١
        } وإلا {
            ح = ٠
        }
        خزّن(أ + ٤ + ي * ٤، ق)
    }
    ك_قصّ(أ)
}

# ---------- باقي القسمة العشرية (مطابق لـ % في JS) ----------
# العناوين ٦٤…١٢٧ مناطق عمل ثابتة (قاعدة المخصِّص ٢٠٤٨٠ ومكدّس الجذور من ١٠٢٤ فلا تتداخل)
# الخوارزمية دقيقة (لا تقريب): نطرح مضاعفات t = |ب|·٢^ك من الأكبر إلى الأصغر؛ الطرح والتنصيف تامّان في IEEE.
دالة ف٦٤_باقي(د، أ، ب) {
    ف٦٤_من_صحيح(٦٤، ٠)
    ف٦٤_من_صحيح(٩٦، ٢)
    ف٦٤_من_صحيح(١١٢، ١)
    ف٦٤_قسمة(١١٢، ١١٢، ٩٦)
    # NaN أو قاسم صفر ⇒ NaN
    إذا (ف٦٤_لا_يساوي(أ، أ) أو ف٦٤_لا_يساوي(ب، ب) أو ف٦٤_يساوي(ب، ٦٤)) {
        ف٦٤_قسمة(د، ٦٤، ٦٤)
        ارجع ٠
    }
    # أ لانهائي (أ - أ = NaN) ⇒ NaN
    ف٦٤_طرح(٧٢، أ، أ)
    إذا (ف٦٤_لا_يساوي(٧٢، ٧٢)) {
        ف٦٤_قسمة(د، ٦٤، ٦٤)
        ارجع ٠
    }
    ف٦٤_مطلق(٨٠، أ)
    ف٦٤_مطلق(٨٨، ب)
    # ب لانهائي ⇒ أ
    ف٦٤_طرح(٧٢، ٨٨، ٨٨)
    إذا (ف٦٤_لا_يساوي(٧٢، ٧٢)) {
        ف٦٤_نسخ(د، أ)
        ارجع ٠
    }
    ف٦٤_نسخ(١٢٠، ٨٨)
    متغير ك = ٠
    ف٦٤_ضرب(٧٢، ٨٨، ٩٦)
    طالما (ف٦٤_أصغر_أو_يساوي(٧٢، ٨٠)) {
        ف٦٤_نسخ(٨٨، ٧٢)
        ف٦٤_ضرب(٧٢، ٨٨، ٩٦)
        ك = ك + ١
    }
    من_أجل (ي من ٠ إلى ك) {
        إذا (ف٦٤_أكبر_أو_يساوي(٨٠، ٨٨)) { ف٦٤_طرح(٨٠، ٨٠، ٨٨) }
        ف٦٤_ضرب(٨٨، ٨٨، ١١٢)
    }
    إذا (ف٦٤_يساوي(أ، ٦٤)) {
        ف٦٤_نسخ(د، أ)
    } وإلا إذا (ف٦٤_أصغر(أ، ٦٤)) {
        ف٦٤_سالب(د، ٨٠)
    } وإلا {
        ف٦٤_نسخ(د، ٨٠)
    }
    ارجع ٠
}

# ---------- العدد → أقصر نص (Steele-White/Dragon4 بأعداد كبيرة؛ يطابق String(عدد) في JS) ----------
متغير _ب_نص = ٠
متغير _ط_نص = ٠
دالة _ب_أضف(ب) {
    خزّن_بايت(_ب_نص + _ط_نص، ب)
    _ط_نص = _ط_نص + ١
}
دالة _ب_أصفار(ن) { من_أجل (ي من ١ إلى ن) { _ب_أضف(٤٨) } }

# مقام الرقم: r/s = القيمة، و m+ وm- نصف الفجوتين. يرجع مؤشر النص الناتج.
دالة عدد_إلى_نص(ص) {
    متغير منخفض = حمّل(ص)
    متغير مرتفع = حمّل(ص + ٤)
    متغير أُسّ = بتّ_و(يمين_موجب(مرتفع، ٢٠)، ٢٠٤٧)
    متغير علوي = بتّ_و(مرتفع، ١٠٤٨٥٧٥)
    متغير سالب = يمين_موجب(مرتفع، ٣١)
    ف٦٤_من_صحيح(٦٤، ٠)
    إذا (أُسّ == ٢٠٤٧) {
        إذا (علوي != ٠ أو منخفض != ٠) {
            متغير ر٣ = نص_جديد(٣)
            نص_ضع_بايت(ر٣، ٠، ٧٨)
            نص_ضع_بايت(ر٣، ١، ٩٧)
            نص_ضع_بايت(ر٣، ٢، ٧٨)
            ارجع ر٣
        }
        متغير ب٠ = ٠
        إذا (سالب == ١) { ب٠ = ١ }
        متغير ر٨ = نص_جديد(٨ + ب٠)
        إذا (سالب == ١) { نص_ضع_بايت(ر٨، ٠، ٤٥) }
        نص_ضع_بايت(ر٨، ب٠، ٧٣)
        نص_ضع_بايت(ر٨، ب٠ + ١، ١١٠)
        نص_ضع_بايت(ر٨، ب٠ + ٢، ١٠٢)
        نص_ضع_بايت(ر٨، ب٠ + ٣، ١٠٥)
        نص_ضع_بايت(ر٨، ب٠ + ٤، ١١٠)
        نص_ضع_بايت(ر٨، ب٠ + ٥، ١٠٥)
        نص_ضع_بايت(ر٨، ب٠ + ٦، ١١٦)
        نص_ضع_بايت(ر٨، ب٠ + ٧، ١٢١)
        ارجع ر٨
    }
    إذا (أُسّ == ٠ و علوي == ٠ و منخفض == ٠) {
        متغير ر١ = نص_جديد(١)
        نص_ضع_بايت(ر١، ٠، ٤٨)
        ارجع ر١
    }
    # f (٥٣ بتًا) وe
    متغير ر = ك_جديد()
    متغير م_زائد = ك_جديد()
    متغير م_ناقص = ك_جديد()
    متغير س = ك_جديد()
    متغير ف = ك_جديد()
    متغير ضمني = ١
    إذا (أُسّ == ٠) { ضمني = ٠ }
    خزّن(ف + ٤، بتّ_و(منخفض، ٦٥٥٣٥))
    خزّن(ف + ٨، يمين_موجب(منخفض، ١٦))
    خزّن(ف + ١٢، بتّ_و(علوي، ٦٥٥٣٥))
    خزّن(ف + ١٦، يمين_موجب(علوي، ١٦) + ضمني * ١٦)
    خزّن(ف، ٤)
    ك_قصّ(ف)
    متغير e = أُسّ - ١٠٧٥
    إذا (أُسّ == ٠) { e = -١٠٧٤ }
    متغير زوجي = ١ - بتّ_و(منخفض، ١)
    متغير حدّي = ٠
    إذا (علوي == ٠ و منخفض == ٠ و أُسّ > ١) { حدّي = ١ }
    ك_انسخ(ر، ف)
    ك_انسخ(م_ناقص، ف)
    ك_صغير(م_زائد، ١)
    ك_صغير(م_ناقص، ١)
    ك_صغير(س، ١)
    إذا (e >= ٠) {
        ك_ضرب_أس٢(ر، e + ١)
        ك_صغير(س، ٢)
        ك_ضرب_أس٢(م_زائد، e)
        ك_انسخ(م_ناقص، م_زائد)
        إذا (حدّي == ١) {
            ك_ضرب_صغير(ر، ٢)
            ك_ضرب_صغير(س، ٢)
            ك_ضرب_صغير(م_زائد، ٢)
        } وإلا {
        }
    } وإلا {
        ك_ضرب_أس٢(ر، ١)
        ك_صغير(س، ١)
        ك_ضرب_أس٢(س، ١ - e)
        إذا (حدّي == ١) {
            ك_ضرب_صغير(ر، ٢)
            ك_ضرب_صغير(س، ٢)
            ك_صغير(م_زائد، ٢)
            ك_صغير(م_ناقص، ١)
        } وإلا {
            ك_صغير(م_زائد، ١)
            ك_صغير(م_ناقص، ١)
        }
    }
    # تقدير ك = floor(log10 القيمة) بالأس الثنائي
    متغير بتّات_ف = ٥٣
    إذا (أُسّ == ٠) { بتّات_ف = ٥٢ }
    متغير ثنائي = e + بتّات_ف - ١
    متغير ك = (ثنائي * ١٢٣٣) / ٤٠٩٦
    إذا (ثنائي < ٠ و (ثنائي * ١٢٣٣) % ٤٠٩٦ != ٠) { ك = ك - ١ }
    إذا (ك >= ٠) {
        ك_ضرب_أس١٠(س، ك)
    } وإلا {
        ك_ضرب_أس١٠(ر، -ك)
        ك_ضرب_أس١٠(م_زائد، -ك)
        ك_ضرب_أس١٠(م_ناقص، -ك)
    }
    # ضبط ك: (ر + م+) ≥ س (أو > إن كان فرديًا) ⇒ نرفع ك
    متغير مؤقت = ك_جديد()
    ك_انسخ(مؤقت، ر)
    ك_أضف(مؤقت، م_زائد)
    متغير مقارنة = ك_قارن(مؤقت، س)
    طالما (مقارنة > ٠ أو (مقارنة == ٠ و زوجي == ١)) {
        ك_ضرب_صغير(س، ١٠)
        ك = ك + ١
        ك_انسخ(مؤقت، ر)
        ك_أضف(مؤقت، م_زائد)
        مقارنة = ك_قارن(مؤقت، س)
    }
    # نضمن أن (ر + م+)·١٠ ≥ س وإلا نضرب ونخفض ك
    ك_انسخ(مؤقت، ر)
    ك_أضف(مؤقت، م_زائد)
    ك_ضرب_صغير(مؤقت، ١٠)
    مقارنة = ك_قارن(مؤقت، س)
    طالما (مقارنة < ٠ أو (مقارنة == ٠ و زوجي == ٠)) {
        ك_ضرب_صغير(ر، ١٠)
        ك_ضرب_صغير(م_زائد، ١٠)
        ك_ضرب_صغير(م_ناقص، ١٠)
        ك = ك - ١
        ك_انسخ(مؤقت، ر)
        ك_أضف(مؤقت، م_زائد)
        ك_ضرب_صغير(مؤقت، ١٠)
        مقارنة = ك_قارن(مؤقت، س)
    }
    # توليد الأرقام
    متغير أرقام = خصّص(٣٢)
    متغير ن = ٠
    متغير تابع = صحيح
    طالما (تابع) {
        ك_ضرب_صغير(ر، ١٠)
        ك_ضرب_صغير(م_زائد، ١٠)
        ك_ضرب_صغير(م_ناقص، ١٠)
        متغير رقم = ٠
        طالما (ك_قارن(ر، س) >= ٠) {
            ك_اطرح(ر، س)
            رقم = رقم + ١
        }
        متغير قارن١ = ك_قارن(ر، م_ناقص)
        متغير ت١ = قارن١ < ٠ أو (قارن١ == ٠ و زوجي == ١)
        ك_انسخ(مؤقت، ر)
        ك_أضف(مؤقت، م_زائد)
        متغير قارن٢ = ك_قارن(مؤقت، س)
        متغير ت٢ = قارن٢ > ٠ أو (قارن٢ == ٠ و زوجي == ١)
        إذا (ليس ت١ و ليس ت٢) {
            خزّن_بايت(أرقام + ن، ٤٨ + رقم)
            ن = ن + ١
        } وإلا {
            إذا (ت١ و ليس ت٢) {
                خزّن_بايت(أرقام + ن، ٤٨ + رقم)
            } وإلا إذا (ت٢ و ليس ت١) {
                خزّن_بايت(أرقام + ن، ٤٩ + رقم)
            } وإلا {
                ك_ضرب_صغير(ر، ٢)
                متغير ق = ك_قارن(ر، س)
                إذا (ق < ٠ أو (ق == ٠ و بتّ_و(رقم، ١) == ٠)) {
                    خزّن_بايت(أرقام + ن، ٤٨ + رقم)
                } وإلا {
                    خزّن_بايت(أرقام + ن، ٤٩ + رقم)
                }
            }
            ن = ن + ١
            تابع = خطأ
        }
    }
    # الصياغة كما في JS (n = ك)
    _ب_نص = خصّص(١٠٠)
    _ط_نص = ٠
    إذا (سالب == ١) { _ب_أضف(٤٥) }
    إذا (ن <= ك و ك <= ٢١) {
        من_أجل (ي من ٠ إلى ن - ١) { _ب_أضف(حمّل_بايت(أرقام + ي)) }
        _ب_أصفار(ك - ن)
    } وإلا إذا (ك > ٠ و ك <= ٢١) {
        من_أجل (ي من ٠ إلى ك - ١) { _ب_أضف(حمّل_بايت(أرقام + ي)) }
        _ب_أضف(٤٦)
        من_أجل (ي من ك إلى ن - ١) { _ب_أضف(حمّل_بايت(أرقام + ي)) }
    } وإلا إذا (ك > -٦ و ك <= ٠) {
        _ب_أضف(٤٨)
        _ب_أضف(٤٦)
        _ب_أصفار(-ك)
        من_أجل (ي من ٠ إلى ن - ١) { _ب_أضف(حمّل_بايت(أرقام + ي)) }
    } وإلا {
        _ب_أضف(حمّل_بايت(أرقام))
        إذا (ن > ١) {
            _ب_أضف(٤٦)
            من_أجل (ي من ١ إلى ن - ١) { _ب_أضف(حمّل_بايت(أرقام + ي)) }
        }
        _ب_أضف(١٠١)
        متغير أس = ك - ١
        إذا (أس < ٠) {
            _ب_أضف(٤٥)
            أس = -أس
        } وإلا {
            _ب_أضف(٤٣)
        }
        متغير نص_الأس = نص_من_عدد(أس)
        من_أجل (ي من ٠ إلى حمّل(نص_الأس) - ١) { _ب_أضف(حمّل_بايت(نص_الأس + ٤ + ي)) }
    }
    متغير نتيجة = نص_جديد(_ط_نص)
    انسخ(_ب_نص، نتيجة + ٤، _ط_نص)
    حرّر(_ب_نص)
    حرّر(أرقام)
    ارجع نتيجة
}

# ---------- النص → عدد (strtod دقيق بالتقريب إلى الأقرب والتعادل إلى الزوجي) ----------
# الصياغة: [+-] أرقام [. أرقام] [e|E [+-] أرقام] أو [+-]Infinity؛ وإلا يرجع ٠ (فشل). عند النجاح يكتب في الصندوق د ويرجع ١.
# حدّ معلوم: يُحتفظ بأول ٤٠٠ رقم معنوي فقط (ما بعدها يُهمل)، وقد يؤثر ذلك على تعادلات اصطناعية بأكثر من ٤٠٠ رقم.
دالة ك_طول_بتّات(ب) {
    متغير ن = حمّل(ب)
    إذا (ن == ٠) { ارجع ٠ }
    متغير أعلى = حمّل(ب + ٤ + (ن - ١) * ٤)
    متغير ع = ٠
    طالما (أعلى > ٠) {
        ع = ع + ١
        أعلى = يمين_موجب(أعلى، ١)
    }
    ارجع (ن - ١) * ١٦ + ع
}
دالة _اكتب_ف٦٤(د، سالب، أُسّ، ذيل_منخفض، ذيل_عالٍ) {
    خزّن(د، ذيل_منخفض)
    خزّن(د + ٤، ذيل_عالٍ + يسار(أُسّ، ٢٠) + يسار(سالب، ٣١))
}
دالة نص_إلى_عدد(ن، د) {
    متغير طول_ن = حمّل(ن)
    متغير ي = ٠
    متغير سالب = ٠
    إذا (ي < طول_ن) {
        متغير ب = حمّل_بايت(ن + ٤ + ي)
        إذا (ب == ٤٥) { سالب = ١
            ي = ي + ١ } وإلا إذا (ب == ٤٣) { ي = ي + ١ }
    }
    # Infinity
    إذا (طول_ن - ي == ٨ و حمّل_بايت(ن + ٤ + ي) == ٧٣ و حمّل_بايت(ن + ٤ + ي + ١) == ١١٠ و حمّل_بايت(ن + ٤ + ي + ٧) == ١٢١) {
        _اكتب_ف٦٤(د، سالب، ٢٠٤٧، ٠، ٠)
        ارجع ١
    }
    متغير ك_ق = ك_جديد()
    متغير أرقام_معنوية = ٠
    متغير أرقام_كلية = ٠
    متغير أس١٠ = ٠
    متغير بعد_النقطة = ٠
    متغير رأينا_رقمًا = ٠
    متغير مستمر = صحيح
    طالما (مستمر و ي < طول_ن) {
        متغير ب = حمّل_بايت(ن + ٤ + ي)
        إذا (ب >= ٤٨ و ب <= ٥٧) {
            رأينا_رقمًا = ١
            متغير رقم = ب - ٤٨
            إذا (أرقام_معنوية > ٠ أو رقم > ٠) {
                إذا (أرقام_معنوية < ٤٠٠) {
                    ك_ضرب_صغير(ك_ق، ١٠)
                    إذا (رقم > ٠) {
                        متغير صغير = ك_جديد()
                        ك_صغير(صغير، رقم)
                        ك_أضف(ك_ق، صغير)
                        حرّر(صغير)
                    }
                    أرقام_معنوية = أرقام_معنوية + ١
                    إذا (بعد_النقطة == ١) { أس١٠ = أس١٠ - ١ }
                } وإلا {
                    إذا (بعد_النقطة == ٠) { أس١٠ = أس١٠ + ١ }
                }
            } وإلا {
                إذا (بعد_النقطة == ١) { أس١٠ = أس١٠ - ١ }
            }
            ي = ي + ١
        } وإلا إذا (ب == ٤٦ و بعد_النقطة == ٠) {
            بعد_النقطة = ١
            ي = ي + ١
        } وإلا {
            مستمر = خطأ
        }
    }
    إذا (رأينا_رقمًا == ٠) { ارجع ٠ }
    إذا (ي < طول_ن) {
        متغير ب = حمّل_بايت(ن + ٤ + ي)
        إذا (ب != ١٠١ و ب != ٦٩) { ارجع ٠ }
        ي = ي + ١
        متغير سالب_أس = ٠
        إذا (ي < طول_ن) {
            متغير ج = حمّل_بايت(ن + ٤ + ي)
            إذا (ج == ٤٥) { سالب_أس = ١
                ي = ي + ١ } وإلا إذا (ج == ٤٣) { ي = ي + ١ }
        }
        متغير أرقام_الأس = ٠
        متغير قيمة_الأس = ٠
        طالما (ي < طول_ن) {
            متغير ج = حمّل_بايت(ن + ٤ + ي)
            إذا (ج < ٤٨ أو ج > ٥٧) { ارجع ٠ }
            إذا (قيمة_الأس < ١٠٠٠٠) { قيمة_الأس = قيمة_الأس * ١٠ + ج - ٤٨ }
            أرقام_الأس = أرقام_الأس + ١
            ي = ي + ١
        }
        إذا (أرقام_الأس == ٠) { ارجع ٠ }
        إذا (سالب_أس == ١) { أس١٠ = أس١٠ - قيمة_الأس } وإلا { أس١٠ = أس١٠ + قيمة_الأس }
    }
    # الصفر
    إذا (حمّل(ك_ق) == ٠) {
        _اكتب_ف٦٤(د، سالب، ٠، ٠، ٠)
        ارجع ١
    }
    # خارج المدى فورًا
    متغير حجم_رقمي = أرقام_معنوية + أس١٠
    إذا (حجم_رقمي > ٣١٠) {
        _اكتب_ف٦٤(د، سالب، ٢٠٤٧، ٠، ٠)
        ارجع ١
    }
    إذا (حجم_رقمي < -٣٢٦) {
        _اكتب_ف٦٤(د، سالب، ٠، ٠، ٠)
        ارجع ١
    }
    متغير ب_ن = ك_ق
    متغير ب_د = ك_جديد()
    ك_صغير(ب_د، ١)
    إذا (أس١٠ >= ٠) { ك_ضرب_أس١٠(ب_ن، أس١٠) } وإلا { ك_ضرب_أس١٠(ب_د، -أس١٠) }
    # نُدخل النسبة في [١، ٢): ب_ن / ب_د ÷ ٢^e٢
    متغير e٢ = ك_طول_بتّات(ب_ن) - ك_طول_بتّات(ب_د)
    إذا (e٢ >= ٠) { ك_ضرب_أس٢(ب_د، e٢) } وإلا { ك_ضرب_أس٢(ب_ن، -e٢) }
    إذا (ك_قارن(ب_ن، ب_د) < ٠) {
        ك_ضرب_صغير(ب_ن، ٢)
        e٢ = e٢ - ١
    }
    إذا (e٢ > ١٠٢٣) {
        _اكتب_ف٦٤(د، سالب، ٢٠٤٧، ٠، ٠)
        ارجع ١
    }
    متغير عدد_البتّات = ٥٣
    إذا (e٢ < -١٠٢٢) { عدد_البتّات = e٢ + ١٠٧٥ }
    إذا (عدد_البتّات < ٠) {
        _اكتب_ف٦٤(د، سالب، ٠، ٠، ٠)
        ارجع ١
    }
    متغير ك_م = ك_جديد()
    من_أجل (ب من ١ إلى عدد_البتّات) {
        ك_ضرب_صغير(ك_م، ٢)
        إذا (ك_قارن(ب_ن، ب_د) >= ٠) {
            ك_اطرح(ب_ن، ب_د)
            متغير واحد = ك_جديد()
            ك_صغير(واحد، ١)
            ك_أضف(ك_م، واحد)
            حرّر(واحد)
        }
        ك_ضرب_صغير(ب_ن، ٢)
    }
    # بعد الحلقة: ب_ن/ب_د ∈ [٠، ٢) — نقارنه بالواحد للتقريب
    متغير ق = ك_قارن(ب_ن، ب_د)
    متغير فردي = بتّ_و(_ط(ك_م، ٠)، ١)
    إذا (ق > ٠ أو (ق == ٠ و فردي == ١)) {
        متغير واحد٢ = ك_جديد()
        ك_صغير(واحد٢، ١)
        ك_أضف(ك_م، واحد٢)
        حرّر(واحد٢)
    }
    متغير أس_الحقل = ٠
    إذا (عدد_البتّات == ٥٣) { أس_الحقل = e٢ + ١٠٢٢ }
    متغير ذيل_منخفض = _ط(ك_م، ٠) + يسار(_ط(ك_م، ١)، ١٦)
    متغير ذيل_عالٍ = _ط(ك_م، ٢) + يسار(_ط(ك_م، ٣)، ١٦)
    # الحقل الأسّي قد يتجاوز بالحمل (m = 2^53) فنجمعه رقميًا
    متغير حقل_كلي = أس_الحقل + يمين_موجب(ذيل_عالٍ، ٢٠)
    إذا (حقل_كلي >= ٢٠٤٧) {
        _اكتب_ف٦٤(د، سالب، ٢٠٤٧، ٠، ٠)
        ارجع ١
    }
    _اكتب_ف٦٤(د، سالب، أس_الحقل، ذيل_منخفض، ذيل_عالٍ)
    ارجع ١
}
