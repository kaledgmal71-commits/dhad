# نواة الآلة الافتراضية لضاد مكتوبةً بضاد (الاستقلال، المرحلة ٦، نموذج أول).
# تنفّذ بايتكود المترجم المكتوب بضاد (selfhost/مترجم.dhad) مباشرة، فتصير السلسلة كلها بضاد: مرمز ← محلل ← مترجم ← آلة.
# القيم هي قيم ضاد نفسها (قوائم وخرائط ونصوص وأرقام)، فعمليات الجمع والمقارنة والفهرسة تُفوَّض إلى الآلة المضيفة بالدلالات والرسائل نفسها.
# ما ليس مدعومًا بعد (يُعلَن خطأً صريحًا): غير_متزامنة/انتظر، الاستيراد، الدوال المعادة من المكتبات الجاهزة التي تستدعي دوال المستخدم.
# الاستعمال: متغير آ = استورد("آلة")؛ آ.شغّل(برنامج_المترجم، خريطة_المدمجات)

متغير مكدّس = []
متغير إطارات = []
متغير معالجات = []
متغير عالمية = لاشيء
متغير خطوات = ٠
متغير حد_الخطوات = ١٥٠٠٠٠٠٠٠٠
# غير المتزامن: المهام والوعود وطابور المهام الصغيرة والمؤقتات بزمن افتراضي (كما في الآلة الأصلية)
متغير مهام_صغيرة = []
متغير مؤقتات = []
متغير الآن = ٠
متغير تسلسل_المؤقتات = ٠
متغير مرفوضة = []
متغير أصلي_اطبع = لاشيء
متغير أصلي_نص = لاشيء
متغير أصلي_نوع = لاشيء
متغير مهمة_حالية = لاشيء
متغير عمق_تزامن = ٠
متغير عمق_المهام = ٠
متغير إطار_حالي = لاشيء
متغير تعليمة_حالية = لاشيء

دالة _إطار_جديد(قطعة، محليات، بيئة_أب) {
    ارجع {"chunk": قطعة، "ip": ٠، "locals": محليات، "env": {"locals": محليات، "parent": بيئة_أب}}
}

دالة _محليات_فارغة(ن) {
    متغير م = []
    من_أجل (ي من ١ إلى ن) { أضف(م، لاشيء) }
    ارجع م
}

# يستدعي دالة مدمجة (من المضيف) بعدد وسائط ثابت
دالة _استدعِ_مدمجة(د، وس) {
    متغير ن = طول(وس)
    إذا (ن == ٠) { ارجع د() }
    إذا (ن == ١) { ارجع د(وس[٠]) }
    إذا (ن == ٢) { ارجع د(وس[٠]، وس[١]) }
    إذا (ن == ٣) { ارجع د(وس[٠]، وس[١]، وس[٢]) }
    إذا (ن == ٤) { ارجع د(وس[٠]، وس[١]، وس[٢]، وس[٣]) }
    إذا (ن == ٥) { ارجع د(وس[٠]، وس[١]، وس[٢]، وس[٣]، وس[٤]) }
    إذا (ن == ٦) { ارجع د(وس[٠]، وس[١]، وس[٢]، وس[٣]، وس[٤]، وس[٥]) }
    أطلق_خطأ("استدعاء مدمجة بأكثر من ٦ وسائط غير مدعوم في الآلة المكتوبة بضاد بعد")
}

دالة _اقطع_المكدّس(ن) {
    طالما (طول(مكدّس) > ن) { انزع(مكدّس) }
}

دالة _أخرج_وسائط(ن) {
    متغير وس = مكدّس[طول(مكدّس) - ن:]
    _اقطع_المكدّس(طول(مكدّس) - ن)
    ارجع وس
}

دالة _بيئة_أعلى(إطار، ن) {
    متغير ب = إطار["env"]
    من_أجل (ك من ١ إلى ن) { ب = ب["parent"] }
    ارجع ب
}

# ينفّذ حتى ينتهي البرنامج أو يخرج خطأ إلى حدود الحلقة الخارجية
دالة _نفّذ_حتى_النهاية(قاعدة) {
    طالما (طول(إطارات) > قاعدة) {
        متغير إ = إطارات[طول(إطارات) - ١]
        متغير شيفرة = إ["chunk"]["code"]
        إذا (إ["ip"] >= طول(شيفرة)) {
            انزع(إطارات)
            أضف(مكدّس، لاشيء)
        } وإلا {
            متغير ت = شيفرة[إ["ip"]]
            إطار_حالي = إ
            تعليمة_حالية = ت
            إ["ip"] = إ["ip"] + ١
            خطوات = خطوات + ١
            إذا (خطوات > حد_الخطوات) {
                أطلق_خطأ("استغرق البرنامج وقتًا طويلًا فأوقفته. تحقّق من حلقة لا تنتهي أو من حساب ثقيل")
            }
            _نفّذ_تعليمة(إ، ت["op"]، ت["args"])
        }
    }
}

دالة _نفّذ_تعليمة(إ، ع، وس) {
    إذا (ع == "GET_LOCAL") {
        أضف(مكدّس، إ["locals"][وس[٠]])
    } وإلا إذا (ع == "CONST") {
        أضف(مكدّس، إ["chunk"]["constants"][وس[٠]])
    } وإلا إذا (ع == "SET_LOCAL") {
        إ["locals"][وس[٠]] = مكدّس[طول(مكدّس) - ١]
    } وإلا إذا (ع == "POP") {
        انزع(مكدّس)
    } وإلا إذا (ع == "GET_GLOBAL") {
        إذا (ليس يحوي(عالمية، وس[٠])) { أطلق_خطأ("متغير غير معرّف: " + وس[٠] + _تلميح(وس[٠])) }
        أضف(مكدّس، عالمية[وس[٠]])
    } وإلا إذا (ع == "JUMP") {
        إ["ip"] = وس[٠]
    } وإلا إذا (ع == "JUMP_IF_FALSE") {
        إذا (ليس مكدّس[طول(مكدّس) - ١]) { إ["ip"] = وس[٠] }
    } وإلا إذا (ع == "ADD") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        أضف(مكدّس، أ + ب)
    } وإلا إذا (ع == "SUB") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        _ثنائي_رقمي("-"، أ، ب)
        أضف(مكدّس، أ - ب)
    } وإلا إذا (ع == "MUL") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        _ثنائي_رقمي("*"، أ، ب)
        أضف(مكدّس، أ * ب)
    } وإلا إذا (ع == "DIV") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        _ثنائي_رقمي("/"، أ، ب)
        أضف(مكدّس، أ / ب)
    } وإلا إذا (ع == "MOD") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        _ثنائي_رقمي("%"، أ، ب)
        أضف(مكدّس، أ % ب)
    } وإلا إذا (ع == "NEG") {
        أضف(مكدّس، -انزع(مكدّس))
    } وإلا إذا (ع == "NOT") {
        أضف(مكدّس، ليس انزع(مكدّس))
    } وإلا إذا (ع == "EQ") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        أضف(مكدّس، أ == ب)
    } وإلا إذا (ع == "NEQ") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        أضف(مكدّس، أ != ب)
    } وإلا إذا (ع == "LT") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        أضف(مكدّس، أ < ب)
    } وإلا إذا (ع == "GT") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        أضف(مكدّس، أ > ب)
    } وإلا إذا (ع == "LTE") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        أضف(مكدّس، أ <= ب)
    } وإلا إذا (ع == "GTE") {
        متغير ب = انزع(مكدّس)
        متغير أ = انزع(مكدّس)
        أضف(مكدّس، أ >= ب)
    } وإلا إذا (ع == "CALL") {
        _استدعاء(وس[٠])
    } وإلا إذا (ع == "RETURN") {
        متغير ق = انزع(مكدّس)
        انزع(إطارات)
        أضف(مكدّس، ق)
    } وإلا إذا (ع == "INDEX_GET") {
        متغير فهرس = انزع(مكدّس)
        متغير هدف = انزع(مكدّس)
        أضف(مكدّس، هدف[فهرس])
    } وإلا إذا (ع == "INDEX_SET") {
        متغير فهرس = انزع(مكدّس)
        متغير هدف = انزع(مكدّس)
        متغير قيمة = انزع(مكدّس)
        هدف[فهرس] = قيمة
        أضف(مكدّس، قيمة)
    } وإلا إذا (ع == "MAKE_LIST") {
        أضف(مكدّس، _أخرج_وسائط(وس[٠]))
    } وإلا إذا (ع == "MAKE_MAP") {
        متغير مسطّح = _أخرج_وسائط(٢ * وس[٠])
        متغير خ = {}
        متغير ي = ٠
        طالما (ي < طول(مسطّح)) {
            خ[مسطّح[ي]] = مسطّح[ي + ١]
            ي = ي + ٢
        }
        أضف(مكدّس، خ)
    } وإلا إذا (ع == "FOR_TEST") {
        متغير خطوة = انزع(مكدّس)
        متغير نهاية = انزع(مكدّس)
        متغير عدّاد = انزع(مكدّس)
        إذا (نوع(خطوة) != "رقم" أو نوع(نهاية) != "رقم" أو نوع(عدّاد) != "رقم") { أطلق_خطأ("حدود الحلقة (من، إلى، بخطوة) يجب أن تكون أرقامًا") }
        إذا (خطوة == ٠) { أطلق_خطأ("خطوة الحلقة لا يمكن أن تكون صفرًا") }
        إذا (خطوة > ٠) { أضف(مكدّس، عدّاد <= نهاية) } وإلا { أضف(مكدّس، عدّاد >= نهاية) }
    } وإلا إذا (ع == "DEFINE_GLOBAL") {
        عالمية[وس[٠]] = انزع(مكدّس)
    } وإلا إذا (ع == "SET_GLOBAL") {
        إذا (ليس يحوي(عالمية، وس[٠])) { أطلق_خطأ("المتغير «" + وس[٠] + "» غير معرّف — عرّفه أولًا بـ «متغير " + وس[٠] + " = …» (الإسناد لا ينشئ متغيرًا جديدًا)" + _تلميح(وس[٠])) }
        عالمية[وس[٠]] = مكدّس[طول(مكدّس) - ١]
    } وإلا إذا (ع == "SET_GLOBAL_NEW") {
        عالمية[وس[٠]] = مكدّس[طول(مكدّس) - ١]
    } وإلا إذا (ع == "GET_UP") {
        أضف(مكدّس، _بيئة_أعلى(إ، وس[٠])["locals"][وس[١]])
    } وإلا إذا (ع == "SET_UP") {
        _بيئة_أعلى(إ، وس[٠])["locals"][وس[١]] = مكدّس[طول(مكدّس) - ١]
    } وإلا إذا (ع == "ENTER_ENV") {
        إ["env"] = {"locals": _محليات_فارغة(وس[٠])، "parent": إ["env"]}
    } وإلا إذا (ع == "EXIT_ENV") {
        إ["env"] = إ["env"]["parent"]
    } وإلا إذا (ع == "BUILD_FUNCTION") {
        أضف(مكدّس، {"@دالة": صحيح، "chunk": دوال_البرنامج[وس[٠]]، "env": إ["env"]})
    } وإلا إذا (ع == "TRY_BEGIN") {
        أضف(معالجات، {"frame": إ، "env": إ["env"]، "depth": طول(إطارات)، "stackLen": طول(مكدّس)، "catchAddr": وس[٠]، "sync": عمق_تزامن})
    } وإلا إذا (ع == "TRY_END") {
        انزع(معالجات)
    } وإلا إذا (ع == "RETHROW") {
        متغير ق = انزع(مكدّس)
        أطلق_خطأ(ق)
    } وإلا إذا (ع == "AWAIT") {
        _انتظر()
    } وإلا إذا (ع == "HALT") {
        انزع(إطارات)
    } وإلا {
        أطلق_خطأ("تعليمة غير معروفة: " + ع)
    }
}

متغير دوال_البرنامج = []

# تسوية إملائية للتلميح «هل تقصد»: الهمزات والتاء المربوطة والألف المقصورة والتشكيل
دالة _سوّ(ك) {
    متغير ن = ""
    من_أجل (ح في ك) {
        متغير ر = رمز(ح)
        إذا (ر >= ١٦١١ و ر <= ١٦١٨) {
            ن = ن + ""
        } وإلا إذا (ح == "أ" أو ح == "إ" أو ح == "آ") {
            ن = ن + "ا"
        } وإلا إذا (ح == "ة") {
            ن = ن + "ه"
        } وإلا إذا (ح == "ى") {
            ن = ن + "ي"
        } وإلا {
            ن = ن + ح
        }
    }
    ارجع ن
}

دالة _تلميح(اسم) {
    متغير هدف = _سوّ(اسم)
    متغير بركة = []
    من_أجل (م في مفاتيح(عالمية)) { إذا (طول(نص_برمجي(م)) == ٠ أو نص_برمجي(م)[:١] != "@") { أضف(بركة، م) } }
    إذا (يحوي(عالمية، "@كلمات")) { بركة = بركة + عالمية["@كلمات"] }
    من_أجل (م في بركة) {
        إذا (م != اسم و _سوّ(م) == هدف) { ارجع " — هل تقصد «" + م + "»؟" }
    }
    ارجع ""
}

دالة _ثنائي_رقمي(عملية، أ، ب) {
    إذا (نوع(أ) != "رقم" أو نوع(ب) != "رقم") {
        أطلق_خطأ("العملية «" + عملية + "» تحتاج رقمين لكنها وجدت " + نوع(أ) + " و" + نوع(ب) + " — حوّل النص برقم بـ عدد()")
    }
    إذا ((عملية == "/" أو عملية == "%") و ب == ٠) { أطلق_خطأ("قسمة على صفر") }
}

دالة _استدعاء(ن) {
    متغير وس = _أخرج_وسائط(ن)
    متغير د = انزع(مكدّس)
    متغير ت = نوع(د)
    إذا (ت == "خريطة" و يحوي(د، "@دالة")) {
        متغير قطعة = د["chunk"]
        متغير م = _محليات_فارغة(قطعة["maxSlots"])
        متغير ي = ٠
        من_أجل (ا في قطعة["params"]) {
            إذا (ي < طول(وس)) { م[ي] = وس[ي] }
            ي = ي + ١
        }
        إذا (يحوي(قطعة، "isAsync") و قطعة["isAsync"]) {
            أضف(مكدّس، _ابدأ_غير_متزامن(قطعة، م، د["env"]))
            ارجع لاشيء
        }
        إذا (طول(إطارات) > ٥٠٠٠) { أطلق_خطأ("تجاوزت الدالة عمق الاستدعاء المسموح (٥٠٠٠) — غالبًا استدعاء ذاتي بلا شرط توقف") }
        أضف(إطارات، _إطار_جديد(قطعة، م، د["env"]))
    } وإلا إذا (ت == "دالة") {
        إذا (د == أصلي_نوع و طول(وس) == ١) {
            إذا (_هو_وعد(وس[٠])) { أضف(مكدّس، "وعد") ارجع لاشيء }
            إذا (_هي_دالة_نواة(وس[٠])) { أضف(مكدّس، "دالة") ارجع لاشيء }
        }
        إذا (د == أصلي_اطبع أو د == أصلي_نص) {
            متغير معروضة = []
            من_أجل (ق في وس) {
                إذا (_خاص(ق، ٠)) { أضف(معروضة، _عرض(ق، [])) } وإلا { أضف(معروضة، ق) }
            }
            أضف(مكدّس، _استدعِ_مدمجة(د، معروضة))
            ارجع لاشيء
        }
        متغير مُغلَّفة = []
        من_أجل (ق في وس) {
            إذا (نوع(ق) == "خريطة" و يحوي(ق، "@دالة")) { أضف(مُغلَّفة، _غلّف(ق)) } وإلا { أضف(مُغلَّفة، ق) }
        }
        أضف(مكدّس، _استدعِ_مدمجة(د، مُغلَّفة))
    } وإلا {
        أطلق_خطأ("غير قابل للاستدعاء")
    }
}

# يزيل بادئة موضع الوحدة («آلة.dhad، السطر ن: ») التي تضيفها الآلة المضيفة لرسالة خطأ صدر من هذه الوحدة نفسها
دالة _جرّد(رسالة) {
    إذا (نوع(رسالة) != "نص") { ارجع رسالة }
    متغير بادئة = "آلة.dhad، السطر "
    إذا (رسالة[:طول(بادئة)] == بادئة) {
        متغير ي = موضع(رسالة، ": ")
        إذا (ي >= ٠) { ارجع رسالة[ي + ٢:] }
    }
    ارجع رسالة
}

# هل هذه القيمة إشارة داخلية (تعليق مهمة عند انتظر) لا خطأ مستخدم؟
دالة _إشارة_تعليق(ق) {
    ارجع نوع(ق) == "خريطة" و يحوي(ق، "@تعليق")
}

# يوجّه الخطأ إلى أقرب «حاول» نشطة فوق القاعدة؛ وإلا يعيد إطلاقه إلى من استدعى هذا التشغيل
دالة _وجّه(ق، قاعدة) {
    متغير ه = لاشيء
    طالما (طول(معالجات) > ٠ و معالجات[طول(معالجات) - ١]["depth"] > قاعدة) {
        متغير ح = انزع(معالجات)
        إذا (ح["depth"] <= طول(إطارات) و إطارات[ح["depth"] - ١] == ح["frame"]) {
            ه = ح
            توقف
        }
    }
    إذا (ه == لاشيء) {
        _اقطع_الإطارات(قاعدة)
        أطلق_خطأ(ق)
    }
    _اقطع_الإطارات(ه["depth"])
    _اقطع_المكدّس(ه["stackLen"])
    عمق_تزامن = ه["sync"]
    ه["frame"]["ip"] = ه["catchAddr"]
    ه["frame"]["env"] = ه["env"]
    أضف(مكدّس، ق)
}

دالة _التقط(خطأ_خام، قاعدة) {
    إذا (_إشارة_تعليق(خطأ_خام)) { أطلق_خطأ(خطأ_خام) }
    متغير ق = _جرّد(خطأ_خام)
    # الرسائل النصية تُنسب إلى سطر التعليمة التي سبّبتها، إلا ما أُعيد إطلاقه (RETHROW/AWAIT) فهو منسوب سلفًا
    متغير عملية = تعليمة_حالية["op"]
    إذا (نوع(ق) == "نص" و ق[:٦] != "السطر " و عملية != "RETHROW" و عملية != "AWAIT" و يحوي(تعليمة_حالية، "line")) {
        ق = "السطر " + نص_برمجي(تعليمة_حالية["line"]) + ": " + ق
    }
    _وجّه(ق، قاعدة)
}

# يشغّل الإطارات حتى يعود عمقها إلى القاعدة، موجِّهًا الأخطاء إلى معالجات «حاول»
دالة _شغّل_حتى(قاعدة) {
    متغير انتهى = خطأ
    طالما (ليس انتهى) {
        حاول {
            _نفّذ_حتى_النهاية(قاعدة)
            انتهى = صحيح
        } التقط (خ) {
            _التقط(خ، قاعدة)
        }
    }
}

# دالة مضيفة تغلّف دالة مستخدم فتُستدعى من المدمجات (طبّق، رتب…) وتنفّذها هنا تشغيلًا متداخلًا
دالة _غلّف(ك) {
    ارجع دالة(أ، ب، ج، د، ه، ز) { ارجع _استدعِ_متداخلة(ك، [أ، ب، ج، د، ه، ز]) }
}

دالة _استدعِ_متداخلة(ك، وسائط) {
    متغير قطعة = ك["chunk"]
    متغير م = _محليات_فارغة(قطعة["maxSlots"])
    متغير ي = ٠
    من_أجل (ا في قطعة["params"]) {
        م[ي] = وسائط[ي]
        ي = ي + ١
    }
    إذا (يحوي(قطعة، "isAsync") و قطعة["isAsync"]) { ارجع _ابدأ_غير_متزامن(قطعة، م، ك["env"]) }
    متغير قاعدة = طول(إطارات)
    أضف(إطارات، _إطار_جديد(قطعة، م، ك["env"]))
    عمق_تزامن = عمق_تزامن + ١
    _شغّل_حتى(قاعدة)
    عمق_تزامن = عمق_تزامن - ١
    ارجع انزع(مكدّس)
}

دالة _اقطع_الإطارات(ن) {
    طالما (طول(إطارات) > ن) { انزع(إطارات) }
}

# ===== عرض القيم الخاصة بالنواة (الوعود والدوال) كما تعرضها الآلة الأصلية =====
دالة _هي_دالة_نواة(ق) { ارجع نوع(ق) == "خريطة" و يحوي(ق، "@دالة") }

# هل القيمة (أو ما تحويه) وعد أو دالة من النواة؟ العمق محدود فلا نغرق في البنى الدائرية
دالة _خاص(ق، عمق) {
    إذا (عمق > ٦) { ارجع خطأ }
    متغير ت = نوع(ق)
    إذا (ت == "قائمة") {
        من_أجل (ع في ق) { إذا (_خاص(ع، عمق + ١)) { ارجع صحيح } }
        ارجع خطأ
    }
    إذا (ت == "خريطة") {
        إذا (يحوي(ق، "@وعد") أو يحوي(ق، "@دالة")) { ارجع صحيح }
        من_أجل (م في مفاتيح(ق)) {
            إذا (_خاص(م، عمق + ١) أو _خاص(ق[م]، عمق + ١)) { ارجع صحيح }
        }
    }
    ارجع خطأ
}

دالة _عرض(ق، مسار) {
    إذا (_هو_وعد(ق)) {
        إذا (ق["state"] == "pending") { ارجع "وعد{منتظر}" }
        إذا (ق["state"] == "done") { ارجع "وعد{أُنجز: " + _عرض(ق["value"]، مسار) + "}" }
        ارجع "وعد{رُفض: " + _عرض(ق["value"]، مسار) + "}"
    }
    إذا (_هي_دالة_نواة(ق)) { ارجع "‹دالة›" }
    متغير ت = نوع(ق)
    إذا (ت == "قائمة" أو ت == "خريطة") {
        من_أجل (م في مسار) { إذا (م == ق) { ارجع "[…]" } }
        أضف(مسار، ق)
        متغير أجزاء = []
        متغير ناتج = ""
        إذا (ت == "قائمة") {
            من_أجل (ع في ق) { أضف(أجزاء، _عرض(ع، مسار)) }
            ناتج = "[" + _اربط(أجزاء) + "]"
        } وإلا {
            من_أجل (م في مفاتيح(ق)) { أضف(أجزاء، _عرض(م، مسار) + ": " + _عرض(ق[م]، مسار)) }
            ناتج = "{" + _اربط(أجزاء) + "}"
        }
        انزع(مسار)
        ارجع ناتج
    }
    ارجع أصلي_نص(ق)
}

دالة _اربط(أجزاء) {
    متغير ن = ""
    متغير ي = ٠
    من_أجل (ج في أجزاء) {
        إذا (ي > ٠) { ن = ن + "، " }
        ن = ن + ج
        ي = ي + ١
    }
    ارجع ن
}

# ===== المهام والوعود (غير المتزامن) =====
دالة _هو_وعد(ق) { ارجع نوع(ق) == "خريطة" و يحوي(ق، "@وعد") }

دالة _وعد_جديد() {
    ارجع {"@وعد": صحيح، "state": "pending"، "value": لاشيء، "callbacks": []، "handled": خطأ}
}

دالة _استقر(وع، حالة، قيمة) {
    إذا (وع["state"] != "pending") { ارجع لاشيء }
    وع["state"] = حالة
    وع["value"] = قيمة
    متغير ردود = وع["callbacks"]
    وع["callbacks"] = []
    من_أجل (رد في ردود) { _أجّل(رد، حالة، قيمة) }
    إذا (حالة == "failed" و ليس وع["handled"]) { أضف(مرفوضة، وع) }
}

دالة _أجّل(رد، حالة، قيمة) {
    أضف(مهام_صغيرة، دالة() { رد(حالة، قيمة) })
}

دالة _عند_الاستقرار(وع، رد) {
    وع["handled"] = صحيح
    إذا (وع["state"] == "pending") { أضف(وع["callbacks"]، رد) } وإلا { _أجّل(رد، وع["state"]، وع["value"]) }
}

دالة _ابدأ_غير_متزامن(قطعة، محليات، بيئة) {
    إذا (عمق_المهام > ٣٠٠) { أطلق_خطأ("تداخل الدوال غير المتزامنة عميق جدًا (أكثر من ٣٠٠)") }
    متغير وع = _وعد_جديد()
    _شغّل_مهمة({"frames": [_إطار_جديد(قطعة، محليات، بيئة)]، "stack": []، "handlers": []، "promise": وع}، لاشيء)
    ارجع وع
}

# يشغّل مهمة حتى تنتهي أو تتوقف عند «انتظر»
دالة _شغّل_مهمة(مهمة، استئناف) {
    متغير ح_إطارات = إطارات
    متغير ح_مكدّس = مكدّس
    متغير ح_معالجات = معالجات
    متغير ح_مهمة = مهمة_حالية
    متغير ح_تزامن = عمق_تزامن
    إطارات = مهمة["frames"]
    مكدّس = مهمة["stack"]
    معالجات = مهمة["handlers"]
    مهمة_حالية = مهمة
    عمق_تزامن = ٠
    عمق_المهام = عمق_المهام + ١
    حاول {
        إذا (استئناف != لاشيء) {
            إذا (استئناف["state"] == "failed") { _وجّه(استئناف["value"]، ٠) } وإلا { أضف(مكدّس، استئناف["value"]) }
        }
        _شغّل_حتى(٠)
        متغير نتيجة = لاشيء
        إذا (طول(مكدّس) > ٠) { نتيجة = مكدّس[طول(مكدّس) - ١] }
        إذا (_هو_وعد(نتيجة)) {
            _عند_الاستقرار(نتيجة، دالة(ح، ق) { _استقر(مهمة["promise"]، ح، ق) })
        } وإلا {
            _استقر(مهمة["promise"]، "done"، نتيجة)
        }
    } التقط (خ) {
        إذا (_إشارة_تعليق(خ)) {
            # توقفت المهمة عند انتظر؛ ستُستأنف عند حسم الوعد
        } وإلا {
            _استقر(مهمة["promise"]، "failed"، _جرّد(خ))
        }
    }
    إطارات = ح_إطارات
    مكدّس = ح_مكدّس
    معالجات = ح_معالجات
    مهمة_حالية = ح_مهمة
    عمق_تزامن = ح_تزامن
    عمق_المهام = عمق_المهام - ١
}

دالة _انتظر() {
    متغير ق = انزع(مكدّس)
    إذا (ليس _هو_وعد(ق)) {
        أضف(مكدّس، ق)
        ارجع لاشيء
    }
    إذا (عمق_تزامن > ٠ أو مهمة_حالية == لاشيء) {
        أطلق_خطأ("انتظر لا تعمل هنا: الدالة استُدعيت من دالة جاهزة (مثل طبّق) أو من ملف مستورَد، فلا يمكن إيقافها لانتظار غيرها")
    }
    إذا (ق["state"] == "done") {
        ق["handled"] = صحيح
        أضف(مكدّس، ق["value"])
        ارجع لاشيء
    }
    إذا (ق["state"] == "failed") {
        ق["handled"] = صحيح
        أطلق_خطأ(ق["value"])
    }
    متغير مهمة = مهمة_حالية
    _عند_الاستقرار(ق، دالة(ح، قيمة) { _شغّل_مهمة(مهمة، {"state": ح، "value": قيمة}) })
    أطلق_خطأ({"@تعليق": صحيح})
}

# يشغّل المهام المؤجلة ثم المؤقتات بزمن افتراضي (نقفز إلى أقرب مؤقت دون انتظار فعلي)
دالة _صرّف() {
    طالما (صحيح) {
        متغير ي = ٠
        طالما (ي < طول(مهام_صغيرة)) {
            متغير م = مهام_صغيرة[ي]
            ي = ي + ١
            م()
        }
        مهام_صغيرة = []
        إذا (طول(مؤقتات) == ٠) { توقف }
        متغير أدنى = ٠
        من_أجل (ك من ١ إلى طول(مؤقتات) - ١) {
            إذا (مؤقتات[ك]["time"] < مؤقتات[أدنى]["time"] أو (مؤقتات[ك]["time"] == مؤقتات[أدنى]["time"] و مؤقتات[ك]["seq"] < مؤقتات[أدنى]["seq"])) { أدنى = ك }
        }
        متغير مؤقت = مؤقتات[أدنى]
        متغير باقي = []
        من_أجل (ك من ٠ إلى طول(مؤقتات) - ١) { إذا (ك != أدنى) { أضف(باقي، مؤقتات[ك]) } }
        مؤقتات = باقي
        إذا (مؤقت["time"] > الآن) { الآن = مؤقت["time"] }
        مؤقت["fn"]()
    }
}

# دوال الوعود والزمن تُسجَّل في المدمجات فتتعامل مع وعود النواة لا وعود المضيف
دالة _ثبّت_الوعود(مدمجات) {
    مدمجات["نم"] = دالة(مللي) {
        إذا (نوع(مللي) != "رقم" أو ليس (مللي >= ٠) أو مللي > ٨٦٤٠٠٠٠٠) { أطلق_خطأ("نم() تحتاج عددًا من ٠ إلى ٨٦٤٠٠٠٠٠ مللي ثانية") }
        إذا (طول(مؤقتات) > ١٠٠٠٠٠) { أطلق_خطأ("نم(): مؤقتات كثيرة جدًا") }
        متغير وع = _وعد_جديد()
        تسلسل_المؤقتات = تسلسل_المؤقتات + ١
        أضف(مؤقتات، {"time": الآن + مللي، "seq": تسلسل_المؤقتات، "fn": دالة() { _استقر(وع، "done"، لاشيء) }})
        ارجع وع
    }
    مدمجات["وعد_جاهز"] = دالة(ق) {
        إذا (_هو_وعد(ق)) { ارجع ق }
        متغير وع = _وعد_جديد()
        _استقر(وع، "done"، ق)
        ارجع وع
    }
    مدمجات["كل_الوعود"] = دالة(قائمة) {
        إذا (نوع(قائمة) != "قائمة") { أطلق_خطأ("كل_الوعود() تحتاج قائمة") }
        متغير خارج = _وعد_جديد()
        متغير ن = طول(قائمة)
        متغير نتائج = []
        من_أجل (ك من ١ إلى ن) { أضف(نتائج، لاشيء) }
        متغير متبقٍ = [ن]
        إذا (ن == ٠) {
            _استقر(خارج، "done"، نتائج)
            ارجع خارج
        }
        من_أجل (ك من ٠ إلى ن - ١) { _اربط_كل(قائمة[ك]، ك، خارج، نتائج، متبقٍ) }
        ارجع خارج
    }
    مدمجات["أول_وعد"] = دالة(قائمة) {
        إذا (نوع(قائمة) != "قائمة") { أطلق_خطأ("أول_وعد() تحتاج قائمة") }
        إذا (طول(قائمة) == ٠) { أطلق_خطأ("أول_وعد() تحتاج قائمة فيها عنصر واحد على الأقل") }
        متغير خارج = _وعد_جديد()
        من_أجل (ق في قائمة) {
            إذا (ليس _هو_وعد(ق)) {
                _استقر(خارج، "done"، ق)
                توقف
            }
            _اربط_أول(ق، خارج)
        }
        ارجع خارج
    }
}

دالة _اربط_كل(ق، ك، خارج، نتائج، متبقٍ) {
    إذا (ليس _هو_وعد(ق)) {
        نتائج[ك] = ق
        متبقٍ[٠] = متبقٍ[٠] - ١
        إذا (متبقٍ[٠] == ٠) { _استقر(خارج، "done"، نتائج) }
        ارجع لاشيء
    }
    _عند_الاستقرار(ق، دالة(ح، قيمة) {
        إذا (خارج["state"] != "pending") { ارجع لاشيء }
        إذا (ح == "failed") {
            _استقر(خارج، "failed"، قيمة)
        } وإلا {
            نتائج[ك] = قيمة
            متبقٍ[٠] = متبقٍ[٠] - ١
            إذا (متبقٍ[٠] == ٠) { _استقر(خارج، "done"، نتائج) }
        }
    })
}

دالة _اربط_أول(ق، خارج) {
    _عند_الاستقرار(ق، دالة(ح، قيمة) {
        إذا (خارج["state"] != "pending") { ارجع لاشيء }
        _استقر(خارج، ح، قيمة)
    })
}

# نقطة الدخول: البرنامج هو مخرج مترجم ضاد، والمدمجات خريطة اسم ← دالة
صدّر دالة شغّل(برنامج، مدمجات) {
    مكدّس = []
    إطارات = []
    معالجات = []
    عالمية = مدمجات
    خطوات = ٠
    مهام_صغيرة = []
    مؤقتات = []
    الآن = ٠
    تسلسل_المؤقتات = ٠
    مرفوضة = []
    مهمة_حالية = لاشيء
    عمق_تزامن = ٠
    عمق_المهام = ٠
    أصلي_اطبع = مدمجات["اطبع"]
    أصلي_نص = مدمجات["نص"]
    أصلي_نوع = مدمجات["نوع"]
    _ثبّت_الوعود(مدمجات)
    دوال_البرنامج = برنامج["functionChunks"]
    متغير رئيسية = دوال_البرنامج[برنامج["mainChunkIndex"]]
    متغير وعد_رئيسي = _وعد_جديد()
    _شغّل_مهمة({"frames": [_إطار_جديد(رئيسية، _محليات_فارغة(رئيسية["maxSlots"])، لاشيء)]، "stack": []، "handlers": []، "promise": وعد_رئيسي}، لاشيء)
    إذا (وعد_رئيسي["state"] == "failed") { أطلق_خطأ(وعد_رئيسي["value"]) }
    _صرّف()
    إذا (وعد_رئيسي["state"] == "failed") { أطلق_خطأ(وعد_رئيسي["value"]) }
    إذا (وعد_رئيسي["state"] == "pending") { أطلق_خطأ("البرنامج ينتظر وعدًا لن يُنجَز أبدًا (انتظار متبادل بين مهمتين، أو وعد لا يُحسم)") }
    من_أجل (ي في مرفوضة) {
        إذا (ليس ي["handled"]) { أطلق_خطأ(ي["value"]) }
    }
    ارجع لاشيء
}
