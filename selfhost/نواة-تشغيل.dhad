# مكتبة التشغيل لـ«ضاد-نواة» (الاستقلال ٦د): مخصِّص ذاكرة، نصوص، قوائم، خرائط — مكتوبة بضاد-نواة نفسها.
# كل القيم أعداد صحيحة ٣٢ بتًا؛ المؤشرات عناوين في الذاكرة الخطية. تُدمج مع برنامج المستخدم بـ صرّف_نواة_مع.
# تخطيط الكتلة: [حجم الحمولة (مضاعف ٨)] ثم الحمولة؛ الكتلة الحرة تحفظ في أول حمولتها مؤشر التالية.
# تخطيط النص: [الطول][البايتات…]. القائمة: [الطول][السعة][مؤشر البيانات]. الخريطة: [العدد][السعة][الجدول][النوع][المشغول]،
#   وكل خانة جدول ١٢ بايتًا: [الحالة ٠ فارغ/١ مشغول/٢ مقبرة][المفتاح][القيمة]؛ النوع ٠ عددي و١ نصي.

# المناطق: [١٠٢٤ … ٢٠٤٨٠) مكدّس الجذور (بيانات مؤشرات يدفعها البرنامج)، ثم الكومة من ٢٠٤٨٠.
# رأس الكتلة ٨ بايتات: [الحجم][الحالة]؛ الحالة للمحجوزة -١ (غير معلَّمة) أو -٢ (معلَّمة)، وللحرة مؤشر التالية (≥ ٠).
متغير قاعدة = ٢٠٤٨٠
متغير قمة = ٢٠٤٨٠
متغير حرة = ٠
متغير جذور = ١٠٢٤
متغير _بت = ٠
متغير _مكدس = ٠

دالة خصّص(ن) {
    ن = بتّ_و(ن + ٧، -٨)
    إذا (ن < ٨) { ن = ٨ }
    متغير ص = حرة
    متغير سابق = ٠
    طالما (ص != ٠) {
        إذا (حمّل(ص) == ن) {
            إذا (سابق == ٠) { حرة = حمّل(ص + ٤) } وإلا { خزّن(سابق + ٤، حمّل(ص + ٤)) }
            خزّن(ص + ٤، -١)
            ارجع ص + ٨
        }
        سابق = ص
        ص = حمّل(ص + ٤)
    }
    ص = قمة
    متغير نهاية = ص + ن + ٨
    طالما (نهاية > حجم_ذاكرة() * ٦٥٥٣٦) {
        إذا (كبّر_ذاكرة(١) == -١) { أطلق_نفاد_الذاكرة() }
    }
    قمة = نهاية
    خزّن(ص، ن)
    خزّن(ص + ٤، -١)
    ارجع ص + ٨
}

دالة أطلق_نفاد_الذاكرة() {
    # لا استثناءات في النواة: نُسقط البرنامج بقسمة على صفر (trap) كما تفعل المنصات
    ارجع ١ / ٠
}

دالة حرّر(م) {
    متغير ك = م - ٨
    خزّن(ك + ٤، حرة)
    حرة = ك
}

دالة انسخ(مصدر_، وجهة_، ن) {
    من_أجل (ي من ٠ إلى ن - ١) { خزّن_بايت(وجهة_ + ي، حمّل_بايت(مصدر_ + ي)) }
}

# ---------- النصوص ----------
دالة نص_جديد(ن) {
    متغير ص = خصّص(ن + ٤)
    خزّن(ص، ن)
    ارجع ص
}
دالة نص_طول(ص) { ارجع حمّل(ص) }
دالة نص_بايت(ص، ي) { ارجع حمّل_بايت(ص + ٤ + ي) }
دالة نص_ضع_بايت(ص، ي، ب) { خزّن_بايت(ص + ٤ + ي، ب) }

دالة نص_دمج(أ، ب) {
    متغير ن١ = حمّل(أ)
    متغير ن٢ = حمّل(ب)
    متغير ر = نص_جديد(ن١ + ن٢)
    انسخ(أ + ٤، ر + ٤، ن١)
    انسخ(ب + ٤، ر + ٤ + ن١، ن٢)
    ارجع ر
}

دالة نص_يساوي(أ، ب) {
    متغير ن = حمّل(أ)
    إذا (ن != حمّل(ب)) { ارجع ٠ }
    من_أجل (ي من ٠ إلى ن - ١) {
        إذا (حمّل_بايت(أ + ٤ + ي) != حمّل_بايت(ب + ٤ + ي)) { ارجع ٠ }
    }
    ارجع ١
}

# FNV-1a ٣٢ بتًا
دالة نص_تجزئة(ص) {
    متغير ه = -٢١٢٨٨٣١٠٣٥
    متغير ن = حمّل(ص)
    من_أجل (ي من ٠ إلى ن - ١) {
        ه = بتّ_خاص(ه، حمّل_بايت(ص + ٤ + ي)) * ١٦٧٧٧٦١٩
    }
    ارجع ه
}

# العدد بالأرقام العشرية (يشمل السالب والصفر؛ الحد الأدنى -٢١٤٧٤٨٣٦٤٨ يُعالَج)
دالة نص_من_عدد(ع) {
    إذا (ع == ٠) {
        متغير ر = نص_جديد(١)
        نص_ضع_بايت(ر، ٠، ٤٨)
        ارجع ر
    }
    متغير سالب = ٠
    إذا (ع < ٠) { سالب = ١ }
    متغير ن = ٠
    متغير ق = ع
    طالما (ق != ٠) { ق = ق / ١٠
        ن = ن + ١ }
    متغير ر = نص_جديد(ن + سالب)
    ق = ع
    متغير ي = ن + سالب - ١
    طالما (ق != ٠) {
        متغير ر١ = ق % ١٠
        إذا (ر١ < ٠) { ر١ = -ر١ }
        نص_ضع_بايت(ر، ي، ٤٨ + ر١)
        ق = ق / ١٠
        ي = ي - ١
    }
    إذا (سالب == ١) { نص_ضع_بايت(ر، ٠، ٤٥) }
    ارجع ر
}

# ---------- القوائم ----------
دالة قائمة_جديدة() {
    متغير ق = خصّص(١٢)
    خزّن(ق، ٠)
    خزّن(ق + ٤، ٤)
    خزّن(ق + ٨، خصّص(١٦))
    ارجع ق
}
دالة قائمة_طول(ق) { ارجع حمّل(ق) }
دالة قائمة_احصل(ق، ي) { ارجع حمّل(حمّل(ق + ٨) + ي * ٤) }
دالة قائمة_اضبط(ق، ي، ع) { خزّن(حمّل(ق + ٨) + ي * ٤، ع) }
دالة قائمة_أضف(ق، ع) {
    متغير ن = حمّل(ق)
    متغير س = حمّل(ق + ٤)
    إذا (ن == س) {
        متغير جديد = خصّص(س * ٨)
        انسخ(حمّل(ق + ٨)، جديد، ن * ٤)
        حرّر(حمّل(ق + ٨))
        خزّن(ق + ٨، جديد)
        خزّن(ق + ٤، س * ٢)
    }
    خزّن(حمّل(ق + ٨) + ن * ٤، ع)
    خزّن(ق، ن + ١)
}
دالة قائمة_انزع(ق) {
    متغير ن = حمّل(ق) - ١
    خزّن(ق، ن)
    ارجع حمّل(حمّل(ق + ٨) + ن * ٤)
}

# ---------- الخرائط ----------
دالة خريطة_جديدة(نوع_) {
    متغير م = خصّص(٢٠)
    خزّن(م، ٠)
    خزّن(م + ٤، ٨)
    خزّن(م + ٨، _جدول_جديد(٨))
    خزّن(م + ١٢، نوع_)
    خزّن(م + ١٦، ٠)
    ارجع م
}
دالة _جدول_جديد(سعة) {
    متغير ج = خصّص(سعة * ١٢)
    من_أجل (ي من ٠ إلى سعة * ٣ - ١) { خزّن(ج + ي * ٤، ٠) }
    ارجع ج
}
دالة _تجزئة_مفتاح(م، ك) {
    إذا (حمّل(م + ١٢) == ١) { ارجع نص_تجزئة(ك) }
    ارجع ك * -١٦٤٠٥٣١٥٣٥
}
دالة _مفتاحان_متساويان(م، أ، ب) {
    إذا (حمّل(م + ١٢) == ١) { ارجع نص_يساوي(أ، ب) }
    ارجع أ == ب
}
# عنوان الخانة المطابقة أو ٠ إن لم توجد
دالة _ابحث(م، ك) {
    متغير س = حمّل(م + ٤)
    متغير ج = حمّل(م + ٨)
    متغير ي = بتّ_و(_تجزئة_مفتاح(م، ك)، س - ١)
    طالما (صحيح) {
        متغير خ = ج + ي * ١٢
        متغير حالة = حمّل(خ)
        إذا (حالة == ٠) { ارجع ٠ }
        إذا (حالة == ١ و _مفتاحان_متساويان(م، حمّل(خ + ٤)، ك)) { ارجع خ }
        ي = بتّ_و(ي + ١، س - ١)
    }
}
دالة _أدرج_جديدًا(م، ك، ع) {
    متغير س = حمّل(م + ٤)
    متغير ج = حمّل(م + ٨)
    متغير ي = بتّ_و(_تجزئة_مفتاح(م، ك)، س - ١)
    طالما (حمّل(ج + ي * ١٢) == ١) { ي = بتّ_و(ي + ١، س - ١) }
    متغير خ = ج + ي * ١٢
    إذا (حمّل(خ) == ٠) { خزّن(م + ١٦، حمّل(م + ١٦) + ١) }
    خزّن(خ، ١)
    خزّن(خ + ٤، ك)
    خزّن(خ + ٨، ع)
    خزّن(م، حمّل(م) + ١)
}
دالة _كبّر_الجدول(م) {
    متغير س = حمّل(م + ٤)
    متغير قديم = حمّل(م + ٨)
    متغير سعة_جديدة = س
    إذا (حمّل(م) * ٢ >= س) { سعة_جديدة = س * ٢ }
    خزّن(م + ٤، سعة_جديدة)
    خزّن(م + ٨، _جدول_جديد(سعة_جديدة))
    خزّن(م، ٠)
    خزّن(م + ١٦، ٠)
    من_أجل (ي من ٠ إلى س - ١) {
        متغير خ = قديم + ي * ١٢
        إذا (حمّل(خ) == ١) { _أدرج_جديدًا(م، حمّل(خ + ٤)، حمّل(خ + ٨)) }
    }
    حرّر(قديم)
}
دالة خريطة_ضع(م، ك، ع) {
    متغير خ = _ابحث(م، ك)
    إذا (خ != ٠) {
        خزّن(خ + ٨، ع)
        ارجع ٠
    }
    إذا ((حمّل(م + ١٦) + ١) * ١٠ >= حمّل(م + ٤) * ٧) { _كبّر_الجدول(م) }
    _أدرج_جديدًا(م، ك، ع)
    ارجع ٠
}
دالة خريطة_يحوي(م، ك) {
    إذا (_ابحث(م، ك) == ٠) { ارجع ٠ }
    ارجع ١
}
دالة خريطة_احصل(م، ك، افتراضي) {
    متغير خ = _ابحث(م، ك)
    إذا (خ == ٠) { ارجع افتراضي }
    ارجع حمّل(خ + ٨)
}
دالة خريطة_احذف(م، ك) {
    متغير خ = _ابحث(م، ك)
    إذا (خ == ٠) { ارجع ٠ }
    خزّن(خ، ٢)
    خزّن(م، حمّل(م) - ١)
    ارجع ١
}
دالة خريطة_عدد(م) { ارجع حمّل(م) }

# ---------- جامع النفايات (علّم واكنس، محافظ، جذوره مكدّس الجذور) ----------
# يُستدعى عند نقاط آمنة فقط: كل قيمة حيّة يجب أن تكون قابلة للوصول من مكدّس الجذور (ادفع_جذر) — لا من محليات WebAssembly.
# محافظ: أي كلمة تشبه عنوان حمولة كتلة محجوزة تُعدّ مؤشرًا (قد يُبقي كتلة بلا داعٍ لكنه لا يحرّر حيًّا أبدًا).
دالة ادفع_جذر(ع) {
    إذا (جذور >= ٢٠٤٨٠) { أطلق_نفاد_الذاكرة() }
    خزّن(جذور، ع)
    جذور = جذور + ٤
}
دالة ارفع_جذور(ن) { جذور = جذور - ن * ٤ }

دالة _بت_مضبوط(ع) {
    متغير ب = (ع - قاعدة) / ٨
    ارجع بتّ_و(يمين_موجب(حمّل_بايت(_بت + ب / ٨)، بتّ_و(ب، ٧))، ١)
}
دالة _اضبط_بت(ع) {
    متغير ب = (ع - قاعدة) / ٨
    متغير ع٢ = _بت + ب / ٨
    خزّن_بايت(ع٢، بتّ_أو(حمّل_بايت(ع٢)، يسار(١، بتّ_و(ب، ٧))))
}
دالة _جرّب(ك) {
    إذا (ك < قاعدة + ٨ أو ك >= قمة) { ارجع ٠ }
    إذا (بتّ_و(ك، ٧) != ٠) { ارجع ٠ }
    إذا (_بت_مضبوط(ك) == ٠) { ارجع ٠ }
    إذا (حمّل(ك - ٤) != -١) { ارجع ٠ }
    خزّن(ك - ٤، -٢)
    خزّن(_مكدس، ك)
    _مكدس = _مكدس + ٤
    ارجع ٠
}
# يرجع عدد البايتات المحرَّرة
دالة جمع_النفايات() {
    متغير طول_الكومة = قمة - قاعدة
    متغير بايتات_البت = طول_الكومة / ٦٤ + ٨
    متغير بداية_البت = بتّ_و(قمة + ٧، -٨)
    متغير بداية_المكدس = بتّ_و(بداية_البت + بايتات_البت + ٧، -٨)
    متغير نهاية = بداية_المكدس + طول_الكومة / ٤ + ٨
    طالما (نهاية > حجم_ذاكرة() * ٦٥٥٣٦) {
        إذا (كبّر_ذاكرة(١) == -١) { أطلق_نفاد_الذاكرة() }
    }
    _بت = بداية_البت
    _مكدس = بداية_المكدس
    من_أجل (ي من ٠ إلى بايتات_البت - ١) { خزّن_بايت(_بت + ي، ٠) }
    # ١) سجلّ بدايات الكتل
    متغير ك = قاعدة
    طالما (ك < قمة) {
        _اضبط_بت(ك + ٨)
        ك = ك + حمّل(ك) + ٨
    }
    # ٢) العلامة من الجذور
    متغير ج = ١٠٢٤
    طالما (ج < جذور) {
        _جرّب(حمّل(ج))
        ج = ج + ٤
    }
    طالما (_مكدس > بداية_المكدس) {
        _مكدس = _مكدس - ٤
        متغير ح = حمّل(_مكدس)
        متغير ن = حمّل(ح - ٨) / ٤
        من_أجل (ي من ٠ إلى ن - ١) { _جرّب(حمّل(ح + ي * ٤)) }
    }
    # ٣) الكنس وإعادة بناء القائمة الحرة
    حرة = ٠
    متغير محرَّر = ٠
    ك = قاعدة
    طالما (ك < قمة) {
        متغير حالة = حمّل(ك + ٤)
        إذا (حالة == -٢) {
            خزّن(ك + ٤، -١)
        } وإلا {
            إذا (حالة == -١) { محرَّر = محرَّر + حمّل(ك) + ٨ }
            خزّن(ك + ٤، حرة)
            حرة = ك
        }
        ك = ك + حمّل(ك) + ٨
    }
    ارجع محرَّر
}
