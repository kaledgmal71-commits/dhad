# مصرِّف «ضاد-نواة» إلى WebAssembly، مكتوب بضاد (الاستقلال، المرحلة ٦ب/٦ج).
# ضاد-نواة: مجموعة جزئية من ضاد نفسها (الصياغة نفسها يقرؤها محلل ضاد) كل أعدادها صحيحة ٣٢ بتًا،
# تُترجَم مباشرة إلى ملف .wasm ثنائي بلا أي أداة خارجية. المخرج قائمة بايتات.
#
# المدعوم: دوال بمعاملات صحيحة تُرجع صحيحًا، متغيرات محلية، + - * / % مقارنات، و أو ليس، إذا/وإلا، طالما،
#   من_أجل (س من ا إلى ب [بخطوة ثابتة])، توقف، أكمل، ارجع، استدعاء الدوال والذاتي.
#   مدمجات: حمّل(ع) خزّن(ع، ق) حمّل_بايت(ع) خزّن_بايت(ع، ق) بتّ_و بتّ_أو بتّ_خاص يسار يمين يمين_موجب اطبع_رقم(ق)
#   ذاكرة خطية من صفحة واحدة تُصدَّر باسم «ذاكرة».
# القسمة على صفر تُسقط البرنامج (trap) كما هو معتاد في WebAssembly.

متغير _م_محلل = استورد("محلل")

# ---------- الترميز الثنائي ----------
دالة _وحدة_غير_موقعة(ن) {
    متغير خرج = []
    متغير ق = ن
    طالما (صحيح) {
        متغير ب = ق % ١٢٨
        ق = أرضية(ق / ١٢٨)
        إذا (ق > ٠) {
            أضف(خرج، ب + ١٢٨)
        } وإلا {
            أضف(خرج، ب)
            توقف
        }
    }
    ارجع خرج
}

دالة _وحدة_موقعة(ن) {
    متغير خرج = []
    متغير ق = ن
    طالما (صحيح) {
        متغير ب = ((ق % ١٢٨) + ١٢٨) % ١٢٨
        ق = أرضية(ق / ١٢٨)
        إذا ((ق == ٠ و ب < ٦٤) أو (ق == -١ و ب >= ٦٤)) {
            أضف(خرج، ب)
            توقف
        }
        أضف(خرج، ب + ١٢٨)
    }
    ارجع خرج
}

دالة _متجه(بايتات) { ارجع _وحدة_غير_موقعة(طول(بايتات)) + بايتات }

دالة _بايتات_اسم(نص_الاسم) {
    متغير خرج = []
    من_أجل (ح في نص_الاسم) {
        متغير ر = رمز(ح)
        إذا (ر < ١٢٨) {
            أضف(خرج، ر)
        } وإلا إذا (ر < ٢٠٤٨) {
            أضف(خرج، ١٩٢ + أرضية(ر / ٦٤))
            أضف(خرج، ١٢٨ + ر % ٦٤)
        } وإلا {
            أضف(خرج، ٢٢٤ + أرضية(ر / ٤٠٩٦))
            أضف(خرج، ١٢٨ + أرضية(ر / ٦٤) % ٦٤)
            أضف(خرج، ١٢٨ + ر % ٦٤)
        }
    }
    ارجع _متجه(خرج)
}

دالة _قسم(رقم، محتوى) { ارجع [رقم] + _وحدة_غير_موقعة(طول(محتوى)) + محتوى }

# ---------- حالة التصريف ----------
متغير دوال_المصدر = []
متغير فهرس_دالة = {}
متغير جسم = []
متغير محليات = {}
متغير عدد_المحليات = ٠
متغير عمق = ٠
متغير حلقات = []
متغير عدّاد_مؤقت = ٠
متغير سطر = ٠
متغير عامة_فهرس = {}
متغير عامة_قيم = []

دالة _خطأ(رسالة) {
    أطلق_خطأ("ضاد-نواة: السطر " + نص_برمجي(سطر) + ": " + رسالة)
}

دالة _ضع(بايتات) {
    من_أجل (ب في بايتات) { أضف(جسم، ب) }
}

دالة _ثابت(ن) { _ضع([٦٥] + _وحدة_موقعة(ن)) }

# ---------- المحليات ----------
دالة _عرّف_محلي(اسم) {
    إذا (ليس يحوي(محليات، اسم)) {
        محليات[اسم] = عدد_المحليات
        عدد_المحليات = عدد_المحليات + ١
    }
}

دالة _اجمع_محليات(كتلة) {
    من_أجل (ج في كتلة["statements"]) { _اجمع_من_جملة(ج) }
}

دالة _اجمع_من_جملة(ج) {
    متغير ك = ج["kind"]
    إذا (ك == "VarDecl") {
        _عرّف_محلي(ج["name"])
    } وإلا إذا (ك == "If") {
        _اجمع_محليات(ج["thenBlock"])
        إذا (ج["elseBlock"] != لاشيء) { _اجمع_محليات(ج["elseBlock"]) }
    } وإلا إذا (ك == "While") {
        _اجمع_محليات(ج["body"])
    } وإلا إذا (ك == "For") {
        _عرّف_محلي(ج["varName"])
        عدّاد_مؤقت = عدّاد_مؤقت + ١
        _عرّف_محلي("@نهاية" + نص_برمجي(عدّاد_مؤقت))
        _اجمع_محليات(ج["body"])
    } وإلا إذا (ك == "Block") {
        _اجمع_محليات(ج)
    } وإلا إذا (ك == "Multi") {
        من_أجل (س في ج["statements"]) { _اجمع_من_جملة(س) }
    }
}

# ---------- التعابير ----------
متغير ثنائية = {"PLUS": [١٠٦]، "MINUS": [١٠٧]، "STAR": [١٠٨]، "SLASH": [١٠٩]، "PERCENT": [١١١]، "EQ": [٧٠]، "NEQ": [٧١]، "LT": [٧٢]، "GT": [٧٤]، "LTE": [٧٦]، "GTE": [٧٨]}
متغير مدمجات_ثنائية = {"بتّ_و": [١١٣]، "بتّ_أو": [١١٤]، "بتّ_خاص": [١١٥]، "يسار": [١١٦]، "يمين": [١١٧]، "يمين_موجب": [١١٨]}

# أعداد الفاصلة العائمة (f64): تُخزَّن في صناديق ٨ بايتات في الذاكرة؛ المدمجات تأخذ عناوين الصناديق (الوجهة أولًا)
متغير ف٦٤_ثلاثية = {"ف٦٤_جمع": [١٦٠]، "ف٦٤_طرح": [١٦١]، "ف٦٤_ضرب": [١٦٢]، "ف٦٤_قسمة": [١٦٣]}
متغير ف٦٤_أحادية = {"ف٦٤_أرضية": [١٥٦]، "ف٦٤_قصّ": [١٥٧]، "ف٦٤_سالب": [١٥٤]، "ف٦٤_جذر": [١٥٩]، "ف٦٤_مطلق": [١٥٣]، "ف٦٤_نسخ": []}
متغير ف٦٤_مقارنة = {"ف٦٤_يساوي": [٩٧]، "ف٦٤_لا_يساوي": [٩٨]، "ف٦٤_أصغر": [٩٩]، "ف٦٤_أكبر": [١٠٠]، "ف٦٤_أصغر_أو_يساوي": [١٠١]، "ف٦٤_أكبر_أو_يساوي": [١٠٢]}
متغير ف٦٤_تحميل = [٤٣، ٣، ٠]
متغير ف٦٤_تخزين = [٥٧، ٣، ٠]

# مدمجات f64؛ ترجع «صحيح» إن عالجت الاسم
دالة _مدمج_ف٦٤(اسم، وسائط، قيمة) {
    إذا (يحوي(ف٦٤_ثلاثية، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٣)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع(ف٦٤_تحميل)
        _عبّر(وسائط[٢])
        _ضع(ف٦٤_تحميل)
        _ضع(ف٦٤_ثلاثية[اسم])
        _ضع(ف٦٤_تخزين)
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    إذا (يحوي(ف٦٤_أحادية، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع(ف٦٤_تحميل)
        _ضع(ف٦٤_أحادية[اسم])
        _ضع(ف٦٤_تخزين)
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    إذا (يحوي(ف٦٤_مقارنة، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _عبّر(وسائط[١])
        _ضع(ف٦٤_تحميل)
        _ضع(ف٦٤_مقارنة[اسم])
        إذا (ليس قيمة) { _ضع([٢٦]) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_من_صحيح") {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([١٨٣])
        _ضع(ف٦٤_تخزين)
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_إلى_صحيح") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _ضع([٢٥٢، ٢])
        إذا (ليس قيمة) { _ضع([٢٦]) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_هل_صحيح") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _ضع([١٥٦، ٩٧])
        إذا (ليس قيمة) { _ضع([٢٦]) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_ثابت") {
        _تحقق_عدد(اسم، وسائط، ٣)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[٢])
        _ضع([٥٤، ٢، ٠])
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([٥٤، ٢، ٤])
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    ارجع خطأ
}

دالة _عبّر(ع) {
    إذا (يحوي(ع، "line") و ع["line"] != لاشيء) { سطر = ع["line"] }
    متغير ك = ع["kind"]
    إذا (ك == "Number") {
        إذا (أرضية(ع["value"]) != ع["value"] أو ع["value"] > ٢١٤٧٤٨٣٦٤٧ أو ع["value"] < -٢١٤٧٤٨٣٦٤٨) { _خطأ("الأعداد في ضاد-نواة صحيحة ٣٢ بتًا، ولا يصلح «" + نص(ع["value"]) + "»") }
        _ثابت(ع["value"])
    } وإلا إذا (ك == "Boolean") {
        إذا (ع["value"]) { _ثابت(١) } وإلا { _ثابت(٠) }
    } وإلا إذا (ك == "Null") {
        _ثابت(٠)
    } وإلا إذا (ك == "Identifier") {
        إذا (يحوي(محليات، ع["name"])) {
            _ضع([٣٢] + _وحدة_غير_موقعة(محليات[ع["name"]]))
        } وإلا إذا (يحوي(عامة_فهرس، ع["name"])) {
            _ضع([٣٥] + _وحدة_غير_موقعة(عامة_فهرس[ع["name"]]))
        } وإلا {
            _خطأ("متغير غير معرّف: " + ع["name"])
        }
    } وإلا إذا (ك == "UnaryOp") {
        إذا (ع["op"] == "ليس") {
            _عبّر(ع["expr"])
            _ضع([٦٩])
        } وإلا {
            # السالب: ٠ - س
            _ثابت(٠)
            _عبّر(ع["expr"])
            _ضع([١٠٧])
        }
    } وإلا إذا (ك == "BinOp") {
        _ثنائي(ع)
    } وإلا إذا (ك == "Assign") {
        _إسناد(ع)
        _ثابت(٠)
    } وإلا إذا (ك == "Call") {
        _استدعاء(ع، صحيح)
    } وإلا {
        _خطأ("غير مدعوم في ضاد-نواة: " + ك)
    }
}

دالة _ثنائي(ع) {
    متغير عملية = ع["op"]
    إذا (عملية == "و") {
        _عبّر(ع["left"])
        _ضع([٤، ١٢٧])
        _عمق_زائد()
        _عبّر(ع["right"])
        _ضع([٥])
        _ثابت(٠)
        _ضع([١١])
        _عمق_ناقص()
    } وإلا إذا (عملية == "أو") {
        _عبّر(ع["left"])
        _ضع([٤، ١٢٧])
        _عمق_زائد()
        _ثابت(١)
        _ضع([٥])
        _عبّر(ع["right"])
        _ضع([١١])
        _عمق_ناقص()
    } وإلا {
        إذا (ليس يحوي(ثنائية، عملية)) { _خطأ("عملية غير مدعومة في ضاد-نواة: " + عملية) }
        _عبّر(ع["left"])
        _عبّر(ع["right"])
        _ضع(ثنائية[عملية])
    }
}

دالة _عمق_زائد() { عمق = عمق + ١ }
دالة _عمق_ناقص() { عمق = عمق - ١ }

دالة _إسناد(ع) {
    إذا (ع["target"]["kind"] != "Identifier") { _خطأ("الإسناد في ضاد-نواة إلى متغير فقط") }
    متغير ا = ع["target"]["name"]
    إذا (ليس يحوي(محليات، ا) و ليس يحوي(عامة_فهرس، ا)) { _خطأ("المتغير «" + ا + "» غير معرّف — عرّفه بـ متغير") }
    _عبّر(ع["expr"])
    إذا (يحوي(محليات، ا)) {
        _ضع([٣٣] + _وحدة_غير_موقعة(محليات[ا]))
    } وإلا {
        _ضع([٣٦] + _وحدة_غير_موقعة(عامة_فهرس[ا]))
    }
}

# قيمة: هل نحتاج قيمة على المكدّس؟ (المدمجات التي لا ترجع شيئًا نضيف لها صفرًا عند الحاجة)
دالة _استدعاء(ع، قيمة) {
    إذا (ع["callee"]["kind"] != "Identifier") { _خطأ("الاستدعاء في ضاد-نواة باسم دالة فقط") }
    متغير اسم = ع["callee"]["name"]
    متغير وسائط = ع["args"]
    إذا (_مدمج_ف٦٤(اسم، وسائط، قيمة)) { ارجع لاشيء }
    إذا (يحوي(مدمجات_ثنائية، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع(مدمجات_ثنائية[اسم])
        ارجع لاشيء
    }
    إذا (اسم == "حمّل") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([٤٠، ٢، ٠])
    } وإلا إذا (اسم == "حمّل_بايت") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([٤٥، ٠، ٠])
    } وإلا إذا (اسم == "خزّن") {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([٥٤، ٢، ٠])
        إذا (قيمة) { _ثابت(٠) }
    } وإلا إذا (اسم == "خزّن_بايت") {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([٥٨، ٠، ٠])
        إذا (قيمة) { _ثابت(٠) }
    } وإلا إذا (اسم == "حجم_ذاكرة") {
        _تحقق_عدد(اسم، وسائط، ٠)
        _ضع([٦٣، ٠])
        إذا (ليس قيمة) { _ضع([٢٦]) }
    } وإلا إذا (اسم == "كبّر_ذاكرة") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([٦٤، ٠])
        إذا (ليس قيمة) { _ضع([٢٦]) }
    } وإلا إذا (اسم == "اطبع_رقم") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([١٦، ٠])
        إذا (قيمة) { _ثابت(٠) }
    } وإلا {
        إذا (ليس يحوي(فهرس_دالة، اسم)) { _خطأ("دالة غير معرّفة: " + اسم) }
        متغير ف = فهرس_دالة[اسم]
        إذا (طول(وسائط) != ف["arity"]) { _خطأ("الدالة «" + اسم + "» تحتاج " + نص_برمجي(ف["arity"]) + " وسائط لكنها استُدعيت بـ " + نص_برمجي(طول(وسائط))) }
        من_أجل (وس في وسائط) { _عبّر(وس) }
        _ضع([١٦] + _وحدة_غير_موقعة(ف["index"] + ١))
    }
}

دالة _تحقق_عدد(اسم، وسائط، ن) {
    إذا (طول(وسائط) != ن) { _خطأ("«" + اسم + "» تحتاج " + نص_برمجي(ن) + " وسائط") }
}

# ---------- الجمل ----------
دالة _كتلة(ك) {
    من_أجل (ج في ك["statements"]) { _جملة(ج) }
}

دالة _جملة(ج) {
    إذا (يحوي(ج، "line") و ج["line"] != لاشيء) { سطر = ج["line"] }
    متغير ك = ج["kind"]
    إذا (ك == "ExprStmt") {
        إذا (ج["expr"]["kind"] == "Call") {
            _استدعاء_جملة(ج["expr"])
        } وإلا إذا (ج["expr"]["kind"] == "Assign") {
            _إسناد(ج["expr"])
        } وإلا {
            _عبّر(ج["expr"])
            _ضع([٢٦])
        }
    } وإلا إذا (ك == "VarDecl") {
        _عبّر(ج["expr"])
        _ضع([٣٣] + _وحدة_غير_موقعة(محليات[ج["name"]]))
    } وإلا إذا (ك == "If") {
        _عبّر(ج["cond"])
        _ضع([٤، ٦٤])
        _عمق_زائد()
        _كتلة(ج["thenBlock"])
        إذا (ج["elseBlock"] != لاشيء) {
            _ضع([٥])
            _كتلة(ج["elseBlock"])
        }
        _ضع([١١])
        _عمق_ناقص()
    } وإلا إذا (ك == "While") {
        _حلقة_طالما(ج)
    } وإلا إذا (ك == "For") {
        _حلقة_من_إلى(ج)
    } وإلا إذا (ك == "Return") {
        إذا (ج["expr"] != لاشيء) { _عبّر(ج["expr"]) } وإلا { _ثابت(٠) }
        _ضع([١٥])
    } وإلا إذا (ك == "Break") {
        إذا (طول(حلقات) == ٠) { _خطأ("توقف خارج حلقة") }
        _ضع([١٢] + _وحدة_غير_موقعة(عمق - حلقات[طول(حلقات) - ١]["break"]))
    } وإلا إذا (ك == "Continue") {
        إذا (طول(حلقات) == ٠) { _خطأ("أكمل خارج حلقة") }
        _ضع([١٢] + _وحدة_غير_موقعة(عمق - حلقات[طول(حلقات) - ١]["continue"]))
    } وإلا إذا (ك == "Block") {
        _كتلة(ج)
    } وإلا إذا (ك == "Multi") {
        من_أجل (س في ج["statements"]) { _جملة(س) }
    } وإلا {
        _خطأ("غير مدعوم في ضاد-نواة: " + ك)
    }
}

# استدعاء كجملة: لا نترك قيمة على المكدّس
دالة _استدعاء_جملة(ع) {
    متغير اسم = ع["callee"]["name"]
    إذا (ع["callee"]["kind"] == "Identifier" و (اسم == "خزّن" أو اسم == "خزّن_بايت" أو اسم == "اطبع_رقم" أو يحوي(ف٦٤_ثلاثية، اسم) أو يحوي(ف٦٤_أحادية، اسم) أو اسم == "ف٦٤_من_صحيح" أو اسم == "ف٦٤_ثابت")) {
        _استدعاء(ع، خطأ)
    } وإلا {
        _استدعاء(ع، صحيح)
        _ضع([٢٦])
    }
}

دالة _حلقة_طالما(ج) {
    _ضع([٢، ٦٤])
    _عمق_زائد()
    متغير ب = عمق
    _ضع([٣، ٦٤])
    _عمق_زائد()
    متغير ح = عمق
    أضف(حلقات، {"break": ب، "continue": ح})
    _عبّر(ج["cond"])
    _ضع([٦٩، ١٣، ١])
    _كتلة(ج["body"])
    _ضع([١٢، ٠])
    انزع(حلقات)
    _ضع([١١])
    _عمق_ناقص()
    _ضع([١١])
    _عمق_ناقص()
}

دالة _حلقة_من_إلى(ج) {
    عدّاد_مؤقت = عدّاد_مؤقت + ١
    متغير خطوة = ١
    إذا (ج["step"] != لاشيء) {
        إذا (ج["step"]["kind"] == "Number") {
            خطوة = ج["step"]["value"]
        } وإلا إذا (ج["step"]["kind"] == "UnaryOp" و ج["step"]["expr"]["kind"] == "Number") {
            خطوة = -ج["step"]["expr"]["value"]
        } وإلا {
            _خطأ("خطوة من_أجل في ضاد-نواة عدد ثابت")
        }
        إذا (خطوة == ٠) { _خطأ("خطوة الحلقة لا يمكن أن تكون صفرًا") }
    }
    متغير س = محليات[ج["varName"]]
    متغير ن = محليات["@نهاية" + نص_برمجي(عدّاد_مؤقت)]
    _عبّر(ج["start"])
    _ضع([٣٣] + _وحدة_غير_موقعة(س))
    _عبّر(ج["end"])
    _ضع([٣٣] + _وحدة_غير_موقعة(ن))
    _ضع([٢، ٦٤])
    _عمق_زائد()
    متغير ب = عمق
    _ضع([٣، ٦٤])
    _عمق_زائد()
    متغير ح = عمق
    _ضع([٣٢] + _وحدة_غير_موقعة(س))
    _ضع([٣٢] + _وحدة_غير_موقعة(ن))
    إذا (خطوة > ٠) { _ضع([٧٦]) } وإلا { _ضع([٧٨]) }
    _ضع([٦٩، ١٣، ١])
    _ضع([٢، ٦٤])
    _عمق_زائد()
    أضف(حلقات، {"break": ب، "continue": عمق})
    _كتلة(ج["body"])
    انزع(حلقات)
    _ضع([١١])
    _عمق_ناقص()
    _ضع([٣٢] + _وحدة_غير_موقعة(س))
    _ثابت(خطوة)
    _ضع([١٠٦])
    _ضع([٣٣] + _وحدة_غير_موقعة(س))
    _ضع([١٢، ٠])
    _ضع([١١])
    _عمق_ناقص()
    _ضع([١١])
    _عمق_ناقص()
}

# ---------- الوحدة ----------
دالة _اجمع_الدوال(برنامج) {
    متغير قائمة = []
    عامة_فهرس = {}
    عامة_قيم = []
    من_أجل (ج في برنامج["statements"]) {
        إذا (يحوي(ج، "line") و ج["line"] != لاشيء) { سطر = ج["line"] }
        إذا (ج["kind"] == "VarDecl") {
            إذا (يحوي(عامة_فهرس، ج["name"])) { _خطأ("المتغير العام «" + ج["name"] + "» معرَّف مرتين") }
            متغير ق = ج["expr"]
            متغير قيمة = ٠
            إذا (ق == لاشيء) {
                قيمة = ٠
            } وإلا إذا (ق["kind"] == "Number") {
                قيمة = ق["value"]
            } وإلا إذا (ق["kind"] == "UnaryOp" و ق["op"] == "-" و ق["expr"]["kind"] == "Number") {
                قيمة = -ق["expr"]["value"]
            } وإلا إذا (ق["kind"] == "Boolean") {
                إذا (ق["value"]) { قيمة = ١ }
            } وإلا {
                _خطأ("قيمة المتغير العام «" + ج["name"] + "» عدد ثابت في ضاد-نواة")
            }
            عامة_فهرس[ج["name"]] = طول(عامة_قيم)
            أضف(عامة_قيم، قيمة)
        } وإلا إذا (ج["kind"] == "FuncDecl") {
            أضف(قائمة، {"decl": ج، "export": خطأ})
        } وإلا إذا (ج["kind"] == "Export" و ج["stmt"]["kind"] == "FuncDecl") {
            أضف(قائمة، {"decl": ج["stmt"]، "export": صحيح})
        } وإلا {
            _خطأ("المستوى الأعلى في ضاد-نواة يقبل تعريف الدوال فقط")
        }
    }
    ارجع قائمة
}

دالة _صرّف_دالة(ف) {
    جسم = []
    محليات = {}
    عدد_المحليات = ٠
    عمق = ٠
    حلقات = []
    عدّاد_مؤقت = ٠
    من_أجل (م في ف["decl"]["params"]) { _عرّف_محلي(م) }
    _اجمع_محليات(ف["decl"]["body"])
    عدّاد_مؤقت = ٠
    _كتلة(ف["decl"]["body"])
    _ثابت(٠)
    _ضع([١١])
    متغير إضافية = عدد_المحليات - طول(ف["decl"]["params"])
    متغير مقدمة = []
    إذا (إضافية > ٠) { مقدمة = _وحدة_غير_موقعة(١) + _وحدة_غير_موقعة(إضافية) + [١٢٧] } وإلا { مقدمة = _وحدة_غير_موقعة(٠) }
    متغير كل = مقدمة + جسم
    ارجع _وحدة_غير_موقعة(طول(كل)) + كل
}

# المخرج: قائمة بايتات ملف WebAssembly. المصدر نص ضاد-نواة.
# مع مكتبة تشغيل: تُحلَّل المكتبة والمصدر كلٌّ على حدة (فتبقى أرقام الأسطر صحيحة) ثم تُدمج جملهما
صدّر دالة صرّف_نواة_مع(مكتبة، مصدر) {
    متغير ب١ = _م_محلل.حلّل(مكتبة)
    متغير ب٢ = _م_محلل.حلّل(مصدر)
    ب٢["statements"] = ب١["statements"] + ب٢["statements"]
    ارجع _صرّف_برنامج(ب٢)
}

صدّر دالة صرّف_نواة(مصدر) {
    ارجع _صرّف_برنامج(_م_محلل.حلّل(مصدر))
}

دالة _صرّف_برنامج(برنامج) {
    دوال_المصدر = _اجمع_الدوال(برنامج)
    فهرس_دالة = {}
    متغير ي = ٠
    من_أجل (ف في دوال_المصدر) {
        إذا (يحوي(فهرس_دالة، ف["decl"]["name"])) { سطر = ف["decl"]["line"]
            _خطأ("الدالة «" + ف["decl"]["name"] + "» معرَّفة مرتين") }
        فهرس_دالة[ف["decl"]["name"]] = {"index": ي، "arity": طول(ف["decl"]["params"])}
        ي = ي + ١
    }
    # الأنواع: ٠ = استيراد (i32)->()، ثم نوع لكل عدد معاملات مميّز (i32 × ن)->i32
    متغير أنواع = []
    متغير فهرس_النوع = {}
    متغير بايتات_الأنواع = [٩٦، ١، ١٢٧، ٠]
    أضف(أنواع، "استيراد")
    من_أجل (ف في دوال_المصدر) {
        متغير ن = طول(ف["decl"]["params"])
        إذا (ليس يحوي(فهرس_النوع، نص_برمجي(ن))) {
            فهرس_النوع[نص_برمجي(ن)] = طول(أنواع)
            أضف(أنواع، ن)
            متغير معاملات = []
            من_أجل (ك من ١ إلى ن) { أضف(معاملات، ١٢٧) }
            بايتات_الأنواع = بايتات_الأنواع + [٩٦] + _متجه(معاملات) + [١، ١٢٧]
        }
    }
    متغير قسم_الأنواع = _قسم(١، _وحدة_غير_موقعة(طول(أنواع)) + بايتات_الأنواع)
    متغير قسم_الاستيراد = _قسم(٢، _وحدة_غير_موقعة(١) + _بايتات_اسم("بيئة") + _بايتات_اسم("اطبع_رقم") + [٠، ٠])
    متغير أرقام_الأنواع = []
    من_أجل (ف في دوال_المصدر) { أرقام_الأنواع = أرقام_الأنواع + _وحدة_غير_موقعة(فهرس_النوع[نص_برمجي(طول(ف["decl"]["params"]))]) }
    متغير قسم_الدوال = _قسم(٣، _وحدة_غير_موقعة(طول(دوال_المصدر)) + أرقام_الأنواع)
    متغير قسم_الذاكرة = _قسم(٥، [١، ٠، ١])
    متغير بايتات_العامة = _وحدة_غير_موقعة(طول(عامة_قيم))
    من_أجل (ق في عامة_قيم) { بايتات_العامة = بايتات_العامة + [١٢٧، ١] + [٦٥] + _وحدة_موقعة(ق) + [١١] }
    متغير قسم_العامة = []
    إذا (طول(عامة_قيم) > ٠) { قسم_العامة = _قسم(٦، بايتات_العامة) }
    متغير صادرات = []
    متغير عدد_الصادرات = ١
    صادرات = _بايتات_اسم("ذاكرة") + [٢، ٠]
    ي = ٠
    من_أجل (ف في دوال_المصدر) {
        إذا (ف["export"]) {
            صادرات = صادرات + _بايتات_اسم(ف["decl"]["name"]) + [٠] + _وحدة_غير_موقعة(ي + ١)
            عدد_الصادرات = عدد_الصادرات + ١
        }
        ي = ي + ١
    }
    متغير قسم_الصادرات = _قسم(٧، _وحدة_غير_موقعة(عدد_الصادرات) + صادرات)
    متغير أجسام = []
    من_أجل (ف في دوال_المصدر) {
        سطر = ف["decl"]["line"]
        أجسام = أجسام + _صرّف_دالة(ف)
    }
    متغير قسم_الشيفرة = _قسم(١٠، _وحدة_غير_موقعة(طول(دوال_المصدر)) + أجسام)
    ارجع [٠، ٩٧، ١١٥، ١٠٩، ١، ٠، ٠، ٠] + قسم_الأنواع + قسم_الاستيراد + قسم_الدوال + قسم_الذاكرة + قسم_العامة + قسم_الصادرات + قسم_الشيفرة
}
