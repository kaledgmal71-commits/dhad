# مصرِّف «ضاد-نواة» إلى WebAssembly، مكتوب بضاد (الاستقلال، المرحلة ٦ب/٦ج).
# ضاد-نواة: مجموعة جزئية من ضاد نفسها (الصياغة نفسها يقرؤها محلل ضاد) كل أعدادها صحيحة ٣٢ بتًا،
# تُترجَم مباشرة إلى ملف .wasm ثنائي بلا أي أداة خارجية. المخرج قائمة بايتات.
#
# المدعوم: دوال بمعاملات صحيحة تُرجع صحيحًا، متغيرات محلية، + - * / % مقارنات، و أو ليس، إذا/وإلا، طالما،
#   من_أجل (س من ا إلى ب [بخطوة ثابتة])، توقف، أكمل، ارجع، استدعاء الدوال والذاتي.
#   مدمجات: حمّل(ع) خزّن(ع، ق) حمّل_بايت(ع) خزّن_بايت(ع، ق) بتّ_و بتّ_أو بتّ_خاص يسار يمين يمين_موجب اطبع_رقم(ق)
#   ذاكرة خطية من صفحة واحدة تُصدَّر باسم «ذاكرة».
# القسمة على صفر تُسقط البرنامج (trap) كما هو معتاد في WebAssembly.

متغير _م_محلل = استورد("محلل")
متغير _م_نطاقات = استورد("نطاقات")

# ---------- الترميز الثنائي ----------
دالة _وحدة_غير_موقعة(ن) {
    متغير خرج = []
    متغير ق = ن
    طالما (صحيح) {
        متغير ب = ق % ١٢٨
        ق = أرضية(ق / ١٢٨)
        إذا (ق > ٠) {
            أضف(خرج، ب + ١٢٨)
        } وإلا {
            أضف(خرج، ب)
            توقف
        }
    }
    ارجع خرج
}

دالة _وحدة_موقعة(ن) {
    متغير خرج = []
    متغير ق = ن
    طالما (صحيح) {
        متغير ب = ((ق % ١٢٨) + ١٢٨) % ١٢٨
        ق = أرضية(ق / ١٢٨)
        إذا ((ق == ٠ و ب < ٦٤) أو (ق == -١ و ب >= ٦٤)) {
            أضف(خرج، ب)
            توقف
        }
        أضف(خرج، ب + ١٢٨)
    }
    ارجع خرج
}

دالة _متجه(بايتات) { ارجع _وحدة_غير_موقعة(طول(بايتات)) + بايتات }

دالة _بايتات_اسم(نص_الاسم) { ارجع _متجه(_بايتات_خام(نص_الاسم)) }
دالة _بايتات_خام(نص_الاسم) {
    متغير خرج = []
    من_أجل (ح في نص_الاسم) {
        متغير ر = رمز(ح)
        إذا (ر < ١٢٨) {
            أضف(خرج، ر)
        } وإلا إذا (ر < ٢٠٤٨) {
            أضف(خرج، ١٩٢ + أرضية(ر / ٦٤))
            أضف(خرج، ١٢٨ + ر % ٦٤)
        } وإلا {
            أضف(خرج، ٢٢٤ + أرضية(ر / ٤٠٩٦))
            أضف(خرج، ١٢٨ + أرضية(ر / ٦٤) % ٦٤)
            أضف(خرج، ١٢٨ + ر % ٦٤)
        }
    }
    ارجع خرج
}

دالة _قسم(رقم، محتوى) { ارجع [رقم] + _وحدة_غير_موقعة(طول(محتوى)) + محتوى }

# ---------- حالة التصريف ----------
متغير دوال_المصدر = []
متغير فهرس_دالة = {}
متغير جسم = []
متغير محليات = {}
متغير عدد_المحليات = ٠
متغير عمق = ٠
متغير حلقات = []
# كتل «أخيرًا» المفتوحة حاليًا (الأعمق آخرًا): يُنفَّذ جسمها قبل الخروج بـ ارجع/توقف/أكمل
متغير نهايات = []
# محلّيات مؤقتة تحمل قاعدة السلسلة الاختيارية ?. الجارية (القمة هي المستعملة)
متغير قواعد_سلسلة = []
متغير عدّاد_مؤقت = ٠
متغير سطر = ٠
متغير عامة_فهرس = {}
متغير عامة_قيم = []
# الوضع الديناميكي (ضاد الكاملة فوق القيم الموسومة): يُفعَّل لكل دالة تأتي من مصدر المستخدم
متغير ديناميكي = خطأ
متغير بيانات_ثابتة = []
متغير فهرس_السلاسل = {}
متغير بداية_البيانات = ٢٠٤٨٨
متغير سياق_حالي = لاشيء
متغير وكلاء = {}

دالة _خطأ(رسالة) {
    أطلق_خطأ("ضاد-نواة: السطر " + نص_برمجي(سطر) + ": " + رسالة)
}

دالة _ضع(بايتات) {
    من_أجل (ب في بايتات) { أضف(جسم، ب) }
}

دالة _ثابت(ن) { _ضع([٦٥] + _وحدة_موقعة(ن)) }

# ---------- المحليات ----------
دالة _عرّف_محلي(اسم) {
    إذا (ليس يحوي(محليات، اسم)) {
        محليات[اسم] = عدد_المحليات
        عدد_المحليات = عدد_المحليات + ١
    }
}

دالة _اجمع_محليات(كتلة) {
    من_أجل (ج في كتلة["statements"]) { _اجمع_من_جملة(ج) }
}

دالة _اجمع_من_جملة(ج) {
    متغير ك = ج["kind"]
    إذا (ك == "VarDecl") {
        _عرّف_محلي(ج["name"])
    } وإلا إذا (ك == "If") {
        _اجمع_محليات(ج["thenBlock"])
        إذا (ج["elseBlock"] != لاشيء) { _اجمع_محليات(ج["elseBlock"]) }
    } وإلا إذا (ك == "While") {
        _اجمع_محليات(ج["body"])
    } وإلا إذا (ك == "For") {
        _عرّف_محلي(ج["varName"])
        عدّاد_مؤقت = عدّاد_مؤقت + ١
        _عرّف_محلي("@نهاية" + نص_برمجي(عدّاد_مؤقت))
        _اجمع_محليات(ج["body"])
    } وإلا إذا (ك == "Block") {
        _اجمع_محليات(ج)
    } وإلا إذا (ك == "Multi") {
        من_أجل (س في ج["statements"]) { _اجمع_من_جملة(س) }
    }
}

# ---------- التعابير ----------
متغير ثنائية = {"PLUS": [١٠٦]، "MINUS": [١٠٧]، "STAR": [١٠٨]، "SLASH": [١٠٩]، "PERCENT": [١١١]، "EQ": [٧٠]، "NEQ": [٧١]، "LT": [٧٢]، "GT": [٧٤]، "LTE": [٧٦]، "GTE": [٧٨]}
متغير مدمجات_ثنائية = {"بتّ_و": [١١٣]، "بتّ_أو": [١١٤]، "بتّ_خاص": [١١٥]، "يسار": [١١٦]، "يمين": [١١٧]، "يمين_موجب": [١١٨]}

# أعداد الفاصلة العائمة (f64): تُخزَّن في صناديق ٨ بايتات في الذاكرة؛ المدمجات تأخذ عناوين الصناديق (الوجهة أولًا)
متغير ف٦٤_ثلاثية = {"ف٦٤_جمع": [١٦٠]، "ف٦٤_طرح": [١٦١]، "ف٦٤_ضرب": [١٦٢]، "ف٦٤_قسمة": [١٦٣]}
متغير ف٦٤_أحادية = {"ف٦٤_أرضية": [١٥٦]، "ف٦٤_قصّ": [١٥٧]، "ف٦٤_سالب": [١٥٤]، "ف٦٤_جذر": [١٥٩]، "ف٦٤_مطلق": [١٥٣]، "ف٦٤_نسخ": []}
متغير ف٦٤_مقارنة = {"ف٦٤_يساوي": [٩٧]، "ف٦٤_لا_يساوي": [٩٨]، "ف٦٤_أصغر": [٩٩]، "ف٦٤_أكبر": [١٠٠]، "ف٦٤_أصغر_أو_يساوي": [١٠١]، "ف٦٤_أكبر_أو_يساوي": [١٠٢]}
متغير ف٦٤_تحميل = [٤٣، ٣، ٠]
متغير ف٦٤_تخزين = [٥٧، ٣، ٠]

# مدمجات f64؛ ترجع «صحيح» إن عالجت الاسم
دالة _مدمج_ف٦٤(اسم، وسائط، قيمة) {
    إذا (يحوي(ف٦٤_ثلاثية، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٣)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع(ف٦٤_تحميل)
        _عبّر(وسائط[٢])
        _ضع(ف٦٤_تحميل)
        _ضع(ف٦٤_ثلاثية[اسم])
        _ضع(ف٦٤_تخزين)
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    إذا (يحوي(ف٦٤_أحادية، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع(ف٦٤_تحميل)
        _ضع(ف٦٤_أحادية[اسم])
        _ضع(ف٦٤_تخزين)
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    إذا (يحوي(ف٦٤_مقارنة، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _عبّر(وسائط[١])
        _ضع(ف٦٤_تحميل)
        _ضع(ف٦٤_مقارنة[اسم])
        إذا (ليس قيمة) { _ضع([٢٦]) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_من_صحيح") {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([١٨٣])
        _ضع(ف٦٤_تخزين)
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_إلى_صحيح") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _ضع([٢٥٢، ٢])
        إذا (ليس قيمة) { _ضع([٢٦]) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_هل_صحيح") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _عبّر(وسائط[٠])
        _ضع(ف٦٤_تحميل)
        _ضع([١٥٦، ٩٧])
        إذا (ليس قيمة) { _ضع([٢٦]) }
        ارجع صحيح
    }
    إذا (اسم == "ف٦٤_ثابت") {
        _تحقق_عدد(اسم، وسائط، ٣)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[٢])
        _ضع([٥٤، ٢، ٠])
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([٥٤، ٢، ٤])
        إذا (قيمة) { _ثابت(٠) }
        ارجع صحيح
    }
    ارجع خطأ
}

دالة _عبّر(ع) {
    إذا (يحوي(ع، "line") و ع["line"] != لاشيء) { سطر = ع["line"] }
    متغير ك = ع["kind"]
    إذا (ديناميكي) {
        _عبّر_د(ع)
        ارجع لاشيء
    }
    إذا (ك == "Number") {
        إذا (أرضية(ع["value"]) != ع["value"] أو ع["value"] > ٢١٤٧٤٨٣٦٤٧ أو ع["value"] < -٢١٤٧٤٨٣٦٤٨) { _خطأ("الأعداد في ضاد-نواة صحيحة ٣٢ بتًا، ولا يصلح «" + نص(ع["value"]) + "»") }
        _ثابت(ع["value"])
    } وإلا إذا (ك == "Boolean") {
        إذا (ع["value"]) { _ثابت(١) } وإلا { _ثابت(٠) }
    } وإلا إذا (ك == "Null") {
        _ثابت(٠)
    } وإلا إذا (ك == "Identifier") {
        إذا (يحوي(محليات، ع["name"])) {
            _ضع([٣٢] + _وحدة_غير_موقعة(محليات[ع["name"]]))
        } وإلا إذا (يحوي(عامة_فهرس، ع["name"])) {
            _ضع([٣٥] + _وحدة_غير_موقعة(عامة_فهرس[ع["name"]]))
        } وإلا {
            _خطأ("متغير غير معرّف: " + ع["name"])
        }
    } وإلا إذا (ك == "UnaryOp") {
        إذا (ع["op"] == "ليس") {
            _عبّر(ع["expr"])
            _ضع([٦٩])
        } وإلا {
            # السالب: ٠ - س
            _ثابت(٠)
            _عبّر(ع["expr"])
            _ضع([١٠٧])
        }
    } وإلا إذا (ك == "BinOp") {
        _ثنائي(ع)
    } وإلا إذا (ك == "Assign") {
        _إسناد(ع)
        _ثابت(٠)
    } وإلا إذا (ك == "Call") {
        _استدعاء(ع، صحيح)
    } وإلا {
        _خطأ("غير مدعوم في ضاد-نواة: " + ك)
    }
}

دالة _ثنائي(ع) {
    متغير عملية = ع["op"]
    إذا (عملية == "و") {
        _عبّر(ع["left"])
        _ضع([٤، ١٢٧])
        _عمق_زائد()
        _عبّر(ع["right"])
        _ضع([٥])
        _ثابت(٠)
        _ضع([١١])
        _عمق_ناقص()
    } وإلا إذا (عملية == "أو") {
        _عبّر(ع["left"])
        _ضع([٤، ١٢٧])
        _عمق_زائد()
        _ثابت(١)
        _ضع([٥])
        _عبّر(ع["right"])
        _ضع([١١])
        _عمق_ناقص()
    } وإلا {
        إذا (ليس يحوي(ثنائية، عملية)) { _خطأ("عملية غير مدعومة في ضاد-نواة: " + عملية) }
        _عبّر(ع["left"])
        _عبّر(ع["right"])
        _ضع(ثنائية[عملية])
    }
}

دالة _عمق_زائد() { عمق = عمق + ١ }
دالة _عمق_ناقص() { عمق = عمق - ١ }

دالة _إسناد(ع) {
    إذا (ديناميكي و ع["target"]["kind"] == "Index") {
        _عبّر(ع["target"]["obj"])
        _عبّر(ع["target"]["index"])
        _عبّر(ع["expr"])
        _استدع_ق("ق_ع_اضبط_فهرس")
        _ضع([٢٦])
        ارجع لاشيء
    }
    إذا (ديناميكي و ع["target"]["ref"] != لاشيء) {
        _إسناد_مرجع_د(ع["target"]["ref"]، ع["expr"])
        ارجع لاشيء
    }
    إذا (ع["target"]["kind"] != "Identifier") { _خطأ("الإسناد في ضاد-نواة إلى متغير فقط") }
    متغير ا = ع["target"]["name"]
    إذا (ليس يحوي(محليات، ا) و ليس يحوي(عامة_فهرس، ا)) { _خطأ("المتغير «" + ا + "» غير معرّف — عرّفه بـ متغير") }
    _عبّر(ع["expr"])
    إذا (يحوي(محليات، ا)) {
        _ضع([٣٣] + _وحدة_غير_موقعة(محليات[ا]))
    } وإلا {
        _ضع([٣٦] + _وحدة_غير_موقعة(عامة_فهرس[ا]))
    }
}

# قيمة: هل نحتاج قيمة على المكدّس؟ (المدمجات التي لا ترجع شيئًا نضيف لها صفرًا عند الحاجة)
دالة _استدعاء(ع، قيمة) {
    إذا (ديناميكي) {
        _استدعاء_د(ع)
        ارجع لاشيء
    }
    إذا (ع["callee"]["kind"] != "Identifier") { _خطأ("الاستدعاء في ضاد-نواة باسم دالة فقط") }
    متغير اسم = ع["callee"]["name"]
    متغير وسائط = ع["args"]
    إذا (_مدمج_ف٦٤(اسم، وسائط، قيمة)) { ارجع لاشيء }
    إذا (يحوي(مدمجات_ثنائية، اسم)) {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع(مدمجات_ثنائية[اسم])
        ارجع لاشيء
    }
    إذا (اسم == "حمّل") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([٤٠، ٢، ٠])
    } وإلا إذا (اسم == "حمّل_بايت") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([٤٥، ٠، ٠])
    } وإلا إذا (اسم == "خزّن") {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([٥٤، ٢، ٠])
        إذا (قيمة) { _ثابت(٠) }
    } وإلا إذا (اسم == "خزّن_بايت") {
        _تحقق_عدد(اسم، وسائط، ٢)
        _عبّر(وسائط[٠])
        _عبّر(وسائط[١])
        _ضع([٥٨، ٠، ٠])
        إذا (قيمة) { _ثابت(٠) }
    } وإلا إذا (اسم == "حجم_ذاكرة") {
        _تحقق_عدد(اسم، وسائط، ٠)
        _ضع([٦٣، ٠])
        إذا (ليس قيمة) { _ضع([٢٦]) }
    } وإلا إذا (اسم == "كبّر_ذاكرة") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([٦٤، ٠])
        إذا (ليس قيمة) { _ضع([٢٦]) }
    } وإلا إذا (اسم == "ارمِ_قيمة") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([٨، ٠])
        إذا (قيمة) { _ثابت(٠) }
    } وإلا إذا (اسم == "اطبع_رقم") {
        _تحقق_عدد(اسم، وسائط، ١)
        _عبّر(وسائط[٠])
        _ضع([١٦، ٠])
        إذا (قيمة) { _ثابت(٠) }
    } وإلا {
        إذا (ليس يحوي(فهرس_دالة، اسم)) { _خطأ("دالة غير معرّفة: " + اسم) }
        متغير ف = فهرس_دالة[اسم]
        إذا (طول(وسائط) != ف["arity"]) { _خطأ("الدالة «" + اسم + "» تحتاج " + نص_برمجي(ف["arity"]) + " وسائط لكنها استُدعيت بـ " + نص_برمجي(طول(وسائط))) }
        من_أجل (وس في وسائط) { _عبّر(وس) }
        _ضع([١٦] + _وحدة_غير_موقعة(ف["index"] + ١))
    }
}

دالة _تحقق_عدد(اسم، وسائط، ن) {
    إذا (طول(وسائط) != ن) { _خطأ("«" + اسم + "» تحتاج " + نص_برمجي(ن) + " وسائط") }
}

# ---------- الوضع الديناميكي ----------
# مضاعف ٨ أعلى أو يساوي ن
دالة بتّ_و_مضاعف(ن) { ارجع أرضية((ن + ٧) / ٨) * ٨ }

دالة _استدع_ق(اسم) {
    إذا (ليس يحوي(فهرس_دالة، اسم)) { _خطأ("مكتبة التشغيل ناقصة: لا توجد «" + اسم + "» (ادمج نواة-قيم ونواة-مدمجات)") }
    _ضع([١٦] + _وحدة_غير_موقعة(فهرس_دالة[اسم]["index"] + ١))
}

# يرجع عنوان نص حرفي موسوم في قسم البيانات: [٢][الطول][البايتات…] مبطَّنًا إلى مضاعف ٨
دالة _سلسلة(نص_) {
    إذا (يحوي(فهرس_السلاسل، نص_)) { ارجع فهرس_السلاسل[نص_] }
    متغير ب = _بايتات_خام(نص_)
    متغير عنوان = بداية_البيانات + طول(بيانات_ثابتة)
    متغير ن = طول(ب)
    متغير خانة = [٢، ٠، ٠، ٠، ن % ٢٥٦، أرضية(ن / ٢٥٦) % ٢٥٦، أرضية(ن / ٦٥٥٣٦) % ٢٥٦، أرضية(ن / ١٦٧٧٧٢١٦) % ٢٥٦] + ب
    طالما (طول(خانة) % ٨ != ٠) { أضف(خانة، ٠) }
    بيانات_ثابتة = بيانات_ثابتة + خانة
    فهرس_السلاسل[نص_] = عنوان
    ارجع عنوان
}

دالة _شرط(ع) {
    _عبّر(ع)
    إذا (ديناميكي) { _استدع_ق("ق_صدق") }
}

متغير عمليات_ديناميكية = {"PLUS": "ق_ع_جمع"، "MINUS": "ق_ع_طرح"، "STAR": "ق_ع_ضرب"، "SLASH": "ق_ع_قسمة"، "PERCENT": "ق_ع_باقي"، "EQ": "ق_ع_يساوي"، "NEQ": "ق_ع_لا_يساوي"، "LT": "ق_ع_أصغر"، "GT": "ق_ع_أكبر"، "LTE": "ق_ع_أصغر_أو_يساوي"، "GTE": "ق_ع_أكبر_أو_يساوي"}
متغير مدمجات_ديناميكية = {"طول": "ق_ع_طول"، "أضف": "ق_ع_أضف"، "انزع": "ق_ع_انزع"، "اطبع": "ق_ع_اطبع"، "@تكرار": "ق_ع_تكرار"، "أطلق_خطأ": "ق_ع_أطلق"}

دالة _عبّر_د(ع) {
    متغير ك = ع["kind"]
    إذا (ك == "Number") {
        متغير ق = ع["value"]
        إذا (أرضية(ق) == ق و ق >= -١٠٧٣٧٤١٨٢٤ و ق < ١٠٧٣٧٤١٨٢٤) {
            _ثابت(ق * ٢ + ١)
        } وإلا {
            # عدد عشري أو كبير: يُحلَّل نصه الأقصر وقت التشغيل
            _ثابت(_سلسلة(نص_برمجي(ق)))
            _استدع_ق("ق_من_نص")
        }
    } وإلا إذا (ك == "String") {
        _ثابت(_سلسلة(ع["value"]))
    } وإلا إذا (ك == "Boolean") {
        إذا (ع["value"]) { _ثابت(٤) } وإلا { _ثابت(٢) }
    } وإلا إذا (ك == "Null") {
        _ثابت(٠)
    } وإلا إذا (ك == "Identifier") {
        إذا (ع["ref"] != لاشيء) {
            _اقرأ_مرجع(ع["ref"])
        } وإلا إذا (يحوي(عامة_فهرس، ع["name"])) {
            _ضع([٣٥] + _وحدة_غير_موقعة(عامة_فهرس[ع["name"]]))
        } وإلا إذا (يحوي(فهرس_دالة، ع["name"])) {
            # دالة المستوى الأعلى بوصفها قيمة: كائن دالة يشير إلى وكيلها
            _أنشئ_دالة_من_فهرس(_وكيل_لـ(ع["name"])، ٠)
        } وإلا {
            _خطأ("متغير غير معرّف: " + ع["name"])
        }
    } وإلا إذا (ك == "FuncExpr") {
        _أنشئ_إغلاق(ع["ctx"])
    } وإلا إذا (ك == "UnaryOp") {
        _عبّر(ع["expr"])
        إذا (ع["op"] == "ليس") { _استدع_ق("ق_ع_ليس") } وإلا { _استدع_ق("ق_ع_سالب") }
    } وإلا إذا (ك == "BinOp") {
        إذا (ع["op"] == "و" أو ع["op"] == "أو") {
            متغير م = _مؤقت_جديد()
            # القيمة المحفوظة كما في ضاد: و ← الأولى إن كانت كاذبة وإلا الثانية، أو ← الأولى إن كانت صادقة وإلا الثانية
            _عبّر(ع["left"])
            _ضع([٣٣] + _وحدة_غير_موقعة(م))
            _ضع([٣٢] + _وحدة_غير_موقعة(م))
            _استدع_ق("ق_صدق")
            _ضع([٤، ١٢٧])
            _عمق_زائد()
            إذا (ع["op"] == "و") {
                _عبّر(ع["right"])
                _ضع([٥، ٣٢] + _وحدة_غير_موقعة(م))
            } وإلا {
                _ضع([٣٢] + _وحدة_غير_موقعة(م))
                _ضع([٥])
                _عبّر(ع["right"])
            }
            _ضع([١١])
            _عمق_ناقص()
        } وإلا {
            إذا (ليس يحوي(عمليات_ديناميكية، ع["op"])) { _خطأ("عملية غير مدعومة بعد في الوضع الديناميكي: " + ع["op"]) }
            _عبّر(ع["left"])
            _عبّر(ع["right"])
            _استدع_ق(عمليات_ديناميكية[ع["op"]])
        }
    } وإلا إذا (ك == "CmpChain") {
        # أ < ب < ج: الأوسط يُحسب مرة واحدة؛ عند كذب مقارنة تُرجَع قيمتها الكاذبة نفسها
        متغير ن٥ = طول(ع["ops"])
        متغير سابق = _مؤقت_جديد()
        _عبّر(ع["operands"][٠])
        _ضع([٣٣] + _وحدة_غير_موقعة(سابق))
        متغير حالي = _مؤقت_جديد()
        _عبّر(ع["operands"][١])
        _ضع([٣٣] + _وحدة_غير_موقعة(حالي))
        _ضع([٣٢] + _وحدة_غير_موقعة(سابق))
        _ضع([٣٢] + _وحدة_غير_موقعة(حالي))
        _استدع_ق(عمليات_ديناميكية[ع["ops"][٠]])
        متغير نتائج = []
        من_أجل (ك٥ من ٠ إلى ن٥ - ٢) {
            متغير ر٥ = _مؤقت_جديد()
            _ضع([٣٣] + _وحدة_غير_موقعة(ر٥))
            أضف(نتائج، ر٥)
            _ضع([٣٢] + _وحدة_غير_موقعة(ر٥))
            _استدع_ق("ق_صدق")
            _ضع([٤، ١٢٧])
            _عمق_زائد()
            سابق = حالي
            حالي = _مؤقت_جديد()
            _عبّر(ع["operands"][ك٥ + ٢])
            _ضع([٣٣] + _وحدة_غير_موقعة(حالي))
            _ضع([٣٢] + _وحدة_غير_موقعة(سابق))
            _ضع([٣٢] + _وحدة_غير_موقعة(حالي))
            _استدع_ق(عمليات_ديناميكية[ع["ops"][ك٥ + ١]])
        }
        متغير ي٥ = طول(نتائج) - ١
        طالما (ي٥ >= ٠) {
            _ضع([٥، ٣٢] + _وحدة_غير_موقعة(نتائج[ي٥]) + [١١])
            _عمق_ناقص()
            ي٥ = ي٥ - ١
        }
    } وإلا إذا (ك == "Cond") {
        _عبّر(ع["cond"])
        _استدع_ق("ق_صدق")
        _ضع([٤، ١٢٧])
        _عمق_زائد()
        _عبّر(ع["then"])
        _ضع([٥])
        _عبّر(ع["else"])
        _ضع([١١])
        _عمق_ناقص()
    } وإلا إذا (ك == "Coalesce") {
        متغير م٣ = _مؤقت_جديد()
        _عبّر(ع["left"])
        _ضع([٣٣] + _وحدة_غير_موقعة(م٣))
        _ضع([٣٢] + _وحدة_غير_موقعة(م٣))
        _ضع([٦٩، ٤، ١٢٧])
        _عمق_زائد()
        _عبّر(ع["right"])
        _ضع([٥، ٣٢] + _وحدة_غير_موقعة(م٣))
        _ضع([١١])
        _عمق_ناقص()
    } وإلا إذا (ك == "Opt") {
        متغير م٤ = _مؤقت_جديد()
        _عبّر(ع["expr"])
        _ضع([٣٣] + _وحدة_غير_موقعة(م٤))
        _ضع([٣٢] + _وحدة_غير_موقعة(م٤))
        _ضع([٦٩، ٤، ١٢٧])
        _عمق_زائد()
        _ثابت(٠)
        _ضع([٥])
        أضف(قواعد_سلسلة، م٤)
        _عبّر(ع["chain"])
        انزع(قواعد_سلسلة)
        _ضع([١١])
        _عمق_ناقص()
    } وإلا إذا (ك == "ChainBase") {
        _ضع([٣٢] + _وحدة_غير_موقعة(قواعد_سلسلة[طول(قواعد_سلسلة) - ١]))
    } وإلا إذا (ك == "Assign") {
        _إسناد(ع)
        _ثابت(٠)
    } وإلا إذا (ك == "Call") {
        _استدعاء_د(ع)
    } وإلا إذا (ك == "Index") {
        _عبّر(ع["obj"])
        _عبّر(ع["index"])
        _استدع_ق("ق_ع_فهرس")
    } وإلا إذا (ك == "ListLiteral") {
        _استدع_ق("ق_قائمة_جديدة")
        من_أجل (عنصر في ع["elements"]) {
            _عبّر(عنصر)
            _استدع_ق("ق_ع_قائمة_أضف_ر")
        }
    } وإلا إذا (ك == "MapLiteral") {
        _استدع_ق("ق_خريطة_جديدة")
        من_أجل (م٢ في ع["entries"]) {
            _عبّر(م٢["key"])
            _عبّر(م٢["value"])
            _استدع_ق("ق_ع_خريطة_ضع_ر")
        }
    } وإلا {
        _خطأ("غير مدعوم بعد في الوضع الديناميكي: " + ك)
    }
}

دالة _استدعاء_د(ع) {
    متغير وسائط = ع["args"]
    متغير مستدعى = ع["callee"]
    إذا (مستدعى["kind"] != "Identifier" أو مستدعى["ref"] != لاشيء أو (ليس يحوي(مدمجات_ديناميكية، مستدعى["name"]) و ليس يحوي(فهرس_دالة، مستدعى["name"]))) {
        # استدعاء غير مباشر: قيمة الدالة (متغير أو عنصر أو ناتج استدعاء) ثم call_indirect
        _استدعاء_غير_مباشر(مستدعى، وسائط)
        ارجع لاشيء
    }
    متغير اسم = مستدعى["name"]
    إذا (يحوي(مدمجات_ديناميكية، اسم)) {
        من_أجل (وس في وسائط) { _عبّر(وس) }
        _استدع_ق(مدمجات_ديناميكية[اسم])
        ارجع لاشيء
    }
    إذا (ليس يحوي(فهرس_دالة، اسم)) { _خطأ("دالة غير معرّفة: " + اسم) }
    متغير ف = فهرس_دالة[اسم]
    إذا (ليس ف["dyn"]) { _خطأ("«" + اسم + "» دالة خام من مكتبة التشغيل ولا تُستدعى من شيفرة ديناميكية") }
    إذا (طول(وسائط) != ف["arity"]) { _خطأ("الدالة «" + اسم + "» تحتاج " + نص_برمجي(ف["arity"]) + " وسائط لكنها استُدعيت بـ " + نص_برمجي(طول(وسائط))) }
    من_أجل (وس في وسائط) { _عبّر(وس) }
    _ضع([١٦] + _وحدة_غير_موقعة(ف["index"] + ١))
}

# ---------- الإغلاقات والخلايا والاستدعاء غير المباشر ----------
دالة _مؤقت_جديد() {
    متغير ر = عدد_المحليات
    عدد_المحليات = عدد_المحليات + ١
    ارجع ر
}
دالة _محلي_احصل(ن) { _ضع([٣٢] + _وحدة_غير_موقعة(ن)) }
دالة _محلي_ضع(ن) { _ضع([٣٣] + _وحدة_غير_موقعة(ن)) }
دالة _حمّل_إزاحة(ن) { _ضع([٤٠، ٢] + _وحدة_غير_موقعة(ن)) }
دالة _خزّن_إزاحة(ن) { _ضع([٥٤، ٢] + _وحدة_غير_موقعة(ن)) }

# يضع على المكدّس مؤشر خلية المتغير الملتقَط (المتغير محليّ مغلَّف أو حرّ من بيئة الإغلاق)
دالة _خلية_مرجع(مرجع) {
    إذا (مرجع["k"] == "local") {
        _محلي_احصل(مرجع["var"]["slot"])
    } وإلا {
        _محلي_احصل(٠)
        _حمّل_إزاحة(١٢ + ٤ * مرجع["idx"])
    }
}
دالة _اقرأ_مرجع(مرجع) {
    إذا (مرجع["k"] == "local" و ليس مرجع["var"]["boxed"]) {
        _محلي_احصل(مرجع["var"]["slot"])
    } وإلا {
        _خلية_مرجع(مرجع)
        _حمّل_إزاحة(٤)
    }
}
# إسناد قيمة تعبير إلى متغير محلل: خلية ← تُخزَّن في الإزاحة ٤؛ محلي غير ملتقَط ← local.set
دالة _إسناد_مرجع_د(مرجع، تعبير) {
    إذا (مرجع["k"] == "local" و ليس مرجع["var"]["boxed"]) {
        _عبّر(تعبير)
        _محلي_ضع(مرجع["var"]["slot"])
    } وإلا {
        _خلية_مرجع(مرجع)
        _عبّر(تعبير)
        _خزّن_إزاحة(٤)
    }
}

دالة _تصريف_متغير_د(ج) {
    متغير ف = ج["var"]
    إذا (ج["expr"] == لاشيء) { _ثابت(٠) } وإلا { _عبّر(ج["expr"]) }
    إذا (ف["boxed"]) { _استدع_ق("ق_خلية_جديدة") }
    _محلي_ضع(ف["slot"])
}

# دالة معرَّفة داخل دالة: متغير باسمها (قد تستدعي نفسها فتُنشأ خليتها قبل الإغلاق)
دالة _تصريف_دالة_متداخلة_د(ج) {
    متغير ف = ج["var"]
    إذا (ف["boxed"]) {
        _ثابت(٠)
        _استدع_ق("ق_خلية_جديدة")
        _محلي_ضع(ف["slot"])
        _محلي_احصل(ف["slot"])
        _أنشئ_إغلاق(ج["ctx"])
        _خزّن_إزاحة(٤)
    } وإلا {
        _أنشئ_إغلاق(ج["ctx"])
        _محلي_ضع(ف["slot"])
    }
}

# كائن دالة جديد: فهرس الدالة (خام) وعدد الخلايا (خام)
دالة _أنشئ_دالة_من_فهرس(فهرس، ن) {
    _ثابت(فهرس)
    _ثابت(ن)
    _استدع_ق("ق_دالة_جديدة")
}
# إغلاق: كائن دالة تُملأ خلاياه من المتغيرات الملتقَطة (من متغيرات الدالة الحالية أو من بيئتها هي)
دالة _أنشئ_إغلاق(س) {
    _أنشئ_دالة_من_فهرس(س["index"]، طول(س["free"]))
    من_أجل (ك من ٠ إلى طول(س["free"]) - ١) {
        متغير ف = س["free"][ك]
        _ثابت(ك)
        إذا (ف["owner"]["index"] == سياق_حالي["index"]) {
            _محلي_احصل(ف["slot"])
        } وإلا {
            _محلي_احصل(٠)
            _حمّل_إزاحة(١٢ + ٤ * سياق_حالي["freeIndex"][نص_برمجي(ف["id"])])
        }
        _استدع_ق("ق_ع_دالة_خلية_ر")
    }
}
دالة _وكيل_لـ(اسم) {
    إذا (يحوي(وكلاء، اسم)) { ارجع وكلاء[اسم] }
    متغير ي = طول(دوال_المصدر)
    أضف(دوال_المصدر، {"kind": "وكيل"، "target": اسم، "arity": فهرس_دالة[اسم]["arity"]، "dyn": صحيح، "export": خطأ، "decl": {"line": ١، "name": "@وكيل_" + اسم، "params": []}})
    وكلاء[اسم] = ي
    ارجع ي
}
# استدعاء قيمة دالة: [البيئة، المعاملات…، فهرس الدالة] ثم call_indirect بنوع (ن+١) معاملات
دالة _استدعاء_غير_مباشر(مستدعى، وسائط) {
    إذا (طول(وسائط) + ١ > ١٦) { _خطأ("الاستدعاء غير المباشر بأكثر من ١٥ وسيطًا غير مدعوم بعد") }
    _عبّر(مستدعى)
    متغير ت = _مؤقت_جديد()
    _محلي_ضع(ت)
    _محلي_احصل(ت)
    من_أجل (وس في وسائط) { _عبّر(وس) }
    _محلي_احصل(ت)
    _استدع_ق("ق_ع_دالة_فهرس")
    _ضع([١٧] + _وحدة_غير_موقعة(طول(وسائط) + ٢) + [٠])
}

# حلقة من_أجل في الوضع الديناميكي: دلالات الآلة نفسها (الخطوة تُقيَّم مرة وتُفحص وقت التشغيل،
# ومتغير الحلقة الملتقَط له خلية جديدة لكل دورة تُنسخ قيمتها عائدةً قبل الزيادة)
دالة _حلقة_من_إلى_د(ج) {
    متغير ف = ج["var"]
    متغير عداد = ف["slot"]
    إذا (ف["boxed"]) { عداد = _مؤقت_جديد() }
    متغير نهاية = _مؤقت_جديد()
    متغير خطوة = _مؤقت_جديد()
    _عبّر(ج["start"])
    _محلي_ضع(عداد)
    _عبّر(ج["end"])
    _محلي_ضع(نهاية)
    إذا (ج["step"] != لاشيء) { _عبّر(ج["step"]) } وإلا { _ثابت(٣) }
    _محلي_ضع(خطوة)
    _ضع([٢، ٦٤])
    _عمق_زائد()
    متغير ب = عمق
    _ضع([٣، ٦٤])
    _عمق_زائد()
    _محلي_احصل(عداد)
    _محلي_احصل(نهاية)
    _محلي_احصل(خطوة)
    _استدع_ق("ق_ع_اختبار_حلقة")
    _ضع([٦٩، ١٣، ١])
    _ضع([٢، ٦٤])
    _عمق_زائد()
    أضف(حلقات، {"break": ب، "continue": عمق، "نه": طول(نهايات)})
    إذا (ف["boxed"]) {
        _محلي_احصل(عداد)
        _استدع_ق("ق_خلية_جديدة")
        _محلي_ضع(ف["slot"])
    }
    _كتلة(ج["body"])
    انزع(حلقات)
    _ضع([١١])
    _عمق_ناقص()
    إذا (ف["boxed"]) {
        _محلي_احصل(ف["slot"])
        _حمّل_إزاحة(٤)
        _محلي_ضع(عداد)
    }
    _محلي_احصل(عداد)
    _محلي_احصل(خطوة)
    _استدع_ق("ق_جمع")
    _محلي_ضع(عداد)
    _ضع([١٢، ٠])
    _ضع([١١])
    _عمق_ناقص()
    _ضع([١١])
    _عمق_ناقص()
}

# ---------- الجمل ----------
دالة _كتلة(ك) {
    من_أجل (ج في ك["statements"]) { _جملة(ج) }
}

دالة _جملة(ج) {
    إذا (يحوي(ج، "line") و ج["line"] != لاشيء) { سطر = ج["line"] }
    متغير ك = ج["kind"]
    إذا (ك == "ExprStmt") {
        إذا (ديناميكي و ج["expr"]["kind"] != "Assign") {
            _عبّر(ج["expr"])
            _ضع([٢٦])
        } وإلا إذا (ج["expr"]["kind"] == "Call") {
            _استدعاء_جملة(ج["expr"])
        } وإلا إذا (ج["expr"]["kind"] == "Assign") {
            _إسناد(ج["expr"])
        } وإلا {
            _عبّر(ج["expr"])
            _ضع([٢٦])
        }
    } وإلا إذا (ك == "VarDecl" و ديناميكي) {
        _تصريف_متغير_د(ج)
    } وإلا إذا (ك == "FuncDecl" و ديناميكي) {
        _تصريف_دالة_متداخلة_د(ج)
    } وإلا إذا (ك == "VarDecl") {
        _عبّر(ج["expr"])
        _ضع([٣٣] + _وحدة_غير_موقعة(محليات[ج["name"]]))
    } وإلا إذا (ك == "If") {
        _شرط(ج["cond"])
        _ضع([٤، ٦٤])
        _عمق_زائد()
        _كتلة(ج["thenBlock"])
        إذا (ج["elseBlock"] != لاشيء) {
            _ضع([٥])
            _كتلة(ج["elseBlock"])
        }
        _ضع([١١])
        _عمق_ناقص()
    } وإلا إذا (ك == "While") {
        _حلقة_طالما(ج)
    } وإلا إذا (ك == "For" و ديناميكي) {
        _حلقة_من_إلى_د(ج)
    } وإلا إذا (ك == "For") {
        _حلقة_من_إلى(ج)
    } وإلا إذا (ك == "Return") {
        إذا (ج["expr"] != لاشيء) { _عبّر(ج["expr"]) } وإلا { _ثابت(٠) }
        _فكّ_نهايات(٠)
        _ضع([١٥])
    } وإلا إذا (ك == "Try" و ديناميكي) {
        _تصريف_حاول_د(ج)
    } وإلا إذا (ك == "Break") {
        إذا (طول(حلقات) == ٠) { _خطأ("توقف خارج حلقة") }
        _فكّ_نهايات(حلقات[طول(حلقات) - ١]["نه"])
        _ضع([١٢] + _وحدة_غير_موقعة(عمق - حلقات[طول(حلقات) - ١]["break"]))
    } وإلا إذا (ك == "Continue") {
        إذا (طول(حلقات) == ٠) { _خطأ("أكمل خارج حلقة") }
        _فكّ_نهايات(حلقات[طول(حلقات) - ١]["نه"])
        _ضع([١٢] + _وحدة_غير_موقعة(عمق - حلقات[طول(حلقات) - ١]["continue"]))
    } وإلا إذا (ك == "Block") {
        _كتلة(ج)
    } وإلا إذا (ك == "Multi") {
        من_أجل (س في ج["statements"]) { _جملة(س) }
    } وإلا {
        _خطأ("غير مدعوم في ضاد-نواة: " + ك)
    }
}

# ينفّذ أجسام «أخيرًا» المفتوحة من الأعمق إلى الموضع «حدّ» (قبل الخروج بـ ارجع/توقف/أكمل)
دالة _فكّ_نهايات(حدّ) {
    متغير حفظ = نهايات
    متغير ك = طول(حفظ) - ١
    طالما (ك >= حدّ) {
        نهايات = حفظ[٠:ك]
        _كتلة(حفظ[ك])
        ك = ك - ١
    }
    نهايات = حفظ
}

# حاول / التقط / أخيرًا بالاستثناءات الأصلية في WebAssembly (وسم واحد يحمل القيمة الموسومة)
#   أخيرًا: try { [try{…}catch{…}] } catch_all { جسم أخيرًا؛ rethrow } ثم جسم أخيرًا على المسار العادي
دالة _تصريف_حاول_د(ج) {
    متغير له_نهاية = ج["finallyBlock"] != لاشيء
    إذا (له_نهاية) {
        _ضع([٦، ٦٤])
        _عمق_زائد()
        أضف(نهايات، ج["finallyBlock"])
    }
    إذا (ج["catchBlock"] != لاشيء) {
        _ضع([٦، ٦٤])
        _عمق_زائد()
        _كتلة(ج["tryBlock"])
        _ضع([٧، ٠])
        إذا (ج["errName"] != لاشيء) {
            متغير ف = ج["var"]
            إذا (ف["boxed"]) { _استدع_ق("ق_خلية_جديدة") }
            _محلي_ضع(ف["slot"])
        } وإلا {
            _ضع([٢٦])
        }
        _كتلة(ج["catchBlock"])
        _ضع([١١])
        _عمق_ناقص()
    } وإلا {
        _كتلة(ج["tryBlock"])
    }
    إذا (له_نهاية) {
        انزع(نهايات)
        _ضع([٢٥])
        _كتلة(ج["finallyBlock"])
        _ضع([٩، ٠، ١١])
        _عمق_ناقص()
        _كتلة(ج["finallyBlock"])
    }
}

# استدعاء كجملة: لا نترك قيمة على المكدّس
دالة _استدعاء_جملة(ع) {
    متغير اسم = ع["callee"]["name"]
    إذا (ع["callee"]["kind"] == "Identifier" و (اسم == "خزّن" أو اسم == "خزّن_بايت" أو اسم == "اطبع_رقم" أو يحوي(ف٦٤_ثلاثية، اسم) أو يحوي(ف٦٤_أحادية، اسم) أو اسم == "ف٦٤_من_صحيح" أو اسم == "ف٦٤_ثابت")) {
        _استدعاء(ع، خطأ)
    } وإلا {
        _استدعاء(ع، صحيح)
        _ضع([٢٦])
    }
}

دالة _حلقة_طالما(ج) {
    _ضع([٢، ٦٤])
    _عمق_زائد()
    متغير ب = عمق
    _ضع([٣، ٦٤])
    _عمق_زائد()
    متغير ح = عمق
    أضف(حلقات، {"break": ب، "continue": ح، "نه": طول(نهايات)})
    _شرط(ج["cond"])
    _ضع([٦٩، ١٣، ١])
    _كتلة(ج["body"])
    _ضع([١٢، ٠])
    انزع(حلقات)
    _ضع([١١])
    _عمق_ناقص()
    _ضع([١١])
    _عمق_ناقص()
}

دالة _حلقة_من_إلى(ج) {
    عدّاد_مؤقت = عدّاد_مؤقت + ١
    متغير خطوة = ١
    إذا (ج["step"] != لاشيء) {
        إذا (ج["step"]["kind"] == "Number") {
            خطوة = ج["step"]["value"]
        } وإلا إذا (ج["step"]["kind"] == "UnaryOp" و ج["step"]["expr"]["kind"] == "Number") {
            خطوة = -ج["step"]["expr"]["value"]
        } وإلا {
            _خطأ("خطوة من_أجل في ضاد-نواة عدد ثابت")
        }
        إذا (خطوة == ٠) { _خطأ("خطوة الحلقة لا يمكن أن تكون صفرًا") }
    }
    متغير س = محليات[ج["varName"]]
    متغير ن = محليات["@نهاية" + نص_برمجي(عدّاد_مؤقت)]
    _عبّر(ج["start"])
    _ضع([٣٣] + _وحدة_غير_موقعة(س))
    _عبّر(ج["end"])
    _ضع([٣٣] + _وحدة_غير_موقعة(ن))
    _ضع([٢، ٦٤])
    _عمق_زائد()
    متغير ب = عمق
    _ضع([٣، ٦٤])
    _عمق_زائد()
    متغير ح = عمق
    _ضع([٣٢] + _وحدة_غير_موقعة(س))
    _ضع([٣٢] + _وحدة_غير_موقعة(ن))
    إذا (خطوة > ٠) { _ضع([٧٦]) } وإلا { _ضع([٧٨]) }
    _ضع([٦٩، ١٣، ١])
    _ضع([٢، ٦٤])
    _عمق_زائد()
    أضف(حلقات، {"break": ب، "continue": عمق، "نه": طول(نهايات)})
    _كتلة(ج["body"])
    انزع(حلقات)
    _ضع([١١])
    _عمق_ناقص()
    _ضع([٣٢] + _وحدة_غير_موقعة(س))
    _ثابت(خطوة)
    _ضع([١٠٦])
    _ضع([٣٣] + _وحدة_غير_موقعة(س))
    _ضع([١٢، ٠])
    _ضع([١١])
    _عمق_ناقص()
    _ضع([١١])
    _عمق_ناقص()
}

# ---------- الوحدة ----------
دالة _اجمع_الدوال(برنامج) {
    متغير قائمة = []
    متغير جمل_التهيئة = []
    عامة_فهرس = {}
    عامة_قيم = []
    من_أجل (ج في برنامج["statements"]) {
        إذا (يحوي(ج، "line") و ج["line"] != لاشيء) { سطر = ج["line"] }
        إذا (ج["kind"] == "VarDecl") {
            إذا (يحوي(عامة_فهرس، ج["name"])) { _خطأ("المتغير العام «" + ج["name"] + "» معرَّف مرتين") }
            متغير ق = ج["expr"]
            متغير قيمة = ٠
            إذا (يحوي(ج، "dyn") و ج["dyn"]) {
                # عام ديناميكي: يبدأ لاشيء ثم تُسنده دالة التهيئة بالترتيب
                إذا (ق != لاشيء) { أضف(جمل_التهيئة، {"kind": "ExprStmt"، "line": ج["line"]، "expr": {"kind": "Assign"، "target": {"kind": "Identifier"، "name": ج["name"]}، "expr": ق}}) }
            } وإلا إذا (ق == لاشيء) {
                قيمة = ٠
            } وإلا إذا (ق["kind"] == "Number") {
                قيمة = ق["value"]
            } وإلا إذا (ق["kind"] == "UnaryOp" و ق["op"] == "-" و ق["expr"]["kind"] == "Number") {
                قيمة = -ق["expr"]["value"]
            } وإلا إذا (ق["kind"] == "Boolean") {
                إذا (ق["value"]) { قيمة = ١ }
            } وإلا {
                _خطأ("قيمة المتغير العام «" + ج["name"] + "» عدد ثابت في ضاد-نواة")
            }
            عامة_فهرس[ج["name"]] = طول(عامة_قيم)
            أضف(عامة_قيم، قيمة)
        } وإلا إذا (ج["kind"] == "FuncDecl") {
            أضف(قائمة، {"decl": ج، "export": خطأ، "dyn": يحوي(ج، "dyn") و ج["dyn"]})
        } وإلا إذا (ج["kind"] == "Export" و ج["stmt"]["kind"] == "FuncDecl") {
            أضف(قائمة، {"decl": ج["stmt"]، "export": صحيح، "dyn": يحوي(ج، "dyn") و ج["dyn"]})
        } وإلا {
            _خطأ("المستوى الأعلى في ضاد-نواة يقبل تعريف الدوال فقط")
        }
    }
    إذا (طول(جمل_التهيئة) > ٠) {
        أضف(قائمة، {"decl": {"kind": "FuncDecl"، "name": "__تهيئة"، "params": []، "line": ١، "body": {"kind": "Block"، "statements": جمل_التهيئة}}، "export": صحيح، "dyn": صحيح})
    }
    ارجع قائمة
}

دالة _صرّف_دالة(ف) {
    إذا (يحوي(ف، "kind") و ف["kind"] == "وكيل") { ارجع _صرّف_وكيل(ف) }
    ديناميكي = ف["dyn"]
    جسم = []
    محليات = {}
    عدد_المحليات = ٠
    عمق = ٠
    حلقات = []
    نهايات = []
    قواعد_سلسلة = []
    عدّاد_مؤقت = ٠
    متغير معاملات_wasm = طول(ف["decl"]["params"])
    إذا (ديناميكي) {
        متغير س = ف["ctx"]
        سياق_حالي = س
        عدد_المحليات = س["slots"]
        إذا (س["hasEnv"]) { معاملات_wasm = معاملات_wasm + ١ }
        # المعاملات الملتقَطة تُوضَع في خلايا عند الدخول
        من_أجل (ي من ٠ إلى طول(ف["decl"]["params"]) - ١) {
            متغير ب = س["vars"][ي]
            إذا (ب["boxed"]) {
                _ضع([٣٢] + _وحدة_غير_موقعة(ب["slot"]))
                _استدع_ق("ق_خلية_جديدة")
                _ضع([٣٣] + _وحدة_غير_موقعة(ب["slot"]))
            }
        }
    } وإلا {
        من_أجل (م في ف["decl"]["params"]) { _عرّف_محلي(م) }
        _اجمع_محليات(ف["decl"]["body"])
        عدّاد_مؤقت = ٠
    }
    _كتلة(ف["decl"]["body"])
    _ثابت(٠)
    _ضع([١١])
    ديناميكي = خطأ
    متغير إضافية = عدد_المحليات - معاملات_wasm
    متغير مقدمة = []
    إذا (إضافية > ٠) { مقدمة = _وحدة_غير_موقعة(١) + _وحدة_غير_موقعة(إضافية) + [١٢٧] } وإلا { مقدمة = _وحدة_غير_موقعة(٠) }
    متغير كل = مقدمة + جسم
    ارجع _وحدة_غير_موقعة(طول(كل)) + كل
}

# وكيل دالة المستوى الأعلى حين تُستعمل قيمةً: (بيئة، معاملات…) ← يستدعي الدالة الأصلية متجاهلًا البيئة
دالة _صرّف_وكيل(ف) {
    جسم = []
    من_أجل (ك من ١ إلى ف["arity"]) { _ضع([٣٢] + _وحدة_غير_موقعة(ك)) }
    _ضع([١٦] + _وحدة_غير_موقعة(فهرس_دالة[ف["target"]]["index"] + ١))
    _ضع([١١])
    متغير كل = _وحدة_غير_موقعة(٠) + جسم
    ارجع _وحدة_غير_موقعة(طول(كل)) + كل
}

# عدد معاملات wasm للدالة: المعاملات المعلنة + معامل البيئة لدوال الإغلاق؛ والوكيل يزيد البيئة على معاملات الأصل
دالة _معاملات_wasm(ف) {
    إذا (يحوي(ف، "kind") و ف["kind"] == "وكيل") { ارجع ف["arity"] + ١ }
    متغير ن = طول(ف["decl"]["params"])
    إذا (ف["dyn"] و ف["ctx"]["hasEnv"]) { ارجع ن + ١ }
    ارجع ن
}
# تسجّل الدوال المتداخلة (وما تحتها) في قائمة الدوال بعد الأعلى، وتعطي كلًّا فهرسه
دالة _سجّل_متداخلة(س) {
    من_أجل (ابن في س["nested"]) {
        ابن["index"] = طول(دوال_المصدر)
        أضف(دوال_المصدر، {"decl": ابن["decl"]، "export": خطأ، "dyn": صحيح، "ctx": ابن، "kind": "مغلّف"})
        _سجّل_متداخلة(ابن)
    }
}

# المخرج: قائمة بايتات ملف WebAssembly. المصدر نص ضاد-نواة.
# مع مكتبة تشغيل: تُحلَّل المكتبة والمصدر كلٌّ على حدة (فتبقى أرقام الأسطر صحيحة) ثم تُدمج جملهما
صدّر دالة صرّف_نواة_مع(مكتبة، مصدر) {
    متغير ب١ = _م_محلل.حلّل(مكتبة)
    متغير ب٢ = _م_محلل.حلّل(مصدر)
    ب٢["statements"] = ب١["statements"] + ب٢["statements"]
    ارجع _صرّف_برنامج(ب٢)
}

# ضاد الكاملة (الوضع الديناميكي): دوال المصدر ديناميكية فوق القيم الموسومة، والمكتبة خام كما هي
صدّر دالة صرّف_ديناميكي_مع(مكتبة، مصدر) {
    متغير ب١ = _م_محلل.حلّل(مكتبة)
    متغير ب٢ = _م_محلل.حلّل(مصدر)
    من_أجل (ج في ب٢["statements"]) { ج["dyn"] = صحيح }
    ب٢["statements"] = ب١["statements"] + ب٢["statements"]
    ارجع _صرّف_برنامج(ب٢)
}

صدّر دالة صرّف_نواة(مصدر) {
    ارجع _صرّف_برنامج(_م_محلل.حلّل(مصدر))
}

دالة _صرّف_برنامج(برنامج) {
    بيانات_ثابتة = []
    فهرس_السلاسل = {}
    دوال_المصدر = _اجمع_الدوال(برنامج)
    فهرس_دالة = {}
    متغير ي = ٠
    من_أجل (ف في دوال_المصدر) {
        إذا (يحوي(فهرس_دالة، ف["decl"]["name"])) { سطر = ف["decl"]["line"]
            _خطأ("الدالة «" + ف["decl"]["name"] + "» معرَّفة مرتين") }
        فهرس_دالة[ف["decl"]["name"]] = {"index": ي، "arity": طول(ف["decl"]["params"])، "dyn": ف["dyn"]}
        ي = ي + ١
    }
    # تحليل النطاقات لدوال المصدر الديناميكية (يُسجّل الدوال المتداخلة ويحدّد المتغيرات الملتقَطة) قبل أي توليد
    وكلاء = {}
    متغير عدد_الأعلى = طول(دوال_المصدر)
    متغير فيه_ديناميكي = خطأ
    من_أجل (ك من ٠ إلى عدد_الأعلى - ١) {
        متغير ف = دوال_المصدر[ك]
        إذا (ف["dyn"]) {
            فيه_ديناميكي = صحيح
            سطر = ف["decl"]["line"]
            متغير س = _م_نطاقات.سياق_جديد(ف["decl"]، لاشيء)
            س["index"] = ك
            _م_نطاقات.حلّ_دالة(س)
            ف["ctx"] = س
            _سجّل_متداخلة(س)
        }
    }
    # تُصرَّف الأجسام أولًا لأن السلاسل الحرفية تُجمَع في قسم البيانات أثناء التصريف
    # (القائمة قد تنمو أثناء التصريف بوكلاء الدوال، فنمشي بالفهرس)
    متغير أجسام = []
    متغير ر = ٠
    طالما (ر < طول(دوال_المصدر)) {
        متغير ف = دوال_المصدر[ر]
        سطر = ف["decl"]["line"]
        أجسام = أجسام + _صرّف_دالة(ف)
        ر = ر + ١
    }
    متغير نهاية_البيانات = بداية_البيانات + طول(بيانات_ثابتة)
    متغير قاعدة_الكومة = بتّ_و_مضاعف(نهاية_البيانات)
    # الأنواع: ٠ = استيراد (i32)->()، ثم i32×ن → i32 للأعداد ن = ٠..١٦ بالترتيب (رقم النوع = ن + ١)
    متغير بايتات_الأنواع = [٩٦، ١، ١٢٧، ٠]
    من_أجل (ن من ٠ إلى ١٦) {
        متغير معاملات = []
        من_أجل (ك من ١ إلى ن) { أضف(معاملات، ١٢٧) }
        بايتات_الأنواع = بايتات_الأنواع + [٩٦] + _متجه(معاملات) + [١، ١٢٧]
    }
    متغير قسم_الأنواع = _قسم(١، _وحدة_غير_موقعة(١٨) + بايتات_الأنواع)
    متغير قسم_الاستيراد = _قسم(٢، _وحدة_غير_موقعة(١) + _بايتات_اسم("بيئة") + _بايتات_اسم("اطبع_رقم") + [٠، ٠])
    متغير أرقام_الأنواع = []
    من_أجل (ف في دوال_المصدر) { أرقام_الأنواع = أرقام_الأنواع + _وحدة_غير_موقعة(_معاملات_wasm(ف) + ١) }
    متغير قسم_الدوال = _قسم(٣، _وحدة_غير_موقعة(طول(دوال_المصدر)) + أرقام_الأنواع)
    # جدول الدوال (للاستدعاء غير المباشر): الخانة د ← الدالة د؛ يُضاف فقط حين يوجد كود ديناميكي
    متغير قسم_الجدول = []
    متغير قسم_العناصر = []
    إذا (فيه_ديناميكي) {
        قسم_الجدول = _قسم(٤، [١، ١١٢، ٠] + _وحدة_غير_موقعة(طول(دوال_المصدر)))
        متغير فهارس = []
        من_أجل (ك من ١ إلى طول(دوال_المصدر)) { فهارس = فهارس + _وحدة_غير_موقعة(ك) }
        قسم_العناصر = _قسم(٩، [١، ٠، ٦٥، ٠، ١١] + _وحدة_غير_موقعة(طول(دوال_المصدر)) + فهارس)
    }
    متغير صفحات = ١
    إذا (قاعدة_الكومة + ٤٠٩٦ > ٦٥٥٣٦) { صفحات = أرضية((قاعدة_الكومة + ٤٠٩٦ + ٦٥٥٣٥) / ٦٥٥٣٦) }
    متغير قسم_الذاكرة = _قسم(٥، [١، ٠] + _وحدة_غير_موقعة(صفحات))
    متغير بايتات_العامة = _وحدة_غير_موقعة(طول(عامة_قيم))
    متغير ترتيب_العامة = []
    من_أجل (اسم_ع في مفاتيح(عامة_فهرس)) { أضف(ترتيب_العامة، اسم_ع) }
    من_أجل (ك من ٠ إلى طول(عامة_قيم) - ١) {
        متغير ق = عامة_قيم[ك]
        # الكومة تبدأ بعد البيانات الثابتة إن وُجدت (عامّتا «قاعدة» و«قمة» في مكتبة التشغيل)
        إذا (طول(بيانات_ثابتة) > ٠ و ق == ٢٠٤٨٠ و (ترتيب_العامة[ك] == "قاعدة" أو ترتيب_العامة[ك] == "قمة")) { ق = قاعدة_الكومة }
        بايتات_العامة = بايتات_العامة + [١٢٧، ١] + [٦٥] + _وحدة_موقعة(ق) + [١١]
    }
    متغير قسم_الوسوم = _قسم(١٣، [١، ٠، ٠])
    متغير قسم_العامة = []
    إذا (طول(عامة_قيم) > ٠) { قسم_العامة = _قسم(٦، بايتات_العامة) }
    متغير صادرات = []
    متغير عدد_الصادرات = ١
    صادرات = _بايتات_اسم("ذاكرة") + [٢، ٠]
    ي = ٠
    من_أجل (ف في دوال_المصدر) {
        إذا (ف["export"]) {
            صادرات = صادرات + _بايتات_اسم(ف["decl"]["name"]) + [٠] + _وحدة_غير_موقعة(ي + ١)
            عدد_الصادرات = عدد_الصادرات + ١
        }
        ي = ي + ١
    }
    متغير قسم_الصادرات = _قسم(٧، _وحدة_غير_موقعة(عدد_الصادرات) + صادرات)
    متغير قسم_الشيفرة = _قسم(١٠، _وحدة_غير_موقعة(طول(دوال_المصدر)) + أجسام)
    متغير قسم_البيانات = []
    إذا (طول(بيانات_ثابتة) > ٠) {
        قسم_البيانات = _قسم(١١، _وحدة_غير_موقعة(١) + [٠، ٦٥] + _وحدة_موقعة(بداية_البيانات) + [١١] + _متجه(بيانات_ثابتة))
    }
    ارجع [٠، ٩٧، ١١٥، ١٠٩، ١، ٠، ٠، ٠] + قسم_الأنواع + قسم_الاستيراد + قسم_الدوال + قسم_الجدول + قسم_الذاكرة + قسم_الوسوم + قسم_العامة + قسم_الصادرات + قسم_العناصر + قسم_الشيفرة + قسم_البيانات
}
