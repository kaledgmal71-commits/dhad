# المحلّل النحوي لضاد مكتوبًا بضاد (الاستضافة الذاتية، المرحلة ٢).
# نقل أمين لصنف Parser في front.js: الشجرة نفسها (خرائط فيها المفتاح "kind") والرسائل نفسها.
# الحالة في متغيرات الوحدة: تُعاد تهيئتها في كل استدعاء لـ حلّل. يعتمد على وحدة «مرمز».

متغير م = استورد("مرمز")

متغير ر = []        # الرموز
متغير و_ = ٠        # الموضع الحالي
متغير عمق = ٠
متغير أصناف = {}
متغير عدّاد_تفكيك = ٠

متغير أسماء_رموز = {
    "LPAREN": "«(»"، "RPAREN": "«)»"، "LBRACE": "«{»"، "RBRACE": "«}»"، "LBRACKET": "«[»"، "RBRACKET": "«]»"،
    "COMMA": "«،»"، "SEMI": "«;»"، "COLON": "«:»"، "ASSIGN": "«=»"، "PLUS": "«+»"، "MINUS": "«-»"، "STAR": "«*»"،
    "SLASH": "«/»"، "PERCENT": "«%»"، "EQ": "«==»"، "NEQ": "«!=»"، "LT": "«<»"، "GT": "«>»"، "LTE": "«<=»"، "GTE": "«>=»"،
    "DOT": "«.»"، "NOT": "«!»"، "IDENT": "اسم (متغير أو دالة)"، "NUMBER": "رقم"، "STRING": "نص"، "EOF": "نهاية الكود"،
    "FUNC": "«دالة»"، "RETURN": "«ارجع»"، "IF": "«إذا»"، "ELSE": "«وإلا»"، "WHILE": "«طالما»"، "FOR": "«من_أجل»"،
    "FROM": "«من»"، "TO": "«إلى»"، "VAR": "«متغير»"، "TRUE": "«صحيح»"، "FALSE": "«خطأ»"، "NULL": "«لاشيء»"،
    "AND": "«و»"، "OR": "«أو»"، "BREAK": "«توقف»"، "CONTINUE": "«أكمل»"
}

دالة _اسم_رمز(ر٠) {
    إذا (ر٠["type"] == "EOF") { ارجع "نهاية الكود (ربما نسيت إغلاق قوس)" }
    إذا (ر٠["type"] == "IDENT" أو ر٠["type"] == "NUMBER") { ارجع أسماء_رموز[ر٠["type"]] + " «" + ر٠["value"] + "»" }
    إذا (ر٠["type"] == "STRING") { ارجع "نص" }
    إذا (يحوي(أسماء_رموز، ر٠["type"])) { ارجع أسماء_رموز[ر٠["type"]] }
    ارجع "«" + ر٠["value"] + "»"
}

# ---------- أدوات الرموز ----------
دالة _انظر() { ارجع ر[و_] }
دالة _تقدّم() {
    متغير ك = ر[و_]
    إذا (ك["type"] != "EOF") { و_ = و_ + ١ }
    ارجع ك
}
دالة _هل(ن) { ارجع ر[و_]["type"] == ن }
دالة _طابق(ن) {
    إذا (ر[و_]["type"] == ن) { ارجع _تقدّم() }
    ارجع لاشيء
}
دالة _توقّع(ن) {
    إذا (_هل(ن)) { ارجع _تقدّم() }
    متغير ك = _انظر()
    متغير اسم = ن
    إذا (يحوي(أسماء_رموز، ن)) { اسم = أسماء_رموز[ن] }
    أطلق_خطأ("السطر " + نص_برمجي(ك["line"]) + ": كنت أنتظر " + اسم + " لكن وجدت " + _اسم_رمز(ك))
}
دالة _كلمة(ك) { ارجع _هل("IDENT") و ر[و_]["value"] == ك }
دالة _نوع_بعد(ن) { ارجع ر[و_ + ن]["type"] }

# عقد صغيرة
دالة _معرّف(اسم) { ارجع {"kind": "Identifier"، "name": اسم} }
دالة _نص_عقدة(قيمة) { ارجع {"kind": "String"، "value": قيمة} }
دالة _رقم_عقدة(قيمة) { ارجع {"kind": "Number"، "value": قيمة} }
دالة _استدعاء(د، وسائط) {
    متغير مستدعى = د
    إذا (نوع(د) == "نص") { مستدعى = _معرّف(د) }
    ارجع {"kind": "Call"، "callee": مستدعى، "args": وسائط}
}
دالة _جملة_تعبير(ع) { ارجع {"kind": "ExprStmt"، "expr": ع} }
دالة _كتلة(جمل) { ارجع {"kind": "Block"، "statements": جمل} }
دالة _لاشيء_عقدة() { ارجع {"kind": "Null"} }

# ---------- البرنامج والجمل ----------
دالة _برنامج() {
    متغير جمل = []
    طالما (ليس _هل("EOF")) { أضف(جمل، _جملة()) }
    ارجع {"kind": "Program"، "statements": جمل}
}

دالة _جملة() {
    متغير سطر = _انظر()["line"]
    متغير ج = _جملة_خام()
    إذا (ج != لاشيء و ليس يحوي(ج، "line")) { ج["line"] = سطر }
    ارجع ج
}

دالة _غير_متزامنة_قبل_دالة() {
    ارجع _هل("IDENT") و ر[و_]["value"] == "غير_متزامنة" و _نوع_بعد(١) == "FUNC"
}

دالة _جملة_خام() {
    إذا (_غير_متزامنة_قبل_دالة() و و_ + ٢ < طول(ر) و ر[و_ + ٢]["type"] == "IDENT") {
        _تقدّم()
        متغير د = _تعريف_دالة()
        د["isAsync"] = صحيح
        ارجع د
    }
    إذا (_هل("FUNC") و _نوع_بعد(١) == "IDENT") { ارجع _تعريف_دالة() }
    إذا (_كلمة("حاول") و _نوع_بعد(١) == "LBRACE") { ارجع _جملة_حاول() }
    إذا (_كلمة("صنف") و _نوع_بعد(١) == "IDENT" و (_نوع_بعد(٢) == "LBRACE" أو (_نوع_بعد(٢) == "IDENT" و ر[و_ + ٢]["value"] == "يرث"))) { ارجع _جملة_صنف() }
    إذا (_هل("IDENT") و (ر[و_]["value"] == "صدّر" أو ر[و_]["value"] == "صدر") و _قابل_للتصدير()) { ارجع _جملة_تصدير() }
    إذا (_هل("IF")) { ارجع _جملة_إذا() }
    إذا (_هل("WHILE")) { ارجع _جملة_طالما() }
    إذا (_هل("FOR")) { ارجع _جملة_من_أجل() }
    إذا (_هل("RETURN")) { ارجع _جملة_ارجع() }
    إذا (_هل("VAR")) { ارجع _تعريف_متغير() }
    إذا (_هل("LBRACE")) { ارجع _كتلة_جمل() }
    إذا (_هل("BREAK")) {
        _تقدّم()
        _طابق("SEMI")
        ارجع {"kind": "Break"}
    }
    إذا (_هل("CONTINUE")) {
        _تقدّم()
        _طابق("SEMI")
        ارجع {"kind": "Continue"}
    }
    ارجع _جملة_تعبير_خام()
}

دالة _قابل_للتصدير() {
    إذا (و_ + ١ >= طول(ر)) { ارجع خطأ }
    متغير تالٍ = ر[و_ + ١]
    متغير ثانٍ = لاشيء
    إذا (و_ + ٢ < طول(ر)) { ثانٍ = ر[و_ + ٢] }
    متغير ثالث = لاشيء
    إذا (و_ + ٣ < طول(ر)) { ثالث = ر[و_ + ٣] }
    إذا (تالٍ["type"] == "FUNC") { ارجع ثانٍ != لاشيء و ثانٍ["type"] == "IDENT" }
    إذا (تالٍ["type"] == "IDENT" و تالٍ["value"] == "غير_متزامنة" و ثانٍ != لاشيء و ثانٍ["type"] == "FUNC") {
        ارجع ثالث != لاشيء و ثالث["type"] == "IDENT"
    }
    إذا (تالٍ["type"] == "VAR") { ارجع صحيح }
    ارجع تالٍ["type"] == "IDENT" و تالٍ["value"] == "صنف" و ثانٍ != لاشيء و ثانٍ["type"] == "IDENT"
}

دالة _جملة_تصدير() {
    متغير سطر = _انظر()["line"]
    إذا (عمق > ٠) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": «صدّر» تُكتب في المستوى الأعلى من الملف فقط، لا داخل دالة أو كتلة") }
    _تقدّم()
    متغير ج = _جملة()
    متغير أسماء = []
    إذا (ج["kind"] == "Multi") {
        إذا (يحوي(ج، "names")) {
            أسماء = ج["names"]
        } وإلا {
            أسماء = [ج["statements"][طول(ج["statements"]) - ١]["name"]]
        }
    } وإلا {
        أسماء = [ج["name"]]
    }
    ارجع {"kind": "Export"، "names": أسماء، "stmt": ج، "line": سطر}
}

دالة _جملة_صنف() {
    متغير سطر = _انظر()["line"]
    _تقدّم()
    متغير اسم = _توقّع("IDENT")["value"]
    متغير أب = لاشيء
    إذا (_كلمة("يرث")) {
        _تقدّم()
        متغير اسم_الأب = _توقّع("IDENT")["value"]
        إذا (ليس يحوي(أصناف، اسم_الأب)) {
            أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": الصنف الأب «" + اسم_الأب + "» غير معروف — عرّفه قبل الصنف الذي يرثه")
        }
        أب = {"name": اسم_الأب، "ctorParams": أصناف[اسم_الأب]["ctorParams"]}
    }
    _توقّع("LBRACE")
    متغير طرق = []
    متغير مُنشئ = لاشيء
    طالما (ليس _هل("RBRACE") و ليس _هل("EOF")) {
        متغير غير_متزامنة = _غير_متزامنة_قبل_دالة()
        إذا (غير_متزامنة) { _تقدّم() }
        إذا (ليس _هل("FUNC")) {
            أطلق_خطأ("السطر " + نص_برمجي(_انظر()["line"]) + ": داخل الصنف لا يُكتب إلا تعريف دوال (دالة اسم(...) { ... })")
        }
        متغير د = _تعريف_دالة()
        إذا (غير_متزامنة) { د["isAsync"] = صحيح }
        إذا (د["name"] == "جديد" و يحوي(د، "isAsync") و د["isAsync"]) {
            أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": دالة «جديد» لا تكون غير_متزامنة")
        }
        إذا (د["name"] == "جديد") {
            إذا (مُنشئ != لاشيء) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": للصنف «" + اسم + "» أكثر من دالة جديد") }
            مُنشئ = د
        } وإلا {
            أضف(طرق، د)
        }
    }
    _توقّع("RBRACE")

    متغير هذا = "هذا"
    متغير معاملات_المنشئ = []
    إذا (مُنشئ != لاشيء) {
        معاملات_المنشئ = مُنشئ["params"]
    } وإلا إذا (أب != لاشيء) {
        معاملات_المنشئ = أب["ctorParams"]
    }

    متغير جسم_الطرق = []
    إذا (أب != لاشيء) { أضف(جسم_الطرق، _جملة_تعبير(_استدعاء("@طرق_" + أب["name"]، [_معرّف(هذا)]))) }
    من_أجل (طريقة في طرق) {
        أضف(جسم_الطرق، طريقة)
        أضف(جسم_الطرق، _جملة_تعبير({"kind": "Assign"، "target": {"kind": "Index"، "obj": _معرّف(هذا)، "index": _نص_عقدة(طريقة["name"])}، "expr": _معرّف(طريقة["name"])}))
    }
    متغير دالة_الطرق = {"kind": "FuncDecl"، "name": "@طرق_" + اسم، "params": [هذا]، "body": _كتلة(جسم_الطرق)}

    متغير جسم_المنشئ = []
    إذا (أب != لاشيء) {
        متغير وسائط_الأب = [_معرّف(هذا)]
        من_أجل (ص في أب["ctorParams"]) { أضف(وسائط_الأب، _معرّف(ص)) }
        أضف(جسم_المنشئ، {"kind": "VarDecl"، "name": "الأب"، "expr": {"kind": "FuncExpr"، "params": أب["ctorParams"]،
            "body": _كتلة([_جملة_تعبير(_استدعاء("@بناء_" + أب["name"]، وسائط_الأب))])}})
    }
    إذا (مُنشئ != لاشيء) {
        من_أجل (ج في مُنشئ["body"]["statements"]) { أضف(جسم_المنشئ، ج) }
    } وإلا إذا (أب != لاشيء) {
        متغير وسائط = []
        من_أجل (ص في معاملات_المنشئ) { أضف(وسائط، _معرّف(ص)) }
        أضف(جسم_المنشئ، _جملة_تعبير(_استدعاء("الأب"، وسائط)))
    }
    متغير معاملات_البناء = [هذا]
    من_أجل (ص في معاملات_المنشئ) { أضف(معاملات_البناء، ص) }
    متغير دالة_المنشئ = {"kind": "FuncDecl"، "name": "@بناء_" + اسم، "params": معاملات_البناء، "body": _كتلة(جسم_المنشئ)}

    متغير وسائط_البناء = [_معرّف(هذا)]
    من_أجل (ص في معاملات_المنشئ) { أضف(وسائط_البناء، _معرّف(ص)) }
    متغير صانع = {"kind": "FuncDecl"، "name": اسم، "params": معاملات_المنشئ، "body": _كتلة([
        {"kind": "VarDecl"، "name": هذا، "expr": {"kind": "MapLiteral"، "entries": []}}،
        _جملة_تعبير(_استدعاء("@طرق_" + اسم، [_معرّف(هذا)]))،
        _جملة_تعبير(_استدعاء("@بناء_" + اسم، وسائط_البناء))،
        {"kind": "Return"، "expr": _معرّف(هذا)}
    ])}
    أصناف[اسم] = {"ctorParams": معاملات_المنشئ}
    ارجع {"kind": "Multi"، "statements": [دالة_الطرق، دالة_المنشئ، صانع]، "line": سطر}
}

دالة _كتلة_جمل() {
    _توقّع("LBRACE")
    متغير جمل = []
    عمق = عمق + ١
    طالما (ليس _هل("RBRACE") و ليس _هل("EOF")) { أضف(جمل، _جملة()) }
    عمق = عمق - ١
    _توقّع("RBRACE")
    ارجع _كتلة(جمل)
}

# قائمة المعاملات بعد «(» وحتى «)»، مع قيم افتراضية اختيارية. تعيد {"params", "defaults"}
دالة _قائمة_معاملات() {
    متغير معاملات = []
    متغير افتراضات = []
    إذا (ليس _هل("RPAREN")) {
        متغير تابع = صحيح
        طالما (تابع) {
            متغير اسم = _توقّع("IDENT")["value"]
            أضف(معاملات، اسم)
            إذا (_طابق("ASSIGN")) {
                أضف(افتراضات، {"name": اسم، "expr": _أو_منطقي()})
            } وإلا إذا (طول(افتراضات) > ٠) {
                أطلق_خطأ("السطر " + نص_برمجي(_انظر()["line"]) + ": بعد معامل له قيمة افتراضية يجب أن تكون بقية المعاملات كذلك")
            }
            تابع = _طابق("COMMA") != لاشيء
        }
    }
    _توقّع("RPAREN")
    ارجع {"params": معاملات، "defaults": افتراضات}
}

دالة _مع_افتراضات(جسم، افتراضات) {
    إذا (طول(افتراضات) == ٠) { ارجع جسم }
    متغير مقدمة = []
    من_أجل (د في افتراضات) {
        أضف(مقدمة، {"kind": "If"،
            "cond": {"kind": "BinOp"، "op": "EQ"، "left": _معرّف(د["name"])، "right": _لاشيء_عقدة()}،
            "thenBlock": _كتلة([_جملة_تعبير({"kind": "Assign"، "target": _معرّف(د["name"])، "expr": د["expr"]})])،
            "elseBlock": لاشيء})
    }
    من_أجل (ج في جسم["statements"]) { أضف(مقدمة، ج) }
    ارجع _كتلة(مقدمة)
}

دالة _تعريف_دالة() {
    _توقّع("FUNC")
    متغير اسم = _توقّع("IDENT")["value"]
    _توقّع("LPAREN")
    متغير ق = _قائمة_معاملات()
    متغير جسم = _مع_افتراضات(_كتلة_جمل()، ق["defaults"])
    ارجع {"kind": "FuncDecl"، "name": اسم، "params": ق["params"]، "body": جسم}
}

دالة _هل_كلمة_أخيرًا() {
    ارجع _هل("IDENT") و (ر[و_]["value"] == "أخيرًا" أو ر[و_]["value"] == "أخيرا" أو ر[و_]["value"] == "أخيراً")
}

دالة _جملة_حاول() {
    _تقدّم()
    متغير كتلة_محاولة = _كتلة_جمل()
    متغير اسم_خطأ = لاشيء
    متغير كتلة_التقاط = لاشيء
    متغير كتلة_أخيرًا = لاشيء
    إذا (_كلمة("التقط")) {
        _تقدّم()
        إذا (_طابق("LPAREN")) {
            اسم_خطأ = _توقّع("IDENT")["value"]
            _توقّع("RPAREN")
        }
        كتلة_التقاط = _كتلة_جمل()
    }
    إذا (_هل_كلمة_أخيرًا()) {
        _تقدّم()
        كتلة_أخيرًا = _كتلة_جمل()
    }
    إذا (كتلة_التقاط == لاشيء و كتلة_أخيرًا == لاشيء) {
        أطلق_خطأ("السطر " + نص_برمجي(_انظر()["line"]) + ": بعد كتلة «حاول» يجب أن تأتي «التقط { … }» أو «أخيرًا { … }»")
    }
    ارجع {"kind": "Try"، "tryBlock": كتلة_محاولة، "errName": اسم_خطأ، "catchBlock": كتلة_التقاط، "finallyBlock": كتلة_أخيرًا}
}

دالة _جملة_إذا() {
    _توقّع("IF")
    _توقّع("LPAREN")
    متغير شرط = _تعبير()
    _توقّع("RPAREN")
    متغير جسم_إذا = _كتلة_جمل()
    متغير جسم_وإلا = لاشيء
    إذا (_طابق("ELSE") != لاشيء) {
        إذا (_هل("IF")) {
            جسم_وإلا = _كتلة([_جملة_إذا()])
        } وإلا {
            جسم_وإلا = _كتلة_جمل()
        }
    }
    ارجع {"kind": "If"، "cond": شرط، "thenBlock": جسم_إذا، "elseBlock": جسم_وإلا}
}

دالة _جملة_طالما() {
    _توقّع("WHILE")
    _توقّع("LPAREN")
    متغير شرط = _تعبير()
    _توقّع("RPAREN")
    متغير جسم = _كتلة_جمل()
    ارجع {"kind": "While"، "cond": شرط، "body": جسم}
}

دالة _جملة_من_أجل() {
    _توقّع("FOR")
    _توقّع("LPAREN")
    متغير اسم_متغير = ""
    متغير نمط = لاشيء
    إذا (_هل("LBRACKET") أو _هل("LBRACE")) {
        نمط = _نمط()
        عدّاد_تفكيك = عدّاد_تفكيك + ١
        اسم_متغير = "@عنصر_حلقة_" + نص_برمجي(عدّاد_تفكيك)
    } وإلا {
        اسم_متغير = _توقّع("IDENT")["value"]
    }
    إذا (_كلمة("في")) {
        _تقدّم()
        متغير مكرَّر = _تعبير()
        _توقّع("RPAREN")
        متغير جسم = _كتلة_جمل()
        إذا (نمط != لاشيء) {
            متغير ج = _فكّ(نمط، _معرّف(اسم_متغير)، _انظر()["line"])
            جسم["statements"] = [ج] + جسم["statements"]
        }
        ارجع {"kind": "ForIn"، "varName": اسم_متغير، "iter": مكرَّر، "body": جسم}
    }
    إذا (نمط != لاشيء) {
        أطلق_خطأ("السطر " + نص_برمجي(_انظر()["line"]) + ": التفكيك في الحلقة يعمل مع «في» فقط: من_أجل ([أ، ب] في قائمة)")
    }
    _توقّع("FROM")
    متغير بداية = _تعبير()
    _توقّع("TO")
    متغير نهاية = _تعبير()
    متغير خطوة = لاشيء
    إذا (_كلمة("بخطوة")) {
        _تقدّم()
        خطوة = _تعبير()
    }
    _توقّع("RPAREN")
    متغير جسم = _كتلة_جمل()
    ارجع {"kind": "For"، "varName": اسم_متغير، "start": بداية، "end": نهاية، "step": خطوة، "body": جسم}
}

دالة _جملة_ارجع() {
    _توقّع("RETURN")
    متغير تعبير = لاشيء
    إذا (ليس _هل("SEMI") و ليس _هل("RBRACE")) { تعبير = _تعبير() }
    _طابق("SEMI")
    ارجع {"kind": "Return"، "expr": تعبير}
}

دالة _تعريف_متغير() {
    _توقّع("VAR")
    إذا (_هل("LBRACKET") أو _هل("LBRACE")) {
        متغير سطر = _انظر()["line"]
        متغير نمط = _نمط()
        _توقّع("ASSIGN")
        متغير تعبير = _تعبير()
        _طابق("SEMI")
        ارجع _فكّ(نمط، تعبير، سطر)
    }
    متغير اسم = _توقّع("IDENT")["value"]
    _توقّع("ASSIGN")
    متغير تعبير = _تعبير()
    _طابق("SEMI")
    ارجع {"kind": "VarDecl"، "name": اسم، "expr": تعبير}
}

# نمط التفكيك: يعيد {"type": "list", "items", "rest"} أو {"type": "map", "entries"}
دالة _نمط() {
    متغير سطر = _انظر()["line"]
    إذا (_طابق("LBRACKET") != لاشيء) {
        متغير عناصر = []
        متغير بقية = لاشيء
        إذا (ليس _هل("RBRACKET")) {
            متغير تابع = صحيح
            طالما (تابع) {
                إذا (_هل("DOT") و _نوع_بعد(١) == "DOT" و _نوع_بعد(٢) == "DOT") {
                    _تقدّم()
                    _تقدّم()
                    _تقدّم()
                    بقية = _توقّع("IDENT")["value"]
                    توقف
                }
                إذا (_هل("LBRACKET") أو _هل("LBRACE")) {
                    أضف(عناصر، _نمط())
                } وإلا {
                    أضف(عناصر، _توقّع("IDENT")["value"])
                }
                تابع = _طابق("COMMA") != لاشيء
            }
        }
        _توقّع("RBRACKET")
        إذا (طول(عناصر) == ٠ و بقية == لاشيء) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": نمط التفكيك فارغ") }
        ارجع {"type": "list"، "items": عناصر، "rest": بقية}
    }
    _توقّع("LBRACE")
    متغير مدخلات = []
    متغير تابع = صحيح
    طالما (تابع) {
        متغير مفتاح = _توقّع("IDENT")["value"]
        متغير هدف = مفتاح
        إذا (_طابق("COLON") != لاشيء) {
            إذا (_هل("LBRACKET") أو _هل("LBRACE")) {
                هدف = _نمط()
            } وإلا {
                هدف = _توقّع("IDENT")["value"]
            }
        }
        أضف(مدخلات، {"key": مفتاح، "target": هدف})
        تابع = _طابق("COMMA") != لاشيء
    }
    _توقّع("RBRACE")
    ارجع {"type": "map"، "entries": مدخلات}
}

# يحوّل نمط التفكيك إلى متغيرات عادية (مصدر مخفي ثم متغير لكل اسم)
متغير _جمل_فك = []
متغير _أسماء_فك = []

دالة _اربط_هدف(هدف، قيمة) {
    إذا (نوع(هدف) == "نص") {
        أضف(_جمل_فك، {"kind": "VarDecl"، "name": هدف، "expr": قيمة})
        أضف(_أسماء_فك، هدف)
    } وإلا {
        _امش(هدف، قيمة)
    }
}

دالة _امش(ن، مصدر) {
    عدّاد_تفكيك = عدّاد_تفكيك + ١
    متغير مخفي = "@تفكيك_" + نص_برمجي(عدّاد_تفكيك)
    أضف(_جمل_فك، {"kind": "VarDecl"، "name": مخفي، "expr": مصدر})
    إذا (ن["type"] == "list") {
        متغير ي = ٠
        طالما (ي < طول(ن["items"])) {
            _اربط_هدف(ن["items"][ي]، _استدعاء("@عنصر"، [_معرّف(مخفي)، _رقم_عقدة(ي)]))
            ي = ي + ١
        }
        إذا (ن["rest"] != لاشيء) {
            _اربط_هدف(ن["rest"]، _استدعاء("@باقي"، [_معرّف(مخفي)، _رقم_عقدة(طول(ن["items"]))]))
        }
    } وإلا {
        من_أجل (مدخل في ن["entries"]) {
            _اربط_هدف(مدخل["target"]، _استدعاء("@عنصر"، [_معرّف(مخفي)، _نص_عقدة(مدخل["key"])]))
        }
    }
}

دالة _فكّ(نمط، تعبير، سطر) {
    عدّاد_تفكيك = عدّاد_تفكيك + ١
    _جمل_فك = []
    _أسماء_فك = []
    _امش(نمط، تعبير)
    ارجع {"kind": "Multi"، "statements": _جمل_فك، "names": _أسماء_فك، "line": سطر}
}

دالة _جملة_تعبير_خام() {
    متغير تعبير = _تعبير()
    _طابق("SEMI")
    ارجع {"kind": "ExprStmt"، "expr": تعبير}
}

# ---------- التعابير ----------
دالة _تعبير() { ارجع _إسناد() }

متغير مركّبة = {"PLUSEQ": "PLUS"، "MINUSEQ": "MINUS"، "STAREQ": "STAR"، "SLASHEQ": "SLASH"، "PERCENTEQ": "PERCENT"}

دالة _إسناد() {
    متغير تعبير = _أو_منطقي()
    متغير نوع_رمز = _انظر()["type"]
    إذا (يحوي(مركّبة، نوع_رمز) أو نوع_رمز == "PLUSPLUS" أو نوع_رمز == "MINUSMINUS") {
        _تقدّم()
        إذا (تعبير["kind"] != "Identifier" و ليس (تعبير["kind"] == "Index" و _هدف_بسيط(تعبير))) {
            أطلق_خطأ("السطر " + نص_برمجي(_انظر()["line"]) + ": الطرف الأيسر للإسناد المركّب يجب أن يكون متغيرًا أو عنصرًا بفهرس بسيط")
        }
        متغير عملية = ""
        متغير قيمة = لاشيء
        إذا (نوع_رمز == "PLUSPLUS" أو نوع_رمز == "MINUSMINUS") {
            عملية = "MINUS"
            إذا (نوع_رمز == "PLUSPLUS") { عملية = "PLUS" }
            قيمة = _رقم_عقدة(١)
        } وإلا {
            عملية = مركّبة[نوع_رمز]
            قيمة = _إسناد()
        }
        ارجع {"kind": "Assign"، "target": تعبير، "expr": {"kind": "BinOp"، "op": عملية، "left": تعبير، "right": قيمة}}
    }
    إذا (_هل("ASSIGN")) {
        _تقدّم()
        متغير قيمة = _إسناد()
        إذا (تعبير["kind"] == "Identifier" أو تعبير["kind"] == "Index") {
            ارجع {"kind": "Assign"، "target": تعبير، "expr": قيمة}
        }
        أطلق_خطأ("الطرف الأيسر للإسناد يجب أن يكون متغيرًا")
    }
    ارجع تعبير
}

دالة _هدف_بسيط(ع) {
    إذا (ع["kind"] == "Identifier" أو ع["kind"] == "Number" أو ع["kind"] == "String") { ارجع صحيح }
    إذا (ع["kind"] == "Index") { ارجع _هدف_بسيط(ع["obj"]) و _هدف_بسيط(ع["index"]) }
    إذا (ع["kind"] == "BinOp") { ارجع _هدف_بسيط(ع["left"]) و _هدف_بسيط(ع["right"]) }
    إذا (ع["kind"] == "UnaryOp") { ارجع _هدف_بسيط(ع["expr"]) }
    ارجع خطأ
}

دالة _أو_منطقي() {
    متغير تعبير = _و_منطقي()
    طالما (_هل("OR")) {
        _تقدّم()
        تعبير = {"kind": "BinOp"، "op": "أو"، "left": تعبير، "right": _و_منطقي()}
    }
    ارجع تعبير
}

دالة _و_منطقي() {
    متغير تعبير = _مساواة()
    طالما (_هل("AND")) {
        _تقدّم()
        تعبير = {"kind": "BinOp"، "op": "و"، "left": تعبير، "right": _مساواة()}
    }
    ارجع تعبير
}

دالة _مساواة() {
    متغير تعبير = _مقارنة()
    طالما (_هل("EQ") أو _هل("NEQ")) {
        متغير عملية = _تقدّم()["type"]
        تعبير = {"kind": "BinOp"، "op": عملية، "left": تعبير، "right": _مقارنة()}
    }
    ارجع تعبير
}

دالة _مقارنة() {
    متغير تعبير = _حدّ()
    طالما (_هل("LT") أو _هل("GT") أو _هل("LTE") أو _هل("GTE") أو _كلمة("في")) {
        إذا (_هل("IDENT")) {
            _تقدّم()
            متغير يمين = _حدّ()
            تعبير = {"kind": "Call"، "callee": _معرّف("@في")، "args": [يمين، تعبير]}
        } وإلا {
            متغير عملية = _تقدّم()["type"]
            تعبير = {"kind": "BinOp"، "op": عملية، "left": تعبير، "right": _حدّ()}
        }
    }
    ارجع تعبير
}

دالة _حدّ() {
    متغير تعبير = _عامل()
    طالما (_هل("PLUS") أو _هل("MINUS")) {
        متغير عملية = _تقدّم()["type"]
        تعبير = {"kind": "BinOp"، "op": عملية، "left": تعبير، "right": _عامل()}
    }
    ارجع تعبير
}

دالة _عامل() {
    متغير تعبير = _أحادي()
    طالما (_هل("STAR") أو _هل("SLASH") أو _هل("PERCENT")) {
        متغير عملية = _تقدّم()["type"]
        تعبير = {"kind": "BinOp"، "op": عملية، "left": تعبير، "right": _أحادي()}
    }
    ارجع تعبير
}

متغير بعد_انتظر = ["IDENT"، "NUMBER"، "STRING"، "LPAREN"، "LBRACKET"، "LBRACE"، "FUNC"، "NOT"، "MINUS"، "TRUE"، "FALSE"، "NULL"]

دالة _أحادي() {
    إذا (_كلمة("انتظر")) {
        متغير تالٍ = ر[و_ + ١]
        إذا (تالٍ["type"] في بعد_انتظر) {
            متغير سطر = _تقدّم()["line"]
            ارجع {"kind": "Await"، "expr": _أحادي()، "line": سطر}
        }
    }
    إذا (_هل("NOT")) {
        _تقدّم()
        ارجع {"kind": "UnaryOp"، "op": "ليس"، "expr": _أحادي()}
    }
    إذا (_هل("MINUS")) {
        _تقدّم()
        ارجع {"kind": "UnaryOp"، "op": "-"، "expr": _أحادي()}
    }
    ارجع _استدعاء_تعبير()
}

دالة _استدعاء_تعبير() {
    متغير تعبير = _أساسي()
    طالما (صحيح) {
        إذا (_هل("LPAREN")) {
            _تقدّم()
            متغير وسائط = []
            إذا (ليس _هل("RPAREN")) {
                أضف(وسائط، _تعبير())
                طالما (_طابق("COMMA") != لاشيء) { أضف(وسائط، _تعبير()) }
            }
            _توقّع("RPAREN")
            تعبير = {"kind": "Call"، "callee": تعبير، "args": وسائط}
        } وإلا إذا (_هل("DOT")) {
            _تقدّم()
            متغير اسم_رمز = _توقّع("IDENT")
            تعبير = {"kind": "Index"، "obj": تعبير، "index": _نص_عقدة(اسم_رمز["value"])}
        } وإلا إذا (_هل("LBRACKET")) {
            _تقدّم()
            إذا (_هل("COLON")) {
                _تقدّم()
                متغير أعلى = _لاشيء_عقدة()
                إذا (ليس _هل("RBRACKET")) { أعلى = _تعبير() }
                _توقّع("RBRACKET")
                تعبير = {"kind": "Call"، "callee": _معرّف("@شريحة")، "args": [تعبير، _لاشيء_عقدة()، أعلى]}
            } وإلا {
                متغير فهرس = _تعبير()
                إذا (_هل("COLON")) {
                    _تقدّم()
                    متغير أعلى = _لاشيء_عقدة()
                    إذا (ليس _هل("RBRACKET")) { أعلى = _تعبير() }
                    _توقّع("RBRACKET")
                    تعبير = {"kind": "Call"، "callee": _معرّف("@شريحة")، "args": [تعبير، فهرس، أعلى]}
                } وإلا {
                    _توقّع("RBRACKET")
                    تعبير = {"kind": "Index"، "obj": تعبير، "index": فهرس}
                }
            }
        } وإلا {
            توقف
        }
    }
    ارجع تعبير
}

# يحوّل نص رقم (ربما فيه نقطتان) إلى عدد كما يفعل parseFloat/parseInt في الأصل
دالة _قيمة_رقم(نص_) {
    متغير ن = موضع(نص_، ".")
    إذا (ن < ٠) { ارجع عدد(نص_) }
    متغير ن٢ = موضع(نص_، "."، ن + ١)
    متغير قص_ = نص_
    إذا (ن٢ >= ٠) { قص_ = اقتطع(نص_، ٠، ن٢) }
    ارجع عدد(قص_)
}

دالة _أساسي() {
    إذا (_غير_متزامنة_قبل_دالة() و و_ + ٢ < طول(ر) و ر[و_ + ٢]["type"] == "LPAREN") {
        _تقدّم()
        متغير ف = _أساسي()
        ف["isAsync"] = صحيح
        ارجع ف
    }
    متغير ك = _انظر()
    متغير ن = ك["type"]
    إذا (ن == "NUMBER") {
        _تقدّم()
        ارجع {"kind": "Number"، "value": _قيمة_رقم(ك["value"])}
    }
    إذا (ن == "STRING") {
        _تقدّم()
        ارجع {"kind": "String"، "value": ك["value"]}
    }
    إذا (ن == "TRUE") {
        _تقدّم()
        ارجع {"kind": "Boolean"، "value": صحيح}
    }
    إذا (ن == "FALSE") {
        _تقدّم()
        ارجع {"kind": "Boolean"، "value": خطأ}
    }
    إذا (ن == "NULL") {
        _تقدّم()
        ارجع {"kind": "Null"}
    }
    إذا (ن == "IDENT") {
        _تقدّم()
        ارجع {"kind": "Identifier"، "name": ك["value"]}
    }
    إذا (ن == "FUNC") {
        _تقدّم()
        _توقّع("LPAREN")
        متغير ق = _قائمة_معاملات()
        ارجع {"kind": "FuncExpr"، "params": ق["params"]، "body": _مع_افتراضات(_كتلة_جمل()، ق["defaults"])}
    }
    إذا (ن == "LPAREN") {
        _تقدّم()
        متغير ع = _تعبير()
        _توقّع("RPAREN")
        ارجع ع
    }
    إذا (ن == "LBRACE") {
        _تقدّم()
        متغير مدخلات = []
        إذا (ليس _هل("RBRACE")) {
            متغير تابع = صحيح
            طالما (تابع) {
                متغير مفتاح = لاشيء
                إذا (_هل("IDENT") و _نوع_بعد(١) == "COLON") {
                    مفتاح = _نص_عقدة(_تقدّم()["value"])
                } وإلا {
                    مفتاح = _تعبير()
                }
                _توقّع("COLON")
                أضف(مدخلات، {"key": مفتاح، "value": _تعبير()})
                تابع = _طابق("COMMA") != لاشيء
            }
        }
        _توقّع("RBRACE")
        ارجع {"kind": "MapLiteral"، "entries": مدخلات}
    }
    إذا (ن == "LBRACKET") {
        _تقدّم()
        متغير عناصر = []
        إذا (ليس _هل("RBRACKET")) {
            أضف(عناصر، _تعبير())
            طالما (_طابق("COMMA") != لاشيء) { أضف(عناصر، _تعبير()) }
        }
        _توقّع("RBRACKET")
        ارجع {"kind": "ListLiteral"، "elements": عناصر}
    }
    أطلق_خطأ("السطر " + نص_برمجي(ك["line"]) + ": لم أفهم هذا الموضع — وجدت " + _اسم_رمز(ك) + " حيث يُنتظر قيمة أو تعبير")
}

# ---------- الواجهة ----------
صدّر دالة حلّل(مصدر) {
    ر = م.رمّز(مصدر)
    و_ = ٠
    عمق = ٠
    أصناف = {}
    عدّاد_تفكيك = ٠
    ارجع _برنامج()
}
