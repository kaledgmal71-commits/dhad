# طبقة القيم الموسومة لـ«ضاد-نواة» (الاستقلال ٦هـ): كل قيمة كلمة واحدة ٣٢ بتًا تحمل نوعها.
# تُدمج بعد نواة-تشغيل ونواة-أعداد:  صرّف_نواة_مع(تشغيل + أعداد + قيم، مصدر).
#
# التمثيل:
#   عدد صحيح صغير      : كلمة فردية  (ع << ١) | ١   والمدى [-٢^٣٠، ٢^٣٠) — لا يُحجَز له شيء في الكومة.
#   لاشيء / خطأ / صحيح  : ٠ / ٢ / ٤  (ثوابت دون بداية الكومة فلا يعدّها جامع النفايات مؤشرات). ٦ علامة محذوف داخلية.
#   كائن               : مؤشر على حمولة كتلة (من ٢٠٤٨٨)، أول كلمة فيه الوسم:
#       ١ عدد عشري : [الوسم][فراغ][f64 في +٨]       ٢ نص    : [الوسم][الطول][البايتات…]
#       ٣ قائمة    : [الوسم][الطول][السعة][البيانات]    ٤ خريطة : [الوسم][فهرس خام ٥ كلمات][قائمة المفاتيح][قائمة القيم][الحيّ]
# قاعدة التوحيد: كل عدد قيمته صحيحة وفي المدى يُخزَّن صغيرًا (و-٠ يبقى عشريًا)، فيكفي لمقارنة صغيرين مقارنة كلمتين.
# الخريطة تحفظ ترتيب الإدخال (كخريطة آلة ضاد)؛ فهرسها خريطة خام من نوع ٢ (مفتاح موسوم ← موضع موسوم).
# الصناديق المؤقتة للعشري: ١٢٨ و١٣٦ و١٤٤ و١٥٢ (لا تتقاطع مع ٦٤–١٢٧ لباقي القسمة ولا مع ١٦٠+ لمستعملي المكتبة).

# ---------- الفحص ----------
دالة ق_هل_صغير(ق) { ارجع بتّ_و(ق، ١) }
دالة ق_هل_كائن(ق) {
    إذا (ق < ٢٠٤٨٨) { ارجع ٠ }
    ارجع ١ - بتّ_و(ق، ١)
}
# وسم الكائن أو ٠
دالة ق_وسم(ق) {
    إذا (ق_هل_كائن(ق) == ٠) { ارجع ٠ }
    ارجع حمّل(ق)
}
دالة ق_هل_عدد(ق) {
    إذا (بتّ_و(ق، ١) == ١) { ارجع ١ }
    ارجع ق_وسم(ق) == ١
}
# رموز النوع: ٠ لاشيء، ١ عدد، ٢ منطقي، ٣ نص، ٤ قائمة، ٥ خريطة
دالة ق_نوع(ق) {
    إذا (بتّ_و(ق، ١) == ١) { ارجع ١ }
    إذا (ق == ٠) { ارجع ٠ }
    إذا (ق == ٢ أو ق == ٤) { ارجع ٢ }
    متغير وس = ق_وسم(ق)
    إذا (وس == ١) { ارجع ١ }
    إذا (وس == ٢) { ارجع ٣ }
    إذا (وس == ٣) { ارجع ٤ }
    إذا (وس == ٤) { ارجع ٥ }
    ارجع -١
}

# ---------- الأعداد ----------
دالة ق_صغير(ع) { ارجع بتّ_أو(يسار(ع، ١)، ١) }
دالة ق_قيمة_صغير(ق) { ارجع يمين(ق، ١) }
# يملأ الصندوق «ص» بقيمة عدد موسوم
دالة ق_ف٦٤(ص، ق) {
    إذا (بتّ_و(ق، ١) == ١) {
        ف٦٤_من_صحيح(ص، يمين(ق، ١))
    } وإلا {
        ف٦٤_نسخ(ص، ق + ٨)
    }
}
# من صندوق f64 إلى قيمة موسومة موحَّدة
دالة ق_من_ف٦٤(ص) {
    ف٦٤_من_صحيح(٢٠٠، ١٠٧٣٧٤١٨٢٤)
    ف٦٤_سالب(٢٠٨، ٢٠٠)
    ف٦٤_مطلق(٢١٦، ص)
    إذا (ف٦٤_هل_صحيح(ص) و (ف٦٤_أصغر(٢١٦، ٢٠٠) أو ف٦٤_يساوي(ص، ٢٠٨))) {
        متغير ع = ف٦٤_إلى_صحيح(ص)
        إذا (ع != ٠) { ارجع ق_صغير(ع) }
        # صفر: الموجب صغير، و-٠ يبقى عشريًا
        إذا (حمّل(ص + ٤) >= ٠) { ارجع ١ }
    }
    متغير ك = خصّص(١٦)
    خزّن(ك، ١)
    خزّن(ك + ٤، ٠)
    ف٦٤_نسخ(ك + ٨، ص)
    ارجع ك
}
# عدد عشري خارج الوحدة الصغيرة من جزأي بتّاته (للتجارب والثوابت)
دالة ق_من_بتّات(منخفض، مرتفع) {
    ف٦٤_ثابت(١٤٤، مرتفع، منخفض)
    ارجع ق_من_ف٦٤(١٤٤)
}

# عملية حسابية على عددين موسومين؛ الرمز: ١ جمع ٢ طرح ٣ ضرب ٤ قسمة ٥ باقي
دالة _حساب_عشري(رمز، أ، ب) {
    ق_ف٦٤(١٢٨، أ)
    ق_ف٦٤(١٣٦، ب)
    إذا (رمز == ١) { ف٦٤_جمع(١٤٤، ١٢٨، ١٣٦) }
    إذا (رمز == ٢) { ف٦٤_طرح(١٤٤، ١٢٨، ١٣٦) }
    إذا (رمز == ٣) { ف٦٤_ضرب(١٤٤، ١٢٨، ١٣٦) }
    إذا (رمز == ٤) { ف٦٤_قسمة(١٤٤، ١٢٨، ١٣٦) }
    إذا (رمز == ٥) { ف٦٤_باقي(١٤٤، ١٢٨، ١٣٦) }
    ارجع ق_من_ف٦٤(١٤٤)
}
دالة ق_جمع(أ، ب) {
    إذا (بتّ_و(أ، ب) % ٢ != ٠) {
        متغير ر = أ + ب - ١
        إذا (بتّ_و(بتّ_خاص(ر، أ)، بتّ_خاص(ر، ب)) >= ٠) { ارجع ر }
    }
    ارجع _حساب_عشري(١، أ، ب)
}
دالة ق_طرح(أ، ب) {
    إذا (بتّ_و(أ، ب) % ٢ != ٠) {
        متغير ر = أ - ب + ١
        إذا (بتّ_و(بتّ_خاص(أ، ب)، بتّ_خاص(أ، ر)) >= ٠) { ارجع ر }
    }
    ارجع _حساب_عشري(٢، أ، ب)
}
دالة ق_ضرب(أ، ب) {
    إذا (بتّ_و(أ، ب) % ٢ != ٠) {
        متغير ن١ = يمين(أ، ١)
        متغير ن٢ = يمين(ب، ١)
        متغير ر = ن١ * ن٢
        إذا (ر != ٠) {
            إذا (ر / ن١ == ن٢ و ر < ١٠٧٣٧٤١٨٢٤ و ر >= -١٠٧٣٧٤١٨٢٤) { ارجع ق_صغير(ر) }
        } وإلا {
            إذا (ن١ >= ٠ و ن٢ >= ٠) { ارجع ١ }
        }
    }
    ارجع _حساب_عشري(٣، أ، ب)
}
# القسمة دائمًا عشرية ثم تُوحَّد؛ فحص القسمة على صفر من شأن المنفِّذ
دالة ق_قسمة(أ، ب) { ارجع _حساب_عشري(٤، أ، ب) }
دالة ق_باقي(أ، ب) {
    إذا (بتّ_و(أ، ب) % ٢ != ٠) {
        متغير ن٢ = يمين(ب، ١)
        إذا (ن٢ != ٠) {
            متغير ن١ = يمين(أ، ١)
            متغير ر = ن١ % ن٢
            إذا (ر != ٠ أو ن١ >= ٠) { ارجع ق_صغير(ر) }
        }
    }
    ارجع _حساب_عشري(٥، أ، ب)
}
دالة ق_سالب(ق) {
    ق_ف٦٤(١٢٨، ق)
    ف٦٤_سالب(١٤٤، ١٢٨)
    ارجع ق_من_ف٦٤(١٤٤)
}
# مقارنة عددين: ١ إن أ < ب
دالة ق_أصغر(أ، ب) {
    إذا (بتّ_و(أ، ب) % ٢ != ٠) { ارجع أ < ب }
    ق_ف٦٤(١٢٨، أ)
    ق_ف٦٤(١٣٦، ب)
    ارجع ف٦٤_أصغر(١٢٨، ١٣٦)
}
دالة ق_أصغر_أو_يساوي(أ، ب) {
    إذا (بتّ_و(أ، ب) % ٢ != ٠) { ارجع أ <= ب }
    ق_ف٦٤(١٢٨، أ)
    ق_ف٦٤(١٣٦، ب)
    ارجع ف٦٤_أصغر_أو_يساوي(١٢٨، ١٣٦)
}

# ---------- النصوص ----------
دالة ق_نص_جديد(ن) {
    متغير ك = خصّص(ن + ٨)
    خزّن(ك، ٢)
    خزّن(ك + ٤، ن)
    ارجع ك
}
دالة ق_نص_طول(ق) { ارجع حمّل(ق + ٤) }
دالة ق_نص_بايت(ق، ي) { ارجع حمّل_بايت(ق + ٨ + ي) }
دالة ق_نص_ضع_بايت(ق، ي، ب) { خزّن_بايت(ق + ٨ + ي، ب) }
# من نص خام (نواة-تشغيل) إلى نص موسوم
دالة ق_نص_من_خام(خ) {
    متغير ن = حمّل(خ)
    متغير ك = ق_نص_جديد(ن)
    انسخ(خ + ٤، ك + ٨، ن)
    ارجع ك
}
دالة ق_نص_دمج(أ، ب) {
    متغير ن١ = حمّل(أ + ٤)
    متغير ن٢ = حمّل(ب + ٤)
    متغير ك = ق_نص_جديد(ن١ + ن٢)
    انسخ(أ + ٨، ك + ٨، ن١)
    انسخ(ب + ٨، ك + ٨ + ن١، ن٢)
    ارجع ك
}
# نص[من:إلى) على البايتات (القصّ على الحروف من شأن المنفِّذ)
دالة ق_نص_جزء(ق، من_، إلى_) {
    متغير ك = ق_نص_جديد(إلى_ - من_)
    انسخ(ق + ٨ + من_، ك + ٨، إلى_ - من_)
    ارجع ك
}
دالة ق_إلى_نص(ق) {
    إذا (بتّ_و(ق، ١) == ١) { ارجع ق_نص_من_خام(نص_من_عدد(يمين(ق، ١))) }
    إذا (ق_وسم(ق) == ١) { ارجع ق_نص_من_خام(عدد_إلى_نص(ق + ٨)) }
    ارجع ق
}
# تحليل نص إلى عدد: يرجع عدد موسومًا أو -١ (الكلمة ٠xFFFFFFFF) عند الفشل
دالة ق_من_نص(ق) {
    إذا (نص_إلى_عدد(ق + ٤، ١٥٢) == ١) { ارجع ق_من_ف٦٤(١٥٢) }
    ارجع -١
}

# ---------- القوائم ----------
دالة ق_قائمة_جديدة() {
    متغير ك = خصّص(١٦)
    خزّن(ك، ٣)
    خزّن(ك + ٤، ٠)
    خزّن(ك + ٨، ٤)
    خزّن(ك + ١٢، خصّص(١٦))
    ارجع ك
}
دالة ق_قائمة_طول(ق) { ارجع حمّل(ق + ٤) }
دالة ق_قائمة_احصل(ق، ي) { ارجع قائمة_احصل(ق + ٤، ي) }
دالة ق_قائمة_اضبط(ق، ي، ع) { قائمة_اضبط(ق + ٤، ي، ع) }
دالة ق_قائمة_أضف(ق، ع) { قائمة_أضف(ق + ٤، ع) }
دالة ق_قائمة_انزع(ق) { ارجع قائمة_انزع(ق + ٤) }

# ---------- المساواة والتجزئة ----------
# مساواة آلة ضاد: الأعداد بالقيمة، والنصوص بالمحتوى، وغيرها بالهوية؛ NaN لا يساوي نفسه
دالة ق_يساوي(أ، ب) {
    إذا (أ == ب) {
        إذا (ق_وسم(أ) == ١) { ارجع ف٦٤_يساوي(أ + ٨، أ + ٨) }
        ارجع ١
    }
    إذا (ق_هل_عدد(أ) و ق_هل_عدد(ب)) {
        ق_ف٦٤(١٢٨، أ)
        ق_ف٦٤(١٣٦، ب)
        ارجع ف٦٤_يساوي(١٢٨، ١٣٦)
    }
    إذا (ق_وسم(أ) == ٢ و ق_وسم(ب) == ٢) { ارجع نص_يساوي(أ + ٤، ب + ٤) }
    ارجع ٠
}
دالة ق_تجزئة(ق) {
    إذا (بتّ_و(ق، ١) == ١) { ارجع ق * -١٦٤٠٥٣١٥٣٥ }
    إذا (ق_وسم(ق) == ١) {
        # الصفر العشري (و-٠) يساوي الصفر الصغير فيجب أن يتفقا في التجزئة
        ف٦٤_من_صحيح(١٣٦، ٠)
        إذا (ف٦٤_يساوي(ق + ٨، ١٣٦)) { ارجع ١ * -١٦٤٠٥٣١٥٣٥ }
        ارجع بتّ_خاص(حمّل(ق + ٨)، حمّل(ق + ١٢)) * -١٦٤٠٥٣١٥٣٥
    }
    إذا (ق_وسم(ق) == ٢) { ارجع نص_تجزئة(ق + ٤) }
    ارجع ق * -١٦٤٠٥٣١٥٣٥
}
# الصدق: ٠ لاشيء وخطأ و٠ و«» والقائمة والخريطة الفارغتان؛ وما عداه صدق
دالة ق_صدق(ق) {
    إذا (بتّ_و(ق، ١) == ١) { ارجع ق != ١ }
    إذا (ق < ٢٠٤٨٨) { ارجع ق == ٤ }
    متغير وس = حمّل(ق)
    إذا (وس == ١) {
        ف٦٤_من_صحيح(١٣٦، ٠)
        ارجع ف٦٤_لا_يساوي(ق + ٨، ١٣٦)
    }
    إذا (وس == ٢) { ارجع حمّل(ق + ٤) > ٠ }
    إذا (وس == ٣) { ارجع حمّل(ق + ٤) > ٠ }
    إذا (وس == ٤) { ارجع حمّل(ق + ٣٢) > ٠ }
    ارجع ١
}

# ---------- الخرائط (مرتبة بالإدخال) ----------
# التخطيط: م+٤ فهرس خام (٥ كلمات) · م+٢٤ المفاتيح · م+٢٨ القيم · م+٣٢ عدد الحيّ. علامة المحذوف ٦.
دالة ق_خريطة_جديدة() {
    متغير م = خصّص(٣٦)
    خزّن(م، ٤)
    خزّن(م + ٤، ٠)
    خزّن(م + ٨، ٨)
    خزّن(م + ١٢، _جدول_جديد(٨))
    خزّن(م + ١٦، ٢)
    خزّن(م + ٢٠، ٠)
    خزّن(م + ٢٤، ق_قائمة_جديدة())
    خزّن(م + ٢٨، ق_قائمة_جديدة())
    خزّن(م + ٣٢، ٠)
    ارجع م
}
دالة ق_خريطة_عدد(م) { ارجع حمّل(م + ٣٢) }
دالة ق_خريطة_يحوي(م، ك) { ارجع خريطة_يحوي(م + ٤، ك) }
دالة ق_خريطة_احصل(م، ك، افتراضي) {
    متغير خ = _ابحث(م + ٤، ك)
    إذا (خ == ٠) { ارجع افتراضي }
    ارجع ق_قائمة_احصل(حمّل(م + ٢٨)، يمين(حمّل(خ + ٨)، ١))
}
دالة ق_خريطة_ضع(م، ك، ع) {
    متغير خ = _ابحث(م + ٤، ك)
    إذا (خ != ٠) {
        ق_قائمة_اضبط(حمّل(م + ٢٨)، يمين(حمّل(خ + ٨)، ١)، ع)
        ارجع ٠
    }
    متغير ي = ق_قائمة_طول(حمّل(م + ٢٤))
    ق_قائمة_أضف(حمّل(م + ٢٤)، ك)
    ق_قائمة_أضف(حمّل(م + ٢٨)، ع)
    خريطة_ضع(م + ٤، ك، ق_صغير(ي))
    خزّن(م + ٣٢، حمّل(م + ٣٢) + ١)
    ارجع ٠
}
دالة ق_خريطة_احذف(م، ك) {
    متغير خ = _ابحث(م + ٤، ك)
    إذا (خ == ٠) { ارجع ٠ }
    متغير ي = يمين(حمّل(خ + ٨)، ١)
    ق_قائمة_اضبط(حمّل(م + ٢٤)، ي، ٦)
    ق_قائمة_اضبط(حمّل(م + ٢٨)، ي، ٠)
    خريطة_احذف(م + ٤، ك)
    خزّن(م + ٣٢، حمّل(م + ٣٢) - ١)
    إذا (ق_قائمة_طول(حمّل(م + ٢٤)) > حمّل(م + ٣٢) * ٢ + ٨) { _ضغط_خريطة(م) }
    ارجع ١
}
# يعيد بناء الفهرس والقائمتين بلا ثقوب مع حفظ الترتيب
دالة _ضغط_خريطة(م) {
    متغير قدم_ك = حمّل(م + ٢٤)
    متغير قدم_ق = حمّل(م + ٢٨)
    متغير ن = ق_قائمة_طول(قدم_ك)
    متغير جدد_ك = ق_قائمة_جديدة()
    خزّن(م + ٢٤، جدد_ك)
    متغير جدد_ق = ق_قائمة_جديدة()
    خزّن(م + ٢٨، جدد_ق)
    خزّن(م + ٤، ٠)
    خزّن(م + ٨، ٨)
    خزّن(م + ١٢، _جدول_جديد(٨))
    خزّن(م + ٢٠، ٠)
    من_أجل (ي من ٠ إلى ن - ١) {
        متغير مف = ق_قائمة_احصل(قدم_ك، ي)
        إذا (مف != ٦) {
            متغير ج = ق_قائمة_طول(جدد_ك)
            ق_قائمة_أضف(جدد_ك، مف)
            ق_قائمة_أضف(جدد_ق، ق_قائمة_احصل(قدم_ق، ي))
            خريطة_ضع(م + ٤، مف، ق_صغير(ج))
        }
    }
}
# المرور بالترتيب: عدد المواضع (فيها ثقوب) والمفتاح والقيمة في الموضع؛ المفتاح ٦ = ثقب يُتخطّى
دالة ق_خريطة_مواضع(م) { ارجع ق_قائمة_طول(حمّل(م + ٢٤)) }
دالة ق_خريطة_مفتاح_في(م، ي) { ارجع ق_قائمة_احصل(حمّل(م + ٢٤)، ي) }
دالة ق_خريطة_قيمة_في(م، ي) { ارجع ق_قائمة_احصل(حمّل(م + ٢٨)، ي) }
