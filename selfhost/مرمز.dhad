# مُرمِّز ضاد مكتوبًا بضاد (الاستضافة الذاتية، المرحلة ١).
# نقل أمين لدالة tokenize في front.js: نفس أنواع الرموز ونفس الرسائل ونفس ترقيم الأسطر، ويُختبر بالمقارنة الآلية بالأصل.
# يقبل نصًّا ويعيد قائمة رموز، كل رمز خريطة {"type", "value", "line"}، ويطلق خطأً بالرسالة نفسها عند رمز غير معروف.

متغير كلمات = {"دالة": "FUNC"، "ارجع": "RETURN"، "إذا": "IF"، "وإلا": "ELSE"، "طالما": "WHILE"، "من_أجل": "FOR"، "من": "FROM"، "إلى": "TO"، "متغير": "VAR"، "صحيح": "TRUE"، "خطأ": "FALSE"، "لاشيء": "NULL"، "و": "AND"، "أو": "OR"، "ليس": "NOT"، "توقف": "BREAK"، "أكمل": "CONTINUE"}

متغير مفردة = {"(": "LPAREN"، ")": "RPAREN"، "{": "LBRACE"، "}": "RBRACE"، "[": "LBRACKET"، "]": "RBRACKET"، ",": "COMMA"، "،": "COMMA"، ";": "SEMI"، ":": "COLON"، "+": "PLUS"، "-": "MINUS"، "*": "STAR"، "/": "SLASH"، "%": "PERCENT"}

متغير ثنائية = {"==": "EQ"، "!=": "NEQ"، "<=": "LTE"، ">=": "GTE"، "&&": "AND"، "||": "OR"، "+=": "PLUSEQ"، "-=": "MINUSEQ"، "*=": "STAREQ"، "/=": "SLASHEQ"، "%=": "PERCENTEQ"، "++": "PLUSPLUS"، "--": "MINUSMINUS"}

# علامات الترقيم العربية التي لا تُعدّ من المعرّفات رغم وقوعها في النطاق العربي
متغير ترقيم_عربي = {}
من_أجل (ح في ["،"، "؛"، "؟"، "٪"، "٫"، "٬"، "۔"]) { ترقيم_عربي[رمز(ح)] = صحيح }

# أرقام لاتينية ٠-٩ وعربية هندية (U+0660-0669) وفارسية (U+06F0-06F9)
دالة _رقم_ر(ر) {
    ارجع (ر >= ٤٨ و ر <= ٥٧) أو (ر >= ١٦٣٢ و ر <= ١٦٤١) أو (ر >= ١٧٧٦ و ر <= ١٧٨٥)
}

دالة _بدء_معرّف(ر) {
    إذا (يحوي(ترقيم_عربي، ر)) { ارجع خطأ }
    ارجع (ر >= ٦٥ و ر <= ٩٠) أو (ر >= ٩٧ و ر <= ١٢٢) أو ر == ٩٥ أو (ر >= ١٥٣٦ و ر <= ١٧٩١)
}

دالة _جزء_معرّف(ر) {
    ارجع _بدء_معرّف(ر) أو (ر >= ٤٨ و ر <= ٥٧)
}

# قيمة حرف رقم بالأساس المعطى أو -١ إن لم يصلح (لاتيني/هندي/فارسي، وa-f للسداسي)
دالة _قيمة_رقم_أساس(ح، أساس) {
    متغير ر = رمز(ح)
    متغير د = -١
    إذا (ر >= ٤٨ و ر <= ٥٧) { د = ر - ٤٨ }
    إذا (ر >= ١٦٣٢ و ر <= ١٦٤١) { د = ر - ١٦٣٢ }
    إذا (ر >= ١٧٧٦ و ر <= ١٧٨٥) { د = ر - ١٧٧٦ }
    إذا (ر >= ٩٧ و ر <= ١٠٢) { د = ر - ٨٧ }
    إذا (ر >= ٦٥ و ر <= ٧٠) { د = ر - ٥٥ }
    إذا (د >= أساس) { ارجع -١ }
    ارجع د
}

# قيمة رقم سداسي عشري (لاتيني فقط) أو -١
دالة _هكس(ح) {
    متغير ر = رمز(ح)
    إذا (ر >= ٤٨ و ر <= ٥٧) { ارجع ر - ٤٨ }
    إذا (ر >= ٩٧ و ر <= ١٠٢) { ارجع ر - ٨٧ }
    إذا (ر >= ٦٥ و ر <= ٧٠) { ارجع ر - ٥٥ }
    ارجع -١
}

# هل في النص الخام فاصل _ لا يقع بين رقمين؟
دالة _فاصل_رقم_سيئ(خام) {
    متغير ي = ٠
    طالما (ي < طول(خام)) {
        إذا (خام[ي] == "_") {
            إذا (ي == ٠ أو ي + ١ >= طول(خام)) { ارجع صحيح }
            إذا (_رقم_ر(رمز(خام[ي - ١])) == خطأ أو _رقم_ر(رمز(خام[ي + ١])) == خطأ) { ارجع صحيح }
        }
        ي = ي + ١
    }
    ارجع خطأ
}

# يحوّل الأرقام العربية والفارسية إلى لاتينية ويبقي ما سواها
دالة _طبّع_أرقام(س) {
    متغير خ = []
    متغير ي = ٠
    طالما (ي < طول(س)) {
        متغير ر = رمز(س[ي])
        إذا (ر >= ١٦٣٢ و ر <= ١٦٤١) {
            أضف(خ، نص_برمجي(ر - ١٦٣٢))
        } وإلا إذا (ر >= ١٧٧٦ و ر <= ١٧٨٥) {
            أضف(خ، نص_برمجي(ر - ١٧٧٦))
        } وإلا {
            أضف(خ، س[ي])
        }
        ي = ي + ١
    }
    ارجع اربط(خ، "")
}

دالة _رمز_جديد(نوع_رمز، قيمة، سطر) {
    ارجع {"type": نوع_رمز، "value": قيمة، "line": سطر}
}

صدّر دالة رمّز(س) {
    متغير رموز = []
    متغير نمط_قالب = خطأ
    متغير ي = ٠
    متغير سطر = ١
    متغير ن = طول(س)

    طالما (ي < ن) {
        متغير ح = س[ي]
        متغير ر = رمز(ح)

        إذا (ح == "\n") {
            سطر = سطر + ١
            ي = ي + ١
        } وإلا إذا (ح == " " أو ح == "\t" أو ح == حرف(١٣)) {
            ي = ي + ١
        } وإلا إذا (ح == "#") {
            طالما (ي < ن و س[ي] != "\n") { ي = ي + ١ }
        } وإلا إذا (ح == "/" و ي + ١ < ن و س[ي + ١] == "*") {
            # تعليق كتلة /* … */ (لا يتداخل)
            متغير سطر_البدء = سطر
            ي = ي + ٢
            طالما (ي < ن و ليس (س[ي] == "*" و ي + ١ < ن و س[ي + ١] == "/")) {
                إذا (س[ي] == "\n") { سطر = سطر + ١ }
                ي = ي + ١
            }
            إذا (ي >= ن) { أطلق_خطأ("السطر " + نص_برمجي(سطر_البدء) + ": تعليق كتلة غير مغلق (نسيت */)") }
            ي = ي + ٢
        } وإلا إذا (_رقم_ر(ر)) {
            متغير بداية = ي
            متغير أساس = ٠
            إذا (ح == "0" و ي + ١ < ن) {
                متغير ت = س[ي + ١]
                إذا (ت == "x" أو ت == "X") { أساس = ١٦ }
                إذا (ت == "b" أو ت == "B") { أساس = ٢ }
                إذا (ت == "o" أو ت == "O") { أساس = ٨ }
            }
            إذا (أساس > ٠) {
                # سداسي عشري 0x وثنائي 0b وثماني 0o (الفاصل _ بين رقمين)
                ي = ي + ٢
                متغير قيمة_ = ٠
                متغير عدد_الأرقام = ٠
                متغير سبق_فاصل = خطأ
                طالما (ي < ن و (_قيمة_رقم_أساس(س[ي]، أساس) >= ٠ أو س[ي] == "_")) {
                    إذا (س[ي] == "_") {
                        إذا (عدد_الأرقام == ٠ أو سبق_فاصل) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": الفاصل _ في الرقم يجب أن يقع بين رقمين") }
                        سبق_فاصل = صحيح
                    } وإلا {
                        قيمة_ = قيمة_ * أساس + _قيمة_رقم_أساس(س[ي]، أساس)
                        عدد_الأرقام = عدد_الأرقام + ١
                        سبق_فاصل = خطأ
                    }
                    ي = ي + ١
                }
                إذا (عدد_الأرقام == ٠) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": رقم بالأساس " + نص_برمجي(أساس) + " بلا أرقام بعد " + اقتطع(س، بداية، ي)) }
                إذا (سبق_فاصل) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": الفاصل _ في الرقم يجب أن يقع بين رقمين") }
                أضف(رموز، _رمز_جديد("NUMBER"، نص_برمجي(قيمة_)، سطر))
            } وإلا {
                طالما (ي < ن و (_رقم_ر(رمز(س[ي])) أو س[ي] == "." أو س[ي] == "٫" أو س[ي] == "_")) { ي = ي + ١ }
                # الأس العلمي: e أو E ثم +/- اختياري ثم أرقام
                إذا (ي < ن و (س[ي] == "e" أو س[ي] == "E")) {
                    متغير ج = ي + ١
                    إذا (ج < ن و (س[ج] == "+" أو س[ج] == "-")) { ج = ج + ١ }
                    إذا (ج < ن و _رقم_ر(رمز(س[ج]))) {
                        طالما (ج < ن و _رقم_ر(رمز(س[ج]))) { ج = ج + ١ }
                        ي = ج
                    }
                }
                متغير خام = اقتطع(س، بداية، ي)
                إذا (_فاصل_رقم_سيئ(خام)) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": الفاصل _ في الرقم يجب أن يقع بين رقمين") }
                أضف(رموز، _رمز_جديد("NUMBER"، _طبّع_أرقام(استبدل(استبدل(خام، "٫"، ".")، "_"، ""))، سطر))
            }
        } وإلا إذا (ح == "\"" أو ح == "'") {
            متغير اقتباس = ح
            متغير قالبي = نمط_قالب
            نمط_قالب = خطأ
            ي = ي + ١
            متغير جزء = []
            متغير قطع = []
            طالما (ي < ن و س[ي] != اقتباس) {
                إذا (قالبي و س[ي] == "{") {
                    # تعبير داخل قالب: يُرمَّز بشكل متداخل
                    متغير ج٢ = ي + ١
                    متغير عمق = ١
                    طالما (ج٢ < ن و عمق > ٠) {
                        متغير ك = س[ج٢]
                        إذا (ك == "\"" أو ك == "'") {
                            ج٢ = ج٢ + ١
                            طالما (ج٢ < ن و س[ج٢] != ك) {
                                إذا (س[ج٢] == "\\") { ج٢ = ج٢ + ١ }
                                ج٢ = ج٢ + ١
                            }
                        } وإلا إذا (ك == "{") {
                            عمق = عمق + ١
                        } وإلا إذا (ك == "}") {
                            عمق = عمق - ١
                        }
                        ج٢ = ج٢ + ١
                    }
                    إذا (عمق > ٠) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": تعبير القالب غير مغلق (نسيت })") }
                    متغير نص_التعبير = اقتطع(س، ي + ١، ج٢ - ١)
                    إذا (طول(قصّ(نص_التعبير)) == ٠) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": تعبير فارغ داخل القالب {}") }
                    متغير داخلية = []
                    حاول {
                        داخلية = رمّز(نص_التعبير)
                    } التقط (خ) {
                        أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": في تعبير القالب: " + خ)
                    }
                    انزع(داخلية)
                    إذا (طول(جزء) > ٠) { أضف(قطع، اربط(جزء، "")) }
                    جزء = []
                    من_أجل (ر٢ في داخلية) { ر٢["line"] = سطر }
                    أضف(قطع، {"expr": داخلية})
                    ي = ج٢
                } وإلا إذا (س[ي] == "\\" و ي + ١ < ن) {
                    متغير تالٍ = س[ي + ١]
                    إذا (تالٍ == "n") {
                        أضف(جزء، "\n")
                    } وإلا إذا (تالٍ == "t") {
                        أضف(جزء، "\t")
                    } وإلا إذا (تالٍ == "r") {
                        أضف(جزء، حرف(١٣))
                    } وإلا إذا (تالٍ == "0") {
                        أضف(جزء، حرف(٠))
                    } وإلا إذا (تالٍ == "x" أو تالٍ == "u") {
                        # \xHH و\uHHHH و\u{H…}
                        متغير ج = ي + ٢
                        متغير قيمة_هروب = ٠
                        متغير عدد_ = ٠
                        إذا (تالٍ == "u" و ج < ن و س[ج] == "{") {
                            ج = ج + ١
                            طالما (ج < ن و _هكس(س[ج]) >= ٠) {
                                قيمة_هروب = قيمة_هروب * ١٦ + _هكس(س[ج])
                                عدد_ = عدد_ + ١
                                ج = ج + ١
                            }
                            إذا (ج >= ن أو س[ج] != "}" أو عدد_ == ٠ أو عدد_ > ٦) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": تسلسل هروب غير صالح (\\u{…} يحتاج من ١ إلى ٦ أرقام سداسية ثم })") }
                            ج = ج + ١
                        } وإلا {
                            متغير مطلوب = ٤
                            إذا (تالٍ == "x") { مطلوب = ٢ }
                            طالما (عدد_ < مطلوب و ج < ن و _هكس(س[ج]) >= ٠) {
                                قيمة_هروب = قيمة_هروب * ١٦ + _هكس(س[ج])
                                عدد_ = عدد_ + ١
                                ج = ج + ١
                            }
                            إذا (عدد_ < مطلوب) {
                                متغير وصف = "أربعة أرقام"
                                إذا (تالٍ == "x") { وصف = "رقمين" }
                                أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": تسلسل هروب غير صالح (\\" + تالٍ + " يحتاج " + وصف + " سداسية عشرية)")
                            }
                        }
                        إذا (قيمة_هروب > ١١١٤١١١) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": تسلسل هروب غير صالح (القيمة خارج النطاق 10FFFF)") }
                        أضف(جزء، حرف(قيمة_هروب))
                        ي = ج - ٢
                    } وإلا {
                        أضف(جزء، تالٍ)
                    }
                    ي = ي + ٢
                } وإلا {
                    أضف(جزء، س[ي])
                    ي = ي + ١
                }
            }
            إذا (ي >= ن) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": نص غير مغلق (نسيت علامة الاقتباس)") }
            ي = ي + ١
            إذا (طول(قطع) == ٠) {
                أضف(رموز، _رمز_جديد("STRING"، اربط(جزء، "")، سطر))
            } وإلا {
                إذا (طول(جزء) > ٠) { أضف(قطع، اربط(جزء، "")) }
                أضف(رموز، _رمز_جديد("LPAREN"، "("، سطر))
                متغير ترتيب = ٠
                من_أجل (ق في قطع) {
                    إذا (ترتيب > ٠) { أضف(رموز، _رمز_جديد("PLUS"، "+"، سطر)) }
                    إذا (نوع(ق) == "نص") {
                        أضف(رموز، _رمز_جديد("STRING"، ق، سطر))
                    } وإلا {
                        أضف(رموز، _رمز_جديد("IDENT"، "@قالب"، سطر))
                        أضف(رموز، _رمز_جديد("LPAREN"، "("، سطر))
                        من_أجل (ر٣ في ق["expr"]) { أضف(رموز، ر٣) }
                        أضف(رموز، _رمز_جديد("RPAREN"، ")"، سطر))
                    }
                    ترتيب = ترتيب + ١
                }
                أضف(رموز، _رمز_جديد("RPAREN"، ")"، سطر))
            }
        } وإلا إذا (_بدء_معرّف(ر)) {
            متغير بداية = ي
            طالما (ي < ن و _جزء_معرّف(رمز(س[ي]))) { ي = ي + ١ }
            متغير كلمة = اقتطع(س، بداية، ي)
            متغير نوع_رمز = "IDENT"
            إذا (كلمة == "قالب" و ي < ن و (س[ي] == "\"" أو س[ي] == "'")) {
                # قالب نصي بتعابير {…}: يُعلَّم وتُعالجه حلقة النص في الدورة التالية
                نمط_قالب = صحيح
            } وإلا إذا (كلمة == "خام" و ي < ن و (س[ي] == "\"" أو س[ي] == "'")) {
                # نص خام: بلا هروب، ينتهي عند أول اقتباس مطابق
                متغير ق = س[ي]
                ي = ي + ١
                متغير بدء_خام = ي
                طالما (ي < ن و س[ي] != ق) { ي = ي + ١ }
                إذا (ي >= ن) { أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": نص غير مغلق (نسيت علامة الاقتباس)") }
                أضف(رموز، _رمز_جديد("STRING"، اقتطع(س، بدء_خام، ي)، سطر))
                ي = ي + ١
            } وإلا {
                إذا (يحوي(كلمات، كلمة)) { نوع_رمز = كلمات[كلمة] }
                أضف(رموز، _رمز_جديد(نوع_رمز، كلمة، سطر))
            }
        } وإلا {
            متغير اثنان = اقتطع(س، ي، ي + ٢)
            إذا (يحوي(ثنائية، اثنان)) {
                أضف(رموز، _رمز_جديد(ثنائية[اثنان]، اثنان، سطر))
                ي = ي + ٢
            } وإلا إذا (ح == "=") {
                أضف(رموز، _رمز_جديد("ASSIGN"، "="، سطر))
                ي = ي + ١
            } وإلا إذا (ح == "<") {
                أضف(رموز، _رمز_جديد("LT"، "<"، سطر))
                ي = ي + ١
            } وإلا إذا (ح == ">") {
                أضف(رموز، _رمز_جديد("GT"، ">"، سطر))
                ي = ي + ١
            } وإلا إذا (ح == "!") {
                أضف(رموز، _رمز_جديد("NOT"، "!"، سطر))
                ي = ي + ١
            } وإلا إذا (ح == ".") {
                أضف(رموز، _رمز_جديد("DOT"، "."، سطر))
                ي = ي + ١
            } وإلا إذا (يحوي(مفردة، ح)) {
                أضف(رموز، _رمز_جديد(مفردة[ح]، ح، سطر))
                ي = ي + ١
            } وإلا {
                أطلق_خطأ("السطر " + نص_برمجي(سطر) + ": رمز غير معروف «" + ح + "»")
            }
        }
    }
    أضف(رموز، _رمز_جديد("EOF"، لاشيء، سطر))
    ارجع رموز
}
