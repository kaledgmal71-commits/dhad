# ضاد/نواة_نوايا_أوزان — مولَّد بـ tools/train_intents.js من نواة_نوايا.درّب؛ لا يُحرَّر يدويًّا.
# الأوزان أعداد صحيحة ×١٠٠٠ بالتجزئة نفسها في «ضاد/نواة_نوايا»، مخزَّنة نصًّا مضغوطًا «فهرس:قيم;...» ويُفكّ عند أول استعمال.

متغير _تصنيفات = [__CLS__]
متغير _انحياز_نص = "__BIAS__"
متغير _نص = "__BODY__"
متغير _نموذج = لاشيء

دالة _عدد(ك) {
    متغير س = ١
    متغير ق = ٠
    متغير ب = ك
    إذا (طول(ب) > ٠ و ب[٠] == "-") { س = -١; ب = ب[١:طول(ب)] }
    من_أجل (ح في ب) {
        من_أجل (ي في مدى(١٠)) { إذا ("٠١٢٣٤٥٦٧٨٩"[ي] == ح) { ق = ق * ١٠ + ي } }
    }
    ارجع س * ق
}

دالة _قائمة(ن) {
    متغير خ = []
    من_أجل (ك في افصل(ن، ",")) { أضف(خ، _عدد(ك)) }
    ارجع خ
}

صدّر دالة نموذج() {
    إذا (_نموذج == لاشيء) {
        متغير أوزان_ = {}
        من_أجل (مدخل في افصل(_نص، ";")) {
            متغير نقطتان = ٠
            من_أجل (ي في مدى(طول(مدخل))) { إذا (مدخل[ي] == ":" و نقطتان == ٠) { نقطتان = ي } }
            أوزان_[_عدد(مدخل[٠:نقطتان])] = _قائمة(مدخل[نقطتان + ١:طول(مدخل)])
        }
        _نموذج = {"تصنيفات": _تصنيفات، "انحياز": _قائمة(_انحياز_نص)، "أوزان": أوزان_}
    }
    ارجع _نموذج
}

صدّر دالة عتبة() { ارجع __THR__ }
